# Containerfile.auditor -- base image for the literature-verification
# orchestrator (#595).
#
# Mirrors math-foundry/tools/Containerfile.foundry (#592) on the
# agentis runtime + claude CLI side. Adds curl + python3-requests on
# top so the four searcher .ag agents can fetch from
# export.arxiv.org / oeis.org / groupprops.subwiki.org /
# api.semanticscholar.org via `exec sh "curl ..."` or `exec sh
# "python3 -c '... urllib ...'"`.
#
# WARNING: this image deliberately bakes ONLY the agentis runtime,
# claude CLI, and HTTP toolchain. The five colonies and the per-run
# hermetic .agentis/ state are mounted at run time via
# `-v $REPO_ROOT:/repo:ro` and `-v $RUN_DIR/<node>:/run-root:rw`. Do
# NOT `COPY` any colony source into the image.
#
# WARNING: Claude Code session credentials (`~/.claude/.credentials.json`)
# MUST NOT be baked in. The orchestrator bind-mounts the host
# operator's `$HOME/.claude` at run time via
# `-v $HOST_CLAUDE_DIR:/root/.claude:rw,z`; never `COPY` the directory
# into the image.
#
# Network: this federation needs outbound HTTPS to arxiv.org,
# oeis.org, groupprops.subwiki.org, and api.semanticscholar.org.
# Unlike math-foundry, the orchestrator does NOT add `--network none`;
# rootless podman's default slirp4netns egress is used. No inbound
# ports are opened.

FROM ubuntu:24.04

ARG AGENTIS_VERSION=v1.7.12

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-requests \
        jq \
        git \
        curl \
        ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Compute stack matching math-foundry so a future merged-image cut is
# painless. The four searchers do not strictly need sympy/numpy/
# networkx, but the auditor synthesis step may want them for sequence
# sanity checks (Phase 2 extension).
RUN python3 -m pip install --no-cache-dir --break-system-packages \
        sympy \
        numpy \
        networkx

RUN cd /tmp \
 && curl -fsSL -o agentis-linux-x86_64 \
        "https://github.com/Replikanti/agentis/releases/download/${AGENTIS_VERSION}/agentis-linux-x86_64" \
 && curl -fsSL -o agentis-linux-x86_64.sha256 \
        "https://github.com/Replikanti/agentis/releases/download/${AGENTIS_VERSION}/agentis-linux-x86_64.sha256" \
 && sha256sum -c agentis-linux-x86_64.sha256 \
 && install -m 0755 agentis-linux-x86_64 /usr/local/bin/agentis \
 && rm /tmp/agentis-linux-x86_64 /tmp/agentis-linux-x86_64.sha256

# Install Claude Code CLI for the optional claude-backend support
# (Sonnet for searchers, Opus for the auditor).
RUN curl -fsSL https://claude.ai/install.sh | bash \
 && ln -s /root/.local/bin/claude /usr/local/bin/claude

WORKDIR /run-root

ENTRYPOINT ["/bin/bash"]
