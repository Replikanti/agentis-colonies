# TEMPLATE — copy to secret.yaml, fill in real tokens, then `kubectl apply`.
#
# DO NOT commit the filled-in version. The .gitignore at the repo root excludes
# *.toml secrets and any file matching `secret.yaml` (without the .example
# suffix). Verify with `git check-ignore secret.yaml` before committing.
#
# Tokens map to the env vars consumed by the federation entrypoint.sh:
#   gitlab_token -> $GITLAB_TOKEN  (used when forge_type = gitlab)
#   github_token -> $GITHUB_TOKEN  (used when forge_type = github)
---
apiVersion: v1
kind: Secret
metadata:
  name: agentis-colonies
  labels:
    app.kubernetes.io/name: agentis-colonies
    app.kubernetes.io/component: federation
type: Opaque
stringData:
  # GitLab personal access token (glpat-...). Required when forge_type=gitlab.
  # Comment out if running github-only.
  gitlab_token: "glpat-REPLACE_ME"

  # GitHub personal access token (ghp_... or github_pat_...). Required when
  # forge_type=github. Comment out if running gitlab-only.
  github_token: "ghp_REPLACE_ME"
