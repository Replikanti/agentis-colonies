# Sample env file for examples/docker/docker-compose.yml.
#
# Copy to `.env` (next to docker-compose.yml) and fill in real values.
# DO NOT commit the filled-in version.

# Forge backend: gitlab | github
FORGE_TYPE=gitlab

# ----- GitLab path (when FORGE_TYPE=gitlab) -----
GITLAB_URL=https://gitlab.com
GITLAB_PROJECT=my-org/my-project
GITLAB_TOKEN=glpat-REPLACE_ME
# Optional: your GitLab username for personal/team activity tagging.
GITLAB_ME=

# ----- GitHub path (when FORGE_TYPE=github) -----
# GITHUB_OWNER=my-org
# GITHUB_REPO=my-project
# GITHUB_TOKEN=ghp_REPLACE_ME
# GITHUB_ME=
