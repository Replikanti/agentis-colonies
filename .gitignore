# Colony runtime state
.agentis/

# Local config (contains tokens)
**/config/colony.toml

# Dashboard (generated HTML)
.dashboard/

# OS
.DS_Store

# Python bytecode (from helper scripts in tools/)
__pycache__/
*.pyc

# Federation release bundles (produced by tools/make-federation-bundle.sh; #220)
/dist/

# Sidecar lock files (created next to the script via fcntl.flock; #245 / #318)
tools/.auto-promote.lock
tools/.cost-cap.lock

# Cross-fed memo host-dir content (#629 Phase 8 PR-1). The bridge sidecar
# regenerates everything under /cross-fed-memo/ on every tick from each
# federation's `.agentis/memo/cross-fed:*` keys -- only the .gitkeep + README
# are tracked.
/cross-fed-memo/*
!/cross-fed-memo/.gitkeep
!/cross-fed-memo/README.md

# grand-rounds (#2032): gated clinical inputs and everything derived from them
# live OUTSIDE the checkout (reached only via $MVA_DATA_DIR / $MVA_WORK_DIR /
# $MVA_OUT_DIR). This block is a belt-and-braces guard so a stray gated file
# under grand-rounds/ can never be staged; tools/check-no-gated-data.sh is the
# enforced gate. The synthetic, gated-data-free fixtures are negated back in.
grand-rounds/**/*.vcf
grand-rounds/**/*.vcf.*
grand-rounds/**/*.bcf
grand-rounds/**/*.bcf.*
grand-rounds/**/*.fastq
grand-rounds/**/*.fastq.*
grand-rounds/**/*.fq
grand-rounds/**/*.fq.*
grand-rounds/**/*.bam
grand-rounds/**/*.bam.*
grand-rounds/**/*.cram
grand-rounds/**/*.cram.*
grand-rounds/**/*.docx
grand-rounds/**/*.gtf
grand-rounds/**/*.gtf.*
grand-rounds/**/*.fa
grand-rounds/**/*.fa.gz
grand-rounds/**/*.fna
grand-rounds/**/*.fna.gz
grand-rounds/**/*.fai
grand-rounds/**/*.obo
grand-rounds/**/data/
grand-rounds/**/work/
grand-rounds/**/refdata/
grand-rounds/**/out/
grand-rounds/**/agentis-federation_*.csv
!grand-rounds/baseline/fixtures/**
