// ship_decider.ag -- Release colony: learns when to ship.
//
// Observes release cadence, blocker patterns, and risk tolerance to learn
// ship/no-ship thresholds. Weighs pre-release check results against learned
// patterns and makes the go/no-go decision.
//
// Run as daemon: agentis daemon agents/ship_decider.ag --colony release
// Requires: exec_foreign capability, GITLAB_* env vars

cb 600;

type ShipPatterns {
    releases_seen: int,
    cadence: string,
    blocker_types: string,
    risk_tolerance: string
}

type ShipDecision {
    decision: string,
    reasoning: string,
    blockers: string,
    confidence: float
}

fn get_confidence() -> float {
    let raw = recall_latest("ship_decider:confidence");
    if len(raw) > 0 {
        return parse_float(raw);
    };
    return 0.0;
}

// #316 M3b: per-tick fan-out helpers. See triage/agents/router.ag for
// the full rationale. Single-block configs collapse to owner=="" sentinel,
// repo_arg/repo_tag return "", scoped_memo passes the suffix through.

fn repo_arg(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return " --repo " + shell_escape(owner + "/" + repo);
}

fn repo_tag(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return "repo:" + owner + "/" + repo;
}

fn scoped_memo(owner: string, repo: string, suffix: string) -> string {
    if len(owner) == 0 { return suffix; };
    return owner + "__" + repo + ":" + suffix;
}

// #316 M4: per-repo confidence read with legacy fallback. Mirrors the
// runtime tier() builtin's threshold table from ADR-0001 / CLAUDE.md.
// `agent_name` (not `agent`) — `agent` is a reserved keyword in `.ag`.
fn repo_tier(agent_name: string, owner: string, repo: string) -> string {
    let raw = if len(owner) == 0 {
        recall_latest(agent_name + ":confidence");
    } else {
        let scoped = recall_latest(scoped_memo(owner, repo, agent_name + ":confidence"));
        if len(scoped) > 0 { scoped; } else { recall_latest(agent_name + ":confidence"); };
    };
    if len(raw) == 0 { return "dormant"; };
    let c = parse_float(raw);
    if c >= 0.95 { return "autonomous"; };
    if c >= 0.8  { return "review-gated"; };
    if c >= 0.6  { return "propose"; };
    if c >= 0.4  { return "shadow"; };
    return "dormant";
}

fn repo_field(line: string, idx: int) -> string {
    let cmd = "L=" + shell_escape(line) + " I=" + to_string(idx) +
        " python3 -c 'import os; parts=os.environ[\"L\"].split(\"\t\"); i=int(os.environ[\"I\"]); print(parts[i] if 0<=i<len(parts) else \"\")'";
    let out = try { exec sh cmd; } catch e { ""; };
    return out;
}

// #147: build the merged-MR delta query with optional --since. Used by
// the tick's pre-prompt delta-check to tell whether any release-relevant
// work has landed since the last tick.
fn mr_delta_cmd_for(owner: string, repo: string, ts: string) -> string {
    // colony-lint: safe-exec-concat
    if len(ts) > 0 {
        return "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --since " + shell_escape(ts) + " --per-page 1" + repo_arg(owner, repo);
    };
    // colony-lint: safe-exec-concat
    return "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --per-page 1" + repo_arg(owner, repo);
}

// --- #1453 Wave 1: reality-check feedback loop ---
//
// Single-slot pending-verdict idiom from the triage/labeler pilot
// (#106/#195). ship_decide has no per-decision artefact id (the decision is
// about the release as a whole, not one MR/issue), so the verdict stores a
// TAG BASELINE instead: a "ship" call held up if the repo's latest tag
// moved past the baseline (a release was actually cut). No prompt()
// anywhere on this path.

// #1453 Wave 1: reality-check — map the reality-check signal to the
// experience-store outcome enum.
fn signal_to_outcome(signal: int) -> string {
    if signal == 1 {
        return "success";
    };
    if signal == 2 {
        return "partial";
    };
    return "failure";
}

// #1453 Wave 1: reality-check — age (seconds) of a pending-verdict blob.
fn verdict_age_seconds(blob: string) -> int {
    let emit_ts = parse_int(to_string(json_get(blob, "[0]")));
    let now_raw = try { exec sh "date +%s"; } catch e { "0"; };
    let now = parse_int(now_raw);
    return now - emit_ts;
}

// #1453 Wave 1: reality-check — sanitized CSV of up to 50 tag names, or
// the sentinel "__QUERY_FAILED__" when the tags query failed/unparseable.
// A SET of names (not "[0].name") because GitHub's /tags endpoint is not
// chronologically ordered — the newest tag is not guaranteed first, so
// "latest tag changed" is unsound there; "a tag exists that was not in
// the baseline set" is sound on both backends. Names are sanitized
// (quotes/backslashes/commas stripped) so the naive-concat JSON blob and
// the CSV separator stay valid even for exotic-but-legal git tag names.
// The sentinel keeps "repo has no tags" ("" — legitimate baseline)
// distinct from "query failed" (must not be stashed or compared: a
// failed stash-time query in a tagged repo would otherwise make any
// pre-existing tag look like a fresh release = false success).
fn tag_set_csv(owner: string, repo: string) -> string {
    // colony-lint: safe-exec-concat
    let tags_cmd = "$COLONY_DIR/scripts/forge-api.sh tags --per-page 50" + repo_arg(owner, repo);
    let raw = try { exec sh tags_cmd; } catch e { ""; };
    if index_of(raw, "[") != 0 { return "__QUERY_FAILED__"; };
    let csv_cmd = "RAW=" + shell_escape(raw) +
        " python3 -c 'import os,json" +
        "\ntry:" +
        "\n    d=json.loads(os.environ[\"RAW\"])" +
        "\nexcept Exception:" +
        "\n    print(\"__QUERY_FAILED__\"); raise SystemExit" +
        "\nnames=sorted({str(x.get(\"name\",\"\")).replace(\",\",\"\").replace(chr(34),\"\").replace(chr(92),\"\") for x in d if isinstance(x,dict)} - {\"\"})" +
        "\nprint(\",\".join(names))'";
    let out = try { exec sh csv_cmd; } catch e { "__QUERY_FAILED__"; };
    return out;
}

// #1453 Wave 1: reality-check — record a pending ship verdict. Stored as
// JSON array [ts, 0, "baseline_csv"] (id slot fixed at 0 — no artefact
// id; see block comment above). baseline_csv is the sanitized tag-name
// set at decision time ("" when the repo has no tags yet). A failed
// tags query (sentinel) skips the stash entirely — never stash a
// baseline the evaluator could misread.
fn record_ship_verdict(owner: string, repo: string, baseline_csv: string) -> void {
    if baseline_csv == "__QUERY_FAILED__" {
        print("[ship_decider] tags query failed — skipping ship verdict stash");
        return;
    };
    let ts_raw = try { exec sh "date +%s"; } catch e { "0"; };
    let blob = "[" + ts_raw + ",0,\"" + baseline_csv + "\"]";
    memo_write(scoped_memo(owner, repo, "ship_decider:pending_verdict"), blob);
    print("[ship_decider] ship verdict recorded: baseline tags", baseline_csv);
}

// #1453 Wave 1: reality-check — score the pending ship verdict against the
// repo's tag set. A tag present now that was NOT in the stashed baseline
// set means a release was actually cut after our ship verdict — signal 1,
// success. While the set is unchanged the verdict stays pending, and the
// 24h ageout drops it WITHOUT scoring (pilot semantics): "operator did
// not release within a day" is too ambiguous to score — release batching
// is a normal workflow, and learn("partial") carries a positive delta,
// so scoring it would quietly reward ignored ship calls. The signal is
// therefore success-only; see doc/feedback-loop.md for the closed-loop
// caveat (an autonomous version_bumper cuts tags itself, so this measures
// the pipeline's follow-through, operator validation only at
// sub-autonomous version_bumper tiers). Mechanical compare — never a
// prompt().
fn evaluate_ship_verdict(owner: string, repo: string) -> void {
    let key = scoped_memo(owner, repo, "ship_decider:pending_verdict");
    let blob = recall_latest(key);
    if len(blob) < 3 {
        return;
    };
    let emit_ts = parse_int(to_string(json_get(blob, "[0]")));
    if emit_ts <= 0 {
        // Corrupt blob or failed stash-time clock — nothing scorable.
        memo_write(key, "");
        return;
    };
    let baseline = to_string(json_get(blob, "[2]"));
    if baseline == "void" {
        memo_write(key, "");
        return;
    };
    let cur = tag_set_csv(owner, repo);
    if cur != "__QUERY_FAILED__" {
        let diff_cmd = "BASE=" + shell_escape(baseline) + " CUR=" + shell_escape(cur) +
            " python3 -c 'import os" +
            "\nsplit=lambda s:{x for x in s.split(\",\") if x}" +
            "\nprint(1 if split(os.environ[\"CUR\"]) - split(os.environ[\"BASE\"]) else 0)'";
        let signal_raw = try { exec sh diff_cmd; } catch e { "0"; };
        if parse_int(signal_raw) == 1 {
            // A release was cut after our ship verdict — the call held up.
            let outcome_s = signal_to_outcome(1);
            if len(owner) > 0 {
                learn("ship_decide", "ship reality-check", "new tag beyond baseline [" + baseline + "] | signal: 1", outcome_s, ["acted", "release", repo_tag(owner, repo)]);
            } else {
                learn("ship_decide", "ship reality-check", "new tag beyond baseline [" + baseline + "] | signal: 1", outcome_s, ["acted", "release"]);
            };
            print("[ship_decider] reality-check: new tag after ship verdict ->", outcome_s);
            memo_write(key, "");
            return;
        };
    };
    let timeout_s = 86400;
    if verdict_age_seconds(blob) > timeout_s {
        print("[ship_decider] ship verdict aged out without a release — dropped unscored");
        memo_write(key, "");
        return;
    };
    // Tag set unchanged (or query failed) and still inside the 24h
    // window — leave pending.
}

fn tick_for_repo(owner: string, repo: string) -> void {
    // #1453 Wave 1: reality-check — score any pending ship verdict from a
    // previous tick FIRST, before the delta gate's early-exit below. Cheap
    // no-op when nothing is pending.
    evaluate_ship_verdict(owner, repo);

    // #147: cheap delta-check BEFORE any prompt(). ship_decider's work
    // is reactive: decide ship/no-ship when `release:check_result`
    // arrives, and re-learn release cadence when new merged MRs show
    // up. If neither signal is present since the last tick, early-exit
    // — no Claude call at all.
    let check_result = listen("release:check_result", 100);
    let check_str = to_string(check_result);
    let has_event = len(check_str) >= 5;

    let mr_delta_cmd = mr_delta_cmd_for(owner, repo, recall_latest(scoped_memo(owner, repo, "ship_decider:last_check")));
    let mr_delta = try { exec sh mr_delta_cmd; } catch e { "[]"; };
    let has_new_mr = len(mr_delta) >= 3;

    if !has_event {
        if !has_new_mr {
            let now_e = try { exec sh "date -u +%Y-%m-%dT%H:%M:%SZ"; } catch e { ""; };
            if len(now_e) > 0 {
                memo_write(scoped_memo(owner, repo, "ship_decider:last_check"), now_e);
            };
            return;
        };
    };

    // 1. Learn release patterns from history (only when there IS new work)
    // colony-lint: safe-exec-concat
    let releases_cmd = "$COLONY_DIR/scripts/forge-api.sh releases --per-page 20 --view release-summary" + repo_arg(owner, repo);
    let releases_raw = try {
        exec sh releases_cmd;
    } catch e {
        print("[ship_decider] GitLab releases poll failed:", e);
        "";
    };

    if len(releases_raw) > 10 {
        // colony-lint: safe-exec-concat
        let tags_cmd = "$COLONY_DIR/scripts/forge-api.sh tags --per-page 20 --view tag-summary" + repo_arg(owner, repo);
        let tags_raw = try {
            exec sh tags_cmd;
        } catch e { "[]"; };

        let patterns = prompt(
            "Analyze these GitLab releases and tags. Identify: how many releases (releases_seen), release cadence (daily, weekly, per-milestone, irregular), what types of issues block releases (blocker_types: failing CI, open critical bugs, incomplete features), risk tolerance (are hotfixes common, are pre-release tags used, do releases happen on specific days). Return JSON: releases_seen (int), cadence (string), blocker_types (string), risk_tolerance (string).",
            releases_raw + "\n\nTags: " + tags_raw
        ) -> ShipPatterns;

        if patterns.releases_seen > 0 {
            if len(owner) > 0 {
                learn(
                    "ship_decide",
                    "batch of " + to_string(patterns.releases_seen) + " releases",
                    "cadence: " + patterns.cadence + " | blockers: " + patterns.blocker_types + " | risk: " + patterns.risk_tolerance,
                    "success",
                    ["observed", "release", repo_tag(owner, repo)]
                );
            } else {
                learn(
                    "ship_decide",
                    "batch of " + to_string(patterns.releases_seen) + " releases",
                    "cadence: " + patterns.cadence + " | blockers: " + patterns.blocker_types + " | risk: " + patterns.risk_tolerance,
                    "success",
                    ["observed", "release"]
                );
            };
            print("[ship_decider] Learned from", patterns.releases_seen, "past releases");
        };
    };

    // 2. Make ship/no-ship decision — only if a check_result arrived
    //    this tick (the MR-delta branch re-learns patterns but has no
    //    pending check to decide on).
    if !has_event {
        let now_e = try { exec sh "date -u +%Y-%m-%dT%H:%M:%SZ"; } catch e { ""; };
        if len(now_e) > 0 {
            memo_write(scoped_memo(owner, repo, "ship_decider:last_check"), now_e);
        };
        return;
    };

    let rec = recommend("ship_decide", ["accuracy"]);
    let context = "Pre-release check results: " + check_str + "\nLearned shipping patterns: " + to_string(rec);

    let decision = prompt(
        "You are a ship decider agent. Based on the pre-release check results and learned shipping patterns, make a ship/no-ship decision. Consider: is CI green, are there blockers, does this match the learned cadence and risk tolerance. Return JSON: decision (string, 'ship' or 'no-ship'), reasoning (string, 2-3 sentences explaining the decision), blockers (string, list of blockers or 'none'), confidence (float 0-1).",
        context
    ) -> ShipDecision;

    let my_tier = repo_tier("ship_decider", owner, repo);
    print("[ship_decider] Decision:", decision.decision, "(tier:", my_tier, ")");

    // ship_decider produces a non-terminal signal — it never tags, merges,
    // or publishes. autonomous = post directly to the MR + emit on bus.
    // review-gated = post draft-flagged note + emit. propose = emit only.
    // shadow/dormant = observe.
    if my_tier == "autonomous" {
        // colony-lint: safe-exec-concat
        let mr_listing_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --per-page 1" + repo_arg(owner, repo);
        let mr_raw = try { exec sh mr_listing_cmd; } catch e { "[]"; };
        let mr_iid = parse_int(to_string(json_get(mr_raw, "[0].iid")));
        if mr_iid > 0 {
            let note = "**Ship Decision** (automated): " + decision.decision + "\n\n" + decision.reasoning;
            // colony-lint: safe-exec-concat
            let post_cmd = "$COLONY_DIR/scripts/forge-api.sh post-note " + to_string(mr_iid) + " --body " + shell_escape(note) + repo_arg(owner, repo);
            try { exec sh post_cmd; } catch e {
                print("[ship_decider] Failed to post note:", e);
            };
        };
        // #1453 Wave 1: reality-check — a "ship" verdict is scored against
        // whether a release (new tag) actually follows; stash the current
        // tag baseline now. no-ship verdicts have no mechanical ground
        // truth here and are not stashed.
        if decision.decision == "ship" {
            record_ship_verdict(owner, repo, tag_set_csv(owner, repo));
        };
        emit("release:ship_decision", decision);
        if len(owner) > 0 {
            learn("ship_decide", "decision: " + decision.decision, decision.reasoning, "success", ["acted", "release", repo_tag(owner, repo)]);
        } else {
            learn("ship_decide", "decision: " + decision.decision, decision.reasoning, "success", ["acted", "release"]);
        };
    } else {
        if my_tier == "review-gated" {
            // colony-lint: safe-exec-concat
            let mr_listing_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --per-page 1" + repo_arg(owner, repo);
            let mr_raw = try { exec sh mr_listing_cmd; } catch e { "[]"; };
            let mr_iid = parse_int(to_string(json_get(mr_raw, "[0].iid")));
            if mr_iid > 0 {
                let note = "[draft-ship] **Ship Decision** (automated, pending approval): " + decision.decision + "\n\n" + decision.reasoning;
                // colony-lint: safe-exec-concat
                let post_cmd = "$COLONY_DIR/scripts/forge-api.sh post-note " + to_string(mr_iid) + " --body " + shell_escape(note) + repo_arg(owner, repo);
                try { exec sh post_cmd; } catch e {
                    print("[ship_decider] Failed to post draft note:", e);
                };
            };
            // #1453 Wave 1: reality-check — stash the tag baseline for a
            // drafted "ship" verdict too (the operator acting on the draft
            // by cutting a release is the ground-truth signal).
            if decision.decision == "ship" {
                record_ship_verdict(owner, repo, tag_set_csv(owner, repo));
            };
            emit("release:ship_decision", decision);
            if len(owner) > 0 {
                learn("ship_decide", "decision: " + decision.decision, decision.reasoning, "partial", ["release", "review-gated", repo_tag(owner, repo)]);
            } else {
                learn("ship_decide", "decision: " + decision.decision, decision.reasoning, "partial", ["release", "review-gated"]);
            };
        } else {
            if my_tier == "propose" {
                emit("release:ship_decision", decision);
                if len(owner) > 0 {
                    learn("ship_decide", "decision: " + decision.decision, decision.reasoning, "partial", ["emitted", "release", repo_tag(owner, repo)]);
                } else {
                    learn("ship_decide", "decision: " + decision.decision, decision.reasoning, "partial", ["emitted", "release"]);
                };
            } else {
                print("[ship_decider] Observing (tier:", my_tier, ")");
                if len(owner) > 0 {
                    learn("ship_decide", "decision: " + decision.decision, decision.reasoning, "partial", ["observed", "release", repo_tag(owner, repo)]);
                } else {
                    learn("ship_decide", "decision: " + decision.decision, decision.reasoning, "partial", ["observed", "release"]);
                };
            };
        };
    };

    let now = try { exec sh "date -u +%Y-%m-%dT%H:%M:%SZ"; } catch e { ""; };
    if len(now) > 0 {
        memo_write(scoped_memo(owner, repo, "ship_decider:last_check"), now);
    };
}

// Recursive iterator over `iter-repos.sh` output. See router.ag for the
// empty-owner sentinel rationale.
fn tick_at(spool: string, line_no: int) -> void {
    let line_cmd = "SP=" + shell_escape(spool) + " N=" + to_string(line_no) +
        " python3 -c 'import os; lines=os.environ[\"SP\"].splitlines(); n=int(os.environ[\"N\"]); print(lines[n] if 0<=n<len(lines) else \"\")'";
    let line = try { exec sh line_cmd; } catch e { ""; };
    if len(line) == 0 { return; };
    let owner = repo_field(line, 0);
    let repo = repo_field(line, 1);
    tick_for_repo(owner, repo);
    return tick_at(spool, line_no + 1);
}

fn tick(reason: string) -> void {
    // #316 M3b: per-repo fan-out. See triage/agents/router.ag for the
    // back-compat sentinel pattern and byte-identity rationale.
    let spool = try { exec sh "$COLONY_DIR/../../tools/iter-repos.sh"; } catch e { ""; };
    if len(spool) == 0 {
        return;
    };
    tick_at(spool, 0);
}
