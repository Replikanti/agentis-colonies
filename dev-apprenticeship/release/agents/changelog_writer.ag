// changelog_writer.ag -- Release colony: learns changelog conventions.
//
// Observes past release notes and MR descriptions to learn how you write
// changelogs: grouping style (by type, by scope), what to include/exclude,
// tone and audience. When a ship decision arrives, compiles release notes
// from merged MRs since the last release.
//
// Run as daemon: agentis daemon agents/changelog_writer.ag --colony release
// Requires: exec_foreign capability, GITLAB_* env vars

cb 800;

type ChangelogStyle {
    releases_seen: int,
    grouping: string,
    tone: string,
    inclusions: string,
    exclusions: string
}

type ChangelogDraft {
    version: string,
    changelog: string,
    mr_count: int,
    confidence: float
}

// #316 M3b: per-tick fan-out helpers. See triage/agents/router.ag for
// the full rationale. Single-block configs collapse to owner=="" sentinel,
// repo_arg/repo_tag return "", scoped_memo passes the suffix through.

fn repo_arg(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return " --repo " + shell_escape(owner + "/" + repo);
}

fn repo_tag(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return "repo:" + owner + "/" + repo;
}

fn scoped_memo(owner: string, repo: string, suffix: string) -> string {
    if len(owner) == 0 { return suffix; };
    return owner + "__" + repo + ":" + suffix;
}

// #316 M4: per-repo confidence read with legacy fallback. Mirrors the
// runtime tier() builtin's threshold table from ADR-0001 / CLAUDE.md.
// `agent_name` (not `agent`) — `agent` is a reserved keyword in `.ag`.
fn repo_tier(agent_name: string, owner: string, repo: string) -> string {
    let raw = if len(owner) == 0 {
        recall_latest(agent_name + ":confidence");
    } else {
        let scoped = recall_latest(scoped_memo(owner, repo, agent_name + ":confidence"));
        if len(scoped) > 0 { scoped; } else { recall_latest(agent_name + ":confidence"); };
    };
    if len(raw) == 0 { return "dormant"; };
    let c = parse_float(raw);
    if c >= 0.95 { return "autonomous"; };
    if c >= 0.8  { return "review-gated"; };
    if c >= 0.6  { return "propose"; };
    if c >= 0.4  { return "shadow"; };
    return "dormant";
}

// #1358: nth 0-based sep-delimited field of `s`, walked natively with
// index_of/substring — `.ag` v1.7 has no split(s, sep) builtin, so this
// recursive walk is the workaround (a general split(s, sep) -> list<string>
// builtin is a candidate upstream agentis-core language ask). Serves both the
// tab-separated iter-repos records (repo_field) and tick_at's newline-split
// spool reader. Total: out-of-range / negative n -> "", mirroring the
// bounds-checked python one-liner it replaces.
fn nth_field(s: string, sep: string, n: int) -> string {
    if n < 0 { return ""; };
    if len(s) == 0 { return ""; };
    let p = index_of(s, sep);
    if n == 0 {
        if p < 0 { return s; };
        return substring(s, 0, p);
    };
    if p < 0 { return ""; };
    return nth_field(substring(s, p + len(sep), len(s)), sep, n - 1);
}

// #1358: tab-separated field read, now native via nth_field (was an inline
// python3 -c split). Total: missing field / out-of-range idx -> "".
fn repo_field(line: string, idx: int) -> string {
    return nth_field(line, "\t", idx);
}

// --- #1453 Wave 2 M4: reality-check feedback loop ---
//
// changelog_writer's draft is a non-terminal external write — it never
// ships anything itself (that's version_bumper's terminal create-tag/
// create-release, gated separately). Mirroring ship_decider's posture
// exactly (success-only, #1453 Wave 1), the ground truth here is whether a
// release was actually cut AFTER our draft — newest_release_tag()'s
// tag_name compared against the baseline stashed when we posted the draft.
// Both backends' `releases` verb returns pre-sorted newest-first (see
// release_checker.ag's identical helper for the backend detail), so a
// plain string compare of the newest tag_name is sound — no set-diff, no
// python3.

// #1453 Wave 2 M4: reality-check — map the reality-check signal to the
// experience-store outcome enum.
fn signal_to_outcome(signal: int) -> string {
    if signal == 1 {
        return "success";
    };
    if signal == 2 {
        return "partial";
    };
    return "failure";
}

// #1453 Wave 2 M4: reality-check — age (seconds) of a pending-verdict blob.
fn verdict_age_seconds(blob: string) -> int {
    let emit_ts = parse_int(to_string(json_get(blob, "[0]")));
    let now_raw = to_string(now_ms() / 1000);
    let now = parse_int(now_raw);
    return now - emit_ts;
}

// #1453 Wave 2 M4: reality-check — newest release tag_name, or "" when the
// repo has no releases yet, or the sentinel "__QUERY_FAILED__" when the
// query failed/unparseable. `.ag` has no imports — own copy, byte-identical
// to release_checker.ag's helper of the same name.
fn newest_release_tag(owner: string, repo: string) -> string {
    // colony-lint: safe-exec-concat
    let releases_cmd = "$COLONY_DIR/scripts/forge-api.sh releases --per-page 1 --view release-summary" + repo_arg(owner, repo);
    let raw = try { exec sh releases_cmd; } catch e { ""; };
    if index_of(raw, "[") != 0 { return "__QUERY_FAILED__"; };
    let tag = to_string(json_get(raw, "[0].tag_name"));
    if tag == "void" { return ""; };
    return tag;
}

// #1453 Wave 2 M4: reality-check — record a pending changelog verdict.
// Stored as JSON array [ts, 0, "baseline_tag"] (id slot fixed at 0 — no
// artefact id; the draft isn't durably keyed to one MR the way
// release_checker's is). A failed releases query (sentinel) skips the
// stash entirely — never stash a baseline the evaluator could misread.
fn record_changelog_verdict(owner: string, repo: string, baseline_tag: string) -> void {
    if baseline_tag == "__QUERY_FAILED__" {
        print("[changelog_writer] releases query failed — skipping changelog verdict stash");
        return;
    };
    let ts_raw = to_string(now_ms() / 1000);
    let blob = "[" + ts_raw + ",0,\"" + baseline_tag + "\"]";
    memo_write(scoped_memo(owner, repo, "changelog_writer:pending_verdict"), blob);
    print("[changelog_writer] changelog verdict recorded: baseline tag", baseline_tag);
}

// #1453 Wave 2 M4: reality-check — score the pending changelog verdict.
// Success-only, mirroring ship_decider's posture exactly: the newest
// release tag_name differing from the stashed baseline (and non-empty,
// non-sentinel) means a release was actually cut after our draft — signal
// 1, success. While unchanged the verdict stays pending, and the 24h
// ageout drops it WITHOUT scoring: a draft not yet shipped is not a wrong
// draft, release batching is a normal workflow, and learn("partial") would
// carry a positive delta and quietly reward ignored release work (same
// rationale ship_decider's doc comment already states). Mechanical compare
// — never a prompt().
fn evaluate_changelog_verdict(owner: string, repo: string) -> void {
    let key = scoped_memo(owner, repo, "changelog_writer:pending_verdict");
    let blob = recall_latest(key);
    if len(blob) < 3 {
        return;
    };
    let emit_ts = parse_int(to_string(json_get(blob, "[0]")));
    if emit_ts <= 0 {
        memo_write(key, "");
        return;
    };
    let baseline = to_string(json_get(blob, "[2]"));
    if baseline == "void" {
        memo_write(key, "");
        return;
    };

    // Re-query ground truth via newest_release_tag(): a single
    // `releases --per-page 1 --view release-summary` fetch +
    // json_get(raw, "[0].tag_name") — both backends return releases
    // pre-sorted newest-first, so no ordering logic is needed here.
    let cur = newest_release_tag(owner, repo);
    if cur != "__QUERY_FAILED__" {
        if len(cur) > 0 {
            if cur != baseline {
                let outcome_s = signal_to_outcome(1);
                if len(owner) > 0 {
                    learn("changelog_write", "changelog reality-check", "new release tag [" + cur + "] beyond baseline [" + baseline + "] | signal: 1", outcome_s, ["acted", "release", repo_tag(owner, repo)]);
                } else {
                    learn("changelog_write", "changelog reality-check", "new release tag [" + cur + "] beyond baseline [" + baseline + "] | signal: 1", outcome_s, ["acted", "release"]);
                };
                print("[changelog_writer] reality-check: release cut after draft ->", outcome_s);
                memo_write(key, "");
                return;
            };
        };
    };

    let timeout_s = 86400;
    if verdict_age_seconds(blob) > timeout_s {
        print("[changelog_writer] changelog verdict aged out without a release — dropped unscored");
        memo_write(key, "");
        return;
    };
    // Newest release tag unchanged (or query failed) and still inside the
    // 24h window — leave pending.
}

fn tick_for_repo(owner: string, repo: string) -> void {
    // #1453 Wave 2 M4: reality-check — score any pending changelog verdict
    // from a previous tick FIRST, before the event-listen early-exit below.
    // Cheap no-op when nothing is pending.
    evaluate_changelog_verdict(owner, repo);

    // #147: changelog_writer is pure event-driven. It reacts to a
    // `release:ship_decision` emit from ship_decider. If the inbox is
    // empty, early-exit before any prompt() (including the release-
    // note style-learning one, which used to run every tick).
    let ship_decision = listen("release:ship_decision", 100);
    let decision_str = to_string(ship_decision);

    if len(decision_str) < 5 {
        let now_e = now_iso();
        if len(now_e) > 0 {
            memo_write(scoped_memo(owner, repo, "changelog_writer:last_check"), now_e);
        };
        return;
    };

    // 1. Learn changelog style from past releases (only when we're
    //    actually about to write one — gated by the delta-check above).
    // colony-lint: safe-exec-concat
    let releases_cmd = "$COLONY_DIR/scripts/forge-api.sh releases --per-page 10 --view release-summary" + repo_arg(owner, repo);
    let releases_raw = try {
        exec sh releases_cmd;
    } catch e {
        print("[changelog_writer] GitLab releases poll failed:", e);
        "";
    };

    if len(releases_raw) > 10 {
        let style = prompt(
            "Analyze these GitLab release descriptions/notes. Identify: how many have descriptions (releases_seen), how changes are grouped (grouping: by type like feat/fix/chore, by component, flat list), tone (technical, user-facing, mixed), what is included (inclusions: MR titles, commit messages, breaking changes, contributors), what is excluded (exclusions: internal refactors, dependency bumps, CI changes). Return JSON: releases_seen (int), grouping (string), tone (string), inclusions (string), exclusions (string).",
            releases_raw
        ) -> ChangelogStyle;

        if style.releases_seen > 0 {
            if len(owner) > 0 {
                learn(
                    "changelog_write",
                    "batch of " + to_string(style.releases_seen) + " releases",
                    "grouping: " + style.grouping + " | tone: " + style.tone + " | include: " + style.inclusions + " | exclude: " + style.exclusions,
                    "success",
                    ["observed", "release", repo_tag(owner, repo)]
                );
            } else {
                learn(
                    "changelog_write",
                    "batch of " + to_string(style.releases_seen) + " releases",
                    "grouping: " + style.grouping + " | tone: " + style.tone + " | include: " + style.inclusions + " | exclude: " + style.exclusions,
                    "success",
                    ["observed", "release"]
                );
            };
            print("[changelog_writer] Learned from", style.releases_seen, "past release notes");
        };
    };

    // Only proceed if the decision is "ship"
    let is_ship = prompt(
        "Does this ship decision say 'ship' (not 'no-ship')? Return 'yes' or 'no', nothing else.",
        decision_str
    ) -> string;

    if is_ship != "yes" {
        print("[changelog_writer] Ship decision is no-ship, skipping changelog");
        let now = now_iso();
        if len(now) > 0 {
            memo_write(scoped_memo(owner, repo, "changelog_writer:last_check"), now);
        };
        return;
    };

    // Get the latest release tag to find MRs merged since then
    // colony-lint: safe-exec-concat
    let latest_release_cmd = "$COLONY_DIR/scripts/forge-api.sh releases --per-page 1 --view release-summary" + repo_arg(owner, repo);
    let latest_release = try {
        exec sh latest_release_cmd;
    } catch e { "[]"; };

    let since_date = prompt(
        "Extract the created_at or released_at date from this GitLab release JSON array (take the first element). Return just the ISO 8601 date string, nothing else. If the array is empty, return '2000-01-01T00:00:00Z'.",
        latest_release
    ) -> string;

    // Fetch MRs merged since last release
    // colony-lint: safe-exec-concat
    let mrs_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --since " + shell_escape(since_date) + " --view release-mr" + repo_arg(owner, repo);
    let mrs_raw = try { exec sh mrs_cmd; } catch e {
        print("[changelog_writer] MR fetch failed:", e);
        "";
    };

    if len(mrs_raw) > 10 {
        let rec = recommend("changelog_write", ["accuracy"]);
        let context = "Merged MRs since last release: " + mrs_raw + "\nShip decision: " + decision_str + "\nLearned changelog conventions: " + to_string(rec);

        let draft = prompt(
            "You are a changelog writer agent. Compile release notes from the merged MRs following learned conventions. Group changes by type, use the learned tone, include/exclude items as learned. Determine the version string from the MR content (or leave as 'TBD' if unclear). Return JSON: version (string), changelog (string, the formatted release notes in markdown), mr_count (int, number of MRs included), confidence (float 0-1).",
            context
        ) -> ChangelogDraft;

        let my_tier = repo_tier("changelog_writer", owner, repo);
        print("[changelog_writer] Drafted changelog for", draft.version, "(", draft.mr_count, "MRs, tier:", my_tier, ")");

        // Posting a release-notes draft as a note on the MR is a non-terminal
        // external write. The terminal action (create-release / create-tag)
        // belongs to version_bumper and is gated on autonomous there.
        if my_tier == "autonomous" {
            // colony-lint: safe-exec-concat
            let mr_listing_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --per-page 1" + repo_arg(owner, repo);
            let mr_raw = try { exec sh mr_listing_cmd; } catch e { "[]"; };
            let mr_iid = parse_int(to_string(json_get(mr_raw, "[0].iid")));
            if mr_iid > 0 {
                let note = "**Release Notes Draft** (automated)\n\n" + draft.changelog;
                // colony-lint: safe-exec-concat
                let post_cmd = "$COLONY_DIR/scripts/forge-api.sh post-note " + to_string(mr_iid) + " --body " + shell_escape(note) + repo_arg(owner, repo);
                try { exec sh post_cmd; } catch e {
                    print("[changelog_writer] Failed to post note:", e);
                };
            };
            emit("release:changelog_draft", draft);
            // #1453 Wave 2 M4: reality-check — stash the newest-release
            // baseline now; evaluate_changelog_verdict re-queries it on a
            // later tick to see whether a release was actually cut after
            // this draft.
            record_changelog_verdict(owner, repo, newest_release_tag(owner, repo));
            if len(owner) > 0 {
                learn("changelog_write", "release " + draft.version, to_string(draft.mr_count) + " MRs", "success", ["acted", "release", repo_tag(owner, repo)]);
            } else {
                learn("changelog_write", "release " + draft.version, to_string(draft.mr_count) + " MRs", "success", ["acted", "release"]);
            };
        } else {
            if my_tier == "review-gated" {
                // colony-lint: safe-exec-concat
                let mr_listing_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --per-page 1" + repo_arg(owner, repo);
                let mr_raw = try { exec sh mr_listing_cmd; } catch e { "[]"; };
                let mr_iid = parse_int(to_string(json_get(mr_raw, "[0].iid")));
                if mr_iid > 0 {
                    let note = "[draft-changelog] **Release Notes Draft** (automated, pending approval)\n\n" + draft.changelog;
                    // colony-lint: safe-exec-concat
                    let post_cmd = "$COLONY_DIR/scripts/forge-api.sh post-note " + to_string(mr_iid) + " --body " + shell_escape(note) + repo_arg(owner, repo);
                    try { exec sh post_cmd; } catch e {
                        print("[changelog_writer] Failed to post draft note:", e);
                    };
                };
                emit("release:changelog_draft", draft);
                if len(owner) > 0 {
                    learn("changelog_write", "release " + draft.version, to_string(draft.mr_count) + " MRs", "partial", ["release", "review-gated", repo_tag(owner, repo)]);
                } else {
                    learn("changelog_write", "release " + draft.version, to_string(draft.mr_count) + " MRs", "partial", ["release", "review-gated"]);
                };
            } else {
                if my_tier == "propose" {
                    emit("release:changelog_draft", draft);
                    if len(owner) > 0 {
                        learn("changelog_write", "release " + draft.version, to_string(draft.mr_count) + " MRs", "partial", ["emitted", "release", repo_tag(owner, repo)]);
                    } else {
                        learn("changelog_write", "release " + draft.version, to_string(draft.mr_count) + " MRs", "partial", ["emitted", "release"]);
                    };
                } else {
                    print("[changelog_writer] Observing (tier:", my_tier, ")");
                    if len(owner) > 0 {
                        learn("changelog_write", "release " + draft.version, to_string(draft.mr_count) + " MRs", "partial", ["observed", "release", repo_tag(owner, repo)]);
                    } else {
                        learn("changelog_write", "release " + draft.version, to_string(draft.mr_count) + " MRs", "partial", ["observed", "release"]);
                    };
                };
            };
        };
    };

    let now = now_iso();
    if len(now) > 0 {
        memo_write(scoped_memo(owner, repo, "changelog_writer:last_check"), now);
    };
}

// Recursive iterator over `iter-repos.sh` output. See router.ag for the
// empty-owner sentinel rationale.
fn tick_at(spool: string, line_no: int) -> void {
    // #1358: nth-line read via nth_field (newline sep) — was an inline
    // python3 -c splitlines() one-liner. Out-of-range line_no -> "", which
    // ends the recursion exactly like the old bounds-checked print.
    let line = nth_field(spool, "\n", line_no);
    if len(line) == 0 { return; };
    let owner = repo_field(line, 0);
    let repo = repo_field(line, 1);
    tick_for_repo(owner, repo);
    return tick_at(spool, line_no + 1);
}

fn tick(reason: string) -> void {
    // #316 M3b: per-repo fan-out. See triage/agents/router.ag for the
    // back-compat sentinel pattern and byte-identity rationale.
    let spool = try { exec sh "$COLONY_DIR/../../tools/iter-repos.sh"; } catch e { ""; };
    if len(spool) == 0 {
        return;
    };
    tick_at(spool, 0);
}
