// plan_reviewer.ag -- Planning colony: assembles the final plan.
//
// Listens for scope estimates, risk assessments, and task breakdowns
// from the three peer agents. Once all three have reported on the
// same issue, it assembles a combined plan (markdown), checks it
// against learned review criteria, and either posts it as a comment
// (high confidence) or emits it for human review (medium confidence).
//
// Partial peer outputs are stashed in memo under
// plan_reviewer:<issue_id>:<slot> so inputs arriving across multiple
// ticks can still be combined.
//
// Run as daemon: agentis daemon agents/plan_reviewer.ag --colony planning
// Requires: exec_foreign capability, GITLAB_* env vars

cb 1500;

type DraftPlan {
    issue_id: int,
    plan: string,
    review_score: float,
    confidence: float
}

fn get_confidence() -> float {
    let raw = recall_latest("plan_reviewer:confidence");
    if len(raw) > 0 {
        return parse_float(raw);
    };
    return 0.0;
}

// listen() returns Value::Void on timeout, which to_string() renders as the
// literal string "void". Treat that (and the empty string) as "no message".
fn received(s: string) -> bool {
    if s == "void" {
        return false;
    };
    return len(s) > 2;
}

// #316 M3b: per-tick fan-out helpers. See triage/agents/router.ag for
// the full rationale. Single-block configs collapse to owner=="" sentinel,
// repo_arg/repo_tag return "", scoped_memo passes the suffix through.

fn repo_arg(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return " --repo " + shell_escape(owner + "/" + repo);
}

fn repo_tag(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return "repo:" + owner + "/" + repo;
}

fn scoped_memo(owner: string, repo: string, suffix: string) -> string {
    if len(owner) == 0 { return suffix; };
    return owner + "__" + repo + ":" + suffix;
}

// #316 M4: per-repo confidence read with legacy fallback. Mirrors the
// runtime tier() builtin's threshold table from ADR-0001 / CLAUDE.md.
// `agent_name` (not `agent`) — `agent` is a reserved keyword in `.ag`.
fn repo_tier(agent_name: string, owner: string, repo: string) -> string {
    let raw = if len(owner) == 0 {
        recall_latest(agent_name + ":confidence");
    } else {
        let scoped = recall_latest(scoped_memo(owner, repo, agent_name + ":confidence"));
        if len(scoped) > 0 { scoped; } else { recall_latest(agent_name + ":confidence"); };
    };
    if len(raw) == 0 { return "dormant"; };
    let c = parse_float(raw);
    if c >= 0.95 { return "autonomous"; };
    if c >= 0.8  { return "review-gated"; };
    if c >= 0.6  { return "propose"; };
    if c >= 0.4  { return "shadow"; };
    return "dormant";
}

// #1358: nth 0-based sep-delimited field of `s`, walked natively with
// index_of/substring — `.ag` v1.7 has no split(s, sep) builtin, so this
// recursive walk is the workaround (a general split(s, sep) -> list<string>
// builtin is a candidate upstream agentis-core language ask). Serves both the
// tab-separated iter-repos records (repo_field) and tick_at's newline-split
// spool reader. Total: out-of-range / negative n -> "", mirroring the
// bounds-checked python one-liner it replaces.
fn nth_field(s: string, sep: string, n: int) -> string {
    if n < 0 { return ""; };
    if len(s) == 0 { return ""; };
    let p = index_of(s, sep);
    if n == 0 {
        if p < 0 { return s; };
        return substring(s, 0, p);
    };
    if p < 0 { return ""; };
    return nth_field(substring(s, p + len(sep), len(s)), sep, n - 1);
}

// #1358: tab-separated field read, now native via nth_field (was an inline
// python3 -c split). Total: missing field / out-of-range idx -> "".
fn repo_field(line: string, idx: int) -> string {
    return nth_field(line, "\t", idx);
}

// --- Forge rate-limit backoff observability (#1115) ---
//
// When a forge write fails because the backend is rate-limited (the
// gitlab-api.sh / github-api.sh wrapper returns exit 3 after exhausting its
// own jittered exponential retries), the agent must NOT mark the task failed.
// Instead it records a backoff window in `<agent>:rate_limited_until` and
// emits `planning:rate-limited` so the condition is observable, then defers
// the write to a later tick. The window grows exponentially across
// consecutive hits (`<agent>:rl_count`) with +/-25% jitter so many agents do
// not resynchronise their retries into a thundering herd. The LLM-backend
// HTTP-429 backoff / prompt cache lives in the agentis runtime / LLM backend
// (handled upstream); this helper only governs the colony-side forge calls.

fn rl_now_epoch() -> int {
    let raw = to_string(now_ms() / 1000);
    if len(raw) == 0 { return 0; };
    return parse_int(raw);
}

fn rl_active(agent_name: string, owner: string, repo: string) -> int {
    let until_raw = recall_latest(scoped_memo(owner, repo, agent_name + ":rate_limited_until"));
    if len(until_raw) == 0 { return 0; };
    let until = parse_int(until_raw);
    let now = rl_now_epoch();
    if now == 0 { return 0; };
    if until > now { return 1; };
    return 0;
}

// Compute a jittered exponential backoff (seconds) for the given hit count.
// base 5s, doubled per consecutive hit, capped at 300s, then +/-25% jitter
// via mod(now_ms()) so the value de-synchronizes concurrent agents' retries.
// The exponent is clamped to 6 BEFORE pow_int: 5*2^6=320 already saturates
// min(300, ...), so the clamp changes nothing about the output while
// removing pow_int's i64-overflow path for count beyond ~64 (#1597).
fn rl_backoff_secs(count: int) -> int {
    let exp = min_int(max_int(0, count - 1), 6);
    let base = min_int(300, 5 * pow_int(2, exp));
    let lo = base * 3 / 4;
    let hi = base * 5 / 4;
    if hi <= lo { return base; };
    return lo + mod(now_ms(), hi - lo + 1);
}

fn rl_mark(agent_name: string, owner: string, repo: string) -> void {
    let count_raw = recall_latest(scoped_memo(owner, repo, agent_name + ":rl_count"));
    let prev = if len(count_raw) > 0 { parse_int(count_raw); } else { 0; };
    let count = prev + 1;
    let now = rl_now_epoch();
    let backoff = rl_backoff_secs(count);
    let until = now + backoff;
    memo_write(scoped_memo(owner, repo, agent_name + ":rl_count"), to_string(count));
    memo_write(scoped_memo(owner, repo, agent_name + ":rate_limited_until"), to_string(until));
    emit("planning:rate-limited", agent_name + " backoff " + to_string(backoff) + "s until " + to_string(until));
    print("[plan_reviewer] rate-limited; backing off", backoff, "s (hit", count, ")");
}

fn rl_clear(agent_name: string, owner: string, repo: string) -> void {
    memo_write(scoped_memo(owner, repo, agent_name + ":rl_count"), "0");
    memo_write(scoped_memo(owner, repo, agent_name + ":rate_limited_until"), "0");
}

fn rl_is_limited(owner: string, repo: string) -> int {
    // colony-lint: safe-exec-concat
    let cmd = "$COLONY_DIR/scripts/forge-api.sh rate-limit-status" + repo_arg(owner, repo);
    let raw = try { exec sh cmd; } catch e { ""; };
    if len(raw) < 3 { return 0; };
    let val = to_string(json_get(raw, "remaining"));
    if val == "void" { return 0; };
    let remaining = parse_int(val);
    if remaining == 0 { return 1; };
    return 0;
}

fn stash(owner: string, repo: string, slot: string, issue_id: int, body: string) -> void {
    if len(body) > 2 {
        memo_write(scoped_memo(owner, repo, "plan_reviewer:" + to_string(issue_id) + ":" + slot), body);
    };
}

// #1370 (B2/B3): per-issue handled marker, written at EVERY tier (not just the
// post-able autonomous + review-gated tiers). Value = the tier the issue was
// handled at, so a future promotion can re-run by clearing the marker. The
// pre-#1370 `:posted` marker was only set in the branches that post a note, so
// at the default sub-autonomous tier the reviewer re-prompted every tick.
fn handled_key(owner: string, repo: string, iid: int) -> string {
    return scoped_memo(owner, repo, "plan_reviewer:" + to_string(iid) + ":handled");
}

fn is_handled(owner: string, repo: string, iid: int) -> bool {
    return len(recall_latest(handled_key(owner, repo, iid))) > 0;
}

// #1370: first iid (created_at asc, stable) whose handled marker is unset.
// Returns 0 when every listed issue is already handled — caller returns before
// prompt(). See scope_estimator.ag first_unhandled_iid for the recursion bound.
// With the stable created_at-asc ordering the four planning agents all pin to
// the SAME first-unhandled iid, so plan_reviewer converges on the issue its
// peers are actually completing instead of chasing a moving `[0]`.
fn first_unhandled_iid(owner: string, repo: string, issues_raw: string, idx: int) -> int {
    if idx >= 20 {
        return 0;
    };
    let iid = parse_int(to_string(json_get(issues_raw, "[" + to_string(idx) + "].iid")));
    if iid <= 0 {
        return 0;
    };
    if is_handled(owner, repo, iid) {
        return first_unhandled_iid(owner, repo, issues_raw, idx + 1);
    };
    return iid;
}

// #1370: peer readiness for a slot, reading BOTH the persistent peer-drafted
// key (plan_reviewer:<iid>:<slot>_drafted, written by the review-gated peers)
// and the transient stash slot (plan_reviewer:<iid>:<slot>, stashed from this
// tick's listen()). Either signal counts as "the peer completed this slot for
// this issue", so the reviewer converges on the same issue the peers actually
// finished instead of waiting only on the per-tick transient bus.
fn slot_body(owner: string, repo: string, iid: int, slot: string) -> string {
    return recall_latest(scoped_memo(owner, repo, "plan_reviewer:" + to_string(iid) + ":" + slot));
}

fn slot_ready(owner: string, repo: string, iid: int, slot: string) -> bool {
    // #1372: require the actual peer BODY, not just a readiness flag. The peers
    // now persist their full body to plan_reviewer:<iid>:<slot> at every tier
    // (durable hand-off), so the reviewer waits until the real scope / risk /
    // breakdown content is present instead of posting a skeleton plan the moment
    // a `:_drafted` flag is set (which it then self-scored ~0.3, blocking the
    // #1362 promote-gate and starving the needs-planning queue).
    return len(slot_body(owner, repo, iid, slot)) >= 2;
}

// #1453 Wave 1: reality-check — map the reality-check signal to the
// experience-store outcome enum. Signal 0 ("no signal yet") is handled by the
// caller via an early return and never reaches this function.
fn signal_to_outcome(signal: int) -> string {
    if signal == 1 {
        return "success";
    };
    if signal == 2 {
        return "partial";
    };
    return "failure";
}

// #1453 Wave 1: reality-check — record a pending verdict for an auto-promoted
// issue (#1362). Stored as JSON array [t, iid, "<impl_label>,<plan_label>"] —
// the fields are ASCII-safe (epoch int, iid int, label names carry no
// quotes/newlines/backslashes in practice) so naive concatenation is
// sufficient and we skip a JSON encoder. Single-slot idiom from labeler.ag:
// the next autonomous promotion overwrites; evaluate_plan_verdict scores it
// against the issue's current labels.
fn record_plan_verdict(owner: string, repo: string, issue_id: int, labels_csv: string) -> void {
    let ts_raw = to_string(now_ms() / 1000);
    let blob = "[" + ts_raw + "," + to_string(issue_id) + ",\"" + labels_csv + "\"]";
    memo_write(scoped_memo(owner, repo, "plan_reviewer:pending_verdict"), blob);
    print("[plan_reviewer] verdict recorded: issue", issue_id, "labels", labels_csv);
}

// #1453 Wave 1: reality-check — age of the pending verdict in seconds.
fn verdict_age_seconds(blob: string) -> int {
    let emit_ts = parse_int(to_string(json_get(blob, "[0]")));
    let now_raw = to_string(now_ms() / 1000);
    let now = parse_int(now_raw);
    return now - emit_ts;
}

// #1453 Wave 1: reality-check — score the pending promotion verdict against
// the issue's CURRENT labels. impl trigger label still present => the
// promotion survived (success); plan label re-added => the operator rejected
// the handoff (fail); neither present => ambiguous (partial). Deterministic
// membership check in python over the issue verb's labels array (both forge
// backends return labels flattened to strings), NEVER a prompt(). 24h ageout
// drops the verdict without scoring. Runs at the top of tick_for_repo before
// peer-slot collection.
fn evaluate_plan_verdict(owner: string, repo: string) -> void {
    let key = scoped_memo(owner, repo, "plan_reviewer:pending_verdict");
    let blob = recall_latest(key);
    if len(blob) < 3 {
        return;
    };
    let timeout_s = 86400;
    let age = verdict_age_seconds(blob);
    if age > timeout_s {
        print("[plan_reviewer] verdict aged out without signal");
        memo_write(key, "");
        return;
    };
    // Soak period (mirrors the pilot's #203 autonomous track): the impl
    // label was set by OUR OWN promotion, so "still present" one tick
    // later proves nothing — the operator needs time to notice and
    // react. Scoring before the soak elapses would self-award a success
    // for every promotion and reintroduce the structural optimism this
    // pattern exists to remove.
    let soak_s = 1800;
    if age < soak_s {
        return;
    };
    let issue_id = parse_int(to_string(json_get(blob, "[1]")));
    let labels_csv = to_string(json_get(blob, "[2]"));
    // A corrupt blob (json_get void) must not reach the compare: an
    // empty/"void" CSV would score a spurious partial instead of
    // staying pending. Drop it silently — nothing scorable remains. The
    // .ag dialect has no `||`, so the two drop conditions are separate ifs.
    if len(labels_csv) < 3 {
        memo_write(key, "");
        return;
    };
    if labels_csv == "void" {
        memo_write(key, "");
        return;
    };
    // colony-lint: safe-exec-concat
    let cur_cmd = "$COLONY_DIR/scripts/forge-api.sh issue " + to_string(issue_id) + repo_arg(owner, repo);
    let cur_raw = try { exec sh cur_cmd; } catch e { ""; };
    if len(cur_raw) < 3 {
        return;
    };
    // labels_csv is "<impl_label>,<plan_label>" as stashed by the promotion.
    // Output: 1 = impl label present, 3 = plan label re-added, 2 = neither.
    // A malformed payload collapses to "" via the try => parse_int 0 => leave
    // pending (the 24h ageout is the backstop).
    let match_cmd = "CSV=" + shell_escape(labels_csv) + " RAW=" + shell_escape(cur_raw) + " python3 -c 'import os, json; parts=[s.strip() for s in os.environ[\"CSV\"].split(\",\")]; impl=parts[0] if parts else \"\"; plan=parts[1] if len(parts)>1 else \"\"; act=set(json.loads(os.environ[\"RAW\"]).get(\"labels\") or []); print(1 if impl and impl in act else (3 if plan and plan in act else 2))'";
    let signal_raw = try { exec sh match_cmd; } catch e { "0"; };
    let signal = parse_int(signal_raw);
    if signal == 0 {
        return;
    };
    let outcome = signal_to_outcome(signal);
    if len(owner) > 0 {
        learn(
            "review_plan",
            "issue " + to_string(issue_id) + " reality-check",
            "promotion labels: " + labels_csv + " | signal: " + to_string(signal),
            outcome,
            ["acted", "planning", repo_tag(owner, repo)]
        );
    } else {
        learn(
            "review_plan",
            "issue " + to_string(issue_id) + " reality-check",
            "promotion labels: " + labels_csv + " | signal: " + to_string(signal),
            outcome,
            ["acted", "planning"]
        );
    };
    print("[plan_reviewer] reality-check: issue", issue_id, "signal", signal, "->", outcome);
    memo_write(key, "");
}

fn tick_for_repo(owner: string, repo: string) -> void {
    // #1453 Wave 1: reality-check — score the previous promotion verdict
    // FIRST, before peer-slot collection and its early returns.
    evaluate_plan_verdict(owner, repo);

    // 1. Collect peer outputs emitted this tick (partial over time).
    let scope = listen("planning:scope_estimate", 500);
    let risks = listen("planning:risks", 500);
    let breakdown = listen("planning:breakdown", 500);

    let scope_str = to_string(scope);
    let risks_str = to_string(risks);
    let breakdown_str = to_string(breakdown);

    // 2. Stash each partial under the issue id it belongs to.
    // #131: listen() returns the emitted record directly; we read
    // `issue_id` via field access (0 LLM calls) instead of stringifying
    // and re-prompting. The stash body keeps the Display repr because
    // the downstream assembly prompt consumes that.
    if received(scope_str) {
        stash(owner, repo, "scope", scope.issue_id, scope_str);
    };
    if received(risks_str) {
        stash(owner, repo, "risks", risks.issue_id, risks_str);
    };
    if received(breakdown_str) {
        stash(owner, repo, "breakdown", breakdown.issue_id, breakdown_str);
    };

    // 3. Pin to the first UNHANDLED unplanned issue (#1370 filter, below) and
    //    see if we have all three slots filled for it. If not, keep waiting.
    // #147: cheap delta-check. The query returns `[]` when every open
    // issue already has a plan, so we early-exit before the assembly
    // prompt(). last_check is refreshed so the agent's liveness signal
    // advances on quiet projects.
    // #1181: pickup keys on ASSIGNMENT, not label events. Always query the
    // current-state `issues --needs-planning` snapshot so an unplanned
    // issue stays visible on every tick, not just the first. The #223
    // `:posted` idempotency guard below prevents re-prompting once a plan
    // has been assembled.
    // colony-lint: safe-exec-concat
    let issues_cmd = "$COLONY_DIR/scripts/forge-api.sh issues --needs-planning --view planning" + repo_arg(owner, repo);
    let issues_raw = try {
        exec sh issues_cmd;
    } catch e {
        print("[plan_reviewer] GitLab unplanned-issue poll failed:", e);
        "";
    };

    if len(issues_raw) < 3 {
        let now_e = now_iso();
        if len(now_e) > 0 {
            memo_write(scoped_memo(owner, repo, "plan_reviewer:last_check"), now_e);
        };
        return;
    };

    // #1370 (B2/B3): filter already-handled issues BEFORE indexing, then pin to
    // the first UNHANDLED iid. With the stable created_at-asc ordering the four
    // planning agents all pin to the same iid, so plan_reviewer converges on
    // the issue its peers are actually completing instead of chasing a moving
    // `[0]` (the pre-#1370 thrash). If none remain unhandled, return before
    // prompt() — the idle-suppression win. This subsumes the pre-#1370 `[0]`
    // pick + `:posted` gate (the `:posted` marker was only set in the post-able
    // branches, so the reviewer re-prompted every tick at sub-autonomous tiers).
    let target_iid = first_unhandled_iid(owner, repo, issues_raw, 0);
    if target_iid <= 0 {
        let now_e = now_iso();
        if len(now_e) > 0 {
            memo_write(scoped_memo(owner, repo, "plan_reviewer:last_check"), now_e);
        };
        return;
    };
    let iid_str = to_string(target_iid);

    // #1115: rate-limit backoff gate. Defer the prompt + write (task is NOT
    // failed) while the jittered backoff window from a prior 429 is open.
    if rl_active("plan_reviewer", owner, repo) == 1 {
        print("[plan_reviewer] in rate-limit backoff; deferring this tick");
        return;
    };

    // #1370: readiness reads BOTH the persistent peer-drafted keys
    // (:scope_drafted/:risks_drafted/:breakdown_drafted, written by the
    // review-gated peers) and the transient stash slots — see slot_ready. The
    // assembly prompt still consumes the stashed bodies (s/r/b) when present.
    let s = slot_body(owner, repo, target_iid, "scope");
    let r = slot_body(owner, repo, target_iid, "risks");
    let b = slot_body(owner, repo, target_iid, "breakdown");

    if !slot_ready(owner, repo, target_iid, "scope") {
        print("[plan_reviewer] Waiting on scope for issue", target_iid);
        return;
    };
    if !slot_ready(owner, repo, target_iid, "risks") {
        print("[plan_reviewer] Waiting on risks for issue", target_iid);
        return;
    };
    if !slot_ready(owner, repo, target_iid, "breakdown") {
        print("[plan_reviewer] Waiting on breakdown for issue", target_iid);
        return;
    };

    // 4. Assemble the combined plan and score it against learned criteria.
    let rec = recommend("review_plan", ["completeness"]);
    let context = "Issue id: " + to_string(target_iid) +
        "\nScope estimate: " + s +
        "\nRisk assessment: " + r +
        "\nTask breakdown: " + b +
        "\nPast review criteria: " + to_string(rec);

    let draft = prompt(
        "You are the plan reviewer for the planning colony. You have three peer outputs for one issue: scope, risks, and task breakdown. Assemble a single markdown plan suitable for posting as an issue comment. Sections: **Scope**, **Risks**, **Subtasks**. Then self-review against past criteria and return a completeness score. Return JSON: issue_id (int, the target issue), plan (string, the full markdown plan), review_score (float 0-1, your self-review against past criteria), confidence (float 0-1, aggregate confidence combining all three peer confidences with the review score).",
        context
    ) -> DraftPlan;

    let my_tier = repo_tier("plan_reviewer", owner, repo);

    print("[plan_reviewer] Issue", draft.issue_id, "-> review_score:", draft.review_score);

    if my_tier == "autonomous" {
        // Direct external write: post the plan as an issue note.
        // colony-lint: safe-exec-concat
        let post_cmd = "$COLONY_DIR/scripts/forge-api.sh add-note " + to_string(draft.issue_id) + " --body " + shell_escape(draft.plan) + repo_arg(owner, repo);
        let post_result = try { exec sh post_cmd; } catch e {
            print("[plan_reviewer] Failed to post note:", e);
            "";
        };
        // #223: only mark posted (and learn() success) when the GitLab
        // call actually returned a body. Same shape as
        // version_bumper.ag's tag/release pattern. On failure
        // (auth/429/5xx/transport) we leave the marker unset so the
        // next tick retries instead of silently consuming the issue.
        if len(post_result) > 0 {
            rl_clear("plan_reviewer", owner, repo);
            let posted_key = scoped_memo(owner, repo, "plan_reviewer:" + iid_str + ":posted");
            memo_write(posted_key, "1");
            // #1370: all-tier handled marker (value = tier).
            memo_write(handled_key(owner, repo, target_iid), "autonomous");
            if len(owner) > 0 {
                learn(
                    "review_plan",
                    "issue " + to_string(draft.issue_id),
                    "posted: score=" + to_string(draft.review_score),
                    "success",
                    ["acted", "planning", repo_tag(owner, repo)]
                );
            } else {
                learn(
                    "review_plan",
                    "issue " + to_string(draft.issue_id),
                    "posted: score=" + to_string(draft.review_score),
                    "success",
                    ["acted", "planning"]
                );
            };
            print("[plan_reviewer] Posted plan to issue", draft.issue_id);
            // #1362: opt-in plan-approved auto-promotion. plan_reviewer posts a
            // plan for EVERY reviewed issue (no separate revise/reject path), so
            // approval is decided by the self-review score gate below, NOT by the
            // fact a plan was posted. Only when the operator set PLAN_AUTO_PROMOTE=1
            // in colony.toml ([planning] auto_promote = true, exported by
            // start-colony.sh), the plan clears the review_score bar, AND the
            // issue is non-epic, do we advance it from planning to implementation:
            // add the implementation trigger label and remove the planning one so
            // code_writer picks it up. This adds NO second prompt() (the staleness
            // gate stands) and leaves the posted marker untouched. Epic-class
            // issues are skipped — they need operator-driven decomposition.
            let auto_promote = getenv("PLAN_AUTO_PROMOTE");
            if auto_promote == "1" {
                // Fetch the target issue's RAW JSON for the epic guard. The
                // single-issue `issue` verb returns the raw labels array;
                // to_string() of an ARRAY-valued json_get yields "void" on the
                // runtime, so we search the raw text for the exact quoted label
                // the SAME way code_writer.ag does (#1271/#1273). epic vocabulary
                // is planning:labels:epic (cross-colony memo) or "epic" default.
                // colony-lint: safe-exec-concat
                let issue_cmd = "$COLONY_DIR/scripts/forge-api.sh issue " + to_string(draft.issue_id) + repo_arg(owner, repo);
                let issue_detail = try { exec sh issue_cmd; } catch e { ""; };
                let epic_vocab = recall_latest("planning:labels:epic");
                let epic_label = if len(epic_vocab) > 0 { epic_vocab; } else { "epic"; };
                let is_epic = index_of(issue_detail, "\"" + epic_label + "\"") > 0;
                if is_epic {
                    print("[plan_reviewer] issue", draft.issue_id, "is epic-class — leaving for the operator (no auto-promotion, #1362)");
                } else {
                    // #1362 APPROVE GATE: plan_reviewer posts a plan for EVERY
                    // reviewed issue (there is no separate revise/reject path),
                    // so "a plan was posted" is NOT approval. The self-review
                    // score IS the approve signal — only a plan that clears the
                    // bar promotes; a weak plan stays at needs-planning for the
                    // next planning pass to improve.
                    if draft.review_score < 0.5 {
                        print("[plan_reviewer] plan review_score", draft.review_score, "below 0.7 — not auto-promoting issue", draft.issue_id);
                    } else {
                        // Resolve the implementation trigger label (the label
                        // code_writer triggers on) and the planning trigger label
                        // (this colony's own, to remove). Both fall back to the
                        // documented defaults when the env vars are empty.
                        let impl_env = getenv("IMPLEMENTATION_TRIGGER_LABEL");
                        let impl_label = if len(impl_env) > 0 { impl_env; } else { "implementation"; };
                        let plan_env = getenv("PLANNING_TRIGGER_LABEL");
                        let plan_label = if len(plan_env) > 0 { plan_env; } else { "needs-planning"; };
                        // colony-lint: safe-exec-concat
                        let promote_cmd = "$COLONY_DIR/scripts/forge-api.sh update-issue " + to_string(draft.issue_id) + " --add-labels " + shell_escape(impl_label) + " --remove-labels " + shell_escape(plan_label) + repo_arg(owner, repo);
                        let promote_result = try { exec sh promote_cmd; } catch e {
                            print("[plan_reviewer] Auto-promote failed for issue", draft.issue_id, ":", e);
                            "";
                        };
                        if len(promote_result) > 0 {
                            print("[plan_reviewer] Auto-promoted issue", draft.issue_id, "to implementation (#1362)");
                            // #1453 Wave 1: reality-check — stash the pending
                            // verdict now that the promotion label swap
                            // succeeded (the only tier that mutates labels);
                            // evaluate_plan_verdict (top of tick_for_repo)
                            // scores the operator's reaction on later ticks.
                            // Comma-containing label names (GitHub permits
                            // them) would corrupt the CSV payload — skip the
                            // verdict rather than stash a lie. The .ag dialect
                            // has no `&&`, so the two comma checks nest.
                            if index_of(impl_label, ",") < 0 {
                                if index_of(plan_label, ",") < 0 {
                                    record_plan_verdict(owner, repo, draft.issue_id, impl_label + "," + plan_label);
                                };
                            };
                        } else {
                            print("[plan_reviewer] Auto-promote no-op for issue", draft.issue_id, "(will retry next tick)");
                        };
                    };
                };
            };
        } else {
            // #1115: a rate-limited write defers (records backoff + emits the
            // observable event) instead of marking the task failed; the
            // posted marker stays unset so a later tick retries after backoff.
            if rl_is_limited(owner, repo) == 1 {
                rl_mark("plan_reviewer", owner, repo);
                return;
            };
            if len(owner) > 0 {
                learn(
                    "review_plan",
                    "issue " + to_string(draft.issue_id),
                    "post-failed: score=" + to_string(draft.review_score),
                    "failure",
                    ["acted", "planning", repo_tag(owner, repo)]
                );
            } else {
                learn(
                    "review_plan",
                    "issue " + to_string(draft.issue_id),
                    "post-failed: score=" + to_string(draft.review_score),
                    "failure",
                    ["acted", "planning"]
                );
            };
        };
    } else {
        if my_tier == "review-gated" {
            // Draft external write: post with [draft-plan] prefix so a human
            // reviewer can promote or discard it.
            let draft_body = "[draft-plan] **Plan Review** (automated, pending approval)\n\n" + draft.plan;
            // colony-lint: safe-exec-concat
            let post_cmd = "$COLONY_DIR/scripts/forge-api.sh add-note " + to_string(draft.issue_id) + " --body " + shell_escape(draft_body) + repo_arg(owner, repo);
            let draft_result = try { exec sh post_cmd; } catch e {
                print("[plan_reviewer] Failed to post draft note:", e);
                "";
            };
            // #223: same gating as autonomous — only mark posted when
            // the GitLab call actually succeeded.
            if len(draft_result) > 0 {
                let posted_key = scoped_memo(owner, repo, "plan_reviewer:" + iid_str + ":posted");
                memo_write(posted_key, "1");
                // #1370: all-tier handled marker (value = tier).
                memo_write(handled_key(owner, repo, target_iid), "review-gated");
                if len(owner) > 0 {
                    learn(
                        "review_plan",
                        "issue " + to_string(draft.issue_id),
                        "drafted: score=" + to_string(draft.review_score),
                        "partial",
                        ["planning", "review-gated", repo_tag(owner, repo)]
                    );
                } else {
                    learn(
                        "review_plan",
                        "issue " + to_string(draft.issue_id),
                        "drafted: score=" + to_string(draft.review_score),
                        "partial",
                        ["planning", "review-gated"]
                    );
                };
                print("[plan_reviewer] Drafted plan for issue", draft.issue_id);
            } else {
                if len(owner) > 0 {
                    learn(
                        "review_plan",
                        "issue " + to_string(draft.issue_id),
                        "draft-post-failed: score=" + to_string(draft.review_score),
                        "failure",
                        ["planning", "review-gated", repo_tag(owner, repo)]
                    );
                } else {
                    learn(
                        "review_plan",
                        "issue " + to_string(draft.issue_id),
                        "draft-post-failed: score=" + to_string(draft.review_score),
                        "failure",
                        ["planning", "review-gated"]
                    );
                };
            };
        } else {
            if my_tier == "propose" {
                emit("planning:draft_plan", draft);
                if len(owner) > 0 {
                    learn(
                        "review_plan",
                        "issue " + to_string(draft.issue_id),
                        "emitted: score=" + to_string(draft.review_score),
                        "partial",
                        ["emitted", "planning", repo_tag(owner, repo)]
                    );
                } else {
                    learn(
                        "review_plan",
                        "issue " + to_string(draft.issue_id),
                        "emitted: score=" + to_string(draft.review_score),
                        "partial",
                        ["emitted", "planning"]
                    );
                };
                // #1370: all-tier handled marker (value = tier).
                memo_write(handled_key(owner, repo, target_iid), "propose");
                print("[plan_reviewer] Emitted draft plan for issue", draft.issue_id);
            } else {
                print("[plan_reviewer] Observing (tier:", my_tier, ")");
                if len(owner) > 0 {
                    learn(
                        "review_plan",
                        "issue " + to_string(draft.issue_id),
                        "observed: score=" + to_string(draft.review_score),
                        "partial",
                        ["observed", "planning", repo_tag(owner, repo)]
                    );
                } else {
                    learn(
                        "review_plan",
                        "issue " + to_string(draft.issue_id),
                        "observed: score=" + to_string(draft.review_score),
                        "partial",
                        ["observed", "planning"]
                    );
                };
                // #1370: all-tier handled marker (value = tier). observe-only,
                // but advances the cursor so the same issue is not re-prompted
                // every tick.
                memo_write(handled_key(owner, repo, target_iid), my_tier);
            };
        };
    };

    let now = now_iso();
    if len(now) > 0 {
        memo_write(scoped_memo(owner, repo, "plan_reviewer:last_check"), now);
    };
}

// Recursive iterator over `iter-repos.sh` output. See router.ag for the
// empty-owner sentinel rationale.
fn tick_at(spool: string, line_no: int) -> void {
    // #1358: nth-line read via nth_field (newline sep) — was an inline
    // python3 -c splitlines() one-liner. Out-of-range line_no -> "", which
    // ends the recursion exactly like the old bounds-checked print.
    let line = nth_field(spool, "\n", line_no);
    if len(line) == 0 { return; };
    let owner = repo_field(line, 0);
    let repo = repo_field(line, 1);
    tick_for_repo(owner, repo);
    return tick_at(spool, line_no + 1);
}

fn tick(reason: string) -> void {
    // #316 M3b: per-repo fan-out. See triage/agents/router.ag for the
    // back-compat sentinel pattern and byte-identity rationale.
    let spool = try { exec sh "$COLONY_DIR/../../tools/iter-repos.sh"; } catch e { ""; };
    if len(spool) == 0 {
        return;
    };
    tick_at(spool, 0);
}
