// scope_estimator.ag -- Planning colony: learns scope calibration.
//
// Observes shipped merge requests and the issues they closed, learns
// how human estimates compare to actual shipped scope, and estimates
// the scope of newly filed unplanned issues.
//
// Run as daemon: agentis daemon agents/scope_estimator.ag --colony planning
// Requires: exec_foreign capability, GITLAB_* env vars

cb 1500;

type ScopeEstimate {
    issue_id: int,
    phases: int,
    points: int,
    reasoning: string,
    confidence: float
}

type CalibrationSummary {
    observed_pairs: int,
    ratio_hint: string,
    tendencies: string
}

// #316 M3b: per-tick fan-out helpers. See triage/agents/router.ag for
// the full rationale. Single-block configs collapse to owner=="" sentinel,
// repo_arg/repo_tag return "", scoped_memo passes the suffix through.

fn repo_arg(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return " --repo " + shell_escape(owner + "/" + repo);
}

fn repo_tag(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return "repo:" + owner + "/" + repo;
}

fn scoped_memo(owner: string, repo: string, suffix: string) -> string {
    if len(owner) == 0 { return suffix; };
    return owner + "__" + repo + ":" + suffix;
}

// #316 M4: per-repo confidence read with legacy fallback. Mirrors the
// runtime tier() builtin's threshold table from ADR-0001 / CLAUDE.md.
// `agent_name` (not `agent`) — `agent` is a reserved keyword in `.ag`.
fn repo_tier(agent_name: string, owner: string, repo: string) -> string {
    let raw = if len(owner) == 0 {
        recall_latest(agent_name + ":confidence");
    } else {
        let scoped = recall_latest(scoped_memo(owner, repo, agent_name + ":confidence"));
        if len(scoped) > 0 { scoped; } else { recall_latest(agent_name + ":confidence"); };
    };
    if len(raw) == 0 { return "dormant"; };
    let c = parse_float(raw);
    if c >= 0.95 { return "autonomous"; };
    if c >= 0.8  { return "review-gated"; };
    if c >= 0.6  { return "propose"; };
    if c >= 0.4  { return "shadow"; };
    return "dormant";
}

// #1358: nth 0-based sep-delimited field of `s`, walked natively with
// index_of/substring — `.ag` v1.7 has no split(s, sep) builtin, so this
// recursive walk is the workaround (a general split(s, sep) -> list<string>
// builtin is a candidate upstream agentis-core language ask). Serves both the
// tab-separated iter-repos records (repo_field) and tick_at's newline-split
// spool reader. Total: out-of-range / negative n -> "", mirroring the
// bounds-checked python one-liner it replaces.
fn nth_field(s: string, sep: string, n: int) -> string {
    if n < 0 { return ""; };
    if len(s) == 0 { return ""; };
    let p = index_of(s, sep);
    if n == 0 {
        if p < 0 { return s; };
        return substring(s, 0, p);
    };
    if p < 0 { return ""; };
    return nth_field(substring(s, p + len(sep), len(s)), sep, n - 1);
}

// #1358: tab-separated field read, now native via nth_field (was an inline
// python3 -c split). Total: missing field / out-of-range idx -> "".
fn repo_field(line: string, idx: int) -> string {
    return nth_field(line, "\t", idx);
}

fn unplanned_cmd(owner: string, repo: string) -> string {
    // #1181: pickup keys on ASSIGNMENT, not label events — see
    // risk_assessor.ag for rationale. Always query the current-state
    // `issues --needs-planning` snapshot so an unplanned issue stays
    // visible on every tick; the #227 `:posted` guard prevents re-prompting.
    // colony-lint: safe-exec-concat
    return "$COLONY_DIR/scripts/forge-api.sh issues --needs-planning --view planning" + repo_arg(owner, repo);
}

// #1370 (B2/B3): per-issue handled marker, written at EVERY tier (not just
// autonomous). The value is the tier the issue was handled at, so a future
// promotion can re-run by clearing the marker. Keyed on issue identity only —
// an EXTERNAL edit that bumps updated_at does NOT clear it (planning re-plans
// on explicit re-trigger, not on every metadata churn), but a genuinely new
// unplanned issue is never marked, so the colony pipelines the backlog.
fn handled_key(owner: string, repo: string, iid: int) -> string {
    return scoped_memo(owner, repo, "scope_estimator:" + to_string(iid) + ":handled");
}

fn is_handled(owner: string, repo: string, iid: int) -> bool {
    return len(recall_latest(handled_key(owner, repo, iid))) > 0;
}

// #1370: scan the issues list (created_at asc, stable) and return the first
// iid whose per-issue handled marker is unset. Recurses over indices until
// json_get yields a non-positive iid (end of list). Returns 0 when every
// listed issue is already handled — the caller then returns before prompt(),
// the key idle-suppression win.
fn first_unhandled_iid(owner: string, repo: string, issues_raw: string, idx: int) -> int {
    if idx >= 20 {
        return 0;
    };
    let iid = parse_int(to_string(json_get(issues_raw, "[" + to_string(idx) + "].iid")));
    if iid <= 0 {
        return 0;
    };
    if is_handled(owner, repo, iid) {
        return first_unhandled_iid(owner, repo, issues_raw, idx + 1);
    };
    return iid;
}

// --- #1453 Wave 2 (M3): reality-check feedback loop ---
//
// Copies the shipped Wave 1/2 idiom in shape (single-slot pending_verdict
// memo, evaluate-first-in-tick, 86400 ageout, prompt()-free compare). The
// ground truth is the FATE of the issue the estimate was posted on: our
// estimate feeds plan_reviewer -> auto-promote (#1362) -> implementation, so
// the advised issue's terminal state is the honest first-order signal —
// closed as real work (no noise label) means the estimate was actionable;
// closed as noise (wontfix/invalid/duplicate/not-planned) means it wasn't.
// See doc/feedback-loop.md and the #1453 M3 plan comment for the rationale
// behind rejecting the umbrella's cycle-time signal (no native ISO->epoch
// parsing without a NEW embedded interpreter).

// Map the reality-check signal to the experience-store outcome enum. Signal
// 0 ("issue still open") is handled by the caller via an early return and
// never reaches this function.
fn signal_to_outcome(signal: int) -> string {
    if signal == 1 {
        return "success";
    };
    return "failure";
}

// Age (seconds) of a pending-verdict blob.
fn verdict_age_seconds(blob: string) -> int {
    let emit_ts = parse_int(to_string(json_get(blob, "[0]")));
    let now_raw = to_string(now_ms() / 1000);
    let now = parse_int(now_raw);
    return now - emit_ts;
}

// Native flat noise-label membership over the raw issue JSON's "labels"
// subtree: a fixed sequence of quote-anchored index_of checks (no
// per-element map/filter walk over the array — the #1640 CB-overflow
// lesson). The JSON-quoted label value gives the same anchoring a set
// membership test would, on both forge backends (GitLab's flat string
// array and GitHub's array-of-objects both quote the label name).
fn noise_label_hit(issue_raw: string) -> bool {
    let labels_raw = json_get_raw(issue_raw, "labels");
    if len(labels_raw) == 0 { return false; };
    if index_of(labels_raw, "\"wontfix\"") >= 0 { return true; };
    if index_of(labels_raw, "\"invalid\"") >= 0 { return true; };
    if index_of(labels_raw, "\"duplicate\"") >= 0 { return true; };
    if index_of(labels_raw, "\"not-planned\"") >= 0 { return true; };
    return false;
}

// Record a pending scope-estimate verdict. Stored as JSON array
// [ts, issue_id, "<points>"] — all three fields are ASCII-safe (epoch int,
// issue id int, a Fibonacci points string) so naive concatenation is
// sufficient and we skip a JSON encoder (the single-slot idiom from
// labeler.ag / plan_reviewer.ag).
fn record_scope_verdict(owner: string, repo: string, issue_id: int, points: string) -> void {
    let ts_raw = to_string(now_ms() / 1000);
    let blob = "[" + ts_raw + "," + to_string(issue_id) + ",\"" + points + "\"]";
    memo_write(scoped_memo(owner, repo, "scope_estimator:pending_verdict"), blob);
    print("[scope_estimator] verdict recorded: issue", issue_id, "points", points);
}

// Score the pending scope-estimate verdict against the issue's CURRENT
// terminal forge state. Re-query forge-api.sh issue <iid>: still "opened" ->
// leave pending (no signal yet, absence is not evidence either way); closed
// with no noise label -> success; closed with a noise label -> failure. 24h
// ageout drops the verdict UNSCORED. Mechanical compare via native flat
// builtins — NEVER a prompt().
fn evaluate_scope_verdict(owner: string, repo: string) -> void {
    let key = scoped_memo(owner, repo, "scope_estimator:pending_verdict");
    let blob = recall_latest(key);
    if len(blob) < 3 {
        return;
    };
    let timeout_s = 86400;
    if verdict_age_seconds(blob) > timeout_s {
        print("[scope_estimator] verdict aged out without signal");
        memo_write(key, "");
        return;
    };
    let issue_id = parse_int(to_string(json_get(blob, "[1]")));
    let points = to_string(json_get(blob, "[2]"));
    // colony-lint: safe-exec-concat
    let cur_cmd = "$COLONY_DIR/scripts/forge-api.sh issue " + to_string(issue_id) + repo_arg(owner, repo);
    let cur_raw = try { exec sh cur_cmd; } catch e { ""; };
    if len(cur_raw) < 3 {
        return;
    };
    let state = to_string(json_get(cur_raw, "state"));
    if state != "closed" {
        return;
    };
    let signal = if noise_label_hit(cur_raw) { 2; } else { 1; };
    let outcome = signal_to_outcome(signal);
    if len(owner) > 0 {
        learn(
            "scope_estimate",
            "issue " + to_string(issue_id) + " reality-check",
            "estimate: " + points + " points | signal: " + to_string(signal),
            outcome,
            ["acted", "planning", repo_tag(owner, repo)]
        );
    } else {
        learn(
            "scope_estimate",
            "issue " + to_string(issue_id) + " reality-check",
            "estimate: " + points + " points | signal: " + to_string(signal),
            outcome,
            ["acted", "planning"]
        );
    };
    print("[scope_estimator] reality-check: issue", issue_id, "signal", signal, "->", outcome);
    memo_write(key, "");
}

fn tick_for_repo(owner: string, repo: string) -> void {
    // #1453 Wave 2 (M3): score any pending scope-estimate verdict FIRST
    // (read-only, no early return) before the observe/act steps below.
    evaluate_scope_verdict(owner, repo);

    // Staleness gate for the observe step (#187). See risk_assessor.ag
    // for rationale. 1 800 s = 30 min between observe prompts keeps
    // calibration fresh without a heartbeat-LLM pathology on idle
    // projects where the act branch rarely fires.
    let now_epoch = to_string(now_ms() / 1000);
    let last_obs = recall_latest(scoped_memo(owner, repo, "scope_estimator:observe_last_ts"));
    let observe_stale = if len(last_obs) > 0 {
        if len(now_epoch) > 0 {
            // Negative delta (operator ran `date -s <past>` or similar
            // wall-clock regression) — treat as stale and re-observe
            // rather than skipping forever on a clock that never catches
            // up.
            let delta = parse_int(now_epoch) - parse_int(last_obs);
            if delta >= 0 {
                if delta < 1800 { 0; } else { 1; };
            } else { 1; };
        } else { 1; };
    } else { 1; };

    // 1. Observe: pull recent merged MRs and learn calibration
    if observe_stale == 1 {
        // colony-lint: safe-exec-concat
        let merged_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --view planning-mr" + repo_arg(owner, repo);
        let merged_raw = try {
            exec sh merged_cmd;
        } catch e {
            print("[scope_estimator] GitLab merged-MR poll failed:", e);
            "";
        };

        if len(merged_raw) > 10 {
            let summary = prompt(
                "Analyze these recently merged GitLab MRs. For each MR that closes an issue, compare the issue body's implied scope (phases, story points, or rough size) to the actual diff size and number of files touched. Summarize patterns (tendencies), give a rough over/under ratio hint (ratio_hint), and count the pairs you could compare (observed_pairs). Return JSON: observed_pairs (int), ratio_hint (string), tendencies (string).",
                merged_raw
            ) -> CalibrationSummary;

            if summary.observed_pairs > 0 {
                if len(owner) > 0 {
                    learn(
                        "scope_estimate",
                        "batch of " + to_string(summary.observed_pairs) + " shipped MRs",
                        "ratio: " + summary.ratio_hint + " | " + summary.tendencies,
                        "success",
                        ["observed", "planning", repo_tag(owner, repo)]
                    );
                } else {
                    learn(
                        "scope_estimate",
                        "batch of " + to_string(summary.observed_pairs) + " shipped MRs",
                        "ratio: " + summary.ratio_hint + " | " + summary.tendencies,
                        "success",
                        ["observed", "planning"]
                    );
                };
                if len(now_epoch) > 0 {
                    memo_write(scoped_memo(owner, repo, "scope_estimator:observe_last_ts"), now_epoch);
                };
                print("[scope_estimator] Observed", summary.observed_pairs, "shipped pairs");
            };
        };
    };

    // 2. Act: estimate scope for the next unplanned issue
    let cmd = unplanned_cmd(owner, repo);
    let issues_raw = try {
        exec sh cmd;
    } catch e {
        print("[scope_estimator] GitLab unplanned-issue poll failed:", e);
        "";
    };

    if len(issues_raw) < 3 {
        return;
    };

    // #1370 (B2/B3): filter already-handled issues BEFORE indexing, then pin
    // to the first UNHANDLED iid. If none remain unhandled this tick, return
    // before prompt() — nothing to do (the idle-suppression win). This
    // replaces the pre-#1370 raw `[0]` pick + `:posted` gate, which only
    // marked at the autonomous tier and so re-prompted every tick at the
    // default sub-autonomous tier.
    let target_iid = first_unhandled_iid(owner, repo, issues_raw, 0);
    if target_iid <= 0 {
        return;
    };

    let rec = recommend("scope_estimate", ["accuracy"]);
    let context = "Target issue id: " + to_string(target_iid) +
        "\nUnplanned issues: " + issues_raw + "\nPast calibration: " + to_string(rec);

    let estimate = prompt(
        "You are a scope estimator. Estimate the scope of the issue whose iid equals the Target issue id given in the context (find it in the issues JSON). Return JSON: issue_id (int, MUST equal the Target issue id), phases (int, 1-5), points (int, Fibonacci 1/2/3/5/8/13), reasoning (string, one short paragraph), confidence (float 0-1).",
        context
    ) -> ScopeEstimate;

    let my_tier = repo_tier("scope_estimator", owner, repo);

    print("[scope_estimator] Issue", estimate.issue_id, "->", estimate.phases, "phases,", estimate.points, "points");

    // #1372 durable hand-off: persist the scope BODY to the exact slot
    // plan_reviewer reads (plan_reviewer:<iid>:scope), at EVERY tier — a memo
    // write is ADR-0001-legal even at shadow. Pre-#1372 plan_reviewer only got
    // the scope if it caught the transient `emit` inside its own 500ms listen()
    // window; with de-bunched 180s ticks it usually missed it and assembled a
    // skeleton plan (self-scored ~0.3, so the #1362 promote-gate correctly held
    // it and the needs-planning queue never drained).
    memo_write(scoped_memo(owner, repo, "plan_reviewer:" + to_string(estimate.issue_id) + ":scope"), to_string(estimate));

    if my_tier == "autonomous" {
        emit("planning:scope_estimate", estimate);
        let note = "**Scope Estimate** (automated): " + to_string(estimate.phases) + " phases, " + to_string(estimate.points) + " points\n\n" + estimate.reasoning;
        // colony-lint: safe-exec-concat
        let post_cmd = "$COLONY_DIR/scripts/forge-api.sh add-note " + to_string(estimate.issue_id) + " --body " + shell_escape(note) + repo_arg(owner, repo);
        let post_result = try { exec sh post_cmd; } catch e {
            print("[scope_estimator] Failed to post note:", e);
            "";
        };
        // #227: gate marker + success learn on non-empty post result.
        if len(post_result) > 0 {
            let posted_key = scoped_memo(owner, repo, "scope_estimator:" + to_string(target_iid) + ":posted");
            memo_write(posted_key, "1");
            // #1370: all-tier handled marker — value = tier so a future
            // promotion can re-run by clearing it.
            memo_write(handled_key(owner, repo, target_iid), "autonomous");
            // #1453 Wave 2 (M3): stash the posted estimate so a later tick
            // scores it against the issue's terminal (closed) fate.
            record_scope_verdict(owner, repo, estimate.issue_id, to_string(estimate.points));
            if len(owner) > 0 {
                learn(
                    "scope_estimate",
                    "issue " + to_string(estimate.issue_id),
                    to_string(estimate.phases) + " phases, " + to_string(estimate.points) + " points: " + estimate.reasoning,
                    "success",
                    ["acted", "planning", repo_tag(owner, repo)]
                );
            } else {
                learn(
                    "scope_estimate",
                    "issue " + to_string(estimate.issue_id),
                    to_string(estimate.phases) + " phases, " + to_string(estimate.points) + " points: " + estimate.reasoning,
                    "success",
                    ["acted", "planning"]
                );
            };
        } else {
            if len(owner) > 0 {
                learn(
                    "scope_estimate",
                    "issue " + to_string(estimate.issue_id),
                    "post-failed: " + to_string(estimate.phases) + " phases, " + to_string(estimate.points) + " points",
                    "failure",
                    ["acted", "planning", repo_tag(owner, repo)]
                );
            } else {
                learn(
                    "scope_estimate",
                    "issue " + to_string(estimate.issue_id),
                    "post-failed: " + to_string(estimate.phases) + " phases, " + to_string(estimate.points) + " points",
                    "failure",
                    ["acted", "planning"]
                );
            };
        };
    } else {
        if my_tier == "review-gated" {
            emit("planning:scope_estimate", estimate);
            memo_write(scoped_memo(owner, repo, "plan_reviewer:" + to_string(estimate.issue_id) + ":scope_drafted"), "true");
            if len(owner) > 0 {
                learn(
                    "scope_estimate",
                    "issue " + to_string(estimate.issue_id),
                    to_string(estimate.phases) + " phases, " + to_string(estimate.points) + " points: " + estimate.reasoning,
                    "partial",
                    ["planning", "review-gated", repo_tag(owner, repo)]
                );
            } else {
                learn(
                    "scope_estimate",
                    "issue " + to_string(estimate.issue_id),
                    to_string(estimate.phases) + " phases, " + to_string(estimate.points) + " points: " + estimate.reasoning,
                    "partial",
                    ["planning", "review-gated"]
                );
            };
            // #1370: all-tier handled marker (value = tier).
            memo_write(handled_key(owner, repo, target_iid), "review-gated");
        } else {
            if my_tier == "propose" {
                emit("planning:scope_estimate", estimate);
                // #1370 QA fix: write the durable :scope_drafted key at propose
                // too (not only review-gated). Otherwise the single transient
                // emit + the handled marker starve plan_reviewer's slot_ready()
                // if its 500ms listen() misses the emit (no durable fallback).
                memo_write(scoped_memo(owner, repo, "plan_reviewer:" + to_string(estimate.issue_id) + ":scope_drafted"), "true");
                if len(owner) > 0 {
                    learn(
                        "scope_estimate",
                        "issue " + to_string(estimate.issue_id),
                        to_string(estimate.phases) + " phases, " + to_string(estimate.points) + " points: " + estimate.reasoning,
                        "partial",
                        ["emitted", "planning", repo_tag(owner, repo)]
                    );
                } else {
                    learn(
                        "scope_estimate",
                        "issue " + to_string(estimate.issue_id),
                        to_string(estimate.phases) + " phases, " + to_string(estimate.points) + " points: " + estimate.reasoning,
                        "partial",
                        ["emitted", "planning"]
                    );
                };
                // #1370: all-tier handled marker (value = tier).
                memo_write(handled_key(owner, repo, target_iid), "propose");
            } else {
                print("[scope_estimator] Observing (tier:", my_tier, ")");
                if len(owner) > 0 {
                    learn(
                        "scope_estimate",
                        "issue " + to_string(estimate.issue_id),
                        to_string(estimate.phases) + " phases, " + to_string(estimate.points) + " points: " + estimate.reasoning,
                        "partial",
                        ["observed", "planning", repo_tag(owner, repo)]
                    );
                } else {
                    learn(
                        "scope_estimate",
                        "issue " + to_string(estimate.issue_id),
                        to_string(estimate.phases) + " phases, " + to_string(estimate.points) + " points: " + estimate.reasoning,
                        "partial",
                        ["observed", "planning"]
                    );
                };
                // #1370: all-tier handled marker (value = tier). shadow/dormant
                // is observe-only, but the marker still advances the cursor so
                // the agent does not re-prompt the same issue every tick.
                memo_write(handled_key(owner, repo, target_iid), my_tier);
            };
        };
    };

    let now = now_iso();
    if len(now) > 0 {
        memo_write(scoped_memo(owner, repo, "scope_estimator:last_check"), now);
    };
}

// Recursive iterator over `iter-repos.sh` output. See router.ag for the
// empty-owner sentinel rationale.
fn tick_at(spool: string, line_no: int) -> void {
    // #1358: nth-line read via nth_field (newline sep) — was an inline
    // python3 -c splitlines() one-liner. Out-of-range line_no -> "", which
    // ends the recursion exactly like the old bounds-checked print.
    let line = nth_field(spool, "\n", line_no);
    if len(line) == 0 { return; };
    let owner = repo_field(line, 0);
    let repo = repo_field(line, 1);
    tick_for_repo(owner, repo);
    return tick_at(spool, line_no + 1);
}

fn tick(reason: string) -> void {
    // #316 M3b: per-repo fan-out. See triage/agents/router.ag for the
    // back-compat sentinel pattern and byte-identity rationale.
    let spool = try { exec sh "$COLONY_DIR/../../tools/iter-repos.sh"; } catch e { ""; };
    if len(spool) == 0 {
        return;
    };
    tick_at(spool, 0);
}
