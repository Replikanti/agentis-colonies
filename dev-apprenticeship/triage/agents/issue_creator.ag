// issue_creator.ag -- Triage colony: learns how you create issues.
//
// Observes human-created issues on GitLab, learns title/description
// conventions, and gradually drafts new issues from events.
//
// Run as daemon: agentis daemon agents/issue_creator.ag --colony triage
// Requires: exec_foreign capability, GITLAB_* env vars

cb 600;

type DraftIssue {
    title: string,
    description: string,
    suggested_labels: string,
    source: string,
    confidence: float
}

type ObservationSummary {
    count: int,
    patterns: string
}

// #316 M3a: per-tick fan-out helpers. See router.ag for the full
// rationale. Single-block configs collapse to owner=="" sentinel,
// repo_arg/repo_tag return "", scoped_memo passes the suffix through.

fn repo_arg(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return " --repo " + shell_escape(owner + "/" + repo);
}

fn repo_tag(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return "repo:" + owner + "/" + repo;
}

fn scoped_memo(owner: string, repo: string, suffix: string) -> string {
    if len(owner) == 0 { return suffix; };
    // `__` between owner and repo is the per-repo segment separator. The
    // memo-key validator (agentis runtime) accepts only [A-Za-z0-9_:.-],
    // so `/` (the natural GitHub spelling in repo_arg / repo_tag) is
    // reserved for the experience-tag and CLI-flag surfaces; memo keys
    // use the underscore form instead. The `:` after repo continues the
    // existing `<agent>:<key>` convention so `<owner>__<repo>:<suffix>`
    // sorts predictably alongside legacy unscoped keys.
    return owner + "__" + repo + ":" + suffix;
}

// #316 M4: per-repo confidence read with legacy fallback. Mirrors the
// runtime tier() builtin's threshold table from ADR-0001 / CLAUDE.md.
// `agent_name` (not `agent`) — `agent` is a reserved keyword in `.ag`.
fn repo_tier(agent_name: string, owner: string, repo: string) -> string {
    let raw = if len(owner) == 0 {
        recall_latest(agent_name + ":confidence");
    } else {
        let scoped = recall_latest(scoped_memo(owner, repo, agent_name + ":confidence"));
        if len(scoped) > 0 { scoped; } else { recall_latest(agent_name + ":confidence"); };
    };
    if len(raw) == 0 { return "dormant"; };
    let c = parse_float(raw);
    if c >= 0.95 { return "autonomous"; };
    if c >= 0.8  { return "review-gated"; };
    if c >= 0.6  { return "propose"; };
    if c >= 0.4  { return "shadow"; };
    return "dormant";
}

// #1358: nth 0-based sep-delimited field of `s`, walked natively with
// index_of/substring — `.ag` v1.7 has no split(s, sep) builtin, so this
// recursive walk is the workaround (a general split(s, sep) -> list<string>
// builtin is a candidate upstream agentis-core language ask). Serves both the
// tab-separated iter-repos records (repo_field) and tick_at's newline-split
// spool reader. Total: out-of-range / negative n -> "", mirroring the
// bounds-checked python one-liner it replaces.
fn nth_field(s: string, sep: string, n: int) -> string {
    if n < 0 { return ""; };
    if len(s) == 0 { return ""; };
    let p = index_of(s, sep);
    if n == 0 {
        if p < 0 { return s; };
        return substring(s, 0, p);
    };
    if p < 0 { return ""; };
    return nth_field(substring(s, p + len(sep), len(s)), sep, n - 1);
}

// #1358: tab-separated field read, now native via nth_field (was an inline
// python3 -c split). Total: missing field / out-of-range idx -> "".
fn repo_field(line: string, idx: int) -> string {
    return nth_field(line, "\t", idx);
}

// #1111: is the shared per-colony issues snapshot fresh enough to read?
// start-colony.sh's snapshot step writes `gitlab:snapshot:issues:ts` (epoch
// seconds) alongside the snapshot blob. A snapshot older than the window
// (or with no ts at all) is treated as stale -> caller falls back to a
// direct fetch. Total-on-failure: a missing/garbled ts yields stale=false
// via the parse_int->0 path, so a broken snapshot can never starve an agent.
fn snapshot_fresh() -> bool {
    let ts_raw = recall_latest("gitlab:snapshot:issues:ts");
    if len(ts_raw) == 0 { return false; };
    let ts = parse_int(ts_raw);
    if ts == 0 { return false; };
    let now_raw = to_string(now_ms() / 1000);
    let now = parse_int(now_raw);
    if now == 0 { return false; };
    return (now - ts) <= 600;
}

// #1111: build a forge-api.sh command that projects `view` out of the
// shared snapshot memo (zero HTTP) when a fresh snapshot exists; "" means
// "no usable snapshot — degrade to a direct fetch". Reads the compressed
// (#1112) envelope from the memo and passes it to the --from-snapshot path
// via the GITLAB_SNAPSHOT env var. Only used on the legacy single-repo path
// (owner==""); the per-colony snapshot is not repo-scoped.
fn snapshot_issues_cmd(view: string) -> string {
    let blob = recall_latest("gitlab:snapshot:issues");
    if len(blob) < 20 { return ""; };
    if !snapshot_fresh() { return ""; };
    // colony-lint: safe-exec-concat
    return "GITLAB_SNAPSHOT=" + shell_escape(blob) + " $COLONY_DIR/scripts/forge-api.sh issues --from-snapshot --view " + view;
}

fn issues_cmd(owner: string, repo: string) -> string {
    // #1111: prefer the shared snapshot on the single-repo path. When it is
    // fresh, every triage agent reads the same memo instead of each curling
    // /issues (the 3x duplicate fetch per tick). Empty return = no fresh
    // snapshot -> fall through to the legacy direct fetch below.
    if len(owner) == 0 {
        let snap = snapshot_issues_cmd("issue_creator");
        if len(snap) > 0 { return snap; };
    };
    let ts = recall_latest(scoped_memo(owner, repo, "issue_creator:last_check"));
    // colony-lint: safe-exec-concat
    if len(ts) > 0 {
        return "$COLONY_DIR/scripts/forge-api.sh issues --since " + shell_escape(ts) + " --view issue_creator" + repo_arg(owner, repo);
    };
    // colony-lint: safe-exec-concat
    return "$COLONY_DIR/scripts/forge-api.sh issues --view issue_creator" + repo_arg(owner, repo);
}

// --- #1453 Wave 2 (M5): reality-check feedback loop ---
//
// Copies the shipped Wave 2 M3 idiom in shape (single-slot pending_verdict
// memo, evaluate-first-in-tick, 86400 ageout, prompt()-free compare). The
// ground truth is the FATE of the self-observe issue this agent filed:
// unlike code_writer (Wave 1), which owns a deterministic fix/issue-<iid>
// branch name it can bounded-list-scan for, a triage-filed issue has no
// derived branch name — whoever picks it up chooses an arbitrary one, so
// "worked (branch/MR/label progression)" is not mechanically observable
// here without a NEW cross-artifact join the forge wrappers don't expose.
// Instead this milestone reuses the exact proven M3 primitive
// (planning/scope_estimator.ag's noise_label_hit + signal_to_outcome,
// byte-identical copy — the .ag dialect has no imports): closed with no
// noise label means the issue survived triage as real work (success);
// closed with a noise label (wontfix/invalid/duplicate/not-planned) means
// it was rejected as noise (failure); still open means no signal yet. This
// directly measures self-observe noise, which the #1411 acceptance gate
// already cares about. See doc/feedback-loop.md and the #1453 M5 plan
// comment for the full rationale.

// Map the reality-check signal to the experience-store outcome enum. Signal
// 0 ("issue still open") is handled by the caller via an early return and
// never reaches this function.
fn signal_to_outcome(signal: int) -> string {
    if signal == 1 {
        return "success";
    };
    return "failure";
}

// Age (seconds) of a pending-verdict blob.
fn verdict_age_seconds(blob: string) -> int {
    let emit_ts = parse_int(to_string(json_get(blob, "[0]")));
    let now_raw = to_string(now_ms() / 1000);
    let now = parse_int(now_raw);
    return now - emit_ts;
}

// Native flat noise-label membership over the raw issue JSON's "labels"
// subtree: a fixed sequence of quote-anchored index_of checks (no
// per-element map/filter walk over the array — the #1640 CB-overflow
// lesson). The JSON-quoted label value gives the same anchoring a set
// membership test would, on both forge backends (GitLab's flat string
// array and GitHub's array-of-objects both quote the label name).
fn noise_label_hit(issue_raw: string) -> bool {
    let labels_raw = json_get_raw(issue_raw, "labels");
    if len(labels_raw) == 0 { return false; };
    if index_of(labels_raw, "\"wontfix\"") >= 0 { return true; };
    if index_of(labels_raw, "\"invalid\"") >= 0 { return true; };
    if index_of(labels_raw, "\"duplicate\"") >= 0 { return true; };
    if index_of(labels_raw, "\"not-planned\"") >= 0 { return true; };
    return false;
}

// Record a pending issue-creation verdict. No payload needed beyond the
// issue id — mirrors ship_decider/changelog_writer's empty-payload-slot
// convention.
fn record_issue_verdict(owner: string, repo: string, issue_id: int) -> void {
    let ts_raw = to_string(now_ms() / 1000);
    let blob = "[" + ts_raw + "," + to_string(issue_id) + ",\"\"]";
    memo_write(scoped_memo(owner, repo, "issue_creator:pending_verdict"), blob);
    print("[issue_creator] verdict recorded: issue", issue_id);
}

// Score the pending issue-creation verdict against the issue's CURRENT
// terminal forge state. Re-query forge-api.sh issue <iid>: still "opened" ->
// leave pending (no signal yet, absence is not evidence either way); closed
// with no noise label -> success; closed with a noise label -> failure. 24h
// ageout drops the verdict UNSCORED. Mechanical compare via native flat
// builtins — NEVER a prompt().
fn evaluate_issue_verdict(owner: string, repo: string) -> void {
    let key = scoped_memo(owner, repo, "issue_creator:pending_verdict");
    let blob = recall_latest(key);
    if len(blob) < 3 {
        return;
    };
    let timeout_s = 86400;
    if verdict_age_seconds(blob) > timeout_s {
        print("[issue_creator] verdict aged out without signal");
        memo_write(key, "");
        return;
    };
    let issue_id = parse_int(to_string(json_get(blob, "[1]")));
    // colony-lint: safe-exec-concat
    let cur_cmd = "$COLONY_DIR/scripts/forge-api.sh issue " + to_string(issue_id) + repo_arg(owner, repo);
    let cur_raw = try { exec sh cur_cmd; } catch e { ""; };
    if len(cur_raw) < 3 {
        return;
    };
    let state = to_string(json_get(cur_raw, "state"));
    if state != "closed" {
        return;
    };
    let signal = if noise_label_hit(cur_raw) { 2; } else { 1; };
    let outcome = signal_to_outcome(signal);
    if len(owner) > 0 {
        learn(
            "create_issue",
            "issue " + to_string(issue_id) + " reality-check",
            "signal: " + to_string(signal),
            outcome,
            ["acted", "triage", repo_tag(owner, repo)]
        );
    } else {
        learn(
            "create_issue",
            "issue " + to_string(issue_id) + " reality-check",
            "signal: " + to_string(signal),
            outcome,
            ["acted", "triage"]
        );
    };
    print("[issue_creator] reality-check: issue", issue_id, "signal", signal, "->", outcome);
    memo_write(key, "");
}

fn tick_for_repo(owner: string, repo: string) -> void {
    // #1453 Wave 2 (M5): score any pending issue-creation verdict FIRST
    // (read-only, no early return) before the observe/act steps below.
    evaluate_issue_verdict(owner, repo);

    let cmd = issues_cmd(owner, repo);
    let raw = try {
        exec sh cmd;
    } catch e {
        print("[issue_creator] GitLab poll failed:", e);
        "";
    };

    if len(raw) < 3 {
        return;
    };

    // Analyze batch: extract patterns from human-created issues
    let summary = prompt(
        "Analyze this GitLab issues JSON. Count how many issues were created by humans (not bots). Summarize the patterns you see in title style, description structure, and label choices. Return JSON: count (int), patterns (string). If no human issues, count=0.",
        raw
    ) -> ObservationSummary;

    if summary.count > 0 {
        if len(owner) > 0 {
            learn(
                "create_issue",
                "batch of " + to_string(summary.count) + " issues",
                summary.patterns,
                "success",
                ["observed", "triage", repo_tag(owner, repo)]
            );
        } else {
            learn(
                "create_issue",
                "batch of " + to_string(summary.count) + " issues",
                summary.patterns,
                "success",
                ["observed", "triage"]
            );
        };
        print("[issue_creator] Observed", summary.count, "human-created issues");
    };

    // Check inbox for events that might warrant new issues
    let inbox = try { poll_inbox(); } catch e { ""; };

    if len(to_string(inbox)) > 5 {
        let my_tier = repo_tier("issue_creator", owner, repo);
        let rec = recommend("create_issue", ["accuracy", "style"]);
        let context = "Event: " + to_string(inbox) + "\nPast learning: " + to_string(rec);

        let draft = prompt(
            "You are an issue creator agent. Draft a GitLab issue from this event using learned conventions. Return JSON: title (string), description (string), suggested_labels (comma-separated string), source (string), confidence (float 0-1).",
            context
        ) -> DraftIssue;

        if my_tier == "autonomous" {
            // colony-lint: safe-exec-concat
            let create_cmd = "$COLONY_DIR/scripts/forge-api.sh create-issue --title " + shell_escape(draft.title) + " --description " + shell_escape(draft.description) + " --labels " + shell_escape(draft.suggested_labels) + repo_arg(owner, repo);
            let result = try {
                exec sh create_cmd;
            } catch e {
                print("[issue_creator] Failed to create issue:", e);
                "";
            };
            if len(result) > 0 {
                print("[issue_creator] Created issue:", draft.title);
                emit("triage:new_issue", draft);
                if len(owner) > 0 {
                    learn("create_issue", "created", draft.title, "success", ["acted", "triage", repo_tag(owner, repo)]);
                } else {
                    learn("create_issue", "created", draft.title, "success", ["acted", "triage"]);
                };
                // #1453 Wave 2 (M5): stash the created issue so a later tick
                // scores it against its terminal (closed) fate.
                record_issue_verdict(owner, repo, parse_int(to_string(json_get(result, "iid"))));
            };
        } else {
            if my_tier == "review-gated" {
                // Non-terminal draft: emit the draft on the bus. A human
                // reviewer can promote it; the actual `create-issue` call
                // stays behind the autonomous branch.
                print("[issue_creator] Drafted issue (pending approval):", draft.title);
                emit("triage:new_issue", draft);
                if len(owner) > 0 {
                    learn("create_issue", "drafted", draft.title, "partial", ["triage", "review-gated", repo_tag(owner, repo)]);
                } else {
                    learn("create_issue", "drafted", draft.title, "partial", ["triage", "review-gated"]);
                };
            } else {
                if my_tier == "propose" {
                    print("[issue_creator] Suggesting issue:", draft.title);
                    emit("triage:new_issue", draft);
                    if len(owner) > 0 {
                        learn("create_issue", "suggested", draft.title, "partial", ["emitted", "triage", repo_tag(owner, repo)]);
                    } else {
                        learn("create_issue", "suggested", draft.title, "partial", ["emitted", "triage"]);
                    };
                } else {
                    print("[issue_creator] Observing (tier:", my_tier, ")");
                    if len(owner) > 0 {
                        learn("create_issue", "observed", draft.title, "partial", ["observed", "triage", repo_tag(owner, repo)]);
                    } else {
                        learn("create_issue", "observed", draft.title, "partial", ["observed", "triage"]);
                    };
                };
            };
        };
    };

    let now = now_iso();
    if len(now) > 0 {
        memo_write(scoped_memo(owner, repo, "issue_creator:last_check"), now);
    };
}

// Recursive iterator over `iter-repos.sh` output. See router.ag for the
// empty-owner sentinel rationale.
fn tick_at(spool: string, line_no: int) -> void {
    // #1358: nth-line read via nth_field (newline sep) — was an inline
    // python3 -c splitlines() one-liner. Out-of-range line_no -> "", which
    // ends the recursion exactly like the old bounds-checked print.
    let line = nth_field(spool, "\n", line_no);
    if len(line) == 0 { return; };
    let owner = repo_field(line, 0);
    let repo = repo_field(line, 1);
    tick_for_repo(owner, repo);
    return tick_at(spool, line_no + 1);
}

fn tick(reason: string) -> void {
    // #316 M3a: per-repo fan-out. See router.ag for the back-compat
    // sentinel pattern and byte-identity rationale.
    let spool = try { exec sh "$COLONY_DIR/../../tools/iter-repos.sh"; } catch e { ""; };
    if len(spool) == 0 {
        return;
    };
    tick_at(spool, 0);
}
