// router.ag -- Triage colony: learns how you assign issues.
//
// Observes assignee patterns on GitLab issues, learns expertise
// mapping, and gradually routes issues to the right people.
//
// Run as daemon: agentis daemon agents/router.ag --colony triage
// Requires: exec_foreign capability, GITLAB_* env vars
//
// #1234 crystallizer pilot (ports the labeler #1235 mechanism to routing):
// repeat routing decisions on the same canonical context CLASS crystallize
// into a "route" rule the agent replays without prompt() (Stage 1), the LLM
// decision is distilled so the class accumulates toward crystallization
// (Stage 2), and a reality-check demotes rules whose suggested assignee the
// operator reassigns away (crystallizer_record_use). Router had no
// reality-check at all before this, so evaluate_route_verdict() is new: it
// treats a later reassignment away from the rule's suggested assignee as the
// demote signal, and a kept assignment as reinforcement. Requires the agentis
// crystallizer builtins (agentis >= 1.8.0).
//
// #1429 Stage 1b: on a Stage 1 prefix-lookup miss, BM25-rank the whole
// crystallized rule pool against the REAL issue text (title + labels) via
// crystallizer_search (agentis >= 1.20.0, ADR-0009 Phase 1.5) and fire the
// first candidate whose class-scoped, confidence-gated point lookup
// confirms it — recall is no longer bounded by the fixed keyword VOCAB.
// When no candidate clears the bar, the top candidates ground the routing
// prompt() instead ("similar past decisions", the RAG fallback).
// Operator knobs (process env, read via getenv — mirror labeler's; every
// knob must be on the install.sh exec.env_passthrough allowlist or it is
// silently inert, #1426/#1428):
//   - ROUTER_RULE_FIRST=0       short-circuits the ENTIRE pilot path (Stage 1
//                               replay, Stage 1b BM25 recall, Stage 2 distill,
//                               verdict recording + reality-check) to the LLM
//                               path — byte-identical to pre-pilot behaviour,
//                               the rollback knob.
//   - ROUTER_RULE_CONFIDENCE=<float>  overrides the default 0.85 minimum
//                               confidence for a rule-first hit (shared by
//                               Stage 1 and Stage 1b — BM25 score is a
//                               relevance signal, never a trust signal).
//   - ROUTER_BM25_RECALL=0      short-circuits Stage 1b only (BM25 recall +
//                               prompt grounding); Stage 1 prefix replay
//                               stays on.
//   - TRIAGE_BM25_K=<int>       top-k for crystallizer_search (default 3; 0
//                               disables recall + grounding via the builtin's
//                               k<=0 empty-list contract). Shared with
//                               labeler.

cb 400;

type RoutingAnalysis {
    assigned_count: int,
    unassigned_count: int,
    patterns: string,
    unassigned_issues: string
}

type RouteAction {
    issue_id: int,
    assignee: string,
    reasoning: string,
    confidence: float
}

// #316 M3a: per-tick fan-out helpers.
//
// `iter-repos.sh` emits one TSV line per repo (owner\trepo\turl\tme).
// On single-block configs the spool collapses to one line with
// `owner==""` (sentinel) — repo_arg returns "", repo_tag returns "",
// scoped_memo passes the suffix through unchanged. Net effect: pre-M3
// behaviour is byte-identical (no --repo flag, no per-repo memo
// keys, no repo: tag on experience rows).

fn repo_arg(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return " --repo " + shell_escape(owner + "/" + repo);
}

fn repo_tag(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return "repo:" + owner + "/" + repo;
}

fn scoped_memo(owner: string, repo: string, suffix: string) -> string {
    if len(owner) == 0 { return suffix; };
    // `__` between owner and repo is the per-repo segment separator. The
    // memo-key validator (agentis runtime) accepts only [A-Za-z0-9_:.-],
    // so `/` (the natural GitHub spelling in repo_arg / repo_tag) is
    // reserved for the experience-tag and CLI-flag surfaces; memo keys
    // use the underscore form instead. The `:` after repo continues the
    // existing `<agent>:<key>` convention so `<owner>__<repo>:<suffix>`
    // sorts predictably alongside legacy unscoped keys.
    return owner + "__" + repo + ":" + suffix;
}

// #316 M4: per-repo confidence read with legacy fallback. Mirrors the
// runtime tier() builtin's threshold table from ADR-0001 / CLAUDE.md.
// `agent_name` (not `agent`) — `agent` is a reserved keyword in `.ag`.
fn repo_tier(agent_name: string, owner: string, repo: string) -> string {
    let raw = if len(owner) == 0 {
        recall_latest(agent_name + ":confidence");
    } else {
        let scoped = recall_latest(scoped_memo(owner, repo, agent_name + ":confidence"));
        if len(scoped) > 0 { scoped; } else { recall_latest(agent_name + ":confidence"); };
    };
    if len(raw) == 0 { return "dormant"; };
    let c = parse_float(raw);
    if c >= 0.95 { return "autonomous"; };
    if c >= 0.8  { return "review-gated"; };
    if c >= 0.6  { return "propose"; };
    if c >= 0.4  { return "shadow"; };
    return "dormant";
}

// #1358: nth 0-based sep-delimited field of `s`, walked natively with
// index_of/substring — `.ag` v1.7 has no split(s, sep) builtin, so this
// recursive walk is the workaround (a general split(s, sep) -> list<string>
// builtin is a candidate upstream agentis-core language ask). Serves both the
// tab-separated iter-repos records (repo_field) and tick_at's newline-split
// spool reader. Total: out-of-range / negative n -> "", mirroring the
// bounds-checked python one-liner it replaces.
fn nth_field(s: string, sep: string, n: int) -> string {
    if n < 0 { return ""; };
    if len(s) == 0 { return ""; };
    let p = index_of(s, sep);
    if n == 0 {
        if p < 0 { return s; };
        return substring(s, 0, p);
    };
    if p < 0 { return ""; };
    return nth_field(substring(s, p + len(sep), len(s)), sep, n - 1);
}

// #1358: tab-separated field read, now native via nth_field (was an inline
// python3 -c split). Total: missing field / out-of-range idx -> "".
fn repo_field(line: string, idx: int) -> string {
    return nth_field(line, "\t", idx);
}

// #317: bidirectional closed-by lookup for unassigned issues. The four
// reviewer agents call closed-by-index.sh `record` whenever a PR body
// mentions `<owner>/<repo>#<N>`; here we read the reverse direction so
// the routing prompt sees a "closed by PR ..." hint per unassigned
// issue with at least one closing PR. Returns "" when:
//   - owner == "" (back-compat sentinel — no per-repo key to look up).
//   - the unassigned issues blob has no parseable iid digits.
//   - no issues have a closed-by entry in the federation index.
// Empty return => byte-identical routing context vs pre-#317.
//
// All lookup logic delegated to a python -c one-liner so the .ag layer
// stays bash-3.2 portable. Inputs travel via env to avoid quoting
// hazards. The inline helper greps the blob for `#<digits>` tokens
// (iids) plus json `"iid": N` shapes, dedupes (preserve first-seen
// order), then shells out to closed-by-index.sh lookup per iid (cap 20).
fn closed_by_context(owner: string, repo: string, blob: string) -> string {
    if len(owner) == 0 { return ""; };
    if len(blob) < 2 { return ""; };
    // colony-lint: safe-exec-concat
    let cmd = "BLOB=" + shell_escape(blob) +
        " OWNER=" + shell_escape(owner) +
        " REPO=" + shell_escape(repo) +
        " python3 -c 'import os,re,json,subprocess,sys; " +
        "b=os.environ[\"BLOB\"]; o=os.environ[\"OWNER\"]; r=os.environ[\"REPO\"]; " +
        "c=os.environ[\"COLONY_DIR\"]; " +
        "lk=c+\"/../../tools/closed-by-index.sh\"; " +
        "iids=[]; s=set(); " +
        "[ (s.add(m.group(1)) or iids.append(m.group(1))) for m in re.finditer(r\"(?<![A-Za-z0-9_])#(\\d+)\", b) if m.group(1) not in s ]; " +
        "[ (s.add(m.group(1)) or iids.append(m.group(1))) for m in re.finditer(r\"\\\"iid\\\"\\s*:\\s*(\\d+)\", b) if m.group(1) not in s ]; " +
        "out=[]; " +
        "[ out.append((n, json.loads(subprocess.check_output([lk,\"lookup\",\"--colony-dir\",c,\"--tgt-owner\",o,\"--tgt-repo\",r,\"--tgt-iid\",n], stderr=subprocess.DEVNULL).decode(\"utf-8\",\"replace\").strip() or \"[]\"))) for n in iids[:20] ]; " +
        "lines=[]; " +
        "[ lines.append(\"- #%s: closed by %s\" % (n, \", \".join([\"%s/%s#%s\" % (e.get(\"src_owner\",\"\"), e.get(\"src_repo\",\"\"), e.get(\"src_iid\",\"\")) for e in arr[:5] if isinstance(e, dict)]))) for (n, arr) in out if arr ]; " +
        "sys.stdout.write(\"\\n\\n## Closed-by hints (cross-repo)\\n\" + \"\\n\".join(lines) + \"\\n\") if lines else None'";
    return try { exec sh cmd; } catch e { ""; };
}

// #1111: is the shared per-colony issues snapshot fresh enough to read?
// start-colony.sh's snapshot step writes `gitlab:snapshot:issues:ts` (epoch
// seconds) alongside the snapshot blob. A snapshot older than the window
// (or with no ts at all) is treated as stale -> caller falls back to a
// direct fetch. Total-on-failure: a missing/garbled ts yields stale=false
// via the parse_int->0 path, so a broken snapshot can never starve an agent.
fn snapshot_fresh() -> bool {
    let ts_raw = recall_latest("gitlab:snapshot:issues:ts");
    if len(ts_raw) == 0 { return false; };
    let ts = parse_int(ts_raw);
    if ts == 0 { return false; };
    let now_raw = to_string(now_ms() / 1000);
    let now = parse_int(now_raw);
    if now == 0 { return false; };
    return (now - ts) <= 600;
}

// #1111: build a forge-api.sh command that projects `view` out of the
// shared snapshot memo (zero HTTP) when a fresh snapshot exists; "" means
// "no usable snapshot — degrade to a direct fetch". Reads the compressed
// (#1112) envelope from the memo and passes it to the --from-snapshot path
// via the GITLAB_SNAPSHOT env var. Only used on the legacy single-repo path
// (owner==""); the per-colony snapshot is not repo-scoped.
fn snapshot_issues_cmd(view: string) -> string {
    let blob = recall_latest("gitlab:snapshot:issues");
    if len(blob) < 20 { return ""; };
    if !snapshot_fresh() { return ""; };
    // colony-lint: safe-exec-concat
    return "GITLAB_SNAPSHOT=" + shell_escape(blob) + " $COLONY_DIR/scripts/forge-api.sh issues --from-snapshot --view " + view;
}

// #1111 (Fix #9): content fingerprint of the view bytes that would feed
// prompt(). On the legacy `--since last_check` path a quiet project returns
// `[]` (handled by the len(raw) < 3 early-exit), but the shared snapshot is
// the FULL collection, so `raw` is non-empty every tick even when nothing
// changed. Hashing the projected view and comparing to a per-agent memo
// restores the quiet-project early-exit: identical content => no prompt().
// Total-on-failure: a hash failure yields "" so the gate never matches and
// the agent falls through to its normal prompt() path (never starved).
// Native sha256_hex (agentis >= 1.20.0, #1588 slice 3) hashes the .ag
// string's UTF-8 bytes directly — no shell round-trip, value-identical to
// the prior python3 sha256 pipeline it replaces.
fn content_hash(raw: string) -> string {
    return sha256_hex(raw);
}

fn issues_cmd(owner: string, repo: string) -> string {
    // #1111: prefer the shared snapshot on the single-repo path. When it is
    // fresh, every triage agent reads the same memo instead of each curling
    // /issues (the 3x duplicate fetch per tick). Empty return = no fresh
    // snapshot -> fall through to the legacy direct fetch below.
    if len(owner) == 0 {
        let snap = snapshot_issues_cmd("router");
        if len(snap) > 0 { return snap; };
    };
    let ts = recall_latest(scoped_memo(owner, repo, "router:last_check"));
    // colony-lint: safe-exec-concat
    if len(ts) > 0 {
        return "$COLONY_DIR/scripts/forge-api.sh issues --since " + shell_escape(ts) + " --view router" + repo_arg(owner, repo);
    };
    // colony-lint: safe-exec-concat
    return "$COLONY_DIR/scripts/forge-api.sh issues --view router" + repo_arg(owner, repo);
}

fn get_confidence() -> float {
    let raw = recall_latest("router:confidence");
    if len(raw) > 0 {
        return parse_float(raw);
    };
    return 0.0;
}

// #1234 crystallizer pilot (ports labeler #1235): deterministic, prompt-free
// canonical context for the first UNASSIGNED issue in `raw` (the router-view
// JSON the LLM path consumes). Emits a single tab-separated line:
//   "<iid>\t<canonical_ctx>\t<bm25_query>"
// where canonical_ctx is "kw=" + sorted_kw_csv + " labels=" + sorted_labels_csv.
// The 3rd field (#1429) is the issue's free text (title + label names —
// the router view carries no description), whitespace-collapsed to one
// line and truncated to 1200 bytes — the Stage 1b crystallizer_search
// query. Emitted unconditionally (repo_field extraction by index keeps
// fields 0-1 byte-identical for Stage 1), consumed only when
// ROUTER_BM25_RECALL is on.
// The keyword signature lowercases the issue title and matches a FIXED triage
// vocabulary (the same set labeler uses); the sorted matched set plus the
// sorted labels CSV are stable across repeats so the crystallized rule id is
// identical tick-to-tick. Routing carries no personal/team scope dimension
// (router's learn() rows have no scope tag), so — unlike labeler — no author
// field is emitted; the router view also carries no description, so only the
// title feeds the keyword signature. An issue with no vocab hit / no labels
// still yields a valid ctx ("kw= labels="); it rarely crystallizes, which is
// fine. Total-on-failure: any python/exec failure returns "" so the caller
// falls through to the LLM path and is never starved.
fn canonical_route_context(issues_raw: string) -> string {
    let cmd = "RAW=" + shell_escape(issues_raw) +
        " python3 -c '" +
        "import os, json, re\n" +
        "VOCAB=[\"bug\",\"crash\",\"error\",\"fail\",\"segfault\",\"panic\",\"exception\",\"docs\",\"documentation\",\"readme\",\"feature\",\"enhancement\",\"request\",\"question\",\"security\",\"vuln\",\"cve\",\"performance\",\"perf\",\"slow\",\"test\",\"ci\",\"build\",\"regression\",\"refactor\",\"dependency\"]\n" +
        "try:\n" +
        "    data=json.loads(os.environ[\"RAW\"])\n" +
        "except Exception:\n" +
        "    print(\"\"); raise SystemExit\n" +
        "if not isinstance(data, list):\n" +
        "    print(\"\"); raise SystemExit\n" +
        "chosen=None\n" +
        "for x in data:\n" +
        "    if not isinstance(x, dict): continue\n" +
        "    if not x.get(\"assignees\"):\n" +
        "        chosen=x; break\n" +
        "if chosen is None:\n" +
        "    print(\"\"); raise SystemExit\n" +
        "iid=chosen.get(\"iid\")\n" +
        "if iid is None:\n" +
        "    print(\"\"); raise SystemExit\n" +
        "text=(chosen.get(\"title\") or \"\").lower()\n" +
        "toks=set(re.findall(r\"[a-z]+\", text))\n" +
        "hits=sorted({w for w in VOCAB if w in toks})\n" +
        "labels=sorted({str(l).strip() for l in (chosen.get(\"labels\") or []) if str(l).strip()})\n" +
        "ctx=\"kw=\"+\",\".join(hits)+\" labels=\"+\",\".join(labels)\n" +
        "q=re.sub(r\"\\s+\", \" \", (chosen.get(\"title\") or \"\")+\" \"+\" \".join(labels)).strip()[:1200]\n" +
        "print(str(iid)+\"\\t\"+ctx+\"\\t\"+q)" +
        "'";
    return try { exec sh cmd; } catch e { ""; };
}

// #1234 crystallizer pilot: canonical assignee for the rule's `action` slot.
// A single username, trimmed of surrounding whitespace and a leading `@` (the
// reasoning strings spell it `@user`), so the KnowledgeEntry id is identical
// across repeats of the same decision (NOT free-form LLM prose). Total-on-
// failure returns "" (caller treats "" as no usable action).
// #1588 slice 4: strip ALL leading `@` chars, mirroring python's
// `.lstrip("@")` (there is no strip_prefix/trim_start_matches builtin —
// confirmed absent from evaluator/mod.rs). Tail-recursive per the `.ag`
// no-loops convention; total-on-empty (returns "" unchanged).
fn strip_leading_at(s: string) -> string {
    if len(s) == 0 {
        return s;
    };
    if substring(s, 0, 1) == "@" {
        return strip_leading_at(substring(s, 1, len(s)));
    };
    return s;
}

// Native via trim + strip_leading_at (was an inline python3 -c pipeline).
// python did `.strip().lstrip("@")` — whitespace trim first, THEN strip
// leading `@`s — so the order here matches exactly.
fn normalize_assignee(name: string) -> string {
    return strip_leading_at(trim(name));
}

// #1429 Stage 1b: walk the BM25 candidate list (JSON strings from
// crystallizer_search, highest score first) and return the `condition` of
// the first candidate that the CLASS-SCOPED, CONFIDENCE-GATED point lookup
// confirms. The class confirmation is load-bearing: crystallizer_search
// ranks the WHOLE rule pool across action types ("label", "route", ...)
// and its per-rule JSON carries no expected_outcome field, so a raw
// candidate may belong to another agent's class. Re-probing the candidate's
// condition through crystallizer_lookup_with_confidence(<class>, cond,
// min_conf) enforces both properties at once — a hit proves a <class> rule
// at >= min_conf matches that condition family; a "label" rule surfaced by
// BM25 simply misses here. BM25 score itself is never a trust signal.
// Tail-recursive (no loops in .ag); the caller bounds depth via the
// TRIAGE_BM25_K search limit (default 3). Returns "" when no candidate
// confirms. json_get on a missing field yields Void -> "void"; skipped.
fn bm25_pick_at(action_type: string, cands: list<string>, pos: int, min_conf: float) -> string {
    if pos >= len(cands) { return ""; };
    let cj = to_string(get(cands, pos));
    let cond = to_string(json_get(cj, "condition"));
    if len(cond) > 0 {
        if cond != "void" {
            let confirmed = crystallizer_lookup_with_confidence(action_type, cond, min_conf);
            if len(confirmed) > 0 {
                return cond;
            };
        };
    };
    return bm25_pick_at(action_type, cands, pos + 1, min_conf);
}

// #1429 RAG fallback: format the BM25 candidates into a compact grounding
// block for the routing prompt ("similar past decisions"). Only candidates
// at 0.5+ rule confidence are included; size is bounded by TRIAGE_BM25_K
// (default 3) times the core's condition (<= 256 chars) + action caps.
// Returns "" when nothing qualifies — the caller then passes the prompt
// context through unchanged (byte-identical to pre-#1429).
fn bm25_grounding_at(cands: list<string>, pos: int, acc: string) -> string {
    if pos >= len(cands) { return acc; };
    let cj = to_string(get(cands, pos));
    let cond = to_string(json_get(cj, "condition"));
    let act = to_string(json_get(cj, "action"));
    let conf_raw = to_string(json_get(cj, "confidence"));
    let conf = parse_float(conf_raw);
    if conf >= 0.5 {
        if len(cond) > 0 {
            if cond != "void" {
                if len(act) > 0 {
                    if act != "void" {
                        let line = "\n- when [" + cond + "] -> " + act + " (confidence " + conf_raw + ")";
                        return bm25_grounding_at(cands, pos + 1, acc + line);
                    };
                };
            };
        };
    };
    return bm25_grounding_at(cands, pos + 1, acc);
}

// #1234: auto-confidence from the reality-check (mirrors labeler #106). Each
// suggested / drafted assignment stashes a pending verdict; a later tick reads
// back the issue's current assignee and scores kept-vs-reassigned. Kept => a
// small positive bump, reassigned-away => a small negative. Capped at 0.85
// (the autonomy threshold): operators sign off on autonomous routing writes
// explicitly, so the reality-check alone never pushes past it.
fn clamp_auto(cur: float, delta: float) -> float {
    let cap = 0.85;
    if delta > 0.0 {
        if cur >= cap {
            return cur;
        };
        if (cur + delta) > cap {
            return cap;
        };
        return cur + delta;
    };
    if (cur + delta) < 0.0 {
        return 0.0;
    };
    return cur + delta;
}

// #1234: reality-check signal -> confidence delta. Single-assignee routing has
// no "partial" (our person is either currently assigned or not): signal 1 =
// kept (+0.02), signal 3 = reassigned away (-0.01). Signal 0 ("still
// unassigned, no signal yet") is handled by the caller via an early return.
fn signal_to_delta(signal: int) -> float {
    if signal == 1 {
        return 0.02;
    };
    if signal == 3 {
        return 0.0 - 0.01;
    };
    return 0.0;
}

// #1234: map the reality-check signal to the experience-store outcome enum so
// auto-promote's fitness gates (#186) see an honest acting-path reject rate.
fn signal_to_outcome(signal: int) -> string {
    if signal == 1 {
        return "success";
    };
    if signal == 2 {
        return "partial";
    };
    return "failure";
}

// #1234: map the reality-check signal to the crystallizer demote/reinforce
// delta. Kept assignment reinforces the rule (+0.1), a reassignment away
// demotes it (-0.15). Core compaction retires a rule at success_rate < 0.5 &&
// use_count >= 20, so sustained reassignments eventually drop it.
fn rule_feedback_delta(signal: int) -> float {
    if signal == 1 {
        return 0.1;
    };
    if signal == 3 {
        return 0.0 - 0.15;
    };
    return 0.0;
}

// #1234: thread the crystallizer demote/reinforce feedback. `blob` is the
// pending-verdict array; its 4th field is the rule_id ("" for LLM-path
// verdicts). When non-empty, credit / penalise the rule the reality-check just
// scored. No-op on LLM-path verdicts (empty rule_id) so an LLM-only tick never
// touches the crystallizer.
fn record_rule_feedback(blob: string, signal: int) -> void {
    let rule_id = to_string(json_get(blob, "[3]"));
    // Empty rule_id = LLM-path verdict. "void" = an in-flight 3-field blob
    // written before this pilot deployed (json_get on the missing [3] index
    // yields Void -> "void"); ignore it so the transition across the deploy
    // boundary never feeds a bogus rule id to the crystallizer.
    if len(rule_id) == 0 {
        return;
    };
    if rule_id == "void" {
        return;
    };
    crystallizer_record_use(rule_id, signal == 1, rule_feedback_delta(signal));
    print("[router] crystallizer feedback: rule", rule_id, "signal", signal);
}

// #1234: per-repo write target for the auto-confidence bump. get_confidence()
// keeps reading the legacy unscoped key (bounded by clamp_auto's 0.85 cap, so
// per-repo drift cannot push past the autonomy threshold from reality-check
// feedback alone). Operators set per-repo overrides via
// `agentis memo set <owner>__<repo>:router:confidence <value>`.
fn apply_feedback(delta: float, owner: string, repo: string) -> void {
    let cur = get_confidence();
    let target = clamp_auto(cur, delta);
    memo_write(scoped_memo(owner, repo, "router:confidence"), to_string(target));
    print("[router] feedback delta", delta, "confidence", cur, "->", target);
}

// #1234: record a pending routing verdict. Stored as JSON array
// [t, iid, "assignee", "rule_id"] — the four fields are ASCII-safe (epoch int,
// iid int, a single username, crystallizer rule ids have no
// quotes/newlines/backslashes in practice) so naive concatenation is
// sufficient and we skip a JSON encoder. The 4th `rule_id` field is "" for
// LLM-path verdicts and the crystallized rule id for rule-hit verdicts;
// evaluate_route_verdict feeds it to crystallizer_record_use after the
// reality-check signal settles (kept reinforces, reassigned demotes).
fn record_route_verdict(owner: string, repo: string, issue_id: int, assignee: string, rule_id: string) -> void {
    let ts_raw = to_string(now_ms() / 1000);
    let blob = "[" + ts_raw + "," + to_string(issue_id) + ",\"" + assignee + "\",\"" + rule_id + "\"]";
    // #1437 multi-slot: keyed per-iid + a CSV index (labeler #203 idiom)
    // so two propose/review-gated ticks on DIFFERENT issues no longer
    // overwrite each other's pending verdict unscored.
    memo_write(scoped_memo(owner, repo, "router:pending_verdict:" + to_string(issue_id)), blob);
    append_verdict_index(owner, repo, issue_id);
    print("[router] verdict recorded: issue", issue_id, "suggested", assignee);
}

fn verdict_age_seconds(blob: string) -> int {
    let emit_ts = parse_int(to_string(json_get(blob, "[0]")));
    let now_raw = to_string(now_ms() / 1000);
    let now = parse_int(now_raw);
    return now - emit_ts;
}

// #1234: score the pending routing verdict against what the operator actually
// did on GitLab (ports labeler's single-slot evaluate_label_verdict). Returns
// early (leaves the verdict pending) when the pilot is disabled, no verdict
// exists, or the issue still has no assignee (no signal yet). Clears the
// verdict when scored or aged out (> 24h). The current assignee is read from
// the `raw` get-issue view (the `feedback-issue` view drops assignees), which
// exposes both the `assignees` array and the deprecated singular `assignee`.
// The reality-check treats a reassignment away from our suggested username as
// the demote signal (signal 3) and a kept assignment as reinforcement
// (signal 1). The ROUTER_RULE_FIRST rollback gate lives on the
// evaluate_route_verdict wrapper below (#1437).
// #1437: score ONE pending verdict blob at `key`. Returns "keep" when the
// verdict should stay in the index for a future tick (fetch failure or no
// operator signal yet) and "drop" when it was scored, aged out (> 24h), or
// the blob is missing (index drift self-heal). Factored out of the former
// single-slot evaluate_route_verdict so the per-iid index scanner and the
// legacy-slot migration share one scoring path.
fn score_route_verdict_key(owner: string, repo: string, key: string) -> string {
    let blob = recall_latest(key);
    if len(blob) < 3 {
        return "drop";
    };
    let timeout_s = 86400;
    if verdict_age_seconds(blob) > timeout_s {
        print("[router] verdict aged out without signal");
        memo_write(key, "");
        return "drop";
    };
    let issue_id = parse_int(to_string(json_get(blob, "[1]")));
    let suggested = to_string(json_get(blob, "[2]"));
    // colony-lint: safe-exec-concat
    let cur_cmd = "$COLONY_DIR/scripts/forge-api.sh get-issue " + to_string(issue_id) + " --view raw" + repo_arg(owner, repo);
    let cur_raw = try { exec sh cur_cmd; } catch e { ""; };
    if len(cur_raw) < 3 {
        return "keep";
    };
    // Deterministic compare in python (cheap, reproducible) rather than a
    // prompt() round-trip. Output: 0 = no signal (still unassigned),
    // 1 = kept (our suggested username is among the current assignees),
    // 3 = reassigned (assigned, but not to our username).
    let match_cmd = "SUGGESTED=" + shell_escape(suggested) + " RAW=" + shell_escape(cur_raw) + " python3 -c 'import os, json; sug=os.environ[\"SUGGESTED\"].strip(); d=json.loads(os.environ[\"RAW\"]); ns={(a or {}).get(\"username\") for a in (d.get(\"assignees\") or [])}; a1=d.get(\"assignee\"); ns.add((a1 or {}).get(\"username\")) if isinstance(a1, dict) else None; ns={n for n in ns if n}; print(0 if not ns else (1 if sug in ns else 3))'";
    let signal_raw = try { exec sh match_cmd; } catch e { "0"; };
    let signal = parse_int(signal_raw);
    if signal == 0 {
        return "keep";
    };
    apply_feedback(signal_to_delta(signal), owner, repo);
    // Credit / penalise the crystallized rule (no-op on LLM-path verdicts
    // whose blob carries an empty rule_id).
    record_rule_feedback(blob, signal);
    // Emit the reality-check outcome to the experience store so auto-promote's
    // fitness gates (#186) see an honest acting-path reject rate. Tagged
    // "acted" regardless of the original tier so the row lands in the acting
    // bucket.
    let outcome = signal_to_outcome(signal);
    if len(owner) > 0 {
        learn(
            "route",
            "issue " + to_string(issue_id) + " reality-check",
            "suggested: " + suggested + " | signal: " + to_string(signal),
            outcome,
            ["acted", "triage", repo_tag(owner, repo)]
        );
    } else {
        learn(
            "route",
            "issue " + to_string(issue_id) + " reality-check",
            "suggested: " + suggested + " | signal: " + to_string(signal),
            outcome,
            ["acted", "triage"]
        );
    };
    print("[router] reality-check: issue", issue_id, "signal", signal, "->", outcome);
    memo_write(key, "");
    return "drop";
}

// CSV accumulator helper — appends `iid_raw` to `acc` with a comma
// separator, or returns `iid_raw` when `acc` is empty (labeler idiom).
fn append_csv(acc: string, iid_raw: string) -> string {
    if len(acc) > 0 {
        return acc + "," + iid_raw;
    };
    return iid_raw;
}

// #1588 slice 4: native dedup-append, was an inline python3 -c pipeline
// (`parts=[p for p in ex.split(",") if p.strip() and p.strip()!=n];
// parts.append(n); print(",".join(parts))`). regex_split(",", ...) on the
// literal separator produces the same empty-string tokens on
// leading/trailing/consecutive commas as python's str.split(","); the
// filter predicate compares `trim(p)` (matching `.strip()`) against `n`
// but keeps the ORIGINAL untrimmed token `p` in the output — exactly what
// the python comprehension does (`if p.strip() ... ` filters, but the
// list holds `p`, not `p.strip()`). `n` itself is always a bare digit
// string (to_string(int)), so no trim is needed on the appended tail.
fn dedup_append_csv(existing: string, n: string) -> string {
    let kept = filter(regex_split(",", existing), |p: string| -> bool {
        if len(trim(p)) > 0 {
            if trim(p) != n { true; } else { false; };
        } else { false; };
    });
    let joined = reduce(kept, |acc: string, p: string| -> string {
        if len(acc) > 0 { acc + "," + p; } else { p; };
    }, "");
    if len(joined) > 0 { return joined + "," + n; };
    return n;
}

// #1588 slice 4: native p-th non-empty CSV token, was an inline python3 -c
// pipeline (`parts=[p for p in os.environ["CSV"].split(",") if p.strip()];
// p=int(os.environ["POS"]); print(parts[p] if 0<=p<len(parts) else "")`).
// Empty/whitespace-only tokens are dropped from `parts` (matching the
// python `if p.strip()` filter) before indexing; out-of-range/negative pos
// -> "" (matching the python bounds check).
fn nth_nonempty_csv(csv: string, pos: int) -> string {
    let parts = filter(regex_split(",", csv), |p: string| -> bool {
        if len(trim(p)) > 0 { true; } else { false; };
    });
    if pos < 0 { return ""; };
    if pos >= len(parts) { return ""; };
    return to_string(get(parts, pos));
}

// #1437: append an iid to the pending-verdict index, deduping so the same
// iid never appears twice (freshest occurrence at the tail — latest write
// wins for repeated suggestions on one issue). #1588 slice 4: native
// dedup_append_csv (was an inline python3 -c pipeline, wrapped in a
// try/catch for subprocess failure). regex_split + filter + trim + reduce
// are total, pure builtins with no exec/shell round-trip, so there is no
// failure mode left to catch.
fn append_verdict_index(owner: string, repo: string, iid: int) -> void {
    let key = scoped_memo(owner, repo, "router:pending_verdict_index");
    let existing = recall_latest(key);
    let iid_str = to_string(iid);
    let next = dedup_append_csv(existing, iid_str);
    memo_write(key, next);
}

// #1437: recursive scanner over the pending-verdict index (`.ag` has no
// loops — tail recursion per the runtime convention). Scores each iid's
// blob; keeps only still-pending ones in the rebuilt index.
fn eval_route_verdicts_at(owner: string, repo: string, index_csv: string, pos: int, acc: string) -> string {
    let iid_raw = nth_nonempty_csv(index_csv, pos);
    if len(iid_raw) < 1 {
        return acc;
    };
    let verdict = score_route_verdict_key(owner, repo, scoped_memo(owner, repo, "router:pending_verdict:" + iid_raw));
    if verdict == "keep" {
        return eval_route_verdicts_at(owner, repo, index_csv, pos + 1, append_csv(acc, iid_raw));
    };
    return eval_route_verdicts_at(owner, repo, index_csv, pos + 1, acc);
}

// #1437: multi-slot entry point (keeps the pre-#1437 name so the tick
// call site is unchanged). Scores every pending per-iid verdict and
// rewrites the index with the survivors. Also scores the LEGACY
// single-slot key once per tick so a verdict recorded by a pre-#1437
// daemon is still honoured across the upgrade boundary. Gated on
// ROUTER_RULE_FIRST exactly like the single-slot predecessor.
fn evaluate_route_verdict(owner: string, repo: string) -> void {
    if getenv("ROUTER_RULE_FIRST") == "0" {
        return;
    };
    score_route_verdict_key(owner, repo, scoped_memo(owner, repo, "router:pending_verdict"));
    let ikey = scoped_memo(owner, repo, "router:pending_verdict_index");
    let index_csv = recall_latest(ikey);
    if len(index_csv) < 1 {
        return;
    };
    let new_index = eval_route_verdicts_at(owner, repo, index_csv, 0, "");
    memo_write(ikey, new_index);
}

// #1234 crystallizer pilot: rule-hit application. Mirror of the LLM tier-block
// in tick_for_repo, but takes primitive fields because the .ag grammar
// disallows inline RouteAction struct literals (so the rule-hit path cannot
// synthesize a RouteAction to feed the existing block). The tier semantics are
// byte-identical to the LLM path (autonomous assigns via update-issue,
// review-gated posts a draft note, propose emits, shadow/dormant observes);
// only the source of the decision differs (crystallized rule vs prompt). Every
// learn() row on this path carries "rule-hit" + "distilled" so auto-promote and
// the dashboard can separate replayed decisions from LLM-driven ones, and the
// review-gated / propose branches thread rule_id through record_route_verdict
// so the reality-check later credits / penalises the rule via
// crystallizer_record_use. #1429: `hit_kind` ("prefix-hit" for the Stage 1
// canonical-context match, "bm25-hit" for the Stage 1b BM25 recall) is
// tagged IN ADDITION to "rule-hit" — the auto-promote rule-hit efficiency
// bonus (#823) keys on "rule-hit" membership and must count both replay
// paths; the extra tag only discriminates them for the dashboard / outcome
// tracking. Autonomous route writes are NOT single-slot
// verdict-recorded here: that tier's longer-horizon revert-check is the
// labeler #203 multi-slot mechanism, a deliberate follow-up to this pilot (the
// optimistic +0.1 recorded in Stage 1 stands until then). The emit payload is a
// JSON string of the RouteAction shape; triage:route_suggestion's only consumer
// (implementation/code_writer) treats the event as a wake-up signal (checks
// len > 5), so the loose shape is safe.
fn apply_route_rule_hit(owner: string, repo: string, my_tier: string, issue_id: int, assignee: string, reasoning: string, rule_id: string, hit_kind: string) -> void {
    let conf_str = recall_latest("router:confidence");
    let action_json = "{\"issue_id\":" + to_string(issue_id) + ",\"assignee\":\"" + assignee + "\",\"reasoning\":\"" + reasoning + "\",\"confidence\":" + conf_str + ",\"rule_id\":\"" + rule_id + "\"}";
    if my_tier == "autonomous" {
        // colony-lint: safe-exec-concat
        let update_cmd = "$COLONY_DIR/scripts/forge-api.sh update-issue " + to_string(issue_id) + " --assignee " + shell_escape(assignee) + repo_arg(owner, repo);
        let result = try { exec sh update_cmd; } catch e {
            print("[router] Failed to assign (rule-hit):", e);
            "";
        };
        if len(result) > 0 {
            print("[router] Assigned issue", issue_id, "to", assignee, "(rule-hit)");
            emit("triage:route_suggestion", action_json);
            if len(owner) > 0 {
                learn("route", "issue " + to_string(issue_id), assignee, "success", ["acted", "triage", "rule-hit", hit_kind, "distilled", repo_tag(owner, repo)]);
            } else {
                learn("route", "issue " + to_string(issue_id), assignee, "success", ["acted", "triage", "rule-hit", hit_kind, "distilled"]);
            };
        };
    } else {
        if my_tier == "review-gated" {
            let note = "[draft-route] **Routing Suggestion** (automated, pending approval): assign to @" + assignee + "\n\n" + reasoning;
            // colony-lint: safe-exec-concat
            let post_cmd = "$COLONY_DIR/scripts/forge-api.sh add-note " + to_string(issue_id) + " --body " + shell_escape(note) + repo_arg(owner, repo);
            try { exec sh post_cmd; } catch e {
                print("[router] Failed to post draft note (rule-hit):", e);
            };
            emit("triage:route_suggestion", action_json);
            record_route_verdict(owner, repo, issue_id, assignee, rule_id);
            if len(owner) > 0 {
                learn("route", "issue " + to_string(issue_id), assignee, "partial", ["triage", "review-gated", "rule-hit", hit_kind, "distilled", repo_tag(owner, repo)]);
            } else {
                learn("route", "issue " + to_string(issue_id), assignee, "partial", ["triage", "review-gated", "rule-hit", hit_kind, "distilled"]);
            };
        } else {
            if my_tier == "propose" {
                print("[router] Suggesting assignee for issue", issue_id, "(rule-hit):", assignee);
                emit("triage:route_suggestion", action_json);
                record_route_verdict(owner, repo, issue_id, assignee, rule_id);
                if len(owner) > 0 {
                    learn("route", "issue " + to_string(issue_id), assignee, "partial", ["emitted", "triage", "rule-hit", hit_kind, "distilled", repo_tag(owner, repo)]);
                } else {
                    learn("route", "issue " + to_string(issue_id), assignee, "partial", ["emitted", "triage", "rule-hit", hit_kind, "distilled"]);
                };
            } else {
                print("[router] Observing rule-hit (tier:", my_tier, ")");
                if len(owner) > 0 {
                    learn("route", "issue " + to_string(issue_id), assignee, "partial", ["observed", "triage", "rule-hit", hit_kind, "distilled", repo_tag(owner, repo)]);
                } else {
                    learn("route", "issue " + to_string(issue_id), assignee, "partial", ["observed", "triage", "rule-hit", hit_kind, "distilled"]);
                };
            };
        };
    };
}

// #1429: shared fire path for Stage 1 (prefix hit) and Stage 1b (BM25
// recall hit) — one place owns the record_use / apply / memo-stamp / gate
// sequence so the two stages cannot drift. Returns "fired" when the rule
// was applied (caller must `return` to skip the LLM), "" when the rule's
// action normalized to no usable assignee (caller falls through to the
// next stage / the prompt). `hit_ctx` is whichever condition string
// produced the hit (canonical_ctx for Stage 1, the BM25 candidate's
// condition for Stage 1b) — stamped into router:rule_ctx so operators can
// see WHICH condition family fired.
fn fire_route_rule(owner: string, repo: string, my_tier: string, issue_id: int, rule_id: string, rule_action: string, rule_conf_str: string, rule_cond: string, hit_ctx: string, hit_kind: string, cur_hash: string) -> string {
    // #1435 defence-in-depth: refuse to replay an over-general
    // empty-keyword rule — condition "kw=" prefix-matches the entire
    // class. Pre-#1435 pools may still hold such rules (distill now
    // guards against minting new ones); this check permanently
    // neutralizes them on the fire path, and the learn row makes the
    // poisoned pool visible to the dashboard / outcome tracking.
    if rule_cond == "kw=" {
        print("[router] rule-hit refused: over-general kw= rule", rule_id, "(#1435)");
        if len(owner) > 0 {
            learn("route", hit_ctx, "kw= rule refused: " + rule_id, "partial", ["observed", "triage", "rule-rejected-overgeneral", repo_tag(owner, repo)]);
        } else {
            learn("route", hit_ctx, "kw= rule refused: " + rule_id, "partial", ["observed", "triage", "rule-rejected-overgeneral"]);
        };
        return "";
    };

    let rule_assignee = normalize_assignee(rule_action);
    if len(rule_assignee) == 0 {
        return "";
    };
    let rule_reasoning = hit_kind + ": crystallized route rule @conf " + rule_conf_str + ". Context: " + hit_ctx;
    // Optimistic at-write reinforcement; the reality-check
    // (evaluate_route_verdict) later corrects via the threaded rule_id
    // (+0.1 kept / -0.15 reassigned).
    crystallizer_record_use(rule_id, true, 0.1);
    apply_route_rule_hit(owner, repo, my_tier, issue_id, rule_assignee, rule_reasoning, rule_id, hit_kind);
    memo_write(scoped_memo(owner, repo, "router:rule_ctx"), hit_ctx);
    memo_write(scoped_memo(owner, repo, "router:rule_id"), rule_id);
    if len(cur_hash) > 0 {
        memo_write(scoped_memo(owner, repo, "router:snapshot_hash"), cur_hash);
    };
    let now_s1 = now_iso();
    if len(now_s1) > 0 {
        memo_write(scoped_memo(owner, repo, "router:last_check"), now_s1);
    };
    return "fired";
}

fn tick_for_repo(owner: string, repo: string) -> void {
    // #1234: score any pending routing verdict from a previous tick before
    // doing new work (cheap no-op when nothing is pending / pilot disabled).
    // Same call-site position evaluate_label_verdict occupies in labeler.
    evaluate_route_verdict(owner, repo);
    // #147: cheap delta-check. `issues_cmd()` already filters
    // server-side via --since last_check, so an empty response
    // (`[]`, 2 chars) means "no new issues since last tick" and we
    // early-exit *before* any prompt(). The last_check memo is
    // refreshed here too — otherwise the --since window would never
    // advance on a quiet project.
    let cmd = issues_cmd(owner, repo);
    let raw = try {
        exec sh cmd;
    } catch e {
        print("[router] GitLab poll failed:", e);
        "";
    };

    if len(raw) < 3 {
        let now_e = now_iso();
        if len(now_e) > 0 {
            memo_write(scoped_memo(owner, repo, "router:last_check"), now_e);
        };
        return;
    };

    // #1111 (Fix #9): snapshot-content-hash gate. The shared snapshot is the
    // full issues collection, so `raw` is non-empty every tick even on a
    // quiet project — without this gate the agent would call prompt() each
    // tick for no change. Compare the fingerprint of the current view bytes
    // against the last-processed hash; if unchanged, no-op (refresh
    // last_check, keep the hash) exactly like the legacy `--since`-empty
    // early-exit. ADDITIONAL to the prompt-gate, not a replacement: one
    // tier() call/tick and the recall_latest()-based check-prompt-gate stay
    // intact. A "" hash (compute failure) never matches -> agent proceeds.
    let cur_hash = content_hash(raw);
    let prev_hash = recall_latest(scoped_memo(owner, repo, "router:snapshot_hash"));
    if len(cur_hash) > 0 {
        if cur_hash == prev_hash {
            let now_h = now_iso();
            if len(now_h) > 0 {
                memo_write(scoped_memo(owner, repo, "router:last_check"), now_h);
            };
            return;
        };
    };

    // Get team members
    // colony-lint: safe-exec-concat
    let members_cmd = "$COLONY_DIR/scripts/forge-api.sh members --view summary" + repo_arg(owner, repo);
    let members_raw = try { exec sh members_cmd; } catch e { "[]"; };

    // Analyze: find assigned and unassigned issues
    let analysis = prompt(
        "Analyze this GitLab issues JSON. Count issues with assignees (assigned_count) and without (unassigned_count). Summarize who gets assigned what types of issues (patterns). List unassigned issue IDs, titles, labels (unassigned_issues). Return JSON: assigned_count (int), unassigned_count (int), patterns (string), unassigned_issues (string).",
        raw
    ) -> RoutingAnalysis;

    if analysis.assigned_count > 0 {
        if len(owner) > 0 {
            learn(
                "route",
                "batch of " + to_string(analysis.assigned_count) + " assigned issues",
                analysis.patterns,
                "success",
                ["observed", "triage", repo_tag(owner, repo)]
            );
        } else {
            learn(
                "route",
                "batch of " + to_string(analysis.assigned_count) + " assigned issues",
                analysis.patterns,
                "success",
                ["observed", "triage"]
            );
        };
        print("[router] Observed", analysis.assigned_count, "assignment patterns");
    };

    // Suggest/apply routing for unassigned issues
    if analysis.unassigned_count > 0 {
        let my_tier = repo_tier("router", owner, repo);
        let rec = recommend("route", ["accuracy"]);
        // #317: bidirectional surface — pass the unassigned issues blob
        // through closed-by-index lookup so the router prompt sees
        // "closed by PR <other>#<N>" hints alongside the issue list.
        // Empty owner sentinel skips the lookup (no per-repo key to
        // search) — byte-identical to pre-#317 routing context.
        let closed_by_block = closed_by_context(owner, repo, analysis.unassigned_issues);
        let context = "Unassigned issues: " + analysis.unassigned_issues + "\nTeam members: " + members_raw + "\nPast learning: " + to_string(rec) + closed_by_block;

        // #1234 Stage 1: rule-first lookup. Build the deterministic,
        // prompt-free canonical context for the first unassigned issue in
        // `raw` (same selection rule the LLM uses for "most important": first
        // listed). If a crystallized "route" rule matches at
        // >= ROUTER_RULE_CONFIDENCE, replay its assignee without the routing
        // prompt() and skip Stage 2 entirely. Rollback knob: ROUTER_RULE_FIRST=0
        // short-circuits BOTH stages (and the verdict recording below) to the
        // LLM path -- byte-identical to pre-pilot behaviour, including no extra
        // exec sh subprocess (the canonical-context build is itself behind the
        // flag). The crystallizer category is "route", matching the
        // learn()/recommend() topic this agent already uses.
        let rule_first_flag = getenv("ROUTER_RULE_FIRST");
        let rule_first_enabled = rule_first_flag != "0";
        let min_conf_str = getenv("ROUTER_RULE_CONFIDENCE");
        let min_conf = if len(min_conf_str) > 0 { parse_float(min_conf_str); } else { 0.85; };
        // #1429 Stage 1b knobs: BM25 recall is subordinate to the pilot
        // flag (ROUTER_RULE_FIRST=0 kills BOTH stages — the one rollback
        // switch restores pre-pilot behaviour exactly). TRIAGE_BM25_K=0
        // disables recall + grounding via crystallizer_search's k<=0
        // empty-list contract.
        let bm25_flag = getenv("ROUTER_BM25_RECALL");
        let bm25_enabled = if rule_first_enabled { bm25_flag != "0"; } else { false; };
        let bm25_k_str = getenv("TRIAGE_BM25_K");
        // #1437: clamp K at 20 — each Stage 1b candidate hop is a pool-scan
        // lookup (plus a potential #670 peer-fetch round-trip when enabled),
        // so an oversized operator K would exhaust the tick CB budget
        // instead of degrading to the LLM. k<=0 still disables recall via
        // the builtin's empty-list contract.
        let bm25_k_raw = if len(bm25_k_str) > 0 { parse_int(bm25_k_str); } else { 3; };
        let bm25_k = if bm25_k_raw > 20 { 20; } else { bm25_k_raw; };
        let canon_line = if rule_first_enabled { canonical_route_context(raw); } else { ""; };
        let canon_iid = if rule_first_enabled { parse_int(repo_field(canon_line, 0)); } else { 0; };
        let canonical_ctx = if rule_first_enabled { repo_field(canon_line, 1); } else { ""; };
        let bm25_query = if bm25_enabled { repo_field(canon_line, 2); } else { ""; };

        if rule_first_enabled {
            if len(canon_line) > 0 {
                if len(canonical_ctx) > 0 {
                    if canon_iid > 0 {
                        let rule = crystallizer_lookup_with_confidence("route", canonical_ctx, min_conf);
                        if len(rule) > 0 {
                            // #843: crystallizer_lookup_with_confidence returns
                            // map<string,string> (Value::Map). Read fields with
                            // get() (the map accessor); json_get() expects a JSON
                            // string and raises "expected string, got map" on a map.
                            let rule_id = to_string(get(rule, "rule_id"));
                            let rule_action = to_string(get(rule, "action"));
                            let rule_conf_str = to_string(get(rule, "confidence"));
                            let rule_cond = to_string(get(rule, "condition"));
                            let fired = fire_route_rule(owner, repo, my_tier, canon_iid, rule_id, rule_action, rule_conf_str, rule_cond, canonical_ctx, "prefix-hit", cur_hash);
                            if fired == "fired" {
                                return;
                            };
                        };
                    };
                };
            };
        };

        // #1429 Stage 1b: BM25 recall over the crystallized rule pool.
        // Stage 1 missed (or its rule had no usable assignee) — rank the
        // pool against the REAL issue text and let the class-scoped,
        // confidence-gated point lookup confirm a candidate before firing.
        // Empty query / k<=0 / absent crystallizer all yield an empty
        // candidate list (builtin contract), so every degraded path falls
        // through to the LLM exactly like a plain miss. The try/catch
        // additionally degrades a pre-v1.20.0 host (no crystallizer_search
        // builtin) to the LLM path instead of erroring the tick.
        let bm25_cands = if bm25_enabled {
            if canon_iid > 0 {
                if len(bm25_query) > 0 {
                    try { crystallizer_search(bm25_query, bm25_k); } catch e { []; };
                } else { []; };
            } else { []; };
        } else { []; };
        if len(bm25_cands) > 0 {
            // #1437: try-wrapped — a candidate-walk error must degrade to
            // the LLM path, not kill the tick.
            let bm25_ctx = try { bm25_pick_at("route", bm25_cands, 0, min_conf); } catch e { ""; };
            if len(bm25_ctx) > 0 {
                let rule_b = crystallizer_lookup_with_confidence("route", bm25_ctx, min_conf);
                if len(rule_b) > 0 {
                    let rule_id_b = to_string(get(rule_b, "rule_id"));
                    let rule_action_b = to_string(get(rule_b, "action"));
                    let rule_conf_b = to_string(get(rule_b, "confidence"));
                    let rule_cond_b = to_string(get(rule_b, "condition"));
                    let fired_b = fire_route_rule(owner, repo, my_tier, canon_iid, rule_id_b, rule_action_b, rule_conf_b, rule_cond_b, bm25_ctx, "bm25-hit", cur_hash);
                    if fired_b == "fired" {
                        return;
                    };
                };
            };
        };

        // #1429 RAG fallback: no rule cleared the confidence bar — ground
        // the routing prompt with the top BM25 candidates (>= 0.5
        // confidence) so the LLM sees how similar past issues were routed.
        // Empty block = context byte-identical to pre-#1429.
        // #1437: try-wrapped for the same reason as the pick walk above.
        let rag_block = try { bm25_grounding_at(bm25_cands, 0, ""); } catch e { ""; };
        let grounded_context = if len(rag_block) > 0 {
            context + "\nSimilar past routing decisions (crystallized rules, BM25-ranked, most relevant first — follow them unless the issue clearly differs):" + rag_block;
        } else { context; };

        let action = prompt(
            "You are a routing agent. Suggest who should be assigned to the most important unassigned issue based on team expertise. Return JSON: issue_id (int), assignee (string, username), reasoning (string), confidence (float 0-1).",
            grounded_context
        ) -> RouteAction;

        // #1234 Stage 2: distill the LLM decision so repeat decisions on the
        // same context CLASS crystallize into a rule Stage 1 replays. The
        // crystallized rule's `action` slot stores the normalized assignee
        // (canonical_action) -- NOT free-form LLM prose -- so the KnowledgeEntry
        // id is identical across repeats and empirical_validations accumulates
        // toward crystallization. The distilled CONDITION (coarse_ctx) is a
        // literal prefix of canonical_ctx (the "kw=<sorted_csv>" part, dropping
        // the " labels=<csv>" tail) so the same keyword class crystallizes
        // regardless of the exact label set, and CrystallizedRule.matches_context
        // (ctx.starts_with(condition)) still matches the full canonical_ctx
        // Stage 1 passes. Gated behind ROUTER_RULE_FIRST so the rollback knob
        // produces byte-identical behaviour (no extra learn rows, no distill
        // side-effects) when set to "0". distill() raises until there are >= 3
        // successful "route" records, so it is guarded; knowledge_validate()
        // bumps empirical_validations toward the crystallize threshold. Only
        // distill when the LLM routed the SAME issue the canonical_ctx was built
        // for (canon_iid = first unassigned): the LLM picks the "most important"
        // unassigned issue, which may differ; distilling issue A's ctx against
        // issue B's assignee would mint a mis-scoped rule Stage 1 later replays
        // onto the wrong class. When they diverge we skip distillation this tick.
        if rule_first_enabled {
            if len(canonical_ctx) > 0 {
                if action.issue_id == canon_iid {
                    let canonical_action = normalize_assignee(action.assignee);
                    if len(canonical_action) > 0 {
                        let labels_at = index_of(canonical_ctx, " labels=");
                        let coarse_ctx = if labels_at > 0 { substring(canonical_ctx, 0, labels_at); } else { canonical_ctx; };
                        // #1435: never distill an empty-keyword class — a
                        // crystallized "kw=" rule prefix-matches EVERY route
                        // context and would route the whole class to one
                        // assignee. Observation kept (learn row tagged
                        // no-distill-empty-kw, outcome partial), distill skipped.
                        if coarse_ctx == "kw=" {
                            print("[router] distill skipped: empty-keyword context would mint an over-general kw= rule (#1435)");
                            if len(owner) > 0 {
                                learn("route", canonical_ctx, canonical_action, "partial", ["observed", "triage", "no-distill-empty-kw", repo_tag(owner, repo)]);
                            } else {
                                learn("route", canonical_ctx, canonical_action, "partial", ["observed", "triage", "no-distill-empty-kw"]);
                            };
                        } else {
                            if len(owner) > 0 {
                                learn("route", canonical_ctx, canonical_action, "success", ["distilled", "triage", repo_tag(owner, repo)]);
                            } else {
                                learn("route", canonical_ctx, canonical_action, "success", ["distilled", "triage"]);
                            };
                            let did = try { distill("route", coarse_ctx, canonical_action, "heuristic"); } catch e { ""; };
                            if len(did) > 0 {
                                knowledge_validate(did);
                            };
                        };
                    };
                } else {
                    // #1437: the skip is correct (distilling issue A's context
                    // against issue B's decision would mint a mis-scoped rule)
                    // but it must not be silent — operators debugging "why does
                    // nothing crystallize" need the divergence visible.
                    print("[router] distill skipped: LLM chose issue", action.issue_id, "but the canonical context was built for issue", canon_iid, "(#1437)");
                };
            };
        };

        if my_tier == "autonomous" {
            // colony-lint: safe-exec-concat
            let update_cmd = "$COLONY_DIR/scripts/forge-api.sh update-issue " + to_string(action.issue_id) + " --assignee " + shell_escape(action.assignee) + repo_arg(owner, repo);
            let result = try { exec sh update_cmd; } catch e {
                print("[router] Failed to assign:", e);
                "";
            };
            if len(result) > 0 {
                print("[router] Assigned issue", action.issue_id, "to", action.assignee);
                emit("triage:route_suggestion", action);
                if len(owner) > 0 {
                    learn("route", "issue " + to_string(action.issue_id), action.assignee, "success", ["acted", "triage", repo_tag(owner, repo)]);
                } else {
                    learn("route", "issue " + to_string(action.issue_id), action.assignee, "success", ["acted", "triage"]);
                };
            };
        } else {
            if my_tier == "review-gated" {
                // Non-terminal draft: emit the suggestion and post an issue note
                // flagged for human approval instead of directly assigning.
                let note = "[draft-route] **Routing Suggestion** (automated, pending approval): assign to @" + action.assignee + "\n\n" + action.reasoning;
                // colony-lint: safe-exec-concat
                let post_cmd = "$COLONY_DIR/scripts/forge-api.sh add-note " + to_string(action.issue_id) + " --body " + shell_escape(note) + repo_arg(owner, repo);
                try { exec sh post_cmd; } catch e {
                    print("[router] Failed to post draft note:", e);
                };
                emit("triage:route_suggestion", action);
                // #1234: stash the verdict (LLM-path, empty rule_id) so the next
                // tick can score this suggestion against whatever the operator
                // eventually assigns. Gated on the pilot flag so ROUTER_RULE_FIRST=0
                // records nothing and stays byte-identical to pre-pilot.
                if rule_first_enabled {
                    record_route_verdict(owner, repo, action.issue_id, action.assignee, "");
                };
                if len(owner) > 0 {
                    learn("route", "issue " + to_string(action.issue_id), action.assignee, "partial", ["triage", "review-gated", repo_tag(owner, repo)]);
                } else {
                    learn("route", "issue " + to_string(action.issue_id), action.assignee, "partial", ["triage", "review-gated"]);
                };
            } else {
                if my_tier == "propose" {
                    print("[router] Suggesting assignee for issue", action.issue_id, ":", action.assignee);
                    emit("triage:route_suggestion", action);
                    // #1234: stash the verdict (LLM-path, empty rule_id) so the
                    // next tick can score this suggestion against whatever the
                    // operator actually assigns. Gated on the pilot flag so
                    // ROUTER_RULE_FIRST=0 records nothing (byte-identical).
                    if rule_first_enabled {
                        record_route_verdict(owner, repo, action.issue_id, action.assignee, "");
                    };
                    if len(owner) > 0 {
                        learn("route", "issue " + to_string(action.issue_id), action.assignee, "partial", ["emitted", "triage", repo_tag(owner, repo)]);
                    } else {
                        learn("route", "issue " + to_string(action.issue_id), action.assignee, "partial", ["emitted", "triage"]);
                    };
                } else {
                    print("[router] Observing (tier:", my_tier, ")");
                    if len(owner) > 0 {
                        learn("route", "issue " + to_string(action.issue_id), action.assignee, "partial", ["observed", "triage", repo_tag(owner, repo)]);
                    } else {
                        learn("route", "issue " + to_string(action.issue_id), action.assignee, "partial", ["observed", "triage"]);
                    };
                };
            };
        };
    };

    let new_issue = listen("triage:new_issue", 100);
    if len(to_string(new_issue)) > 5 {
        print("[router] Received new issue draft, will route on next tick");
    };

    // #1111 (Fix #9): stamp the just-processed view fingerprint so the next
    // tick's hash gate above can detect "nothing changed" and skip prompt().
    if len(cur_hash) > 0 {
        memo_write(scoped_memo(owner, repo, "router:snapshot_hash"), cur_hash);
    };

    let now = now_iso();
    if len(now) > 0 {
        memo_write(scoped_memo(owner, repo, "router:last_check"), now);
    };
}

// Recursive iterator over `iter-repos.sh` output. `.ag` has no for/while
// loops; tail-recursion is the loop substitute (per labeler.ag's
// `eval_autonomous_at` precedent). Each call processes one TSV line and
// recurses to the next index. Empty line = past EOF, terminate.
//
// An empty owner field on a present line is the byte-identity sentinel
// from iter-repos.sh: pass it through to tick_for_repo("", "") so the
// scoped_memo / repo_arg / repo_tag helpers branch onto the legacy
// behaviour. Differs from "missing line" (= past EOF, return).
fn tick_at(spool: string, line_no: int) -> void {
    // #1358: nth-line read via nth_field (newline sep) — was an inline
    // python3 -c splitlines() one-liner. Out-of-range line_no -> "", which
    // ends the recursion exactly like the old bounds-checked print.
    let line = nth_field(spool, "\n", line_no);
    if len(line) == 0 { return; };
    let owner = repo_field(line, 0);
    let repo = repo_field(line, 1);
    tick_for_repo(owner, repo);
    return tick_at(spool, line_no + 1);
}

fn tick(reason: string) -> void {
    // #316 M3a: fan out across every repo declared in this colony's
    // [[forge.github]] array. iter-repos.sh emits TSV for each repo.
    // On single-block configs (no GITHUB_REPOS_JSON env), the helper
    // emits exactly one line from the legacy GITHUB_OWNER/REPO/URL/ME
    // env — same call shape, byte-identical experience rows.
    let spool = try { exec sh "$COLONY_DIR/../../tools/iter-repos.sh"; } catch e { ""; };
    if len(spool) == 0 {
        // No repos configured at all (or iter-repos.sh failed). Nothing
        // to tick — same shape as the pre-M3 empty-issues early-exit.
        return;
    };
    tick_at(spool, 0);
}
