// test_reviewer.ag -- Code Review colony: reviews test quality.
//
// Observes how you evaluate test coverage, test structure, missing
// edge case tests, and assertion quality in MR reviews.
//
// Run as daemon: agentis daemon agents/test_reviewer.ag --colony code-review
// Requires: exec_foreign capability, GITLAB_* env vars

cb 800;

type TestFinding {
    file: string,
    issue: string,
    severity: string,
    suggestion: string
}

type TestReview {
    mr_iid: int,
    findings: list<TestFinding>,
    summary: string
}

// #316 M3b: per-tick fan-out helpers. See triage/agents/router.ag for
// the full rationale. Single-block configs collapse to owner=="" sentinel,
// repo_arg/repo_tag return "", scoped_memo passes the suffix through.

fn repo_arg(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return " --repo " + shell_escape(owner + "/" + repo);
}

fn repo_tag(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return "repo:" + owner + "/" + repo;
}

fn scoped_memo(owner: string, repo: string, suffix: string) -> string {
    if len(owner) == 0 { return suffix; };
    return owner + "__" + repo + ":" + suffix;
}

// #316 M4: per-repo confidence read with legacy fallback. Mirrors the
// runtime tier() builtin's threshold table from ADR-0001 / CLAUDE.md.
// `agent_name` (not `agent`) — `agent` is a reserved keyword in `.ag`.
fn repo_tier(agent_name: string, owner: string, repo: string) -> string {
    let raw = if len(owner) == 0 {
        recall_latest(agent_name + ":confidence");
    } else {
        let scoped = recall_latest(scoped_memo(owner, repo, agent_name + ":confidence"));
        if len(scoped) > 0 { scoped; } else { recall_latest(agent_name + ":confidence"); };
    };
    if len(raw) == 0 { return "dormant"; };
    let c = parse_float(raw);
    if c >= 0.95 { return "autonomous"; };
    if c >= 0.8  { return "review-gated"; };
    if c >= 0.6  { return "propose"; };
    if c >= 0.4  { return "shadow"; };
    return "dormant";
}

// #1358: nth 0-based sep-delimited field of `s`, walked natively with
// index_of/substring — `.ag` v1.7 has no split(s, sep) builtin, so this
// recursive walk is the workaround (a general split(s, sep) -> list<string>
// builtin is a candidate upstream agentis-core language ask). Serves both the
// tab-separated iter-repos records (repo_field) and tick_at's newline-split
// spool reader. Total: out-of-range / negative n -> "", mirroring the
// bounds-checked python one-liner it replaces.
fn nth_field(s: string, sep: string, n: int) -> string {
    if n < 0 { return ""; };
    if len(s) == 0 { return ""; };
    let p = index_of(s, sep);
    if n == 0 {
        if p < 0 { return s; };
        return substring(s, 0, p);
    };
    if p < 0 { return ""; };
    return nth_field(substring(s, p + len(sep), len(s)), sep, n - 1);
}

// #1358: tab-separated field read, now native via nth_field (was an inline
// python3 -c split). Total: missing field / out-of-range idx -> "".
fn repo_field(line: string, idx: int) -> string {
    return nth_field(line, "\t", idx);
}

fn mr_cmd(owner: string, repo: string) -> string {
    let ts = recall_latest(scoped_memo(owner, repo, "test_reviewer:last_check"));
    // colony-lint: safe-exec-concat
    if len(ts) > 0 {
        return "$COLONY_DIR/scripts/forge-api.sh merge-requests --since " + shell_escape(ts) + " --view reviewer" + repo_arg(owner, repo);
    };
    // colony-lint: safe-exec-concat
    return "$COLONY_DIR/scripts/forge-api.sh merge-requests --view reviewer" + repo_arg(owner, repo);
}

// #317: cross-repo reference enrichment. See logic_reviewer.ag for the
// full design rationale. Returns "" => byte-identical context vs pre-#317.
fn cross_repo_context(owner: string, repo: string, mr_iid: int, body: string) -> string {
    if len(body) < 5 { return ""; };
    if len(owner) == 0 { return ""; };  // M3a sentinel: skip cross-repo scan on single-block path
    let self_arg = if len(owner) > 0 { " --self " + shell_escape(owner + "/" + repo); } else { ""; };
    // colony-lint: safe-exec-concat
    let scan_cmd = "printf '%s' " + shell_escape(body) +
        " | $COLONY_DIR/../../tools/scan-cross-repo-refs.sh" + self_arg;
    let refs_raw = try { exec sh scan_cmd; } catch e { ""; };
    if len(refs_raw) == 0 { return ""; };
    let src_args = if len(owner) > 0 {
        " --src-owner " + shell_escape(owner) +
        " --src-repo " + shell_escape(repo) +
        " --src-iid " + to_string(mr_iid);
    } else { ""; };
    // colony-lint: safe-exec-concat
    let resolve_cmd = "printf '%s' " + shell_escape(refs_raw) +
        " | $COLONY_DIR/../../tools/resolve-cross-repo-ref.sh --colony-dir \"$COLONY_DIR\" --max 5" + src_args;
    return try { exec sh resolve_cmd; } catch e { ""; };
}

// #1461 per-(iid, head) dedup: fingerprint of the MR head — sha256 of the
// mr-changes payload, first 16 hex chars. Byte-identical to the qa_reviewer /
// approval_decider helper (the #1484 gate keys on the same fingerprint shape).
// Forge-agnostic and stable across our own note posts — posting a note bumps
// updated_at but never the diff, so the reviewed-head gate below cannot
// self-retrigger (#1370 idle-suppression principle applied to the reviewer
// shape). Native sha256_hex (agentis >= 1.20.0, #1588 slice 3) hashes the
// .ag string's UTF-8 bytes directly — no shell round-trip, value-identical
// to the prior python3 sha256 pipeline it replaces.
fn head_fingerprint(changes_raw: string) -> string {
    return substring(sha256_hex(changes_raw), 0, 16);
}

// --- #1453 Wave 2 (M1): reality-check feedback loop ---
//
// Copied from the Wave-1 idiom (approval_decider / code_writer): each acting
// tier that POSTS a findings note on an MR stashes the reviewed head
// fingerprint in a single-slot `test_reviewer:pending_verdict` memo; a later
// tick mechanically re-queries the MR's terminal forge state (merged vs closed)
// and scores whether the review held up — no prompt() on this path. The head-fp
// stashed here is the SAME value the existing `test_reviewer:reviewed_head:<iid>`
// gate keys on (reused, not a new fingerprint). The `.ag` dialect has no
// imports, so signal_to_outcome / verdict_age_seconds / the list-scan helper are
// re-defined per file exactly as the seven Wave-1/pilot agents do.

// Map the reality-check signal to the experience-store outcome enum. Signal 0
// ("no terminal state yet") is handled by the caller via an early return and
// never reaches this function.
fn signal_to_outcome(signal: int) -> string {
    if signal == 1 {
        return "success";
    };
    if signal == 2 {
        return "partial";
    };
    return "failure";
}

// Age (seconds) of a pending-verdict blob.
fn verdict_age_seconds(blob: string) -> int {
    let emit_ts = parse_int(to_string(json_get(blob, "[0]")));
    let now_raw = to_string(now_ms() / 1000);
    let now = parse_int(now_raw);
    return now - emit_ts;
}

// Native FLAT iid-membership over a merge-requests list JSON: project the `iid`
// column to a newline-separated blob with ONE json_array_project call (no
// per-element map/filter `.ag` walk — the #1640 CB-overflow lesson) and test
// exact-line membership by wrapping both the projection and the needle in
// newlines so a substring hit can't cross an iid boundary ("2" never matches
// inside "12"). Total: empty/malformed list or empty needle -> false.
fn iid_in_list(raw: string, iid_str: string) -> bool {
    if len(iid_str) == 0 { return false; };
    let projected = json_array_project(raw, "", "iid");
    if len(projected) == 0 { return false; };
    return index_of("\n" + projected + "\n", "\n" + iid_str + "\n") >= 0;
}

// Record a pending review verdict. Stored as JSON array [ts, mr_iid, "head"] —
// all three fields are ASCII-safe (epoch int, iid int, 16-hex head
// fingerprint) so naive concatenation is sufficient and we skip a JSON encoder
// (the single-slot idiom from labeler.ag). `head` is the SAME head_fingerprint()
// the existing `test_reviewer:reviewed_head:<iid>` gate keys on (reused).
fn record_test_verdict(owner: string, repo: string, mr_iid: int, head: string) -> void {
    let ts_raw = to_string(now_ms() / 1000);
    let blob = "[" + ts_raw + "," + to_string(mr_iid) + ",\"" + head + "\"]";
    memo_write(scoped_memo(owner, repo, "test_reviewer:pending_verdict"), blob);
    print("[test_reviewer] verdict recorded: MR", mr_iid, "head", head);
}

// Score the pending review verdict against the MR's terminal forge state. The
// findings were posted on an MR; its fate — and whether new commits addressed
// them — is the honest ground truth. Merged & head changed since we reviewed
// (new commits landed => findings likely addressed) => success (1); merged with
// the SAME head (merged as-is / findings ignored) => partial (2);
// closed-unmerged => partial (2); still open / not found => no signal yet
// (leave pending). The merged list is parsed FIRST with a parse-guard so a
// GitHub backend (whose closed list is a superset of merged) can never misread
// a merged MR as closed-unmerged. 24h ageout drops the verdict UNSCORED
// (absence of a terminal state is not evidence either way). Mechanical compare
// via native flat builtins — NEVER a prompt().
fn evaluate_test_verdict(owner: string, repo: string) -> void {
    let key = scoped_memo(owner, repo, "test_reviewer:pending_verdict");
    let blob = recall_latest(key);
    if len(blob) < 3 {
        return;
    };
    let timeout_s = 86400;
    if verdict_age_seconds(blob) > timeout_s {
        print("[test_reviewer] verdict aged out without signal");
        memo_write(key, "");
        return;
    };
    let mr_iid = parse_int(to_string(json_get(blob, "[1]")));
    let iid_s = to_string(mr_iid);
    let stored_head = to_string(json_get(blob, "[2]"));
    // colony-lint: safe-exec-concat
    let merged_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --per-page 50" + repo_arg(owner, repo);
    let merged_raw = try { exec sh merged_cmd; } catch e { ""; };
    // Score ONLY when the merged list parsed as a JSON array (index 0 = leading
    // "["); a transient merged-query failure otherwise leaves the verdict
    // pending for a later tick.
    if index_of(merged_raw, "[") != 0 {
        return;
    };
    let signal = if iid_in_list(merged_raw, iid_s) {
        // Merged — did new commits change the head since we reviewed?
        // colony-lint: safe-exec-concat
        let changes_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-changes " + shell_escape(iid_s) + repo_arg(owner, repo);
        let changes_raw = try { exec sh changes_cmd; } catch e { ""; };
        let cur_head = if len(changes_raw) >= 10 { head_fingerprint(changes_raw); } else { ""; };
        // head changed => findings likely addressed (success); unchanged (or
        // unfetchable) => merged as-is / findings ignored (partial).
        if len(cur_head) > 0 {
            if cur_head != stored_head { 1; } else { 2; };
        } else {
            2;
        };
    } else {
        // colony-lint: safe-exec-concat
        let closed_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state closed --per-page 50" + repo_arg(owner, repo);
        let closed_raw = try { exec sh closed_cmd; } catch e { ""; };
        if iid_in_list(closed_raw, iid_s) { 2; } else { 0; };
    };
    if signal == 0 {
        return;
    };
    let outcome = signal_to_outcome(signal);
    if len(owner) > 0 {
        learn("test_review", "MR " + iid_s + " reality-check", "head " + stored_head + " | signal: " + to_string(signal), outcome, ["acted", "code-review", repo_tag(owner, repo)]);
    } else {
        learn("test_review", "MR " + iid_s + " reality-check", "head " + stored_head + " | signal: " + to_string(signal), outcome, ["acted", "code-review"]);
    };
    print("[test_reviewer] reality-check: MR", mr_iid, "signal", signal, "->", outcome);
    memo_write(key, "");
}

fn tick_for_repo(owner: string, repo: string) -> void {
    // #1453 Wave 2 (M1): score any pending review verdict FIRST (read-only, no
    // early return) before the poll below. Cheap no-op when nothing is pending.
    evaluate_test_verdict(owner, repo);

    let cmd = mr_cmd(owner, repo);
    let raw = try {
        exec sh cmd;
    } catch e {
        print("[test_reviewer] GitLab poll failed:", e);
        "";
    };

    if len(raw) < 3 {
        return;
    };

    let mr_iid = parse_int(to_string(json_get(raw, "[0].iid")));

    if mr_iid <= 0 {
        return;
    };
    // colony-lint: safe-exec-concat
    let changes_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-changes " + to_string(mr_iid) + repo_arg(owner, repo);
    let changes_raw = try { exec sh changes_cmd; } catch e { ""; };

    if len(changes_raw) < 10 {
        return;
    };

    // #201: staleness gate for the human-pattern-learning prompt. The
    // outer #147-style delta-check only catches no-activity ticks; when
    // our own review post bumps the MR updated_at, the next tick
    // re-enters this block and re-summarizes identical notes. Gate the
    // observe prompt on a 1800s window aligned with the #187 planning
    // gate.
    let now_epoch_s = to_string(now_ms() / 1000);
    let last_learn = recall_latest(scoped_memo(owner, repo, "test_reviewer:last_pattern_learn_ts"));
    let should_learn = if len(last_learn) > 0 {
        if len(now_epoch_s) > 0 {
            let delta = parse_int(now_epoch_s) - parse_int(last_learn);
            if delta >= 0 {
                if delta < 1800 { 0; } else { 1; };
            } else { 1; };
        } else { 1; };
    } else { 1; };

    if should_learn == 1 {
        // Learn from human test-related comments
        // colony-lint: safe-exec-concat
        let notes_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-notes " + to_string(mr_iid) + repo_arg(owner, repo);
        let notes_raw = try { exec sh notes_cmd; } catch e { "[]"; };

        let human_patterns = prompt(
            "Analyze these MR review comments. Find comments about testing: missing tests, coverage gaps, test quality, assertion issues, edge case tests, flaky tests, test structure. Summarize. If none, return 'none'.",
            notes_raw
        ) -> string;

        if len(human_patterns) > 5 {
            if len(owner) > 0 {
                learn("test_review", "MR " + to_string(mr_iid), human_patterns, "success", ["observed", "code-review", repo_tag(owner, repo)]);
            } else {
                learn("test_review", "MR " + to_string(mr_iid), human_patterns, "success", ["observed", "code-review"]);
            };
            if len(now_epoch_s) > 0 {
                memo_write(scoped_memo(owner, repo, "test_reviewer:last_pattern_learn_ts"), now_epoch_s);
            };
        };
    };

    // #1461 per-head review gate: suppress the WHOLE review prompt() (and its
    // [draft-review] note) when this MR head has already been reviewed at the
    // acting tier. Mirrors qa_reviewer's verdict_head dedup — an unchanged head
    // exits here, before any LLM round-trip, killing the per-tick re-review
    // spam. A new push changes the diff, changes the fingerprint, and falls
    // through to a fresh review. Placed AFTER the #201 pattern-learn block so
    // that gate keeps its own independent cadence (it learns from human
    // comments that can arrive without a head change).
    let head = head_fingerprint(changes_raw);
    if len(head) == 0 {
        return;
    };
    let reviewed = recall_latest(scoped_memo(owner, repo, "test_reviewer:reviewed_head:" + to_string(mr_iid)));
    if reviewed == head {
        return;
    };

    // Perform test review
    let rec = recommend("test_review", ["accuracy"]);
    // #317: scan PR body for cross-repo refs and prefix the resolved
    // markdown context onto the prompt. Empty xrepo_block =>
    // byte-identical context vs pre-#317. See logic_reviewer.ag.
    let pr_body = to_string(json_get(raw, "[0].description"));
    let xrepo_block = cross_repo_context(owner, repo, mr_iid, pr_body);
    let context = "MR diff:\n" + changes_raw + "\n\nLearned patterns: " + to_string(rec) + xrepo_block;

    let review = prompt(
        "You are a test reviewer. Analyze this merge request diff for test quality: missing tests for new code, untested edge cases, weak assertions (only checking happy path), missing error path tests, test duplication, flaky patterns (timing, ordering). Return JSON: mr_iid (int), findings (array with file, issue, severity, suggestion), summary (string). If tests are adequate, return empty findings. Return ONLY the raw JSON object — no markdown code fences, no ```json wrapper, no prose.",
        context
    ) -> TestReview;

    let my_tier = repo_tier("test_reviewer", owner, repo);

    if len(review.findings) > 0 {
        print("[test_reviewer] MR", mr_iid, ":", len(review.findings), "test findings");

        if my_tier == "autonomous" {
            emit("review:test_findings", review);
            let comment = "**Test Review** (automated)\n\n" + review.summary;
            // colony-lint: safe-exec-concat
            let post_cmd = "$COLONY_DIR/scripts/forge-api.sh post-note " + to_string(mr_iid) + " --body " + shell_escape(comment) + repo_arg(owner, repo);
            let result = try { exec sh post_cmd; } catch e {
                print("[test_reviewer] Failed to post comment:", e);
                "";
            };
            if len(owner) > 0 {
                learn("test_review", "MR " + to_string(mr_iid), review.summary, "success", ["code-review", "acted", repo_tag(owner, repo)]);
            } else {
                learn("test_review", "MR " + to_string(mr_iid), review.summary, "success", ["code-review", "acted"]);
            };
            if len(result) > 0 {
                // #1461: mark this head reviewed only AFTER a successful post —
                // a failed post is a logged no-op that retries next tick.
                memo_write(scoped_memo(owner, repo, "test_reviewer:reviewed_head:" + to_string(mr_iid)), head);
                // #1453 Wave 2 (M1): stash the reviewed head so a later tick
                // scores this posted review against the MR's merged/closed fate.
                record_test_verdict(owner, repo, mr_iid, head);
            };
        } else {
            if my_tier == "review-gated" {
                emit("review:test_findings", review);
                let comment = "[draft-review] **Test Review** (automated, pending approval)\n\n" + review.summary;
                // colony-lint: safe-exec-concat
                let post_cmd = "$COLONY_DIR/scripts/forge-api.sh post-note " + to_string(mr_iid) + " --body " + shell_escape(comment) + repo_arg(owner, repo);
                let result = try { exec sh post_cmd; } catch e {
                    print("[test_reviewer] Failed to post draft comment:", e);
                    "";
                };
                if len(result) > 0 {
                    // #1461: mark this head reviewed after a successful draft post.
                    memo_write(scoped_memo(owner, repo, "test_reviewer:reviewed_head:" + to_string(mr_iid)), head);
                    memo_write(scoped_memo(owner, repo, "test_reviewer:approved:" + to_string(mr_iid)), "drafted");
                    // #1453 Wave 2 (M1): stash the reviewed head (draft post) so
                    // a later tick scores it against the MR's merged/closed fate.
                    record_test_verdict(owner, repo, mr_iid, head);
                    if len(owner) > 0 {
                        learn("test_review", "drafted on MR " + to_string(mr_iid), review.summary, "partial", ["code-review", "review-gated", repo_tag(owner, repo)]);
                    } else {
                        learn("test_review", "drafted on MR " + to_string(mr_iid), review.summary, "partial", ["code-review", "review-gated"]);
                    };
                };
            } else {
                if my_tier == "propose" {
                    emit("review:test_findings", review);
                    // #1461: no post at this tier, so mark the head reviewed
                    // unconditionally — the emit is the per-tier action.
                    memo_write(scoped_memo(owner, repo, "test_reviewer:reviewed_head:" + to_string(mr_iid)), head);
                    if len(owner) > 0 {
                        learn("test_review", "MR " + to_string(mr_iid), review.summary, "partial", ["code-review", "emitted", repo_tag(owner, repo)]);
                    } else {
                        learn("test_review", "MR " + to_string(mr_iid), review.summary, "partial", ["code-review", "emitted"]);
                    };
                } else {
                    print("[test_reviewer] MR", mr_iid, ": observing (tier:", my_tier, ")");
                    // #1461: mark the head reviewed so the same head is not
                    // re-prompted every tick at the default sub-autonomous tier.
                    memo_write(scoped_memo(owner, repo, "test_reviewer:reviewed_head:" + to_string(mr_iid)), head);
                    if len(owner) > 0 {
                        learn("test_review", "MR " + to_string(mr_iid), review.summary, "partial", ["code-review", "observed", repo_tag(owner, repo)]);
                    } else {
                        learn("test_review", "MR " + to_string(mr_iid), review.summary, "partial", ["code-review", "observed"]);
                    };
                };
            };
        };
    } else {
        print("[test_reviewer] MR", mr_iid, ": adequate");
        if my_tier == "autonomous" {
            emit("review:test_findings", review);
        } else {
            if my_tier == "review-gated" {
                emit("review:test_findings", review);
            } else {
                if my_tier == "propose" {
                    emit("review:test_findings", review);
                };
            };
        };
        // #1461: an adequate review is still a completed per-head action — mark
        // it so the unchanged head is not re-prompted every tick.
        memo_write(scoped_memo(owner, repo, "test_reviewer:reviewed_head:" + to_string(mr_iid)), head);
    };

    let now = now_iso();
    if len(now) > 0 {
        memo_write(scoped_memo(owner, repo, "test_reviewer:last_check"), now);
    };
}

// Recursive iterator over `iter-repos.sh` output. See router.ag for the
// empty-owner sentinel rationale.
fn tick_at(spool: string, line_no: int) -> void {
    // #1358: nth-line read via nth_field (newline sep) — was an inline
    // python3 -c splitlines() one-liner. Out-of-range line_no -> "", which
    // ends the recursion exactly like the old bounds-checked print.
    let line = nth_field(spool, "\n", line_no);
    if len(line) == 0 { return; };
    let owner = repo_field(line, 0);
    let repo = repo_field(line, 1);
    tick_for_repo(owner, repo);
    return tick_at(spool, line_no + 1);
}

fn tick(reason: string) -> void {
    // #316 M3b: per-repo fan-out. See triage/agents/router.ag for the
    // back-compat sentinel pattern and byte-identity rationale.
    let spool = try { exec sh "$COLONY_DIR/../../tools/iter-repos.sh"; } catch e { ""; };
    if len(spool) == 0 {
        return;
    };
    tick_at(spool, 0);
}
