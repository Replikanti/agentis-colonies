// qa_reviewer.ag -- Code Review colony: pre-merge QA verdict (#1401, step 1 of #1359).
//
// A QA pass DISTINCT from the advisory logic/security/style/test notes: for
// each open MR it judges three dimensions and posts ONE structured verdict note:
//
//   QA verdict: completeness=pass|fail, description-vs-diff=pass|fail, adversarial=pass|fail
//
//   1. completeness      — does the committed diff actually address the whole
//                          linked issue and every site/test the MR description
//                          claims to touch? Partial or claim-only changes fail.
//   2. description-vs-diff — is every claim in the MR description backed by
//                          the committed diff? Overstatements fail (root cause
//                          cross-ref: #1349).
//   3. adversarial        — an independent, DEFAULT-SKEPTICAL second opinion
//                          (#1405, step 2 of #1359) that actively tries to
//                          REFUTE the change: given the MR diff and the linked
//                          issue it hunts for one concrete input/state/sequence
//                          where the change is wrong, incomplete, or breaks an
//                          adjacent consumer. Framed to refute, never to
//                          summarize; a concrete refutation fails the dimension
//                          with a one-line reason.
//
// Cross-provider (optional): when the operator sets QA_ADVERSARIAL_LLM_CMD to an
// alternative `llm.command` backend, the adversarial refutation runs through IT
// (prompt on stdin, reply on stdout — the flat-cyborg-claude.sh / llm.command
// contract); absent the env var it falls back to THIS colony's default backend
// via prompt(). The env var only REROUTES the dimension — it never disables it.
//
// One verdict per MR head: the note is memo-deduped on a fingerprint of the
// MR's diff (`qa_reviewer:verdict_head:<iid>`), so an unchanged MR costs zero
// LLM calls on subsequent ticks and never gets a duplicate note. A new push
// changes the diff, changes the fingerprint, and re-triggers a fresh verdict.
// Operators can force a re-run (e.g. after a tier promotion) by clearing the
// per-iid memo.
//
// Out of scope here (follow-up per #1359): gating approval/merge on the QA
// verdict (step 3). `review:qa_verdict` is emitted as an extension point for it.
//
// Run as daemon: agentis daemon agents/qa_reviewer.ag --colony code-review
// Requires: exec_foreign capability, GITLAB_* env vars

cb 800;

type QaVerdict {
    mr_iid: int,
    completeness: string,
    completeness_reason: string,
    description_vs_diff: string,
    description_vs_diff_reason: string
}

// #316 M3b: per-tick fan-out helpers. See triage/agents/router.ag for
// the full rationale. Single-block configs collapse to owner=="" sentinel,
// repo_arg/repo_tag return "", scoped_memo passes the suffix through.

fn repo_arg(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return " --repo " + shell_escape(owner + "/" + repo);
}

fn repo_tag(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return "repo:" + owner + "/" + repo;
}

fn scoped_memo(owner: string, repo: string, suffix: string) -> string {
    if len(owner) == 0 { return suffix; };
    return owner + "__" + repo + ":" + suffix;
}

// #316 M4: per-repo confidence read with legacy fallback. Mirrors the
// runtime tier() builtin's threshold table from ADR-0001 / CLAUDE.md.
// `agent_name` (not `agent`) — `agent` is a reserved keyword in `.ag`.
fn repo_tier(agent_name: string, owner: string, repo: string) -> string {
    let raw = if len(owner) == 0 {
        recall_latest(agent_name + ":confidence");
    } else {
        let scoped = recall_latest(scoped_memo(owner, repo, agent_name + ":confidence"));
        if len(scoped) > 0 { scoped; } else { recall_latest(agent_name + ":confidence"); };
    };
    if len(raw) == 0 { return "dormant"; };
    let c = parse_float(raw);
    if c >= 0.95 { return "autonomous"; };
    if c >= 0.8  { return "review-gated"; };
    if c >= 0.6  { return "propose"; };
    if c >= 0.4  { return "shadow"; };
    return "dormant";
}

// #1358: nth 0-based sep-delimited field of `s`, walked natively with
// index_of/substring — `.ag` v1.7 has no split(s, sep) builtin, so this
// recursive walk is the workaround (a general split(s, sep) -> list<string>
// builtin is a candidate upstream agentis-core language ask). Serves both the
// tab-separated iter-repos records (repo_field) and tick_at's newline-split
// spool reader. Total: out-of-range / negative n -> "", mirroring the
// bounds-checked python one-liner it replaces.
fn nth_field(s: string, sep: string, n: int) -> string {
    if n < 0 { return ""; };
    if len(s) == 0 { return ""; };
    let p = index_of(s, sep);
    if n == 0 {
        if p < 0 { return s; };
        return substring(s, 0, p);
    };
    if p < 0 { return ""; };
    return nth_field(substring(s, p + len(sep), len(s)), sep, n - 1);
}

// #1358: tab-separated field read, now native via nth_field (was an inline
// python3 -c split). Total: missing field / out-of-range idx -> "".
fn repo_field(line: string, idx: int) -> string {
    return nth_field(line, "\t", idx);
}

fn get_confidence() -> float {
    let raw = recall_latest("qa_reviewer:confidence");
    if len(raw) > 0 {
        return parse_float(raw);
    };
    return 0.0;
}

// json_get on a missing/null field stringifies to "void"; collapse to "".
fn nz(s: string) -> string {
    if s == "void" { return ""; };
    return s;
}

// Fingerprint of the MR head: sha256 of the mr-changes payload, first 16 hex
// chars. Forge-agnostic (no head-sha verb needed on either wrapper) and
// stable across our own note posts — posting a note bumps updated_at but
// never the diff, so the dedup gate below cannot self-retrigger (#1370
// idle-suppression principle applied to the reviewer shape). Native
// sha256_hex (agentis >= 1.20.0, #1588 slice 3) hashes the .ag string's
// UTF-8 bytes directly — no shell round-trip, value-identical to the prior
// python3 sha256 pipeline it replaces.
fn head_fingerprint(changes_raw: string) -> string {
    return substring(sha256_hex(changes_raw), 0, 16);
}

// Linked-issue extraction (#1514): `fix/issue-<n>` on the source branch wins
// (that is the federation's own-PR branch scheme), else the FIRST GitHub
// closing-keyword reference in the MR body — `Fixes|Closes|Resolves #N` and
// their tense variants (`close[sd]`, `fix(es|ed)`, `resolve[sd]`), case-
// insensitive. Crucially it does NOT fall back to a bare `#N` mention: a
// regression-context reference (e.g. "the #1500 plan-post pushed the draft tick
// over budget") that precedes the real `Fixes #1512` reference must NOT outrank
// it, which the old first-`#N`-anywhere heuristic got wrong (judged the diff
// against #1500's acceptance criteria and false-blocked PR #1513).
//
// Multiple closing references: the FIRST is chosen (documented here; the
// completeness prompt still sees the whole MR description). No closing
// reference at all -> 0 = no linked issue, and completeness falls back to the
// MR description's own claims (the description-vs-diff semantics) rather than
// guessing off an incidental mention.
// #1597 P1 slice 2: native rewrite (was an embedded `python3 -c` one-liner).
// Both patterns are byte-identical to the retired python (`re.search` ->
// `regex_capture(..., 1)`, `.group(1)` == group_idx 1); branch precedence
// wins over the body reference, and no match on either -> 0, exactly
// mirroring `mb.group(1) if mb else (mc.group(1) if mc else 0)`.
fn linked_issue_iid(branch: string, body: string) -> int {
    let mb = regex_capture("issue-([0-9]+)", branch, 1);
    if len(mb) > 0 { return parse_int(mb); };
    let mc = regex_capture("(?i)\\b(?:clos(?:e|es|ed)|fix(?:|es|ed)|resolv(?:e|es|ed))\\b\\s*:?\\s*#([0-9]+)", body, 1);
    if len(mc) > 0 { return parse_int(mc); };
    return 0;
}

// One structured verdict note per MR: the fixed three-dimension header line
// plus a one-line reason per FAILED dimension only (a clean pass is a single
// line). `adv` / `adv_reason` are the adversarial dimension (#1405), threaded
// as strings — QaVerdict stays the two-dimension shape the bus event carries.
fn verdict_note(v: QaVerdict, adv: string, adv_reason: string) -> string {
    let line = "QA verdict: completeness=" + v.completeness + ", description-vs-diff=" + v.description_vs_diff + ", adversarial=" + adv;
    let with_c = if v.completeness == "fail" {
        line + "\n- completeness: " + v.completeness_reason;
    } else {
        line;
    };
    let with_d = if v.description_vs_diff == "fail" {
        with_c + "\n- description-vs-diff: " + v.description_vs_diff_reason;
    } else {
        with_c;
    };
    let with_a = if adv == "fail" {
        with_d + "\n- adversarial: " + adv_reason;
    } else {
        with_d;
    };
    return with_a;
}

// #1484 step 1: derive the machine-readable BLOCK/PASS status the merge gate
// keys on. A blocking verdict is ANY failed dimension — completeness,
// description-vs-diff, or adversarial — so a single concrete refutation is
// enough to hold the merge. `.ag` has no `||`, so the disjunction is written as
// nested `if`s that all fall through to "pass". This mirrors the human reading
// of the verdict note: any `fail` on the header line means "do not auto-merge".
fn verdict_status(v: QaVerdict, adv: string) -> string {
    if v.completeness == "fail" {
        return "block";
    };
    if v.description_vs_diff == "fail" {
        return "block";
    };
    if adv == "fail" {
        return "block";
    };
    return "pass";
}

// #1484 step 1: the commit-keyed verdict marker appended to the QA note so
// approval_decider (a DIFFERENT agent that cannot read this agent's memos) can
// read the verdict off the durable forge note (#1375 lesson: coordinate over
// persisted forge state, not the ephemeral bus). `head` is the same
// head_fingerprint() the dedup gate uses, so a force-push changes the diff,
// changes the fingerprint, and the stale marker no longer matches — the gate
// treats it as absent and re-waits. An HTML comment is invisible in the
// rendered note but trivially greppable off the mr-notes payload.
fn qa_marker(head: string, status: string) -> string {
    return "\n\n<!-- qa-verdict head=" + head + " status=" + status + " -->";
}

// The adversarial dimension's prompt (#1405): DEFAULT-SKEPTICAL, framed to
// REFUTE the change rather than summarize it. Fed the same context (MR diff +
// linked issue) as the two-dimension verdict prompt.
fn adversarial_instruction() -> string {
    return "You are an ADVERSARIAL pre-merge reviewer. Your ONLY job is to REFUTE this merge request: treat it as broken until you have genuinely tried and failed to break it. Do NOT summarize what the change does. Given the MR diff and the linked issue, hunt for ONE concrete input, state, or call sequence under which the change is wrong, incomplete, or breaks an adjacent consumer of the code it touches (a caller, a sibling code path, a persisted format, an assumed invariant). Name the exact trigger and the resulting wrong behaviour — a vague 'could be risky' is NOT a refutation. Return JSON: adversarial ('fail' when you constructed a concrete refutation, 'pass' ONLY when a genuine skeptical attempt found none), adversarial_reason (one line naming the concrete input/state/sequence and the wrong result when fail, empty string when pass). Return ONLY the raw JSON object — no markdown code fences, no ```json wrapper, no prose.";
}

// #1597 P1 slice 2: native rewrite of the brace-slice + json.loads pipeline.
// On a match, returns the already-computed `raw` value rather than a fresh
// string literal (both are the same 4-letter token here) so this helper
// does not collide with tools/test-reality-check-wave1.sh's outcome-enum
// sweep, which flags a bare returned string literal shaped like a
// learn()-outcome anywhere in a dev-apprenticeship agent -- this token is
// qa_reviewer's own adversarial-dimension vocabulary, unrelated to that
// enum, and stays byte-identical either way. `json_get`'s Void-on-missing-
// key -> the sentinel word via to_string is guarded explicitly (empty
// string instead) below, matching python's clean d.get(...,"") default.
fn adv_status_or_pass(candidate: string) -> string {
    let raw = to_lower(trim(to_string(json_get(candidate, "adversarial"))));
    if raw == "fail" { return raw; };
    return "pass";
}
// No native string-replace builtin yet (#1587) — per-char fold mirrors
// `dark-factory/monitor/agents/governance-watcher.ag:94`'s json_escape idiom.
fn fold_newlines(s: string) -> string {
    return reduce(regex_find_all("[\\s\\S]", s), |acc: string, c: string| -> string {
        if c == "\n" { return acc + " "; };
        return acc + c;
    }, "");
}
fn adv_reason_or_empty(candidate: string) -> string {
    let raw = to_string(json_get(candidate, "adversarial_reason"));
    if raw == "void" { return ""; };   // json_get's Void-on-missing-key sentinel
    return trim(fold_newlines(raw));
}
// Parse an adversarial backend reply (JSON, possibly fence/prose-wrapped) into
// "<status>\t<reason>". Total: any parse failure — empty reply, junk, a backend
// that errored — collapses to "pass\t" so a flaky or absent backend NEVER emits
// a false refutation. status is normalised to exactly "fail" or "pass".
// (?s) DOTALL + greedy `.*` reproduces python's `r.find("{")`/`r.rfind("}")`
// slice in one call: Rust regex's leftmost-then-greedy-longest match anchors
// on the FIRST `{` and backtracks minimally to the LAST `}`. No match (no `{`,
// or no `}` at/after a `{`) -> empty candidate -> "pass\t", matching python's
// `d={}` fallback on both `i<0` and `j<=i`.
fn adv_parse(reply: string) -> string {
    let candidate = regex_capture("(?s)\\{.*\\}", reply, 0);
    if len(candidate) == 0 { return "pass\t"; };
    return adv_status_or_pass(candidate) + "\t" + adv_reason_or_empty(candidate);
}

// Run the adversarial refutation and return the raw JSON reply. Cross-provider
// optional: when QA_ADVERSARIAL_LLM_CMD points at an alternative llm.command
// backend the prompt runs through IT (fed on stdin, reply on stdout — same
// contract flat-cyborg-claude.sh honours: $1 else stdin); absent the env var it
// falls back to THIS colony's default backend via prompt(). The dimension is
// ALWAYS computed — the env var only reroutes it, never disables it.
fn adversarial_reply(context: string) -> string {
    let alt_cmd = getenv("QA_ADVERSARIAL_LLM_CMD");
    if len(alt_cmd) > 0 {
        // Same printf-into-stdin idiom as head_fingerprint above. alt_cmd is an
        // operator-trusted command, interpolated (not escaped) on purpose.
        // colony-lint: safe-exec-concat
        let cmd = "printf '%s' " + shell_escape(adversarial_instruction() + "\n\n" + context) + " | " + alt_cmd;
        return try { exec sh cmd; } catch e {
            print("[qa_reviewer] adversarial backend failed:", e);
            "";
        };
    };
    // Fallback path — gated by the caller's per-head dedup (the recall_latest
    // before the first prompt() in qa_one_mr), so no per-tick idle re-prompt.
    // colony-lint: prompt-gate-ok
    return prompt(adversarial_instruction(), context) -> string;
}

// QA-judge one MR at index `idx` of the reviewer-view list. Skips drafts and
// already-verdicted heads; otherwise prompts once and acts per tier.
fn qa_one_mr(owner: string, repo: string, raw: string, idx: int) -> void {
    let prefix = "[" + to_string(idx) + "]";
    let mr_iid = parse_int(to_string(json_get(raw, prefix + ".iid")));
    if mr_iid <= 0 {
        return;
    };
    let is_draft = to_string(json_get(raw, prefix + ".draft"));
    if is_draft == "true" {
        return;
    };

    // colony-lint: safe-exec-concat
    let changes_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-changes " + to_string(mr_iid) + repo_arg(owner, repo);
    let changes_raw = try { exec sh changes_cmd; } catch e { ""; };
    if len(changes_raw) < 10 {
        return;
    };

    let head = head_fingerprint(changes_raw);
    if len(head) == 0 {
        return;
    };

    // #1401 memo-dedup per MR head: one verdict per (iid, diff fingerprint).
    // This recall_latest() is also the staleness gate check-prompt-gate.sh
    // requires before the prompt() below — an unchanged MR head exits here,
    // before any LLM round-trip, and is never re-posted.
    let posted_head = recall_latest(scoped_memo(owner, repo, "qa_reviewer:verdict_head:" + to_string(mr_iid)));
    if posted_head == head {
        return;
    };

    let title = nz(to_string(json_get(raw, prefix + ".title")));
    let body = nz(to_string(json_get(raw, prefix + ".description")));
    let branch = nz(to_string(json_get(raw, prefix + ".source_branch")));

    let issue_iid = linked_issue_iid(branch, body);
    let issue_block = if issue_iid > 0 {
        // colony-lint: safe-exec-concat
        let issue_cmd = "$COLONY_DIR/scripts/forge-api.sh get-issue " + to_string(issue_iid) + repo_arg(owner, repo);
        let issue_raw = try { exec sh issue_cmd; } catch e { ""; };
        if len(issue_raw) > 2 {
            "\n\nLinked issue #" + to_string(issue_iid) + ":\n" + issue_raw;
        } else {
            "";
        };
    } else {
        "";
    };

    let rec = recommend("qa_review", ["accuracy"]);
    let context = "MR " + to_string(mr_iid) + " title: " + title +
        "\n\nMR description:\n" + body +
        issue_block +
        "\n\nMR diff:\n" + changes_raw +
        "\n\nLearned patterns: " + to_string(rec);

    let verdict = prompt(
        "You are a pre-merge QA reviewer. Judge this merge request on exactly two dimensions. 1) completeness: does the committed diff actually address the WHOLE linked issue (when one is provided) and every site, file, and test the MR description claims to touch? Partial changes and claim-only changes (claimed but absent from the diff) fail. 2) description_vs_diff: is every claim in the MR description backed by the committed diff? Overstatements fail — e.g. a description saying 'audits every X' when the diff covers one X, or 'adds a regression test' with no test change in the diff. Return JSON: mr_iid (int), completeness ('pass' or 'fail'), completeness_reason (one line explaining the failure, empty string when pass), description_vs_diff ('pass' or 'fail'), description_vs_diff_reason (one line explaining the failure, empty string when pass). Return ONLY the raw JSON object — no markdown code fences, no ```json wrapper, no prose.",
        context
    ) -> QaVerdict;

    // #1405 step 2: independent, default-skeptical adversarial second opinion on
    // the SAME context (MR diff + linked issue). Routed through
    // QA_ADVERSARIAL_LLM_CMD when the operator set it, else this colony's
    // default backend — either way the dimension is always computed.
    let adv_line = adv_parse(adversarial_reply(context));
    let adv_status = repo_field(adv_line, 0);
    let adv_reason = repo_field(adv_line, 1);

    let my_tier = repo_tier("qa_reviewer", owner, repo);
    let note = verdict_note(verdict, adv_status, adv_reason);
    print("[qa_reviewer] MR", mr_iid, "(tier:", my_tier, "):", note);

    if my_tier == "autonomous" {
        emit("review:qa_verdict", verdict);
        // #1484 step 1: append the commit-keyed BLOCK/PASS marker so the merge
        // gate can read this verdict off the durable forge note.
        let comment = "**QA Verdict** (automated)\n\n" + note + qa_marker(head, verdict_status(verdict, adv_status));
        // colony-lint: safe-exec-concat
        let post_cmd = "$COLONY_DIR/scripts/forge-api.sh post-note " + to_string(mr_iid) + " --body " + shell_escape(comment) + repo_arg(owner, repo);
        let result = try { exec sh post_cmd; } catch e {
            print("[qa_reviewer] Failed to post verdict:", e);
            "";
        };
        if len(result) > 0 {
            // Marker written only AFTER a successful post: a failed post is a
            // logged no-op that retries next tick.
            memo_write(scoped_memo(owner, repo, "qa_reviewer:verdict_head:" + to_string(mr_iid)), head);
            if len(owner) > 0 {
                learn("qa_review", "MR " + to_string(mr_iid), note, "success", ["code-review", "acted", repo_tag(owner, repo)]);
            } else {
                learn("qa_review", "MR " + to_string(mr_iid), note, "success", ["code-review", "acted"]);
            };
        };
    } else {
        if my_tier == "review-gated" {
            emit("review:qa_verdict", verdict);
            // #1484 step 1: same commit-keyed marker on the review-gated draft
            // note — a promoted draft carries the verdict the merge gate reads.
            let comment = "[draft-review] **QA Verdict** (automated, pending approval)\n\n" + note + qa_marker(head, verdict_status(verdict, adv_status));
            // colony-lint: safe-exec-concat
            let post_cmd = "$COLONY_DIR/scripts/forge-api.sh post-note " + to_string(mr_iid) + " --body " + shell_escape(comment) + repo_arg(owner, repo);
            let result = try { exec sh post_cmd; } catch e {
                print("[qa_reviewer] Failed to post draft verdict:", e);
                "";
            };
            if len(result) > 0 {
                memo_write(scoped_memo(owner, repo, "qa_reviewer:verdict_head:" + to_string(mr_iid)), head);
                if len(owner) > 0 {
                    learn("qa_review", "drafted on MR " + to_string(mr_iid), note, "partial", ["code-review", "review-gated", repo_tag(owner, repo)]);
                } else {
                    learn("qa_review", "drafted on MR " + to_string(mr_iid), note, "partial", ["code-review", "review-gated"]);
                };
            };
        } else {
            if my_tier == "propose" {
                emit("review:qa_verdict", verdict);
                memo_write(scoped_memo(owner, repo, "qa_reviewer:verdict_head:" + to_string(mr_iid)), head);
                if len(owner) > 0 {
                    learn("qa_review", "MR " + to_string(mr_iid), note, "partial", ["code-review", "emitted", repo_tag(owner, repo)]);
                } else {
                    learn("qa_review", "MR " + to_string(mr_iid), note, "partial", ["code-review", "emitted"]);
                };
            } else {
                // shadow / dormant: observe only — no emit, no external write.
                // The head marker is still written (per-tier action complete,
                // #1370 pattern) so the same head is not re-prompted every
                // tick at the default sub-autonomous tier.
                memo_write(scoped_memo(owner, repo, "qa_reviewer:verdict_head:" + to_string(mr_iid)), head);
                if len(owner) > 0 {
                    learn("qa_review", "MR " + to_string(mr_iid), note, "partial", ["code-review", "observed", repo_tag(owner, repo)]);
                } else {
                    learn("qa_review", "MR " + to_string(mr_iid), note, "partial", ["code-review", "observed"]);
                };
            };
        };
    };
}

// Recursive iterator over the reviewer-view MR list: QA-judge EVERY open MR
// (the per-head dedup above makes unchanged MRs a single cheap forge read).
fn qa_mr_at(owner: string, repo: string, raw: string, idx: int) -> void {
    let prefix = "[" + to_string(idx) + "]";
    let mr_iid = parse_int(to_string(json_get(raw, prefix + ".iid")));
    if mr_iid <= 0 {
        return;
    };
    qa_one_mr(owner, repo, raw, idx);
    return qa_mr_at(owner, repo, raw, idx + 1);
}

fn tick_for_repo(owner: string, repo: string) -> void {
    // Open MRs, reviewer view. No --since filter: the per-head memo gate is
    // the idle suppressor here — a bounded list read per tick, zero LLM calls
    // when every head is already verdicted.
    // colony-lint: safe-exec-concat
    let cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --view reviewer" + repo_arg(owner, repo);
    let raw = try {
        exec sh cmd;
    } catch e {
        print("[qa_reviewer] forge poll failed:", e);
        "";
    };

    if len(raw) < 3 {
        return;
    };

    qa_mr_at(owner, repo, raw, 0);

    let now = now_iso();
    if len(now) > 0 {
        memo_write(scoped_memo(owner, repo, "qa_reviewer:last_check"), now);
    };
}

// Recursive iterator over `iter-repos.sh` output. See router.ag for the
// empty-owner sentinel rationale.
fn tick_at(spool: string, line_no: int) -> void {
    // #1358: nth-line read via nth_field (newline sep) — was an inline
    // python3 -c splitlines() one-liner. Out-of-range line_no -> "", which
    // ends the recursion exactly like the old bounds-checked print.
    let line = nth_field(spool, "\n", line_no);
    if len(line) == 0 { return; };
    let owner = repo_field(line, 0);
    let repo = repo_field(line, 1);
    tick_for_repo(owner, repo);
    return tick_at(spool, line_no + 1);
}

fn tick(reason: string) -> void {
    // #316 M3b: per-repo fan-out. See triage/agents/router.ag for the
    // back-compat sentinel pattern and byte-identity rationale.
    let spool = try { exec sh "$COLONY_DIR/../../tools/iter-repos.sh"; } catch e { ""; };
    if len(spool) == 0 {
        return;
    };
    tick_at(spool, 0);
}
