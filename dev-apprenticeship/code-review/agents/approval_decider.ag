// approval_decider.ag -- Code Review colony: aggregates and decides.
//
// Listens for findings from style, logic, security, and test reviewers.
// Aggregates severity, weighs findings, and decides: approve, request
// changes, or escalate to the human.
//
// Run as daemon: agentis daemon agents/approval_decider.ag --colony code-review
// Requires: exec_foreign capability, GITLAB_* env vars

cb 600;

type ReviewDecision {
    mr_iid: int,
    action: string,
    reasoning: string,
    critical_count: int,
    total_findings: int
}

fn get_confidence() -> float {
    let raw = recall_latest("approval_decider:confidence");
    if len(raw) > 0 {
        return parse_float(raw);
    };
    return 0.0;
}

// #316 M3b: per-tick fan-out helpers. See triage/agents/router.ag for
// the full rationale. Single-block configs collapse to owner=="" sentinel,
// repo_arg/repo_tag return "", scoped_memo passes the suffix through.

fn repo_arg(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return " --repo " + shell_escape(owner + "/" + repo);
}

fn repo_tag(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return "repo:" + owner + "/" + repo;
}

fn scoped_memo(owner: string, repo: string, suffix: string) -> string {
    if len(owner) == 0 { return suffix; };
    return owner + "__" + repo + ":" + suffix;
}

// #316 M4: per-repo confidence read with legacy fallback. Mirrors the
// runtime tier() builtin's threshold table from ADR-0001 / CLAUDE.md.
// `agent_name` (not `agent`) — `agent` is a reserved keyword in `.ag`.
fn repo_tier(agent_name: string, owner: string, repo: string) -> string {
    let raw = if len(owner) == 0 {
        recall_latest(agent_name + ":confidence");
    } else {
        let scoped = recall_latest(scoped_memo(owner, repo, agent_name + ":confidence"));
        if len(scoped) > 0 { scoped; } else { recall_latest(agent_name + ":confidence"); };
    };
    if len(raw) == 0 { return "dormant"; };
    let c = parse_float(raw);
    if c >= 0.95 { return "autonomous"; };
    if c >= 0.8  { return "review-gated"; };
    if c >= 0.6  { return "propose"; };
    if c >= 0.4  { return "shadow"; };
    return "dormant";
}

fn repo_field(line: string, idx: int) -> string {
    let cmd = "L=" + shell_escape(line) + " I=" + to_string(idx) +
        " python3 -c 'import os; parts=os.environ[\"L\"].split(\"\t\"); i=int(os.environ[\"I\"]); print(parts[i] if 0<=i<len(parts) else \"\")'";
    let out = try { exec sh cmd; } catch e { ""; };
    return out;
}

// --- Forge rate-limit backoff observability (#1115) ---
//
// When a forge write fails because the backend is rate-limited (the
// gitlab-api.sh / github-api.sh wrapper returns exit 3 after exhausting its
// own jittered exponential retries), the agent must NOT mark the task failed.
// Instead it records a backoff window in the `<agent>:rate_limited_until`
// memo and emits a `code-review:rate-limited` event so the condition is
// observable, then defers the write to a later tick. The window grows
// exponentially across consecutive rate-limit hits (tracked in
// `<agent>:rl_count`) with +/-25% jitter so many agents do not resynchronise
// their retries into a thundering herd. The LLM-backend HTTP-429 backoff /
// prompt cache lives in the agentis runtime / LLM backend (handled upstream);
// this helper only governs the colony-side forge calls.

fn rl_now_epoch() -> int {
    let raw = try { exec sh "date -u +%s"; } catch e { ""; };
    if len(raw) == 0 { return 0; };
    return parse_int(raw);
}

// Active when `rate_limited_until` is set and still in the future.
fn rl_active(agent_name: string, owner: string, repo: string) -> int {
    let until_raw = recall_latest(scoped_memo(owner, repo, agent_name + ":rate_limited_until"));
    if len(until_raw) == 0 { return 0; };
    let until = parse_int(until_raw);
    let now = rl_now_epoch();
    if now == 0 { return 0; };
    if until > now { return 1; };
    return 0;
}

// Compute a jittered exponential backoff (seconds) for the given hit count.
// base 5s, doubled per consecutive hit, capped at 300s, then +/-25% jitter
// via the shell so the value is non-deterministic between agents.
fn rl_backoff_secs(count: int) -> int {
    let cmd = "C=" + shell_escape(to_string(count)) +
        " python3 -c 'import os,random; c=int(os.environ[\"C\"]); base=min(300, 5*(2**max(0,c-1))); lo=int(base*0.75); hi=int(base*1.25); print(random.randint(lo, hi) if hi>lo else base)'";
    let out = try { exec sh cmd; } catch e { ""; };
    if len(out) == 0 { return 5; };
    let secs = parse_int(out);
    if secs <= 0 { return 5; };
    return secs;
}

// Record a rate-limit hit: grow the count, stamp the until-memo, emit the
// observable event. Returns nothing; the caller defers its write.
fn rl_mark(agent_name: string, owner: string, repo: string) -> void {
    let count_raw = recall_latest(scoped_memo(owner, repo, agent_name + ":rl_count"));
    let prev = if len(count_raw) > 0 { parse_int(count_raw); } else { 0; };
    let count = prev + 1;
    let now = rl_now_epoch();
    let backoff = rl_backoff_secs(count);
    let until = now + backoff;
    memo_write(scoped_memo(owner, repo, agent_name + ":rl_count"), to_string(count));
    memo_write(scoped_memo(owner, repo, agent_name + ":rate_limited_until"), to_string(until));
    emit("code-review:rate-limited", agent_name + " backoff " + to_string(backoff) + "s until " + to_string(until));
    print("[approval_decider] rate-limited; backing off", backoff, "s (hit", count, ")");
}

// Clear the backoff state after a successful forge write.
fn rl_clear(agent_name: string, owner: string, repo: string) -> void {
    memo_write(scoped_memo(owner, repo, agent_name + ":rl_count"), "0");
    memo_write(scoped_memo(owner, repo, agent_name + ":rate_limited_until"), "0");
}

// Detect whether a just-failed forge call failed because the backend is
// rate-limited (vs an auth / 4xx / transport error). Consults the
// `forge-api.sh rate-limit-status` contract ({remaining, limit, reset_at}):
// `remaining == 0` is the rate-limit signature. Total-on-failure: when the
// status call itself errors or the instance reports null remaining, returns
// 0 so a non-rate-limit failure is not misclassified as a backoff.
fn rl_is_limited(owner: string, repo: string) -> int {
    // colony-lint: safe-exec-concat
    let cmd = "$COLONY_DIR/scripts/forge-api.sh rate-limit-status" + repo_arg(owner, repo);
    let raw = try { exec sh cmd; } catch e { ""; };
    if len(raw) < 3 { return 0; };
    let val = to_string(json_get(raw, "remaining"));
    if val == "void" { return 0; };
    let remaining = parse_int(val);
    if remaining == 0 { return 1; };
    return 0;
}

// --- #1375: durable own-PR auto-merge sweep ---
//
// The bus-based findings -> decision path below gates the WHOLE tick on four
// ephemeral `listen("review:*_findings")` reads, which the reviewers emit on
// their own independent tick schedules — so the narrow listen() window almost
// never catches them and the tick early-exits before ever reaching the
// approve/merge block. Two green, reviewed PRs sat unmerged for ~19h despite
// AUTO_MERGE=1 and the autonomous tier (#1375). The remedy (sibling of #1360):
// poll DURABLE forge state instead of the ephemeral bus. This sweep lists the
// federation's OWN open PRs every tick, BEFORE the bus gate, and approves +
// merges the green/mergeable ones — re-deriving the trigger from persisted
// state rather than a missed pub/sub. The merge verb (the SAFETY chokepoint:
// it independently re-checks mergeable + all-green and is a logged no-op
// otherwise), the green+mergeable gating semantics, and the AUTO_MERGE env
// contract are all unchanged. This path adds NO prompt().

// open_pr_field: extract [idx].<field> (a scalar string) from the open-PR list
// JSON. The raw JSON rides $J (env var, off-argv) so ARG_MAX never bites. Total:
// missing index / field / malformed JSON all collapse to "". Mirrors the helper
// of the same name in implementation/code_writer.ag (#1332).
fn open_pr_field(raw: string, idx: int, field: string) -> string {
    let cmd = "J=" + shell_escape(raw) + " I=" + to_string(idx) + " F=" + shell_escape(field) +
        " python3 -c 'import os,json,sys" +
        "\ntry:" +
        "\n    d=json.loads(os.environ[\"J\"])" +
        "\nexcept Exception:" +
        "\n    print(\"\"); sys.exit(0)" +
        "\ni=int(os.environ[\"I\"]); f=os.environ[\"F\"]" +
        "\nif not isinstance(d,list) or not (0<=i<len(d)):" +
        "\n    print(\"\"); sys.exit(0)" +
        "\nv=d[i].get(f) if isinstance(d[i],dict) else None" +
        "\nprint(v if isinstance(v,str) else (\"\" if v is None else str(v)))'";
    let out = try { exec sh cmd; } catch e { ""; };
    return out;
}

// pr_check_token: pull the value of KEY out of a `STATUS=<x> REF=<y>` line (the
// forge mr-pipeline-status verb output). Value rides $L (env var, off-argv).
// Total: "". Mirrors the helper of the same name in implementation/code_writer.ag.
fn pr_check_token(out: string, key: string) -> string {
    let cmd = "L=" + shell_escape(out) + " K=" + shell_escape(key) +
        " python3 -c 'import os,sys" +
        "\ns=os.environ[\"L\"].strip(); k=os.environ[\"K\"]+\"=\"" +
        "\nfor tok in s.split():" +
        "\n    if tok.startswith(k):" +
        "\n        print(tok[len(k):]); sys.exit(0)" +
        "\nprint(\"\")'";
    let res = try { exec sh cmd; } catch e { ""; };
    return res;
}

// ci_state: classify a raw CI status word (the mr-pipeline-status verb's STATUS
// token) into the red/green/pending vocabulary the merge sweep branches on. This
// is the classification that lived inside gitlab-api.sh/github-api.sh pr-checks
// before #1355 moved the reasoning out of the thin forge wrapper: failed/canceled
// => red, success => green, everything else (running, pending, created, …, or ""
// when the MR has no pipeline yet) => pending — CI not verified yet, so never
// race it. GitHub's backend pre-reduces its check-runs to the same
// success|failed|pending vocabulary, so this classifier is forge-agnostic.
// Mirrors the helper of the same name in implementation/code_writer.ag.
fn ci_state(status: string) -> string {
    if status == "failed" { return "red"; };
    if status == "canceled" { return "red"; };
    if status == "cancelled" { return "red"; };
    if status == "success" { return "green"; };
    return "pending";
}

// merge_attempts: how many auto-merge attempts we have already made on this PR
// (read from the merge_sweep:attempts:<iid> memo). Missing => 0.
fn merge_attempts(owner: string, repo: string, iid_str: string) -> int {
    let raw = recall_latest(scoped_memo(owner, repo, "merge_sweep:attempts:" + iid_str));
    if len(raw) == 0 { return 0; };
    return parse_int(raw);
}

// --- #1484: head-keyed QA review gate (second independent merge gate) ---
//
// A SECOND merge gate layered on top of the unchanged #1317 CI chokepoint: an
// autonomous auto-merge fires only when CI is green AND a passing QA verdict
// exists for the PR's CURRENT head commit. The verdict signal is qa_reviewer's
// pre-merge note (#1401/#1405), made machine-readable by the commit-keyed marker
// `<!-- qa-verdict head=<fp16> status=<pass|block> -->` it now appends (#1484
// step 1). approval_decider cannot read another agent's memo (agents coordinate
// over the ephemeral bus + their own `<agent>:*` memos), so the verdict is read
// off DURABLE forge state — the mr-notes payload — keyed to the same head
// fingerprint qa_reviewer embeds. A force-push changes the diff, changes the
// fingerprint, and the stale marker no longer matches: the gate re-waits (the
// intended invalidation). The pipeline fails SAFE — no marker means HOLD (never
// a spurious merge), the exact #1481 failure this closes.

// review_timeout_s: the review-wait window in seconds before the timeout
// fallback applies. Operator knob MERGE_REVIEW_TIMEOUT_S (getenv reads the
// SANITIZED env — allowlisted by install.sh); default 1800 when empty or
// unparsable (parse_int -> 0 -> default).
fn review_timeout_s() -> int {
    let raw = getenv("MERGE_REVIEW_TIMEOUT_S");
    if len(raw) == 0 { return 1800; };
    let n = parse_int(raw);
    if n <= 0 { return 1800; };
    return n;
}

// review_timeout_action: what to do when the review-wait window elapses with no
// verdict for the current head. "merge" = bound-wait-then-merge (opt-in);
// anything else (default "hold") = keep holding for a human. Operator knob
// MERGE_REVIEW_TIMEOUT_ACTION.
fn review_timeout_action() -> string {
    let raw = getenv("MERGE_REVIEW_TIMEOUT_ACTION");
    if raw == "merge" { return "merge"; };
    return "hold";
}

// bot_login: the federation's own forge login, read from the sanitized env
// (GITHUB_ME on GitHub, GITLAB_ME on GitLab — both covered by the GITHUB_*/
// GITLAB_* wildcards on the install.sh exec.env_passthrough allowlist, so no
// allowlist entry is added; start-colony.sh exports exactly one, so
// first-non-empty is unambiguous). Empty when unconfigured -> the author bind
// (note_verdict / block_reason_for_head) honors NOTHING: the gate stays HELD
// and no re-fix drives (fail-closed, never a spurious release/clobber).
fn bot_login() -> string {
    let gh = getenv("GITHUB_ME");
    if len(gh) > 0 { return gh; };
    return getenv("GITLAB_ME");
}

// head_fingerprint: fingerprint of the MR head — sha256 of the mr-changes
// payload, first 16 hex chars. BYTE-IDENTICAL to qa_reviewer.head_fingerprint
// (pinned by tools/test-approval-decider-review-gate.sh): the gate matches only
// when this fp equals the one qa_reviewer embedded in the marker, so the two
// helpers must compute the same value over the same mr-changes verb output. A
// mismatch therefore means a real force-push — the intended invalidation.
fn head_fingerprint(changes_raw: string) -> string {
    let cmd = "printf '%s' " + shell_escape(changes_raw) +
        " | python3 -c 'import sys, hashlib; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest()[:16])'";
    return try { exec sh cmd; } catch e { ""; };
}

// note_verdict: scan the mr-notes array for a body carrying the commit-keyed
// marker `<!-- qa-verdict head=<head_fp> status=<s> -->` and print `s`
// ("pass"|"block"). The raw notes JSON rides $J (env var, off-argv, like
// open_pr_field), head_fp rides $H, and the fed's own bot login rides $ME so
// ARG_MAX never bites. AUTHOR BIND (#1573): a marker is honored ONLY on a note
// whose author.username casefold-equals the bot login `me` (from bot_login());
// a marker QUOTED by an operator or another bot is ignored — a quoted `pass`
// can never release the #1484 HOLD. An empty `me` (unconfigured forge identity)
// honors NOTHING: note_verdict returns "" and the gate stays HELD (fail-closed,
// never a spurious release). Total: malformed JSON, empty head, empty me, no
// bot-authored matching marker all collapse to "" ( = none/stale, which the
// caller treats as "no verdict yet"). ORDERING: mr-notes is newest-first on
// both forges (GitHub sort=created direction=desc; GitLab order_by=created_at
// sort=desc), so the FIRST bot-authored match in iteration order is the LATEST
// verdict for this head — we take it and STOP. This prevents an early
// stray/forged "pass" from masking a later genuine "block" for the same commit
// (#1493 — now "newest BOT-authored match").
fn note_verdict(notes_raw: string, head_fp: string, me: string) -> string {
    let cmd = "J=" + shell_escape(notes_raw) + " H=" + shell_escape(head_fp) + " ME=" + shell_escape(me) +
        " python3 -c 'import os,json,re,sys" +
        "\ntry:" +
        "\n    d=json.loads(os.environ[\"J\"])" +
        "\nexcept Exception:" +
        "\n    print(\"\"); sys.exit(0)" +
        "\nh=os.environ[\"H\"]" +
        "\nme=os.environ[\"ME\"].casefold()" +
        "\nif not h or not me or not isinstance(d,list):" +
        "\n    print(\"\"); sys.exit(0)" +
        "\npat=re.compile(\"<!-- qa-verdict head=\"+re.escape(h)+\" status=(pass|block) -->\")" +
        "\nfor n in d:" +
        "\n    if not isinstance(n,dict):" +
        "\n        continue" +
        "\n    a=n.get(\"author\")" +
        "\n    author=a.get(\"username\") if isinstance(a,dict) else None" +
        "\n    if not isinstance(author,str) or author.casefold()!=me:" +
        "\n        continue" +
        "\n    b=n.get(\"body\")" +
        "\n    m=pat.search(b) if isinstance(b,str) else None" +
        "\n    if m:" +
        "\n        print(m.group(1)); sys.exit(0)" +
        "\nprint(\"\")'";
    let out = try { exec sh cmd; } catch e { ""; };
    return out;
}

// post_held_note_once: post a visible "auto-merge held" note at most once per
// head, guarded by merge_sweep:held_note:<iid> == head_fp. A new head resets the
// guard (a fresh hold/block on a new commit posts once again). Total: a failed
// post is a logged no-op — the guard is written first so a flaky forge does not
// re-spam, matching the merge_sweep:approved / attempts fail-closed convention.
fn post_held_note_once(owner: string, repo: string, iid_str: string, head_fp: string, body: string) -> void {
    let guard = recall_latest(scoped_memo(owner, repo, "merge_sweep:held_note:" + iid_str));
    if guard == head_fp { return; };
    memo_write(scoped_memo(owner, repo, "merge_sweep:held_note:" + iid_str), head_fp);
    // colony-lint: safe-exec-concat
    let cmd = "$COLONY_DIR/scripts/forge-api.sh post-note " + shell_escape(iid_str) + " --body " + shell_escape(body) + repo_arg(owner, repo);
    try { exec sh cmd; } catch e {
        print("[approval_decider] Failed to post held note for PR", iid_str, ":", e);
    };
}

// review_gate: the #1484 second merge gate. Returns "merge" | "block" | "wait".
// "merge" = a passing QA verdict exists for the current head (or the timeout
// fell back to merge); "block" = a blocking verdict is present (never merge);
// "wait" = no verdict yet and the review-wait window has not elapsed under the
// default HOLD. Only "merge" releases the merge. Fails SAFE ("wait") whenever
// the head cannot be fingerprinted. The wait clock lives in
// merge_sweep:review_wait_since:<iid> = "<fp>\t<epoch>" and is re-stamped when
// the stored fp no longer matches the head (force-push reset).
fn review_gate(owner: string, repo: string, iid_str: string) -> string {
    // colony-lint: safe-exec-concat
    let changes_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-changes " + shell_escape(iid_str) + repo_arg(owner, repo);
    let changes_raw = try { exec sh changes_cmd; } catch e { ""; };
    if len(changes_raw) < 10 { return "wait"; };
    let head_fp = head_fingerprint(changes_raw);
    if len(head_fp) == 0 { return "wait"; };

    // colony-lint: safe-exec-concat
    let notes_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-notes " + shell_escape(iid_str) + repo_arg(owner, repo);
    let notes_raw = try { exec sh notes_cmd; } catch e { ""; };
    let status = note_verdict(notes_raw, head_fp, bot_login());

    if status == "pass" {
        return "merge";
    };
    if status == "block" {
        post_held_note_once(owner, repo, iid_str, head_fp,
            "**Auto-merge held** (automated): a blocking QA verdict is present for this commit; not merging.");
        return "block";
    };

    // No matching marker (none / stale): apply the review-wait timeout clock.
    let now = rl_now_epoch();
    let since_raw = recall_latest(scoped_memo(owner, repo, "merge_sweep:review_wait_since:" + iid_str));
    if len(since_raw) == 0 {
        memo_write(scoped_memo(owner, repo, "merge_sweep:review_wait_since:" + iid_str), head_fp + "\t" + to_string(now));
        return "wait";
    };
    let stored_fp = repo_field(since_raw, 0);
    if stored_fp != head_fp {
        // Force-push reset: a new head restarts the wait clock from now.
        memo_write(scoped_memo(owner, repo, "merge_sweep:review_wait_since:" + iid_str), head_fp + "\t" + to_string(now));
        return "wait";
    };
    let epoch = parse_int(repo_field(since_raw, 1));
    let waited = now - epoch;
    if waited < review_timeout_s() {
        return "wait";
    };
    if review_timeout_action() == "merge" {
        return "merge";
    };
    // HOLD (default): post the held note once and keep waiting for a human.
    post_held_note_once(owner, repo, iid_str, head_fp,
        "**Auto-merge held** (automated): no QA verdict for this commit after the review-wait timeout; holding for a human (set [code-review] merge_review_timeout_action = merge to bound-then-merge).");
    return "wait";
}

// merge_at: process the open PR at index `idx`. Returns 1 if it ACTED (the caller
// then returns for this tick — one merge action per tick), 0 otherwise (skip +
// keep scanning). Own PRs only: the head branch must start `fix/issue-` (the
// federation's own — never touch a human / third-party PR). Acts ONLY on
// STATE=green (never red / pending — don't race CI). Approves at most once per PR
// (the merge_sweep:approved:<iid> memo, written BEFORE the approve call). Hard
// cap 3 merge attempts per PR via merge_sweep:attempts:<iid>; after that it gives
// up + logs (needs human) so a green-but-permanently-unmergeable PR can't spin.
fn merge_at(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    if iid_str == "void" { return 0; };
    let src = open_pr_field(raw, idx, "source_branch");
    // Own PRs only: never touch a PR we did not open.
    if index_of(src, "fix/issue-") != 0 { return 0; };

    // colony-lint: safe-exec-concat
    let checks_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-pipeline-status " + shell_escape(iid_str) + repo_arg(owner, repo);
    let checks_out = try { exec sh checks_cmd; } catch e { ""; };
    // Classify the raw pipeline status here (was gitlab-api.sh/github-api.sh
    // pr-checks before #1355 thinned the forge wrapper to a raw STATUS read).
    let state = ci_state(pr_check_token(checks_out, "STATUS"));
    // Only act on a confirmed green CI; pending => don't race, red => not ready.
    if state != "green" { return 0; };

    // #1484: second, independent gate — CI is green (checked FIRST, above), now
    // require a passing head-keyed QA verdict. A "wait" (no verdict yet) or
    // "block" (a blocking verdict) returns 0 WITHOUT consuming a merge attempt
    // (the 3-cap counts merge attempts, not review-wait ticks) and WITHOUT
    // approving — the PR simply retries next tick. Only "merge" falls through.
    let g = review_gate(owner, repo, iid_str);
    if g != "merge" { return 0; };

    // Hard cap: after 3 merge attempts on a green-but-unmergeable PR, give up so
    // it can't spin forever — a human takes over from here.
    let attempts = merge_attempts(owner, repo, iid_str);
    if attempts >= 3 {
        print("[approval_decider] auto-merge gave up on PR", iid_str, "after 3 attempts — needs human");
        return 0;
    };
    // Bump the attempt memo BEFORE acting so a crash mid-merge still counts
    // against the cap (fail-closed: never exceed 3 attempts).
    let next_attempt = attempts + 1;
    memo_write(scoped_memo(owner, repo, "merge_sweep:attempts:" + iid_str), to_string(next_attempt));

    // Approve at most once per PR. Write the merge_sweep:approved:<iid> memo
    // BEFORE the approve call so a retry next tick (a green-but-not-yet-mergeable
    // PR) skips re-approving — only the merge verb retries.
    let approved = recall_latest(scoped_memo(owner, repo, "merge_sweep:approved:" + iid_str));
    if len(approved) == 0 {
        memo_write(scoped_memo(owner, repo, "merge_sweep:approved:" + iid_str), "1");
        // colony-lint: safe-exec-concat
        let approve_cmd = "$COLONY_DIR/scripts/forge-api.sh approve " + shell_escape(iid_str) + repo_arg(owner, repo);
        try { exec sh approve_cmd; } catch e {
            print("[approval_decider] Failed to approve PR", iid_str, ":", e);
        };
    };

    // The gated merge verb independently re-checks mergeable + all-green and is a
    // logged no-op (empty / non-zero) when not ready, so a not-yet-mergeable PR
    // simply retries next tick (until the attempts cap).
    // colony-lint: safe-exec-concat
    let merge_cmd = "$COLONY_DIR/scripts/forge-api.sh merge " + shell_escape(iid_str) + repo_arg(owner, repo);
    let merge_result = try { exec sh merge_cmd; } catch e {
        print("[approval_decider] Auto-merge refused/failed for PR", iid_str, ":", e);
        "";
    };
    if len(merge_result) > 0 {
        print("[approval_decider] Auto-merged PR", iid_str);
    } else {
        print("[approval_decider] Auto-merge no-op for PR", iid_str, "(not green / not mergeable); will retry");
    };
    // One merge action per tick: signal the caller to return.
    return 1;
}

// merge_scan: recurse over the open-PR list, acting on at most ONE PR per tick.
// Returns 1 once an action ran (stop scanning), else 0.
fn merge_scan(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    let did = merge_at(owner, repo, raw, idx);
    if did == 1 { return 1; };
    return merge_scan(owner, repo, raw, idx + 1);
}

// merge_ready_prs: list the federation's own open PRs and, at the autonomous
// tier ONLY (merging is a terminal write) and ONLY when the operator opted in
// via AUTO_MERGE=1 (the unchanged env contract), approve + merge the FIRST green
// one whose head is a fix/issue- branch we opened. Returns 1 if it acted (the
// caller returns for this tick — one merge action per tick). This is the DURABLE
// trigger (#1375): it polls persisted forge state every tick instead of relying
// on the ephemeral review-findings bus, which the independent tick schedules
// almost always miss.
fn merge_ready_prs(owner: string, repo: string) -> int {
    // Autonomous-only: merging is a terminal write.
    if repo_tier("approval_decider", owner, repo) != "autonomous" { return 0; };
    // Preserve the AUTO_MERGE opt-in contract: no auto-merge unless enabled.
    if getenv("AUTO_MERGE") != "1" { return 0; };
    // Raw (no --view): the normalized list carries both `iid` and `source_branch`,
    // the two fields merge_at needs.
    // colony-lint: safe-exec-concat
    let list_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state opened" + repo_arg(owner, repo);
    let raw = try { exec sh list_cmd; } catch e { ""; };
    if len(raw) < 5 { return 0; };
    return merge_scan(owner, repo, raw, 0);
}

fn tick_for_repo(owner: string, repo: string) -> void {
    // #1375: durable own-PR auto-merge sweep runs FIRST — BEFORE the ephemeral
    // `listen("review:*_findings")` bus reads / early-exit gate below — so the
    // merge sweep happens every tick regardless of bus traffic (the bus emits
    // almost never land inside the narrow listen() window across independent tick
    // schedules). If a green/mergeable PR we own is merged this tick, stamp
    // last_check and return — one merge action per tick. The bus-based
    // findings -> decision path below stays intact for the no-merge ticks.
    if merge_ready_prs(owner, repo) == 1 {
        let now_m = try { exec sh "date -u +%Y-%m-%dT%H:%M:%SZ"; } catch e { ""; };
        if len(now_m) > 0 {
            memo_write(scoped_memo(owner, repo, "approval_decider:last_check"), now_m);
        };
        return;
    };

    // #147: cheap delta-check. approval_decider has no GitLab poll —
    // its input is the colony bus. If no reviewer emitted findings
    // since the last tick (all four `listen()` calls returned Void —
    // to_string "void" = 4 chars, so 4*4 = 16 < 24), early-exit
    // before any prompt(). `last_check` is refreshed so operators can
    // see the agent is alive (and so downstream tooling can tell an
    // empty-inbox tick from a stalled daemon).
    let style = listen("review:style_findings", 500);
    let logic = listen("review:logic_findings", 500);
    let security = listen("review:security_findings", 500);
    let tests = listen("review:test_findings", 500);

    let style_str = to_string(style);
    let logic_str = to_string(logic);
    let security_str = to_string(security);
    let tests_str = to_string(tests);

    // Only proceed if at least one reviewer reported
    let total_len = len(style_str) + len(logic_str) + len(security_str) + len(tests_str);
    if total_len < 24 {
        let now_e = try { exec sh "date -u +%Y-%m-%dT%H:%M:%SZ"; } catch e { ""; };
        if len(now_e) > 0 {
            memo_write(scoped_memo(owner, repo, "approval_decider:last_check"), now_e);
        };
        return;
    };

    // #1115: rate-limit backoff gate. If a prior forge write tripped the
    // backend's rate limit, `rate_limited_until` holds an epoch in the
    // future; defer this tick's prompt + write entirely (task is NOT failed,
    // just postponed) until the jittered backoff window elapses.
    if rl_active("approval_decider", owner, repo) == 1 {
        print("[approval_decider] in rate-limit backoff; deferring this tick");
        let now_g = try { exec sh "date -u +%Y-%m-%dT%H:%M:%SZ"; } catch e { ""; };
        if len(now_g) > 0 {
            memo_write(scoped_memo(owner, repo, "approval_decider:last_check"), now_g);
        };
        return;
    };

    // Learn from past human approval/rejection patterns
    // colony-lint: safe-exec-concat
    let mr_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --view reviewer" + repo_arg(owner, repo);
    let recent_merged = try { exec sh mr_cmd; } catch e { "[]"; };

    // Cold-path via upstream rate-limit: the bus-load early-exit above
    // (total_len < 24) means we only reach this prompt when at least one
    // reviewer emitted findings this tick, and after #201 each of the 4
    // upstream reviewers emits at most once per 1800s per MR — so this
    // prompt cannot sticky-re-burn without a reviewer burning first.
    // colony-lint: prompt-gate-ok
    let approval_patterns = prompt(
        "Analyze these recently merged MRs. What patterns do you see in what gets approved quickly vs what takes multiple rounds? Summarize briefly.",
        recent_merged
    ) -> string;

    if len(approval_patterns) > 10 {
        if len(owner) > 0 {
            learn("approval_decision", "merged MRs batch", approval_patterns, "success", ["observed", "code-review", repo_tag(owner, repo)]);
        } else {
            learn("approval_decision", "merged MRs batch", approval_patterns, "success", ["observed", "code-review"]);
        };
    };

    // Aggregate findings and decide
    let rec = recommend("approval_decision", ["accuracy", "safety"]);
    let all_findings = "Style findings: " + style_str + "\nLogic findings: " + logic_str + "\nSecurity findings: " + security_str + "\nTest findings: " + tests_str + "\nPast approval patterns: " + to_string(rec);

    // colony-lint: prompt-gate-ok — same bus-load early-exit rationale as above.
    let decision = prompt(
        "You are the approval decider. Based on findings from style, logic, security, and test reviewers, decide the review outcome. Rules: any critical security finding = request changes. Multiple high-severity logic findings = request changes. Style-only findings = approve with comments. No findings = approve. Return JSON: mr_iid (int, from the findings), action (string: 'approve', 'request_changes', or 'escalate'), reasoning (string), critical_count (int), total_findings (int). Return ONLY the raw JSON object — no markdown code fences, no ```json wrapper, no prose.",
        all_findings
    ) -> ReviewDecision;

    let my_tier = repo_tier("approval_decider", owner, repo);

    print("[approval_decider] MR", decision.mr_iid, "-> action:", decision.action, "(", decision.total_findings, "findings,", decision.critical_count, "critical)");

    if my_tier == "autonomous" {
        if decision.action == "approve" {
            // colony-lint: safe-exec-concat
            let approve_cmd = "$COLONY_DIR/scripts/forge-api.sh approve " + to_string(decision.mr_iid) + repo_arg(owner, repo);
            let approve_result = try { exec sh approve_cmd; } catch e {
                print("[approval_decider] Failed to approve:", e);
                "";
            };
            // #1115: a rate-limited write defers (records backoff + emits the
            // observable event) instead of marking the task failed.
            if len(approve_result) == 0 {
                if rl_is_limited(owner, repo) == 1 {
                    rl_mark("approval_decider", owner, repo);
                    return;
                };
            } else {
                rl_clear("approval_decider", owner, repo);
            };
            print("[approval_decider] Approved MR", decision.mr_iid);
            if len(owner) > 0 {
                learn("approval_decision", "MR " + to_string(decision.mr_iid), "approved: " + decision.reasoning, "success", ["acted", "code-review", repo_tag(owner, repo)]);
            } else {
                learn("approval_decision", "MR " + to_string(decision.mr_iid), "approved: " + decision.reasoning, "success", ["acted", "code-review"]);
            };
            // #1317: opt-in autonomous auto-merge. Only when the operator set
            // AUTO_MERGE=1 in colony.toml ([code-review] auto_merge = true,
            // exported by start-colony.sh) AND this agent is at the autonomous
            // tier (already true in this branch) do we close the loop. The
            // merge verb is the SAFETY chokepoint — it independently re-checks
            // mergeability + all-green CI and refuses (exit 4) otherwise, so a
            // not-ready PR here is a logged no-op that retries next tick. This
            // adds NO second prompt() (the existing staleness gate stands) and
            // leaves the decide-once memo behaviour untouched.
            // #1317: only auto-merge after a SUCCESSFUL approve (non-empty
            // approve_result). A non-rate-limit approve failure falls through
            // this branch, so without the len(approve_result) guard the merge
            // hook could fire without a posted approval review (QA on #1323).
            let auto_merge = getenv("AUTO_MERGE");
            if auto_merge == "1" {
                if len(approve_result) > 0 {
                    // #1484: the rare (per #1375) bus-decision merge site is
                    // review-gated too, so the second gate cannot be bypassed by
                    // whichever path fires. Same semantics as merge_at: only a
                    // "merge" verdict releases; "wait"/"block" is a logged no-op.
                    if review_gate(owner, repo, to_string(decision.mr_iid)) == "merge" {
                        // colony-lint: safe-exec-concat
                        let merge_cmd = "$COLONY_DIR/scripts/forge-api.sh merge " + to_string(decision.mr_iid) + repo_arg(owner, repo);
                        let merge_result = try { exec sh merge_cmd; } catch e {
                            print("[approval_decider] Auto-merge refused/failed for MR", decision.mr_iid, ":", e);
                            "";
                        };
                        if len(merge_result) > 0 {
                            print("[approval_decider] Auto-merged MR", decision.mr_iid);
                        } else {
                            print("[approval_decider] Auto-merge no-op for MR", decision.mr_iid, "(not green / not mergeable); will retry");
                        };
                    } else {
                        print("[approval_decider] Auto-merge held for MR", decision.mr_iid, "(no passing QA verdict for this head yet); will retry");
                    };
                };
            };
        } else {
            if decision.action == "request_changes" {
                let comment = "**Review Summary** (automated)\n\n" + decision.reasoning + "\n\nFindings: " + to_string(decision.total_findings) + " total, " + to_string(decision.critical_count) + " critical";
                // colony-lint: safe-exec-concat
                let post_cmd = "$COLONY_DIR/scripts/forge-api.sh post-note " + to_string(decision.mr_iid) + " --body " + shell_escape(comment) + repo_arg(owner, repo);
                let post_result = try { exec sh post_cmd; } catch e {
                    print("[approval_decider] Failed to post:", e);
                    "";
                };
                // #1115: defer on rate-limit instead of failing.
                if len(post_result) == 0 {
                    if rl_is_limited(owner, repo) == 1 {
                        rl_mark("approval_decider", owner, repo);
                        return;
                    };
                } else {
                    rl_clear("approval_decider", owner, repo);
                };
                if len(owner) > 0 {
                    learn("approval_decision", "MR " + to_string(decision.mr_iid), "request_changes: " + decision.reasoning, "success", ["acted", "code-review", repo_tag(owner, repo)]);
                } else {
                    learn("approval_decision", "MR " + to_string(decision.mr_iid), "request_changes: " + decision.reasoning, "success", ["acted", "code-review"]);
                };
            } else {
                print("[approval_decider] Escalating MR", decision.mr_iid, "to human");
                emit("review:escalation", decision);
            };
        };
    } else {
        if my_tier == "review-gated" {
            // Non-terminal draft: post a draft-flagged summary on the MR so
            // a human can promote the approve / request_changes action instead
            // of acting directly.
            let comment = "[draft-review-decision] **Review Summary** (automated, pending approval): suggested action `" + decision.action + "`\n\n" + decision.reasoning + "\n\nFindings: " + to_string(decision.total_findings) + " total, " + to_string(decision.critical_count) + " critical";
            // colony-lint: safe-exec-concat
            let post_cmd = "$COLONY_DIR/scripts/forge-api.sh post-note " + to_string(decision.mr_iid) + " --body " + shell_escape(comment) + repo_arg(owner, repo);
            try { exec sh post_cmd; } catch e {
                print("[approval_decider] Failed to post draft summary:", e);
            };
            emit("review:decision_suggestion", decision);
            if len(owner) > 0 {
                learn("approval_decision", "MR " + to_string(decision.mr_iid), "drafted: " + decision.action + " — " + decision.reasoning, "partial", ["code-review", "review-gated", repo_tag(owner, repo)]);
            } else {
                learn("approval_decision", "MR " + to_string(decision.mr_iid), "drafted: " + decision.action + " — " + decision.reasoning, "partial", ["code-review", "review-gated"]);
            };
        } else {
            if my_tier == "propose" {
                print("[approval_decider] Suggesting:", decision.action, "for MR", decision.mr_iid);
                emit("review:decision_suggestion", decision);
                if len(owner) > 0 {
                    learn("approval_decision", "MR " + to_string(decision.mr_iid), "suggested: " + decision.action + " — " + decision.reasoning, "partial", ["emitted", "code-review", repo_tag(owner, repo)]);
                } else {
                    learn("approval_decision", "MR " + to_string(decision.mr_iid), "suggested: " + decision.action + " — " + decision.reasoning, "partial", ["emitted", "code-review"]);
                };
            } else {
                print("[approval_decider] Observing (tier:", my_tier, ")");
                if len(owner) > 0 {
                    learn("approval_decision", "MR " + to_string(decision.mr_iid), "observed: " + decision.action + " — " + decision.reasoning, "partial", ["observed", "code-review", repo_tag(owner, repo)]);
                } else {
                    learn("approval_decision", "MR " + to_string(decision.mr_iid), "observed: " + decision.action + " — " + decision.reasoning, "partial", ["observed", "code-review"]);
                };
            };
        };
    };

    // Listen for new MRs from implementation colony
    let impl_mr = listen("implementation:mr_ready", 100);
    if len(to_string(impl_mr)) > 5 {
        print("[approval_decider] Implementation colony created a new MR, reviewers will pick it up on next tick");
    };

    let now = try { exec sh "date -u +%Y-%m-%dT%H:%M:%SZ"; } catch e { ""; };
    if len(now) > 0 {
        memo_write(scoped_memo(owner, repo, "approval_decider:last_check"), now);
    };
}

// Recursive iterator over `iter-repos.sh` output. See router.ag for the
// empty-owner sentinel rationale.
fn tick_at(spool: string, line_no: int) -> void {
    let line_cmd = "SP=" + shell_escape(spool) + " N=" + to_string(line_no) +
        " python3 -c 'import os; lines=os.environ[\"SP\"].splitlines(); n=int(os.environ[\"N\"]); print(lines[n] if 0<=n<len(lines) else \"\")'";
    let line = try { exec sh line_cmd; } catch e { ""; };
    if len(line) == 0 { return; };
    let owner = repo_field(line, 0);
    let repo = repo_field(line, 1);
    tick_for_repo(owner, repo);
    return tick_at(spool, line_no + 1);
}

fn tick(reason: string) -> void {
    // #316 M3b: per-repo fan-out. See triage/agents/router.ag for the
    // back-compat sentinel pattern and byte-identity rationale.
    let spool = try { exec sh "$COLONY_DIR/../../tools/iter-repos.sh"; } catch e { ""; };
    if len(spool) == 0 {
        return;
    };
    tick_at(spool, 0);
}
