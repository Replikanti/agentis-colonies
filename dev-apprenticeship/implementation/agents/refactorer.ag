// refactorer.ag -- Implementation colony: learns your refactoring style.
//
// Observes refactoring-focused MRs to learn what code smells you fix,
// when you extract vs inline, and cleanup patterns you follow. When a
// code draft arrives on the colony bus, suggests improvements.
//
// Run as daemon: agentis daemon agents/refactorer.ag --colony implementation
// Requires: exec_foreign capability, GITLAB_* env vars

cb 1000;

type RefactorPatterns {
    refactor_mrs: int,
    smells_fixed: string,
    techniques: string
}

type RefactorSuggestion {
    issue_id: int,
    suggestions: string,
    priority: string,
    confidence: float
}

// #316 M3b: per-tick fan-out helpers. See triage/agents/router.ag for
// the full rationale. Single-block configs collapse to owner=="" sentinel,
// repo_arg/repo_tag return "", scoped_memo passes the suffix through.

fn repo_arg(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return " --repo " + shell_escape(owner + "/" + repo);
}

fn repo_tag(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return "repo:" + owner + "/" + repo;
}

fn scoped_memo(owner: string, repo: string, suffix: string) -> string {
    if len(owner) == 0 { return suffix; };
    return owner + "__" + repo + ":" + suffix;
}

// #316 M4: per-repo confidence read with legacy fallback. Mirrors the
// runtime tier() builtin's threshold table from ADR-0001 / CLAUDE.md.
// `agent_name` (not `agent`) — `agent` is a reserved keyword in `.ag`.
fn repo_tier(agent_name: string, owner: string, repo: string) -> string {
    let raw = if len(owner) == 0 {
        recall_latest(agent_name + ":confidence");
    } else {
        let scoped = recall_latest(scoped_memo(owner, repo, agent_name + ":confidence"));
        if len(scoped) > 0 { scoped; } else { recall_latest(agent_name + ":confidence"); };
    };
    if len(raw) == 0 { return "dormant"; };
    let c = parse_float(raw);
    if c >= 0.95 { return "autonomous"; };
    if c >= 0.8  { return "review-gated"; };
    if c >= 0.6  { return "propose"; };
    if c >= 0.4  { return "shadow"; };
    return "dormant";
}

// #1358: nth 0-based sep-delimited field of `s`, walked natively with
// index_of/substring — `.ag` v1.7 has no split(s, sep) builtin, so this
// recursive walk is the workaround (a general split(s, sep) -> list<string>
// builtin is a candidate upstream agentis-core language ask). Serves both the
// tab-separated iter-repos records (repo_field) and tick_at's newline-split
// spool reader. Total: out-of-range / negative n -> "", mirroring the
// bounds-checked python one-liner it replaces.
fn nth_field(s: string, sep: string, n: int) -> string {
    if n < 0 { return ""; };
    if len(s) == 0 { return ""; };
    let p = index_of(s, sep);
    if n == 0 {
        if p < 0 { return s; };
        return substring(s, 0, p);
    };
    if p < 0 { return ""; };
    return nth_field(substring(s, p + len(sep), len(s)), sep, n - 1);
}

// #1358: tab-separated field read, now native via nth_field (was an inline
// python3 -c split). Total: missing field / out-of-range idx -> "".
fn repo_field(line: string, idx: int) -> string {
    return nth_field(line, "\t", idx);
}

fn merged_mr_cmd(owner: string, repo: string) -> string {
    let ts = recall_latest(scoped_memo(owner, repo, "refactorer:last_check"));
    // colony-lint: safe-exec-concat
    if len(ts) > 0 {
        return "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --since " + shell_escape(ts) + " --view impl" + repo_arg(owner, repo);
    };
    // colony-lint: safe-exec-concat
    return "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --view impl" + repo_arg(owner, repo);
}

fn get_confidence() -> float {
    let raw = recall_latest("refactorer:confidence");
    if len(raw) > 0 {
        return parse_float(raw);
    };
    return 0.0;
}

// #200: suppress repeated refactor suggestions for the same `issue_id`
// within a 300s cooldown window (5× the 60s tick interval).
// Defense-in-depth: code_writer has its own (iid, updated_at) gate so
// the bus shouldn't see dupes, but if it does we don't re-pay the LLM
// cost. Cooldown expires so a genuine new draft for the same issue
// after an edit eventually passes.
fn should_handle_refactor(owner: string, repo: string, iid_str: string) -> bool {
    // Malformed bus payload (missing issue_id) would otherwise collapse
    // all drafts into the shared "void" memo slot. Skip — we have
    // nothing to gate on.
    if iid_str == "void" {
        return false;
    };
    if len(iid_str) == 0 {
        return false;
    };
    let last_iid = recall_latest(scoped_memo(owner, repo, "refactorer:last_handled_iid"));
    if len(last_iid) == 0 {
        return true;
    };
    if iid_str != last_iid {
        return true;
    };
    let last_ts_str = recall_latest(scoped_memo(owner, repo, "refactorer:last_handled_ts"));
    if len(last_ts_str) == 0 {
        return true;
    };
    let now_str = to_string(now_ms() / 1000);
    if len(now_str) == 0 {
        return true;
    };
    let now_epoch = parse_int(now_str);
    let last_epoch = parse_int(last_ts_str);
    if now_epoch - last_epoch >= 300 {
        return true;
    };
    return false;
}

// #239: learn from each merged MR at most once per daemon lifetime.
// Without this gate, the `merge-requests --since <last_check>` query
// keeps returning the same MR at index [0] as long as its `updated_at`
// keeps getting bumped, so the learning-path prompt re-fires every
// tick at cb_budget 1000. Single-key memo, no TTL: at-most-once per
// distinct MR iid.
fn should_learn_from_mr(owner: string, repo: string, mr_iid: int) -> bool {
    if mr_iid <= 0 {
        return false;
    };
    let iid_str = to_string(mr_iid);
    let last_iid = recall_latest(scoped_memo(owner, repo, "refactorer:last_learned_mr_iid"));
    if len(last_iid) == 0 {
        return true;
    };
    if iid_str != last_iid {
        return true;
    };
    return false;
}

// --- #1453 Wave 2 (M2): reality-check feedback loop ---
//
// Copied from the Wave-1 idiom (code_writer) and the M1 code-review reviewers:
// when this agent autonomously commits a refactor onto an MR's branch, it
// stashes that MR's iid in a single-slot `refactorer:pending_verdict` memo; a
// later tick mechanically re-queries whether the MR merged or was closed-
// unmerged and scores the decision — no prompt() on this path. The `.ag` dialect
// has no imports, so signal_to_outcome / verdict_age_seconds / the list-scan
// helper are re-defined per file exactly as the seven Wave-1/M1 agents do.

// Map the reality-check signal to the experience-store outcome enum. Signal 0
// ("no terminal state yet") is handled by the caller via an early return and
// never reaches this function. M2 only emits 1 (merged) and 3 (closed-
// unmerged); the partial branch is carried for idiom parity with Wave 1.
fn signal_to_outcome(signal: int) -> string {
    if signal == 1 {
        return "success";
    };
    if signal == 2 {
        return "partial";
    };
    return "failure";
}

// Age (seconds) of a pending-verdict blob.
fn verdict_age_seconds(blob: string) -> int {
    let emit_ts = parse_int(to_string(json_get(blob, "[0]")));
    let now_raw = to_string(now_ms() / 1000);
    let now = parse_int(now_raw);
    return now - emit_ts;
}

// Native FLAT iid-membership over a merge-requests list JSON: project the `iid`
// column to a newline-separated blob with ONE json_array_project call (no
// per-element map/filter `.ag` walk — the #1640 CB-overflow lesson) and test
// exact-line membership by wrapping both the projection and the needle in
// newlines so a substring hit can't cross an iid boundary ("2" never matches
// inside "12"). Total: empty/malformed list or empty needle -> false. Same
// native helper the M1 reviewers wrote (not the python-based Wave-1
// raw_list_has_branch).
fn iid_in_list(raw: string, iid_str: string) -> bool {
    if len(iid_str) == 0 { return false; };
    let projected = json_array_project(raw, "", "iid");
    if len(projected) == 0 { return false; };
    return index_of("\n" + projected + "\n", "\n" + iid_str + "\n") >= 0;
}

// Parallel-column walk: the `iid` and `source_branch` projections of the same
// merge-requests list preserve array order (one line per element, empty line
// for a missing field — verified live), so the iid on the same line as a
// matching source_branch is that MR's iid. Driven off the always-present `iid`
// column so an empty trailing branch never short-circuits the walk; a real
// (non-empty) branch never matches an empty projection line. Returns "" when
// exhausted. Bounded native recursion (<=50 rows), not a per-element map/filter
// closure (#1640 CB lesson).
fn parallel_iid_at(branches: string, iids: string, branch: string, n: int) -> string {
    let id = nth_field(iids, "\n", n);
    if len(id) == 0 {
        return "";
    };
    let b = nth_field(branches, "\n", n);
    if b == branch {
        return id;
    };
    return parallel_iid_at(branches, iids, branch, n + 1);
}

// Resolve the iid of the MR whose `source_branch` equals `branch`, over a raw
// (no --view) merge-requests list — the raw shape carries source_branch, which
// the `impl` view drops (same reason code_writer's recover_red_prs reads raw).
// Two flat json_array_project calls + the parallel walk above; total on empty
// branch / empty or malformed list -> "".
fn iid_for_branch(raw: string, branch: string) -> string {
    if len(branch) == 0 { return ""; };
    let iids = json_array_project(raw, "", "iid");
    if len(iids) == 0 { return ""; };
    let branches = json_array_project(raw, "", "source_branch");
    return parallel_iid_at(branches, iids, branch, 0);
}

// Write the single-slot pending-verdict blob [ts, iid, ""] for the MR our
// refactor was committed onto, so a later tick scores it against merged/closed
// fate. Shared by the immediate resolve path (record_refactor_verdict) and the
// deferred retry path (resolve_pending_branch).
fn stash_refactor_verdict(owner: string, repo: string, mr_iid: string) -> void {
    let ts_raw = to_string(now_ms() / 1000);
    let blob = "[" + ts_raw + "," + mr_iid + ",\"\"]";
    memo_write(scoped_memo(owner, repo, "refactorer:pending_verdict"), blob);
    print("[refactorer] verdict recorded: MR", mr_iid);
}

// Record a pending verdict for the MR our refactor was committed onto. We know
// the branch we committed to, so resolve it to the open MR's iid and stash the
// verdict. If no open MR carries this branch yet, DON'T drop the verdict:
// commit_composer is a separate daemon on an independent tick clock and may not
// have opened the MR yet (#1653). Persist the branch in a durable
// refactorer:pending_branch_resolution memo and retry resolution on a later tick
// (resolve_pending_branch), bounded by the same 24h ageout.
fn record_refactor_verdict(owner: string, repo: string, branch: string) -> void {
    if len(branch) == 0 { return; };
    // colony-lint: safe-exec-concat
    let opened_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state opened --per-page 50" + repo_arg(owner, repo);
    let opened_raw = try { exec sh opened_cmd; } catch e { ""; };
    let mr_iid = iid_for_branch(opened_raw, branch);
    if len(mr_iid) == 0 {
        let ts_raw = to_string(now_ms() / 1000);
        let blob = "[" + ts_raw + ",\"" + branch + "\"]";
        memo_write(scoped_memo(owner, repo, "refactorer:pending_branch_resolution"), blob);
        print("[refactorer] branch not yet attributable, deferred:", branch);
        return;
    };
    stash_refactor_verdict(owner, repo, mr_iid);
}

// #1653: retry the branch->iid resolution that record_refactor_verdict deferred
// when commit_composer had not opened the MR yet. Runs at the TOP of
// tick_for_repo. On each tick it re-queries the opened-MR list for the persisted
// branch; once the branch resolves it stashes the normal pending_verdict blob and
// clears the retry memo. If the branch never becomes an open MR within 24h
// (86400s), the verdict is dropped UNSCORED — same posture as every other ageout
// in this loop: never mis-score, just skip.
fn resolve_pending_branch(owner: string, repo: string) -> void {
    let key = scoped_memo(owner, repo, "refactorer:pending_branch_resolution");
    let blob = recall_latest(key);
    if len(blob) < 3 {
        return;
    };
    if verdict_age_seconds(blob) > 86400 {
        print("[refactorer] pending branch resolution aged out without an MR");
        memo_write(key, "");
        return;
    };
    let branch = to_string(json_get(blob, "[1]"));
    if len(branch) == 0 {
        memo_write(key, "");
        return;
    };
    // colony-lint: safe-exec-concat
    let opened_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state opened --per-page 50" + repo_arg(owner, repo);
    let opened_raw = try { exec sh opened_cmd; } catch e { ""; };
    let mr_iid = iid_for_branch(opened_raw, branch);
    if len(mr_iid) == 0 {
        return;
    };
    stash_refactor_verdict(owner, repo, mr_iid);
    memo_write(key, "");
    print("[refactorer] deferred branch resolved -> MR", mr_iid, "branch", branch);
}

// Score the pending verdict against the fate of the MR we committed a refactor
// onto. Mechanical compare via the raw merge-requests lists — NEVER a prompt().
// merged => success (1); closed-unmerged => failure (3); still open / not found
// => no signal yet (leave pending). The merged list is parsed FIRST with a
// parse-guard so a GitHub backend (whose closed list is a superset of merged)
// can never misread a merged MR as closed-unmerged. 24h ageout drops the
// verdict UNSCORED. Runs at the TOP of tick_for_repo, before any other work.
fn evaluate_refactor_verdict(owner: string, repo: string) -> void {
    let key = scoped_memo(owner, repo, "refactorer:pending_verdict");
    let blob = recall_latest(key);
    if len(blob) < 3 {
        return;
    };
    let timeout_s = 86400;
    if verdict_age_seconds(blob) > timeout_s {
        print("[refactorer] verdict aged out without signal");
        memo_write(key, "");
        return;
    };
    let mr_iid = parse_int(to_string(json_get(blob, "[1]")));
    let iid_s = to_string(mr_iid);
    // colony-lint: safe-exec-concat
    let merged_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --per-page 50" + repo_arg(owner, repo);
    let merged_raw = try { exec sh merged_cmd; } catch e { ""; };
    if index_of(merged_raw, "[") != 0 {
        return;
    };
    let signal = if iid_in_list(merged_raw, iid_s) {
        1;
    } else {
        // colony-lint: safe-exec-concat
        let closed_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state closed --per-page 50" + repo_arg(owner, repo);
        let closed_raw = try { exec sh closed_cmd; } catch e { ""; };
        if iid_in_list(closed_raw, iid_s) { 3; } else { 0; };
    };
    if signal == 0 {
        return;
    };
    let outcome = signal_to_outcome(signal);
    if len(owner) > 0 {
        learn("refactor", "MR " + iid_s + " reality-check", "signal: " + to_string(signal), outcome, ["acted", "implementation", repo_tag(owner, repo)]);
    } else {
        learn("refactor", "MR " + iid_s + " reality-check", "signal: " + to_string(signal), outcome, ["acted", "implementation"]);
    };
    print("[refactorer] reality-check: MR", mr_iid, "signal", signal, "->", outcome);
    memo_write(key, "");
}

fn tick_for_repo(owner: string, repo: string) -> void {
    // #1453 Wave 2 (M2): score any pending MR verdict FIRST (read-only, no
    // early return) before the poll below. Cheap no-op when nothing is pending.
    evaluate_refactor_verdict(owner, repo);
    // #1653: retry a deferred branch->iid resolution (commit_composer may have
    // opened the MR on a later tick than the commit). No-op when nothing pending.
    resolve_pending_branch(owner, repo);

    // 1. Learn from refactoring patterns in merged MRs
    let cmd = merged_mr_cmd(owner, repo);
    let raw = try {
        exec sh cmd;
    } catch e {
        print("[refactorer] GitLab poll failed:", e);
        "";
    };

    if len(raw) > 10 {
        let mr_iid = parse_int(to_string(json_get(raw, "[0].iid")));

        if should_learn_from_mr(owner, repo, mr_iid) {
            memo_write(scoped_memo(owner, repo, "refactorer:last_learned_mr_iid"), to_string(mr_iid));
            // colony-lint: safe-exec-concat
            let changes_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-changes " + to_string(mr_iid) + repo_arg(owner, repo);
            let changes_raw = try { exec sh changes_cmd; } catch e { ""; };

            if len(changes_raw) > 10 {
                // colony-lint: safe-exec-concat
                let commits_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-commits " + to_string(mr_iid) + repo_arg(owner, repo);
                let commits_raw = try { exec sh commits_cmd; } catch e { "[]"; };

                let patterns = prompt(
                    "Analyze this MR diff and commit messages. Identify refactoring activity: code smells that were fixed (duplication, long methods, dead code, naming), techniques used (extract method, inline variable, move to module, simplify conditional). If the MR is purely new features with no refactoring, set refactor_mrs to 0. Return JSON: refactor_mrs (int, 0 or 1), smells_fixed (string), techniques (string). Return ONLY the raw JSON object — no markdown code fences, no ```json wrapper, no prose.",
                    changes_raw + "\n\nCommit messages: " + commits_raw
                ) -> RefactorPatterns;

                if patterns.refactor_mrs > 0 {
                    if len(owner) > 0 {
                        learn(
                            "refactor",
                            "MR " + to_string(mr_iid),
                            "smells: " + patterns.smells_fixed + " | techniques: " + patterns.techniques,
                            "success",
                            ["observed", "implementation", repo_tag(owner, repo)]
                        );
                    } else {
                        learn(
                            "refactor",
                            "MR " + to_string(mr_iid),
                            "smells: " + patterns.smells_fixed + " | techniques: " + patterns.techniques,
                            "success",
                            ["observed", "implementation"]
                        );
                    };
                    print("[refactorer] Learned refactoring patterns from MR", mr_iid);
                };
            };
        };
    };

    // 2. Listen for code drafts and suggest improvements
    let draft = listen("implementation:code_draft", 100);
    let draft_str = to_string(draft);

    if len(draft_str) > 5 {
        // #200: extract issue_id directly from the bus payload JSON and
        // gate on (iid, 300s cooldown) before paying for the review LLM
        // call. Stash the memos *before* prompt() so downstream failures
        // don't force re-burn.
        let incoming_iid = to_string(json_get(draft_str, "issue_id"));
        if should_handle_refactor(owner, repo, incoming_iid) {
            memo_write(scoped_memo(owner, repo, "refactorer:last_handled_iid"), incoming_iid);
            let ts_now = to_string(now_ms() / 1000);
            if len(ts_now) > 0 {
                memo_write(scoped_memo(owner, repo, "refactorer:last_handled_ts"), ts_now);
            };
            let rec = recommend("refactor", ["accuracy"]);
            let context = "Code draft to review: " + draft_str + "\nLearned refactoring patterns: " + to_string(rec);

            let suggestion = prompt(
                "You are a refactoring agent. A code draft has been produced for an issue. Review it against learned refactoring patterns and suggest improvements. Focus on: naming consistency, duplication, overly complex conditionals, missing error handling, extract/inline opportunities. Return JSON: issue_id (int, from the draft), suggestions (string, markdown list of specific improvements), priority (string, 'high' if structural issues or 'low' if cosmetic only), confidence (float 0-1). Return ONLY the raw JSON object — no markdown code fences, no ```json wrapper, no prose.",
                context
            ) -> RefactorSuggestion;

            let my_tier = repo_tier("refactorer", owner, repo);
            print("[refactorer] Reviewed draft for issue", suggestion.issue_id, "(tier:", my_tier, ")");

            if my_tier == "autonomous" {
                // Generate refactored code and commit to branch.
                // #131: read branch_name via field access on the bus-delivered
                // record instead of stringifying + re-prompting.
                let branch = draft.branch_name;
                let refactor_context = "Code draft: " + draft_str + "\nSuggestions: " + suggestion.suggestions + "\nPatterns: " + to_string(rec);
                let actions_json = prompt(
                    "You are a refactorer. Apply these refactoring suggestions to the code draft. Return a JSON array of objects, each with: action (string, 'update'), file_path (string), content (string, the refactored file content). Only return the JSON array, nothing else.",
                    refactor_context
                ) -> string;
                // colony-lint: safe-exec-concat (all dynamic values wrapped in shell_escape)
                let commit_cmd = "$COLONY_DIR/scripts/forge-api.sh commit-files --branch " + shell_escape(branch) + " --message " + shell_escape("refactor: apply improvements for #" + to_string(suggestion.issue_id)) + " --actions " + shell_escape(actions_json) + repo_arg(owner, repo);
                let commit_result = try { exec sh commit_cmd; } catch e {
                    print("[refactorer] Commit failed:", e);
                    "";
                };
                if len(commit_result) > 0 {
                    print("[refactorer] Committed refactoring to", branch);
                    emit("implementation:refactor_suggestions", suggestion);
                    if len(owner) > 0 {
                        learn("refactor", "issue " + to_string(suggestion.issue_id), suggestion.suggestions, "success", ["acted", "implementation", repo_tag(owner, repo)]);
                    } else {
                        learn("refactor", "issue " + to_string(suggestion.issue_id), suggestion.suggestions, "success", ["acted", "implementation"]);
                    };
                    // #1453 Wave 2 (M2): stash the iid of the MR carrying this
                    // branch so a later tick scores it against merged/closed fate.
                    record_refactor_verdict(owner, repo, branch);
                };
            } else {
                if my_tier == "review-gated" {
                    // Non-terminal draft: post the refactoring suggestions as a
                    // comment on the issue so a human can approve before we
                    // commit refactored files. No commit at this tier.
                    let note = "[draft-refactor] **Refactoring Suggestions** (automated, pending approval) — priority: " + suggestion.priority + "\n\n" + suggestion.suggestions;
                    // colony-lint: safe-exec-concat
                    let post_cmd = "$COLONY_DIR/scripts/forge-api.sh add-note " + to_string(suggestion.issue_id) + " --body " + shell_escape(note) + repo_arg(owner, repo);
                    try { exec sh post_cmd; } catch e {
                        print("[refactorer] Failed to post draft note:", e);
                    };
                    emit("implementation:refactor_suggestions", suggestion);
                    if len(owner) > 0 {
                        learn("refactor", "issue " + to_string(suggestion.issue_id), suggestion.suggestions, "partial", ["implementation", "review-gated", repo_tag(owner, repo)]);
                    } else {
                        learn("refactor", "issue " + to_string(suggestion.issue_id), suggestion.suggestions, "partial", ["implementation", "review-gated"]);
                    };
                } else {
                    if my_tier == "propose" {
                        emit("implementation:refactor_suggestions", suggestion);
                        if len(owner) > 0 {
                            learn("refactor", "issue " + to_string(suggestion.issue_id), suggestion.suggestions, "partial", ["emitted", "implementation", repo_tag(owner, repo)]);
                        } else {
                            learn("refactor", "issue " + to_string(suggestion.issue_id), suggestion.suggestions, "partial", ["emitted", "implementation"]);
                        };
                    } else {
                        print("[refactorer] Observing (tier:", my_tier, ")");
                        if len(owner) > 0 {
                            learn("refactor", "issue " + to_string(suggestion.issue_id), suggestion.suggestions, "partial", ["observed", "implementation", repo_tag(owner, repo)]);
                        } else {
                            learn("refactor", "issue " + to_string(suggestion.issue_id), suggestion.suggestions, "partial", ["observed", "implementation"]);
                        };
                    };
                };
            };
        };
    };

    let now = now_iso();
    if len(now) > 0 {
        memo_write(scoped_memo(owner, repo, "refactorer:last_check"), now);
    };
}

// Recursive iterator over `iter-repos.sh` output. See router.ag for the
// empty-owner sentinel rationale.
fn tick_at(spool: string, line_no: int) -> void {
    // #1358: nth-line read via nth_field (newline sep) — was an inline
    // python3 -c splitlines() one-liner. Out-of-range line_no -> "", which
    // ends the recursion exactly like the old bounds-checked print.
    let line = nth_field(spool, "\n", line_no);
    if len(line) == 0 { return; };
    let owner = repo_field(line, 0);
    let repo = repo_field(line, 1);
    tick_for_repo(owner, repo);
    return tick_at(spool, line_no + 1);
}

fn tick(reason: string) -> void {
    // #316 M3b: per-repo fan-out. See triage/agents/router.ag for the
    // back-compat sentinel pattern and byte-identity rationale.
    let spool = try { exec sh "$COLONY_DIR/../../tools/iter-repos.sh"; } catch e { ""; };
    if len(spool) == 0 {
        return;
    };
    tick_at(spool, 0);
}
