// code_writer.ag -- Implementation colony: learns how you write code.
//
// Observes merged MRs to learn naming conventions, architecture patterns,
// idioms, error handling style, and file organization. When an issue is
// assigned for implementation, drafts code matching learned patterns.
//
// Run as daemon: agentis daemon agents/code_writer.ag --colony implementation
// Requires: exec_foreign capability, GITLAB_* env vars

cb 3000;

type CodePatterns {
    mr_count: int,
    naming: string,
    structure: string,
    error_handling: string
}

type CodeDraft {
    issue_id: int,
    branch_name: string,
    title: string,
    files: string,
    summary: string,
    confidence: float
}

// #316 M3b: per-tick fan-out helpers. See triage/agents/router.ag for
// the full rationale. Single-block configs collapse to owner=="" sentinel,
// repo_arg/repo_tag return "", scoped_memo passes the suffix through.

fn repo_arg(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return " --repo " + shell_escape(owner + "/" + repo);
}

fn repo_tag(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return "repo:" + owner + "/" + repo;
}

fn scoped_memo(owner: string, repo: string, suffix: string) -> string {
    if len(owner) == 0 { return suffix; };
    return owner + "__" + repo + ":" + suffix;
}

// #316 M4: per-repo confidence read with legacy fallback. Mirrors the
// runtime tier() builtin's threshold table from ADR-0001 / CLAUDE.md.
// `agent_name` (not `agent`) — `agent` is a reserved keyword in `.ag`.
fn repo_tier(agent_name: string, owner: string, repo: string) -> string {
    let raw = if len(owner) == 0 {
        recall_latest(agent_name + ":confidence");
    } else {
        let scoped = recall_latest(scoped_memo(owner, repo, agent_name + ":confidence"));
        if len(scoped) > 0 { scoped; } else { recall_latest(agent_name + ":confidence"); };
    };
    if len(raw) == 0 { return "dormant"; };
    let c = parse_float(raw);
    if c >= 0.95 { return "autonomous"; };
    if c >= 0.8  { return "review-gated"; };
    if c >= 0.6  { return "propose"; };
    if c >= 0.4  { return "shadow"; };
    return "dormant";
}

// #1358: nth 0-based sep-delimited field of `s`, walked natively with
// index_of/substring — `.ag` v1.7 has no split(s, sep) builtin, so this
// recursive walk is the workaround (a general split(s, sep) -> list<string>
// builtin is a candidate upstream agentis-core language ask). Serves both the
// tab-separated iter-repos records (repo_field) and tick_at's newline-split
// spool reader. Total: out-of-range / negative n -> "", mirroring the
// bounds-checked python one-liner it replaces.
fn nth_field(s: string, sep: string, n: int) -> string {
    if n < 0 { return ""; };
    if len(s) == 0 { return ""; };
    let p = index_of(s, sep);
    if n == 0 {
        if p < 0 { return s; };
        return substring(s, 0, p);
    };
    if p < 0 { return ""; };
    return nth_field(substring(s, p + len(sep), len(s)), sep, n - 1);
}

// #1358: tab-separated field read, now native via nth_field (was an inline
// python3 -c split). Total: missing field / out-of-range idx -> "".
fn repo_field(line: string, idx: int) -> string {
    return nth_field(line, "\t", idx);
}

// #1214/#1356: code-edit-job.sh prints ONE raw line. On a fresh launch it is
// the bare keyword `LAUNCHED`; when the global concurrency cap deferred the
// launch (no job dir created) it is `RUNNING`; when polling an existing job dir
// it is `STATUS=<s> PID_ALIVE=<0|1> RESULT=<url>` — RAW facts, no decision. The
// running/done/no_edits/error/job-died FSM that used to live in the launcher's
// case block now lives here in job_decide (below, after pr_check_token, whose
// KEY=<v> token reader it reuses). job_word returns the leading whitespace token
// (`LAUNCHED` / `RUNNING` / `STATUS=<s>`) — enough for job_decide to tell the two
// launch-path sentinels from a poll line. Native since #1358 (was an inline
// python3 -c): the leading token is everything before the first space, cut
// again at a newline in case a garbled multi-line blob slipped through.
// Total: missing/garbled input -> "".
fn job_word(out: string) -> string {
    let head = nth_field(out, " ", 0);
    let nl = index_of(head, "\n");
    if nl < 0 { return head; };
    return substring(head, 0, nl);
}

// #1172: pull the primary file path out of `draft.files` (a markdown list of
// "file path + what each does" lines). We fetch the existing content of that
// one file so the code-gen prompt can EDIT it rather than clobber it. Multi-
// file extraction in `.ag` is impractical, so we deliberately fetch only the
// first/primary path; a from-scratch fallback still applies to the rest. The
// helper scans for the first backtick-quoted token (the draft prompt tends to
// wrap paths in backticks); failing that, the first slash-or-dot-bearing token
// on the first list line. Returns "" when nothing path-shaped is found.
//
// #1597 (substrate purity P1): native rewrite, was an inline `python3 -c`.
// `is_path_shaped` mirrors the python filter (`len(tok)>2 and ("/" in tok or
// "." in tok)`); `lstrip_markers` mirrors `.lstrip("-*0123456789. \t")` via
// repeated single-char strip from the front; `first_path_in_lines_at` walks
// lines by index (no native list-slice/list-tail builtin exists per
// docs/language.md's Core/Higher-order builtin tables, so an index-parameter
// recursion replaces the python `for ln in t.splitlines()` loop). Total on
// every failure mode (empty `files`, no lines, no path-shaped token) -> "",
// matching the python's trailing `print("")`.
fn is_path_shaped(tok: string) -> bool {
    if len(tok) <= 2 { return false; };
    if index_of(tok, "/") >= 0 { return true; };
    return index_of(tok, ".") >= 0;
}

fn first_path_token(toks: list<string>) -> string {
    let hit = filter(toks, |t: string| -> bool { return is_path_shaped(trim(t)); });
    if len(hit) == 0 { return ""; };
    return trim(get(hit, 0));
}

fn lstrip_markers(s: string) -> string {
    if len(s) == 0 { return s; };
    if index_of("-*0123456789. \t", substring(s, 0, 1)) >= 0 {
        return lstrip_markers(substring(s, 1, len(s)));
    };
    return s;
}

fn first_path_in_lines_at(lines: list<string>, i: int) -> string {
    if i >= len(lines) { return ""; };
    let hit = first_path_token(regex_split("[\\s:,]+", lstrip_markers(get(lines, i))));
    if len(hit) > 0 { return hit; };
    return first_path_in_lines_at(lines, i + 1);
}

fn primary_file_path(files: string) -> string {
    let bt = regex_capture("`([^`]+)`", files, 1);
    if len(bt) > 0 { return trim(bt); };
    return first_path_in_lines_at(regex_split("\\r\\n|\\r|\\n", files), 0);
}

// #1195: deterministically turn (existing content, LLM search/replace edits)
// into the `--actions` JSON commit-files expects, WITHOUT the LLM ever having
// to emit the full file. tools/apply-edits.py reads the original content on
// stdin and the edits JSON from $APPLY_EDITS, replaces each edit's old_str
// (which must be an EXACT, unique substring) and prints the new full content;
// we then json.dumps a single-element [{action:"update", file_path, content}]
// array. Large values (the fetched file + the edits) ride env vars / a pipe
// fed by `printf` (a shell builtin), never argv, so ARG_MAX never bites. If
// apply-edits.py exits non-zero (mangled / ambiguous / missing old_str — the
// flat-cyborg screen-scrape corruption guard) the whole `exec sh` exits
// non-zero and the caller's `try` collapses to "" => treated as a failed
// code-gen, no commit. `path` is shell_escape'd; `orig` and `edits` are passed
// as env vars so the body itself carries no untrusted concatenation.
//
// #1597 (substrate purity P1): the `python3 -c` wrapper only did three
// mechanical things apply-edits.py already does itself (build the tools/
// path, run it with content on stdin + $APPLY_EDITS, json.dumps the
// envelope) — verified apply-edits.py:126-141 reads stdin + the env var
// directly. Now a plain `sh -c 'printf ... | python3 ...'` pipeline (no
// embedded interpreter logic); the JSON envelope is built with
// `json_escape_string` (matches python's `json.dumps` string-escaping for
// `"`, `\`, control chars). A shell pipeline's exit status is the LAST
// command's, so a non-zero apply-edits.py exit still fails the whole
// `exec sh` -> `try/catch` collapses to "" -> same no-commit path as
// today. `tools/apply-edits.py` itself is UNTOUCHED (stays class C).
fn apply_edits_to_actions(path: string, orig: string, edits: string) -> string {
    // colony-lint: safe-exec-concat
    let cmd = "ORIG=" + shell_escape(orig) + " APPLY_EDITS=" + shell_escape(edits) +
        " sh -c 'printf %s \"$ORIG\" | python3 \"$COLONY_DIR/../../tools/apply-edits.py\"'";
    let content = try { exec sh cmd; } catch e { ""; };
    if len(content) == 0 { return ""; };
    return "[{\"action\": \"update\", \"file_path\": \"" + json_escape_string(path) +
        "\", \"content\": \"" + json_escape_string(content) + "\"}]";
}

// #1208: render a line-NUMBERED view of the file content for the edit prompt.
// Each line gets an `N|` prefix (N = 1-based line number) so the LLM can name
// line-range edits without ever reproducing exact source bytes (the markdown
// `**`-drop failure mode of the search/replace path). The UN-numbered content
// rides $C (env var, off-argv) so ARG_MAX never bites; splitlines() keepends is
// not needed here because the numbered view is a display artifact, not content.
//
// substrate-purity: deferred (CB: native recursion ~46 CB/line would exhaust
// cb_per_tick on large files; revisit after a cheaper primitive lands)
fn numbered_view(content: string) -> string {
    // colony-lint: safe-exec-concat
    let cmd = "C=" + shell_escape(content) +
        " python3 -c 'import os,sys" +
        "\ntext=os.environ[\"C\"]" +
        "\nlines=text.splitlines()" +
        "\nsys.stdout.write(\"\\n\".join(\"%d|%s\" % (i+1, ln) for i,ln in enumerate(lines)))'";
    let out = try { exec sh cmd; } catch e { ""; };
    return out;
}

// #1208: deterministically turn (existing UN-numbered content, LLM line-range
// edits) into the `--actions` JSON commit-files expects, WITHOUT the LLM ever
// reproducing source bytes. tools/apply-line-edits.py reads the original content
// on stdin and the edits JSON from $LINE_EDITS ([{start_line,end_line,new_text}],
// 1-based inclusive; empty new_text deletes), validates 1<=start<=end<=nlines and
// NON-OVERLAPPING, applies descending-by-start so earlier replacements don't shift
// later ranges, and prints the new full content; we then json.dumps a single
// [{action:"update", file_path, content}] array. Large values (fetched file +
// edits) ride env vars / a pipe (`printf`, a shell builtin), never argv. If
// apply-line-edits.py exits non-zero (out-of-bounds / overlapping — the
// validation guard) the whole `exec sh` exits non-zero and the caller's `try`
// collapses to "" => treated as a failed code-gen, no commit. `path` is
// shell_escape'd; `orig` and `edits` are passed as env vars so the body itself
// carries no untrusted concatenation.
//
// #1597 (substrate purity P1): mirrors apply_edits_to_actions's rewrite —
// the `python3 -c` wrapper only did three mechanical things
// apply-line-edits.py already does itself (build the tools/ path, run it
// with content on stdin + $LINE_EDITS, json.dumps the envelope) — verified
// apply-line-edits.py:71-86 reads stdin + the env var directly. Now a plain
// `sh -c 'printf ... | python3 ...'` pipeline; the JSON envelope is built
// with `json_escape_string`. `tools/apply-line-edits.py` itself is
// UNTOUCHED (stays class C).
fn apply_line_edits_to_actions(path: string, orig: string, edits: string) -> string {
    // colony-lint: safe-exec-concat
    let cmd = "ORIG=" + shell_escape(orig) + " LINE_EDITS=" + shell_escape(edits) +
        " sh -c 'printf %s \"$ORIG\" | python3 \"$COLONY_DIR/../../tools/apply-line-edits.py\"'";
    let content = try { exec sh cmd; } catch e { ""; };
    if len(content) == 0 { return ""; };
    return "[{\"action\": \"update\", \"file_path\": \"" + json_escape_string(path) +
        "\", \"content\": \"" + json_escape_string(content) + "\"}]";
}

fn merged_mr_cmd(owner: string, repo: string) -> string {
    let ts = recall_latest(scoped_memo(owner, repo, "code_writer:last_check"));
    // colony-lint: safe-exec-concat
    if len(ts) > 0 {
        return "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --since " + shell_escape(ts) + " --view impl" + repo_arg(owner, repo);
    };
    // #1185: first run has no `last_check`, so without a bound the no-since
    // query learns from the WHOLE merged-MR history — one prompt() per MR per
    // tick, starving the drafting step on a mature repo. Bound the first run to
    // the single most recent merged MR via --per-page 1 (both forge backends
    // sort by updated_at desc and accept --per-page). The should_learn_from_mr
    // memo gate still caps learning at at-most-once per distinct MR iid; this
    // just stops the very first tick from fanning out across the full backlog.
    // colony-lint: safe-exec-concat
    return "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --per-page 1 --view impl" + repo_arg(owner, repo);
}

// #291: the forge wrappers' assigned-issues* subcommands gate on BOTH the
// trigger label AND the assignee by default. On most repos labeled issues
// are unassigned until a contributor picks them up, so the action path
// never fires. start-colony.sh seeds code_writer:require_assignee from
// [implementation].require_assignee (new default false); here we turn that
// into the --include-unassigned flag when the operator has opted in to the
// label-alone trigger.
fn include_unassigned_flag() -> string {
    let raw = recall_latest("code_writer:require_assignee");
    if raw == "false" {
        return " --include-unassigned";
    };
    return "";
}

fn get_confidence() -> float {
    let raw = recall_latest("code_writer:confidence");
    if len(raw) > 0 {
        return parse_float(raw);
    };
    return 0.0;
}

// #200: skip the LLM draft when the top assigned issue hasn't changed
// since our last run. `assigned-issues` has no --since filter server-side,
// so without this gate the draft prompt re-fires every tick as long as
// any issue remains assigned, re-paying the LLM cost for identical
// input. Gate on (iid, updated_at) so that issue edits (title,
// description, labels — anything that bumps updated_at) trigger a
// fresh draft.
fn should_draft_code(owner: string, repo: string, iid_str: string, upd: string) -> bool {
    // Malformed GitLab payload (missing iid) would otherwise collapse
    // all drafts into the shared "void" memo slot. Skip entirely — we
    // have nothing to gate on, and the next tick will re-poll.
    if iid_str == "void" {
        return false;
    };
    if len(iid_str) == 0 {
        return false;
    };
    // #1277: a projection that drops/nulls updated_at renders it as "void".
    // If we let a stored ("void") marker match a freshly-seen "void" the gate
    // short-circuits forever and the issue is starved (observed live on #1266,
    // which never produced a PR). The projection fix (restore updated_at to the
    // `assigned` view) is the primary cure; this guard is the belt-and-braces:
    // treat a void updated_at as ALWAYS stale so a future projection regression
    // degrades to "redraft every tick" instead of "never redraft again".
    // Mirrors the iid_str == "void" guard above.
    if upd == "void" {
        return true;
    };
    let last_iid = recall_latest(scoped_memo(owner, repo, "code_writer:last_drafted_iid"));
    if len(last_iid) == 0 {
        return true;
    };
    if iid_str != last_iid {
        return true;
    };
    let last_upd = recall_latest(scoped_memo(owner, repo, "code_writer:last_drafted_updated_at"));
    if upd != last_upd {
        return true;
    };
    return false;
}

// #1370 (B3): tier-independent input fingerprint. Unlike the #200/#1185
// completion markers (last_drafted_*), which are written ONLY after a
// per-tier terminal action completes, this fingerprint is written at the END
// of EVERY tick regardless of tier (and regardless of job poll-state). It
// records the (iid, updated_at) of the top assigned issue we last *saw*, so a
// tier-independent early-return can skip re-prompting an unchanged,
// already-handled issue every tick. It NEVER starves: an EXTERNAL edit,
// re-assignment, or any change that bumps updated_at flips this to false and
// re-triggers a fresh draft. The early-return that consumes it is additionally
// guarded by has_mr_for_branch, so an MR-less branch (a launched job that died
// without opening an MR — the #1363 rescue) is never suppressed.
fn input_unchanged(owner: string, repo: string, iid_str: string, upd: string) -> bool {
    if iid_str == "void" {
        return false;
    };
    if len(iid_str) == 0 {
        return false;
    };
    let seen_iid = recall_latest(scoped_memo(owner, repo, "code_writer:last_seen_iid"));
    if len(seen_iid) == 0 {
        return false;
    };
    if iid_str != seen_iid {
        return false;
    };
    let seen_upd = recall_latest(scoped_memo(owner, repo, "code_writer:last_seen_updated_at"));
    return upd == seen_upd;
}

// #1350: scan a raw merge-requests list JSON for an MR whose `source_branch`
// equals BR. Returns "1" on a match, "0" otherwise. The raw JSON rides $J
// (env var, off-argv) so ARG_MAX never bites. Total: malformed JSON / missing
// field / non-list all collapse to "0".
//
// #1597 (substrate purity P1): native rewrite via
// `json_array_object_field_values`, was an inline `python3 -c`. Malformed
// JSON / non-array top-level both resolve to an empty list from the builtin
// (confirmed: parse failure and non-Array both hit the builtin's own
// `Vec::new()` fallback) — same as python's `except Exception` / `not
// isinstance(d,list)` guards. Non-dict array entries are silently skipped by
// the builtin, same as python's `isinstance(it,dict)` guard.
//
// Sharp edge caught during review (a real fix, not a transliteration
// artifact): when an object is present but LACKS `source_branch`, the
// builtin emits `""` for that entry so callers can distinguish
// field-absent from object-absent; python's `it.get("source_branch")` is
// `None`, and `None == br` is always `False` for a real branch string — but
// if `branch == ""` the native version would WRONGLY match (`"" == ""` ->
// true) where python never would. The `len(branch) == 0` guard below closes
// that latent false-match gap. Every real caller (has_mr_for_branch, the
// epic-decompose branch-check sites) always passes a computed
// `fix/issue-<iid>` string, never `""`, so this is belt-and-braces here,
// not a live bug on the current call graph.
fn raw_list_has_branch(raw: string, branch: string) -> bool {
    if len(branch) == 0 { return false; };
    let branches = json_array_object_field_values(raw, "source_branch");
    return len(filter(branches, |b: string| -> bool { return b == branch; })) > 0;
}

// #1259: split a (possibly CSV) planning:labels:epic vocab and OR the exact-
// quoted match across its tokens, restoring CSV parity with task_decomposer.ag
// (which splices the same vocab whole into an LLM prompt that CAN split it —
// the two consumers diverged for multi-token configs like "epic, big-feature").
// A single-token vocab ("epic", the shipped default) matches exactly as before.
// Each token is JSON-quoted (chr(34)+t+chr(34) => "<token>") before the substring
// test, preserving the anti-false-match property: an "epic-foo" label lacks the
// closing quote so it still can't match. ISSUE_DETAIL + VOCAB ride env vars
// (off-argv, so ARG_MAX never bites). Total: a malformed/empty vocab or no token
// match collapses to "0" => false (a missed auto-decompose is the safe failure).
//
// #1597 (substrate purity P1): native rewrite via regex_split + filter, was
// an inline `python3 -c`. `index_of(issue_detail, "\"" + tt + "\"") >= 0` is
// exactly python's `chr(34)+t+chr(34) in d` literal-substring test (-1 on
// no match == total-on-no-match, same contract). `regex_split(",", ...)`
// reproduces python's `.split(",")` token boundaries (including empty
// tokens on leading/trailing/consecutive commas), which the `len(tt)==0`
// filter then drops, same as python's `if t and ...`. Malformed/empty vocab
// -> empty/all-empty tokens -> no hits -> false, matching the documented
// fail-safe.
fn is_epic_match(issue_detail: string, epic_vocab: string) -> bool {
    let hits = filter(regex_split(",", epic_vocab), |t: string| -> bool {
        let tt = trim(t);
        if len(tt) == 0 { return false; };
        return index_of(issue_detail, "\"" + tt + "\"") >= 0;
    });
    return len(hits) > 0;
}

// #1350: does an open OR merged MR already exist for this issue's deterministic
// fix/issue-<iid> branch? The #200 staleness markers (last_drafted_iid /
// _updated_at) record "we drafted once", NOT "an MR landed", so a detached edit
// job that dies without opening an MR (NO_EDITS / error / killed session) leaves
// the issue stranded: should_draft_code short-circuits until the issue's
// updated_at changes, yet no MR exists. Gating on actual completion fixes that —
// the draft path re-fires whenever this returns false regardless of the markers.
// Queries the RAW (no --view) opened then merged lists — the raw GitLab shape
// carries source_branch, which the `impl` view drops (same reason recover_red_prs
// reads raw). A void/empty iid has no branch to key on, so we report true
// (suppress the forced re-draft, mirroring should_draft_code's void guard).
// A poll that errors collapses to "" => no branch match, so a transient forge
// outage biases toward a (harmless, pid-guarded) re-draft attempt rather than
// silently stranding the issue.
fn has_mr_for_branch(owner: string, repo: string, iid_str: string) -> bool {
    if iid_str == "void" { return true; };
    if len(iid_str) == 0 { return true; };
    let branch = "fix/issue-" + iid_str;
    // colony-lint: safe-exec-concat
    let opened_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state opened" + repo_arg(owner, repo);
    let opened_raw = try { exec sh opened_cmd; } catch e { ""; };
    if raw_list_has_branch(opened_raw, branch) { return true; };
    // colony-lint: safe-exec-concat
    let merged_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged" + repo_arg(owner, repo);
    let merged_raw = try { exec sh merged_cmd; } catch e { ""; };
    return raw_list_has_branch(merged_raw, branch);
}

// #1560: cheap, clone-free probe of a branch's remote state, via
// code-edit-in-checkout.sh's read-only --probe-remote-head mode (a single
// `git ls-remote`, no workspace, no LLM). Returns the RAW two-token line
// `PROBE_STATUS=ok|unreachable REMOTE_HEAD=<sha-or-empty>` for the caller to
// parse with pr_check_token; any exec failure -> "" (which parses as
// PROBE_STATUS="" -> treated as unreachable = fail-safe keep-hold).
fn ownership_probe(owner: string, repo: string, branch: string) -> string {
    // colony-lint: safe-exec-concat
    let probe_cmd = "$COLONY_DIR/../../tools/code-edit-in-checkout.sh --owner " + shell_escape(owner) + " --repo " + shell_escape(repo) + " --issue x --branch " + shell_escape(branch) + " --title x --task x --probe-remote-head";
    return try { exec sh probe_cmd; } catch e { ""; };
}

// #1560: is issue `iid_str`'s branch currently under an ownership hold (the
// operator carries commits on it, no MR yet)? Reads the sha recorded at
// refusal time and re-probes the remote every call. Three outcomes, keyed on
// the probe's PROBE_STATUS (which reflects ls-remote's own exit code):
//   * unreachable (or exec failed) -> KEEP the hold (fail-safe transient; the
//     ONLY "keep on ambiguity" path, bounded by the unconditional mr_exists
//     escape the caller checks first + a later reachable probe releasing it);
//   * reachable + branch GONE (empty head) -> RELEASE — the operator deleted
//     the WIP branch we were protecting; nothing left to clobber, and a plain
//     `len(probe)==0` check used to treat this identically to "unreachable" and
//     wedge the hold forever (no MR can open for a deleted branch);
//   * reachable + head == recorded -> KEEP; head != recorded -> RELEASE.
fn ownership_held(owner: string, repo: string, iid_str: string) -> bool {
    let recorded = recall_latest(scoped_memo(owner, repo, "code_edit_loop:ownership_hold:" + iid_str));
    if len(recorded) == 0 { return false; };
    let branch = "fix/issue-" + iid_str;
    let raw = ownership_probe(owner, repo, branch);
    let status = pr_check_token(raw, "PROBE_STATUS");
    if status != "ok" {
        // Remote unreachable or probe exec failed — fail SAFE, keep the hold.
        return true;
    };
    let probe_head = pr_check_token(raw, "REMOTE_HEAD");
    if len(probe_head) == 0 {
        // Reachable AND the branch is gone (deleted) — release so the fed can
        // re-attempt (guarded_push proceeds on an absent remote branch).
        memo_write(scoped_memo(owner, repo, "code_edit_loop:ownership_hold:" + iid_str), "");
        print("[code_writer] issue", iid_str, "ownership hold released — branch deleted");
        return false;
    };
    if probe_head == recorded {
        // Situation unchanged since the refusal — still held.
        return true;
    };
    // Reachable and the head moved to a different sha — release the hold.
    memo_write(scoped_memo(owner, repo, "code_edit_loop:ownership_hold:" + iid_str), "");
    print("[code_writer] issue", iid_str, "ownership hold released — remote head moved");
    return false;
}

// #239: learn from each merged MR at most once per daemon lifetime.
// Without this gate, the `merge-requests --since <last_check>` query
// keeps returning the same MR at index [0] as long as its `updated_at`
// keeps getting bumped (new comments, pipeline events, label changes),
// so the learning-path prompt re-fires every tick at cb_budget 2000 —
// hundreds of duplicate `Learned from MR <N>` log entries and an
// OOM-class load on long-lived MRs. Single-key memo, no TTL: we want
// at-most-once per distinct MR iid.
fn should_learn_from_mr(owner: string, repo: string, mr_iid: int) -> bool {
    if mr_iid <= 0 {
        return false;
    };
    let iid_str = to_string(mr_iid);
    let last_iid = recall_latest(scoped_memo(owner, repo, "code_writer:last_learned_mr_iid"));
    if len(last_iid) == 0 {
        return true;
    };
    if iid_str != last_iid {
        return true;
    };
    return false;
}

// #1500: autonomous-tier plan-visibility gate. The `review-gated` branch has
// always posted the drafted implementation plan as an issue note before
// touching a branch; the `autonomous` branch never did — it drafted a plan
// internally and jumped straight to launching the detached edit job, so the
// operator's only pre-code intervention point (cf. #1482) never fired for
// self-initiated / directly-labeled issues. One plan per issue for the life
// of this memo key (see #1500 plan "Out of scope" — no clear path on
// re-scope; an operator/future change can clear the memo explicitly).
fn plan_already_posted(owner: string, repo: string, iid_str: string) -> bool {
    let posted = recall_latest(scoped_memo(owner, repo, "code_writer:plan_posted:" + iid_str));
    return len(posted) > 0;
}

// #1332: red-PR recovery helpers. The federation opens PRs and (#1317)
// auto-merges green ones, but had NO reaction to a RED CI: when code_writer's
// edit job exhausts its local verify budget it commits anyway ("CI is the
// backstop"), and the then-red PR sits forever (the merge gate refuses it; the
// draft path won't re-touch the issue due to its last_drafted_iid staleness
// gate). These helpers add the missing fix-if-red edge. The CI gate IS the
// local verify gate (colony-lint), so recovery re-drives the edit job on the
// EXISTING branch with the verify-and-fix loop (which reproduces the failure
// locally and iterates) — it never needs to fetch CI logs.

// open_pr_field: extract [idx].<field> (a scalar string) from the open-PR
// list JSON — native json_get since #1358 (was an inline python3 -c), the
// idiom the code-review agents already use for `[0].iid`. to_string() of a
// Void json_get (missing index / field / null / malformed JSON) renders as
// "void", collapsed to "" here so callers keep the empty-means-missing
// contract (recover_scan / resolve_review_scan terminate on len()==0).
fn open_pr_field(raw: string, idx: int, field: string) -> string {
    let v = to_string(json_get(raw, "[" + to_string(idx) + "]." + field));
    if v == "void" { return ""; };
    return v;
}

// pr_check_token: pull the value of KEY out of a `STATUS=<x> REF=<y>` line (the
// forge mr-pipeline-status verb output) — native index_of/substring scan since
// #1358 (was an inline python3 -c). The KEY= marker must sit at a token start
// (position 0 or right after a space) so a key that is a suffix of another
// token (XRESULT= vs RESULT=) can't false-match — the startswith property of
// the old per-token loop. The value runs to the next space (or newline, for a
// garbled multi-line blob). Total: "".
fn pr_check_token(out: string, key: string) -> string {
    let marker = key + "=";
    // len(out) is the not-found sentinel (avoids a negative literal).
    let at = if index_of(out, marker) == 0 {
        0;
    } else {
        let mid = index_of(out, " " + marker);
        if mid < 0 { len(out); } else { mid + 1; };
    };
    if at >= len(out) { return ""; };
    let rest = substring(out, at + len(marker), len(out));
    let sp = index_of(rest, " ");
    let tok = if sp < 0 { rest; } else { substring(rest, 0, sp); };
    let nl = index_of(tok, "\n");
    if nl < 0 { return tok; };
    return substring(tok, 0, nl);
}

// #1356: the poll-time FSM code-edit-job.sh used to own. The launcher now
// prints ONE raw line and decides NOTHING; job_decide interprets it into the
// vocabulary the autonomous draft-poll branch (and the recover paths) already
// switch on. It reuses pr_check_token's KEY=<v> reader (a poll line is
// `STATUS=<s> PID_ALIVE=<0|1> RESULT=<url>`) and job_word for the two bare
// launch-path sentinels. Mapping (mirrors the old launcher case block, per its
// header):
//   LAUNCHED                      -> "LAUNCHED"  (fresh detached launch)
//   RUNNING                       -> "RUNNING"   (cap-deferred; no job dir yet)
//   STATUS=running PID_ALIVE=1 .. -> "RUNNING"   (orchestrator still alive)
//   STATUS=running PID_ALIVE=0 .. -> "ERROR"     (job-died: pid gone, no terminal status)
//   STATUS=done   RESULT=<url>    -> "DONE"      (PR URL read via job_rest)
//   STATUS=done   RESULT=<empty>  -> "ERROR"     (done-without-url)
//   STATUS=no_edits ..            -> "NO_EDITS"
//   STATUS=error  ..              -> "ERROR"     (job-failed)
//   STATUS=none / unknown         -> "ERROR"     (stale/half-written dir)
// Total: a missing/garbled line collapses through job_word "" -> the ERROR
// (retry) branch, the safe failure (clears markers + job dir, re-drafts).
fn job_decide(out: string) -> string {
    let w = job_word(out);
    if w == "LAUNCHED" { return "LAUNCHED"; };
    if w == "RUNNING" { return "RUNNING"; };
    let status = pr_check_token(out, "STATUS");
    if status == "running" {
        if pr_check_token(out, "PID_ALIVE") == "1" { return "RUNNING"; };
        return "ERROR";
    };
    if status == "done" {
        if len(pr_check_token(out, "RESULT")) > 0 { return "DONE"; };
        return "ERROR";
    };
    if status == "no_edits" { return "NO_EDITS"; };
    return "ERROR";
}

// #1356: the PR URL from a DONE poll line — the RESULT= token. Empty for any
// non-DONE line. Reuses pr_check_token's KEY=<v> reader.
fn job_rest(out: string) -> string {
    return pr_check_token(out, "RESULT");
}

// #1356: clear the per-issue job dir once the poll FSM reaches a terminal state
// (DONE / NO_EDITS / ERROR). This cleanup used to live in the launcher's poll
// path; it moved here with the decision logic so code-edit-job.sh stays a dumb
// reporter that never deletes the dir. Path mirrors the launcher exactly:
// <FED_DIR>/.agentis/jobs/<colony>/issue-<iid>, with FED_DIR=$COLONY_DIR/.. and
// colony=$(basename "$COLONY_DIR"). The iid rides $IID
// (off-argv, shell_escape'd); a void/empty iid is a no-op (nothing safe to key
// on). rm -rf is total on a missing dir, so the catch is effectively dead.
fn clear_job_dir(iid_str: string) -> void {
    if len(iid_str) == 0 { return; };
    if iid_str == "void" { return; };
    let cmd = "IID=" + shell_escape(iid_str) +
        "; rm -rf \"$COLONY_DIR/../.agentis/jobs/$(basename \"$COLONY_DIR\")/issue-$IID\"";
    try { exec sh cmd; } catch e {
        print("[code_writer] job-dir cleanup failed for issue", iid_str, ":", e);
    };
}

// ---------------------------------------------------------------------------
// #1354 step 2b — the caller-driven edit loop. When AG_DRIVEN_EDIT_LOOP=1,
// code_writer OWNS the attempt/continuation/verify/finalize state machine that
// code-edit-in-checkout.sh's internal multi-attempt loop owns by default,
// driving the --one-attempt / --reuse / --finalize primitives (#1354 step 2a)
// through the detached launcher across ticks. Per-issue state lives in two
// repo-scoped memos:
//     code_edit_loop:phase:<iid>     "" | "attempt" | "finalize"
//     code_edit_loop:attempts:<iid>  count of --one-attempt drives done so far
// The job dir is the SAME per-issue dir the default path uses (the launcher
// keys on iid), reused sequentially across attempts + the finalize drive. State
// transitions persist via the phase memo BEFORE the next launch, so a launch
// deferred by the #1367 concurrency cap (bare RUNNING, no dir) is retried next
// tick from the right phase instead of restarting the loop.
//
// Returns a verdict the draft branch maps exactly like job_decide's, with the
// PR URL folded into DONE so the terminal handling is shared with the default
// path:
//     "RUNNING"     in flight / cap-deferred / mid-transition — re-poll, no mark
//                   (reuses the existing RUNNING verdict so the draft branch's
//                   no-op-and-re-poll handling is shared)
//     "DONE:<url>"  finalize opened the PR
//     "NO_EDITS"    the loop produced nothing (retry, not an error)
//     "ERROR"       a primitive drive failed
// ---------------------------------------------------------------------------
fn ag_loop_max_attempts() -> int {
    let e = getenv("CODE_EDIT_MAX_ATTEMPTS");
    if len(e) == 0 { return 3; };
    let n = parse_int(e);
    if n < 1 { return 3; };
    return n;
}

fn ag_edit_reset(owner: string, repo: string, iid: string) -> void {
    memo_write(scoped_memo(owner, repo, "code_edit_loop:phase:" + iid), "");
    memo_write(scoped_memo(owner, repo, "code_edit_loop:attempts:" + iid), "");
    // #1424: also delete the caller-side continuation file ag_edit_step() writes
    // before a --reuse re-drive; the job-dir copy is reaped by clear_job_dir(),
    // but this original would otherwise leak one small file per re-driven issue.
    // Same off-argv IID + rm -f pattern clear_job_dir() uses; rm -f is total on a
    // missing file, so the catch is effectively dead.
    // colony-lint: safe-exec-concat
    let cmd = "IID=" + shell_escape(iid) +
        "; rm -f \"$COLONY_DIR/../.agentis/code-edit-cont/issue-$IID.txt\"";
    try { exec sh cmd; } catch e {
        print("[code_writer] continuation-file cleanup failed for issue", iid, ":", e);
    };
}

// #1422 M2: shared primitive-launch, factored out of ag_edit_step so both the
// ordinary AG loop (ag_edit_step) and the AG-driven decompose loop
// (ag_decompose_step) build and fire the --one-attempt / --reuse / --finalize
// drive through ONE code path — shrinking the regression surface of the
// migration. Flags:
//   is_finalize      => " --description <d> --finalize" (the no-edit terminal drive)
//   want_continuation => " --one-attempt --reuse --continuation <file>"
//   want_reuse only   => " --one-attempt --reuse"  (fresh scoped prompt on branch)
//   else             => " --one-attempt"
//
// #1422 review finding 1: "reuse the branch" and "continuation framing" are two
// DIFFERENT things and MUST be decoupled. --reuse accumulates edits on the one
// branch (needed for decompose subtask >= 2, force_reuse). The whole-issue
// continuation preamble ("Continue implementing … finish anything incomplete …
// so the implementation is complete and correct") is a WITHIN-attempt RETRY
// device (attempts>0) — feeding it to a FRESH subtask tells a capable editor to
// attempt the whole remaining scope in one drive, collapsing decomposition back
// to monolithic (the exact failure this migration exists to prevent). So:
//   want_reuse        = force_reuse OR attempts>0   (accumulate on the branch)
//   want_continuation = attempts>0                  (retry framing ONLY)
// (`.ag` has no `||`, so nest.) For ag_edit_step (force_reuse always false) the
// two are equal, so its behaviour is unchanged; a decompose subtask >= 2 first
// attempt gets --reuse WITHOUT --continuation, so code-edit-in-checkout.sh's
// --one-attempt path uses its default tightly-scoped per-subtask template with
// the subtask text as the task. Returns the raw launcher poll for ag_attempt_poll.
fn ag_attempt_launch(owner: string, repo: string, iid: string, branch: string, title: string, task: string, description: string, is_finalize: bool, force_reuse: bool) -> string {
    let attempts_s = recall_latest(scoped_memo(owner, repo, "code_edit_loop:attempts:" + iid));
    let attempts = if len(attempts_s) > 0 { parse_int(attempts_s); } else { 0; };
    let want_reuse = if is_finalize { false; } else { if force_reuse { true; } else { attempts > 0; }; };
    let want_continuation = if is_finalize { false; } else { attempts > 0; };
    let contpath = "$COLONY_DIR/../.agentis/code-edit-cont/issue-" + iid + ".txt";
    if want_continuation {
        let cont = "Continue implementing this issue in the CURRENT working checkout. Some changes may already be present from a previous attempt — build on them, finish anything incomplete, and fix anything that does not yet work so the implementation is complete and correct. Do NOT revert existing progress.\n\n" + task;
        // colony-lint: safe-exec-concat
        let writecmd = "mkdir -p \"$COLONY_DIR/../.agentis/code-edit-cont\" && printf '%s' " + shell_escape(cont) + " > " + contpath;
        try { exec sh writecmd; } catch e { print("[code_writer] ag-loop continuation write failed for issue", iid, ":", e); };
    };
    let flags = if is_finalize {
        " --description " + shell_escape(description) + " --finalize";
    } else {
        if want_continuation {
            " --one-attempt --reuse --continuation " + contpath;
        } else {
            if want_reuse {
                " --one-attempt --reuse";
            } else {
                " --one-attempt";
            };
        };
    };
    // colony-lint: safe-exec-concat
    let launch_cmd = "$COLONY_DIR/../../tools/code-edit-job.sh --owner " + shell_escape(owner) + " --repo " + shell_escape(repo) + " --issue " + shell_escape(iid) + " --branch " + shell_escape(branch) + " --title " + shell_escape(title) + " --task " + shell_escape(task) + flags;
    let job_out = try { exec sh launch_cmd; } catch e {
        print("[code_writer] ag-loop launcher failed for issue", iid, ":", e);
        "";
    };
    return job_out;
}

// #1422 M2: normalize a raw launcher poll into a stateless micro-verdict, the
// second helper both AG loops share. It reads ONLY the poll — the attempt-cap /
// phase-memo threading stays in the CALLER (ag_edit_step counts drives against
// max_attempts; ag_decompose_step drives once per subtask), so this stays a pure
// classifier. Vocabulary (a superset of the plan's four — VERIFY_FAIL and DONE
// are kept distinct because ag_edit_step's verify-retry and finalize-URL paths
// need them; job-died folds into ERROR, which both callers treat identically):
//   "RUNNING"      fresh launch / cap-deferred / orchestrator still alive
//   "READY"        --one-attempt produced a diff that passes/skips verify
//   "VERIFY_FAIL"  --one-attempt produced a diff that FAILS verify
//   "NO_EDITS"     --one-attempt made no edits, OR --finalize found nothing staged
//   "DONE"         --finalize opened the PR (caller reads the RESULT= URL)
//   "ERROR"        job-died / done-without-url / stale / garbled
fn ag_attempt_poll(poll: string) -> string {
    let w = job_word(poll);
    if w == "LAUNCHED" { return "RUNNING"; };
    if w == "RUNNING" { return "RUNNING"; };
    let status = pr_check_token(poll, "STATUS");
    if status == "running" {
        // Alive => still driving; pid gone without a terminal status => it died.
        if pr_check_token(poll, "PID_ALIVE") == "1" { return "RUNNING"; };
        return "ERROR";
    };
    if status == "attempt_done" {
        let churn = parse_int(pr_check_token(poll, "CHURN"));
        if churn <= 0 { return "NO_EDITS"; };
        if pr_check_token(poll, "VERIFY") == "fail" { return "VERIFY_FAIL"; };
        return "READY";
    };
    if status == "done" {
        // A done status with an EMPTY RESULT= (finalize succeeded but no URL
        // parsed) is a failure, not a success — mirror job_decide's
        // done-without-url => ERROR so no issue is marked drafted on a URL-less
        // finalize.
        if len(pr_check_token(poll, "RESULT")) > 0 { return "DONE"; };
        return "ERROR";
    };
    if status == "no_edits" { return "NO_EDITS"; };
    // #1560: a genuine foreign-commit guarded_push refusal (exit 7) — distinct
    // from the generic ERROR verdict so ag_edit_step can set an ownership hold
    // instead of retrying the expensive draft cycle every tick.
    if status == "ownership_refused" { return "OWNERSHIP_REFUSED"; };
    return "ERROR";
}

fn ag_edit_step(owner: string, repo: string, iid: string, branch: string, title: string, task: string, description: string) -> string {
    let phase = recall_latest(scoped_memo(owner, repo, "code_edit_loop:phase:" + iid));
    let attempts_s = recall_latest(scoped_memo(owner, repo, "code_edit_loop:attempts:" + iid));
    let attempts = if len(attempts_s) > 0 { parse_int(attempts_s); } else { 0; };
    let max_attempts = ag_loop_max_attempts();

    // A FRESH launch (the launcher ignores flags and just polls when a job dir
    // already exists for this iid). ag_edit_step never force-reuses — its
    // continuation is driven by the attempts counter, not a subtask boundary.
    let is_finalize = phase == "finalize";
    let poll = ag_attempt_launch(owner, repo, iid, branch, title, task, description, is_finalize, false);
    let mv = ag_attempt_poll(poll);

    // in flight / cap-deferred => re-poll, leave state untouched.
    if mv == "RUNNING" { return "RUNNING"; };
    // #1560: guarded_push genuinely refused a foreign (operator-owned) commit
    // on this branch. Record a hold keyed to the remote head observed right
    // now so the needs-draft gate can skip re-drafting on subsequent ticks —
    // but only when the probe actually returns a sha; an empty probe here has
    // no baseline to compare against later, so setting a hold would be an
    // unreleasable one (fail SAFE: no hold, fall through as a plain error).
    if mv == "OWNERSHIP_REFUSED" {
        let probe_head = pr_check_token(ownership_probe(owner, repo, branch), "REMOTE_HEAD");
        if len(probe_head) > 0 {
            memo_write(scoped_memo(owner, repo, "code_edit_loop:ownership_hold:" + iid), probe_head);
            print("[code_writer] ag-loop issue", iid, "ownership hold set at remote head", probe_head);
        } else {
            print("[code_writer] ag-loop issue", iid, "ownership-refused but probe returned no head (unreachable/absent) — not setting a hold, treating as plain error");
        };
        ag_edit_reset(owner, repo, iid);
        clear_job_dir(iid);
        return "ERROR";
    };
    // job-died / stale / done-without-url => clear + reset so the next tick restarts.
    if mv == "ERROR" {
        ag_edit_reset(owner, repo, iid);
        clear_job_dir(iid);
        return "ERROR";
    };
    if mv == "DONE" {
        // The finalize drive opened the PR (ag_attempt_poll guarantees a
        // non-empty RESULT= for the DONE verdict).
        let url = pr_check_token(poll, "RESULT");
        ag_edit_reset(owner, repo, iid);
        clear_job_dir(iid);
        return "DONE:" + url;
    };
    if mv == "NO_EDITS" {
        // is_finalize disambiguates the two NO_EDITS sources: a --finalize that
        // found nothing staged is TERMINAL; a --one-attempt that made no edits is
        // a candidate for a bounded re-drive.
        if is_finalize {
            ag_edit_reset(owner, repo, iid);
            clear_job_dir(iid);
            return "NO_EDITS";
        };
        // Consume this attempt's dir; the next launch is a fresh primitive.
        clear_job_dir(iid);
        // No edits this attempt. attempts is the value the just-completed drive
        // launched with (drive #N has attempts == N-1), so the drive that just
        // finished was #(attempts+1). Cap TOTAL drives at max_attempts to match
        // the in-shell loop's CODE_EDIT_MAX_ATTEMPTS (total attempts, not retries).
        if attempts + 1 >= max_attempts {
            print("[code_writer] ag-loop issue", iid, "made no edits after", to_string(attempts + 1), "attempts — giving up");
            ag_edit_reset(owner, repo, iid);
            return "NO_EDITS";
        };
        memo_write(scoped_memo(owner, repo, "code_edit_loop:phase:" + iid), "attempt");
        memo_write(scoped_memo(owner, repo, "code_edit_loop:attempts:" + iid), to_string(attempts + 1));
        print("[code_writer] ag-loop issue", iid, "attempt", to_string(attempts), "produced no edits — re-driving");
        return "RUNNING";
    };
    if mv == "VERIFY_FAIL" {
        // churn > 0 but the verify gate failed. Consume the dir first.
        clear_job_dir(iid);
        // Re-drive only if a FURTHER drive stays within the total-drives cap (the
        // just-finished drive was #(attempts+1)); otherwise finalize the diff we
        // have. Matches CODE_EDIT_MAX_ATTEMPTS as a total count.
        if attempts + 1 < max_attempts {
            memo_write(scoped_memo(owner, repo, "code_edit_loop:phase:" + iid), "attempt");
            memo_write(scoped_memo(owner, repo, "code_edit_loop:attempts:" + iid), to_string(attempts + 1));
            print("[code_writer] ag-loop issue", iid, "verify=fail — re-driving to fix (attempt", to_string(attempts + 1), ")");
            return "RUNNING";
        };
        // Out of attempts but we HAVE a diff: commit it rather than discard the
        // work (the in-shell loop commits the last diff regardless of the final
        // verify outcome — a timeout/fail that still produced edits is a success,
        // not a discard).
        print("[code_writer] ag-loop issue", iid, "verify=fail but out of attempts — finalizing the diff anyway");
        memo_write(scoped_memo(owner, repo, "code_edit_loop:phase:" + iid), "finalize");
        return "RUNNING";
    };
    // mv == "READY": churn > 0 and verify pass/skipped/unverifiable => finalize.
    clear_job_dir(iid);
    memo_write(scoped_memo(owner, repo, "code_edit_loop:phase:" + iid), "finalize");
    return "RUNNING";
}

// ---------------------------------------------------------------------------
// #1422 M2 — the AG-driven decompose loop. When AG_DECOMPOSE_LOOP=1, an
// epic-class issue is decomposed and driven ENTIRELY from code_writer.ag,
// consuming the --decompose-only primitive (M1) instead of the in-shell
// --decompose orchestration. It is a cross-tick, memo-threaded FSM that mirrors
// ag_edit_step (at most ONE launch per tick; its "recursion" is the memo state
// machine, not a call stack) and drives the per-subtask --one-attempt / --reuse
// sequence onto ONE branch, closed by exactly ONE --finalize => ONE PR.
//
// DEFAULT OFF: epics keep flowing through the untouched in-shell --decompose
// path unless an operator sets AG_DECOMPOSE_LOOP=1 (M1+M2 land the capability;
// flipping the default, deleting the in-shell loop, and retiring the opt-out are
// the burn-in-gated M3 follow-up).
//
// State memos (all under the existing code_edit_loop: namespace, per iid):
//   code_edit_loop:decomp:<iid>          "" | "decomposing" | "editing" | "finalize"
//   code_edit_loop:subtask_count:<iid>   N (from the M1 poll's SUBTASKS= token)
//   code_edit_loop:subtask_idx:<iid>     current subtask, 1-based
//   code_edit_loop:phase:<iid>           per-subtask attempt sub-state (reused,
//   code_edit_loop:attempts:<iid>        reset to "" at each subtask boundary)
//
// Same verdict contract as ag_edit_step: "RUNNING" | "DONE:<url>" | "NO_EDITS" |
// "ERROR", so the draft-poll terminal handling is shared unchanged.
// ---------------------------------------------------------------------------

// The stable subtasks file — mirrors the code-edit-cont convention: keyed by
// iid, lives OUTSIDE the per-issue job dir so clear_job_dir cannot reap it, and
// passed UNescaped so $COLONY_DIR expands in the shell (like contpath).
fn ag_subtasks_path(iid: string) -> string {
    return "$COLONY_DIR/../.agentis/code-edit-subtasks/issue-" + iid + ".txt";
}

// Launch the M1 --decompose-only primitive (the launcher polls the existing job
// dir on later ticks). Returns the raw poll line.
fn ag_decompose_launch(owner: string, repo: string, iid: string, branch: string, title: string, task: string) -> string {
    // colony-lint: safe-exec-concat
    let launch_cmd = "$COLONY_DIR/../../tools/code-edit-job.sh --owner " + shell_escape(owner) + " --repo " + shell_escape(repo) + " --issue " + shell_escape(iid) + " --branch " + shell_escape(branch) + " --title " + shell_escape(title) + " --task " + shell_escape(task) + " --decompose-only --subtasks-out " + ag_subtasks_path(iid);
    let job_out = try { exec sh launch_cmd; } catch e {
        print("[code_writer] ag-decompose launcher failed for issue", iid, ":", e);
        "";
    };
    return job_out;
}

// Read subtask record `idx` (1-based) from the stable NUL-delimited subtasks
// file. #1422 review finding 2: split on NUL with the SAME portable mechanism
// the in-shell reference uses — bash `read -r -d ""` (NUL delimiter), NOT
// gawk-specific `RS="\0"` (BSD/busybox awk treat RS="\0" as empty-string RS =
// paragraph mode and return the wrong record, and the bundle ships to operator
// machines). The record can contain newlines (the monolithic fallback holds the
// whole multi-line task as one record), which `read -r -d ""` + `IFS=` + `printf
// "%s"` preserves byte-for-byte, identical to the orchestrator's own loop. We
// delegate to `bash -c` because `/bin/sh` may be dash/busybox (no `read -d`);
// the OUTER exec-sh string stays dash-safe (only env-assignments + a
// single-quoted bash script, no bashisms). n/f ride in as env (index is
// shell-escaped; path expands $COLONY_DIR, passed unescaped like contpath).
fn read_subtask(iid: string, idx: int) -> string {
    // colony-lint: safe-exec-concat
    let cmd = "n=" + shell_escape(to_string(idx)) + " f=" + ag_subtasks_path(iid) + " bash -c 'i=0; while IFS= read -r -d \"\" rec; do i=$((i+1)); if [ \"$i\" = \"$n\" ]; then printf \"%s\" \"$rec\"; break; fi; done < \"$f\"'";
    let out = try { exec sh cmd; } catch e {
        print("[code_writer] read_subtask failed for issue", iid, "idx", to_string(idx), ":", e);
        "";
    };
    return out;
}

// Clear every decompose memo + the per-subtask attempt sub-state + the caller
// continuation file + the stable subtasks file, so the next tick restarts clean.
fn ag_decompose_reset(owner: string, repo: string, iid: string) -> void {
    memo_write(scoped_memo(owner, repo, "code_edit_loop:decomp:" + iid), "");
    memo_write(scoped_memo(owner, repo, "code_edit_loop:subtask_count:" + iid), "");
    memo_write(scoped_memo(owner, repo, "code_edit_loop:subtask_idx:" + iid), "");
    memo_write(scoped_memo(owner, repo, "code_edit_loop:phase:" + iid), "");
    memo_write(scoped_memo(owner, repo, "code_edit_loop:attempts:" + iid), "");
    // Same off-argv IID + rm -f pattern clear_job_dir()/ag_edit_reset() use; rm -f
    // is total on a missing file, so the catch is effectively dead.
    // colony-lint: safe-exec-concat
    let cmd = "IID=" + shell_escape(iid) +
        "; rm -f \"$COLONY_DIR/../.agentis/code-edit-cont/issue-$IID.txt\" \"$COLONY_DIR/../.agentis/code-edit-subtasks/issue-$IID.txt\"";
    try { exec sh cmd; } catch e {
        print("[code_writer] ag-decompose cleanup failed for issue", iid, ":", e);
    };
}

fn ag_decompose_step(owner: string, repo: string, iid: string, branch: string, title: string, task: string, description: string) -> string {
    let decomp = recall_latest(scoped_memo(owner, repo, "code_edit_loop:decomp:" + iid));

    // State "" — kick off the decompose-only drive, advance to "decomposing".
    if len(decomp) == 0 {
        ag_decompose_launch(owner, repo, iid, branch, title, task);
        memo_write(scoped_memo(owner, repo, "code_edit_loop:decomp:" + iid), "decomposing");
        return "RUNNING";
    };

    // State "decomposing" — poll the decompose-only drive.
    if decomp == "decomposing" {
        let poll = ag_decompose_launch(owner, repo, iid, branch, title, task);
        let w = job_word(poll);
        // Fresh launch (cap-deferred earlier) / still alive => keep polling.
        if w == "LAUNCHED" { return "RUNNING"; };
        if w == "RUNNING" { return "RUNNING"; };
        let status = pr_check_token(poll, "STATUS");
        if status == "running" {
            if pr_check_token(poll, "PID_ALIVE") == "1" { return "RUNNING"; };
            // pid gone without a terminal status => the drive died.
            ag_decompose_reset(owner, repo, iid);
            clear_job_dir(iid);
            return "ERROR";
        };
        if status == "decomposed" {
            let n = parse_int(pr_check_token(poll, "SUBTASKS"));
            let count = if n < 1 { 1; } else { n; };
            memo_write(scoped_memo(owner, repo, "code_edit_loop:subtask_count:" + iid), to_string(count));
            memo_write(scoped_memo(owner, repo, "code_edit_loop:subtask_idx:" + iid), "1");
            memo_write(scoped_memo(owner, repo, "code_edit_loop:phase:" + iid), "");
            memo_write(scoped_memo(owner, repo, "code_edit_loop:attempts:" + iid), "");
            // Consume the decompose job dir so the first subtask launch is fresh.
            clear_job_dir(iid);
            memo_write(scoped_memo(owner, repo, "code_edit_loop:decomp:" + iid), "editing");
            print("[code_writer] ag-decompose issue", iid, "decomposed into", to_string(count), "subtask(s) — editing");
            return "RUNNING";
        };
        // error / none / stale — clear + reset so the next tick restarts.
        ag_decompose_reset(owner, repo, iid);
        clear_job_dir(iid);
        return "ERROR";
    };

    // State "editing" — one --one-attempt drive per subtask on ONE branch.
    if decomp == "editing" {
        let idx_s = recall_latest(scoped_memo(owner, repo, "code_edit_loop:subtask_idx:" + iid));
        let count_s = recall_latest(scoped_memo(owner, repo, "code_edit_loop:subtask_count:" + iid));
        let i = if len(idx_s) > 0 { parse_int(idx_s); } else { 1; };
        let n = if len(count_s) > 0 { parse_int(count_s); } else { 1; };
        // Subtask >= 2 MUST accumulate on subtask 1's fresh branch => force --reuse.
        let force_reuse = i > 1;
        let subtask_text = read_subtask(iid, i);
        let poll = ag_attempt_launch(owner, repo, iid, branch, title, subtask_text, description, false, force_reuse);
        let mv = ag_attempt_poll(poll);
        if mv == "RUNNING" { return "RUNNING"; };
        if mv == "ERROR" {
            ag_decompose_reset(owner, repo, iid);
            clear_job_dir(iid);
            return "ERROR";
        };
        // READY / VERIFY_FAIL / NO_EDITS all ADVANCE the subtask cursor: a
        // zero-churn or verify-failing subtask is skipped, not fatal (matches the
        // in-shell loop, which never aborts an epic on one empty subtask and
        // commits whatever accumulated). Consume this subtask's job dir first.
        clear_job_dir(iid);
        // Base case: subtask_idx grows ONLY while i < N; i == N is the SOLE
        // transition into finalize — the one-PR invariant.
        if i < n {
            memo_write(scoped_memo(owner, repo, "code_edit_loop:subtask_idx:" + iid), to_string(i + 1));
            memo_write(scoped_memo(owner, repo, "code_edit_loop:phase:" + iid), "");
            memo_write(scoped_memo(owner, repo, "code_edit_loop:attempts:" + iid), "");
            print("[code_writer] ag-decompose issue", iid, "subtask", to_string(i), "of", to_string(n), "done — next");
            return "RUNNING";
        };
        memo_write(scoped_memo(owner, repo, "code_edit_loop:decomp:" + iid), "finalize");
        print("[code_writer] ag-decompose issue", iid, "all", to_string(n), "subtask(s) done — finalizing");
        return "RUNNING";
    };

    // State "finalize" — the SINGLE --finalize drive commits the accumulated
    // diff and opens ONE PR.
    let poll = ag_attempt_launch(owner, repo, iid, branch, title, task, description, true, false);
    let mv = ag_attempt_poll(poll);
    if mv == "RUNNING" { return "RUNNING"; };
    if mv == "DONE" {
        let url = pr_check_token(poll, "RESULT");
        ag_decompose_reset(owner, repo, iid);
        clear_job_dir(iid);
        return "DONE:" + url;
    };
    if mv == "NO_EDITS" {
        // Nothing accumulated across the subtasks — terminal, not an error.
        ag_decompose_reset(owner, repo, iid);
        clear_job_dir(iid);
        return "NO_EDITS";
    };
    // ERROR (incl. done-without-url) — clear + reset so the next tick restarts.
    ag_decompose_reset(owner, repo, iid);
    clear_job_dir(iid);
    return "ERROR";
}

// ci_state: classify a raw CI status word (the mr-pipeline-status verb's STATUS
// token) into the red/green/pending vocabulary the recovery loops branch on.
// This is the classification that lived inside gitlab-api.sh/github-api.sh
// pr-checks before #1355 moved the reasoning out of the thin forge wrapper:
// failed/canceled => red, success => green, everything else (running, pending,
// created, …, or "" when the MR has no pipeline yet) => pending — CI not
// verified yet, so never race it. GitHub's backend pre-reduces its check-runs to
// the same success|failed|pending vocabulary, so this classifier is forge-agnostic.
fn ci_state(status: string) -> string {
    if status == "failed" { return "red"; };
    if status == "canceled" { return "red"; };
    if status == "cancelled" { return "red"; };
    if status == "success" { return "green"; };
    return "pending";
}

// recover_attempts: how many recovery re-drives we have already launched for
// this PR (read from the ci_fix:attempts:<iid> memo). Missing => 0.
fn recover_attempts(owner: string, repo: string, iid_str: string) -> int {
    let raw = recall_latest(scoped_memo(owner, repo, "ci_fix:attempts:" + iid_str));
    if len(raw) == 0 { return 0; };
    return parse_int(raw);
}

// recover_at: process the open PR at index `idx`. Returns 1 if it LAUNCHED a
// recovery re-drive (the caller then returns for this tick — one job per tick,
// do not also draft), 0 otherwise (skip + keep scanning). Own PRs only: the
// head branch must start `fix/issue-` (the federation's own). Acts only on
// a red state, never pending (don't race CI). Retry cap 2 per PR via the
// ci_fix:attempts:<iid> memo; after that, give up + log (needs human).
fn recover_at(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    if iid_str == "void" { return 0; };
    let src = open_pr_field(raw, idx, "source_branch");
    // Own PRs only: never touch a PR we did not open.
    if index_of(src, "fix/issue-") != 0 { return 0; };

    // colony-lint: safe-exec-concat
    let checks_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-pipeline-status " + shell_escape(iid_str) + repo_arg(owner, repo);
    let checks_out = try { exec sh checks_cmd; } catch e { ""; };
    // Classify the raw pipeline status here (was gitlab-api.sh/github-api.sh
    // pr-checks before #1355 thinned the forge wrapper to a raw STATUS read).
    let state = ci_state(pr_check_token(checks_out, "STATUS"));
    // Only act on a confirmed red CI; pending => don't race, green => merge gate.
    if state != "red" { return 0; };

    let attempts = recover_attempts(owner, repo, iid_str);
    if attempts >= 2 {
        print("[code_writer] CI-fix gave up on PR", iid_str, "after 2 attempts — needs human");
        return 0;
    };

    // Bump the attempt memo BEFORE launching so a crash mid-launch still counts
    // against the cap (fail-closed: never exceed 2 re-drives).
    let next_attempt = attempts + 1;
    memo_write(scoped_memo(owner, repo, "ci_fix:attempts:" + iid_str), to_string(next_attempt));

    // Re-drive the PR's ACTUAL head branch (source_branch), NOT a branch
    // reconstructed from the PR number: a PR for issue N has its own PR number
    // M != N, so "fix/issue-" + <PR iid> would target a non-existent branch.
    // `src` was already validated to start with "fix/issue-" (own-PRs guard).
    let branch_name = src;
    let recover_title = "fix: recover CI for #" + iid_str;
    let recover_task = "The CI gate (colony-lint) is failing on this PR. Reproduce the failure locally, fix it with a MINIMAL change, and do not touch unrelated code.";
    // colony-lint: safe-exec-concat
    let job_cmd = "$COLONY_DIR/../../tools/code-edit-job.sh --owner " + shell_escape(owner) + " --repo " + shell_escape(repo) + " --issue " + shell_escape(iid_str) + " --branch " + shell_escape(branch_name) + " --title " + shell_escape(recover_title) + " --task " + shell_escape(recover_task) + " --recover";
    let job_out = try { exec sh job_cmd; } catch e {
        print("[code_writer] CI-fix launcher failed for PR", iid_str, ":", e);
        "";
    };
    let job_state = job_word(job_out);
    if job_state == "DONE" {
        print("[code_writer] CI-fix pushed a fix to red PR", iid_str, "(attempt", next_attempt, "/2)");
    } else {
        print("[code_writer] re-driving red PR", iid_str, "(attempt", next_attempt, "/2)");
    };
    // One recovery job per tick: signal the caller to return without drafting.
    // The launcher's pid check gives idempotency so a re-poll won't double-launch.
    return 1;
}

// recover_scan: recurse over the open-PR list, launching at most ONE recovery
// re-drive per tick. Returns 1 once a job is launched (stop scanning), else 0.
fn recover_scan(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    let did = recover_at(owner, repo, raw, idx);
    if did == 1 { return 1; };
    return recover_scan(owner, repo, raw, idx + 1);
}

// recover_red_prs: list the federation's own open PRs and, at the autonomous
// tier only, re-drive the FIRST red one whose head is a fix/issue- branch we
// opened. Returns 1 if it launched a recovery job (the caller returns for this
// tick — one job per tick, do not also draft).
fn recover_red_prs(owner: string, repo: string) -> int {
    // Autonomous-only: re-pushing to PRs is a terminal write.
    if repo_tier("code_writer", owner, repo) != "autonomous" { return 0; };
    // Raw (no --view): the normalized GitLab-shape list carries both `iid` and
    // `source_branch`, the two fields recover_at needs. The implementation
    // colony's `impl` view drops source_branch, so we read the raw shape here.
    // colony-lint: safe-exec-concat
    let list_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state opened" + repo_arg(owner, repo);
    let raw = try { exec sh list_cmd; } catch e { ""; };
    if len(raw) < 5 { return 0; };
    return recover_scan(owner, repo, raw, 0);
}

// #1518: auto-rebase sweep for our OWN CONFLICTING PRs. A PR made CONFLICTING by
// an unrelated main merge gets NO fresh CI run at all (GitHub skips workflows on
// an unmergeable head), so recover_red_prs (which keys on a RED CI) can never
// help it — the PR silently rots. This sweep detects `MERGEABLE=conflicting`
// (the mr-pipeline-status token) and launches a pure-git `--rebase` job that
// rebases the branch onto the default branch, union-merges the one proven-safe
// conflict class (CHANGELOG [Unreleased] two-sided inserts), and fail-closes
// everything else to a human note. It runs BEFORE recover_red_prs in the tick
// (a CONFLICTING PR has no fresh CI, so rebase must run first to PRODUCE one).

// rebase_attempts: how many auto-rebase jobs we have already launched for this
// PR (from the rebase:attempts:<iid> memo). Missing => 0. Mirrors
// recover_attempts (the ci_fix:attempts cap).
fn rebase_attempts(owner: string, repo: string, iid_str: string) -> int {
    let raw = recall_latest(scoped_memo(owner, repo, "rebase:attempts:" + iid_str));
    if len(raw) == 0 { return 0; };
    return parse_int(raw);
}

// rebase_at: process the open PR at index `idx`. Returns 1 if it LAUNCHED an
// auto-rebase job (caller then returns — one job per tick), 0 otherwise. Own PRs
// only (head branch starts `fix/issue-`). Acts ONLY on MERGEABLE==conflicting:
//   * unknown -> GitHub is still computing mergeability; skip + re-poll next tick
//                (NEVER treat unknown as clean or conflicting).
//   * true/false/other -> not our concern here (a red PR is recover_red_prs').
// Retry cap 2 per PR via rebase:attempts:<iid> (bumped BEFORE launch,
// fail-closed). The `--rebase` job's push routes through guarded_push (#1516), so
// an operator-carrying branch degrades to a yield note, never a clobber.
fn rebase_at(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    if iid_str == "void" { return 0; };
    let src = open_pr_field(raw, idx, "source_branch");
    // Own PRs only: never touch a PR we did not open.
    if index_of(src, "fix/issue-") != 0 { return 0; };

    // colony-lint: safe-exec-concat
    let checks_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-pipeline-status " + shell_escape(iid_str) + repo_arg(owner, repo);
    let checks_out = try { exec sh checks_cmd; } catch e { ""; };
    let mergeable = pr_check_token(checks_out, "MERGEABLE");
    // Act ONLY on a confirmed git conflict. `unknown` (GitHub still computing),
    // `true`, `false`, and an empty read all fall through to skip + re-poll.
    if mergeable != "conflicting" { return 0; };

    let attempts = rebase_attempts(owner, repo, iid_str);
    if attempts >= 2 {
        print("[code_writer] auto-rebase gave up on PR", iid_str, "after 2 attempts — needs human");
        return 0;
    };

    // Bump the attempt memo BEFORE launching so a crash mid-launch still counts
    // against the cap (fail-closed: never exceed 2 re-drives).
    let next_attempt = attempts + 1;
    memo_write(scoped_memo(owner, repo, "rebase:attempts:" + iid_str), to_string(next_attempt));

    // Rebase the PR's ACTUAL head branch (source_branch), already validated to
    // start `fix/issue-`. `--task` is required by the orchestrator but the
    // `--rebase` op is pure-git and never runs an editing engine, so pass a
    // benign descriptor.
    let branch_name = src;
    let rebase_title = "chore: auto-rebase #" + iid_str;
    let rebase_task = "Auto-rebase this conflicting PR onto the default branch (pure git, no code edit).";
    // colony-lint: safe-exec-concat
    let job_cmd = "$COLONY_DIR/../../tools/code-edit-job.sh --owner " + shell_escape(owner) + " --repo " + shell_escape(repo) + " --issue " + shell_escape(iid_str) + " --branch " + shell_escape(branch_name) + " --title " + shell_escape(rebase_title) + " --task " + shell_escape(rebase_task) + " --rebase";
    let job_out = try { exec sh job_cmd; } catch e {
        print("[code_writer] auto-rebase launcher failed for PR", iid_str, ":", e);
        "";
    };
    let job_state = job_word(job_out);
    if job_state == "DONE" {
        print("[code_writer] auto-rebase pushed a rebase of conflicting PR", iid_str, "(attempt", next_attempt, "/2)");
    } else {
        print("[code_writer] auto-rebasing conflicting PR", iid_str, "(attempt", next_attempt, "/2)");
    };
    // One rebase job per tick: signal the caller to return without drafting.
    return 1;
}

// rebase_scan: recurse over the open-PR list, launching at most ONE auto-rebase
// per tick. Returns 1 once a job is launched (stop scanning), else 0.
fn rebase_scan(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    let did = rebase_at(owner, repo, raw, idx);
    if did == 1 { return 1; };
    return rebase_scan(owner, repo, raw, idx + 1);
}

// rebase_conflicting_prs: list the federation's own open PRs and, at the
// autonomous tier only, auto-rebase the FIRST CONFLICTING one whose head is a
// fix/issue- branch we opened. Returns 1 if it launched a rebase job (caller
// returns for this tick — one job per tick, do not also draft).
fn rebase_conflicting_prs(owner: string, repo: string) -> int {
    // Autonomous-only: force-pushing a rebased branch is a terminal write.
    if repo_tier("code_writer", owner, repo) != "autonomous" { return 0; };
    // Raw (no --view): needs both `iid` and `source_branch`, which the `impl`
    // view drops — same reason as recover_red_prs.
    // colony-lint: safe-exec-concat
    let list_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state opened" + repo_arg(owner, repo);
    let raw = try { exec sh list_cmd; } catch e { ""; };
    if len(raw) < 5 { return 0; };
    return rebase_scan(owner, repo, raw, 0);
}

// #1360: review-finding recovery helpers (the review-resolver pattern). The
// federation re-drives a RED PR (recover_red_prs), but a GREEN PR carrying
// actionable review findings — the code-review colony's request_changes summary
// (approval_decider's `**Review Summary** (automated)` note / the
// `[draft-review-decision] ... request_changes` draft) or a human review note —
// just sat until a human manually triggered a --recover. These helpers add the
// missing implement->review->fix edge, a near-exact structural mirror of the
// red-CI path but triggered by a durable review NOTE instead of a red CI state. The
// signal is the durable forge note (polled here, exactly as recover_at polls
// mr-pipeline-status), NOT the ephemeral colony bus: the reviewers emit on sub-second
// listen() windows on an independent schedule, so a cross-daemon emit is almost
// never caught. Idempotency is the note-id watermark (review_fix:last_note:<iid>)
// plus the hard cap (review_fix:attempts:<iid>, cap 2 — identical to recover_at).

// review_fix_attempts: how many review-fix re-drives we have already launched for
// this PR (read from the review_fix:attempts:<iid> memo). Missing => 0. Mirrors
// recover_attempts.
fn review_fix_attempts(owner: string, repo: string, iid_str: string) -> int {
    let raw = recall_latest(scoped_memo(owner, repo, "review_fix:attempts:" + iid_str));
    if len(raw) == 0 { return 0; };
    return parse_int(raw);
}

// bot_username: the federation's own forge username (memo `gitlab:me`, seeded by
// install.sh — the same memo style_reviewer reads). Lets actionable_note tell a
// human review note from the federation's own notes. Empty when unseeded, which
// actionable_note treats fail-safe (only the federation's own request_changes /
// draft markers stay actionable, never a bare author mismatch).
fn bot_username() -> string {
    return recall_latest("gitlab:me");
}

// actionable_note: reduce the mr-notes JSON to the most-recent (highest `id`)
// ACTIONABLE note, given the bot username `me`. A note is actionable when it is
// non-system AND either (a) authored by a human (author.username != me, me
// non-empty) or (b) the federation's own request_changes verdict — body starts
// `**Review Summary** (automated)` (the autonomous post) or is the review-gated
// draft (approval_decider.ag:932). Plain reviewer comments, approvals, and clean
// reviews are NOT actionable. Returns `<max_note_id>\t<concatenated actionable
// bodies>` (bodies joined ascending-`id` by `\n\n`) or "" when none / malformed.
//
// Native via `json_array_reduce` (agentis >= 1.22.3, the #1587 substrate-purity
// ratchet, #1613) — no embedded python. The keep grammar is `must "|" any`:
// `must` = `system!=true` (ALL); the `any` half is an OR-list evaluated as
// `any.is_empty() OR ANY(any)`.
//   * is_human -> `author.username!=me` (a missing/null author.username coerces
//     to "", so an author-LESS note is KEPT: DECIDED (#903) — unreachable on a
//     real forge (every note carries a non-null author) and non-harmful even if
//     reached (an actionable_note drives only a cap-2 re-fix, never a merge-gate
//     release like the verdict readers), so the `!=me` keep stands, documented).
//   * is_req -> `body^=**Review Summary** (automated)` (startswith, value-
//     identical to the old python).
//   * is_draft -> `body~suggested action \`request_changes\``. The old python
//     is_draft was a TWO-substring conjunction (`[draft-review-decision]` AND
//     `request_changes`) — inexpressible in the pure-OR `any` half (the grammar
//     has no conjunction-in-OR). This single `~` clause on the discriminating
//     phrase from the draft template (approval_decider.ag:932 emits
//     `suggested action \`<action>\`` iff the decision is request_changes)
//     captures the intent. Divergence is provably SAFE-DIRECTION and rare: the
//     only note where it differs is an `approve`/`escalate` draft whose LLM
//     reasoning text happens to contain `request_changes` — the old python KEPT
//     it (and wrongly re-drove a code-fix against an approval), this DROPS it.
//     Never looser, only tighter+safer.
// Empty-me fail-safe: OMIT the author clause (else `author.username!=""` keeps
// every authored note) — only the federation's own request_changes / draft
// markers stay actionable, never a bare author mismatch. me is a forge username
// (`[A-Za-z0-9_.-]`, never `;`/`|`/`\`), so it cannot forge an extra keep clause.
// json_array_reduce json_tsv_escapes each body cell (a real `\t`/`\n` in a body
// becomes the two-char `\t`/`\n`) and joins notes with real `\n\n`, so the record
// still holds exactly one real tab (the max_id separator) — the consumer's
// repo_field split is unaffected; the body TEXT is now escaped instead of the old
// tab->space collapse (the same accepted cosmetic class as PR A's block reason,
// read fine by the re-fix LLM).
fn actionable_note(raw: string, me: string) -> string {
    let draft = "body^=**Review Summary** (automated);body~suggested action `request_changes`";
    if len(me) == 0 {
        return json_array_reduce(raw, "", "system!=true|" + draft, "id", "body");
    };
    return json_array_reduce(raw, "", "system!=true|author.username!=" + me + ";" + draft, "id", "body");
}

// resolve_review_at: process the open PR at index `idx`. Returns 1 if it LAUNCHED
// a review-fix re-drive (caller returns for this tick — one job per tick, do not
// also draft), 0 otherwise. Own PRs only (head branch starts fix/issue-). Acts
// ONLY on STATE=green: red is owned by recover_red_prs (no race), pending => do
// not race CI. Idempotent: re-drives only when the newest actionable note id is
// strictly greater than the review_fix:last_note:<iid> watermark. Retry cap 2 via
// review_fix:attempts:<iid>; after that, give up + log (needs human). Mirrors
// recover_at but keyed on a review note instead of STATE=red.
fn resolve_review_at(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    if iid_str == "void" { return 0; };
    let src = open_pr_field(raw, idx, "source_branch");
    // Own PRs only: never touch a PR we did not open.
    if index_of(src, "fix/issue-") != 0 { return 0; };

    // colony-lint: safe-exec-concat
    let checks_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-pipeline-status " + shell_escape(iid_str) + repo_arg(owner, repo);
    let checks_out = try { exec sh checks_cmd; } catch e { ""; };
    // Classify the raw pipeline status here (see recover_at / #1355).
    let state = ci_state(pr_check_token(checks_out, "STATUS"));
    // Act ONLY on a green PR: red is owned by recover_red_prs (avoid the race),
    // pending => don't race CI. The precise inverse of recover_at's red-only guard.
    if state != "green" { return 0; };

    // colony-lint: safe-exec-concat
    let notes_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-notes " + shell_escape(iid_str) + repo_arg(owner, repo);
    let notes_raw = try { exec sh notes_cmd; } catch e { ""; };
    let rec = actionable_note(notes_raw, bot_username());
    if len(rec) == 0 { return 0; };

    let note_id_str = repo_field(rec, 0);
    if len(note_id_str) == 0 { return 0; };
    let note_id = parse_int(note_id_str);
    // Idempotency: re-drive only when a STRICTLY newer actionable note appears.
    // Once we re-drive against the newest finding we never re-drive again until a
    // re-review posts a strictly-newer actionable note (so a satisfied review,
    // which posts no new request_changes note, terminates the loop).
    let last_seen = recall_latest(scoped_memo(owner, repo, "review_fix:last_note:" + iid_str));
    if len(last_seen) > 0 {
        if note_id <= parse_int(last_seen) { return 0; };
    };

    let attempts = review_fix_attempts(owner, repo, iid_str);
    if attempts >= 2 {
        print("[code_writer] review-fix gave up on PR", iid_str, "after 2 attempts — needs human");
        return 0;
    };

    let next_attempt = attempts + 1;

    let bodies = repo_field(rec, 1);
    // Re-drive the PR's ACTUAL head branch (source_branch), validated above to
    // start with fix/issue-. --recover pushes to the existing branch (no new PR);
    // keying --issue on the PR iid shares the per-issue job dir with recover_at so
    // the launcher pid-guard serializes the two paths on one PR.
    let branch_name = src;
    let recover_title = "fix: address review findings on #" + iid_str;
    let recover_task = "Address these code-review findings on this PR with a MINIMAL change; do not touch unrelated code:\n" + bodies;
    // colony-lint: safe-exec-concat
    let job_cmd = "$COLONY_DIR/../../tools/code-edit-job.sh --owner " + shell_escape(owner) + " --repo " + shell_escape(repo) + " --issue " + shell_escape(iid_str) + " --branch " + shell_escape(branch_name) + " --title " + shell_escape(recover_title) + " --task " + shell_escape(recover_task) + " --recover";
    let job_out = try { exec sh job_cmd; } catch e {
        print("[code_writer] review-fix launcher failed for PR", iid_str, ":", e);
        "";
    };
    let job_state = job_word(job_out);
    // Cap-deferred (RUNNING): the CODE_EDIT_MAX_CONCURRENT semaphore was saturated,
    // so the launcher created NO job dir and promised a next-tick re-poll. Skip the
    // watermark/attempts write so re-entry for this note id is NOT blocked — without
    // this guard the watermark would swallow the deferral into the needs-human
    // fallback. Mirrors recover_at, which never consumes budget on a RUNNING defer.
    if job_state == "RUNNING" {
        print("[code_writer] review-fix deferred for PR", iid_str, "(concurrency cap) — will re-poll");
        return 1;
    };
    // Launched (or crashed mid-launch): write the note watermark + bump the attempt
    // memo so a crash still counts (fail-closed: never exceed 2 re-drives, never
    // re-drive the same finding twice).
    memo_write(scoped_memo(owner, repo, "review_fix:last_note:" + iid_str), note_id_str);
    memo_write(scoped_memo(owner, repo, "review_fix:attempts:" + iid_str), to_string(next_attempt));
    if job_state == "DONE" {
        print("[code_writer] review-fix pushed a fix to PR", iid_str, "(attempt", next_attempt, "/2)");
    } else {
        print("[code_writer] re-driving PR", iid_str, "for review findings (attempt", next_attempt, "/2)");
    };
    // One review-fix job per tick: signal the caller to return without drafting.
    // The launcher's pid check gives idempotency so a re-poll won't double-launch.
    return 1;
}

// resolve_review_scan: recurse over the open-PR list, launching at most ONE
// review-fix re-drive per tick. Returns 1 once a job is launched, else 0. Mirrors
// recover_scan.
fn resolve_review_scan(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    let did = resolve_review_at(owner, repo, raw, idx);
    if did == 1 { return 1; };
    return resolve_review_scan(owner, repo, raw, idx + 1);
}

// resolve_review_prs: list the federation's own open PRs and, at the autonomous
// tier only, re-drive the FIRST green one whose head is a fix/issue- branch we
// opened and that carries an actionable review note. Returns 1 if it launched a
// review-fix job (the caller returns for this tick — one job per tick, do not
// also draft). Mirrors recover_red_prs.
fn resolve_review_prs(owner: string, repo: string) -> int {
    // Autonomous-only: re-pushing to PRs is a terminal write.
    if repo_tier("code_writer", owner, repo) != "autonomous" { return 0; };
    // Raw (no --view): the normalized GitLab-shape list carries both `iid` and
    // `source_branch`, the two fields resolve_review_at needs.
    // colony-lint: safe-exec-concat
    let list_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state opened" + repo_arg(owner, repo);
    let raw = try { exec sh list_cmd; } catch e { ""; };
    if len(raw) < 5 { return 0; };
    return resolve_review_scan(owner, repo, raw, 0);
}

// #1521: QA-block recovery helpers (the fix-if-qa-block pattern — the adversarial
// analog of recover_red_prs). A GREEN own-PR that carries a BLOCKING #1484 QA
// verdict for its CURRENT head just sat HELD forever: the gate is fail-safe, but
// nothing consumed the block to revise the code. These helpers add the missing
// review->fix->re-review edge, a near-exact structural mirror of the review-resolver
// (#1360), but triggered by the durable commit-keyed marker
// `<!-- qa-verdict head=<fp16> status=block -->` (the SAME marker approval_decider's
// review gate reads) instead of a request_changes note. The whole path is behind a
// default-OFF operator flag (QA_FIX_RECOVERY_ENABLED) so it ships dormant until the
// qa_reviewer verdict precision is proven live (the #1568 burn-in). Idempotency is
// the head-fp watermark (qa_fix:last_block:<iid>) plus a MONOTONIC PER-ISSUE cap
// (qa_fix:attempts:<iid>, cap 2, NEVER reset per head): the adversarial ratchet can
// raise a DIFFERENT block on each re-review, so a per-head cap would reset exactly
// when a new block appears and never terminate the chase — only a per-issue counter
// bounds it. On exhaustion a one-time human note (qa_fix:escalated:<iid>) and stop.

// head_fingerprint: fingerprint of the MR head — sha256 of the mr-changes payload,
// first 16 hex chars. BYTE-IDENTICAL to qa_reviewer.head_fingerprint /
// approval_decider.head_fingerprint (pinned by
// tools/test-code-writer-qa-fix-recovery.sh): the block marker keys on the fp
// qa_reviewer embedded, so recomputing it here with the same bytes is what makes a
// STALE block on an OLD head a no-op (a force-push changed the diff => a different
// fp => the marker no longer matches). code_writer cannot call another agent's
// function, so it carries its own byte-identical copy. Native sha256_hex
// (agentis >= 1.20.0, #1588 slice 3) hashes the .ag string's UTF-8 bytes
// directly — no shell round-trip, value-identical to the prior python3
// sha256 pipeline it replaces.
fn head_fingerprint(changes_raw: string) -> string {
    return substring(sha256_hex(changes_raw), 0, 16);
}

// bot_login: the federation's own forge login, read from the sanitized env
// (GITHUB_ME on GitHub, GITLAB_ME on GitLab — both covered by the GITHUB_*/
// GITLAB_* wildcards on the install.sh exec.env_passthrough allowlist, so no
// allowlist entry is added; start-colony.sh exports exactly one, so
// first-non-empty is unambiguous). Empty when unconfigured -> the author bind
// (note_verdict / block_reason_for_head) honors NOTHING: the gate stays HELD
// and no re-fix drives (fail-closed, never a spurious release/clobber).
fn bot_login() -> string {
    let gh = getenv("GITHUB_ME");
    if len(gh) > 0 { return gh; };
    return getenv("GITLAB_ME");
}

// --- Shared verdict-note core (BYTE-IDENTICAL across approval_decider.ag and
// implementation/code_writer.ag) -------------------------------------------
// scan_verdict + marked_bot_note_body are duplicated verbatim from
// code-review/approval_decider.ag (.ag has no cross-file import, so "shared" =
// identical bodies) and pinned byte-for-byte by
// tools/test-approval-decider-review-gate.sh /
// tools/test-code-writer-qa-fix-recovery.sh — the author-bind logic can never
// drift between the #1484 gate reader and the #1521 recovery reader. Native
// rewrite of the retired `python3 -c` mr-notes readers on json_array_project
// (agentis >= 1.22.2): ONE flat, size-independent projection of the notes array
// into `author\tbody` TSV lines (element order preserved -> line 0 = newest
// note, matching the forge's newest-first ordering; `\t`/`\n`/`\\` escaped
// INSIDE each cell so the framing is injection-safe — a body with a real newline
// cannot forge a second line or spoof the author cell).
//
// scan_verdict: walk the projected `author\tbody` TSV newest-first (line 0 =
// newest), take-and-STOP on the FIRST bot-authored full-marker note, return its
// BODY cell (reason + marker), "" if none. Per line, in CB-short-circuit order:
// a whole-line index_of(mprefix) reject (the common no-marker line pays nothing
// more), then the tab split, then the author bind, then regex_capture (so a bot
// `status=weird` marker is SKIPPED and the scan CONTINUES to an older valid one
// — exact python re.search parity). AUTHOR BIND (#1573): to_lower(author) ==
// me_lc. `to_lower` is str::to_ascii_lowercase; GitHub logins are [A-Za-z0-9-]
// and GitLab usernames [A-Za-z0-9_.-] — ASCII-only, where to_ascii_lowercase ==
// .lower() == .casefold() byte-for-byte (the QA-Bot vs qa-bot case). A
// hypothetical non-ASCII login folds differently -> author != me_lc -> marker
// NOT honored -> HELD / no re-fix (always the fail-closed direction; the fed's
// own bot login is never non-ASCII). An empty author cell (missing/misshapen
// author, or an author-as-string that projects no .username) has tab <= 0 or an
// empty prefix -> skipped, scan continues.
fn scan_verdict(rest: string, me_lc: string, mprefix: string, marker_rx: string) -> string {
    if len(rest) == 0 { return ""; };
    let nl = index_of(rest, "\n");
    let line = if nl >= 0 { substring(rest, 0, nl) } else { rest };
    if index_of(line, mprefix) >= 0 {
        let tab = index_of(line, "\t");
        if tab > 0 {
            if to_lower(substring(line, 0, tab)) == me_lc {
                let body = substring(line, tab + 1, len(line));
                if len(regex_capture(marker_rx, body, 1)) > 0 {
                    return body;
                };
            };
        };
    };
    if nl < 0 { return ""; };
    return scan_verdict(substring(rest, nl + 1, len(rest)), me_lc, mprefix, marker_rx);
}

// marked_bot_note_body: fail-closed guards + flat projection + O(1) quick-reject.
// Empty head_fp or empty me -> "" (empty-me fail-closed -> the gate stays HELD).
// json_array_project returns "" on malformed / non-array notes_raw -> "" (HELD).
// The whole-blob index_of(mprefix) short-circuits the overwhelmingly-common
// verdict-NONE case with NO line walk at all (no marker for THIS head); only when
// the head-keyed marker string IS present do we walk lines via scan_verdict.
fn marked_bot_note_body(notes_raw: string, head_fp: string, me: string) -> string {
    if len(head_fp) == 0 { return ""; };
    if len(me) == 0 { return ""; };
    let mprefix = "<!-- qa-verdict head=" + head_fp + " status=";
    let marker_rx = "<!-- qa-verdict head=" + head_fp + " status=(pass|block) -->";
    let tsv = json_array_project(notes_raw, "", "author.username,body");
    if len(tsv) == 0 { return ""; };
    if index_of(tsv, mprefix) < 0 { return ""; };
    return scan_verdict(tsv, to_lower(me), mprefix, marker_rx);
}

// strip_verdict_markers: remove ALL `<!-- qa-verdict ...-->` spans by
// index_of/substring recursion (regex_replace is not shipped), so the block
// reason is the note body with the marker HTML comment removed. A stray `>`
// between `<!-- qa-verdict ` and `-->` would over-strip vs the retired
// `re.sub("<!-- qa-verdict [^>]*-->", ...)`, but bot markers never contain `>`
// and the stripped text is a non-gating human fix brief -> harmless direction.
fn strip_verdict_markers(s: string) -> string {
    let a = index_of(s, "<!-- qa-verdict ");
    if a < 0 { return s; };
    let after = substring(s, a, len(s));
    let c = index_of(after, "-->");
    if c < 0 { return s; };
    return strip_verdict_markers(substring(s, 0, a) + substring(s, a + c + 3, len(s)));
}

// block_reason_for_head: scan the mr-notes array (newest-first) for the FIRST
// note carrying the commit-keyed marker
// `<!-- qa-verdict head=<head_fp> status=(pass|block) -->`. If that newest match
// is `status=block`, return the note BODY with the marker HTML-comment stripped (=
// the block reason, fed as the fix brief); if it is `status=pass` or there is no
// match, return "". Native since #1613: shares scan_verdict / marked_bot_note_body
// (the BYTE-IDENTICAL core above) with approval_decider.note_verdict — same
// projection, same quick-reject, same author bind — but returns the reason text
// rather than the bare status. Taking the NEWEST match and acting only on `block`
// reproduces the #1493 race guard: a later re-review that flipped this head to
// `pass` yields "" (no re-drive). AUTHOR BIND (#1573): a marker is honored ONLY on
// a note whose author.username casefold-equals the fed's own bot login `me` (from
// bot_login()); a `block` marker QUOTED by an operator or another bot is ignored
// (no bogus re-fix). An empty `me` (unconfigured forge identity) honors NOTHING ->
// "" -> no re-drive (fail-closed). Total: malformed JSON, empty head, empty me, no
// bot-authored matching marker all collapse to "".
// ESCAPED-REASON DIVERGENCE (#1613, decided LEAVE-ESCAPED + document): the reason
// text is extracted from the json_array_project body cell, where a real newline/
// tab is the ESCAPED two-char form (a `\n` becomes `\` `n`; `trim` does not strip
// a literal `\n`). The retired python saw raw newlines. The pass/block/none
// DECISION is value-identical; the reason whitespace is cosmetic (an LLM `--task`
// brief reads the escaped form fine), so this single divergence is documented, not
// unescaped.
fn block_reason_for_head(notes_raw: string, head_fp: string, me: string) -> string {
    let body = marked_bot_note_body(notes_raw, head_fp, me);
    if len(body) == 0 { return ""; };
    let status = regex_capture("<!-- qa-verdict head=" + head_fp + " status=(pass|block) -->", body, 1);
    if status != "block" { return ""; };
    return trim(strip_verdict_markers(body));
}

// qa_fix_attempts: how many QA-block re-drives we have already launched for this
// ISSUE (from the qa_fix:attempts:<iid> memo). Missing => 0. Monotonic per issue —
// NEVER reset per head, so the adversarial ratchet cannot chase forever. Mirrors
// recover_attempts / review_fix_attempts.
fn qa_fix_attempts(owner: string, repo: string, iid_str: string) -> int {
    let raw = recall_latest(scoped_memo(owner, repo, "qa_fix:attempts:" + iid_str));
    if len(raw) == 0 { return 0; };
    return parse_int(raw);
}

// recover_qa_block_at: process the open PR at index `idx`. Returns 1 if it LAUNCHED
// a QA-block re-drive (caller returns for this tick — one job per tick, do not also
// draft), 0 otherwise. Routes each PR to EXACTLY ONE recovery path: own PRs only
// (head starts fix/issue-); STATE=green (red -> recover_red_prs, pending -> don't
// race CI); MERGEABLE!=conflicting (conflicting -> rebase_conflicting_prs); AND a
// `block` verdict for the RECOMPUTED CURRENT head_fp (a stale block on an OLD head
// yields "" => no re-drive). Idempotent on the head-fp watermark
// (qa_fix:last_block:<iid>). Cap 2 per ISSUE via qa_fix:attempts:<iid> (bumped
// AFTER launch, skipped on a RUNNING cap-defer); on exhaustion a one-time human
// note (qa_fix:escalated:<iid>) and no further pushes. Mirrors resolve_review_at.
fn recover_qa_block_at(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    if iid_str == "void" { return 0; };
    let src = open_pr_field(raw, idx, "source_branch");
    // Own PRs only: never touch a PR we did not open.
    if index_of(src, "fix/issue-") != 0 { return 0; };

    // colony-lint: safe-exec-concat
    let checks_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-pipeline-status " + shell_escape(iid_str) + repo_arg(owner, repo);
    let checks_out = try { exec sh checks_cmd; } catch e { ""; };
    // Classify the raw pipeline status (see recover_at / #1355).
    let state = ci_state(pr_check_token(checks_out, "STATUS"));
    // Act ONLY on green: red is owned by recover_red_prs (no race), pending => don't
    // race CI. Same green-only guard as resolve_review_at.
    if state != "green" { return 0; };
    // Conflicting is owned by rebase_conflicting_prs — never re-drive a conflicting
    // head (it has no fresh CI and a fix would rebase-conflict anyway).
    let mergeable = pr_check_token(checks_out, "MERGEABLE");
    if mergeable == "conflicting" { return 0; };

    // Recompute the CURRENT head fingerprint. A STALE block on an OLD head keys a
    // different fp, so block_reason_for_head below returns "" — the no-op that makes
    // acting on a stale block impossible.
    // colony-lint: safe-exec-concat
    let changes_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-changes " + shell_escape(iid_str) + repo_arg(owner, repo);
    let changes_raw = try { exec sh changes_cmd; } catch e { ""; };
    let head_fp = head_fingerprint(changes_raw);
    if len(head_fp) == 0 { return 0; };

    // colony-lint: safe-exec-concat
    let notes_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-notes " + shell_escape(iid_str) + repo_arg(owner, repo);
    let notes_raw = try { exec sh notes_cmd; } catch e { ""; };
    let reason = block_reason_for_head(notes_raw, head_fp, bot_login());
    // Empty = no blocking verdict for the CURRENT head (none / stale / flipped to
    // pass) — nothing to recover.
    if len(reason) == 0 { return 0; };

    // Idempotency: the same block on the same head is re-driven at most once (guards
    // the in-flight window before the fix pushes a new head). A NEW head (after the
    // fix) has a NEW head_fp, so a fresh block on it is a fresh attempt — still under
    // the per-issue cap.
    let last_block = recall_latest(scoped_memo(owner, repo, "qa_fix:last_block:" + iid_str));
    if last_block == head_fp { return 0; };

    // Cap / escalation. The counter is MONOTONIC PER ISSUE (never reset per head) so
    // the adversarial ratchet cannot become an infinite chase. On exhaustion post a
    // one-time human note (guarded by qa_fix:escalated:<iid>) and stop — no further
    // pushes.
    let attempts = qa_fix_attempts(owner, repo, iid_str);
    if attempts >= 2 {
        let escalated = recall_latest(scoped_memo(owner, repo, "qa_fix:escalated:" + iid_str));
        if len(escalated) == 0 {
            memo_write(scoped_memo(owner, repo, "qa_fix:escalated:" + iid_str), head_fp);
            // colony-lint: safe-exec-concat
            let note_cmd = "$COLONY_DIR/scripts/forge-api.sh post-note " + shell_escape(iid_str) + " --body " + shell_escape("**QA auto-fix gave up** (automated): 2 attempts did not clear the blocking QA verdict for this PR; needs a human.") + repo_arg(owner, repo);
            try { exec sh note_cmd; } catch e {
                print("[code_writer] QA-fix escalation note failed for PR", iid_str, ":", e);
            };
        };
        print("[code_writer] QA-fix gave up on PR", iid_str, "after 2 attempts — needs human");
        return 0;
    };

    let next_attempt = attempts + 1;

    // Re-drive the PR's ACTUAL head branch (source_branch), validated above to start
    // with fix/issue-. --recover pushes to the existing branch (no new PR); keying
    // --issue on the PR iid shares the per-issue job dir with recover_at /
    // resolve_review_at so the launcher pid-guard serializes the recover paths.
    let branch_name = src;
    let recover_title = "fix: address QA block on #" + iid_str;
    let recover_task = "A pre-merge QA review BLOCKED this change. Fix ONLY the specific finding below with a MINIMAL change and stop; do not touch unrelated code:\n" + reason;
    // colony-lint: safe-exec-concat
    let job_cmd = "$COLONY_DIR/../../tools/code-edit-job.sh --owner " + shell_escape(owner) + " --repo " + shell_escape(repo) + " --issue " + shell_escape(iid_str) + " --branch " + shell_escape(branch_name) + " --title " + shell_escape(recover_title) + " --task " + shell_escape(recover_task) + " --recover";
    let job_out = try { exec sh job_cmd; } catch e {
        print("[code_writer] QA-fix launcher failed for PR", iid_str, ":", e);
        "";
    };
    let job_state = job_word(job_out);
    // Cap-deferred (RUNNING): the CODE_EDIT_MAX_CONCURRENT semaphore was saturated,
    // so the launcher created NO job dir and promised a next-tick re-poll. Skip the
    // watermark/attempts write so re-entry for this head is NOT swallowed and no
    // budget is consumed (#1379). Mirrors resolve_review_at.
    if job_state == "RUNNING" {
        print("[code_writer] QA-fix deferred for PR", iid_str, "(concurrency cap) — will re-poll");
        return 1;
    };
    // Launched (or crashed mid-launch): write the head-fp watermark + bump the
    // attempt memo so a crash still counts (fail-closed: never exceed 2 re-drives),
    // and the counter is NEVER reset per head (monotonic per issue). A guarded_push
    // (#1516) refusal on a foreign-commit branch also lands here (non-RUNNING) — so a
    // refusal counts toward the cap and escalates after 2, never loops.
    memo_write(scoped_memo(owner, repo, "qa_fix:last_block:" + iid_str), head_fp);
    memo_write(scoped_memo(owner, repo, "qa_fix:attempts:" + iid_str), to_string(next_attempt));
    if job_state == "DONE" {
        print("[code_writer] QA-fix pushed a fix to blocked PR", iid_str, "(attempt", next_attempt, "/2)");
    } else {
        print("[code_writer] re-driving PR", iid_str, "for QA block (attempt", next_attempt, "/2)");
    };
    // One QA-fix job per tick: signal the caller to return without drafting. The
    // launcher's pid check gives idempotency so a re-poll won't double-launch.
    return 1;
}

// recover_qa_block_scan: recurse over the open-PR list, launching at most ONE
// QA-block re-drive per tick. Returns 1 once a job is launched, else 0. Mirrors
// resolve_review_scan.
fn recover_qa_block_scan(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    let did = recover_qa_block_at(owner, repo, raw, idx);
    if did == 1 { return 1; };
    return recover_qa_block_scan(owner, repo, raw, idx + 1);
}

// recover_qa_block_prs: list the federation's own open PRs and, at the autonomous
// tier only, re-drive the FIRST green non-conflicting one whose head is a fix/issue-
// branch we opened and that carries a BLOCKING QA verdict for its current head.
// Returns 1 if it launched a QA-fix job (the caller returns for this tick — one job
// per tick, do not also draft). Mirrors resolve_review_prs. The feature flag is the
// FIRST statement: flag-off = zero forge reads = byte-identical no-op.
fn recover_qa_block_prs(owner: string, repo: string) -> int {
    // Feature-flag default OFF: dormant until qa_reviewer verdict precision is
    // proven live (#1568). Reading the flag first keeps flag-off a zero-forge-read
    // no-op. QA_FIX_RECOVERY_ENABLED is on the install.sh exec.env_passthrough
    // allowlist + #1437 residue list (getenv reads the SANITIZED env).
    if getenv("QA_FIX_RECOVERY_ENABLED") != "1" { return 0; };
    // Autonomous-only: re-pushing to PRs is a terminal write.
    if repo_tier("code_writer", owner, repo) != "autonomous" { return 0; };
    // Raw (no --view): needs both `iid` and `source_branch`, which the `impl` view
    // drops — same reason as recover_red_prs / resolve_review_prs.
    // colony-lint: safe-exec-concat
    let list_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state opened" + repo_arg(owner, repo);
    let raw = try { exec sh list_cmd; } catch e { ""; };
    if len(raw) < 5 { return 0; };
    return recover_qa_block_scan(owner, repo, raw, 0);
}

// #1453 Wave 1: reality-check — map the reality-check signal to the
// experience-store outcome enum. Signal 0 ("no signal yet") is handled by the
// caller via an early return and never reaches this function.
fn signal_to_outcome(signal: int) -> string {
    if signal == 1 {
        return "success";
    };
    if signal == 2 {
        return "partial";
    };
    return "failure";
}

// #1453 Wave 1: reality-check — record a pending verdict for an autonomously
// opened MR. Stored as JSON array [t, iid, ""] — the fields are ASCII-safe
// (epoch int, iid int, empty payload) so naive concatenation is sufficient
// and we skip a JSON encoder. Single-slot idiom from labeler.ag: the next
// autonomous DONE overwrites; evaluate_code_verdict scores it against the
// fate of the deterministic fix/issue-<iid> branch.
fn record_code_verdict(owner: string, repo: string, issue_id: int) -> void {
    let ts_raw = to_string(now_ms() / 1000);
    let blob = "[" + ts_raw + "," + to_string(issue_id) + ",\"\"]";
    memo_write(scoped_memo(owner, repo, "code_writer:pending_verdict"), blob);
    print("[code_writer] verdict recorded: issue", issue_id);
}

// #1453 Wave 1: reality-check — age of the pending verdict in seconds.
fn verdict_age_seconds(blob: string) -> int {
    let emit_ts = parse_int(to_string(json_get(blob, "[0]")));
    let now_raw = to_string(now_ms() / 1000);
    let now = parse_int(now_raw);
    return now - emit_ts;
}

// #1453 Wave 1: reality-check — score the pending verdict against the fate of
// the MR we opened on the deterministic fix/issue-<iid> branch. Mechanical
// compare via the raw merge-requests lists (raw_list_has_branch — the raw
// GitLab shape carries source_branch, same reason recover_red_prs reads raw),
// NEVER a prompt(). merged => success (1); closed unmerged and not re-opened
// => fail (3); still opened or not found => no signal yet (leave pending).
// The merged list is checked FIRST so a GitHub backend (whose closed list
// includes merged PRs) can never misread a merged PR as closed-unmerged.
// 24h ageout drops the verdict without scoring. Runs at the TOP of
// tick_for_repo, BEFORE recover_red_prs and any other early-returning work.
fn evaluate_code_verdict(owner: string, repo: string) -> void {
    let key = scoped_memo(owner, repo, "code_writer:pending_verdict");
    let blob = recall_latest(key);
    if len(blob) < 3 {
        return;
    };
    let timeout_s = 86400;
    if verdict_age_seconds(blob) > timeout_s {
        print("[code_writer] verdict aged out without signal");
        memo_write(key, "");
        return;
    };
    let issue_id = parse_int(to_string(json_get(blob, "[1]")));
    let branch = "fix/issue-" + to_string(issue_id);
    // colony-lint: safe-exec-concat
    let merged_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged" + repo_arg(owner, repo);
    let merged_raw = try { exec sh merged_cmd; } catch e { ""; };
    // A transient merged-query failure must never let GitHub's
    // closed-superset-of-merged list misread a merged MR as
    // closed-unmerged: score ONLY when the merged list parsed as a JSON
    // array (index 0 = leading "["); anything else leaves the verdict
    // pending for a later tick.
    if index_of(merged_raw, "[") != 0 {
        return;
    };
    let signal = if raw_list_has_branch(merged_raw, branch) {
        1;
    } else {
        // colony-lint: safe-exec-concat
        let closed_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state closed" + repo_arg(owner, repo);
        let closed_raw = try { exec sh closed_cmd; } catch e { ""; };
        if raw_list_has_branch(closed_raw, branch) {
            // colony-lint: safe-exec-concat
            let opened_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state opened" + repo_arg(owner, repo);
            let opened_raw = try { exec sh opened_cmd; } catch e { ""; };
            // Same rule for the reopened check: an unparseable opened
            // list must not be read as "not reopened" (a false fail).
            if index_of(opened_raw, "[") != 0 {
                0;
            } else {
                if raw_list_has_branch(opened_raw, branch) { 0; } else { 3; };
            };
        } else {
            0;
        };
    };
    if signal == 0 {
        return;
    };
    let outcome = signal_to_outcome(signal);
    if len(owner) > 0 {
        learn(
            "code_write",
            "issue " + to_string(issue_id) + " reality-check",
            "branch " + branch + " | signal: " + to_string(signal),
            outcome,
            ["acted", "implementation", repo_tag(owner, repo)]
        );
    } else {
        learn(
            "code_write",
            "issue " + to_string(issue_id) + " reality-check",
            "branch " + branch + " | signal: " + to_string(signal),
            outcome,
            ["acted", "implementation"]
        );
    };
    print("[code_writer] reality-check: issue", issue_id, "signal", signal, "->", outcome);
    memo_write(key, "");
}

fn tick_for_repo(owner: string, repo: string) -> void {
    // #1453 Wave 1: reality-check — score the previous autonomous MR verdict
    // FIRST, before red-PR recovery and the draft path, so a recovery launch's
    // early return can never starve the feedback loop.
    evaluate_code_verdict(owner, repo);

    // #1518: auto-rebase of our own CONFLICTING PRs runs FIRST — BEFORE red-CI
    // recovery. A CONFLICTING PR has NO fresh CI run (GitHub skips workflows on
    // an unmergeable head), so recover_red_prs cannot help it; the rebase must
    // run first to PRODUCE a CI run. One code-edit job per tick: a launch returns
    // without drafting.
    if rebase_conflicting_prs(owner, repo) == 1 {
        let now_b = now_iso();
        if len(now_b) > 0 {
            memo_write(scoped_memo(owner, repo, "code_writer:last_check"), now_b);
        };
        return;
    };

    // #1332: red-PR recovery runs (autonomous tier only) BEFORE the draft path.
    // If a red PR we own is re-driven this tick, return without drafting — one
    // code-edit job per tick.
    if recover_red_prs(owner, repo) == 1 {
        let now_r = now_iso();
        if len(now_r) > 0 {
            memo_write(scoped_memo(owner, repo, "code_writer:last_check"), now_r);
        };
        return;
    };

    // #1360: review-finding recovery. Runs AFTER red-CI recovery (red PRs are
    // owned by recover_red_prs — no race) and BEFORE the draft path. Acts only on
    // a GREEN own-PR carrying an actionable review note (the durable forge note,
    // not the ephemeral bus). One job per tick: a launch returns without drafting.
    if resolve_review_prs(owner, repo) == 1 {
        let now_v = now_iso();
        if len(now_v) > 0 {
            memo_write(scoped_memo(owner, repo, "code_writer:last_check"), now_v);
        };
        return;
    };

    // #1521: QA-block recovery. Runs AFTER review-finding recovery and BEFORE the
    // draft path (last among the recovery sweeps — it and resolve_review_prs both
    // act on GREEN own-PRs but on DISJOINT signals: actionable_note never matches
    // the QA verdict marker, so there is no overlap). Feature-flagged default OFF
    // (QA_FIX_RECOVERY_ENABLED). Acts only on a GREEN, non-conflicting own-PR
    // carrying a BLOCKING QA verdict for the CURRENT head (the #1484 marker). One
    // job per tick: a launch returns without drafting; the new head invalidates the
    // stale verdict marker and re-stamps the #1484 wait clock for the gate to
    // re-judge (this sweep does NOT touch the gate).
    if recover_qa_block_prs(owner, repo) == 1 {
        let now_q = now_iso();
        if len(now_q) > 0 {
            memo_write(scoped_memo(owner, repo, "code_writer:last_check"), now_q);
        };
        return;
    };

    // 1. Learn from recently merged MRs
    let cmd = merged_mr_cmd(owner, repo);
    let raw = try {
        exec sh cmd;
    } catch e {
        print("[code_writer] GitLab poll failed:", e);
        "";
    };

    if len(raw) > 10 {
        let mr_iid = parse_int(to_string(json_get(raw, "[0].iid")));

        if should_learn_from_mr(owner, repo, mr_iid) {
            memo_write(scoped_memo(owner, repo, "code_writer:last_learned_mr_iid"), to_string(mr_iid));
            // colony-lint: safe-exec-concat
            let changes_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-changes " + to_string(mr_iid) + repo_arg(owner, repo);
            let changes_raw = try { exec sh changes_cmd; } catch e { ""; };

            if len(changes_raw) > 10 {
                let patterns = prompt(
                    "Analyze this MR diff JSON. Identify: naming conventions (variable/function names, casing), code structure (module organization, import style), error handling patterns (try/catch, Result types, guard clauses). Return JSON: mr_count (int, always 1), naming (string), structure (string), error_handling (string). Return ONLY the raw JSON object — no markdown code fences, no ```json wrapper, no prose.",
                    changes_raw
                ) -> CodePatterns;

                if len(owner) > 0 {
                    learn(
                        "code_write",
                        "MR " + to_string(mr_iid),
                        "naming: " + patterns.naming + " | structure: " + patterns.structure + " | errors: " + patterns.error_handling,
                        "success",
                        ["observed", "implementation", repo_tag(owner, repo)]
                    );
                } else {
                    learn(
                        "code_write",
                        "MR " + to_string(mr_iid),
                        "naming: " + patterns.naming + " | structure: " + patterns.structure + " | errors: " + patterns.error_handling,
                        "success",
                        ["observed", "implementation"]
                    );
                };
                print("[code_writer] Learned from MR", mr_iid);
            };
        };
    };

    // 2. Check for assigned issues needing implementation.
    // #1181: pickup keys on ASSIGNMENT, not label events. Always query the
    // current-state `assigned-issues` snapshot so a stably-assigned issue
    // (no recent label churn) stays visible on every tick, not just the
    // first. The #200 `should_draft_code` staleness gate below prevents
    // re-paying the LLM cost now that the snapshot is queried each tick.
    let unassigned_flag = include_unassigned_flag();
    // colony-lint: safe-exec-concat
    let issues_cmd = "$COLONY_DIR/scripts/forge-api.sh assigned-issues --view assigned" + unassigned_flag + repo_arg(owner, repo);
    let issues_raw = try {
        exec sh issues_cmd;
    } catch e {
        print("[code_writer] assigned-issues poll failed:", e);
        "";
    };

    if len(issues_raw) > 10 {
        // #200: early-out when the top assigned issue is the same one we
        // already drafted and its `updated_at` is unchanged. The iid /
        // updated_at pair is stashed at the start of a fresh draft so
        // subsequent ticks on a sticky assignment short-circuit before
        // the `draft = prompt(...)` call below.
        let first_iid_str = to_string(json_get(issues_raw, "[0].iid"));
        let first_upd = to_string(json_get(issues_raw, "[0].updated_at"));
        // #1516: recovery-over-redraft. An issue whose deterministic
        // fix/issue-<iid> branch already has an open OR merged MR is NEVER
        // re-drafted from scratch — the PR IS the artifact. The pre-#1516 gate
        // re-triggered a full draft->edit->finalize->FORCE-PUSH cycle whenever
        // should_draft_code() saw an updated_at bump (an operator comment/label
        // on the already-PR'd issue), which rebuilt the branch off main and
        // force-pushed over the operator's commits. Dropping that re-trigger
        // makes an existing MR terminal: needs_draft = !mr_exists. The #1350
        // MR-less rescue is preserved verbatim (no MR ⇒ needs_draft true), so an
        // edit job that died without opening an MR still gets a fresh draft.
        let mr_exists = has_mr_for_branch(owner, repo, first_iid_str);
        if mr_exists {
            // A phase memo left set by a prior tick's ag_edit_step whose job has
            // already produced an MR is terminal/stale: reset it (+ clear the job
            // dir) so no later tick resumes a --finalize that would force-push a
            // locally-rebuilt branch over the existing PR. The phase-set + no-MR
            // case is deliberately left untouched here — it self-heals through
            // ag_edit_step's own ERROR->ag_edit_reset path (a dead detached
            // process), and the abandoned job then reaches a fresh draft below.
            let stale_phase = recall_latest(scoped_memo(owner, repo, "code_edit_loop:phase:" + first_iid_str));
            if len(stale_phase) > 0 {
                print("[code_writer] issue", first_iid_str, "has an MR but a lingering edit-loop phase", stale_phase, "— resetting (the PR is terminal; not resuming a stale finalize)");
                ag_edit_reset(owner, repo, first_iid_str);
                clear_job_dir(first_iid_str);
            };
        };
        let needs_draft = !mr_exists;
        if needs_draft {
            // #1560: an ownership hold (operator commits on the branch, no MR)
            // set by a prior ag_edit_step refusal. Checked FIRST — before the
            // input_unchanged early-return and before the expensive draft
            // prompt() below — so a held issue costs one cheap `git ls-remote`
            // per tick instead of a full draft+edit+finalize cycle.
            if ownership_held(owner, repo, first_iid_str) {
                print("[code_writer] issue", first_iid_str, "has an ownership hold (operator commits on the branch, no MR) — skipping draft this tick");
                return;
            };
            // #1370 (B3): tier-independent input-unchanged early-return BEFORE
            // the draft prompt(). If the top assigned issue's (iid, updated_at)
            // fingerprint is unchanged since the last tick we saw it AND an
            // open/merged MR already exists for its fix/issue-<iid> branch
            // (has_mr_for_branch — i.e. real work landed, NOT an MR-less branch
            // that needs the #1363 rescue), there is nothing new to do this
            // tick: skip the expensive draft prompt and re-poll next tick. The
            // red-CI recovery path already ran first (recover_red_prs returns
            // before reaching here), so "no red CI to recover" holds. This is
            // the idle-prompt-suppression win: it stops re-prompting an
            // unchanged, already-handled issue every tick. It never starves —
            // an external edit/re-assignment bumps updated_at and re-triggers.
            if input_unchanged(owner, repo, first_iid_str, first_upd) {
                if has_mr_for_branch(owner, repo, first_iid_str) {
                    let now_s = now_iso();
                    if len(now_s) > 0 {
                        memo_write(scoped_memo(owner, repo, "code_writer:last_check"), now_s);
                    };
                    memo_write(scoped_memo(owner, repo, "code_writer:last_seen_iid"), first_iid_str);
                    memo_write(scoped_memo(owner, repo, "code_writer:last_seen_updated_at"), first_upd);
                    print("[code_writer] issue", first_iid_str, "unchanged + MR exists — skipping draft prompt this tick");
                    return;
                };
            };
            // #1185: the staleness markers (last_drafted_iid / _updated_at)
            // are NOT set here. The #200 gate must only short-circuit once an
            // action for this issue has actually COMPLETED. The autonomous
            // path sets them after commit-files succeeds; the review-gated /
            // propose / shadow paths set them after their own terminal action
            // (the draft comment / emit). A branch-created-but-commit-failed
            // tick leaves the markers unset so the next tick retries instead
            // of stranding an empty branch.
            let rec = recommend("code_write", ["accuracy"]);
            let context = "Assigned issues: " + issues_raw + "\nLearned code patterns: " + to_string(rec);

            let draft = prompt(
                "You are a code writer agent. Pick the highest-priority assigned issue and draft an implementation plan. Propose a branch name (kebab-case, prefixed with feat/ or fix/), a concise Conventional Commits PR title (format `type(scope): summary` in the imperative mood, 50-72 chars, lowercase summary, NO trailing period; type is one of feat/fix/docs/test/refactor/chore/perf), list the files to create or modify with brief descriptions, and summarize the approach. Return JSON: issue_id (int), branch_name (string), title (string, the Conventional Commits PR title — short, NOT the full summary), files (string, markdown list of file paths and what each does), summary (string, 2-3 sentences for the PR body), confidence (float 0-1). Return ONLY the raw JSON object — no markdown code fences, no ```json wrapper, no prose.",
                context
            ) -> CodeDraft;

            let my_tier = repo_tier("code_writer", owner, repo);
            print("[code_writer] Drafted code for issue", draft.issue_id, "(tier:", my_tier, ")");

            if my_tier == "autonomous" {
                // #1210: Approach A — edit files DIRECTLY in a local checkout via
                // Claude Code (flat-cyborg), then commit the `git diff` and open
                // the PR. This replaces the old "create-branch -> get-file ->
                // numbered_view -> line-range prompt() -> apply-line-edits.py ->
                // commit-files via the forge Git Database API" chain. That chain
                // round-tripped file CONTENT through flat-cyborg's TUI screen-
                // scrape, which line-wraps and corrupts large files (#1152 /
                // #1195 / #1208). Editing in a real checkout sidesteps the
                // screen-scrape: claude's own file tools touch the working tree
                // and we commit whatever git shows. The editing prompt now lives
                // INSIDE the orchestrator's flat-cyborg invocation, NOT as an .ag
                // prompt() — so this branch has no prompt() at all. flat-cyborg
                // stays the only backend; `claude -p` is not used.
                //
                // #1214: the orchestrator's job (clone + flat-cyborg edit +
                // commit + push + PR) runs for MINUTES, but agentis caps a single
                // `exec sh` at ~120000ms (the exec.default_timeout_ms knob is
                // ignored), so a synchronous call was killed mid-edit with
                // ExecTimeout. Instead we call tools/code-edit-job.sh — a FAST
                // launcher that runs code-edit-in-checkout.sh DETACHED (setsid)
                // and tracks it in a per-issue job dir. It returns in well under
                // 120s on every tick, printing one of: LAUNCHED (just started),
                // RUNNING (still going), DONE <url> (PR opened), NO_EDITS (claude
                // changed nothing), or ERROR <short>. code_writer polls it across
                // ticks: while LAUNCHED/RUNNING it leaves the #1185 markers unset
                // so the same assigned issue is re-polled next tick (a re-poll
                // does NOT start a second clone/edit — the launcher's pid check
                // guards idempotency). Only DONE sets the markers + emits.
                //
                // Deterministic per-issue branch (fix/issue-<iid>) so a retry
                // reuses the same branch instead of littering empty branches.
                let issue_iid = to_string(draft.issue_id);
                let branch_name = "fix/issue-" + issue_iid;
                // colony-lint: safe-exec-concat
                let issue_cmd = "$COLONY_DIR/scripts/forge-api.sh issue " + to_string(draft.issue_id) + repo_arg(owner, repo);
                let issue_detail = try { exec sh issue_cmd; } catch e { ""; };
                // Task text = issue body + the drafted plan. The orchestrator
                // wraps this into the claude editing instruction.
                let task_text = "Issue:\n" + issue_detail + "\n\nPlan:\n" + draft.files + "\n\n" + draft.summary;
                // #1500: post the drafted plan as an issue note BEFORE the
                // launch call below, so the operator's pre-code intervention
                // point (cf. #1482) exists for the autonomous tier too — not
                // just the review-gated tier's "pending approval" note. Fail
                // open: a failed post is logged and never blocks the launch;
                // the per-issue memo is written ONLY on a successful post so
                // a failed attempt is naturally retried next tick instead of
                // being silently dropped. Guarded so LAUNCHED/RUNNING re-polls
                // (this whole block re-enters every tick until DONE) never
                // double-post.
                if !plan_already_posted(owner, repo, issue_iid) {
                    let plan_note = "[plan] **Implementation Plan** (automated)\n\nBranch: `" + branch_name + "`\n\n" + draft.summary + "\n\nFiles:\n" + draft.files;
                    // colony-lint: safe-exec-concat
                    let plan_post_cmd = "$COLONY_DIR/scripts/forge-api.sh add-note " + to_string(draft.issue_id) + " --body " + shell_escape(plan_note) + repo_arg(owner, repo);
                    let plan_post_result = try { exec sh plan_post_cmd; } catch e {
                        print("[code_writer] Failed to post autonomous plan note:", e);
                        "";
                    };
                    if len(plan_post_result) > 0 { memo_write(scoped_memo(owner, repo, "code_writer:plan_posted:" + issue_iid), "1"); };
                };
                // The launcher manages the detached orchestrator's lifecycle and
                // prints the current poll-state on stdout. It never blocks on the
                // slow job, so this `exec sh` returns fast and never hits the
                // 120s cap. A non-zero exit (a usage / launch error) collapses
                // the `try` to "" => job_word "" => the ERROR/else branch retries.
                // Epic auto-trigger (#1257): an epic-class issue gets --decompose so
                // the orchestrator splits it into per-subtask edits (M3, #1254). The
                // epic label is the planning vocabulary (planning:labels:epic, read
                // cross-colony) or "epic" by default, matched as EXACT quoted JSON
                // array element(s) on the issue's labels so "not-epic"/"epic-foo" don't
                // false-match. Decomposing a non-epic is harmless (one subtask = the
                // whole task), so a loose match here is low-stakes.
                let epic_vocab = recall_latest("planning:labels:epic");
                let epic_vocab_or_default = if len(epic_vocab) > 0 { epic_vocab; } else { "epic"; };
                // #1271: detect epic on the DRAFTED issue (issue_detail, fetched
                // above), NOT issues_raw[0] — the LLM may draft ANY assigned issue,
                // so [0] is the wrong issue whenever more than one is assigned.
                // Match the quoted label in the RAW issue JSON: to_string() of an
                // ARRAY-valued json_get yields "void" on the runtime, so the old
                // json_get(...,"labels") path never matched. Searching the raw text
                // for "\"<token>\"" is reliable and keeps the anti-false-match
                // (an "epic"-prefixed label like "epic-foo" lacks the closing quote;
                // body/title quotes are JSON-escaped as \" so they cannot match).
                // #1259: is_epic_match splits a CSV vocab ("epic, big-feature") and
                // ORs the quoted match across tokens, so a "big-feature"-only issue
                // decomposes too — CSV parity with task_decomposer.ag, which splices
                // the same vocab whole into an LLM prompt that can split it.
                let is_epic = is_epic_match(issue_detail, epic_vocab_or_default);
                if is_epic { print("[code_writer] issue", issue_iid, "is epic-class — auto-decomposing (#1257)"); };
                // #1422 M2: an epic opts into the AG-driven decompose loop only
                // when AG_DECOMPOSE_LOOP=1 (DEFAULT OFF); otherwise it stays on
                // the untouched in-shell --decompose path. A non-epic never
                // decomposes (decompose_flag=""), so the flag is epic-scoped.
                let ag_decompose_on = if is_epic { getenv("AG_DECOMPOSE_LOOP") == "1"; } else { false; };
                let decompose_flag = if is_epic { if ag_decompose_on { ""; } else { " --decompose"; }; } else { ""; };
                // #1349: thread the agent's OWN drafted summary through as the
                // PR/MR body (--description). draft.summary is the "2-3 sentences
                // for the PR body" the prompt() above already produced; without
                // this it was silently dropped and the orchestrator fell back to a
                // static template. The LLM reasoning stays in the .ag prompt(), NOT
                // in shell plumbing. code-edit-job.sh forwards it to the detached
                // worker; code-edit-in-checkout.sh uses it for create-mr (static
                // template only as the empty-value fallback).
                // #1354 step 2b: when AG_DRIVEN_EDIT_LOOP=1, code_writer drives
                // the attempt/continuation/verify/finalize loop ITSELF over the
                // #1354-step-2a primitives (ag_edit_step); otherwise the default
                // in-shell multi-attempt loop runs (code-edit-in-checkout.sh's
                // own loop, launched here). Both collapse to one verdict shape —
                // "DONE:<url>" / "RUNNING" / "NO_EDITS" / "ERROR" — so the
                // terminal handling below is shared. For the default path the PR
                // URL is folded into DONE via job_rest (the RESULT= token).
                // #1354 step 3: the AG-driven loop is the default for ORDINARY
                // issues. #1422 M2: EPICS now have TWO routes — the AG-driven
                // decompose loop (ag_decompose_step, opt-in via AG_DECOMPOSE_LOOP,
                // DEFAULT OFF) or the untouched in-shell --decompose path (the
                // working default until the M3 burn-in). ag_loop_on (the ordinary
                // AG loop, ag_edit_step) is only ever on for NON-epics — an epic
                // routes through ag_decompose_step or the in-shell path, never
                // ag_edit_step, so decomposition is never silently dropped.
                let ag_loop_on = if is_epic { false; } else { getenv("AG_DRIVEN_EDIT_LOOP") == "1"; };
                // Default path launches the in-shell loop HERE so its raw poll
                // line (STATUS=.. PID_ALIVE=.. RESULT=..) stays in scope for the
                // ERROR diagnostic below; job_cmd is built either way but only
                // exec'd on the default (neither-AG-path) route. Both AG paths
                // drive + log their own detail, so job_raw is "" there.
                // colony-lint: safe-exec-concat
                let job_cmd = "$COLONY_DIR/../../tools/code-edit-job.sh --owner " + shell_escape(owner) + " --repo " + shell_escape(repo) + " --issue " + shell_escape(issue_iid) + " --branch " + shell_escape(branch_name) + " --title " + shell_escape(draft.title) + " --description " + shell_escape(draft.summary) + " --task " + shell_escape(task_text) + decompose_flag;
                // Exec the in-shell launcher only when NEITHER AG path is active
                // (`.ag` has no `||`, so nest the two off-checks).
                let job_raw = if ag_loop_on { ""; } else {
                    if ag_decompose_on { ""; } else {
                        try { exec sh job_cmd; } catch e {
                            print("[code_writer] code-edit-job launcher failed — not marking drafted, will retry:", e);
                            "";
                        };
                    };
                };
                let verdict = if ag_decompose_on {
                    ag_decompose_step(owner, repo, issue_iid, branch_name, draft.title, task_text, draft.summary);
                } else {
                    if ag_loop_on {
                        ag_edit_step(owner, repo, issue_iid, branch_name, draft.title, task_text, draft.summary);
                    } else {
                        let d = job_decide(job_raw);
                        if d == "DONE" { "DONE:" + job_rest(job_raw); } else { d; };
                    };
                };
                // Split the verdict into a bare state + the PR URL (empty unless
                // DONE) so the branches below read a stable job_state / pr_url.
                let is_done_v = index_of(verdict, "DONE:") == 0;
                let job_state = if is_done_v { "DONE"; } else { verdict; };
                let pr_url = if is_done_v { substring(verdict, 5, len(verdict)); } else { ""; };

                if job_state == "DONE" {
                    // #1185: mark drafted only now that the PR opened. LAUNCHED /
                    // RUNNING / NO_EDITS / ERROR all leave the markers unset so
                    // the next tick re-polls (or retries) the same issue.
                    // #1356: the launcher reports RAW facts now; the verdict
                    // resolution (above) folded the PR URL into pr_url from the
                    // RESULT= token. Clear the now-consumed job dir so a future
                    // re-draft relaunches cleanly (was the launcher's job). In the
                    // AG-loop path ag_edit_step already cleared it; clear_job_dir
                    // is idempotent on a missing dir.
                    clear_job_dir(issue_iid);
                    memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_iid"), first_iid_str);
                    memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_updated_at"), first_upd);
                    print("[code_writer] Opened PR via detached checkout-edit for issue", draft.issue_id, ":", pr_url);
                    emit("implementation:mr_ready", draft);
                    if len(owner) > 0 {
                        learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "success", ["acted", "implementation", repo_tag(owner, repo)]);
                    } else {
                        learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "success", ["acted", "implementation"]);
                    };
                    // #1453 Wave 1: reality-check — stash the pending verdict
                    // now that the detached edit job confirmed an MR opened;
                    // evaluate_code_verdict (top of tick_for_repo) scores the
                    // fix/issue-<iid> branch's fate on later ticks.
                    record_code_verdict(owner, repo, draft.issue_id);
                } else {
                    if job_state == "LAUNCHED" {
                        print("[code_writer] Launched detached checkout-edit for issue", draft.issue_id, "— will poll next tick");
                    } else {
                        if job_state == "RUNNING" {
                            print("[code_writer] Detached checkout-edit still running for issue", draft.issue_id, "— will poll next tick");
                        } else {
                            if job_state == "NO_EDITS" {
                                // #1350: a terminal failure that opened no MR. Clear
                                // the #200 staleness markers (defensively — the
                                // autonomous path only sets them on DONE) so the
                                // next tick re-drafts instead of stranding the issue.
                                // #1356: also clear the consumed job dir so the
                                // relaunch starts fresh (was the launcher's poll job).
                                clear_job_dir(issue_iid);
                                memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_iid"), "");
                                memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_updated_at"), "");
                                print("[code_writer] Detached checkout-edit produced no edits for issue", draft.issue_id, "— cleared draft markers, will retry");
                            } else {
                                // #1356: terminal ERROR — job-died (running pid gone),
                                // done-without-url, job-failed, or a stale/half-written
                                // dir, all folded here by job_decide. Same job-dir +
                                // marker clear so the next tick retries. On the default
                                // path job_raw carries the raw STATUS=.. PID_ALIVE=..
                                // line for diagnosis; on the AG path ag_edit_step logged
                                // its own detail and job_raw is "" (verdict = "ERROR").
                                clear_job_dir(issue_iid);
                                memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_iid"), "");
                                memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_updated_at"), "");
                                print("[code_writer] Detached checkout-edit error for issue", draft.issue_id, ":", job_raw, verdict, "— cleared draft markers, will retry");
                            };
                        };
                    };
                };
            } else {
                if my_tier == "review-gated" {
                    // Non-terminal draft: post the implementation plan as a comment
                    // on the issue so a human can approve before we create a branch
                    // and commit code. No branch or commit at this tier.
                    let note = "[draft-impl] **Implementation Plan** (automated, pending approval)\n\nBranch: `" + draft.branch_name + "`\n\n" + draft.summary + "\n\nFiles:\n" + draft.files;
                    // colony-lint: safe-exec-concat
                    let post_cmd = "$COLONY_DIR/scripts/forge-api.sh add-note " + to_string(draft.issue_id) + " --body " + shell_escape(note) + repo_arg(owner, repo);
                    try { exec sh post_cmd; } catch e {
                        print("[code_writer] Failed to post draft plan:", e);
                    };
                    emit("implementation:code_draft", draft);
                    if len(owner) > 0 {
                        learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "partial", ["implementation", "review-gated", repo_tag(owner, repo)]);
                    } else {
                        learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "partial", ["implementation", "review-gated"]);
                    };
                } else {
                    if my_tier == "propose" {
                        emit("implementation:code_draft", draft);
                        if len(owner) > 0 {
                            learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "partial", ["emitted", "implementation", repo_tag(owner, repo)]);
                        } else {
                            learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "partial", ["emitted", "implementation"]);
                        };
                    } else {
                        print("[code_writer] Observing (tier:", my_tier, ")");
                        if len(owner) > 0 {
                            learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "partial", ["observed", "implementation", repo_tag(owner, repo)]);
                        } else {
                            learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "partial", ["observed", "implementation"]);
                        };
                    };
                };
                // #1185: for the review-gated / propose / shadow paths the
                // draft comment / emit IS the terminal action and it has just
                // run, so mark drafted now to preserve their per-tick
                // idempotency (they must not re-post / re-emit every tick).
                // The autonomous path deliberately does NOT fall through here
                // — it sets the markers only after commit-files succeeds.
                memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_iid"), first_iid_str);
                memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_updated_at"), first_upd);
            };
        };
        // #1370 (B3): record the input fingerprint of the top assigned issue we
        // saw THIS tick, at the END of the tick regardless of tier and
        // regardless of whether we drafted/skipped. The next tick's
        // input_unchanged early-return reads it. Written unconditionally here
        // (not only on a completed action) so the early-return is robust even
        // when the #1185 completion markers are deliberately left unset
        // (LAUNCHED/RUNNING). An external edit bumps updated_at -> re-triggers.
        memo_write(scoped_memo(owner, repo, "code_writer:last_seen_iid"), first_iid_str);
        memo_write(scoped_memo(owner, repo, "code_writer:last_seen_updated_at"), first_upd);
    };

    // 3. Listen for routing suggestions from triage colony
    let routed = listen("triage:route_suggestion", 100);
    if len(to_string(routed)) > 5 {
        print("[code_writer] Received routing suggestion, will check assigned issues on next tick");
    };

    let now = now_iso();
    if len(now) > 0 {
        memo_write(scoped_memo(owner, repo, "code_writer:last_check"), now);
    };
}

// Recursive iterator over `iter-repos.sh` output. See router.ag for the
// empty-owner sentinel rationale.
fn tick_at(spool: string, line_no: int) -> void {
    // #1358: nth-line read via nth_field (newline sep) — was an inline
    // python3 -c splitlines() one-liner. Out-of-range line_no -> "", which
    // ends the recursion exactly like the old bounds-checked print.
    let line = nth_field(spool, "\n", line_no);
    if len(line) == 0 { return; };
    let owner = repo_field(line, 0);
    let repo = repo_field(line, 1);
    tick_for_repo(owner, repo);
    return tick_at(spool, line_no + 1);
}

fn tick(reason: string) -> void {
    // #316 M3b: per-repo fan-out. See triage/agents/router.ag for the
    // back-compat sentinel pattern and byte-identity rationale.
    let spool = try { exec sh "$COLONY_DIR/../../tools/iter-repos.sh"; } catch e { ""; };
    if len(spool) == 0 {
        return;
    };
    tick_at(spool, 0);
}
