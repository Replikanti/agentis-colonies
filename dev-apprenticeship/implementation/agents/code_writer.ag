// code_writer.ag -- Implementation colony: learns how you write code.
//
// Observes merged MRs to learn naming conventions, architecture patterns,
// idioms, error handling style, and file organization. When an issue is
// assigned for implementation, drafts code matching learned patterns.
//
// Run as daemon: agentis daemon agents/code_writer.ag --colony implementation
// Requires: exec_foreign capability, GITLAB_* env vars

cb 2000;

type CodePatterns {
    mr_count: int,
    naming: string,
    structure: string,
    error_handling: string
}

type CodeDraft {
    issue_id: int,
    branch_name: string,
    title: string,
    files: string,
    summary: string,
    confidence: float
}

// #316 M3b: per-tick fan-out helpers. See triage/agents/router.ag for
// the full rationale. Single-block configs collapse to owner=="" sentinel,
// repo_arg/repo_tag return "", scoped_memo passes the suffix through.

fn repo_arg(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return " --repo " + shell_escape(owner + "/" + repo);
}

fn repo_tag(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return "repo:" + owner + "/" + repo;
}

fn scoped_memo(owner: string, repo: string, suffix: string) -> string {
    if len(owner) == 0 { return suffix; };
    return owner + "__" + repo + ":" + suffix;
}

// #316 M4: per-repo confidence read with legacy fallback. Mirrors the
// runtime tier() builtin's threshold table from ADR-0001 / CLAUDE.md.
// `agent_name` (not `agent`) — `agent` is a reserved keyword in `.ag`.
fn repo_tier(agent_name: string, owner: string, repo: string) -> string {
    let raw = if len(owner) == 0 {
        recall_latest(agent_name + ":confidence");
    } else {
        let scoped = recall_latest(scoped_memo(owner, repo, agent_name + ":confidence"));
        if len(scoped) > 0 { scoped; } else { recall_latest(agent_name + ":confidence"); };
    };
    if len(raw) == 0 { return "dormant"; };
    let c = parse_float(raw);
    if c >= 0.95 { return "autonomous"; };
    if c >= 0.8  { return "review-gated"; };
    if c >= 0.6  { return "propose"; };
    if c >= 0.4  { return "shadow"; };
    return "dormant";
}

// #1358: nth 0-based sep-delimited field of `s`, walked natively with
// index_of/substring — `.ag` v1.7 has no split(s, sep) builtin, so this
// recursive walk is the workaround (a general split(s, sep) -> list<string>
// builtin is a candidate upstream agentis-core language ask). Serves both the
// tab-separated iter-repos records (repo_field) and tick_at's newline-split
// spool reader. Total: out-of-range / negative n -> "", mirroring the
// bounds-checked python one-liner it replaces.
fn nth_field(s: string, sep: string, n: int) -> string {
    if n < 0 { return ""; };
    if len(s) == 0 { return ""; };
    let p = index_of(s, sep);
    if n == 0 {
        if p < 0 { return s; };
        return substring(s, 0, p);
    };
    if p < 0 { return ""; };
    return nth_field(substring(s, p + len(sep), len(s)), sep, n - 1);
}

// #1358: tab-separated field read, now native via nth_field (was an inline
// python3 -c split). Total: missing field / out-of-range idx -> "".
fn repo_field(line: string, idx: int) -> string {
    return nth_field(line, "\t", idx);
}

// #1214/#1356: code-edit-job.sh prints ONE raw line. On a fresh launch it is
// the bare keyword `LAUNCHED`; when the global concurrency cap deferred the
// launch (no job dir created) it is `RUNNING`; when polling an existing job dir
// it is `STATUS=<s> PID_ALIVE=<0|1> RESULT=<url>` — RAW facts, no decision. The
// running/done/no_edits/error/job-died FSM that used to live in the launcher's
// case block now lives here in job_decide (below, after pr_check_token, whose
// KEY=<v> token reader it reuses). job_word returns the leading whitespace token
// (`LAUNCHED` / `RUNNING` / `STATUS=<s>`) — enough for job_decide to tell the two
// launch-path sentinels from a poll line. Native since #1358 (was an inline
// python3 -c): the leading token is everything before the first space, cut
// again at a newline in case a garbled multi-line blob slipped through.
// Total: missing/garbled input -> "".
fn job_word(out: string) -> string {
    let head = nth_field(out, " ", 0);
    let nl = index_of(head, "\n");
    if nl < 0 { return head; };
    return substring(head, 0, nl);
}

// #1172: pull the primary file path out of `draft.files` (a markdown list of
// "file path + what each does" lines). We fetch the existing content of that
// one file so the code-gen prompt can EDIT it rather than clobber it. Multi-
// file extraction in `.ag` is impractical, so we deliberately fetch only the
// first/primary path; a from-scratch fallback still applies to the rest. The
// helper scans for the first backtick-quoted token (the draft prompt tends to
// wrap paths in backticks); failing that, the first slash-or-dot-bearing token
// on the first list line. Returns "" when nothing path-shaped is found.
fn primary_file_path(files: string) -> string {
    let cmd = "F=" + shell_escape(files) +
        " python3 -c 'import os,re,sys" +
        "\nt=os.environ[\"F\"]" +
        "\nm=re.search(r\"`([^`]+)`\", t)" +
        "\nif m:" +
        "\n    print(m.group(1).strip()); sys.exit(0)" +
        "\nfor ln in t.splitlines():" +
        "\n    s=ln.lstrip(\"-*0123456789. \\t\")" +
        "\n    for tok in re.split(r\"[\\s:,]+\", s):" +
        "\n        if (\"/\" in tok or \".\" in tok) and len(tok)>2:" +
        "\n            print(tok.strip()); sys.exit(0)" +
        "\nprint(\"\")'";
    let out = try { exec sh cmd; } catch e { ""; };
    return out;
}

// #1195: deterministically turn (existing content, LLM search/replace edits)
// into the `--actions` JSON commit-files expects, WITHOUT the LLM ever having
// to emit the full file. tools/apply-edits.py reads the original content on
// stdin and the edits JSON from $APPLY_EDITS, replaces each edit's old_str
// (which must be an EXACT, unique substring) and prints the new full content;
// we then json.dumps a single-element [{action:"update", file_path, content}]
// array. Large values (the fetched file + the edits) ride env vars / a pipe
// fed by `printf` (a shell builtin), never argv, so ARG_MAX never bites. If
// apply-edits.py exits non-zero (mangled / ambiguous / missing old_str — the
// flat-cyborg screen-scrape corruption guard) the whole `exec sh` exits
// non-zero and the caller's `try` collapses to "" => treated as a failed
// code-gen, no commit. `path` is shell_escape'd; `orig` and `edits` are passed
// as env vars so the body itself carries no untrusted concatenation.
fn apply_edits_to_actions(path: string, orig: string, edits: string) -> string {
    // colony-lint: safe-exec-concat
    let cmd = "ORIG=" + shell_escape(orig) + " APPLY_EDITS=" + shell_escape(edits) +
        " FP=" + shell_escape(path) +
        " python3 -c 'import os,sys,subprocess,json" +
        "\ntools=os.path.join(os.environ[\"COLONY_DIR\"], \"..\", \"..\", \"tools\", \"apply-edits.py\")" +
        "\np=subprocess.run([sys.executable, tools], input=os.environ[\"ORIG\"], capture_output=True, text=True, env=os.environ)" +
        "\nif p.returncode != 0:" +
        "\n    sys.stderr.write(p.stderr); sys.exit(1)" +
        "\nprint(json.dumps([{\"action\": \"update\", \"file_path\": os.environ[\"FP\"], \"content\": p.stdout}]))'";
    let out = try { exec sh cmd; } catch e { ""; };
    return out;
}

// #1208: render a line-NUMBERED view of the file content for the edit prompt.
// Each line gets an `N|` prefix (N = 1-based line number) so the LLM can name
// line-range edits without ever reproducing exact source bytes (the markdown
// `**`-drop failure mode of the search/replace path). The UN-numbered content
// rides $C (env var, off-argv) so ARG_MAX never bites; splitlines() keepends is
// not needed here because the numbered view is a display artifact, not content.
fn numbered_view(content: string) -> string {
    // colony-lint: safe-exec-concat
    let cmd = "C=" + shell_escape(content) +
        " python3 -c 'import os,sys" +
        "\ntext=os.environ[\"C\"]" +
        "\nlines=text.splitlines()" +
        "\nsys.stdout.write(\"\\n\".join(\"%d|%s\" % (i+1, ln) for i,ln in enumerate(lines)))'";
    let out = try { exec sh cmd; } catch e { ""; };
    return out;
}

// #1208: deterministically turn (existing UN-numbered content, LLM line-range
// edits) into the `--actions` JSON commit-files expects, WITHOUT the LLM ever
// reproducing source bytes. tools/apply-line-edits.py reads the original content
// on stdin and the edits JSON from $LINE_EDITS ([{start_line,end_line,new_text}],
// 1-based inclusive; empty new_text deletes), validates 1<=start<=end<=nlines and
// NON-OVERLAPPING, applies descending-by-start so earlier replacements don't shift
// later ranges, and prints the new full content; we then json.dumps a single
// [{action:"update", file_path, content}] array. Large values (fetched file +
// edits) ride env vars / a pipe (`printf`, a shell builtin), never argv. If
// apply-line-edits.py exits non-zero (out-of-bounds / overlapping — the
// validation guard) the whole `exec sh` exits non-zero and the caller's `try`
// collapses to "" => treated as a failed code-gen, no commit. `path` is
// shell_escape'd; `orig` and `edits` are passed as env vars so the body itself
// carries no untrusted concatenation.
fn apply_line_edits_to_actions(path: string, orig: string, edits: string) -> string {
    // colony-lint: safe-exec-concat
    let cmd = "ORIG=" + shell_escape(orig) + " LINE_EDITS=" + shell_escape(edits) +
        " FP=" + shell_escape(path) +
        " python3 -c 'import os,sys,subprocess,json" +
        "\ntools=os.path.join(os.environ[\"COLONY_DIR\"], \"..\", \"..\", \"tools\", \"apply-line-edits.py\")" +
        "\np=subprocess.run([sys.executable, tools], input=os.environ[\"ORIG\"], capture_output=True, text=True, env=os.environ)" +
        "\nif p.returncode != 0:" +
        "\n    sys.stderr.write(p.stderr); sys.exit(1)" +
        "\nprint(json.dumps([{\"action\": \"update\", \"file_path\": os.environ[\"FP\"], \"content\": p.stdout}]))'";
    let out = try { exec sh cmd; } catch e { ""; };
    return out;
}

fn merged_mr_cmd(owner: string, repo: string) -> string {
    let ts = recall_latest(scoped_memo(owner, repo, "code_writer:last_check"));
    // colony-lint: safe-exec-concat
    if len(ts) > 0 {
        return "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --since " + shell_escape(ts) + " --view impl" + repo_arg(owner, repo);
    };
    // #1185: first run has no `last_check`, so without a bound the no-since
    // query learns from the WHOLE merged-MR history — one prompt() per MR per
    // tick, starving the drafting step on a mature repo. Bound the first run to
    // the single most recent merged MR via --per-page 1 (both forge backends
    // sort by updated_at desc and accept --per-page). The should_learn_from_mr
    // memo gate still caps learning at at-most-once per distinct MR iid; this
    // just stops the very first tick from fanning out across the full backlog.
    // colony-lint: safe-exec-concat
    return "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --per-page 1 --view impl" + repo_arg(owner, repo);
}

// #291: the forge wrappers' assigned-issues* subcommands gate on BOTH the
// trigger label AND the assignee by default. On most repos labeled issues
// are unassigned until a contributor picks them up, so the action path
// never fires. start-colony.sh seeds code_writer:require_assignee from
// [implementation].require_assignee (new default false); here we turn that
// into the --include-unassigned flag when the operator has opted in to the
// label-alone trigger.
fn include_unassigned_flag() -> string {
    let raw = recall_latest("code_writer:require_assignee");
    if raw == "false" {
        return " --include-unassigned";
    };
    return "";
}

fn get_confidence() -> float {
    let raw = recall_latest("code_writer:confidence");
    if len(raw) > 0 {
        return parse_float(raw);
    };
    return 0.0;
}

// #200: skip the LLM draft when the top assigned issue hasn't changed
// since our last run. `assigned-issues` has no --since filter server-side,
// so without this gate the draft prompt re-fires every tick as long as
// any issue remains assigned, re-paying the LLM cost for identical
// input. Gate on (iid, updated_at) so that issue edits (title,
// description, labels — anything that bumps updated_at) trigger a
// fresh draft.
fn should_draft_code(owner: string, repo: string, iid_str: string, upd: string) -> bool {
    // Malformed GitLab payload (missing iid) would otherwise collapse
    // all drafts into the shared "void" memo slot. Skip entirely — we
    // have nothing to gate on, and the next tick will re-poll.
    if iid_str == "void" {
        return false;
    };
    if len(iid_str) == 0 {
        return false;
    };
    // #1277: a projection that drops/nulls updated_at renders it as "void".
    // If we let a stored ("void") marker match a freshly-seen "void" the gate
    // short-circuits forever and the issue is starved (observed live on #1266,
    // which never produced a PR). The projection fix (restore updated_at to the
    // `assigned` view) is the primary cure; this guard is the belt-and-braces:
    // treat a void updated_at as ALWAYS stale so a future projection regression
    // degrades to "redraft every tick" instead of "never redraft again".
    // Mirrors the iid_str == "void" guard above.
    if upd == "void" {
        return true;
    };
    let last_iid = recall_latest(scoped_memo(owner, repo, "code_writer:last_drafted_iid"));
    if len(last_iid) == 0 {
        return true;
    };
    if iid_str != last_iid {
        return true;
    };
    let last_upd = recall_latest(scoped_memo(owner, repo, "code_writer:last_drafted_updated_at"));
    if upd != last_upd {
        return true;
    };
    return false;
}

// #1370 (B3): tier-independent input fingerprint. Unlike the #200/#1185
// completion markers (last_drafted_*), which are written ONLY after a
// per-tier terminal action completes, this fingerprint is written at the END
// of EVERY tick regardless of tier (and regardless of job poll-state). It
// records the (iid, updated_at) of the top assigned issue we last *saw*, so a
// tier-independent early-return can skip re-prompting an unchanged,
// already-handled issue every tick. It NEVER starves: an EXTERNAL edit,
// re-assignment, or any change that bumps updated_at flips this to false and
// re-triggers a fresh draft. The early-return that consumes it is additionally
// guarded by has_mr_for_branch, so an MR-less branch (a launched job that died
// without opening an MR — the #1363 rescue) is never suppressed.
fn input_unchanged(owner: string, repo: string, iid_str: string, upd: string) -> bool {
    if iid_str == "void" {
        return false;
    };
    if len(iid_str) == 0 {
        return false;
    };
    let seen_iid = recall_latest(scoped_memo(owner, repo, "code_writer:last_seen_iid"));
    if len(seen_iid) == 0 {
        return false;
    };
    if iid_str != seen_iid {
        return false;
    };
    let seen_upd = recall_latest(scoped_memo(owner, repo, "code_writer:last_seen_updated_at"));
    return upd == seen_upd;
}

// #1350: scan a raw merge-requests list JSON for an MR whose `source_branch`
// equals BR. Returns "1" on a match, "0" otherwise. The raw JSON rides $J
// (env var, off-argv) so ARG_MAX never bites. Total: malformed JSON / missing
// field / non-list all collapse to "0".
fn raw_list_has_branch(raw: string, branch: string) -> bool {
    let cmd = "J=" + shell_escape(raw) + " BR=" + shell_escape(branch) +
        " python3 -c 'import os,json,sys" +
        "\ntry:" +
        "\n    d=json.loads(os.environ[\"J\"])" +
        "\nexcept Exception:" +
        "\n    print(\"0\"); sys.exit(0)" +
        "\nbr=os.environ[\"BR\"]" +
        "\nif not isinstance(d,list):" +
        "\n    print(\"0\"); sys.exit(0)" +
        "\nfor it in d:" +
        "\n    if isinstance(it,dict) and it.get(\"source_branch\")==br:" +
        "\n        print(\"1\"); sys.exit(0)" +
        "\nprint(\"0\")'";
    let out = try { exec sh cmd; } catch e { ""; };
    return out == "1";
}

// #1259: split a (possibly CSV) planning:labels:epic vocab and OR the exact-
// quoted match across its tokens, restoring CSV parity with task_decomposer.ag
// (which splices the same vocab whole into an LLM prompt that CAN split it —
// the two consumers diverged for multi-token configs like "epic, big-feature").
// A single-token vocab ("epic", the shipped default) matches exactly as before.
// Each token is JSON-quoted (chr(34)+t+chr(34) => "<token>") before the substring
// test, preserving the anti-false-match property: an "epic-foo" label lacks the
// closing quote so it still can't match. ISSUE_DETAIL + VOCAB ride env vars
// (off-argv, so ARG_MAX never bites). Total: a malformed/empty vocab or no token
// match collapses to "0" => false (a missed auto-decompose is the safe failure).
fn is_epic_match(issue_detail: string, epic_vocab: string) -> bool {
    let cmd = "D=" + shell_escape(issue_detail) + " V=" + shell_escape(epic_vocab) +
        " python3 -c 'import os,sys" +
        "\nd=os.environ[\"D\"]" +
        "\nv=os.environ[\"V\"]" +
        "\nfor t in v.split(\",\"):" +
        "\n    t=t.strip()" +
        "\n    if t and chr(34)+t+chr(34) in d:" +
        "\n        print(\"1\"); sys.exit(0)" +
        "\nprint(\"0\")'";
    let out = try { exec sh cmd; } catch e { ""; };
    return out == "1";
}

// #1350: does an open OR merged MR already exist for this issue's deterministic
// fix/issue-<iid> branch? The #200 staleness markers (last_drafted_iid /
// _updated_at) record "we drafted once", NOT "an MR landed", so a detached edit
// job that dies without opening an MR (NO_EDITS / error / killed session) leaves
// the issue stranded: should_draft_code short-circuits until the issue's
// updated_at changes, yet no MR exists. Gating on actual completion fixes that —
// the draft path re-fires whenever this returns false regardless of the markers.
// Queries the RAW (no --view) opened then merged lists — the raw GitLab shape
// carries source_branch, which the `impl` view drops (same reason recover_red_prs
// reads raw). A void/empty iid has no branch to key on, so we report true
// (suppress the forced re-draft, mirroring should_draft_code's void guard).
// A poll that errors collapses to "" => no branch match, so a transient forge
// outage biases toward a (harmless, pid-guarded) re-draft attempt rather than
// silently stranding the issue.
fn has_mr_for_branch(owner: string, repo: string, iid_str: string) -> bool {
    if iid_str == "void" { return true; };
    if len(iid_str) == 0 { return true; };
    let branch = "fix/issue-" + iid_str;
    // colony-lint: safe-exec-concat
    let opened_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state opened" + repo_arg(owner, repo);
    let opened_raw = try { exec sh opened_cmd; } catch e { ""; };
    if raw_list_has_branch(opened_raw, branch) { return true; };
    // colony-lint: safe-exec-concat
    let merged_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged" + repo_arg(owner, repo);
    let merged_raw = try { exec sh merged_cmd; } catch e { ""; };
    return raw_list_has_branch(merged_raw, branch);
}

// #239: learn from each merged MR at most once per daemon lifetime.
// Without this gate, the `merge-requests --since <last_check>` query
// keeps returning the same MR at index [0] as long as its `updated_at`
// keeps getting bumped (new comments, pipeline events, label changes),
// so the learning-path prompt re-fires every tick at cb_budget 2000 —
// hundreds of duplicate `Learned from MR <N>` log entries and an
// OOM-class load on long-lived MRs. Single-key memo, no TTL: we want
// at-most-once per distinct MR iid.
fn should_learn_from_mr(owner: string, repo: string, mr_iid: int) -> bool {
    if mr_iid <= 0 {
        return false;
    };
    let iid_str = to_string(mr_iid);
    let last_iid = recall_latest(scoped_memo(owner, repo, "code_writer:last_learned_mr_iid"));
    if len(last_iid) == 0 {
        return true;
    };
    if iid_str != last_iid {
        return true;
    };
    return false;
}

// #1332: red-PR recovery helpers. The federation opens PRs and (#1317)
// auto-merges green ones, but had NO reaction to a RED CI: when code_writer's
// edit job exhausts its local verify budget it commits anyway ("CI is the
// backstop"), and the then-red PR sits forever (the merge gate refuses it; the
// draft path won't re-touch the issue due to its last_drafted_iid staleness
// gate). These helpers add the missing fix-if-red edge. The CI gate IS the
// local verify gate (colony-lint), so recovery re-drives the edit job on the
// EXISTING branch with the verify-and-fix loop (which reproduces the failure
// locally and iterates) — it never needs to fetch CI logs.

// open_pr_field: extract [idx].<field> (a scalar string) from the open-PR
// list JSON — native json_get since #1358 (was an inline python3 -c), the
// idiom the code-review agents already use for `[0].iid`. to_string() of a
// Void json_get (missing index / field / null / malformed JSON) renders as
// "void", collapsed to "" here so callers keep the empty-means-missing
// contract (recover_scan / resolve_review_scan terminate on len()==0).
fn open_pr_field(raw: string, idx: int, field: string) -> string {
    let v = to_string(json_get(raw, "[" + to_string(idx) + "]." + field));
    if v == "void" { return ""; };
    return v;
}

// pr_check_token: pull the value of KEY out of a `STATUS=<x> REF=<y>` line (the
// forge mr-pipeline-status verb output) — native index_of/substring scan since
// #1358 (was an inline python3 -c). The KEY= marker must sit at a token start
// (position 0 or right after a space) so a key that is a suffix of another
// token (XRESULT= vs RESULT=) can't false-match — the startswith property of
// the old per-token loop. The value runs to the next space (or newline, for a
// garbled multi-line blob). Total: "".
fn pr_check_token(out: string, key: string) -> string {
    let marker = key + "=";
    // len(out) is the not-found sentinel (avoids a negative literal).
    let at = if index_of(out, marker) == 0 {
        0;
    } else {
        let mid = index_of(out, " " + marker);
        if mid < 0 { len(out); } else { mid + 1; };
    };
    if at >= len(out) { return ""; };
    let rest = substring(out, at + len(marker), len(out));
    let sp = index_of(rest, " ");
    let tok = if sp < 0 { rest; } else { substring(rest, 0, sp); };
    let nl = index_of(tok, "\n");
    if nl < 0 { return tok; };
    return substring(tok, 0, nl);
}

// #1356: the poll-time FSM code-edit-job.sh used to own. The launcher now
// prints ONE raw line and decides NOTHING; job_decide interprets it into the
// vocabulary the autonomous draft-poll branch (and the recover paths) already
// switch on. It reuses pr_check_token's KEY=<v> reader (a poll line is
// `STATUS=<s> PID_ALIVE=<0|1> RESULT=<url>`) and job_word for the two bare
// launch-path sentinels. Mapping (mirrors the old launcher case block, per its
// header):
//   LAUNCHED                      -> "LAUNCHED"  (fresh detached launch)
//   RUNNING                       -> "RUNNING"   (cap-deferred; no job dir yet)
//   STATUS=running PID_ALIVE=1 .. -> "RUNNING"   (orchestrator still alive)
//   STATUS=running PID_ALIVE=0 .. -> "ERROR"     (job-died: pid gone, no terminal status)
//   STATUS=done   RESULT=<url>    -> "DONE"      (PR URL read via job_rest)
//   STATUS=done   RESULT=<empty>  -> "ERROR"     (done-without-url)
//   STATUS=no_edits ..            -> "NO_EDITS"
//   STATUS=error  ..              -> "ERROR"     (job-failed)
//   STATUS=none / unknown         -> "ERROR"     (stale/half-written dir)
// Total: a missing/garbled line collapses through job_word "" -> the ERROR
// (retry) branch, the safe failure (clears markers + job dir, re-drafts).
fn job_decide(out: string) -> string {
    let w = job_word(out);
    if w == "LAUNCHED" { return "LAUNCHED"; };
    if w == "RUNNING" { return "RUNNING"; };
    let status = pr_check_token(out, "STATUS");
    if status == "running" {
        if pr_check_token(out, "PID_ALIVE") == "1" { return "RUNNING"; };
        return "ERROR";
    };
    if status == "done" {
        if len(pr_check_token(out, "RESULT")) > 0 { return "DONE"; };
        return "ERROR";
    };
    if status == "no_edits" { return "NO_EDITS"; };
    return "ERROR";
}

// #1356: the PR URL from a DONE poll line — the RESULT= token. Empty for any
// non-DONE line. Reuses pr_check_token's KEY=<v> reader.
fn job_rest(out: string) -> string {
    return pr_check_token(out, "RESULT");
}

// #1356: clear the per-issue job dir once the poll FSM reaches a terminal state
// (DONE / NO_EDITS / ERROR). This cleanup used to live in the launcher's poll
// path; it moved here with the decision logic so code-edit-job.sh stays a dumb
// reporter that never deletes the dir. Path mirrors the launcher exactly:
// <FED_DIR>/.agentis/jobs/<colony>/issue-<iid>, with FED_DIR=$COLONY_DIR/.. and
// colony=$(basename "$COLONY_DIR"). The iid rides $IID
// (off-argv, shell_escape'd); a void/empty iid is a no-op (nothing safe to key
// on). rm -rf is total on a missing dir, so the catch is effectively dead.
fn clear_job_dir(iid_str: string) -> void {
    if len(iid_str) == 0 { return; };
    if iid_str == "void" { return; };
    let cmd = "IID=" + shell_escape(iid_str) +
        "; rm -rf \"$COLONY_DIR/../.agentis/jobs/$(basename \"$COLONY_DIR\")/issue-$IID\"";
    try { exec sh cmd; } catch e {
        print("[code_writer] job-dir cleanup failed for issue", iid_str, ":", e);
    };
}

// ci_state: classify a raw CI status word (the mr-pipeline-status verb's STATUS
// token) into the red/green/pending vocabulary the recovery loops branch on.
// This is the classification that lived inside gitlab-api.sh/github-api.sh
// pr-checks before #1355 moved the reasoning out of the thin forge wrapper:
// failed/canceled => red, success => green, everything else (running, pending,
// created, …, or "" when the MR has no pipeline yet) => pending — CI not
// verified yet, so never race it. GitHub's backend pre-reduces its check-runs to
// the same success|failed|pending vocabulary, so this classifier is forge-agnostic.
fn ci_state(status: string) -> string {
    if status == "failed" { return "red"; };
    if status == "canceled" { return "red"; };
    if status == "cancelled" { return "red"; };
    if status == "success" { return "green"; };
    return "pending";
}

// recover_attempts: how many recovery re-drives we have already launched for
// this PR (read from the ci_fix:attempts:<iid> memo). Missing => 0.
fn recover_attempts(owner: string, repo: string, iid_str: string) -> int {
    let raw = recall_latest(scoped_memo(owner, repo, "ci_fix:attempts:" + iid_str));
    if len(raw) == 0 { return 0; };
    return parse_int(raw);
}

// recover_at: process the open PR at index `idx`. Returns 1 if it LAUNCHED a
// recovery re-drive (the caller then returns for this tick — one job per tick,
// do not also draft), 0 otherwise (skip + keep scanning). Own PRs only: the
// head branch must start `fix/issue-` (the federation's own). Acts only on
// a red state, never pending (don't race CI). Retry cap 2 per PR via the
// ci_fix:attempts:<iid> memo; after that, give up + log (needs human).
fn recover_at(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    if iid_str == "void" { return 0; };
    let src = open_pr_field(raw, idx, "source_branch");
    // Own PRs only: never touch a PR we did not open.
    if index_of(src, "fix/issue-") != 0 { return 0; };

    // colony-lint: safe-exec-concat
    let checks_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-pipeline-status " + shell_escape(iid_str) + repo_arg(owner, repo);
    let checks_out = try { exec sh checks_cmd; } catch e { ""; };
    // Classify the raw pipeline status here (was gitlab-api.sh/github-api.sh
    // pr-checks before #1355 thinned the forge wrapper to a raw STATUS read).
    let state = ci_state(pr_check_token(checks_out, "STATUS"));
    // Only act on a confirmed red CI; pending => don't race, green => merge gate.
    if state != "red" { return 0; };

    let attempts = recover_attempts(owner, repo, iid_str);
    if attempts >= 2 {
        print("[code_writer] CI-fix gave up on PR", iid_str, "after 2 attempts — needs human");
        return 0;
    };

    // Bump the attempt memo BEFORE launching so a crash mid-launch still counts
    // against the cap (fail-closed: never exceed 2 re-drives).
    let next_attempt = attempts + 1;
    memo_write(scoped_memo(owner, repo, "ci_fix:attempts:" + iid_str), to_string(next_attempt));

    // Re-drive the PR's ACTUAL head branch (source_branch), NOT a branch
    // reconstructed from the PR number: a PR for issue N has its own PR number
    // M != N, so "fix/issue-" + <PR iid> would target a non-existent branch.
    // `src` was already validated to start with "fix/issue-" (own-PRs guard).
    let branch_name = src;
    let recover_title = "fix: recover CI for #" + iid_str;
    let recover_task = "The CI gate (colony-lint) is failing on this PR. Reproduce the failure locally, fix it with a MINIMAL change, and do not touch unrelated code.";
    // colony-lint: safe-exec-concat
    let job_cmd = "$COLONY_DIR/../../tools/code-edit-job.sh --owner " + shell_escape(owner) + " --repo " + shell_escape(repo) + " --issue " + shell_escape(iid_str) + " --branch " + shell_escape(branch_name) + " --title " + shell_escape(recover_title) + " --task " + shell_escape(recover_task) + " --recover";
    let job_out = try { exec sh job_cmd; } catch e {
        print("[code_writer] CI-fix launcher failed for PR", iid_str, ":", e);
        "";
    };
    let job_state = job_word(job_out);
    if job_state == "DONE" {
        print("[code_writer] CI-fix pushed a fix to red PR", iid_str, "(attempt", next_attempt, "/2)");
    } else {
        print("[code_writer] re-driving red PR", iid_str, "(attempt", next_attempt, "/2)");
    };
    // One recovery job per tick: signal the caller to return without drafting.
    // The launcher's pid check gives idempotency so a re-poll won't double-launch.
    return 1;
}

// recover_scan: recurse over the open-PR list, launching at most ONE recovery
// re-drive per tick. Returns 1 once a job is launched (stop scanning), else 0.
fn recover_scan(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    let did = recover_at(owner, repo, raw, idx);
    if did == 1 { return 1; };
    return recover_scan(owner, repo, raw, idx + 1);
}

// recover_red_prs: list the federation's own open PRs and, at the autonomous
// tier only, re-drive the FIRST red one whose head is a fix/issue- branch we
// opened. Returns 1 if it launched a recovery job (the caller returns for this
// tick — one job per tick, do not also draft).
fn recover_red_prs(owner: string, repo: string) -> int {
    // Autonomous-only: re-pushing to PRs is a terminal write.
    if repo_tier("code_writer", owner, repo) != "autonomous" { return 0; };
    // Raw (no --view): the normalized GitLab-shape list carries both `iid` and
    // `source_branch`, the two fields recover_at needs. The implementation
    // colony's `impl` view drops source_branch, so we read the raw shape here.
    // colony-lint: safe-exec-concat
    let list_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state opened" + repo_arg(owner, repo);
    let raw = try { exec sh list_cmd; } catch e { ""; };
    if len(raw) < 5 { return 0; };
    return recover_scan(owner, repo, raw, 0);
}

// #1360: review-finding recovery helpers (the review-resolver pattern). The
// federation re-drives a RED PR (recover_red_prs), but a GREEN PR carrying
// actionable review findings — the code-review colony's request_changes summary
// (approval_decider's `**Review Summary** (automated)` note / the
// `[draft-review-decision] ... request_changes` draft) or a human review note —
// just sat until a human manually triggered a --recover. These helpers add the
// missing implement->review->fix edge, a near-exact structural mirror of the
// red-CI path but triggered by a durable review NOTE instead of a red CI state. The
// signal is the durable forge note (polled here, exactly as recover_at polls
// mr-pipeline-status), NOT the ephemeral colony bus: the reviewers emit on sub-second
// listen() windows on an independent schedule, so a cross-daemon emit is almost
// never caught. Idempotency is the note-id watermark (review_fix:last_note:<iid>)
// plus the hard cap (review_fix:attempts:<iid>, cap 2 — identical to recover_at).

// review_fix_attempts: how many review-fix re-drives we have already launched for
// this PR (read from the review_fix:attempts:<iid> memo). Missing => 0. Mirrors
// recover_attempts.
fn review_fix_attempts(owner: string, repo: string, iid_str: string) -> int {
    let raw = recall_latest(scoped_memo(owner, repo, "review_fix:attempts:" + iid_str));
    if len(raw) == 0 { return 0; };
    return parse_int(raw);
}

// bot_username: the federation's own forge username (memo `gitlab:me`, seeded by
// install.sh — the same memo style_reviewer reads). Lets actionable_note tell a
// human review note from the federation's own notes. Empty when unseeded, which
// actionable_note treats fail-safe (only the federation's own request_changes /
// draft markers stay actionable, never a bare author mismatch).
fn bot_username() -> string {
    return recall_latest("gitlab:me");
}

// actionable_note: scan the mr-notes JSON (on $J, off-argv) for the most-recent
// (highest `id`) ACTIONABLE note, given the bot username on $ME. A note is
// actionable when it is non-system AND either (a) authored by a human
// (author.username != $ME, and $ME is non-empty) or (b) the federation's own
// request_changes verdict — body starts `**Review Summary** (automated)` (the
// autonomous post) or contains both `[draft-review-decision]` and
// `request_changes` (the review-gated draft). Plain reviewer comments, approvals,
// and clean reviews are NOT actionable. Prints a tab-joined record
// `<max_note_id>\t<concatenated actionable bodies>` (tabs in bodies collapsed to
// spaces so the record stays two fields) or "" when none / malformed JSON.
fn actionable_note(raw: string, me: string) -> string {
    let cmd = "J=" + shell_escape(raw) + " ME=" + shell_escape(me) +
        " python3 -c 'import os,json,sys" +
        "\ntry:" +
        "\n    d=json.loads(os.environ[\"J\"])" +
        "\nexcept Exception:" +
        "\n    print(\"\"); sys.exit(0)" +
        "\nif not isinstance(d,list):" +
        "\n    print(\"\"); sys.exit(0)" +
        "\nme=os.environ[\"ME\"]" +
        "\nhits=[]" +
        "\nfor it in d:" +
        "\n    if not isinstance(it,dict):" +
        "\n        continue" +
        "\n    if it.get(\"system\") is True:" +
        "\n        continue" +
        "\n    nid=it.get(\"id\")" +
        "\n    if not isinstance(nid,int):" +
        "\n        continue" +
        "\n    body=it.get(\"body\")" +
        "\n    if not isinstance(body,str):" +
        "\n        continue" +
        "\n    a=it.get(\"author\")" +
        "\n    author=a.get(\"username\") if isinstance(a,dict) else None" +
        "\n    is_human=(me!=\"\" and isinstance(author,str) and author!=me)" +
        "\n    is_req=body.startswith(\"**Review Summary** (automated)\")" +
        "\n    is_draft=(\"[draft-review-decision]\" in body and \"request_changes\" in body)" +
        "\n    if is_human or is_req or is_draft:" +
        "\n        hits.append((nid, body.replace(chr(9), \" \")))" +
        "\nif not hits:" +
        "\n    print(\"\"); sys.exit(0)" +
        "\nmax_id=max(h[0] for h in hits)" +
        "\nbodies=(chr(10)+chr(10)).join(b for _,b in sorted(hits))" +
        "\nsys.stdout.write(str(max_id)+chr(9)+bodies)'";
    let out = try { exec sh cmd; } catch e { ""; };
    return out;
}

// resolve_review_at: process the open PR at index `idx`. Returns 1 if it LAUNCHED
// a review-fix re-drive (caller returns for this tick — one job per tick, do not
// also draft), 0 otherwise. Own PRs only (head branch starts fix/issue-). Acts
// ONLY on STATE=green: red is owned by recover_red_prs (no race), pending => do
// not race CI. Idempotent: re-drives only when the newest actionable note id is
// strictly greater than the review_fix:last_note:<iid> watermark. Retry cap 2 via
// review_fix:attempts:<iid>; after that, give up + log (needs human). Mirrors
// recover_at but keyed on a review note instead of STATE=red.
fn resolve_review_at(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    if iid_str == "void" { return 0; };
    let src = open_pr_field(raw, idx, "source_branch");
    // Own PRs only: never touch a PR we did not open.
    if index_of(src, "fix/issue-") != 0 { return 0; };

    // colony-lint: safe-exec-concat
    let checks_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-pipeline-status " + shell_escape(iid_str) + repo_arg(owner, repo);
    let checks_out = try { exec sh checks_cmd; } catch e { ""; };
    // Classify the raw pipeline status here (see recover_at / #1355).
    let state = ci_state(pr_check_token(checks_out, "STATUS"));
    // Act ONLY on a green PR: red is owned by recover_red_prs (avoid the race),
    // pending => don't race CI. The precise inverse of recover_at's red-only guard.
    if state != "green" { return 0; };

    // colony-lint: safe-exec-concat
    let notes_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-notes " + shell_escape(iid_str) + repo_arg(owner, repo);
    let notes_raw = try { exec sh notes_cmd; } catch e { ""; };
    let rec = actionable_note(notes_raw, bot_username());
    if len(rec) == 0 { return 0; };

    let note_id_str = repo_field(rec, 0);
    if len(note_id_str) == 0 { return 0; };
    let note_id = parse_int(note_id_str);
    // Idempotency: re-drive only when a STRICTLY newer actionable note appears.
    // Once we re-drive against the newest finding we never re-drive again until a
    // re-review posts a strictly-newer actionable note (so a satisfied review,
    // which posts no new request_changes note, terminates the loop).
    let last_seen = recall_latest(scoped_memo(owner, repo, "review_fix:last_note:" + iid_str));
    if len(last_seen) > 0 {
        if note_id <= parse_int(last_seen) { return 0; };
    };

    let attempts = review_fix_attempts(owner, repo, iid_str);
    if attempts >= 2 {
        print("[code_writer] review-fix gave up on PR", iid_str, "after 2 attempts — needs human");
        return 0;
    };

    let next_attempt = attempts + 1;

    let bodies = repo_field(rec, 1);
    // Re-drive the PR's ACTUAL head branch (source_branch), validated above to
    // start with fix/issue-. --recover pushes to the existing branch (no new PR);
    // keying --issue on the PR iid shares the per-issue job dir with recover_at so
    // the launcher pid-guard serializes the two paths on one PR.
    let branch_name = src;
    let recover_title = "fix: address review findings on #" + iid_str;
    let recover_task = "Address these code-review findings on this PR with a MINIMAL change; do not touch unrelated code:\n" + bodies;
    // colony-lint: safe-exec-concat
    let job_cmd = "$COLONY_DIR/../../tools/code-edit-job.sh --owner " + shell_escape(owner) + " --repo " + shell_escape(repo) + " --issue " + shell_escape(iid_str) + " --branch " + shell_escape(branch_name) + " --title " + shell_escape(recover_title) + " --task " + shell_escape(recover_task) + " --recover";
    let job_out = try { exec sh job_cmd; } catch e {
        print("[code_writer] review-fix launcher failed for PR", iid_str, ":", e);
        "";
    };
    let job_state = job_word(job_out);
    // Cap-deferred (RUNNING): the CODE_EDIT_MAX_CONCURRENT semaphore was saturated,
    // so the launcher created NO job dir and promised a next-tick re-poll. Skip the
    // watermark/attempts write so re-entry for this note id is NOT blocked — without
    // this guard the watermark would swallow the deferral into the needs-human
    // fallback. Mirrors recover_at, which never consumes budget on a RUNNING defer.
    if job_state == "RUNNING" {
        print("[code_writer] review-fix deferred for PR", iid_str, "(concurrency cap) — will re-poll");
        return 1;
    };
    // Launched (or crashed mid-launch): write the note watermark + bump the attempt
    // memo so a crash still counts (fail-closed: never exceed 2 re-drives, never
    // re-drive the same finding twice).
    memo_write(scoped_memo(owner, repo, "review_fix:last_note:" + iid_str), note_id_str);
    memo_write(scoped_memo(owner, repo, "review_fix:attempts:" + iid_str), to_string(next_attempt));
    if job_state == "DONE" {
        print("[code_writer] review-fix pushed a fix to PR", iid_str, "(attempt", next_attempt, "/2)");
    } else {
        print("[code_writer] re-driving PR", iid_str, "for review findings (attempt", next_attempt, "/2)");
    };
    // One review-fix job per tick: signal the caller to return without drafting.
    // The launcher's pid check gives idempotency so a re-poll won't double-launch.
    return 1;
}

// resolve_review_scan: recurse over the open-PR list, launching at most ONE
// review-fix re-drive per tick. Returns 1 once a job is launched, else 0. Mirrors
// recover_scan.
fn resolve_review_scan(owner: string, repo: string, raw: string, idx: int) -> int {
    let iid_str = open_pr_field(raw, idx, "iid");
    if len(iid_str) == 0 { return 0; };
    let did = resolve_review_at(owner, repo, raw, idx);
    if did == 1 { return 1; };
    return resolve_review_scan(owner, repo, raw, idx + 1);
}

// resolve_review_prs: list the federation's own open PRs and, at the autonomous
// tier only, re-drive the FIRST green one whose head is a fix/issue- branch we
// opened and that carries an actionable review note. Returns 1 if it launched a
// review-fix job (the caller returns for this tick — one job per tick, do not
// also draft). Mirrors recover_red_prs.
fn resolve_review_prs(owner: string, repo: string) -> int {
    // Autonomous-only: re-pushing to PRs is a terminal write.
    if repo_tier("code_writer", owner, repo) != "autonomous" { return 0; };
    // Raw (no --view): the normalized GitLab-shape list carries both `iid` and
    // `source_branch`, the two fields resolve_review_at needs.
    // colony-lint: safe-exec-concat
    let list_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state opened" + repo_arg(owner, repo);
    let raw = try { exec sh list_cmd; } catch e { ""; };
    if len(raw) < 5 { return 0; };
    return resolve_review_scan(owner, repo, raw, 0);
}

fn tick_for_repo(owner: string, repo: string) -> void {
    // #1332: red-PR recovery runs FIRST (autonomous tier only), BEFORE the
    // draft path. If a red PR we own is re-driven this tick, return without
    // drafting — one code-edit job per tick.
    if recover_red_prs(owner, repo) == 1 {
        let now_r = try { exec sh "date -u +%Y-%m-%dT%H:%M:%SZ"; } catch e { ""; };
        if len(now_r) > 0 {
            memo_write(scoped_memo(owner, repo, "code_writer:last_check"), now_r);
        };
        return;
    };

    // #1360: review-finding recovery. Runs AFTER red-CI recovery (red PRs are
    // owned by recover_red_prs — no race) and BEFORE the draft path. Acts only on
    // a GREEN own-PR carrying an actionable review note (the durable forge note,
    // not the ephemeral bus). One job per tick: a launch returns without drafting.
    if resolve_review_prs(owner, repo) == 1 {
        let now_v = try { exec sh "date -u +%Y-%m-%dT%H:%M:%SZ"; } catch e { ""; };
        if len(now_v) > 0 {
            memo_write(scoped_memo(owner, repo, "code_writer:last_check"), now_v);
        };
        return;
    };

    // 1. Learn from recently merged MRs
    let cmd = merged_mr_cmd(owner, repo);
    let raw = try {
        exec sh cmd;
    } catch e {
        print("[code_writer] GitLab poll failed:", e);
        "";
    };

    if len(raw) > 10 {
        let mr_iid = parse_int(to_string(json_get(raw, "[0].iid")));

        if should_learn_from_mr(owner, repo, mr_iid) {
            memo_write(scoped_memo(owner, repo, "code_writer:last_learned_mr_iid"), to_string(mr_iid));
            // colony-lint: safe-exec-concat
            let changes_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-changes " + to_string(mr_iid) + repo_arg(owner, repo);
            let changes_raw = try { exec sh changes_cmd; } catch e { ""; };

            if len(changes_raw) > 10 {
                let patterns = prompt(
                    "Analyze this MR diff JSON. Identify: naming conventions (variable/function names, casing), code structure (module organization, import style), error handling patterns (try/catch, Result types, guard clauses). Return JSON: mr_count (int, always 1), naming (string), structure (string), error_handling (string). Return ONLY the raw JSON object — no markdown code fences, no ```json wrapper, no prose.",
                    changes_raw
                ) -> CodePatterns;

                if len(owner) > 0 {
                    learn(
                        "code_write",
                        "MR " + to_string(mr_iid),
                        "naming: " + patterns.naming + " | structure: " + patterns.structure + " | errors: " + patterns.error_handling,
                        "success",
                        ["observed", "implementation", repo_tag(owner, repo)]
                    );
                } else {
                    learn(
                        "code_write",
                        "MR " + to_string(mr_iid),
                        "naming: " + patterns.naming + " | structure: " + patterns.structure + " | errors: " + patterns.error_handling,
                        "success",
                        ["observed", "implementation"]
                    );
                };
                print("[code_writer] Learned from MR", mr_iid);
            };
        };
    };

    // 2. Check for assigned issues needing implementation.
    // #1181: pickup keys on ASSIGNMENT, not label events. Always query the
    // current-state `assigned-issues` snapshot so a stably-assigned issue
    // (no recent label churn) stays visible on every tick, not just the
    // first. The #200 `should_draft_code` staleness gate below prevents
    // re-paying the LLM cost now that the snapshot is queried each tick.
    let unassigned_flag = include_unassigned_flag();
    // colony-lint: safe-exec-concat
    let issues_cmd = "$COLONY_DIR/scripts/forge-api.sh assigned-issues --view assigned" + unassigned_flag + repo_arg(owner, repo);
    let issues_raw = try {
        exec sh issues_cmd;
    } catch e {
        print("[code_writer] assigned-issues poll failed:", e);
        "";
    };

    if len(issues_raw) > 10 {
        // #200: early-out when the top assigned issue is the same one we
        // already drafted and its `updated_at` is unchanged. The iid /
        // updated_at pair is stashed at the start of a fresh draft so
        // subsequent ticks on a sticky assignment short-circuit before
        // the `draft = prompt(...)` call below.
        let first_iid_str = to_string(json_get(issues_raw, "[0].iid"));
        let first_upd = to_string(json_get(issues_raw, "[0].updated_at"));
        // #1350: gate on actual completion, not "we drafted once". Re-draft when
        // the #200 staleness gate says so OR when no open/merged MR exists for
        // the issue's deterministic fix/issue-<iid> branch — the latter rescues
        // an issue whose launched edit job died without opening an MR. The
        // has_mr_for_branch check is only reached when should_draft_code is false
        // (the if-expression short-circuits), so the extra MR-list queries cost
        // nothing on the common drafted-and-changed path.
        let needs_draft = if should_draft_code(owner, repo, first_iid_str, first_upd) {
            true;
        } else {
            !has_mr_for_branch(owner, repo, first_iid_str);
        };
        if needs_draft {
            // #1370 (B3): tier-independent input-unchanged early-return BEFORE
            // the draft prompt(). If the top assigned issue's (iid, updated_at)
            // fingerprint is unchanged since the last tick we saw it AND an
            // open/merged MR already exists for its fix/issue-<iid> branch
            // (has_mr_for_branch — i.e. real work landed, NOT an MR-less branch
            // that needs the #1363 rescue), there is nothing new to do this
            // tick: skip the expensive draft prompt and re-poll next tick. The
            // red-CI recovery path already ran first (recover_red_prs returns
            // before reaching here), so "no red CI to recover" holds. This is
            // the idle-prompt-suppression win: it stops re-prompting an
            // unchanged, already-handled issue every tick. It never starves —
            // an external edit/re-assignment bumps updated_at and re-triggers.
            if input_unchanged(owner, repo, first_iid_str, first_upd) {
                if has_mr_for_branch(owner, repo, first_iid_str) {
                    let now_s = try { exec sh "date -u +%Y-%m-%dT%H:%M:%SZ"; } catch e { ""; };
                    if len(now_s) > 0 {
                        memo_write(scoped_memo(owner, repo, "code_writer:last_check"), now_s);
                    };
                    memo_write(scoped_memo(owner, repo, "code_writer:last_seen_iid"), first_iid_str);
                    memo_write(scoped_memo(owner, repo, "code_writer:last_seen_updated_at"), first_upd);
                    print("[code_writer] issue", first_iid_str, "unchanged + MR exists — skipping draft prompt this tick");
                    return;
                };
            };
            // #1185: the staleness markers (last_drafted_iid / _updated_at)
            // are NOT set here. The #200 gate must only short-circuit once an
            // action for this issue has actually COMPLETED. The autonomous
            // path sets them after commit-files succeeds; the review-gated /
            // propose / shadow paths set them after their own terminal action
            // (the draft comment / emit). A branch-created-but-commit-failed
            // tick leaves the markers unset so the next tick retries instead
            // of stranding an empty branch.
            let rec = recommend("code_write", ["accuracy"]);
            let context = "Assigned issues: " + issues_raw + "\nLearned code patterns: " + to_string(rec);

            let draft = prompt(
                "You are a code writer agent. Pick the highest-priority assigned issue and draft an implementation plan. Propose a branch name (kebab-case, prefixed with feat/ or fix/), a concise Conventional Commits PR title (format `type(scope): summary` in the imperative mood, 50-72 chars, lowercase summary, NO trailing period; type is one of feat/fix/docs/test/refactor/chore/perf), list the files to create or modify with brief descriptions, and summarize the approach. Return JSON: issue_id (int), branch_name (string), title (string, the Conventional Commits PR title — short, NOT the full summary), files (string, markdown list of file paths and what each does), summary (string, 2-3 sentences for the PR body), confidence (float 0-1). Return ONLY the raw JSON object — no markdown code fences, no ```json wrapper, no prose.",
                context
            ) -> CodeDraft;

            let my_tier = repo_tier("code_writer", owner, repo);
            print("[code_writer] Drafted code for issue", draft.issue_id, "(tier:", my_tier, ")");

            if my_tier == "autonomous" {
                // #1210: Approach A — edit files DIRECTLY in a local checkout via
                // Claude Code (flat-cyborg), then commit the `git diff` and open
                // the PR. This replaces the old "create-branch -> get-file ->
                // numbered_view -> line-range prompt() -> apply-line-edits.py ->
                // commit-files via the forge Git Database API" chain. That chain
                // round-tripped file CONTENT through flat-cyborg's TUI screen-
                // scrape, which line-wraps and corrupts large files (#1152 /
                // #1195 / #1208). Editing in a real checkout sidesteps the
                // screen-scrape: claude's own file tools touch the working tree
                // and we commit whatever git shows. The editing prompt now lives
                // INSIDE the orchestrator's flat-cyborg invocation, NOT as an .ag
                // prompt() — so this branch has no prompt() at all. flat-cyborg
                // stays the only backend; `claude -p` is not used.
                //
                // #1214: the orchestrator's job (clone + flat-cyborg edit +
                // commit + push + PR) runs for MINUTES, but agentis caps a single
                // `exec sh` at ~120000ms (the exec.default_timeout_ms knob is
                // ignored), so a synchronous call was killed mid-edit with
                // ExecTimeout. Instead we call tools/code-edit-job.sh — a FAST
                // launcher that runs code-edit-in-checkout.sh DETACHED (setsid)
                // and tracks it in a per-issue job dir. It returns in well under
                // 120s on every tick, printing one of: LAUNCHED (just started),
                // RUNNING (still going), DONE <url> (PR opened), NO_EDITS (claude
                // changed nothing), or ERROR <short>. code_writer polls it across
                // ticks: while LAUNCHED/RUNNING it leaves the #1185 markers unset
                // so the same assigned issue is re-polled next tick (a re-poll
                // does NOT start a second clone/edit — the launcher's pid check
                // guards idempotency). Only DONE sets the markers + emits.
                //
                // Deterministic per-issue branch (fix/issue-<iid>) so a retry
                // reuses the same branch instead of littering empty branches.
                let issue_iid = to_string(draft.issue_id);
                let branch_name = "fix/issue-" + issue_iid;
                // colony-lint: safe-exec-concat
                let issue_cmd = "$COLONY_DIR/scripts/forge-api.sh issue " + to_string(draft.issue_id) + repo_arg(owner, repo);
                let issue_detail = try { exec sh issue_cmd; } catch e { ""; };
                // Task text = issue body + the drafted plan. The orchestrator
                // wraps this into the claude editing instruction.
                let task_text = "Issue:\n" + issue_detail + "\n\nPlan:\n" + draft.files + "\n\n" + draft.summary;
                // The launcher manages the detached orchestrator's lifecycle and
                // prints the current poll-state on stdout. It never blocks on the
                // slow job, so this `exec sh` returns fast and never hits the
                // 120s cap. A non-zero exit (a usage / launch error) collapses
                // the `try` to "" => job_word "" => the ERROR/else branch retries.
                // Epic auto-trigger (#1257): an epic-class issue gets --decompose so
                // the orchestrator splits it into per-subtask edits (M3, #1254). The
                // epic label is the planning vocabulary (planning:labels:epic, read
                // cross-colony) or "epic" by default, matched as EXACT quoted JSON
                // array element(s) on the issue's labels so "not-epic"/"epic-foo" don't
                // false-match. Decomposing a non-epic is harmless (one subtask = the
                // whole task), so a loose match here is low-stakes.
                let epic_vocab = recall_latest("planning:labels:epic");
                let epic_vocab_or_default = if len(epic_vocab) > 0 { epic_vocab; } else { "epic"; };
                // #1271: detect epic on the DRAFTED issue (issue_detail, fetched
                // above), NOT issues_raw[0] — the LLM may draft ANY assigned issue,
                // so [0] is the wrong issue whenever more than one is assigned.
                // Match the quoted label in the RAW issue JSON: to_string() of an
                // ARRAY-valued json_get yields "void" on the runtime, so the old
                // json_get(...,"labels") path never matched. Searching the raw text
                // for "\"<token>\"" is reliable and keeps the anti-false-match
                // (an "epic"-prefixed label like "epic-foo" lacks the closing quote;
                // body/title quotes are JSON-escaped as \" so they cannot match).
                // #1259: is_epic_match splits a CSV vocab ("epic, big-feature") and
                // ORs the quoted match across tokens, so a "big-feature"-only issue
                // decomposes too — CSV parity with task_decomposer.ag, which splices
                // the same vocab whole into an LLM prompt that can split it.
                let is_epic = is_epic_match(issue_detail, epic_vocab_or_default);
                if is_epic { print("[code_writer] issue", issue_iid, "is epic-class — auto-decomposing (#1257)"); };
                let decompose_flag = if is_epic { " --decompose"; } else { ""; };
                // #1349: thread the agent's OWN drafted summary through as the
                // PR/MR body (--description). draft.summary is the "2-3 sentences
                // for the PR body" the prompt() above already produced; without
                // this it was silently dropped and the orchestrator fell back to a
                // static template. The LLM reasoning stays in the .ag prompt(), NOT
                // in shell plumbing. code-edit-job.sh forwards it to the detached
                // worker; code-edit-in-checkout.sh uses it for create-mr (static
                // template only as the empty-value fallback).
                // colony-lint: safe-exec-concat
                let job_cmd = "$COLONY_DIR/../../tools/code-edit-job.sh --owner " + shell_escape(owner) + " --repo " + shell_escape(repo) + " --issue " + shell_escape(issue_iid) + " --branch " + shell_escape(branch_name) + " --title " + shell_escape(draft.title) + " --description " + shell_escape(draft.summary) + " --task " + shell_escape(task_text) + decompose_flag;
                let job_out = try { exec sh job_cmd; } catch e {
                    print("[code_writer] code-edit-job launcher failed — not marking drafted, will retry:", e);
                    "";
                };
                let job_state = job_decide(job_out);

                if job_state == "DONE" {
                    // #1185: mark drafted only now that the PR opened. LAUNCHED /
                    // RUNNING / NO_EDITS / ERROR all leave the markers unset so
                    // the next tick re-polls (or retries) the same issue.
                    // #1356: the launcher reports RAW facts now; job_decide (above)
                    // resolved them into this DONE, and job_rest reads the PR URL
                    // from the RESULT= token. Clear the now-consumed job dir so a
                    // future re-draft relaunches cleanly (was the launcher's job).
                    let pr_url = job_rest(job_out);
                    clear_job_dir(issue_iid);
                    memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_iid"), first_iid_str);
                    memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_updated_at"), first_upd);
                    print("[code_writer] Opened PR via detached checkout-edit for issue", draft.issue_id, ":", pr_url);
                    emit("implementation:mr_ready", draft);
                    if len(owner) > 0 {
                        learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "success", ["acted", "implementation", repo_tag(owner, repo)]);
                    } else {
                        learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "success", ["acted", "implementation"]);
                    };
                } else {
                    if job_state == "LAUNCHED" {
                        print("[code_writer] Launched detached checkout-edit for issue", draft.issue_id, "— will poll next tick");
                    } else {
                        if job_state == "RUNNING" {
                            print("[code_writer] Detached checkout-edit still running for issue", draft.issue_id, "— will poll next tick");
                        } else {
                            if job_state == "NO_EDITS" {
                                // #1350: a terminal failure that opened no MR. Clear
                                // the #200 staleness markers (defensively — the
                                // autonomous path only sets them on DONE) so the
                                // next tick re-drafts instead of stranding the issue.
                                // #1356: also clear the consumed job dir so the
                                // relaunch starts fresh (was the launcher's poll job).
                                clear_job_dir(issue_iid);
                                memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_iid"), "");
                                memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_updated_at"), "");
                                print("[code_writer] Detached checkout-edit produced no edits for issue", draft.issue_id, "— cleared draft markers, will retry");
                            } else {
                                // #1356: terminal ERROR — job-died (running pid gone),
                                // done-without-url, job-failed, or a stale/half-written
                                // dir, all folded here by job_decide. Same job-dir +
                                // marker clear so the next tick retries. job_out carries
                                // the raw STATUS=.. PID_ALIVE=.. line for diagnosis.
                                clear_job_dir(issue_iid);
                                memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_iid"), "");
                                memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_updated_at"), "");
                                print("[code_writer] Detached checkout-edit error for issue", draft.issue_id, ":", job_out, "— cleared draft markers, will retry");
                            };
                        };
                    };
                };
            } else {
                if my_tier == "review-gated" {
                    // Non-terminal draft: post the implementation plan as a comment
                    // on the issue so a human can approve before we create a branch
                    // and commit code. No branch or commit at this tier.
                    let note = "[draft-impl] **Implementation Plan** (automated, pending approval)\n\nBranch: `" + draft.branch_name + "`\n\n" + draft.summary + "\n\nFiles:\n" + draft.files;
                    // colony-lint: safe-exec-concat
                    let post_cmd = "$COLONY_DIR/scripts/forge-api.sh add-note " + to_string(draft.issue_id) + " --body " + shell_escape(note) + repo_arg(owner, repo);
                    try { exec sh post_cmd; } catch e {
                        print("[code_writer] Failed to post draft plan:", e);
                    };
                    emit("implementation:code_draft", draft);
                    if len(owner) > 0 {
                        learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "partial", ["implementation", "review-gated", repo_tag(owner, repo)]);
                    } else {
                        learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "partial", ["implementation", "review-gated"]);
                    };
                } else {
                    if my_tier == "propose" {
                        emit("implementation:code_draft", draft);
                        if len(owner) > 0 {
                            learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "partial", ["emitted", "implementation", repo_tag(owner, repo)]);
                        } else {
                            learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "partial", ["emitted", "implementation"]);
                        };
                    } else {
                        print("[code_writer] Observing (tier:", my_tier, ")");
                        if len(owner) > 0 {
                            learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "partial", ["observed", "implementation", repo_tag(owner, repo)]);
                        } else {
                            learn("code_write", "issue " + to_string(draft.issue_id), draft.summary, "partial", ["observed", "implementation"]);
                        };
                    };
                };
                // #1185: for the review-gated / propose / shadow paths the
                // draft comment / emit IS the terminal action and it has just
                // run, so mark drafted now to preserve their per-tick
                // idempotency (they must not re-post / re-emit every tick).
                // The autonomous path deliberately does NOT fall through here
                // — it sets the markers only after commit-files succeeds.
                memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_iid"), first_iid_str);
                memo_write(scoped_memo(owner, repo, "code_writer:last_drafted_updated_at"), first_upd);
            };
        };
        // #1370 (B3): record the input fingerprint of the top assigned issue we
        // saw THIS tick, at the END of the tick regardless of tier and
        // regardless of whether we drafted/skipped. The next tick's
        // input_unchanged early-return reads it. Written unconditionally here
        // (not only on a completed action) so the early-return is robust even
        // when the #1185 completion markers are deliberately left unset
        // (LAUNCHED/RUNNING). An external edit bumps updated_at -> re-triggers.
        memo_write(scoped_memo(owner, repo, "code_writer:last_seen_iid"), first_iid_str);
        memo_write(scoped_memo(owner, repo, "code_writer:last_seen_updated_at"), first_upd);
    };

    // 3. Listen for routing suggestions from triage colony
    let routed = listen("triage:route_suggestion", 100);
    if len(to_string(routed)) > 5 {
        print("[code_writer] Received routing suggestion, will check assigned issues on next tick");
    };

    let now = try { exec sh "date -u +%Y-%m-%dT%H:%M:%SZ"; } catch e { ""; };
    if len(now) > 0 {
        memo_write(scoped_memo(owner, repo, "code_writer:last_check"), now);
    };
}

// Recursive iterator over `iter-repos.sh` output. See router.ag for the
// empty-owner sentinel rationale.
fn tick_at(spool: string, line_no: int) -> void {
    // #1358: nth-line read via nth_field (newline sep) — was an inline
    // python3 -c splitlines() one-liner. Out-of-range line_no -> "", which
    // ends the recursion exactly like the old bounds-checked print.
    let line = nth_field(spool, "\n", line_no);
    if len(line) == 0 { return; };
    let owner = repo_field(line, 0);
    let repo = repo_field(line, 1);
    tick_for_repo(owner, repo);
    return tick_at(spool, line_no + 1);
}

fn tick(reason: string) -> void {
    // #316 M3b: per-repo fan-out. See triage/agents/router.ag for the
    // back-compat sentinel pattern and byte-identity rationale.
    let spool = try { exec sh "$COLONY_DIR/../../tools/iter-repos.sh"; } catch e { ""; };
    if len(spool) == 0 {
        return;
    };
    tick_at(spool, 0);
}
