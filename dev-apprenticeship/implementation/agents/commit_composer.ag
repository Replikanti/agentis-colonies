// commit_composer.ag -- Implementation colony: learns commit conventions.
//
// Observes commit messages and change grouping in merged MRs to learn
// your commit conventions: message format, scope prefixes, what goes in
// one commit vs many. Packages code + tests + refactoring into structured
// commits and opens a merge request.
//
// Run as daemon: agentis daemon agents/commit_composer.ag --colony implementation
// Requires: exec_foreign capability, GITLAB_* env vars

cb 600;

type CommitStyle {
    commits_seen: int,
    format: string,
    grouping: string,
    prefixes: string
}

type MRPlan {
    issue_id: int,
    branch_name: string,
    commits: string,
    mr_title: string,
    mr_description: string,
    confidence: float
}

// #316 M3b: per-tick fan-out helpers. See triage/agents/router.ag for
// the full rationale. Single-block configs collapse to owner=="" sentinel,
// repo_arg/repo_tag return "", scoped_memo passes the suffix through.

fn repo_arg(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return " --repo " + shell_escape(owner + "/" + repo);
}

fn repo_tag(owner: string, repo: string) -> string {
    if len(owner) == 0 { return ""; };
    return "repo:" + owner + "/" + repo;
}

fn scoped_memo(owner: string, repo: string, suffix: string) -> string {
    if len(owner) == 0 { return suffix; };
    return owner + "__" + repo + ":" + suffix;
}

// #316 M4: per-repo confidence read with legacy fallback. Mirrors the
// runtime tier() builtin's threshold table from ADR-0001 / CLAUDE.md.
// `agent_name` (not `agent`) — `agent` is a reserved keyword in `.ag`.
fn repo_tier(agent_name: string, owner: string, repo: string) -> string {
    let raw = if len(owner) == 0 {
        recall_latest(agent_name + ":confidence");
    } else {
        let scoped = recall_latest(scoped_memo(owner, repo, agent_name + ":confidence"));
        if len(scoped) > 0 { scoped; } else { recall_latest(agent_name + ":confidence"); };
    };
    if len(raw) == 0 { return "dormant"; };
    let c = parse_float(raw);
    if c >= 0.95 { return "autonomous"; };
    if c >= 0.8  { return "review-gated"; };
    if c >= 0.6  { return "propose"; };
    if c >= 0.4  { return "shadow"; };
    return "dormant";
}

// #1358: nth 0-based sep-delimited field of `s`, walked natively with
// index_of/substring — `.ag` v1.7 has no split(s, sep) builtin, so this
// recursive walk is the workaround (a general split(s, sep) -> list<string>
// builtin is a candidate upstream agentis-core language ask). Serves both the
// tab-separated iter-repos records (repo_field) and tick_at's newline-split
// spool reader. Total: out-of-range / negative n -> "", mirroring the
// bounds-checked python one-liner it replaces.
fn nth_field(s: string, sep: string, n: int) -> string {
    if n < 0 { return ""; };
    if len(s) == 0 { return ""; };
    let p = index_of(s, sep);
    if n == 0 {
        if p < 0 { return s; };
        return substring(s, 0, p);
    };
    if p < 0 { return ""; };
    return nth_field(substring(s, p + len(sep), len(s)), sep, n - 1);
}

// #1358: tab-separated field read, now native via nth_field (was an inline
// python3 -c split). Total: missing field / out-of-range idx -> "".
fn repo_field(line: string, idx: int) -> string {
    return nth_field(line, "\t", idx);
}

fn merged_mr_cmd(owner: string, repo: string) -> string {
    let ts = recall_latest(scoped_memo(owner, repo, "commit_composer:last_check"));
    // colony-lint: safe-exec-concat
    if len(ts) > 0 {
        return "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --since " + shell_escape(ts) + " --view impl" + repo_arg(owner, repo);
    };
    // colony-lint: safe-exec-concat
    return "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --view impl" + repo_arg(owner, repo);
}

// #239: learn from each merged MR at most once per daemon lifetime.
// Without this gate, the `merge-requests --since <last_check>` query
// keeps returning the same MR at index [0] as long as its `updated_at`
// keeps getting bumped, so the learning-path prompt re-fires every
// tick at cb_budget 600. Single-key memo, no TTL: at-most-once per
// distinct MR iid.
fn should_learn_from_mr(owner: string, repo: string, mr_iid: int) -> bool {
    if mr_iid <= 0 {
        return false;
    };
    let iid_str = to_string(mr_iid);
    let last_iid = recall_latest(scoped_memo(owner, repo, "commit_composer:last_learned_mr_iid"));
    if len(last_iid) == 0 {
        return true;
    };
    if iid_str != last_iid {
        return true;
    };
    return false;
}

// --- #1453 Wave 2 (M2): reality-check feedback loop ---
//
// Copied from the Wave-1 idiom (code_writer) and the M1 code-review reviewers:
// when this agent autonomously opens an MR, it stashes the created MR iid in a
// single-slot `commit_composer:pending_verdict` memo; a later tick mechanically
// re-queries whether that MR merged or was closed-unmerged and scores the
// decision — no prompt() on this path. The `.ag` dialect has no imports, so
// signal_to_outcome / verdict_age_seconds / the list-scan helper are re-defined
// per file exactly as the seven Wave-1/M1 agents do.

// Map the reality-check signal to the experience-store outcome enum. Signal 0
// ("no terminal state yet") is handled by the caller via an early return and
// never reaches this function. M2 only emits 1 (merged) and 3 (closed-
// unmerged); the partial branch is carried for idiom parity with Wave 1.
fn signal_to_outcome(signal: int) -> string {
    if signal == 1 {
        return "success";
    };
    if signal == 2 {
        return "partial";
    };
    return "failure";
}

// Age (seconds) of a pending-verdict blob.
fn verdict_age_seconds(blob: string) -> int {
    let emit_ts = parse_int(to_string(json_get(blob, "[0]")));
    let now_raw = to_string(now_ms() / 1000);
    let now = parse_int(now_raw);
    return now - emit_ts;
}

// Native FLAT iid-membership over a merge-requests list JSON: project the `iid`
// column to a newline-separated blob with ONE json_array_project call (no
// per-element map/filter `.ag` walk — the #1640 CB-overflow lesson) and test
// exact-line membership by wrapping both the projection and the needle in
// newlines so a substring hit can't cross an iid boundary ("2" never matches
// inside "12"). Total: empty/malformed list or empty needle -> false. Same
// native helper the M1 reviewers wrote (not the python-based Wave-1
// raw_list_has_branch).
fn iid_in_list(raw: string, iid_str: string) -> bool {
    if len(iid_str) == 0 { return false; };
    let projected = json_array_project(raw, "", "iid");
    if len(projected) == 0 { return false; };
    return index_of("\n" + projected + "\n", "\n" + iid_str + "\n") >= 0;
}

// The create-mr forge response is the RAW backend object: GitLab returns an MR
// carrying `iid`, GitHub a PR carrying `number`. Read `iid` first, fall back to
// `number`; json_get emits the "void" sentinel for a missing key, so both are
// filtered to "" for the record guard.
fn created_mr_iid(mr_result: string) -> string {
    let iid = to_string(json_get(mr_result, "iid"));
    if len(iid) > 0 { if iid != "void" { return iid; }; };
    let num = to_string(json_get(mr_result, "number"));
    if num == "void" { return ""; };
    return num;
}

// Record a pending verdict for an autonomously opened MR. Stored as JSON array
// [ts, iid, ""] — epoch int, iid int and an empty payload are all ASCII-safe so
// naive concatenation is sufficient and we skip a JSON encoder (the single-slot
// idiom from labeler.ag). A blank iid (unresolvable create-mr response) is a
// no-op.
fn record_commit_verdict(owner: string, repo: string, mr_iid: string) -> void {
    if len(mr_iid) == 0 { return; };
    let ts_raw = to_string(now_ms() / 1000);
    let blob = "[" + ts_raw + "," + mr_iid + ",\"\"]";
    memo_write(scoped_memo(owner, repo, "commit_composer:pending_verdict"), blob);
    print("[commit_composer] verdict recorded: MR", mr_iid);
}

// Score the pending verdict against the fate of the MR we opened. Mechanical
// compare via the raw merge-requests lists — NEVER a prompt(). merged =>
// success (1); closed-unmerged => failure (3); still open / not found => no
// signal yet (leave pending). The merged list is parsed FIRST with a parse-
// guard so a GitHub backend (whose closed list is a superset of merged) can
// never misread a merged MR as closed-unmerged. 24h ageout drops the verdict
// UNSCORED (absence of a terminal state is not evidence either way). Runs at
// the TOP of tick_for_repo, before any other work.
fn evaluate_commit_verdict(owner: string, repo: string) -> void {
    let key = scoped_memo(owner, repo, "commit_composer:pending_verdict");
    let blob = recall_latest(key);
    if len(blob) < 3 {
        return;
    };
    let timeout_s = 86400;
    if verdict_age_seconds(blob) > timeout_s {
        print("[commit_composer] verdict aged out without signal");
        memo_write(key, "");
        return;
    };
    let mr_iid = parse_int(to_string(json_get(blob, "[1]")));
    let iid_s = to_string(mr_iid);
    // colony-lint: safe-exec-concat
    let merged_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state merged --per-page 50" + repo_arg(owner, repo);
    let merged_raw = try { exec sh merged_cmd; } catch e { ""; };
    // Score ONLY when the merged list parsed as a JSON array (index 0 = leading
    // "["); a transient merged-query failure otherwise leaves the verdict
    // pending for a later tick.
    if index_of(merged_raw, "[") != 0 {
        return;
    };
    let signal = if iid_in_list(merged_raw, iid_s) {
        1;
    } else {
        // colony-lint: safe-exec-concat
        let closed_cmd = "$COLONY_DIR/scripts/forge-api.sh merge-requests --state closed --per-page 50" + repo_arg(owner, repo);
        let closed_raw = try { exec sh closed_cmd; } catch e { ""; };
        if iid_in_list(closed_raw, iid_s) { 3; } else { 0; };
    };
    if signal == 0 {
        return;
    };
    let outcome = signal_to_outcome(signal);
    if len(owner) > 0 {
        learn("commit_compose", "MR " + iid_s + " reality-check", "signal: " + to_string(signal), outcome, ["acted", "implementation", repo_tag(owner, repo)]);
    } else {
        learn("commit_compose", "MR " + iid_s + " reality-check", "signal: " + to_string(signal), outcome, ["acted", "implementation"]);
    };
    print("[commit_composer] reality-check: MR", mr_iid, "signal", signal, "->", outcome);
    memo_write(key, "");
}

fn tick_for_repo(owner: string, repo: string) -> void {
    // #1453 Wave 2 (M2): score any pending MR verdict FIRST (read-only, no
    // early return) before the poll below. Cheap no-op when nothing is pending.
    evaluate_commit_verdict(owner, repo);

    // 1. Learn commit conventions from recently merged MRs
    let cmd = merged_mr_cmd(owner, repo);
    let raw = try {
        exec sh cmd;
    } catch e {
        print("[commit_composer] GitLab poll failed:", e);
        "";
    };

    if len(raw) > 10 {
        let mr_iid = parse_int(to_string(json_get(raw, "[0].iid")));

        if should_learn_from_mr(owner, repo, mr_iid) {
            memo_write(scoped_memo(owner, repo, "commit_composer:last_learned_mr_iid"), to_string(mr_iid));
            // colony-lint: safe-exec-concat
            let commits_cmd = "$COLONY_DIR/scripts/forge-api.sh mr-commits " + to_string(mr_iid) + repo_arg(owner, repo);
            let commits_raw = try { exec sh commits_cmd; } catch e { "[]"; };

            if len(commits_raw) > 10 {
                let style = prompt(
                    "Analyze these commit messages from a merged MR. Identify: how many commits (commits_seen), message format (conventional commits, imperative mood, ticket references), change grouping strategy (one big commit, logical splits, separate refactoring commits), common prefixes (feat:, fix:, chore:, refactor:). Return JSON: commits_seen (int), format (string), grouping (string), prefixes (string). Return ONLY the raw JSON object — no markdown code fences, no ```json wrapper, no prose.",
                    commits_raw
                ) -> CommitStyle;

                if style.commits_seen > 0 {
                    if len(owner) > 0 {
                        learn(
                            "commit_compose",
                            "MR " + to_string(mr_iid) + " (" + to_string(style.commits_seen) + " commits)",
                            "format: " + style.format + " | grouping: " + style.grouping + " | prefixes: " + style.prefixes,
                            "success",
                            ["observed", "implementation", repo_tag(owner, repo)]
                        );
                    } else {
                        learn(
                            "commit_compose",
                            "MR " + to_string(mr_iid) + " (" + to_string(style.commits_seen) + " commits)",
                            "format: " + style.format + " | grouping: " + style.grouping + " | prefixes: " + style.prefixes,
                            "success",
                            ["observed", "implementation"]
                        );
                    };
                    print("[commit_composer] Learned from", style.commits_seen, "commits in MR", mr_iid);
                };
            };
        };
    };

    // 2. Collect drafts from other agents and compose MR
    let code_draft = listen("implementation:code_draft", 100);
    let code_str = to_string(code_draft);

    if len(code_str) < 5 {
        // #1151: the live `implementation:code_draft` event was not caught in
        // this tick's 100ms listen() window. Fall back to the durable
        // single-slot memo code_writer persists right after a successful
        // commit, so a missed event no longer strands a committed branch
        // without an MR. The memo is tab-delimited (issue_id, branch_name,
        // summary); see code_writer.ag.
        let pending = recall_latest(scoped_memo(owner, repo, "implementation:pending_mr"));
        if len(pending) < 3 {
            // No durable handoff pending either — nothing to compose.
            let now = now_iso();
            if len(now) > 0 {
                memo_write(scoped_memo(owner, repo, "commit_composer:last_check"), now);
            };
            return;
        };

        let pending_issue = repo_field(pending, 0);
        let pending_branch = repo_field(pending, 1);
        let pending_summary = repo_field(pending, 2);

        // Idempotency: skip if we already opened the MR for this issue.
        let last_mr = recall_latest(scoped_memo(owner, repo, "commit_composer:last_mr_issue"));
        if last_mr == pending_issue {
            let now = now_iso();
            if len(now) > 0 {
                memo_write(scoped_memo(owner, repo, "commit_composer:last_check"), now);
            };
            return;
        };

        // One tier() call per tick: this fallback path returns before the
        // live-event path below ever reaches its own repo_tier() call.
        let fallback_tier = repo_tier("commit_composer", owner, repo);
        if fallback_tier == "autonomous" {
            // Derive MR fields deterministically (no prompt(): the
            // check-prompt-gate lint forbids an ungated prompt here, and the
            // durable fallback is specifically the autonomous terminal write).
            let mr_title = "feat: resolve #" + pending_issue;
            let mr_description = pending_summary;
            // colony-lint: safe-exec-concat
            let mr_cmd = "$COLONY_DIR/scripts/forge-api.sh create-mr --source " + shell_escape(pending_branch) + " --title " + shell_escape(mr_title) + " --description " + shell_escape(mr_description) + repo_arg(owner, repo);
            let mr_result = try { exec sh mr_cmd; } catch e {
                print("[commit_composer] MR creation failed (durable handoff):", e);
                "";
            };

            if len(mr_result) > 0 {
                print("[commit_composer] Opened MR via durable handoff for issue", pending_issue);
                emit("implementation:mr_ready", pending);
                if len(owner) > 0 {
                    learn("commit_compose", "issue " + pending_issue, mr_title, "success", ["acted", "implementation", repo_tag(owner, repo)]);
                } else {
                    learn("commit_compose", "issue " + pending_issue, mr_title, "success", ["acted", "implementation"]);
                };
                memo_write(scoped_memo(owner, repo, "commit_composer:last_mr_issue"), pending_issue);
                memo_write(scoped_memo(owner, repo, "implementation:pending_mr"), "");
                // #1453 Wave 2 (M2): stash the created MR iid so a later tick
                // scores this MR against its merged/closed fate.
                record_commit_verdict(owner, repo, created_mr_iid(mr_result));
            };
        };
        // Below autonomous: leave the durable memo in place so a later tick at
        // a higher tier can still open the MR. The terminal write is gated to
        // the autonomous tier only.

        let now = now_iso();
        if len(now) > 0 {
            memo_write(scoped_memo(owner, repo, "commit_composer:last_check"), now);
        };
        return;
    };

    // Collect test draft and refactoring suggestions (non-blocking, may be empty)
    let test_draft = listen("implementation:test_draft", 100);
    let refactor_suggestions = listen("implementation:refactor_suggestions", 100);

    let all_input = "Code draft: " + code_str
        + "\nTest draft: " + to_string(test_draft)
        + "\nRefactoring suggestions: " + to_string(refactor_suggestions);

    let rec = recommend("commit_compose", ["accuracy"]);
    let context = all_input + "\nLearned commit conventions: " + to_string(rec);

    let plan = prompt(
        "You are a commit composer agent. You received a code draft, possibly tests, and possibly refactoring suggestions for an issue. Compose a structured commit plan following learned conventions. Decide how to split changes into commits (code, tests, refactoring as separate commits or combined, based on learned grouping style). Write commit messages in the learned format. Propose an MR title and description. Return JSON: issue_id (int), branch_name (string, from the code draft), commits (string, markdown numbered list of commit messages), mr_title (string), mr_description (string, brief summary), confidence (float 0-1). Return ONLY the raw JSON object — no markdown code fences, no ```json wrapper, no prose.",
        context
    ) -> MRPlan;

    let my_tier = repo_tier("commit_composer", owner, repo);
    print("[commit_composer] Composed MR plan for issue", plan.issue_id, "(tier:", my_tier, ")");

    if my_tier == "autonomous" {
        // Create the MR
        // colony-lint: safe-exec-concat
        let mr_cmd = "$COLONY_DIR/scripts/forge-api.sh create-mr --source " + shell_escape(plan.branch_name) + " --title " + shell_escape(plan.mr_title) + " --description " + shell_escape(plan.mr_description) + repo_arg(owner, repo);
        let mr_result = try { exec sh mr_cmd; } catch e {
            print("[commit_composer] MR creation failed:", e);
            "";
        };

        if len(mr_result) > 0 {
            print("[commit_composer] Created MR for issue", plan.issue_id);
            emit("implementation:mr_ready", plan);
            if len(owner) > 0 {
                learn("commit_compose", "issue " + to_string(plan.issue_id), plan.mr_title, "success", ["acted", "implementation", repo_tag(owner, repo)]);
            } else {
                learn("commit_compose", "issue " + to_string(plan.issue_id), plan.mr_title, "success", ["acted", "implementation"]);
            };
            // #1151: record the idempotency marker + clear the durable handoff
            // so the no-event fallback does not re-open this same MR next tick.
            memo_write(scoped_memo(owner, repo, "commit_composer:last_mr_issue"), to_string(plan.issue_id));
            memo_write(scoped_memo(owner, repo, "implementation:pending_mr"), "");
            // #1453 Wave 2 (M2): stash the created MR iid so a later tick scores
            // this MR against its merged/closed fate.
            record_commit_verdict(owner, repo, created_mr_iid(mr_result));
        };
    } else {
        if my_tier == "review-gated" {
            // Non-terminal draft: post the MR plan as a comment on the issue
            // so a human can approve before we actually open a non-draft MR.
            let note = "[draft-mr] **Merge Request Plan** (automated, pending approval)\n\nBranch: `" + plan.branch_name + "`\nTitle: " + plan.mr_title + "\n\n" + plan.mr_description + "\n\nCommits:\n" + plan.commits;
            // colony-lint: safe-exec-concat
            let post_cmd = "$COLONY_DIR/scripts/forge-api.sh add-note " + to_string(plan.issue_id) + " --body " + shell_escape(note) + repo_arg(owner, repo);
            try { exec sh post_cmd; } catch e {
                print("[commit_composer] Failed to post draft plan:", e);
            };
            emit("implementation:mr_ready", plan);
            if len(owner) > 0 {
                learn("commit_compose", "issue " + to_string(plan.issue_id), plan.mr_title, "partial", ["implementation", "review-gated", repo_tag(owner, repo)]);
            } else {
                learn("commit_compose", "issue " + to_string(plan.issue_id), plan.mr_title, "partial", ["implementation", "review-gated"]);
            };
        } else {
            if my_tier == "propose" {
                emit("implementation:mr_ready", plan);
                if len(owner) > 0 {
                    learn("commit_compose", "issue " + to_string(plan.issue_id), plan.mr_title, "partial", ["emitted", "implementation", repo_tag(owner, repo)]);
                } else {
                    learn("commit_compose", "issue " + to_string(plan.issue_id), plan.mr_title, "partial", ["emitted", "implementation"]);
                };
            } else {
                print("[commit_composer] Observing (tier:", my_tier, ")");
                if len(owner) > 0 {
                    learn("commit_compose", "issue " + to_string(plan.issue_id), plan.mr_title, "partial", ["observed", "implementation", repo_tag(owner, repo)]);
                } else {
                    learn("commit_compose", "issue " + to_string(plan.issue_id), plan.mr_title, "partial", ["observed", "implementation"]);
                };
            };
        };
    };

    let now = now_iso();
    if len(now) > 0 {
        memo_write(scoped_memo(owner, repo, "commit_composer:last_check"), now);
    };
}

// Recursive iterator over `iter-repos.sh` output. See router.ag for the
// empty-owner sentinel rationale.
fn tick_at(spool: string, line_no: int) -> void {
    // #1358: nth-line read via nth_field (newline sep) — was an inline
    // python3 -c splitlines() one-liner. Out-of-range line_no -> "", which
    // ends the recursion exactly like the old bounds-checked print.
    let line = nth_field(spool, "\n", line_no);
    if len(line) == 0 { return; };
    let owner = repo_field(line, 0);
    let repo = repo_field(line, 1);
    tick_for_repo(owner, repo);
    return tick_at(spool, line_no + 1);
}

fn tick(reason: string) -> void {
    // #316 M3b: per-repo fan-out. See triage/agents/router.ag for the
    // back-compat sentinel pattern and byte-identity rationale.
    let spool = try { exec sh "$COLONY_DIR/../../tools/iter-repos.sh"; } catch e { ""; };
    if len(spool) == 0 {
        return;
    };
    tick_at(spool, 0);
}
