// invariant-watcher.ag — Monitor colony (Dark Factory federation).
//
// Continuously evaluates DERIVED protocol invariants against CURRENT on-chain
// state and flags a violation (or a thin margin-to-violation) as a candidate
// anomaly. NON-custodial / read-only: it only READS chain state via `cast`/RPC
// over `exec sh` — it never signs a transaction and never touches funds.
//
// The signal is a FACT (an on-chain read + a deterministic comparison), never an
// LLM opinion. Emission is gated PURELY on the ADR-0001 tier of this agent (the
// false-positive control):
//   shadow / dormant -> observe + learn a baseline, NO emit (learning the
//                       protocol's normal state before it is trusted to page);
//   propose          -> contribute the signal to the coordinator's fused
//   review-gated /       alert (a DRAFT-grade contribution at propose, a
//   autonomous           page-grade one at review-gated+). NO direct page:
//                        the cross-daemon bus is #961-blind, so the
//                        coordinator's `monitor:alert:pending` store
//                        hand-off is the ONE delivery path (#1891).
// One tier() call per tick, branch once, fall through to shadow/dormant.
//
// Env contract (all read via getenv; the coordinator + scripts/start-colony.sh
// export them; add each to exec.env_passthrough in .agentis/config so the
// sandboxed `exec sh` can read them):
//   MONITOR_CAST        path to the `cast` binary (foundry) used for the read;
//                       "" => the watcher has no reader and observes nothing.
//   MONITOR_RPC_URL     the chain RPC endpoint `cast` reads from (read-only).
//   MONITOR_TARGET      the target protocol contract address (0x...).
//   MONITOR_INV_LHS_SIG the `cast call` function signature whose return is the
//                       invariant's LEFT-hand quantity (e.g. "totalSupply()").
//   MONITOR_INV_RHS_SIG the function signature for the RIGHT-hand quantity
//                       (e.g. "totalAssets()"); "" => RHS is the literal bound
//                       MONITOR_INV_RHS_CONST instead (a fixed reserve floor).
//   MONITOR_INV_RHS_CONST a literal integer RHS bound used when RHS_SIG is "".
//   MONITOR_INV_REL     the relation that MUST hold: "le" (lhs<=rhs, e.g.
//                       solvency: supply<=assets), "ge" (lhs>=rhs), or "eq".
//                       "" => default "le".
//   MONITOR_INV_MARGIN_BP a margin-to-violation band in basis points (0..10000):
//                       when the invariant HOLDS but the gap is within this band
//                       of flipping, the watcher flags a margin warning. "" => 0
//                       (only a hard violation flags).
//   MONITOR_INV_LABEL   a human label for the invariant (for the alert body).
//   MONITOR_INV_LHS_TARGET / MONITOR_INV_RHS_TARGET
//                       (#2122) OPTIONAL per-SIDE contract address (0x...) so a
//                       CROSS-CONTRACT invariant can compare a quantity read from
//                       ONE contract against a quantity read from ANOTHER (e.g. a
//                       vault's accounting total vs a token's balance held by it).
//                       "" (or a value carrying a non-alphanumeric character) =>
//                       MONITOR_TARGET, so a single-contract invariant is
//                       byte-for-byte unchanged.
//   MONITOR_INV_LHS_ARGS / MONITOR_INV_RHS_ARGS
//                       (#2122) OPTIONAL call ARGUMENTS for that side's signature,
//                       comma- or space-separated (e.g. "0xHOLDER" for
//                       "balanceOf(address)"). At most args_max() (4)
//                       alphanumeric tokens survive; every one is shell_escape()d.
//                       "" => a zero-arg read (today's behaviour).
//   MONITOR_INV_LHS_SCALE / MONITOR_INV_RHS_SCALE
//                       (#2122) OPTIONAL integer MULTIPLIER applied to that side's
//                       reading BEFORE the comparison, so two sides carried in
//                       different decimals can be compared (e.g. "1000000000000"
//                       to lift a 6-dp reading onto an 18-dp one). A power of ten
//                       is EXACT at any magnitude; any other integer is accepted
//                       only while its MANTISSA fits scale_mantissa_max() digits,
//                       which guarantees >= 10 significant digits survive (#2142).
//                       An UNSUPPORTED scale resolves to the no-read sentinel
//                       (quiet) — never to a lossy or unscaled comparison.
//                       "" / "1" => no scaling.
//   MONITOR_CAST_READ   (#1098) OPTIONAL — path to scripts/cast-read.sh, the ONE
//                       centralized read wrapper that adds RPC FAILOVER (a comma
//                       list MONITOR_RPC_URLS, tried in order) + optional read
//                       CONSENSUS (MONITOR_RPC_CONSENSUS). When set, read_uint
//                       routes through it instead of `cast` directly; the wrapper
//                       reads the endpoint list / quorum from the environment, so
//                       failover lives in ONE place, not duplicated per watcher.
//                       "" => the legacy single-endpoint direct-`cast` read (the
//                       behaviour is byte-for-byte unchanged when unset).
//   MONITOR_INV_SPEC    (#1086) OPTIONAL — a DERIVED watch-spec for the WHOLE
//                       invariant SET of the target (run-live-watch.sh emits it
//                       once from the invariant-prover derivation path). Either an
//                       absolute PATH to a JSON file, or the JSON array INLINE. The
//                       array holds one object per invariant:
//                         {"label","lhs_sig","rhs_sig","rhs_const","rel","margin_bp",
//                          "lhs_target","rhs_target","lhs_args","rhs_args",
//                          "lhs_scale","rhs_scale"}
//                       (rhs_sig OR rhs_const per entry; rel in le|ge|eq). The six
//                       #2122 per-side fields are OPTIONAL and mirror the
//                       MONITOR_INV_*_TARGET / _ARGS / _SCALE env keys above with
//                       the same "unset => today's behaviour" rule: no target =>
//                       MONITOR_TARGET, no args => a zero-arg read, no scale => no
//                       scaling.
//                       When SET, the watcher evaluates EVERY invariant in the set
//                       against live state each tick (the set path); when UNSET it falls
//                       back to the single MONITOR_INV_* env contract above (the
//                       legacy path is byte-for-byte unchanged). .ag has no loops,
//                       so the set is walked by BOUNDED RECURSION over the array
//                       indices (cap MONITOR_INV_SPEC_MAX entries), per the
//                       single-assignment reduce/recursion convention.
// Writes: "monitor:signal:invariant" (the coordinator's blackboard fusion input
//   — the ONLY output of this watcher; the coordinator alone writes the
//   delivered alert to `monitor:alert:pending`, #1891).

cb 90000;

// Upper bound on how many invariants the set path walks in one tick (the bounded
// recursion's depth cap, since .ag has no loops and the runtime exposes no
// json-array-length builtin). A derived watch-spec for one target is a small,
// curated set; 64 is far above any realistic per-target invariant count and keeps
// the per-tick cost bounded.
fn spec_max() -> int {
    return 64;
}

// (#2122) Upper bound on how many CALL ARGUMENTS one invariant side may carry.
// A live-watchable view takes at most a handful of selectors (a holder address, a
// token id, a market key); 4 keeps the per-read command bounded and caps the flat
// argument walk below.
fn args_max() -> int {
    return 4;
}

// (#2122) Depth cap for the digit-string zero-append used by the scale multiplier.
// 64 zeros is far beyond any on-chain decimals normalisation (1e18 is 18) and
// keeps the bounded recursion cheap; a scale needing more resolves to no-read.
fn pad_max() -> int {
    return 64;
}

// --- env facts -----------------------------------------------------------------
fn rel_or_default(raw: string) -> string {
    if len(raw) == 0 { return "le"; }
    return raw;
}

fn label_or_sig(raw: string, lhs: string) -> string {
    if len(raw) > 0 { return raw; }
    return lhs;
}

// The centralized read wrapper (#1098): scripts/cast-read.sh, the ONE place RPC
// failover + read consensus live. "" => no wrapper, use the legacy direct `cast`.
fn cast_reader() -> string {
    return getenv("MONITOR_CAST_READ");
}

// --- read a single uint return from an on-chain view via cast call -------------
// `cast call --rpc-url <url> <addr> <sig>` prints one 0x-hex word; `cast --to-dec`
// renders it as a decimal integer string. EVERY dynamic value (the cast path, the
// rpc url, the address, the function signature) is shell_escape()d — they are all
// operator/coordinator-supplied facts that flow into a shell, so none may be a
// bare concat. `set +e` + `|| true` so a transient RPC failure returns "" (no
// reading -> no false flag) instead of aborting the tick. Returns the decimal
// string, or "" on any failure / empty reader.
//
// #1098: when MONITOR_CAST_READ is set, route through scripts/cast-read.sh so RPC
// FAILOVER (MONITOR_RPC_URLS) + read CONSENSUS (MONITOR_RPC_CONSENSUS) apply in
// ONE place — the wrapper reads the endpoint list / quorum from the environment,
// emits the no-read sentinel (empty + non-zero) only when ALL endpoints fail, and
// `|| true` keeps the tick alive. With it unset the legacy single-endpoint direct
// `cast` read below runs unchanged.
//
// #2122: `args` is the side's CALL ARGUMENT list, already shell_escape()d and
// space-PREFIXED by args_string() ("" for a zero-arg view). It is appended verbatim
// after the signature in BOTH branches, so with no arguments the emitted command
// string is byte-identical to the one this function has always produced.
fn read_uint(castBin: string, rpc: string, addr: string, sig: string, args: string) -> string {
    if len(castBin) == 0 { return ""; }
    if len(rpc) == 0 { return ""; }
    if len(addr) == 0 { return ""; }
    if len(sig) == 0 { return ""; }
    let reader = cast_reader();
    if len(reader) > 0 {
        // colony-lint: safe-exec-concat
        return exec sh "set +e; " + shell_escape(reader) + " --to-dec call "
            + shell_escape(addr) + " " + shell_escape(sig) + args + " 2>/dev/null || true";
    }
    // colony-lint: safe-exec-concat
    let out = exec sh "set +e; " + shell_escape(castBin) + " call --rpc-url " + shell_escape(rpc)
            + " " + shell_escape(addr) + " " + shell_escape(sig) + args
            + " 2>/dev/null | " + shell_escape(castBin) + " --to-dec 2>/dev/null || true";
    return out;
}

// (#2122) Build the ALREADY-ESCAPED, space-prefixed argument list read_uint()
// appends after the signature. ONE function serves BOTH sources: the spec array's
// raw JSON subtree (json_get_raw -> `["0x..","25"]`) and the env value's
// comma/space-separated list ("0x..,25") — a single FLAT regex_split over the
// JSON/list punctuation yields the same token sequence for both. The flat split is
// deliberate: a per-element `.ag` walk of the array costs ~70+ CB/element (#1587),
// which a per-tick read path cannot afford.
//
// Every surviving token is shell_escape()d, and any token carrying a
// NON-ALPHANUMERIC character is DROPPED — an address, an unsigned integer and a
// bytes32 word are all alphanumeric once the punctuation is split away, so nothing
// structural (a quote, a `$`, a `;`) can ever reach the shell. At most args_max()
// tokens survive. "" -> "" (the zero-arg read).
fn args_string(raw: string) -> string {
    if len(raw) == 0 { return ""; }
    return reduce(regex_split("[\\[\\], \"\\n\\t]+", raw), |acc: string, seg: string| -> string {
        if len(seg) == 0 { return acc; }
        if len(regex_find_all("[^A-Za-z0-9]", seg)) > 0 { return acc; }
        if len(regex_find_all(" ", acc)) >= args_max() { return acc; }
        return acc + " " + shell_escape(seg);
    }, "");
}

// (#2122) Resolve one side's READ ADDRESS: the per-side value when it is present
// AND alphanumeric (a malformed address must never reach the shell as a target),
// else the colony-wide fallback (MONITOR_TARGET). Total.
fn target_or(raw: string, fallback: string) -> string {
    if len(raw) == 0 { return fallback; }
    if len(regex_find_all("[^A-Za-z0-9]", raw)) > 0 { return fallback; }
    return raw;
}

// Trim the trailing newline cast leaves on its decimal output, leaving only digits.
// #2122: also cut at the first SPACE. A TYPED return signature ("totalSupply()(uint256)")
// makes `cast` print `<dec> [<sci>]` (e.g. `1000000000000000000000 [1e21]`), and
// reading_to_dec() rejects any non-digit — so without this cut every typed-return
// signature (the shape the monitoring watch-specs use) silently degraded to the
// no-read sentinel. A plain decimal / hex word has no space, so this is a no-op there.
fn first_token(s: string) -> string {
    let nl = index_of(s, "\n");
    let head = if nl < 0 { s } else { substring(s, 0, nl) };
    let sp = index_of(head, " ");
    if sp < 0 { return head; }
    return substring(head, 0, sp);
}

// --- big-number-safe wei handling (NO bare parse_int on the raw reading) -------
// A realistic on-chain quantity is in wei: a $100M vault's totalAssets() ≈ 1e26,
// far beyond the i64 range (~9.2e18, ≈ 9.22 ETH at 18 dp) parse_int can hold —
// parse_int SATURATES such a value to 0, so totalAssets() and totalSupply() BOTH
// read as 0, verdict_of(0,0,ge) returns "ok", and the watcher reported every real
// protocol healthy regardless of true state (solvency-blind). The two invariant
// sides are therefore kept as DECIMAL STRINGS and, when they exceed 18 digits,
// SCALED DOWN by truncating the SAME number of low-order digits from BOTH (the
// relation / ratio is preserved) BEFORE any parse_int — so every parse_int below
// operates on a value guaranteed to fit i64. Mirrors the proven liquidity-watcher
// / flow-watcher / prospector value-scorer idiom. (#1109.)

// Strip leading zeros from a digit string, leaving at least one digit ("0").
fn strip_leading_zeros(s: string) -> string {
    let kept = reduce(regex_find_all("[0-9]", s), |acc: string, d: string| -> string {
        if len(acc) > 0 { return acc + d; }
        if d == "0" { return acc; }
        return d;
    }, "");
    if len(kept) == 0 { return "0"; }
    return kept;
}

// Normalise a raw decimal reading to a clean digit string (leading zeros stripped).
// "" / non-numeric -> "" (the "no reading" sentinel, distinct from a legitimate
// "0"). Total. Mirrors prospector/value-scorer.ag's reading_to_dec.
fn reading_to_dec(s: string) -> string {
    let t = first_token(s);
    if len(t) == 0 { return ""; }
    if len(regex_find_all("[^0-9]", t)) > 0 { return ""; }
    return strip_leading_zeros(t);
}

// The most significant digits a scaled value may keep so parse_int never wraps:
// i64 max is 19 digits (9223372036854775807); 18 digits (<1e18) always fits.
fn max_safe_digits() -> int {
    return 18;
}

// (#2142) The longest NON-power-of-ten scale mantissa mul_dec() will apply. The
// mantissa is the only part of a scale that costs precision (the 10^zeros part is an
// exact zero-append), and it costs exactly its own length out of the
// max_safe_digits() budget — so an 8-digit cap GUARANTEES at least 10 significant
// digits survive every accepted scale, six orders finer than the margin_bp (1e-4)
// comparison granularity. Real decimals-normalisation scales are powers of ten or
// have a 1-2 digit mantissa; a longer one is a misconfiguration, and a
// misconfiguration must be LOUDLY quiet (no-read) rather than silently lossy — the
// previous guard only stopped an i64 overflow, so a 17-digit mantissa still computed
// a value with ~19 % relative error (#2142).
fn scale_mantissa_max() -> int {
    return 8;
}

// How many low-order digits must be dropped so BOTH `a` and `b` fit i64: the
// excess of the LONGER string over max_safe_digits(), clamped to >= 0. The SAME
// drop is applied to both, so the relation / margin-bp ratio is preserved.
fn excess_digits(a: string, b: string) -> int {
    let longest = if len(a) > len(b) { len(a) } else { len(b) };
    let excess = longest - max_safe_digits();
    if excess < 0 { return 0; }
    return excess;
}

// Truncate the `drop` low-order digits off a digit string (scale down by 10^drop).
// The "" no-read sentinel is PRESERVED (a missing value must stay missing through
// scaling — never become "0"). A real value whose every digit is dropped scales to
// dust "0". Total.
fn scale_dec(s: string, drop: int) -> string {
    if len(s) == 0 { return ""; }
    if drop <= 0 { return s; }
    if drop >= len(s) { return "0"; }
    return substring(s, 0, len(s) - drop);
}

// (#2122) Append `n` zeros to a digit string — a scale-UP by 10^n, done as a
// digit-string operation so no parse_int ever sees a wei magnitude. Bounded by the
// caller against pad_max(); n <= 0 is the identity.
fn pad_zeros(s: string, n: int) -> string {
    if n <= 0 { return s; }
    return pad_zeros(s + "0", n - 1);
}

// (#2122) Drop a digit string's TRAILING zeros, leaving its mantissa ("1000" -> "1",
// "2500" -> "25", "0" -> "0"). Used to factor a scale into mantissa x 10^zeros so the
// 10^zeros part is applied EXACTLY (a zero-append) and only the small mantissa costs
// precision. Bounded by the caller (the scale is length-checked first).
fn strip_trailing_zeros(s: string) -> string {
    if len(s) <= 1 { return s; }
    if substring(s, len(s) - 1, len(s)) != "0" { return s; }
    return strip_trailing_zeros(substring(s, 0, len(s) - 1));
}

// (#2122) Apply a per-side integer SCALE multiplier to a reading, as a digit-string
// operation. Two sides of a cross-contract invariant are often carried in different
// decimals (a 6-dp stablecoin balance vs an 18-dp share total), so one side must be
// lifted BEFORE the comparison — and it must happen before the symmetric #1109
// excess_digits/scale_dec normalisation, whose whole guarantee is that both sides
// were already made comparable.
//
// The scale is factored as `mantissa x 10^zeros`:
//   * the 10^zeros part is a pure zero-append -> EXACT at any magnitude, which is
//     the shape every decimals normalisation takes (1e12, 1e18, ...);
//   * the mantissa is applied with the same pre-truncate/multiply/re-pad idiom the
//     #1105/#1109 big-decimal handling uses, so no parse_int ever sees more than
//     max_safe_digits() digits. It costs exactly len(mantissa) significant digits,
//     and mantissas longer than scale_mantissa_max() are REFUSED — so every scale
//     this function accepts leaves at least
//     max_safe_digits() - scale_mantissa_max() = 10 significant digits, six orders
//     finer than the margin_bp (1e-4) comparison granularity. That is an ENFORCED
//     guarantee, not a claim about "realistic" inputs (#2142).
// Total, and QUIET on anything it cannot do precisely enough: an empty / non-numeric
// scale leaves the reading UNCHANGED, while a scale it cannot represent (a mantissa
// longer than scale_mantissa_max(), or more zeros than pad_max()) resolves to the
// "" no-read sentinel + a diagnostic — never to a silently lossy or unscaled
// comparison that could page a false `violated`. "" (no reading) stays "".
fn mul_dec(dec: string, scaleRaw: string) -> string {
    if len(dec) == 0 { return ""; }
    if len(scaleRaw) == 0 { return dec; }
    if len(regex_find_all("[^0-9]", scaleRaw)) > 0 { return dec; }
    let scale = strip_leading_zeros(scaleRaw);
    if scale == "0" { return dec; }
    if scale == "1" { return dec; }
    if len(scale) > pad_max() {
        print("invariant-watcher: scale " + scale + " exceeds the " + to_string(pad_max()) + "-digit cap -> no-read");
        return "";
    }
    let mant = strip_trailing_zeros(scale);
    let zeros = len(scale) - len(mant);
    if mant == "1" { return pad_zeros(dec, zeros); }
    if len(mant) > scale_mantissa_max() {
        print("invariant-watcher: scale " + scale + " has a " + to_string(len(mant))
            + "-digit mantissa (max " + to_string(scale_mantissa_max()) + ") -> no-read");
        return "";
    }
    // Truncate just enough low-order digits off the reading that the product still
    // fits i64, multiply, then re-append what was truncated plus the factored zeros.
    let excess = len(dec) + len(mant) - max_safe_digits();
    let drop = if excess > 0 { excess } else { 0 };
    if drop + zeros > pad_max() {
        print("invariant-watcher: scale " + scale + " on a " + to_string(len(dec)) + "-digit reading exceeds the pad cap -> no-read");
        return "";
    }
    return pad_zeros(to_string(parse_int(scale_dec(dec, drop)) * parse_int(mant)), drop + zeros);
}

// Parse a SCALED (<= 18-digit) digit string to int; "" -> -1 (the "no reading"
// sentinel, distinct from a legitimate 0). parse_int is total and, post-scaling,
// never overflows.
fn scaled_to_int(s: string) -> int {
    if len(s) == 0 { return -1; }
    return parse_int(s);
}

// Resolve the RHS quantity as a big-number-safe DIGIT STRING: a live read of
// RHS_SIG when present, else the literal MONITOR_INV_RHS_CONST. Returns "" (the
// "no reading" sentinel) when neither yields a numeric value.
fn resolve_rhs_dec(castBin: string, rpc: string, addr: string, rhsSig: string, rhsConst: string, args: string) -> string {
    if len(rhsSig) > 0 {
        return reading_to_dec(read_uint(castBin, rpc, addr, rhsSig, args));
    }
    if len(rhsConst) == 0 { return ""; }
    if len(regex_find_all("[^0-9]", rhsConst)) > 0 { return ""; }
    return strip_leading_zeros(rhsConst);
}

// margin_bp may be absent / non-numeric (=> 0). A basis-point band (0..10000)
// always fits i64, so a bare parse_int is safe here. "" / non-numeric -> 0.
fn margin_int(raw: string) -> int {
    if len(raw) == 0 { return 0; }
    if len(regex_find_all("[^0-9]", raw)) > 0 { return 0; }
    return parse_int(raw);
}

// --- the deterministic invariant verdict (a FACT, never an LLM call) -----------
// "violated" when the required relation does NOT hold; "margin" when it holds but
// the gap is within MONITOR_INV_MARGIN_BP basis points of flipping; "ok" when it
// holds comfortably; "no-read" when either side could not be read. lhs/rhs are
// already SCALED to fit i64 (the same drop applied to both, so the relation +
// margin ratio are preserved).
fn within_margin(lhs: int, rhs: int, rel: string, marginBp: int) -> bool {
    if marginBp <= 0 { return false; }
    if rhs <= 0 { return false; }
    // gap_bp = |lhs - rhs| / (rhs / 10000) ; flag when the holding side is within
    // marginBp of equality (the point the relation flips). DIVISION-FIRST: a
    // `|lhs - rhs| * 10000 / rhs` ratio overflows i64 even for an in-range 18-digit
    // rhs, so we compute `unit = rhs / 10000` (the per-bp magnitude) FIRST and then
    // `diff / unit` — no large multiply, no overflow. An rhs below 10000 (after
    // scaling) is dust: `unit < 1` -> treat as within margin (a tiny denominator).
    let diff = if lhs >= rhs { lhs - rhs } else { rhs - lhs };
    let unit = rhs / 10000;
    if unit < 1 { return true; }
    let gapBp = diff / unit;
    return gapBp <= marginBp;
}

fn invariant_holds(lhs: int, rhs: int, rel: string) -> bool {
    if rel == "le" { return lhs <= rhs; }
    if rel == "ge" { return lhs >= rhs; }
    if rel == "eq" { return lhs == rhs; }
    return lhs <= rhs;
}

fn verdict_of(lhs: int, rhs: int, rel: string, marginBp: int) -> string {
    if lhs < 0 { return "no-read"; }
    if rhs < 0 { return "no-read"; }
    if !invariant_holds(lhs, rhs, rel) { return "violated"; }
    if within_margin(lhs, rhs, rel, marginBp) { return "margin"; }
    return "ok";
}

// learn() outcome enum {success,failure,partial,timeout,error}. A clean hold is a
// confirmed-healthy observation (success); a violation is the anomaly the watcher
// exists to catch (failure); a margin is a partial (holding but thin); a missing
// read is an error (the reader could not produce a fact this tick).
fn outcome_of(verdict: string) -> string {
    if verdict == "ok" { return "success"; }
    if verdict == "violated" { return "failure"; }
    if verdict == "margin" { return "partial"; }
    return "error";
}

// Is this verdict worth surfacing as an alert at all (vs a healthy/quiet tick)?
fn is_anomaly(verdict: string) -> bool {
    if verdict == "violated" { return true; }
    if verdict == "margin" { return true; }
    return false;
}

// The lhs / rhs reported in the payload: the full (UN-scaled) digit string, or
// "-1" for a no-read (the sentinel, mirroring the sibling watchers' convention).
// Carried as a JSON STRING because a wei magnitude (>1e18) overflows the JSON
// number parser downstream (the prospector value-scorer / liquidity-watcher
// convention).
fn value_for_json(s: string) -> string {
    if len(s) == 0 { return "-1"; }
    return s;
}

// A compact, deterministic alert payload (JSON). All fields are facts the watcher
// computed; none is LLM text. `sev` is set by the tier branch (draft vs page).
// lhs/rhs are the full (UN-scaled) wei digit strings, quoted (see value_for_json).
fn alert_payload(label: string, verdict: string, lhs: string, rhs: string, rel: string, addr: string, sev: string) -> string {
    return "{\"watcher\":\"invariant\",\"invariant\":\"" + json_escape_string(label) + "\",\"verdict\":\"" + verdict
         + "\",\"lhs\":\"" + value_for_json(lhs) + "\",\"rhs\":\"" + value_for_json(rhs) + "\",\"rel\":\"" + rel
         + "\",\"target\":\"" + json_escape_string(addr) + "\",\"severity\":\"" + sev + "\"}";
}

// === #1086 — DERIVED watch-spec (multi-invariant SET) path =====================
// Everything below is ADDITIVE: it fires only when MONITOR_INV_SPEC is set. With
// it unset, tick() takes the unchanged single-invariant env path above.

// Resolve MONITOR_INV_SPEC to the JSON array text. The env value is either the
// JSON INLINE (first non-space char `[`) or an absolute PATH to the JSON file the
// derivation step (run-live-watch.sh) wrote. A path is read through the sandboxed
// reader; the path is the ONLY dynamic value in the shell, so it is shell_escape()d
// (operator/derivation-supplied — never a bare concat). `set +e` + `|| true` so a
// missing/unreadable file degrades to "" (no spec -> no set path), never an abort.
fn read_spec_file(path: string) -> string {
    if len(path) == 0 { return ""; }
    // colony-lint: safe-exec-concat
    return exec sh "set +e; cat -- " + shell_escape(path) + " 2>/dev/null || true";
}

// First non-whitespace character of the raw env value, used to tell inline JSON
// (`[`) from a filesystem path. Total: "" stays "".
fn first_nonspace(s: string) -> string {
    let trimmed = reduce(regex_find_all("[^ \t\r\n]", s), |acc: string, c: string| -> string {
        if len(acc) > 0 { return acc; }
        return c;
    }, "");
    return trimmed;
}

fn resolve_spec(raw: string) -> string {
    if len(raw) == 0 { return ""; }
    if first_nonspace(raw) == "[" { return raw; }
    return read_spec_file(raw);
}

// Pull one field of the i-th invariant object out of the spec array. A miss
// (index out of range, or an absent field) is json_get -> Void -> "void", which
// we collapse to "" — the same total-on-failure idiom the env path uses for an
// empty reading. The path is built from a controlled index + a fixed field name,
// so it carries no untrusted text into json_get's selector.
fn spec_field(spec: string, i: int, field: string) -> string {
    let v = to_string(json_get(spec, "[" + to_string(i) + "]." + field));
    if v == "void" { return ""; }
    return v;
}

// margin_bp may be absent (=> 0) or non-numeric (=> 0); margin_int is total. A
// basis-point band always fits i64, so no scaling is needed.
fn spec_margin(spec: string, i: int) -> int {
    return margin_int(spec_field(spec, i, "margin_bp"));
}

// (#2122) The i-th invariant's per-SIDE read address ("lhs" / "rhs"): the entry's
// own <side>_target when it is present and alphanumeric, else `fallback`
// (MONITOR_TARGET). An entry with no per-side target therefore reads exactly where
// it reads today.
fn side_target(spec: string, i: int, side: string, fallback: string) -> string {
    return target_or(spec_field(spec, i, side + "_target"), fallback);
}

// (#2122) The i-th invariant's per-SIDE call arguments, escaped and space-prefixed.
// The <side>_args field is a JSON ARRAY, so it is pulled as a RAW subtree
// (json_get_raw, flat) and tokenised by args_string's single split — never by a
// per-element .ag walk, which would cost ~70+ CB per argument (#1587). An absent
// field yields "" -> a zero-arg read.
fn side_args(spec: string, i: int, side: string) -> string {
    return args_string(json_get_raw(spec, "[" + to_string(i) + "]." + side + "_args"));
}

// The per-invariant LIVE verdict for the i-th entry: read LHS (always a sig), read
// RHS (a sig when rhs_sig is present, else the rhs_const literal) — BOTH as
// big-number-safe DIGIT STRINGS — SCALE both down by the SAME drop so neither wraps
// to 0, then the SAME deterministic verdict_of() the single-invariant path uses. A
// FACT, never an LLM call. rel "" defaults to "le" via rel_or_default, matching the
// env path.
//
// #2122: each side is resolved INDEPENDENTLY first — its own contract address
// (side_target, defaulting to `addr` = MONITOR_TARGET), its own call arguments
// (side_args) and its own decimals-normalising multiplier (mul_dec, applied BEFORE
// the symmetric excess_digits/scale_dec normalisation below, which is untouched).
// An entry carrying none of the six fields resolves to exactly today's behaviour.
fn spec_verdict(castBin: string, rpc: string, addr: string, spec: string, i: int) -> string {
    let lhsSig = spec_field(spec, i, "lhs_sig");
    let rhsSig = spec_field(spec, i, "rhs_sig");
    let rhsConst = spec_field(spec, i, "rhs_const");
    let rel = rel_or_default(spec_field(spec, i, "rel"));
    let marginBp = spec_margin(spec, i);
    let lhsAddr = side_target(spec, i, "lhs", addr);
    let rhsAddr = side_target(spec, i, "rhs", addr);
    let lhsDec = mul_dec(reading_to_dec(read_uint(castBin, rpc, lhsAddr, lhsSig, side_args(spec, i, "lhs"))),
                         spec_field(spec, i, "lhs_scale"));
    let rhsDec = mul_dec(resolve_rhs_dec(castBin, rpc, rhsAddr, rhsSig, rhsConst, side_args(spec, i, "rhs")),
                         spec_field(spec, i, "rhs_scale"));
    let drop = excess_digits(lhsDec, rhsDec);
    let lhs = scaled_to_int(scale_dec(lhsDec, drop));
    let rhs = scaled_to_int(scale_dec(rhsDec, drop));
    return verdict_of(lhs, rhs, rel, marginBp);
}

// The i-th invariant's human label, falling back to its lhs_sig (the env path's
// label_or_sig rule), then to a positional "inv-<i>" when both are empty.
fn spec_label(spec: string, i: int) -> string {
    let label = label_or_sig(spec_field(spec, i, "label"), spec_field(spec, i, "lhs_sig"));
    if len(label) > 0 { return label; }
    return "inv-" + to_string(i);
}

// FUSE two per-invariant verdicts into the worse of the two — the SET's verdict is
// the most severe across all its invariants, so one violation pages the whole set.
// Order of severity: violated > margin > ok > no-read (a side that could not be
// read is the quietest — it raises no false alarm, exactly like the env path).
fn verdict_rank(verdict: string) -> int {
    if verdict == "violated" { return 3; }
    if verdict == "margin" { return 2; }
    if verdict == "ok" { return 1; }
    return 0;
}

fn worse_verdict(a: string, b: string) -> string {
    if verdict_rank(a) >= verdict_rank(b) { return a; }
    return b;
}

// A memo key must be non-empty, start alnum, and contain only [A-Za-z0-9_:.-]. An
// invariant label is free text (e.g. "totalSupply()"), whose `(`/`)`/space would be
// illegal in a key, so the label's key SUFFIX is sanitized: every run of
// disallowed chars collapses to a single "_" (regex_split on the disallowed class,
// rejoined with "_"). The prefix "monitor:signal:invariant:" supplies the required
// leading alnum + the `:` separators, so only the suffix needs cleaning. The JSON
// payload still carries the ORIGINAL label verbatim — only the key is sanitized.
fn signal_key_label(label: string) -> string {
    return reduce(regex_split("[^A-Za-z0-9_.-]", label), |acc: string, seg: string| -> string {
        if len(acc) == 0 { return seg; }
        if len(seg) == 0 { return acc + "_"; }
        return acc + "_" + seg;
    }, "");
}

// One per-invariant blackboard signal, posted under monitor:signal:invariant:<label>
// so the coordinator (or an operator) can see the SET broken down by member while
// the fused monitor:signal:invariant stays the single fused fact it already reads.
// A memo write — allowed at every tier, including shadow. The key suffix is the
// sanitized label; the payload carries the original label.
//
// #2122: the payload also names the two RESOLVED per-side addresses, so an operator
// reading a cross-contract member can see WHICH contract each side came from. The
// FUSED monitor:signal:invariant payload is deliberately unchanged — coordinator.ag
// reads only that key, so the #1891 delivery hand-off is untouched.
fn post_signal(label: string, verdict: string, addr: string, lhsAddr: string, rhsAddr: string) -> void {
    memo_write("monitor:signal:invariant:" + signal_key_label(label),
        "{\"watcher\":\"invariant\",\"invariant\":\"" + json_escape_string(label) + "\",\"verdict\":\"" + verdict
        + "\",\"target\":\"" + json_escape_string(addr)
        + "\",\"lhs_target\":\"" + json_escape_string(lhsAddr)
        + "\",\"rhs_target\":\"" + json_escape_string(rhsAddr) + "\",\"severity\":\"info\"}");
}

// BOUNDED RECURSION over the spec array (single-assignment .ag has no while/for):
// at each index i evaluate the i-th invariant LIVE, post its per-invariant signal,
// and fold its verdict into the running fused verdict. Stops at the first absent
// label (end of array) or at the spec_max() cap, so a missing json_len builtin is
// not a hazard. Returns the fused (worst) verdict across the whole set; "no-read"
// when the set is empty / unreadable (no spec -> no fact -> no flag).
fn fuse_set(castBin: string, rpc: string, addr: string, spec: string, i: int, remaining: int, acc: string) -> string {
    if remaining <= 0 { return acc; }
    let label = spec_label(spec, i);
    if len(spec_field(spec, i, "lhs_sig")) == 0 { return acc; }
    let verdict = spec_verdict(castBin, rpc, addr, spec, i);
    let _sig = post_signal(label, verdict, addr,
        side_target(spec, i, "lhs", addr), side_target(spec, i, "rhs", addr));
    print("invariant-watcher: [set] " + label + " -> " + verdict);
    return fuse_set(castBin, rpc, addr, spec, i + 1, remaining - 1, worse_verdict(acc, verdict));
}

// Count the invariants the set path actually evaluated (for the fused label/log) —
// same bounded walk, no live reads. Stops at the first entry with no lhs_sig.
fn count_set(spec: string, i: int, remaining: int, acc: int) -> int {
    if remaining <= 0 { return acc; }
    if len(spec_field(spec, i, "lhs_sig")) == 0 { return acc; }
    return count_set(spec, i + 1, remaining - 1, acc + 1);
}

fn tick(reason: string) -> void {
    let now = to_string(now_ms());
    // Heartbeat first so the dashboard's memo-freshness probe sees the daemon
    // alive even when the reader is unconfigured and the tick early-returns.
    memo_write("invariant-watcher:last_check", now);

    let castBin = getenv("MONITOR_CAST");
    let rpc = getenv("MONITOR_RPC_URL");
    let addr = getenv("MONITOR_TARGET");

    // #1086: when MONITOR_INV_SPEC is set, evaluate the DERIVED invariant SET; else
    // fall through to the single MONITOR_INV_* env contract (byte-identical legacy
    // path). resolve_spec() yields the JSON array (inline or file-read), "" when
    // unset/unreadable -> the env path. ONE branch, no `let` reassignment: every
    // downstream fact (label, rel, lhs, rhs, verdict) is picked here via `if`.
    let spec = resolve_spec(getenv("MONITOR_INV_SPEC"));
    let useSet = len(spec) > 0;

    // --- single-invariant env facts (the legacy path; only used when !useSet) ---
    let lhsSig = getenv("MONITOR_INV_LHS_SIG");
    let rhsSig = getenv("MONITOR_INV_RHS_SIG");
    let rhsConst = getenv("MONITOR_INV_RHS_CONST");
    let marginBp = margin_int(getenv("MONITOR_INV_MARGIN_BP"));

    // #2122 per-SIDE env facts (env path only). Each falls back to today's value:
    // no per-side target => MONITOR_TARGET, no args => a zero-arg read (the emitted
    // command string is then byte-identical to the one this agent has always run),
    // no scale => the reading is passed through unchanged.
    let lhsAddr = target_or(getenv("MONITOR_INV_LHS_TARGET"), addr);
    let rhsAddr = target_or(getenv("MONITOR_INV_RHS_TARGET"), addr);
    let lhsArgs = args_string(getenv("MONITOR_INV_LHS_ARGS"));
    let rhsArgs = args_string(getenv("MONITOR_INV_RHS_ARGS"));

    // The relation reported in the alert body. The SET fuses many relations, so the
    // fused body reports "set"; the env path reports its single configured relation.
    let rel = if useSet { "set" } else { rel_or_default(getenv("MONITOR_INV_REL")) };

    // The label reported in the alert body. The SET fuses many members, so it
    // reports "set(<N>)" (N = members evaluated); the env path keeps its single
    // label (operator label, else the LHS signature).
    let label = if useSet {
        "set(" + to_string(count_set(spec, 0, spec_max(), 0)) + ")"
    } else {
        label_or_sig(getenv("MONITOR_INV_LABEL"), lhsSig)
    };

    // Read the two invariant sides as big-number-safe DIGIT STRINGS (env path only;
    // on the SET path each member is read inside fuse_set()). A no-read yields the ""
    // sentinel. lhs/rhs are only meaningful on the env path; on the SET path they are
    // the "no single pair" sentinel "".
    // #2122: each side is read from its OWN address with its OWN arguments, and its
    // per-side scale multiplier is applied BEFORE the symmetric #1109 normalisation
    // below (which is unchanged).
    let lhsDec = if useSet { "" } else {
        mul_dec(reading_to_dec(read_uint(castBin, rpc, lhsAddr, lhsSig, lhsArgs)), getenv("MONITOR_INV_LHS_SCALE"))
    };
    let rhsDec = if useSet { "" } else {
        mul_dec(resolve_rhs_dec(castBin, rpc, rhsAddr, rhsSig, rhsConst, rhsArgs), getenv("MONITOR_INV_RHS_SCALE"))
    };

    // SCALE both to <= 18 digits by dropping the SAME number of low-order digits
    // (the relation + margin ratio are preserved) BEFORE any parse_int, so a 1e26
    // totalAssets()/totalSupply() never wraps to 0. A no-read ("") yields the -1
    // sentinel and is never scaled.
    let drop = excess_digits(lhsDec, rhsDec);
    let lhs = scaled_to_int(scale_dec(lhsDec, drop));
    let rhs = scaled_to_int(scale_dec(rhsDec, drop));

    // The VERDICT (a FACT, never an LLM call). SET path: the fused (worst) verdict
    // across every member, with each member ALSO posted to its own per-invariant
    // blackboard signal inside fuse_set(). Env path: the single deterministic
    // verdict over the two SCALED configured sides.
    let verdict = if useSet {
        fuse_set(castBin, rpc, addr, spec, 0, spec_max(), "no-read")
    } else {
        verdict_of(lhs, rhs, rel, marginBp)
    };
    let outcome = outcome_of(verdict);

    print("invariant-watcher: " + label + " " + rel + " -> " + verdict
        + " (lhs=" + value_for_json(lhsDec) + " rhs=" + value_for_json(rhsDec) + ", conf=" + to_string(confidence_value("invariant-watcher")) + ")");

    let key = label + ":" + addr;
    let desc = "on-chain invariant " + label + " " + rel + " -> " + verdict;
    let anomaly = is_anomaly(verdict);

    // Post this watcher's latest (fused, on the SET path) verdict to the shared
    // blackboard memo the coordinator reads each tick to fuse + dedup signals (a
    // memo write — allowed at every tier, including shadow). The payload is the same
    // fact JSON the emit carries, with a neutral severity the coordinator re-decides
    // on fusion. The per-invariant signals (monitor:signal:invariant:<label>) are
    // posted inside fuse_set(); this fused signal stays the single fact the existing
    // coordinator already consumes (backward-compatible). lhs/rhs carry the full
    // (UN-scaled) wei magnitudes as quoted JSON strings.
    memo_write("monitor:signal:invariant", alert_payload(label, verdict, lhsDec, rhsDec, rel, addr, "info"));

    // ONE tier() call, branch ONCE (ADR-0001). The tier gates EMISSION only; the
    // verdict above is unchanged by tier. shadow/dormant fall through to observe.
    // (.ag has no `else if`; the tiers nest as `else { if ... { } else { } }`.)
    let my_tier = tier("invariant-watcher");
    if my_tier == "autonomous" {
        // Proven reliable -> the anomaly feeds the coordinator's fused page.
        if anomaly {
            learn("invariant-watch", key, desc, outcome, [verdict, outcome, "acted"]);
        } else {
            learn("invariant-watch", key, desc, outcome, [verdict, outcome, "observed"]);
        };
    } else {
        if my_tier == "review-gated" {
            // Trusted under a review gate -> the anomaly feeds the fused page.
            if anomaly {
                learn("invariant-watch", key, desc, outcome, [verdict, outcome, "review-gated"]);
            } else {
                learn("invariant-watch", key, desc, outcome, [verdict, outcome, "observed"]);
            };
        } else {
            if my_tier == "propose" {
                // Enough signal to contribute -> a DRAFT-grade contribution.
                if anomaly {
                    learn("invariant-watch", key, desc, outcome, [verdict, outcome, "emitted"]);
                } else {
                    learn("invariant-watch", key, desc, outcome, [verdict, outcome, "observed"]);
                };
            } else {
                // shadow / dormant: learn the baseline ONLY — no contribution.
                learn("invariant-watch", key, desc + " (baseline)", outcome, [verdict, outcome, "observed"]);
                print("invariant-watcher: observing (tier: " + my_tier + ") — no emit");
            };
        };
    };

    memo_write("invariant-watcher:last_check", to_string(now_ms()));
}
