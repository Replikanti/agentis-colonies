# exam-plus.env — exam.env plus the later breadth + deep knobs: the function-coverage gate (READ| traces + one
# focused re-ask cell per zone, #2256), breadth promises (PTRACE| gate, #2264), the scope-aware refute over the
# contest's own docs (#2257), and the deep-hunt time budget (parallel cells, per-cell cap, broken-target skip,
# #2258). Sized for a WHOLE-CONTEST arm (`--zone _all`): a 24 h hard stop per call.
# SCOPE_DOCS=auto (#2292): the README-aware extractor, which also finds a contest README one level above the code
# dir. It used to be `code:README.md`, which handed the README to the OPERATOR parser — that one is for a curated
# file, and it turned the README's in-scope file list into citable exclusions.
BACKEND=flat-cyborg
MODEL=claude-opus-4-8
JOBS=2
HARD_STOP_S=86400
env.SEVERITY_RUBRIC=1
env.GROUND_EVIDENCE=1
env.FUNCTION_COVERAGE=1
env.BREADTH_PROMISES=1
SCOPE_DOCS=auto
DEEP_PASS=1
deep.DEEP_HUNT_REACH=1
deep.DEEP_HUNT_PROMISES=1
deep.DEEP_HUNT_JOBS=2
deep.DEEP_HUNT_CELL_TIMEOUT_S=2700
deep.DEEP_HUNT_SKIP_BROKEN_TARGET=1
