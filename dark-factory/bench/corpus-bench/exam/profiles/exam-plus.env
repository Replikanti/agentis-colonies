# exam-plus.env — exam.env plus the later breadth + deep knobs: the function-coverage gate (READ| traces + one
# focused re-ask cell per zone, #2256), breadth promises (PTRACE| gate, #2264), the scope-aware refute over the
# contest's own README (#2257, SCOPE_DOCS resolves under the frozen code/ dir), and the deep-hunt time budget
# (parallel cells, per-cell cap, broken-target skip, #2258). Sized for a WHOLE-CONTEST arm (`--zone _all`):
# a 24 h hard stop per call.
BACKEND=flat-cyborg
MODEL=claude-opus-4-8
JOBS=2
HARD_STOP_S=86400
env.SEVERITY_RUBRIC=1
env.GROUND_EVIDENCE=1
env.FUNCTION_COVERAGE=1
env.BREADTH_PROMISES=1
SCOPE_DOCS=code:README.md
DEEP_PASS=1
deep.DEEP_HUNT_REACH=1
deep.DEEP_HUNT_PROMISES=1
deep.DEEP_HUNT_JOBS=2
deep.DEEP_HUNT_CELL_TIMEOUT_S=2700
deep.DEEP_HUNT_SKIP_BROKEN_TARGET=1
