# mock.env — the OFFLINE profile `exam.sh self-test` drives (the stub agentis, no LLM, no network). It sets no
# breadth knob on purpose: the self-test exports SEVERITY_RUBRIC=1 in its own shell and asserts the stub never
# sees it. The deep knobs prove the routing: DEEP_HUNT_REACH=1 would make the BREADTH call exit 2 (it requires
# --deep-hunt) if it leaked there.
BACKEND=mock
MODEL=claude-opus-4-8
JOBS=1
HARD_STOP_S=600
DEEP_PASS=1
deep.DEEP_HUNT_REACH=1
deep.DEEP_HUNT_PROMISES=1
