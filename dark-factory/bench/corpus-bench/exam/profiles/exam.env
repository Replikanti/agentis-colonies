# exam.env — the final-exam knob set (#2245): the contest-severity dismissal rubric + the ground-evidence
# contract on the breadth pass, then STAGE 4.5 (the deep hunt, --deep-hunt-only over the SAME breadth output)
# with concrete multi-target REACH and promise-derived invariants. Per-zone sized: 4 h hard stop per call.
BACKEND=flat-cyborg
MODEL=claude-opus-4-8
JOBS=2
HARD_STOP_S=14400
env.SEVERITY_RUBRIC=1
env.GROUND_EVIDENCE=1
DEEP_PASS=1
deep.DEEP_HUNT_REACH=1
deep.DEEP_HUNT_PROMISES=1
