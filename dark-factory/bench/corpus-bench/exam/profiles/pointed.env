# pointed.env — the #2311 pointed-ladder breadth-only arm (L1, L2, the L0 replicates, the mechanics-gate controls):
# exactly the pointed-l0.env breadth knobs, no STAGE 4.5. HARD_STOP_S=28800 is the same per-call stop as the L0
# arm, so every rung's breadth call runs under one ceiling (the measured breadth call is 77-235 min per zone).
BACKEND=flat-cyborg
MODEL=claude-opus-4-8
JOBS=2
HARD_STOP_S=28800
env.SEVERITY_RUBRIC=1
env.GROUND_EVIDENCE=1
DEEP_PASS=0
