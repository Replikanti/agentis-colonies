# control.env — the #2262 exam runner's CONTROL profile: the shipped pipeline defaults, no knob at all.
# Grammar (exam-helper.py profile): `#` comment; KEY=VALUE sets a runner key (BACKEND MODEL JOBS DEEP_JOBS
# HARD_STOP_S DEEP_PASS INJECT_CLASSES SCOPE_DOCS); env.<NAME>=<v> is exported into the breadth call only;
# deep.<NAME>=<v> into the STAGE 4.5 call only; pass.<NAME> inherits <NAME> from the caller's environment by name.
# Before a profile is applied the runner UNSETS every knob of the registry (every env./deep./pass. name of the
# shipped profiles + KNOBS), so nothing exported in the operator's shell leaks into this arm.
# No contest name and no path belongs in a profile.
BACKEND=flat-cyborg
MODEL=claude-opus-4-8
JOBS=1
HARD_STOP_S=14400
