# control.env — the #2262 exam runner's CONTROL profile: the shipped pipeline defaults, no knob at all.
# Grammar (exam-helper.py profile): `#` comment; KEY=VALUE sets a runner key (BACKEND MODEL JOBS DEEP_JOBS
# HARD_STOP_S DEEP_PASS INJECT_CLASSES SCOPE_DOCS REHUNT_TRANSPORT ATTRIB_FAMILY); env.<NAME>=<v> is exported into
# the breadth call only; deep.<NAME>=<v> into the STAGE 4.5 call only; pass.<NAME> inherits <NAME> from the
# caller's environment by name.
# Every pipeline call gets `env -u` for every knob candidate (every env name the checkout's pipeline reads + the
# shipped profiles' knobs + KNOBS names and prefixes; see KNOBS) before the profile's knobs are applied, so
# nothing exported in the operator's shell leaks into this arm. DF_NO_SANDBOX is refused outright.
# No contest name and no path belongs in a profile.
BACKEND=flat-cyborg
MODEL=claude-opus-4-8
JOBS=1
HARD_STOP_S=14400
