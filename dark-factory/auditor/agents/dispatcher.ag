cb 300000;
// dispatcher.ag — #1014 M2: the action DISPATCH, moved into the substrate for EVERY action type.
//
// WHAT MOVED. run-coordinator.sh used to route the coordinator's chosen action through a shell `case`:
// stub_outcome()/real_outcome() derived the gate verdict, then fed it back. M1 moved the `hunt` branch
// of that dispatch onto the substrate. M2 GENERALISES it: the coordinator (coordinator.ag) `emit`s the
// chosen action over the IN-PROCESS bus (`dark-factory:dispatch`, payload `<type>|<args>`) for ANY real
// action (hunt / refute / poc-screen / invent-method); THIS agent fn `listen`s it, parses the action
// `<type>`, derives the gate OUTCOME, writes it back as a DURABLE fact (`coordinator:last_outcome` memo),
// and prints an observable `DISPATCH|...` marker. The shell loop then READS the verdict from the memo
// instead of computing it in a `case` — for EVERY non-`stop` action, not just hunt.
//
// WHY emit/listen + memo (not a cross-process bus). In agentis the emit/listen bus is IN-PROCESS only:
// two separate `agentis go` invocations cannot exchange a bus event. So the coordinator's `emit` and this
// `listen` only meet when they run in the SAME `agentis go` (coordinator.ag calls dispatch() after it
// decides, gated on DISPATCH_ENABLED). The ONLY substrate-native CROSS-PROCESS channel is the durable
// memo store — so the VERDICT crosses back to the shell loop via `memo_write(coordinator:last_outcome,...)`
// + a separate `agentis memo get`. Mirrors auditor.ag's emit->listen->call DAG (reconn/guard/tracker/synth).
//
// OFFLINE/DETERMINISTIC verdict. The verdict comes from a FIXTURE (`DISPATCH_FIXTURE` env fact), NOT an LLM
// — the SAME `type|glob|outcome` shape run-coordinator.sh's `--fixture` uses, projected to an env string.
// First match wins, default `dry`. NO prompt()/network on this path. The LIVE path (no fixture set) is an
// honest per-type stub that prints what real wiring it still needs (mirrors the old real_outcome() honesty)
// and returns a benign `dry` — it does NOT attempt a real action.
//
// Env (all FACTS; none is an LLM call):
//   DISPATCH_FIXTURE  the offline verdict rules: `type|glob=verdict;type2|glob2=verdict2`, first match
//                     wins, default `dry`. <glob> is a PREFIX glob (trailing `*` optional) matched against
//                     the action ARGS (for hunt that is `subsystem|class`; for refute/poc-screen the
//                     candidate id; invent-method has empty args). An empty prefix (bare `*`) matches any
//                     args. e.g. `hunt|vault*=confirmed;refute|cand-2=refuted;invent-method|*=confirmed`.
//   HUNT_FIXTURE      backward-compat alias: when DISPATCH_FIXTURE is empty, hunt rules may still be passed
//                     in the M1 `glob=verdict;...` shape (no `type|` prefix; implicitly `hunt`). Consulted
//                     for a `hunt` action only.
//   DISPATCH_LIVE     when set (and no fixture matches a fixture set), the LIVE honest-stub path is taken.
// Bus (in-process): listen `dark-factory:dispatch`, payload `<type>|<args>`.
// Memo (durable, cross-process): write `coordinator:last_outcome` = `<type>|<args>|<verdict>`.
// Stdout marker: `DISPATCH|<type>|<args>|<verdict>`.

// --- payload parsing (single-assignment string helpers; only leaf builtins) ------------------------

// The Nth `|`-segment (0-based) of `s`, "" if absent. Single-assignment reduce: the accumulator carries
// `<nextIndex>\t<captured>`; each segment captures itself when its index equals `n`, then the tab-prefix
// is dropped to yield the field value. Leaf builtins only (kept shallow on the native call stack).
fn payload_field(s: string, n: int) -> string {
    let segs = regex_split("\\|", s);
    let acc = reduce(segs, |a: string, seg: string| -> string {
        let bar = index_of(a, "\t");
        let idx = parse_int(substring(a, 0, bar));
        let cap = substring(a, bar + 1, len(a));
        if idx == n { return to_string(idx + 1) + "\t" + seg; }
        return to_string(idx + 1) + "\t" + cap;
    }, "0\t");
    return substring(acc, index_of(acc, "\t") + 1, len(acc));
}

// The `<args>` of a `<type>|<args>` payload: everything after the FIRST `|` (so a hunt's `subsystem|class`
// stays intact as one args string). "" when there is no `|`.
fn payload_args(s: string) -> string {
    let bar = index_of(s, "|");
    if bar < 0 { return ""; }
    return substring(s, bar + 1, len(s));
}

// --- the offline FIXTURE verdict (mirrors run-coordinator.sh's --fixture semantics) ----------------

// Strip a single trailing `*` from a glob, yielding the literal prefix to match against.
fn glob_prefix(glob: string) -> string {
    let n = len(glob);
    if n == 0 { return ""; }
    if substring(glob, n - 1, n) == "*" { return substring(glob, 0, n - 1); }
    return glob;
}

// Does `args` match the PREFIX `glob` (trailing `*` optional)? An empty prefix matches anything (a bare
// `*` rule, or an empty glob — the natural match for invent-method's empty args). Otherwise the args must
// START with the prefix (index_of == 0).
fn glob_matches(glob: string, args: string) -> bool {
    let pfx = glob_prefix(glob);
    if len(pfx) == 0 { return true; }
    return index_of(args, pfx) == 0;
}

// First-match verdict for action `<type>` with `<args>` from a `type|glob=verdict;...` DISPATCH_FIXTURE.
// Each rule is `<rtype>|<glob>=<verdict>`: it applies when <rtype> equals the action type AND <glob>
// prefix-matches the args. Default `dry` when nothing matches (a benign default, exactly like the old
// stub_outcome's END rule). Single-assignment reduce; first match wins.
fn fixture_verdict(fixture: string, atype: string, args: string) -> string {
    if len(fixture) == 0 { return "dry"; }
    let hit = reduce(regex_split(";", fixture), |acc: string, rule: string| -> string {
        if len(acc) > 0 { return acc; }
        if len(rule) == 0 { return acc; }
        let eq = index_of(rule, "=");
        if eq < 0 { return acc; }
        let lhs = substring(rule, 0, eq);
        let verdict = substring(rule, eq + 1, len(rule));
        let bar = index_of(lhs, "|");
        if bar < 0 { return acc; }
        let rtype = substring(lhs, 0, bar);
        let glob = substring(lhs, bar + 1, len(lhs));
        if rtype != atype { return acc; }
        if glob_matches(glob, args) { return verdict; }
        return acc;
    }, "");
    if len(hit) == 0 { return "dry"; }
    return hit;
}

// First-match verdict for a `hunt` from the M1 `glob=verdict;...` HUNT_FIXTURE (no `type|` prefix; every
// rule is implicitly a hunt rule). Backward-compat alias consulted only when DISPATCH_FIXTURE is empty.
// The glob prefix-matches the hunt args (`subsystem|class`); default `dry`.
fn hunt_fixture_verdict(fixture: string, args: string) -> string {
    if len(fixture) == 0 { return "dry"; }
    let hit = reduce(regex_split(";", fixture), |acc: string, rule: string| -> string {
        if len(acc) > 0 { return acc; }
        if len(rule) == 0 { return acc; }
        let eq = index_of(rule, "=");
        if eq < 0 { return acc; }
        let glob = substring(rule, 0, eq);
        let verdict = substring(rule, eq + 1, len(rule));
        if glob_matches(glob, args) { return verdict; }
        return acc;
    }, "");
    if len(hit) == 0 { return "dry"; }
    return hit;
}

// Is `v` one of the three legal gate verdicts? Guards against a malformed fixture cell. Leaf compares.
fn is_verdict(v: string) -> bool {
    if v == "confirmed" { return true; }
    if v == "dry" { return true; }
    if v == "refuted" { return true; }
    return false;
}

// Is `t` a real (dispatchable) action type? `stop` is terminal and never dispatched. Leaf compares.
fn is_action(t: string) -> bool {
    if t == "hunt" { return true; }
    if t == "refute" { return true; }
    if t == "poc-screen" { return true; }
    if t == "invent-method" { return true; }
    return false;
}

// Derive the gate OUTCOME for an action of `<type>` with `<args>`. Offline (DISPATCH_FIXTURE set, or the
// M1 HUNT_FIXTURE alias for a hunt) -> the fixture rule, NO prompt()/LLM. Otherwise the LIVE path: an
// honest per-type stub that says what real wiring it needs (mirrors run-coordinator.sh::real_outcome) and
// returns a benign `dry` — it does NOT attempt a real action.
fn action_outcome(atype: string, args: string) -> string {
    let fixture = getenv("DISPATCH_FIXTURE");
    if len(fixture) > 0 {
        let v = fixture_verdict(fixture, atype, args);
        if is_verdict(v) { return v; }
        return "dry";
    }
    let huntFx = getenv("HUNT_FIXTURE");
    if atype == "hunt" {
        if len(huntFx) > 0 {
            let hv = hunt_fixture_verdict(huntFx, args);
            if is_verdict(hv) { return hv; }
            return "dry";
        }
    }
    print("dispatcher: LIVE " + atype + " of '" + args + "' needs its real wiring (hunt: TARGET_DIR/IN_SCOPE/SCOPE_BRIEF/TAXONOMY/SLICER per run-discovery.sh/hunter.ag; refute->run-refute.sh; poc-screen->screen-leads.sh; invent-method->run-method-discovery.sh); set DISPATCH_FIXTURE for the offline-deterministic path. No real action attempted.");
    return "dry";
}

// --- the dispatch agent fn: listen the chosen action, derive + record the OUTCOME, mark it -----------
// Mirrors auditor.ag's sub-agents (reconn/guard/tracker): an `agent fn` with NO `fn tick` (so it is
// exempt from the ADR-0001 tier lint and the prompt-gate lint), driven by an in-process `listen` of a
// topic a sibling `emit`ted, then CALLED at top level after the emit.
agent dispatch() -> void {
    let payload = listen("dark-factory:dispatch");
    let atype = payload_field(payload, 0);
    if !is_action(atype) {
        // Only real actions are dispatched; `stop` and any malformed payload are ignored.
        print("dispatcher: ignoring non-action dispatch payload '" + payload + "'");
        memo_write("dispatcher:last_check", "done");
        return;
    }
    let args = payload_args(payload);
    let verdict = action_outcome(atype, args);
    // Durable, cross-process: the shell loop READS this back instead of a shell `case`.
    let outcome = atype + "|" + args + "|" + verdict;
    memo_write("coordinator:last_outcome", outcome);
    // Observable marker (the demo asserts ACTION|<type>|... and DISPATCH|<type>|... in the SAME process).
    print("DISPATCH|" + atype + "|" + args + "|" + verdict);
    memo_write("dispatcher:last_check", "done");
}

// --- standalone entry: emit the chosen action over the in-process bus, then run the dispatch chain. ---
// The CANONICAL use is the gated call from coordinator.ag (which decides, then emits + calls dispatch()
// in the SAME `agentis go`). This top-level lets the agent be committed + lint-validated on its own and
// dispatched directly: it reads the chosen `<type>|<args>` from DISPATCH_ARGS, emits the
// `dark-factory:dispatch` event, and calls the chain — exactly the shape coordinator.ag inlines.
let dargs = getenv("DISPATCH_ARGS");
if len(dargs) > 0 {
    emit("dark-factory:dispatch", dargs);
    dispatch();
}
