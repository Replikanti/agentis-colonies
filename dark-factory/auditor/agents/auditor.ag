// auditor.ag — Dark Factory bounty-audit colony federation
// (skeleton, agents, structural detection, DAG distillation / dedup cache).
//
// FOUR cooperating .ag agents wired by the substrate emit/listen bus, closing the
// full audit loop ON the agentis substrate, fully offline, substrate-only — no Rust
// in core. An audit target flows over the bus with no polling:
//
//   orchestrator --emit audit:target--> reconn
//   reconn (recon + distill) --emit guard:target/guard:th/guard:cached, tracker:target-->
//   guard        --emit synth:class / synth:target / synth:th / synth:hit--> synthesis
//   tracker      --emit synth:trace--> synthesis
//   synthesis    --> compile+run PoC in the hardened sandbox --> validate --> report
//
// Run (from an initialised dir; run twice in the SAME dir to see the dedup HIT):
//   agentis go colonies/bounty/auditor.ag --enable-exec --enable-messaging --sandbox-profile hardened
//   The report + PoC artefacts land under <rundir>/.agentis/sandbox/ (file_write is sandbox-resolved).
//   (optional) BOUNTY_TARGET=<path> with exec.env_passthrough = BOUNTY_TARGET in config;
//   (optional) learning/experience/knowledge.enabled = true to publish to the knowledge_market.
//
// Killer feature (content-addressed DAG) realized as the colony's dedup cache:
//   * reconn dag_puts each handler sub-graph -> same sub-graph across targets/repos has the
//     same content hash, stored once (structural dedup); the canonical target hash `th` keys
//     a memo verdict-cache + a federation blacklist;
//   * on a cache HIT the verdict is reused and synthesis SKIPS the rustc re-compile
//     (the DAG is the cumulative dedup cache + knowledge graph, NOT the detector).

cb 2000000;

// ---- helpers: ingest ----------------------------------------------------------

// Embedded default target (vulnerable; mirrors colonies/bounty/vuln_missing_signer.rs).
fn embedded_target() -> string {
    return "pub struct AccountInfo { pub key: u64, pub is_signer: bool }\n" +
        "pub struct Vault { pub authority: u64, pub balance: u64 }\n" +
        "pub struct WithdrawCtx<'a> { pub vault: &'a mut Vault, pub authority: &'a AccountInfo }\n" +
        "pub fn withdraw(ctx: WithdrawCtx, amount: u64) -> Result<(), String> {\n" +
        "    if ctx.vault.balance < amount { return Err(\"insufficient funds\".to_string()); }\n" +
        "    ctx.vault.balance -= amount;\n" +
        "    Ok(())\n" +
        "}\n";
}

// Read the target: BOUNTY_TARGET path (cat in the sandbox) if set, else embedded.
fn ingest_target() -> string {
    let path = getenv("BOUNTY_TARGET");
    if len(path) > 0 {
        // colony-lint: safe-exec-concat
        let src = exec sh "cat ${path} 2>/dev/null || true";
        if len(src) > 0 {
            return src;
        }
        // BOUNTY_TARGET was requested but is unreadable. NEVER silently fall back to the
        // embedded demo (a vulnerable vault) — that would audit a program the operator never
        // supplied and could stage a false finding on an in-scope-safe target. Return empty
        // so detection finds nothing (-> SAFE, no synthesis, no false-VERIFIED), and say so.
        print("ingest: ERROR — BOUNTY_TARGET set but unreadable (", path, ") — auditing nothing; supply a readable absolute path. No embedded fallback when a target is requested.");
        return "";
    }
    return embedded_target();
}

// ---- helpers: structural detection -------------------------------------------

// Strip `//` line comments so they can neither forge nor mask a guard.
fn strip_comments(src: string) -> string {
    let lines = regex_split("\n", src);
    return reduce(lines, |acc: string, l: string| -> string {
        let c = index_of(l, "//");
        if c >= 0 {
            acc + substring(l, 0, c) + "\n";
        } else {
            acc + l + "\n";
        }
    }, "");
}

// min of two index_of results, ignoring -1 (absent).
fn min_present(a: int, b: int) -> int {
    if a < 0 {
        return b;
    }
    if b < 0 {
        return a;
    }
    if a < b {
        return a;
    }
    return b;
}

// Earliest state-mutation sink (`balance -=` / `balance +=`), or -1 if none.
fn sink_pos(code: string) -> int {
    return min_present(index_of(code, "balance -="), index_of(code, "balance +="));
}

// Earliest signer/authority guard construct, or -1 if none.
fn guard_pos(code: string) -> int {
    let g1 = index_of(code, ".is_signer");
    let g2 = index_of(code, "require!");
    let g3 = index_of(code, "assert!");
    let g4 = index_of(code, "has_one");
    return min_present(min_present(g1, g2), min_present(g3, g4));
}

// MissingSignerCheck (Critical): a state mutation with no DOMINATING signer guard.
// Inlined (only leaf builtins beneath it) so the per-function reduce/lambda below
// stays shallow on the native stack inside the agent block.
fn detect_missing_signer(code: string) -> bool {
    let sink = min_present(index_of(code, "balance -="), index_of(code, "balance +="));
    if sink < 0 {
        return false;
    }
    let g = min_present(min_present(index_of(code, ".is_signer"), index_of(code, "require!")), min_present(index_of(code, "assert!"), index_of(code, "has_one")));
    if g < 0 {
        return true;
    }
    if g > sink {
        return true;
    }
    return false;
}

// IntegerOverflow (Medium): unchecked `balance +=` with no checked_/saturating_.
fn detect_integer_overflow(code: string) -> bool {
    let add = index_of(code, "balance +=");
    if add < 0 {
        return false;
    }
    if index_of(code, "checked_") >= 0 {
        return false;
    }
    if index_of(code, "saturating_") >= 0 {
        return false;
    }
    return true;
}

// Per-function scoping: run each detector WITHIN a single function body (split on the
// `fn ` boundary) so a guard / checked_ in one handler cannot mask a vuln in another.
// A class fires if ANY handler chunk is vulnerable. The reduce lambda calls a single
// self-contained detector (only leaf builtins beneath it) to keep the native call
// stack shallow inside the agent block.
fn classify(code: string) -> string {
    let chunks = regex_split("fn ", code);
    let ms = reduce(chunks, |acc: bool, c: string| -> bool {
        if acc {
            return true;
        }
        return detect_missing_signer(c);
    }, false);
    if ms {
        return "MissingSignerCheck";
    }
    let ov = reduce(chunks, |acc: bool, c: string| -> bool {
        if acc {
            return true;
        }
        return detect_integer_overflow(c);
    }, false);
    if ov {
        return "IntegerOverflow";
    }
    return "none";
}

// V3 (#841): LLM-driven classification over the program source. Returns a canonical
// vuln-class token, "Safe", or "" when the backend gives no usable answer (mock returns
// the literal "mock", which matches no token) so the caller falls back to the structural
// heuristic. prompt() is host-side (the one allowed egress), so this runs before the
// network-closed sandbox compile. Generalises to real Anchor shapes the textual heuristic
// cannot see (e.g. an `authority: AccountInfo` field that should be `Signer`).
fn classify_llm(src: string) -> string {
    let out = to_lower(prompt("You are a Solana/Anchor security auditor. Identify the SINGLE most likely access-control vulnerability in the program below and reply with EXACTLY ONE token, nothing else: MissingSignerCheck | MissingOwnerCheck | AccountDataMatching | ArbitraryCPI | IntegerOverflow | Safe. MissingSignerCheck = an account used as an authority is not required to sign (e.g. an Anchor field typed AccountInfo/UncheckedAccount instead of Signer, or a native handler that moves funds / mutates state without checking is_signer). Reply Safe when the authority is a Signer or the required access-control check is present.", src) -> string);
    if index_of(out, "missingsignercheck") >= 0 { return "MissingSignerCheck"; }
    if index_of(out, "missingownercheck") >= 0 { return "MissingOwnerCheck"; }
    if index_of(out, "accountdatamatching") >= 0 { return "AccountDataMatching"; }
    if index_of(out, "arbitrarycpi") >= 0 { return "ArbitraryCPI"; }
    if index_of(out, "integeroverflow") >= 0 { return "IntegerOverflow"; }
    if index_of(out, "safe") >= 0 { return "Safe"; }
    return "";
}

// Resolve the final class from the V3 LLM verdict + the structural-heuristic verdict.
// The LLM class wins when present (generalises to real Anchor/native programs); "Safe"
// -> "none"; an empty LLM verdict (mock / no usable answer) falls back to the heuristic.
// This is a SHALLOW string-only helper — it must NOT call classify() itself: the guard
// runs classify() directly at its own depth (calling the deep structural fold through an
// extra wrapper frame overflows the native stack the colony is tuned shallow for). A
// mis-classification only ROUTES to synthesis; the #820 two-sided + real-SVM gate is the
// truth, so a wrong class yields `inconclusive`, never a false-VERIFIED.
fn resolve_cls(llm: string, heuristic: string) -> string {
    if len(llm) > 0 {
        if llm == "Safe" {
            return "none";
        }
        return llm;
    }
    return heuristic;
}

// ---- helpers: EVM/Solidity detection (M1: reentrancy) ------------------------

// Is the active audit an EVM/Solidity one? True when the operator selected the EVM harness
// (EVM_HARNESS_DIR), or the source is clearly Solidity. The harness flag is authoritative;
// the source sniff covers a Solidity target supplied without the flag. SHALLOW leaf
// (getenv + index_of). M1 scopes EVM detection to reentrancy; M3 broadens the class set.
fn is_evm_target(src: string) -> bool {
    if len(getenv("EVM_HARNESS_DIR")) > 0 {
        return true;
    }
    if index_of(src, "pragma solidity") >= 0 {
        return true;
    }
    if index_of(src, "function ") >= 0 {
        if index_of(src, "msg.sender") >= 0 {
            return true;
        }
    }
    return false;
}

// Structural reentrancy heuristic (checks-effects-interactions violation): an external
// value-bearing call (`.call{value:`) that is NOT dominated by zeroing the caller's recorded
// balance (`balanceOf[...] = 0` / a `-=` effect). Insecure = the external call precedes the
// effect (interaction-before-effect); secure = the effect precedes the call. -1 sentinels mean
// the construct is absent. SHALLOW leaf (index_of only). This is the structural fallback when
// the LLM classifier gives no usable answer (mock / offline).
fn detect_reentrancy(src: string) -> bool {
    let call = index_of(src, ".call{value:");
    if call < 0 {
        return false;
    }
    let zero = index_of(src, "] = 0");
    let dec = index_of(src, "] -=");
    let effect = min_present(zero, dec);
    if effect < 0 {
        return true;
    }
    if call < effect {
        return true;
    }
    return false;
}

// V3-style LLM classification for an EVM/Solidity target. M3 (#858): a MULTI-CLASS classifier
// over the full EVM class set. Returns EXACTLY ONE canonical token — Reentrancy | AccessControl |
// UncheckedCall | OracleManipulation | IntegerOverflow | Safe — or "" when the backend gives no
// usable answer (mock -> "mock", which matches no token) so the caller falls back to the
// structural reentrancy heuristic. Each class carries a precise detection cue in the prompt.
// prompt() is host-side (the one allowed egress) and runs before the network-closed sandbox build.
fn classify_evm_llm(src: string) -> string {
    let out = to_lower(prompt("You are an EVM/Solidity security auditor. Identify the SINGLE most likely exploitable vulnerability in the contract below and reply with EXACTLY ONE token, nothing else: Reentrancy | AccessControl | UncheckedCall | OracleManipulation | IntegerOverflow | Safe. Reentrancy = a checks-effects-interactions violation: an external value-bearing call (e.g. `msg.sender.call{value: ...}`) is made BEFORE the caller's recorded balance/state is updated, so a malicious receiver can re-enter and drain funds. AccessControl = a privileged state-changing function (e.g. setOwner / withdraw / mint / pause) lacks an owner/role check (no `onlyOwner`, no `require(msg.sender == owner)`), so any caller can invoke it. UncheckedCall = an external call's success/return value is ignored (a low-level `.call`/`.send` whose returned bool is not checked), or the call target / `delegatecall` is attacker-influenced, so a failed or hijacked call is silently trusted. OracleManipulation = a price/value is read from a manipulable spot source (a single DEX pair reserve / `getReserves` / spot `balanceOf`) WITHOUT a TWAP or sanity bound, so an attacker who moves the source moves the contract's view. IntegerOverflow = value-carrying arithmetic wraps or underflows (pre-0.8 arithmetic, or an explicit `unchecked { ... }` block on balances/supply/amounts). Reply Safe when the required check / guard is present and no class applies.", src) -> string);
    if index_of(out, "reentrancy") >= 0 { return "Reentrancy"; }
    if index_of(out, "accesscontrol") >= 0 { return "AccessControl"; }
    if index_of(out, "uncheckedcall") >= 0 { return "UncheckedCall"; }
    if index_of(out, "oraclemanipulation") >= 0 { return "OracleManipulation"; }
    if index_of(out, "integeroverflow") >= 0 { return "IntegerOverflow"; }
    if index_of(out, "safe") >= 0 { return "Safe"; }
    return "";
}

// Resolve the EVM class from the LLM verdict + the structural reentrancy heuristic. The LLM
// wins when present ("Safe" -> "none"); an empty verdict (mock / offline) falls back to the
// structural reentrancy heuristic (the only EVM class with a textual fallback). SHALLOW leaf —
// a mis-route only reaches synthesis, where the two-sided real-EVM gate is the truth (a wrong
// route yields `inconclusive`, never a false-VERIFIED).
fn resolve_evm_cls(llm: string, heuristic: bool) -> string {
    if len(llm) > 0 {
        if llm == "Safe" {
            return "none";
        }
        return llm;
    }
    if heuristic {
        return "Reentrancy";
    }
    return "none";
}

// ---- helpers: DAG distillation -----------------------------------------------

// Store each handler sub-graph in the content-addressed DAG (the dedup cache):
// same sub-graph across targets/repos -> same content hash -> stored once. Returns
// the count distilled. dag_put is a leaf builtin (kept shallow on the call stack).
fn distill_subgraphs(code: string) -> int {
    return reduce(regex_split("fn ", code), |acc: int, c: string| -> int {
        if len(c) > 0 {
            dag_put("fn " + c);
        }
        return acc + 1;
    }, 0);
}

// M2 (#858): EVM peer of distill_subgraphs — split a Solidity target on the `function `
// handler boundary so the same handler sub-graph across .sol targets/repos gets the same
// content hash (structural dedup). dag_put is a leaf builtin (kept shallow on the stack).
fn distill_subgraphs_evm(code: string) -> int {
    return reduce(regex_split("function ", code), |acc: int, c: string| -> int {
        if len(c) > 0 {
            dag_put("function " + c);
        }
        return acc + 1;
    }, 0);
}

// Pick the prior verdict for a sub-graph: federation blacklist wins, else own cache.
fn pick_prior(cached: string, black: string) -> string {
    if len(black) > 0 {
        return black;
    }
    return cached;
}

// ---- helpers: synthesis -------------------------------------------------------

// PoC template for MissingSignerCheck (two-sided invariant harness). main()
// runs BOTH a control (authorized signer must be accepted -> prints `CONTROL OK:`)
// and the exploit (unauthorized caller must be rejected; a drain breaks the invariant
// -> prints `INVARIANT VIOLATED:`). The control proves the harness is discriminating
// (it accepts the legit case), so assess() can reject a rigged always-fire harness
// that screams the sentinel without ever exercising the target.
fn synth_exploit() -> string {
    return "include!(\"target.rs\");\n" +
        "fn main() {\n" +
        "    // control: an AUTHORIZED signer must be accepted (invariant holds).\n" +
        "    let mut cvault = Vault { authority: 1, balance: 1000 };\n" +
        "    let signer = AccountInfo { key: 1, is_signer: true };\n" +
        "    let cpre = cvault.balance;\n" +
        "    let cres = withdraw(WithdrawCtx { vault: &mut cvault, authority: &signer }, cpre);\n" +
        "    if cres.is_ok() {\n" +
        "        println!(\"CONTROL OK: authorized withdrawal accepted {} -> {}\", cpre, cvault.balance);\n" +
        "    } else {\n" +
        "        println!(\"control anomaly: authorized withdrawal rejected\");\n" +
        "    }\n" +
        "    // exploit: an UNAUTHORIZED caller must be rejected; a drain breaks the invariant.\n" +
        "    let mut vault = Vault { authority: 1, balance: 1000 };\n" +
        "    let attacker = AccountInfo { key: 2, is_signer: false };\n" +
        "    let pre = vault.balance;\n" +
        "    let res = withdraw(WithdrawCtx { vault: &mut vault, authority: &attacker }, pre);\n" +
        "    let invariant_held = res.is_err() && vault.balance == pre;\n" +
        "    if invariant_held {\n" +
        "        println!(\"invariant held: unauthorized withdrawal rejected\");\n" +
        "    } else {\n" +
        "        eprintln!(\"INVARIANT VIOLATED: unauthorized caller drained vault {} -> {}\", pre, vault.balance);\n" +
        "        std::process::exit(101);\n" +
        "    }\n" +
        "}\n";
}

// Two-sided validation gate. A PoC run is `verified` ONLY when all three hold: (a) the
// compile produced no rustc error, (b) the exploit sentinel `INVARIANT VIOLATED:` is
// present, AND (c) the control marker `CONTROL OK:` is present (the harness is
// discriminating, not a rigged always-fire bug). Otherwise `inconclusive:<reason>`.
// Clause (c) is what makes panic != verified structural — the sentinel alone is not
// enough. Leaf function (only index_of) so the native call stack stays shallow.
fn assess(run_out: string) -> string {
    if index_of(run_out, "error[E") >= 0 { return "inconclusive:compile-error"; }
    if index_of(run_out, "INVARIANT VIOLATED:") < 0 { return "inconclusive:no-violation"; }
    if index_of(run_out, "CONTROL OK:") < 0 { return "inconclusive:no-control"; }
    return "verified";
}

// V5 (#843): is `cls` one of the synthesizable vuln classes (any class the LLM
// detector emits, except "Safe"/"none"/"")? Routes detection -> synthesis. SHALLOW
// leaf (string compares only) — safe at any agent depth.
fn is_vuln_class(cls: string) -> bool {
    if cls == "MissingSignerCheck" { return true; }
    if cls == "MissingOwnerCheck" { return true; }
    if cls == "AccountDataMatching" { return true; }
    if cls == "ArbitraryCPI" { return true; }
    if cls == "IntegerOverflow" { return true; }
    if cls == "Reentrancy" { return true; }
    if cls == "AccessControl" { return true; }
    if cls == "UncheckedCall" { return true; }
    if cls == "OracleManipulation" { return true; }
    return false;
}

// V5 (#843): the program-specific invariant the PoC must assert for the detected class.
// This is the heart of V5 — it tells the synthesis prompt WHAT to prove (control = the
// legitimate case that must be accepted; exploit = the attacker case that, if it
// succeeds, violates the named invariant), so the generated PoC asserts the RIGHT
// property per class instead of a generic signer drain. The generic default covers any
// unrecognised token (e.g. AccountConfusion / type-cosplay, a sibling of
// AccountDataMatching). SHALLOW leaf — safe at any agent depth.
fn invariant_for(cls: string) -> string {
    if cls == "MissingSignerCheck" {
        return "PROVE THIS INVARIANT (MissingSignerCheck): a privileged state change (moving funds / mutating an account the authority owns) MUST require the authority account to have signed. CONTROL: the authorized caller WITH a valid signature performs the action and is accepted. EXPLOIT: an attacker passes the SAME authority account but does NOT sign it (is_signer = false / a non-signer AccountMeta); if the action still succeeds and state mutates, the invariant is violated.";
    }
    if cls == "MissingOwnerCheck" {
        return "PROVE THIS INVARIANT (MissingOwnerCheck): the handler MUST verify a passed account is owned by the expected program before trusting its data. CONTROL: an account correctly owned by the program is accepted. EXPLOIT: an attacker substitutes an account THEY own (owner = a different program) carrying forged data; if the handler trusts it and the privileged action succeeds, the invariant is violated.";
    }
    if cls == "AccountDataMatching" {
        return "PROVE THIS INVARIANT (AccountDataMatching): the handler MUST check the passed account's identity matches the privileged identity stored in state (e.g. account.key == state.authority). CONTROL: the account whose key matches the stored authority is accepted. EXPLOIT: an attacker passes a DIFFERENT account whose key does NOT match the stored authority; if the privileged action still succeeds, the invariant is violated.";
    }
    if cls == "ArbitraryCPI" {
        return "PROVE THIS INVARIANT (ArbitraryCPI): a cross-program invocation MUST target the expected, hard-checked program id. CONTROL: the CPI against the legitimate program id behaves correctly. EXPLOIT: an attacker supplies a DIFFERENT program id for the invoked program; if the handler performs the CPI against the attacker-controlled program without rejecting it, the invariant is violated.";
    }
    if cls == "IntegerOverflow" {
        return "PROVE THIS INVARIANT (IntegerOverflow): value-carrying arithmetic (balances, supply, amounts) MUST NOT wrap or underflow. CONTROL: an in-range operation produces the correct arithmetic result and is accepted. EXPLOIT: an attacker supplies an amount that makes the unchecked arithmetic wrap (e.g. subtract more than the balance to underflow to a huge value, or add past the max); if the resulting state reflects the wrapped value, the conservation invariant is violated.";
    }
    return "PROVE THIS INVARIANT (generic access-control): a privileged action MUST be reachable only by the authorized party. CONTROL: the legitimate authorized caller is accepted. EXPLOIT: an unauthorized caller performs the same action; if it succeeds against the safety invariant, the invariant is violated.";
}

// M3 (#858): the EVM peer of invariant_for() — the program-specific invariant the revm PoC must
// assert for the detected EVM class. EVM-flavored (msg.sender / external calls / ETH balances)
// and kept SEPARATE from the Solana invariant_for() because IntegerOverflow is a token shared by
// both chains and the EVM phrasing differs. Same shape: CONTROL = the legit flow that must be
// accepted, EXPLOIT = the attacker action that breaks the invariant. The #820 marker contract
// (CONTROL OK: + INVARIANT VIOLATED: + exit 101) is unchanged. SHALLOW leaf — safe at any depth.
fn evm_invariant_for(cls: string) -> string {
    if cls == "Reentrancy" {
        return "PROVE THIS INVARIANT (Reentrancy): a withdraw/payout that sends ETH MUST update the caller's recorded balance BEFORE the external call (checks-effects-interactions). CONTROL: an honest account deposits then withdraws and the flow conserves (the user is restored and the vault returns to its prior holdings). EXPLOIT: an attacker contract deposits a small stake, calls withdraw(), and re-enters withdraw() from its receive()/fallback while the target still credits its un-zeroed balance; if the attacker ends holding MORE ETH than it staked (the pooled TVL is drained), the conservation invariant is violated.";
    }
    if cls == "AccessControl" {
        return "PROVE THIS INVARIANT (AccessControl): a privileged state-changing function (e.g. setOwner / withdraw / mint / pause) MUST be reachable only by the authorized owner/role. CONTROL: the legitimate owner (the deployer / the address recorded as owner) calls the privileged function and it is accepted and mutates state. EXPLOIT: a NON-owner address calls the SAME privileged function; if it still succeeds and the state mutates (ownership transferred, funds withdrawn, supply minted), the access-control invariant is violated.";
    }
    if cls == "UncheckedCall" {
        return "PROVE THIS INVARIANT (UncheckedCall): an external call's success MUST be checked, and the call target / delegatecall MUST NOT be attacker-influenced. CONTROL: the legitimate call path completes and the contract's accounting matches the actual transfer outcome. EXPLOIT: an attacker forces the external call to FAIL (or supplies an attacker-controlled target/delegatecall); if the contract ignores the unchecked return and proceeds as if it succeeded — crediting value never transferred, or executing attacker code under its own context — the invariant is violated.";
    }
    if cls == "OracleManipulation" {
        return "PROVE THIS INVARIANT (OracleManipulation): a price/value the contract acts on MUST NOT be readable straight from a manipulable spot source without a TWAP or sanity bound. CONTROL: under normal reserves the contract reads a fair price and the dependent action (swap / borrow / liquidation) is correct. EXPLOIT: an attacker moves the spot source within the same transaction (e.g. a large swap that skews the pair reserves, or a direct token transfer that inflates a spot balanceOf); if the contract trusts the manipulated price and lets the attacker extract value, the invariant is violated.";
    }
    if cls == "IntegerOverflow" {
        return "PROVE THIS INVARIANT (IntegerOverflow): value-carrying arithmetic (balances, supply, amounts) MUST NOT wrap or underflow. CONTROL: an in-range operation produces the correct arithmetic result and is accepted. EXPLOIT: an attacker supplies an amount that makes the unchecked arithmetic (a pre-0.8 op or an `unchecked { ... }` block) wrap — e.g. subtract more than the balance to underflow to a huge value, or add past the uint max; if the resulting on-chain state reflects the wrapped value, the conservation invariant is violated.";
    }
    return "PROVE THIS INVARIANT (generic EVM safety): a privileged or value-bearing action MUST be reachable only under its intended precondition. CONTROL: the legitimate flow is accepted and the contract's accounting is correct. EXPLOIT: an attacker performs the same action outside its precondition; if it succeeds against the safety/conservation invariant, the invariant is violated.";
}

// PoC generation instruction for the prompt-driven synthesis (two-sided).
// When the real Solana toolchain is enabled (SOLANA_HARNESS_DIR set) the
// instruction asks for a solana-program-test + BanksClient PoC that runs through the
// REAL solana-runtime SVM; otherwise the std-only include!("target.rs") harness.
// V5 (#843): class-aware. `invariant_for(cls)` selects the SPECIFIC invariant the PoC
// must assert; the rest of the instruction is the mechanical two-sided scaffolding. The
// #820 marker contract (CONTROL OK: + INVARIANT VIOLATED: + exit 101) is unchanged, so
// the two-sided gate still blocks rigged/always-fire harnesses regardless of class.
// V6 (#844): the active real-SVM harness dir — the Anchor harness when
// SOLANA_ANCHOR_HARNESS_DIR is set, else the native harness (SOLANA_HARNESS_DIR).
// Leaf (getenv only) — safe at any agent depth.
fn harness_dir() -> string {
    let e = getenv("EVM_HARNESS_DIR");
    if len(e) > 0 {
        return e;
    }
    let a = getenv("SOLANA_ANCHOR_HARNESS_DIR");
    if len(a) > 0 {
        return a;
    }
    return getenv("SOLANA_HARNESS_DIR");
}

fn poc_instruction(cls: string) -> string {
    let inv = invariant_for(cls);
    if len(getenv("EVM_HARNESS_DIR")) > 0 {
        // M3 (#858): class-aware. evm_invariant_for(cls) selects the SPECIFIC EVM invariant the
        // revm PoC must prove (reentrancy / access-control / unchecked-call / oracle / overflow);
        // the rest is the mechanical revm two-sided scaffolding. argv[2] is a provided reentrancy
        // attacker (.bin) — used for the Reentrancy class; for the other classes the PoC drives
        // the target directly (attacker bytecode optional). The #820 marker contract (CONTROL OK:
        // + INVARIANT VIOLATED: + exit 101) is unchanged, so the two-sided gate still blocks
        // rigged/always-fire harnesses regardless of class.
        let einv = evm_invariant_for(cls);
        return "You are given a Solidity smart contract (the in-scope target). Write the FULL contents of " +
            "src/bin/poc.rs: a self-contained `fn main()` that drives the target through the REAL EVM (the " +
            "`revm` crate, version 14) as a TWO-SIDED proof. Do NOT link or import the target as Rust — the " +
            "target (and a provided generic reentrancy attacker) are compiled to EVM creation-bytecode " +
            "HOST-SIDE and passed to your binary as file paths on argv: argv[1] = the target's creation-" +
            "bytecode (.bin, a hex string), argv[2] = a provided attacker contract's creation-bytecode (.bin) " +
            "exposing `attack()` payable (it deposits msg.value into the target then calls the target's " +
            "withdraw(), and re-enters withdraw() from its receive() while the target still holds funds); its " +
            "constructor takes the target address. Use the attacker for the reentrancy class; for other classes " +
            "you may drive the target directly (deploy it and send the relevant txs yourself) and ignore argv[2]. " +
            einv + " Imports (revm 14): `use revm::db::{CacheDB, EmptyDB}; use " +
            "revm::primitives::{keccak256, AccountInfo, Address, Bytes, ExecutionResult, Output, TxKind, " +
            "U256}; use revm::Evm; use std::process::exit;`. Build the EVM with `let mut evm = " +
            "Evm::builder().with_db(CacheDB::new(EmptyDB::default())).build();`. Fund an account via " +
            "`evm.db_mut().insert_account_info(addr, AccountInfo { balance: wei, ..Default::default() });`. " +
            "Read a balance via `evm.db_mut().accounts.get(&addr).map(|a| a.info.balance).unwrap_or(U256::ZERO)`. " +
            "To OBSERVE a state change with NO public getter (a private variable, or a getter gated by access " +
            "control) read its RAW STORAGE SLOT directly: add `use revm::Database;` and call " +
            "`evm.db_mut().storage(addr, U256::from(slot)).unwrap_or(U256::ZERO)` (returns the slot's U256 value). " +
            "State variables occupy storage slots in DECLARATION ORDER from slot 0 (value types may pack into one " +
            "slot; a string/bytes/array/mapping takes its own slot — for a short string the slot itself holds the " +
            "data+length, so a CHANGED slot value proves the variable was written). Prove the invariant by comparing " +
            "a slot BEFORE and AFTER the action: an unauthorized actor changing a slot it must not change = INVARIANT " +
            "VIOLATED. Prefer a public getter when one exists; fall back to the raw storage slot when the mutated " +
            "state is otherwise unobservable (e.g. a private variable like a stored password/owner/config). " +
            "Send a tx by setting `tx.caller / tx.transact_to (TxKind::Create or TxKind::Call(addr)) / tx.value " +
            "/ tx.data = Bytes::from(bytes) / tx.gas_limit = 30_000_000 / tx.gas_price = U256::ZERO / tx.nonce = " +
            "None` on `evm.tx_mut()`, then `evm.transact_commit()`. A successful CREATE returns " +
            "`ExecutionResult::Success { output: Output::Create(_, Some(addr)), .. }`. Read the returned data of " +
            "a Call via `ExecutionResult::Success { output: Output::Call(bytes), .. }`. Compute a function " +
            "selector with `keccak256(sig.as_bytes())[..4].to_vec()` (e.g. \"deposit()\", \"withdraw()\", " +
            "\"attack()\", \"owner()\", \"setOwner(address)\"). ABI-encode a single address arg as 32 bytes " +
            "(12 zero bytes + the 20 address bytes) appended to the selector. Load a .bin with " +
            "`hex::decode(std::fs::read_to_string(path).unwrap().trim()).unwrap()`. " +
            "For a constructor(address) argument, append the 32-byte left-padded address (12 zero bytes + the " +
            "20 address bytes) to the attacker creation-bytecode before deploying. STEPS: (1) read argv[1] " +
            "(target bytecode) and (when the class needs it) argv[2] (attacker bytecode); (2) CONTROL — deploy a " +
            "FRESH target and exercise the LEGITIMATE flow from the invariant above; assert it is accepted / " +
            "conserves; if so print exactly `CONTROL OK: <detail>`; if the legitimate flow does NOT hold, print " +
            "a HARNESS ERROR to stderr and `exit(2)` (NOT a verdict). (3) EXPLOIT — deploy a FRESH target, set " +
            "up the attacker action from the invariant above (for reentrancy: seed honest TVL, deploy the " +
            "attacker with the target address as its constructor arg, call `attack()` with a stake; for the " +
            "other classes: have a non-owner / attacker account send the offending tx directly), then check the " +
            "invariant; if it is VIOLATED print exactly `INVARIANT VIOLATED: <detail>` to stderr and call " +
            "`std::process::exit(101)`; otherwise print `invariant held: <detail>`. Both `CONTROL OK:` and " +
            "`INVARIANT VIOLATED:` markers are REQUIRED on a vulnerable target. Reserve exit code 101 " +
            "EXCLUSIVELY for a genuine INVARIANT VIOLATED. Output only the Rust source of src/bin/poc.rs.";
    }
    if len(getenv("SOLANA_ANCHOR_HARNESS_DIR")) > 0 {
        return "You are given an ANCHOR Solana program — the contents of the harness crate " +
            "`solana_harness_anchor`'s src/lib.rs (an `#[program]` module with `declare_id!`). Write the FULL " +
            "contents of src/bin/poc.rs: a `#[tokio::main] async fn main()` driving it through " +
            "solana-program-test as a TWO-SIDED proof against the REAL SVM. " + inv + " Imports: `use " +
            "anchor_lang::InstructionData; use solana_harness_anchor::instruction as ix; use " +
            "solana_program::{account_info::AccountInfo, entrypoint::ProgramResult, pubkey::Pubkey}; use " +
            "solana_program_test::{processor, ProgramTest}; use solana_sdk::{account::Account, " +
            "instruction::{AccountMeta, Instruction}, signature::{Keypair, Signer}, system_program, " +
            "transaction::Transaction};`. Bridge anchor's entry to ProcessInstruction EXACTLY: `fn " +
            "process_instruction(program_id: &Pubkey, accounts: &[AccountInfo], data: &[u8]) -> ProgramResult " +
            "{ let tied: &[AccountInfo] = unsafe { core::mem::transmute(accounts) }; " +
            "solana_harness_anchor::entry(program_id, tied, data) }` (anchor ties the accounts/AccountInfo " +
            "lifetimes; the bridge is sound — the runner's accounts outlive the call). Use `let program_id = " +
            "solana_harness_anchor::ID;` and `ProgramTest::new(\"solana_harness_anchor\", program_id, " +
            "processor!(process_instruction))`. Seed every account the handler reads with `pt.add_account(pk, " +
            "Account { lamports: 1000000, data: <bytes>, owner: <owner>, executable: false, rent_epoch: 0 })`. " +
            "Build instruction data with anchor: `ix::Handler { ..fields }.data()` where Handler is the " +
            "PascalCase of the handler `pub fn` name (no fields if it takes none). Order AccountMeta to match " +
            "the program's #[derive(Accounts)] struct with correct is_signer flags. CONTROL: the legitimate " +
            "caller — if accepted print exactly `CONTROL OK: <detail>`. EXPLOIT: the attacker case from the " +
            "invariant — if it succeeds print exactly `INVARIANT VIOLATED: <detail>` to stderr and call " +
            "std::process::exit(101); otherwise print `invariant held`. Both markers REQUIRED. Output only the " +
            "Rust source of src/bin/poc.rs.";
    }
    if len(getenv("SOLANA_HARNESS_DIR")) > 0 {
        return "You are given a Solana program — the contents of the harness crate's src/target.rs, which " +
            "exposes `pub fn process_instruction(program_id: &Pubkey, accounts: &[AccountInfo], data: &[u8]) " +
            "-> ProgramResult`. Write the FULL contents of src/bin/poc.rs: a `#[tokio::main] async fn main()` " +
            "that drives this program through solana-program-test + BanksClient as a TWO-SIDED proof against " +
            "the REAL SVM. " + inv + " Imports: `use solana_harness::target; use solana_program_test::{processor, " +
            "ProgramTest}; use solana_sdk::{account::Account, instruction::{AccountMeta, Instruction}, " +
            "pubkey::Pubkey, signature::{Keypair, Signer}, transaction::Transaction};`. For EACH side build a " +
            "fresh `ProgramTest::new(\"solana_harness\", program_id, processor!(target::process_instruction))`, " +
            "seed program-owned accounts via `pt.add_account(pk, Account { lamports, data: vec![], owner: " +
            "program_id, executable: false, rent_epoch: 0 })`, then `let (mut banks, payer, recent) = " +
            "pt.start().await;`, build the instruction with correct AccountMeta signer flags, sign with " +
            "`tx.sign(&[&payer, ...], recent)`, and `banks.process_transaction(tx).await`. For the CONTROL " +
            "side, if accepted print exactly `CONTROL OK: <detail>`. For the EXPLOIT side, if it succeeds " +
            "against the invariant above print exactly `INVARIANT VIOLATED: <detail>` to stderr and call " +
            "std::process::exit(101); otherwise print `invariant held`. Both markers REQUIRED. Output only the " +
            "Rust source of src/bin/poc.rs.";
    }
    return "You are given a Rust program as input. Write a self-contained Rust `fn main()` that begins " +
        "with include!(\"target.rs\") and proves the following vulnerability with a TWO-SIDED harness, using " +
        "the EXACT type and function names defined in the input. " + inv + " CONTROL: construct the legitimate " +
        "case described above and invoke the in-scope entry point; if it is accepted print exactly " +
        "`CONTROL OK: <detail>`. EXPLOIT: construct the attacker case described above and invoke the same " +
        "entry point; if it succeeds against the invariant print exactly `INVARIANT VIOLATED: <detail>` to " +
        "stderr and call std::process::exit(101); otherwise print `invariant held`. Both `CONTROL OK:` and " +
        "`INVARIANT VIOLATED:` markers are REQUIRED. Output only the Rust source.";
}

// #982: DECOMPOSED EVM synthesis. The one-shot poc_instruction asks for the WHOLE poc.rs
// (~200 lines) in a single prompt — a big OUTPUT that stalls `claude -p` on a non-trivial
// contract (proven: a complex target's one-shot never returned at 600s, while a small-output
// fragment prompt returns in ~40s). So for EVM we keep all the revm boilerplate in a FIXED
// skeleton (evm-harness/poc-skeleton.rs) and ask the LLM only for two SMALL slots — the CONTROL
// block and the EXPLOIT block (~12-18 lines each) — then splice them in (assemble-poc.js). Each
// generation is small + fast; the two-sided gate (CONTROL OK: + INVARIANT VIOLATED: + exit 101)
// is unchanged. The slot prompts describe the skeleton's helpers/vars so the fills compile against it.
fn control_instruction(cls: string) -> string {
    let einv = evm_invariant_for(cls);
    return "You are filling ONLY the CONTROL block of a revm-14 Rust PoC against the Solidity contract " +
        "given as input. A fixed skeleton already provides these helpers + vars — USE them, do NOT " +
        "redefine, import, or write any `fn`/`use`/`main`: deploy(&mut evm, deployer, &target_code, " +
        "&ctor_args) -> Address (deploys a FRESH target; append abi-encoded constructor args or pass " +
        "&[]); call(&mut evm, from, to, data) -> Vec<u8> (NON-payable, 4 args, DIES on revert); " +
        "call_value(&mut evm, from, to, value, data) -> Vec<u8> (payable, sends ETH); try_call(&mut evm, " +
        "from, to, data) -> Option<Vec<u8>> (non-payable, None on revert); try_call_value(&mut evm, from, " +
        "to, value, data) -> Option<Vec<u8>> (payable); selector(\"f(uint256)\") -> Vec<u8>; " +
        "abi_addr(addr) -> Vec<u8>; abi_u256(amount) -> Vec<u8> (accepts a U256 or a u128/u64 integer); " +
        "eth_balance(&mut evm, addr) -> U256; " +
        "storage(&mut evm, addr, slot_u64) -> U256; u256(&bytes) -> U256; die(msg: String) -> !. Vars in " +
        "scope: evm, target_code: Vec<u8>, attacker_code: Vec<u8> (argv[2], may be empty), " +
        "deployer/attacker/user: Address (each funded 100 ETH). U256, TxKind, Address are imported. " +
        "EXAMPLE of a read: `let mut d = selector(\"balanceOf(address)\"); d.extend(abi_addr(user)); " +
        "let bal = u256(&call(&mut evm, user, t, d));`. The invariant under test: " + einv +
        " Write ONLY the CONTROL block: deploy a fresh target and " +
        "exercise the LEGITIMATE flow the invariant assumes; if it holds print exactly " +
        "`CONTROL OK: <short detail>`. If the legitimate flow itself fails, call die(\"...\".into()) (a " +
        "setup failure, NOT a verdict). Output ONLY Rust statements (~12 lines) — no code fences, no " +
        "prose, no fn/use/main.";
}

fn exploit_instruction(cls: string) -> string {
    let einv = evm_invariant_for(cls);
    return "You are filling ONLY the EXPLOIT block of a revm-14 Rust PoC against the Solidity contract " +
        "given as input. The SAME fixed skeleton/helpers/vars as the CONTROL block are available " +
        "(deploy; call(&mut evm,from,to,data) NON-payable 4 args; call_value(&mut evm,from,to,value,data) " +
        "payable; try_call / try_call_value; selector / abi_addr / abi_u256 / eth_balance / storage / u256 " +
        "/ die; evm, target_code, attacker_code, deployer/attacker/user: Address; U256/TxKind/Address " +
        "imported; exit() in scope). Do NOT redefine, import, or write any fn/use/main. The invariant " +
        "under test: " + einv + " Write ONLY the EXPLOIT block: deploy a FRESH target via deploy(...), " +
        "perform the attack the invariant describes — a non-owner/attacker account sends the offending tx. " +
        "CRITICAL: use try_call / try_call_value (NOT call / call_value) for the ATTACK call itself — on a " +
        "secure target the attack reverts, which means the invariant HELD; a revert must NOT crash the PoC. " +
        "Plain call/call_value DIE on a revert and report a FALSE `HARNESS ERROR` (exit 2). Use plain " +
        "call/call_value only for setup steps you expect to succeed, and reads. " +
        "For a reentrancy class deploy the attacker with `deploy(&mut evm, attacker, &attacker_code, " +
        "&abi_addr(t))` (target address as its constructor arg) and call its attack() with a stake via " +
        "call_value(&mut evm, attacker, atk, U256::from(1_000_000_000_000_000_000u128), selector(\"attack()\")) " +
        "— then read the relevant state (a public " +
        "getter via call(), or storage(&mut evm, t, slot) for a private variable; slots are in declaration " +
        "order from 0) and check the invariant. If it is VIOLATED, print exactly " +
        "`INVARIANT VIOLATED: <short detail>` to stderr with eprintln! and call exit(101). Otherwise do " +
        "nothing (the skeleton reports invariant-held). Output ONLY Rust statements (~18 lines) — no code " +
        "fences, no prose, no fn/use/main.";
}

// Generate the EVM poc.rs by filling the skeleton's two slots from two small prompts, then splicing
// via assemble-poc.js (runs from the colony cwd where the fills are written; reads the skeleton +
// assembler by absolute path in the harness dir). Returns the assembled poc.rs on stdout.
fn synth_evm_poc_decomposed(cls: string, target: string) -> string {
    let ed = getenv("EVM_HARNESS_DIR");
    let control = prompt(control_instruction(cls), target) -> string;
    let exploit = prompt(exploit_instruction(cls), target) -> string;
    file_write("h_control.rs", control);
    file_write("h_exploit.rs", exploit);
    // colony-lint: safe-exec-concat
    return exec sh "node ${ed}/assemble-poc.js ${ed}/poc-skeleton.rs h_control.rs h_exploit.rs 2>/dev/null";
}

// Build a PoC candidate: decomposed skeleton-fill for EVM (#982), the single one-shot prompt for
// Solana / std targets (their PoCs are smaller + the harness mechanics differ).
fn gen_poc(cls: string, target: string) -> string {
    if is_evm_target(target) {
        return synth_evm_poc_decomposed(cls, target);
    }
    let p = prompt(poc_instruction(cls), target) -> string;
    return p;
}

// Compile + run a PoC candidate, routing to the real Solana toolchain when
// SOLANA_HARNESS_DIR is set (solana-program-test + BanksClient through the real SVM,
// fully offline), else the std-only `rustc` path (offline-deterministic, V1 behaviour).
// In harness mode an empty `poc` keeps the harness's committed default src/bin/poc.rs
// (the deterministic template-fallback). `target_src` is written to src/target.rs so the
// PoC links against the in-scope program. All leaf calls — the native call stack stays shallow.
fn compile_run(poc: string, target_src: string) -> string {
    let ed = getenv("EVM_HARNESS_DIR");
    if len(ed) > 0 {
        // EVM harness: the target is a Solidity .sol. It does NOT link the PoC — solc compiles
        // the target + the committed generic reentrancy Attacker host-side (node compile.js), the
        // revm poc.rs loads the creation-bytecode at runtime via argv. The in-sandbox build stays
        // offline (cargo + revm only); solc/node runs host-side. revm is slow in debug, so build +
        // run --release (the warmed profile). An empty poc keeps the harness's committed poc.rs.
        file_write("h_target.sol", target_src);
        // #859: a REAL multi-file repo target. The in-scope source (challenge-augmented) compiles
        // WITH its deps via compile-project.js (remappings + lib/ + node_modules, project solc,
        // offline from the host-warmed .solc-cache). compile.js still builds the committed generic
        // Attacker (self-contained). No contracts/Target.sol is written — that would break compile.js's
        // import-less batch (#820 regression) — Target.bin comes from the project compile, content-
        // overridden by h_inscope.sol so the per-run challenge fn rides in the bytecode without
        // mutating the operator's repo. $BOUNTY_* are shell-expanded from the passed-through env.
        if len(getenv("BOUNTY_REPO")) > 0 {
            if len(poc) > 0 {
                file_write("h_poc.rs", poc);
                // colony-lint: safe-exec-concat
                return exec sh "set -e; cp h_poc.rs ${ed}/src/bin/poc.rs; cp h_target.sol ${ed}/h_inscope.sol; rm -f ${ed}/contracts/Target.sol ${ed}/contracts/bin/Target.bin; cd ${ed}; set +e; node compile.js > solc.out 2>&1; SRC=$?; if [ $SRC -ne 0 ]; then cat solc.out; echo __rc=$SRC; else node compile-project.js \"$BOUNTY_REPO\" \"$BOUNTY_IN_SCOPE\" contracts/bin/Target.bin \"$BOUNTY_CONTRACT\" h_inscope.sol > proj.out 2>&1; PRC=$?; if [ $PRC -ne 0 ]; then cat proj.out; echo __rc=$PRC; else export PATH=$HOME/.cargo/bin:$PATH; CARGO_NET_OFFLINE=1 cargo build --quiet --release --bin poc --offline > build.out 2>&1; BRC=$?; if [ $BRC -ne 0 ]; then cat build.out; echo __rc=$BRC; else RAYON_NUM_THREADS=4 ./target/release/poc contracts/bin/Target.bin contracts/bin/Attacker.bin 2>&1; echo __rc=$?; fi; fi; fi";
            }
            // colony-lint: safe-exec-concat
            return exec sh "set -e; cp h_target.sol ${ed}/h_inscope.sol; rm -f ${ed}/contracts/Target.sol ${ed}/contracts/bin/Target.bin; cd ${ed}; set +e; node compile.js > solc.out 2>&1; SRC=$?; if [ $SRC -ne 0 ]; then cat solc.out; echo __rc=$SRC; else node compile-project.js \"$BOUNTY_REPO\" \"$BOUNTY_IN_SCOPE\" contracts/bin/Target.bin \"$BOUNTY_CONTRACT\" h_inscope.sol > proj.out 2>&1; PRC=$?; if [ $PRC -ne 0 ]; then cat proj.out; echo __rc=$PRC; else export PATH=$HOME/.cargo/bin:$PATH; CARGO_NET_OFFLINE=1 cargo build --quiet --release --bin poc --offline > build.out 2>&1; BRC=$?; if [ $BRC -ne 0 ]; then cat build.out; echo __rc=$BRC; else RAYON_NUM_THREADS=4 ./target/release/poc contracts/bin/Target.bin contracts/bin/Attacker.bin 2>&1; echo __rc=$?; fi; fi; fi";
        }
        if len(poc) > 0 {
            file_write("h_poc.rs", poc);
            // colony-lint: safe-exec-concat
            return exec sh "set -e; cp h_target.sol ${ed}/contracts/Target.sol; cp h_poc.rs ${ed}/src/bin/poc.rs; cd ${ed}; set +e; node compile.js > solc.out 2>&1; SRC=$?; if [ $SRC -ne 0 ]; then cat solc.out; echo __rc=$SRC; else export PATH=$HOME/.cargo/bin:$PATH; CARGO_NET_OFFLINE=1 cargo build --quiet --release --bin poc --offline > build.out 2>&1; BRC=$?; if [ $BRC -ne 0 ]; then cat build.out; echo __rc=$BRC; else RAYON_NUM_THREADS=4 ./target/release/poc contracts/bin/Target.bin contracts/bin/Attacker.bin 2>&1; echo __rc=$?; fi; fi";
        }
        // colony-lint: safe-exec-concat
        return exec sh "set -e; cp h_target.sol ${ed}/contracts/Target.sol; cd ${ed}; set +e; node compile.js > solc.out 2>&1; SRC=$?; if [ $SRC -ne 0 ]; then cat solc.out; echo __rc=$SRC; else export PATH=$HOME/.cargo/bin:$PATH; CARGO_NET_OFFLINE=1 cargo build --quiet --release --bin poc --offline > build.out 2>&1; BRC=$?; if [ $BRC -ne 0 ]; then cat build.out; echo __rc=$BRC; else RAYON_NUM_THREADS=4 ./target/release/poc contracts/bin/Target.bin contracts/bin/Attacker.bin 2>&1; echo __rc=$?; fi; fi";
    }
    let ad = getenv("SOLANA_ANCHOR_HARNESS_DIR");
    if len(ad) > 0 {
        // Anchor harness: the target IS the whole crate src/lib.rs (an #[program] module).
        file_write("h_lib.rs", target_src);
        if len(poc) > 0 {
            file_write("h_poc.rs", poc);
            // colony-lint: safe-exec-concat
            return exec sh "set -e; cp h_lib.rs ${ad}/src/lib.rs; cp h_poc.rs ${ad}/src/bin/poc.rs; cd ${ad}; set +e; export PATH=$HOME/.cargo/bin:$PATH; CARGO_NET_OFFLINE=1 cargo build --quiet --bin poc --offline > build.out 2>&1; BRC=$?; if [ $BRC -ne 0 ]; then cat build.out; echo __rc=$BRC; else RAYON_NUM_THREADS=4 ./target/debug/poc 2>&1; echo __rc=$?; fi";
        }
        // colony-lint: safe-exec-concat
        return exec sh "set -e; cp h_lib.rs ${ad}/src/lib.rs; cd ${ad}; cp src/bin/poc.rs.tmpl src/bin/poc.rs; set +e; export PATH=$HOME/.cargo/bin:$PATH; CARGO_NET_OFFLINE=1 cargo build --quiet --bin poc --offline > build.out 2>&1; BRC=$?; if [ $BRC -ne 0 ]; then cat build.out; echo __rc=$BRC; else RAYON_NUM_THREADS=4 ./target/debug/poc 2>&1; echo __rc=$?; fi";
    }
    let hd = getenv("SOLANA_HARNESS_DIR");
    if len(hd) > 0 {
        file_write("h_target.rs", target_src);
        if len(poc) > 0 {
            file_write("h_poc.rs", poc);
            // colony-lint: safe-exec-concat
            return exec sh "set -e; cp h_target.rs ${hd}/src/target.rs; cp h_poc.rs ${hd}/src/bin/poc.rs; cd ${hd}; set +e; export PATH=$HOME/.cargo/bin:$PATH; CARGO_NET_OFFLINE=1 cargo build --quiet --bin poc --offline > build.out 2>&1; BRC=$?; if [ $BRC -ne 0 ]; then cat build.out; echo __rc=$BRC; else RAYON_NUM_THREADS=4 ./target/debug/poc 2>&1; echo __rc=$?; fi";
        }
        // colony-lint: safe-exec-concat
        return exec sh "set -e; cp h_target.rs ${hd}/src/target.rs; cd ${hd}; cp src/bin/poc.rs.tmpl src/bin/poc.rs; set +e; export PATH=$HOME/.cargo/bin:$PATH; CARGO_NET_OFFLINE=1 cargo build --quiet --bin poc --offline > build.out 2>&1; BRC=$?; if [ $BRC -ne 0 ]; then cat build.out; echo __rc=$BRC; else RAYON_NUM_THREADS=4 ./target/debug/poc 2>&1; echo __rc=$?; fi";
    }
    // std-only path: the PoC is `include!("target.rs")`, so write the (possibly
    // challenge-augmented) target alongside it — keeps compile_run consistent with the
    // harness branches and lets the #852 linkage challenge const resolve via the include.
    file_write("target.rs", target_src);
    file_write("exploit.rs", poc);
    return exec sh "rm -f poc; rustc --edition 2021 exploit.rs -o poc 2>&1; ./poc 2>&1; echo __rc=$?";
}

// #852: a supplied BOUNTY_POC must demonstrably EXERCISE the in-scope target — a
// target-agnostic PoC that merely prints the two markers (the documented forgery) must
// not mint VERIFIED. This is the STRUCTURAL half of the gate: for the active harness mode
// the PoC must reference the in-scope target/harness, exactly as the real PoCs do. Mode
// detection mirrors harness_dir()/poc_instruction()/challenge_ref(). SHALLOW leaf
// (getenv + index_of only) — safe at any agent depth.
fn poc_exercises_target(poc: string) -> bool {
    if len(getenv("EVM_HARNESS_DIR")) > 0 {
        // M3 (#858): EVM peer. A real revm PoC drives the in-scope target through the EVM —
        // it must use the `revm` crate AND load the target's creation-bytecode handed to it on
        // argv (it deploys it as a CREATE tx). A target-agnostic marker-printer that uses neither
        // is rejected here (the structural half), before the per-run target-linkage challenge.
        if index_of(poc, "revm") < 0 { return false; }
        if index_of(poc, "TxKind::Create") < 0 { return false; }
        if index_of(poc, "args") >= 0 { return true; }
        if index_of(poc, "argv") >= 0 { return true; }
        if index_of(poc, "read_to_string") >= 0 { return true; }
        return false;
    }
    if len(getenv("SOLANA_ANCHOR_HARNESS_DIR")) > 0 {
        if index_of(poc, "solana_harness_anchor") < 0 { return false; }
        if index_of(poc, "processor!") >= 0 { return true; }
        if index_of(poc, "entry(") >= 0 { return true; }
        if index_of(poc, "::instruction") >= 0 { return true; }
        return false;
    }
    if len(getenv("SOLANA_HARNESS_DIR")) > 0 {
        if index_of(poc, "solana_harness") < 0 { return false; }
        if index_of(poc, "process_instruction") >= 0 { return true; }
        if index_of(poc, "processor!") >= 0 { return true; }
        return false;
    }
    return index_of(poc, "target.rs") >= 0;
}

// #852: the Rust path to the per-run challenge const by harness mode. The const is
// appended to the target the PoC is compiled against, so reading it back proves the PoC
// linked THIS run's target (not a stale / target-free binary). SHALLOW leaf (getenv).
// M3 (#858): EVM has no Rust-linked const (the target is a .sol the PoC never imports as
// Rust); its per-run challenge is a uniquely-named Solidity view fn injected into the target
// and called through the EVM by the wrapped PoC (see inject_evm_challenge / wrap_with_challenge_evm),
// so for EVM this returns the challenge fn base name token (the nonce-specific selector is built inline).
fn challenge_ref() -> string {
    if len(getenv("EVM_HARNESS_DIR")) > 0 { return "pocChallenge"; }
    if len(getenv("SOLANA_ANCHOR_HARNESS_DIR")) > 0 { return "solana_harness_anchor::POC_CHALLENGE"; }
    if len(getenv("SOLANA_HARNESS_DIR")) > 0 { return "solana_harness::target::POC_CHALLENGE"; }
    return "POC_CHALLENGE";
}

// #852: wrap a supplied PoC so it echoes the per-run challenge BEFORE its own main runs
// (the user main may std::process::exit(101) on the violation path). Renames the first
// `fn main(` to `__poc_user_main` and prepends a new `fn main` that prints
// `POC_CHALLENGE=<nonce>` read from the target-linked const, then calls the user main. A
// PoC that does not link the in-scope target cannot resolve the const → fails to compile
// (std) or never surfaces the nonce, and is rejected. If no `fn main(` is present the PoC
// is returned unchanged (the structural gate still applies). SHALLOW leaf (string surgery).
fn wrap_with_challenge(poc: string, cref: string) -> string {
    let p = index_of(poc, "fn main(");
    if p < 0 { return poc; }
    // Build with shallow (<=1 `+`) sequential concats: the colony's native call stack is
    // tuned razor-thin (#820), and a long `((a+b)+c)+d` chain recurses one frame per `+`
    // — enough, at this depth, to overflow. Sequential lets keep each expression shallow.
    let head = substring(poc, 0, p);
    let tail = substring(poc, p + 8, len(poc));
    let renamed = head + "fn __poc_user_main(";
    let body = renamed + tail;
    let mhead = "\nfn main() { eprintln!(\"POC_CHALLENGE={}\", ";
    let mmid = mhead + cref;
    let mfn = mmid + "); __poc_user_main(); }\n";
    return body + mfn;
}

// M3 (#858): EVM peer of the #852 challenge const — a uniquely-named Solidity view fn carrying
// the per-run nonce, injected into the in-scope target the PoC is run against. The nonce is the
// low 6 bytes of a uint256 returned by `pocChallenge_<nonce>()`; a PoC that deploys THIS run's
// target (the challenged bytecode handed to it on argv[1]) can call this fn and surface the nonce.
// SHALLOW leaf (string concat). `nonce` is a 12-hex-char fragment.
fn evm_challenge_fn(nonce: string) -> string {
    let sig = "\n    function pocChallenge_" + nonce;
    let body = sig + "() external pure returns (uint256) { return 0x";
    let lit = body + nonce;
    return lit + "; }\n";
}

// Inject the per-run Solidity challenge fn into the target's FIRST contract body (right after its
// opening `{`), so the compiled creation-bytecode the PoC deploys carries it. If the target has no
// `contract ` (interface/library only) the fn is appended at the end — the PoC then cannot resolve
// it on the deployed primary and the challenge fails (fail-safe rejection). SHALLOW leaf (string
// surgery: index_of + substring + concat only).
fn inject_evm_challenge(target: string, nonce: string) -> string {
    let fnsrc = evm_challenge_fn(nonce);
    let c = index_of(target, "contract ");
    if c < 0 {
        return target + fnsrc;
    }
    let after = substring(target, c, len(target));
    let rel = index_of(after, "{");
    if rel < 0 {
        return target + fnsrc;
    }
    let cut = c + rel + 1;
    let head = substring(target, 0, cut);
    let withfn = head + fnsrc;
    let tail = substring(target, cut, len(target));
    return withfn + tail;
}

// M3 (#858): EVM peer of wrap_with_challenge — renames the supplied PoC's first `fn main(` to
// `__poc_user_main` and prepends a `fn main` that, BEFORE the user main runs (it may exit 101 on
// the violation path), deploys argv[1] (the challenged target bytecode) through the EVM, calls
// `pocChallenge_<nonce>()`, and prints `POC_CHALLENGE=<nonce>` ONLY if the deployed target returns
// the matching low-6-byte value — proving the PoC was run against THIS run's target. Self-contained
// via fully-qualified `revm::`/`hex::` paths (no `use`, so it never conflicts with the PoC's own
// imports). A PoC run against a different / no target never surfaces the nonce -> rejected. If there
// is no `fn main(` the PoC is returned unchanged (the structural gate still applies). SHALLOW leaf.
fn wrap_with_challenge_evm(poc: string, nonce: string) -> string {
    let p = index_of(poc, "fn main(");
    if p < 0 { return poc; }
    let head = substring(poc, 0, p);
    let tail = substring(poc, p + 8, len(poc));
    let renamed = head + "fn __poc_user_main(";
    let body = renamed + tail;
    // Sequential single-`+` concats (the #820 razor-thin native stack overflows on long `+` chains).
    let e1 = "\nfn __poc_challenge_echo() {\n";
    let e2 = e1 + "    let __a: Vec<String> = std::env::args().collect();\n";
    let e3 = e2 + "    if __a.len() < 2 { return; }\n";
    let e4 = e3 + "    let __code = match std::fs::read_to_string(&__a[1]) { Ok(s) => s, Err(_) => return };\n";
    let e5 = e4 + "    let __bytes = match hex::decode(__code.trim()) { Ok(b) => b, Err(_) => return };\n";
    let e6 = e5 + "    let mut __evm = revm::Evm::builder().with_db(revm::db::CacheDB::new(revm::db::EmptyDB::default())).build();\n";
    let e7 = e6 + "    let __dep = revm::primitives::Address::from([0x55u8; 20]);\n";
    let e8 = e7 + "    __evm.db_mut().insert_account_info(__dep, revm::primitives::AccountInfo { balance: revm::primitives::U256::from(1u64), ..Default::default() });\n";
    let e9 = e8 + "    { let __tx = __evm.tx_mut(); __tx.caller = __dep; __tx.transact_to = revm::primitives::TxKind::Create; __tx.value = revm::primitives::U256::ZERO; __tx.data = revm::primitives::Bytes::from(__bytes); __tx.gas_limit = 30_000_000; __tx.gas_price = revm::primitives::U256::ZERO; __tx.nonce = None; }\n";
    let e10 = e9 + "    let __cr = match __evm.transact_commit() { Ok(r) => r, Err(_) => return };\n";
    let e11 = e10 + "    let __addr = match __cr { revm::primitives::ExecutionResult::Success { output: revm::primitives::Output::Create(_, Some(a)), .. } => a, _ => return };\n";
    let s1 = "    let __sel = revm::primitives::keccak256(\"pocChallenge_";
    let s2 = s1 + nonce;
    let s3 = s2 + "()\".as_bytes())[..4].to_vec();\n";
    let e12 = e11 + s3;
    let e13 = e12 + "    { let __tx = __evm.tx_mut(); __tx.caller = __dep; __tx.transact_to = revm::primitives::TxKind::Call(__addr); __tx.value = revm::primitives::U256::ZERO; __tx.data = revm::primitives::Bytes::from(__sel); __tx.gas_limit = 30_000_000; __tx.gas_price = revm::primitives::U256::ZERO; __tx.nonce = None; }\n";
    let e14 = e13 + "    let __rr = match __evm.transact_commit() { Ok(r) => r, Err(_) => return };\n";
    let e15 = e14 + "    if let revm::primitives::ExecutionResult::Success { output: revm::primitives::Output::Call(__ret), .. } = __rr {\n";
    let n1 = "        if __ret.len() == 32 { if hex::encode(&__ret[26..32]) == \"";
    let n2 = n1 + nonce;
    let n3 = n2 + "\" { eprintln!(\"POC_CHALLENGE=";
    let n4 = n3 + nonce;
    let n5 = n4 + "\"); } }\n";
    let e16 = e15 + n5;
    let e17 = e16 + "    }\n}\n";
    let e18 = e17 + "fn main() { __poc_challenge_echo(); __poc_user_main(); }\n";
    return body + e18;
}

// Generate the PoC and run it in the hardened sandbox. Resolution order:
//   1. BOUNTY_POC=<path> override — a human-supplied (or negative-test) candidate;
//   2. the 5-retry prompt loop (the real LLM path);
//   3. the deterministic two-sided class template (offline determinism: mock -> "mock").
// Every candidate is gated by the two-sided check (INVARIANT VIOLATED + CONTROL OK),
// inlined in the retry lambda to keep the native call stack shallow.
fn synth_via_prompt(cls: string, target: string) -> string {
    let pocpath = getenv("BOUNTY_POC");
    if len(pocpath) > 0 {
        // colony-lint: safe-exec-concat
        let supplied = exec sh "cat ${pocpath} 2>/dev/null || true";
        if index_of(supplied, "fn main") >= 0 {
            // #852: do NOT trust a supplied PoC's markers blindly. (1) structural gate: it
            // must reference the in-scope target/harness; (2) per-run target-linkage
            // challenge (run_challenged_poc): a nonce const appended to the target, echoed
            // by the wrapped PoC, proves it compiled against THIS run's target. Only then
            // does the caller's two-sided assess() decide. Closes the target-agnostic
            // marker-printer forgery; a sophisticated link-but-never-invoke PoC remains an
            // operator-trust residual (indistinguishable from captured stdout) — the
            // autonomous LLM/template path is unaffected.
            if poc_exercises_target(supplied) {
                // Inline (NOT a helper call — an extra frame here overflows the shallow
                // native stack, #820) with shallow sequential concats. compile_run stays
                // at this function's depth, exactly as the origin BOUNTY_POC path.
                if is_evm_target(target) {
                    // M3 (#858): EVM peer of the linkage challenge. The target is a .sol the PoC
                    // never imports as Rust, so the nonce rides a uniquely-named Solidity view fn
                    // injected into the target's bytecode (inject_evm_challenge); the wrapped PoC
                    // deploys argv[1] (the challenged target) through the EVM and echoes the nonce
                    // only if that exact bytecode returns it (wrap_with_challenge_evm). 12 hex
                    // chars = low 6 bytes of the returned uint256. Same fail-safe contract: no
                    // surfaced nonce -> the supplied PoC is rejected, never a false-VERIFIED.
                    let enonce = substring(sha256_hex(target + now_iso()), 0, 12);
                    let echallenged = inject_evm_challenge(target, enonce);
                    let ewrapped = wrap_with_challenge_evm(supplied, enonce);
                    let eout = compile_run(ewrapped, echallenged);
                    let eneedle = "POC_CHALLENGE=" + enonce;
                    if index_of(eout, eneedle) >= 0 {
                        print("synthesis: BOUNTY_POC exercised the in-scope target (EVM challenge ok) — gating by two-sided assess");
                        return eout;
                    }
                    print("synthesis: REJECTED BOUNTY_POC — failed the per-run EVM target-linkage challenge (did not run against the in-scope target); not trusting it");
                    return "inconclusive: supplied BOUNTY_POC failed the target-linkage challenge";
                }
                let nonce = substring(sha256_hex(target + now_iso()), 0, 16);
                let cdef = "\npub const POC_CHALLENGE: &str = \"" + nonce;
                let challenged = target + cdef + "\";\n";
                let cref = challenge_ref();
                let wrapped = wrap_with_challenge(supplied, cref);
                let out = compile_run(wrapped, challenged);
                let needle = "POC_CHALLENGE=" + nonce;
                if index_of(out, needle) >= 0 {
                    print("synthesis: BOUNTY_POC linked the in-scope target (challenge ok) — gating by two-sided assess");
                    return out;
                }
                print("synthesis: REJECTED BOUNTY_POC — failed the per-run target-linkage challenge (did not link the in-scope target); not trusting it");
                return "inconclusive: supplied BOUNTY_POC failed the target-linkage challenge";
            }
            print("synthesis: REJECTED BOUNTY_POC — it does not exercise the in-scope target (no target/harness reference); not trusting it");
            return "inconclusive: supplied BOUNTY_POC does not exercise the in-scope target";
        }
        print("synthesis: BOUNTY_POC unreadable — falling back to generation");
    }
    let llm_out = try {
        retry(5, || -> string {
            let poc = gen_poc(cls, target);
            if index_of(poc, "fn main") < 0 {
                print("synthesis: prompt candidate rejected — no usable Rust (no fn main)");
                throw("prompt produced no usable Rust");
            }
            // observability: persist the LLM candidate + its compile/run output so a real-target
            // run that does not verify still leaves a forensic artifact (last_candidate.rs / .out).
            file_write("last_candidate.rs", poc);
            let out = compile_run(poc, target);
            file_write("last_candidate.out", out);
            if index_of(out, "INVARIANT VIOLATED:") >= 0 {
                if index_of(out, "CONTROL OK:") >= 0 {
                    out;
                } else {
                    print("synthesis: prompt candidate rejected — fired the sentinel without a passing control");
                    throw("candidate fired the sentinel without a passing control");
                }
            } else {
                print("synthesis: prompt candidate rejected — no invariant violation / compile error");
                throw("candidate did not violate the invariant");
            }
        });
    } catch e {
        "";
    };
    if assess(llm_out) == "verified" {
        print("synthesis: prompt-generated PoC verified (two-sided)");
        return llm_out;
    }
    // V5: the deterministic fallback (built-in template / harness default PoC) is
    // signer-shaped, correct ONLY for MissingSignerCheck. For the other V3 classes the
    // LLM is the only generator — with no usable candidate the run is inconclusive
    // (never a false-VERIFIED; the #820 two-sided gate stays the source of truth).
    if cls != "MissingSignerCheck" {
        print("synthesis: prompt path exhausted; no deterministic template for " + cls + " — inconclusive");
        return llm_out;
    }
    if len(harness_dir()) > 0 {
        print("synthesis: prompt path exhausted — running the harness default two-sided PoC");
        return compile_run("", target);
    }
    print("synthesis: prompt path exhausted — using the deterministic MissingSignerCheck template");
    return compile_run(synth_exploit(), target);
}

// ---- standardized report + human submission gate -----------------------------

// Immunefi severity scale for a verified finding class (V5: per-class).
fn severity_for(cls: string) -> string {
    if cls == "MissingSignerCheck" { return "Critical"; }
    if cls == "MissingOwnerCheck" { return "Critical"; }
    if cls == "ArbitraryCPI" { return "Critical"; }
    if cls == "AccessControl" { return "Critical"; }
    if cls == "AccountDataMatching" { return "High"; }
    if cls == "Reentrancy" { return "High"; }
    if cls == "OracleManipulation" { return "High"; }
    if cls == "UncheckedCall" { return "Medium"; }
    if cls == "IntegerOverflow" { return "Medium"; }
    return "Informational";
}

// V5 (#843): per-class report narrative. Each is a SHALLOW leaf (string compares +
// concat only) so the report stays accurate to the detected class instead of carrying a
// hardcoded signer-drain story. Generic default covers any unrecognised token.
fn summary_for(cls: string, node: string) -> string {
    if cls == "MissingSignerCheck" {
        return "The `" + node + "` handler authorizes a state-mutating action without verifying that the authority account signed the transaction, so any caller can perform it without the owner's signature.";
    }
    if cls == "MissingOwnerCheck" {
        return "The `" + node + "` handler trusts a passed account without verifying it is owned by the expected program, so an attacker can substitute an account they control carrying forged data.";
    }
    if cls == "AccountDataMatching" {
        return "The `" + node + "` handler never checks that the passed account's identity matches the privileged identity stored in state, so an attacker can pass a different account and bypass the access-control check.";
    }
    if cls == "ArbitraryCPI" {
        return "The `" + node + "` handler performs a cross-program invocation against an unverified, caller-supplied program id, so an attacker can redirect the CPI to a malicious program.";
    }
    if cls == "IntegerOverflow" {
        return "The `" + node + "` handler performs unchecked arithmetic on caller-influenced amounts, so a crafted amount can wrap or underflow and corrupt the conserved value (balance / supply).";
    }
    if cls == "Reentrancy" {
        return "The `" + node + "` function makes an external value-bearing call before zeroing the caller's recorded balance (a checks-effects-interactions violation), so a malicious receiver can re-enter and withdraw repeatedly, draining funds far beyond its own deposit.";
    }
    if cls == "AccessControl" {
        return "The `" + node + "` function performs a privileged state change without an owner/role check (no `onlyOwner` / `require(msg.sender == owner)`), so any caller can invoke it and seize control or funds the contract was meant to restrict to its owner.";
    }
    if cls == "UncheckedCall" {
        return "The `" + node + "` function ignores the success/return value of an external call (or invokes an attacker-influenced target/delegatecall), so a failed or hijacked call is silently trusted and the contract's accounting diverges from what actually transferred.";
    }
    if cls == "OracleManipulation" {
        return "The `" + node + "` function reads a price/value from a manipulable spot source without a TWAP or sanity bound, so an attacker who moves that source within a transaction skews the contract's view and extracts value at the manipulated rate.";
    }
    return "The `" + node + "` handler exposes a privileged action to an unauthorized caller, breaking its access-control invariant.";
}

fn impact_for(cls: string) -> string {
    if cls == "IntegerOverflow" {
        return "Value corruption: a wrapped balance / supply lets an attacker mint or withdraw value that should not exist, breaking conservation of funds.";
    }
    if cls == "ArbitraryCPI" {
        return "An attacker redirects a trusted cross-program call to a malicious program, enabling arbitrary effects executed under the victim program's authority.";
    }
    if cls == "Reentrancy" {
        return "Direct theft of funds: an attacker re-enters the vulnerable function during its external call and withdraws repeatedly, draining the entire pooled balance (every depositor's funds), not just its own.";
    }
    if cls == "AccessControl" {
        return "Privileged takeover: any caller invokes an owner-only function — transferring ownership, withdrawing the contract's funds, minting supply, or pausing it — seizing control or value the contract was meant to gate.";
    }
    if cls == "UncheckedCall" {
        return "Accounting divergence or arbitrary execution: a silently-failed transfer credits value that never moved, or an attacker-controlled call target / delegatecall executes attacker code under the contract's own context and storage.";
    }
    if cls == "OracleManipulation" {
        return "Economic drain: an attacker manipulates the spot price the contract trusts (a flash-loan-skewed pair reserve or inflated spot balance) and borrows / swaps / liquidates at the false rate, extracting value from the protocol.";
    }
    return "Unauthorized control over a privileged action: an attacker performs it without the required authorization, typically draining funds or seizing state.";
}

fn remediation_for(cls: string) -> string {
    if cls == "MissingSignerCheck" {
        return "Require the authority to sign: type the field as `Signer` (Anchor) or assert `authority.is_signer` (native) before any state mutation.";
    }
    if cls == "MissingOwnerCheck" {
        return "Verify account ownership before trusting data: constrain `owner = <program>` (Anchor) or assert `account.owner == program_id` (native).";
    }
    if cls == "AccountDataMatching" {
        return "Compare the passed account against the identity stored in state (e.g. `has_one = authority` / `require_keys_eq!(account.key, state.authority)`) before the privileged action.";
    }
    if cls == "ArbitraryCPI" {
        return "Verify the invoked program id equals the expected, hard-coded program before the CPI (e.g. `require_keys_eq!(program.key, expected_program_id)`).";
    }
    if cls == "IntegerOverflow" {
        return "Use checked arithmetic (`checked_add` / `checked_sub` / `checked_mul`) and reject on overflow, or saturating ops where a clamp is the intended behaviour.";
    }
    if cls == "Reentrancy" {
        return "Apply checks-effects-interactions: update state (zero the caller's balance) BEFORE the external call, and/or guard the function with a reentrancy lock (e.g. OpenZeppelin `nonReentrant`).";
    }
    if cls == "AccessControl" {
        return "Gate the privileged function with an access-control check: an `onlyOwner` / role modifier (e.g. OpenZeppelin `Ownable` / `AccessControl`) or an explicit `require(msg.sender == owner)` before the state change.";
    }
    if cls == "UncheckedCall" {
        return "Check the returned success of every external call (`(bool ok, ) = ...; require(ok)`), prefer `transfer`/`SafeERC20` where appropriate, and never `delegatecall` / call a target an attacker can influence.";
    }
    if cls == "OracleManipulation" {
        return "Read prices from a manipulation-resistant source: a time-weighted average price (TWAP) or a vetted oracle (e.g. Chainlink) with staleness + deviation bounds, never a single-block spot reserve / spot balanceOf.";
    }
    return "Add the missing access-control check so only the authorized party can perform the privileged action.";
}

// Best-effort implicated-node extraction: the handler fn name from the target (structural
// detection). Handles both Rust (`fn `) and Solidity (`function `) targets; for a Solidity
// reentrancy target the vulnerable function is `withdraw`, so prefer it when present.
fn first_fn_name(src: string) -> string {
    let p = index_of(src, "fn ");
    if p < 0 {
        if index_of(src, "function withdraw") >= 0 { return "withdraw"; }
        let fp = index_of(src, "function ");
        if fp < 0 { return "(handler)"; }
        let frest = substring(src, fp + 9, len(src));
        let fparen = index_of(frest, "(");
        if fparen < 0 { return "(handler)"; }
        return substring(frest, 0, fparen);
    }
    let rest = substring(src, p + 3, len(src));
    let paren = index_of(rest, "(");
    if paren < 0 { return "(handler)"; }
    return substring(rest, 0, paren);
}

// bool -> "yes"/"no" (no mutable reassignment in .ag, so compute inline via a leaf).
fn yn(cond: bool) -> string {
    if cond { return "yes"; }
    return "no";
}

// Standardized Immunefi-shaped finding. HUMAN-GATED: the colony writes the finding to
// disk and marks it PENDING; submission to a bounty platform is a SEPARATE, explicit
// human action. The colony NEVER contacts a platform (no http_post anywhere).
fn submission_report(cls: string, th: string, node: string, trace: string, poc_src: string, std_ok: string, observed: string, snap_section: string) -> string {
    return "# Bounty finding — " + cls + "\n\n" +
        "| Field | Value |\n|---|---|\n" +
        "| Severity (Immunefi) | " + severity_for(cls) + " |\n" +
        "| Rule | " + cls + " |\n" +
        "| Affected function | `" + node + "` |\n" +
        "| Sub-graph hash | " + th + " |\n" +
        "| Standalone PoC re-verified | " + std_ok + " |\n\n" +
        "## Summary\n\n" + summary_for(cls, node) + "\n\n" +
        "## Vulnerability details (implicated nodes)\n\n" + trace + "\n\n" +
        "## Proof of Concept (standalone, reproducible)\n\nSingle-file Rust PoC — no external deps, compiles + runs offline:\n\n```rust\n" + poc_src + "```\n\n" +
        "Reproduce:\n\n```\nrustc --edition 2021 poc_standalone.rs -o poc && ./poc\n```\n\n" +
        "Observed:\n\n```\n" + observed + "```\n\n" +
        snap_section +
        "## Impact\n\n" + impact_for(cls) + "\n\n" +
        "## Remediation\n\n" + remediation_for(cls) + "\n\n" +
        "## Submission — HUMAN-GATED (NOT SUBMITTED)\n\n" +
        "**STATUS: PENDING HUMAN APPROVAL — NOT SUBMITTED.** This colony NEVER posts to a bounty platform (anti-bot / dedup → bans). Submission to Immunefi / Code4rena / Sherlock is a SEPARATE, explicit human action: a reviewer reads this report and submits it manually.\n\n" +
        "---\n_Generated by the auditor.ag colony federation on the agentis substrate._\n";
}

// Tier-gated submission marker (ADR-0001). The colony NEVER auto-posts to a bounty
// platform — submission stays a separate, explicit human action. This gate decides
// only whether a verified finding is STAGED for human review: at `review-gated` /
// `autonomous` tier the colony writes the `pending_human_review` submission marker and
// emits `submission:pending` (a reviewer is expected to act on it); at `propose` /
// `shadow` / `dormant` it writes the report alone and stays silent on the submission
// bus. Returns "staged" / "report-only" for the synthesis log line. One tier() call
// per run; the report itself is always written by the caller regardless of tier.
fn submission_gate(th: string) -> string {
    let my_tier = tier("auditor");
    if my_tier == "review-gated" {
        memo_write("bounty:submission:" + th, "pending_human_review");
        emit("submission:pending", th);
        return "staged";
    } else {
        if my_tier == "autonomous" {
            memo_write("bounty:submission:" + th, "pending_human_review");
            emit("submission:pending", th);
            return "staged";
        } else {
            return "report-only";
        }
    }
}

// ---- on-chain state snapshot replay ------------------------------------------

// The frozen account snapshot a host-side RPC dump would produce. If BOUNTY_SNAPSHOT
// names a readable file (a real host RPC dump, mounted RO into the sandbox), use it;
// else the embedded default frozen state. Flat key=value so a std-only PoC parses it.
fn snapshot_state() -> string {
    let p = getenv("BOUNTY_SNAPSHOT");
    if len(p) > 0 {
        // colony-lint: safe-exec-concat
        let dump = exec sh "cat ${p} 2>/dev/null || true";
        if index_of(dump, "account.lamports") >= 0 {
            print("snapshot: using host-supplied RPC dump (BOUNTY_SNAPSHOT, real account format)");
            return dump;
        }
        if index_of(dump, "vault.balance") >= 0 {
            print("snapshot: using host-supplied RPC dump (BOUNTY_SNAPSHOT)");
            return dump;
        }
        print("snapshot: BOUNTY_SNAPSHOT unreadable — using embedded frozen state");
    }
    return "vault.authority=1\nvault.balance=1000\naccount.lamports=1000000000\naccount.data_first8_le=1000\n";
}

// A PoC that REPLAYS the exploit against a FROZEN snapshot read from disk — zero
// network inside the sandbox (std::fs only, no std::net). Two-sided: the
// control accepts the authorized signer, the exploit drains the snapshotted vault.
fn synth_snapshot_exploit() -> string {
    return "include!(\"target.rs\");\n" +
        "use std::fs;\n" +
        "fn field(s: &str, key: &str) -> u64 {\n" +
        "    for line in s.lines() {\n" +
        "        if let Some(rest) = line.strip_prefix(key) {\n" +
        "            if let Some(v) = rest.strip_prefix(\"=\") { return v.trim().parse().unwrap_or(0); }\n" +
        "        }\n" +
        "    }\n" +
        "    0\n" +
        "}\n" +
        "fn main() {\n" +
        "    // frozen on-chain snapshot (host RPC dump), replayed offline — no network.\n" +
        "    let snap = fs::read_to_string(\"snapshot.txt\").unwrap_or_default();\n" +
        "    let authority = field(&snap, \"vault.authority\");\n" +
        "    let balance = field(&snap, \"vault.balance\");\n" +
        "    // control: an AUTHORIZED signer from the snapshot must be accepted.\n" +
        "    let mut cvault = Vault { authority: authority, balance: balance };\n" +
        "    let signer = AccountInfo { key: authority, is_signer: true };\n" +
        "    let cpre = cvault.balance;\n" +
        "    let cres = withdraw(WithdrawCtx { vault: &mut cvault, authority: &signer }, cpre);\n" +
        "    if cres.is_ok() { println!(\"CONTROL OK: authorized withdrawal accepted {} -> {}\", cpre, cvault.balance); }\n" +
        "    else { println!(\"control anomaly: authorized withdrawal rejected\"); }\n" +
        "    // exploit: an UNAUTHORIZED caller drains the snapshotted vault.\n" +
        "    let mut vault = Vault { authority: authority, balance: balance };\n" +
        "    let attacker = AccountInfo { key: authority + 1, is_signer: false };\n" +
        "    let pre = vault.balance;\n" +
        "    let res = withdraw(WithdrawCtx { vault: &mut vault, authority: &attacker }, pre);\n" +
        "    let invariant_held = res.is_err() && vault.balance == pre;\n" +
        "    if invariant_held { println!(\"invariant held: unauthorized withdrawal rejected\"); }\n" +
        "    else {\n" +
        "        eprintln!(\"INVARIANT VIOLATED: unauthorized caller drained snapshotted vault {} -> {}\", pre, vault.balance);\n" +
        "        std::process::exit(101);\n" +
        "    }\n" +
        "}\n";
}

// Report section documenting the frozen-snapshot replay.
fn snapshot_section(snap: string, snap_run: string, snap_ok: string) -> string {
    return "## On-chain state snapshot replay\n\n" +
        "The exploit is replayed against a FROZEN account snapshot (a host-side RPC dump, mounted read-only into the sandbox) with ZERO network inside the sandbox — deterministic offline reproduction.\n\n" +
        "Frozen snapshot (`snapshot.txt`):\n\n```\n" + snap + "```\n\n" +
        "Replay (`poc_snapshot.rs` reads the snapshot via std::fs, no network):\n\n```\n" + snap_run + "```\n\n" +
        "Snapshot replay re-verified: " + snap_ok + "\n\n";
}

// V4 (#842): replay a frozen on-chain snapshot through the REAL SVM in the native vault
// harness — write snapshot.txt into the harness, build + run the `poc_snapshot` bin offline
// (zero network in-sandbox). Leaf calls only (file_write + one exec) — stack stays shallow.
fn run_snapshot_replay(snap: string) -> string {
    let hd = getenv("SOLANA_HARNESS_DIR");
    file_write("snap_in.txt", snap);
    // colony-lint: safe-exec-concat
    return exec sh "cp snap_in.txt ${hd}/snapshot.txt; cd ${hd}; export PATH=$HOME/.cargo/bin:$PATH; CARGO_NET_OFFLINE=1 cargo build --quiet --bin poc_snapshot --offline > snap_build.out 2>&1; BRC=$?; if [ $BRC -ne 0 ]; then cat snap_build.out; echo __rc=$BRC; else RAYON_NUM_THREADS=4 ./target/debug/poc_snapshot 2>&1; echo __rc=$?; fi";
}

// V4: the report's on-chain snapshot section. In native-harness mode with a frozen snapshot
// supplied (BOUNTY_SNAPSHOT, a real host RPC dump), replay it through the real SVM offline
// and document the result; otherwise (anchor target, or no snapshot supplied) the snapshot
// replay does not apply -> n/a. The two-sided gate still governs (a snapshot whose state
// does not drain stays inconclusive — no false-VERIFIED from a foreign/empty snapshot).
fn harness_snap_section() -> string {
    if len(getenv("SOLANA_HARNESS_DIR")) > 0 {
        if len(getenv("BOUNTY_SNAPSHOT")) > 0 {
            let snap = snapshot_state();
            let snap_run = run_snapshot_replay(snap);
            return snapshot_section(snap, snap_run, yn(assess(snap_run) == "verified"));
        }
    }
    return snapshot_section("", "n/a — verified through the real Solana SVM; supply BOUNTY_SNAPSHOT (a host RPC dump) to also replay a frozen on-chain account offline", "n/a");
}

// ---- agents -------------------------------------------------------------------

// reconn: dependency recon via `cargo tree` + DAG distillation + verdict-cache lookup.
// reference node-extractor: a std-only Rust parser (compiles offline, zero crate
// deps) that scans an Anchor/CosmWasm Rust target for fn / struct / impl items and emits
// the canonical JSON node stream. Real engagements swap in tree-sitter/semgrep — no core
// change. This keeps parsing in the colony layer; core stays zero-dep (no parse builtin).
fn node_extractor() -> string {
    return "use std::fs;\n" +
        "fn ident_after(s: &str, kw: &str) -> String {\n" +
        "    match s.find(kw) {\n" +
        "        Some(i) => s[i + kw.len()..].chars().take_while(|c| c.is_alphanumeric() || *c == '_').collect(),\n" +
        "        None => String::new(),\n" +
        "    }\n" +
        "}\n" +
        "fn main() {\n" +
        "    let src = fs::read_to_string(\"target_src.rs\").unwrap_or_default();\n" +
        "    let mut nodes: Vec<String> = Vec::new();\n" +
        "    for line in src.lines() {\n" +
        "        let t = line.trim_start();\n" +
        "        let (kind, kw) = if t.starts_with(\"pub fn \") || t.starts_with(\"fn \") { (\"fn\", \"fn \") }\n" +
        "            else if t.starts_with(\"pub struct \") || t.starts_with(\"struct \") { (\"struct\", \"struct \") }\n" +
        "            else if t.starts_with(\"impl \") { (\"impl\", \"impl \") }\n" +
        "            else { continue };\n" +
        "        let name = ident_after(t, kw);\n" +
        "        if !name.is_empty() {\n" +
        "            nodes.push(format!(\"{{\\\"kind\\\":\\\"{}\\\",\\\"name\\\":\\\"{}\\\"}}\", kind, name));\n" +
        "        }\n" +
        "    }\n" +
        "    println!(\"[{}]\", nodes.join(\",\"));\n" +
        "}\n";
}

// node-stream ingestion: exec the reference parser in the hardened sandbox, consume its JSON
// node stream. Graceful — a compile/run failure degrades to "[]" and never breaks the
// audit (structural detection is unaffected; it uses the in-.ag per-fn view).
fn ingest_nodes(target: string) -> string {
    file_write("target_src.rs", target);
    file_write("extract_nodes.rs", node_extractor());
    return exec sh "rm -f extract; rustc --edition 2021 extract_nodes.rs -o extract 2>/dev/null && ./extract 2>/dev/null || echo '[]'";
}

// M2 (#858): EVM/Solidity node-stream ingestion — the EVM peer of ingest_nodes(). Execs the
// host-side `ast.js` (pinned solc 0.8.26) in the EVM harness dir, where ast.js + node_modules/solc
// live, mirroring how compile_run runs `node compile.js` there. solc parses the target to its AST;
// ast.js walks it and emits the SAME canonical {"kind","name"} node stream the Rust extractor
// produces (function / external-call / storage-write-sink nodes). Host-side parse, exactly like the
// Rust exec-driven parse. Graceful — a solc fatal / missing ast.js degrades to "[]" and never breaks
// the audit (the in-.ag structural reentrancy view is unaffected). `target` is written into the
// harness scratch (h_ingest.sol, gitignored) so the parse never touches the committed contracts.
fn ingest_evm_nodes(target: string) -> string {
    let ed = getenv("EVM_HARNESS_DIR");
    if len(ed) == 0 {
        return "[]";
    }
    // #859: a repo target's in-scope file imports deps — point ast.js at the file IN the repo
    // plus the repo ROOT so its imports resolve (remappings + lib/ + node_modules) and the node
    // stream is non-empty instead of degrading to "[]" on the first unresolved import. BOUNTY_TARGET
    // is the in-scope file's absolute path; ast.js keys it project-relative for correct import normalization.
    if len(getenv("BOUNTY_REPO")) > 0 {
        // colony-lint: safe-exec-concat
        return exec sh "cd ${ed}; node ast.js \"$BOUNTY_TARGET\" \"$BOUNTY_REPO\" 2>/dev/null || echo '[]'";
    }
    file_write("h_ingest.sol", target);
    // colony-lint: safe-exec-concat
    return exec sh "cp h_ingest.sol ${ed}/contracts/Ingest.sol 2>/dev/null; cd ${ed}; node ast.js contracts/Ingest.sol 2>/dev/null || echo '[]'";
}

agent reconn() -> void {
    let target = listen("audit:target");
    // M2 (#858): EVM/Solidity targets get the FULL reconn->guard->tracker DAG pipeline (the
    // M1 trivial-node bypass is gone). The Rust path's `cargo tree` + Rust fn/struct/impl
    // node-extractor do not apply to a `.sol`, so reconn runs the EVM peer: a host-side solc
    // AST parse (ast.js, pinned solc 0.8.26) -> the SAME canonical {"kind","name"} node stream
    // (function / external-call / storage-write-sink nodes), dag_put as a sub-graph exactly like
    // the Rust node stream. The content-addressed target hash (verdict cache + federation
    // blacklist + dedup) stays `dag_put(strip_comments(target))`, byte-identical to M1, so a
    // cached EVM verdict from before M2 still hits. Downstream (guard fires Reentrancy, the
    // two-sided real-EVM synthesis gate) is unchanged — M2 only changes how reconn builds the DAG.
    if is_evm_target(target) {
        let enodes = ingest_evm_nodes(target);
        let enh = dag_put(enodes);
        let encount = len(regex_find_all("\"name\"", enodes));
        print("reconn: EVM/Solidity ingest ->", encount, "node(s) -> dag", substring(enh, 0, 12));
        // distill: store each Solidity handler sub-graph in the content-addressed DAG (dedup cache).
        let ecode = strip_comments(target);
        let en = distill_subgraphs_evm(ecode);
        let eth = dag_put(ecode);
        print("reconn: distilled", en, "sub-graph(s); target hash", substring(eth, 0, 12));
        // audit-once: reuse a prior verdict / federation blacklist for this exact sub-graph.
        let eprior = pick_prior(recall_latest("bounty:verdict:" + eth), recall_latest("bounty:blacklist:" + eth));
        emit("guard:target", target);
        emit("guard:th", eth);
        emit("guard:cached", eprior);
        emit("tracker:target", target);
        return;
    }
    file_write("Cargo.toml", "[package]\nname = \"bounty-target\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\n");
    file_write("src/lib.rs", target);
    let tree = exec sh "cargo tree --offline 2>&1; echo __rc=$?";
    print("reconn: cargo tree ->", substring(tree, 0, 36));
    // exec-driven canonical node-stream ingestion (core stays zero-dep) -> DAG.
    let nodes = ingest_nodes(target);
    let nh = dag_put(nodes);
    let ncount = len(regex_find_all("\"name\"", nodes));
    print("ingest: canonical node stream (exec-driven parse):", ncount, "node(s) -> dag", substring(nh, 0, 12));
    // distill: store handler sub-graphs in the content-addressed DAG (dedup cache).
    let code = strip_comments(target);
    let n = distill_subgraphs(code);
    let th = dag_put(code);
    print("reconn: distilled", n, "sub-graph(s); target hash", substring(th, 0, 12));
    // audit-once: reuse a prior verdict / federation blacklist for this exact sub-graph.
    let prior = pick_prior(recall_latest("bounty:verdict:" + th), recall_latest("bounty:blacklist:" + th));
    emit("guard:target", target);
    emit("guard:th", th);
    emit("guard:cached", prior);
    emit("tracker:target", target);
}

// tracker: dataflow trace — does a guard dominate the sink (untrusted input -> mutation)?
agent tracker() -> void {
    let target = listen("tracker:target");
    let code = strip_comments(target);
    let sink = sink_pos(code);
    if sink < 0 {
        emit("synth:trace", "no state mutation sink reached");
    } else {
        let g = guard_pos(code);
        if g >= 0 {
            if g < sink {
                emit("synth:trace", "sink reachable but a signer/authority guard DOMINATES it (guarded path)");
            } else {
                emit("synth:trace", "sink reachable; guard present but does NOT dominate (post-mutation check, ineffective)");
            }
        } else {
            emit("synth:trace", "untrusted input reaches the state-mutation sink with NO dominating guard");
        }
    }
    print("tracker: dataflow trace emitted");
}

// guard: reuse the cached verdict on a DAG hit (audit-once), else structural detection.
agent guard() -> void {
    let target = listen("guard:target");
    let th = listen("guard:th");
    let cached = listen("guard:cached");
    emit("synth:target", target);
    emit("synth:th", th);
    if len(cached) > 0 {
        // Cache HIT: reuse the cached verdict directly (audit-once, no re-detection).
        print("guard: cache HIT — reusing verdict", cached, "for sub-graph", substring(th, 0, 12), "(audit-once, no re-detection)");
        emit("synth:hit", "hit");
        emit("synth:class", cached);
    } else {
        if is_evm_target(target) {
            // M1 (#858): EVM/Solidity detection. The Rust heuristic + Solana-token LLM classifier
            // do not apply, so route through the EVM pair: the structural reentrancy heuristic
            // (CEI violation) + an EVM LLM classifier (Reentrancy vs Safe). The LLM wins when
            // present, "Safe" -> none, an empty verdict falls back to the heuristic. M3 broadens
            // this to the full EVM class set; the two-sided real-EVM gate stays the source of truth.
            let evm_heur = detect_reentrancy(strip_comments(target));
            let evm_llm = classify_evm_llm(target);
            let evm_cls = resolve_evm_cls(evm_llm, evm_heur);
            if is_vuln_class(evm_cls) {
                print("guard: " + evm_cls + " fired [" + severity_for(evm_cls) + "] (EVM)");
            } else {
                print("guard: no EVM rule fired — target looks safe");
            }
            emit("synth:hit", "miss");
            emit("synth:class", evm_cls);
        } else {
            // MISS: detect afresh. Run the structural detector at the agent's OWN depth
            // (classify()'s fold overflows the native stack if called through an extra wrapper
            // frame — the colony is tuned shallow). Then the V3 LLM classifier, then a shallow
            // resolve: the LLM class wins (generalises to real Anchor), "Safe" -> none, an
            // empty LLM verdict (mock / offline) falls back to the heuristic.
            let heuristic = classify(strip_comments(target));
            let llm = classify_llm(target);
            let cls = resolve_cls(llm, heuristic);
            if is_vuln_class(cls) {
                print("guard: " + cls + " fired [" + severity_for(cls) + "]");
            } else {
                print("guard: no rule fired — target looks safe");
            }
            emit("synth:hit", "miss");
            emit("synth:class", cls);
        }
    }
}

// synthesis: per-class disposition. On a cache HIT, reuse the verified verdict and
// skip the rustc re-compile (dedup). On a MISS, build+run the PoC in the hardened
// sandbox, two-sided validate (control accepted + exploit broke the invariant),
// then CACHE the verdict + blacklist.
agent synthesis() -> void {
    let cls = listen("synth:class");
    let target = listen("synth:target");
    let th = listen("synth:th");
    let hit = listen("synth:hit");
    let trace = listen("synth:trace");
    if is_vuln_class(cls) {
        if hit == "hit" {
            print("synthesis: reusing cached VERIFIED verdict (audit-once) — skipping PoC re-compile");
            let node = first_fn_name(target);
            let gate = submission_gate(th);
            file_write("report.md", submission_report(cls, th, node, trace,
                "// PoC reused from the original audit — fetch the standalone PoC from the\n// content-addressed DAG cache for this sub-graph (audit-once dedup).\n",
                "cached",
                "(reused from the DAG verdict-cache — no re-compile this run)",
                ""));
            print("report: wrote standardized Immunefi report.md  (reused, sub-graph", substring(th, 0, 12), ")");
            print("submission:", gate, "— human-gated, never auto-posted");
            print("Verdict: VERIFIED");
        } else {
            file_write("target.rs", target);
            print("synthesis: generating " + cls + " PoC (prompt 5-retry + class-specific invariant)");
            let run_out = synth_via_prompt(cls, target);
            let verdict = assess(run_out);
            if verdict == "verified" {
                memo_write("bounty:verified", th);
                memo_write("bounty:verdict:" + th, cls);
                memo_write("bounty:blacklist:" + th, cls);
                knowledge_sell("bounty:vuln:" + th, cls + ":" + severity_for(cls), 1);
                let node = first_fn_name(target);
                let gate = submission_gate(th);
                let hd = harness_dir();
                if is_evm_target(target) {
                    // M1 (#858): EVM harness mode. The PoC was verified through the REAL EVM
                    // (revm) by synth_via_prompt — solc compiled the target host-side, the revm
                    // poc.rs loaded the creation-bytecode and ran the two-sided gate. Ship the
                    // revm PoC + its actual run output. The Solana frozen-snapshot replay does
                    // not apply to an EVM target.
                    // colony-lint: safe-exec-concat
                    let epoc_src = exec sh "cat ${hd}/src/bin/poc.rs 2>/dev/null || true";
                    file_write("report.md", submission_report(cls, th, node, trace, epoc_src, "yes (real EVM via revm)", run_out, "## On-chain state snapshot replay\n\nn/a — verified through the real EVM (revm): solc compiles the in-scope target to creation bytecode host-side, the revm PoC deploys it and runs the two-sided gate. The honest CONTROL flow conserves on this exact target and the EXPLOIT breaks the conservation invariant.\n\n"));
                    print("synthesis: VERIFIED — real-EVM two-sided PoC (revm)");
                    print("report: wrote standardized Immunefi report.md  (sub-graph", substring(th, 0, 12), ")");
                    print("submission:", gate, "— human-gated, never auto-posted");
                    print("Verdict: VERIFIED");
                } else { if len(hd) > 0 {
                    // Harness mode: the PoC was already verified through the REAL Solana SVM
                    // (solana-program-test + BanksClient) by synth_via_prompt. The std-only
                    // standalone re-compile + frozen-snapshot replay assume a std-stub target
                    // and do not apply to a native program, so the report ships the real-SVM
                    // PoC + its actual run output instead of a std-only rustc re-verify.
                    // colony-lint: safe-exec-concat
                    let poc_src = exec sh "cat ${hd}/src/bin/poc.rs 2>/dev/null || true";
                    let snap_sec = harness_snap_section();
                    file_write("report.md", submission_report(cls, th, node, trace, poc_src, "yes (real Solana SVM)", run_out, snap_sec));
                    print("synthesis: VERIFIED — real-SVM two-sided PoC (solana-program-test + BanksClient)");
                    print("report: wrote standardized Immunefi report.md  (sub-graph", substring(th, 0, 12), ")");
                    print("submission:", gate, "— human-gated, never auto-posted");
                    print("Verdict: VERIFIED");
                } else {
                    // std-only path: single-file standalone re-verify + frozen-snapshot replay.
                    let std_run = exec sh "( cat target.rs; grep -v 'include!' exploit.rs ) > poc_standalone.rs; rm -f poc_std; rustc --edition 2021 poc_standalone.rs -o poc_std 2>&1; ./poc_std 2>&1; echo __rc=$?";
                    let poc_src = exec sh "cat poc_standalone.rs 2>/dev/null || true";
                    let std_ok = yn(assess(std_run) == "verified");
                    let snap = snapshot_state();
                    file_write("snapshot.txt", snap);
                    file_write("poc_snapshot.rs", synth_snapshot_exploit());
                    let snap_run = exec sh "rm -f poc_snap; rustc --edition 2021 poc_snapshot.rs -o poc_snap 2>&1; ./poc_snap 2>&1; echo __rc=$?";
                    let snap_ok = yn(assess(snap_run) == "verified");
                    file_write("report.md", submission_report(cls, th, node, trace, poc_src, std_ok, std_run, snapshot_section(snap, snap_run, snap_ok)));
                    print("synthesis: VERIFIED — cached verdict + blacklisted sub-graph");
                    print("synthesis: standalone PoC re-verified:", std_ok);
                    print("snapshot: replayed frozen on-chain state offline — re-verified:", snap_ok);
                    print("report: wrote standardized Immunefi report.md  (sub-graph", substring(th, 0, 12), ")");
                    print("submission:", gate, "— human-gated, never auto-posted");
                    print("Verdict: VERIFIED");
                }
                }
            } else {
                print("synthesis: Inconclusive — " + verdict);
                print("Verdict: INCONCLUSIVE (" + verdict + ")");
            }
        }
    } else {
        print("synthesis: no finding to synthesize");
        print("Verdict: SAFE");
    }
}

// --- orchestrator: seed the bus, then run the event chain (no polling) ---
print("auditor: federation start");
emit("audit:target", ingest_target());
reconn();
guard();
tracker();
synthesis();
// last_check heartbeat: a freshness memo the dashboard reads to confirm the colony ran.
memo_write("auditor:last_check", now_iso());
print("auditor: federation done");
