cb 300000;
// #999 — substrate-native ADVERSARIAL REFUTATION. Takes ONE candidate finding (a hunter/auditor LEAD:
// file:fn + the claimed exploit) and the relevant in-scope code, then runs an INDEPENDENT skeptic that
// tries to REFUTE the claim against the ACTUAL control/data flow — the colony-native form of the
// `adversarial-refute` step (auditor/methods/registry.md) that previously ran as an externally-orchestrated
// subagent. It is the proving pattern (#999) for porting the remaining deep capabilities (deep cross-function
// audit, build-and-run PoC, fork-differential) onto the substrate too.
//
// This is the second gate AFTER the hunter surfaces a CANDIDATE and BEFORE the operator spends a Foundry
// PoC on it: a separate skeptical reader, with NO stake in the finding being real, must fail to break it.
// The bias is deliberately conservative — DEFAULT TO REFUTED whenever the code does not unambiguously
// confirm the exploit, so only candidates that survive a hostile read reach the (expensive) forge gate.
// A REAL verdict here is still a LEAD, never a finding: only a PASSING forge-verify PoC makes it a finding,
// and submission stays an explicit human action.
//
// Env:
//   CAND_FILE_FN   the candidate location, "path/to/Contract.sol:functionName" (free-form label; the lens)
//   CAND_CLASS     the bug class id the candidate was filed under, e.g. "C10" (optional; "" if unknown)
//   CAND_SEVERITY  the claimed severity, "Medium" | "High" (optional)
//   CAND_EXPLOIT   the one-sentence external exploit path the candidate claims
//   CODE_PATH      absolute path to a file holding the RELEVANT code (the function(s) + context to judge
//                  against). The exec sandbox cannot read $HOME — pass a rundir path or a /tmp path.
//   AUX_CODE_PATH  optional path to the IMPLEMENTATION APPENDIX (#1861): when CODE_PATH is an `abstract
//                  contract`, this is a function-sliced derived contract that implements its `virtual`
//                  members. "" to skip — and with "" the prompt is byte-identical to the pre-#1861 one.
//   BRIEF_PATH     optional path to the protocol brief (invariants + KNOWN ISSUES to exclude); "" to skip.
//   SEVERITY_RUBRIC  #2245 iteration 2 OPT-IN: "1" injects the contest-severity dismissal rubric + the closed
//                  ground list into the HOW-TO-JUDGE body and asks for a `REFUTE-GROUND|` line on a REFUTED
//                  verdict. Unset / any other value = OFF = the DEFAULT, and the prompt is byte-identical to
//                  the pre-#2245 one in both modes.
//   RUBRIC_REASK_GROUNDS  #2245 iteration 2: the insufficient ground the driver is re-asking about. Set by
//                  run-refute.sh ONLY on that bounded second call; empty (the default) => no re-ask block.
//   SCOPE_ASSUMPTIONS_PATH  #2257 OPT-IN: path to the staged declared-scope block (lib/scope-assumptions.py).
//                  Read ONLY inside a rubric-ON prompt; there it adds the block + the extra SUFFICIENT ground
//                  `out-of-scope-premise`. Unset / empty file = OFF = the prompt is byte-identical.
// Stdout: exactly one verdict line —
//   VERDICT|REAL|<file:fn>|<class>|<one-sentence why the refutation FAILED: the exploit holds>
//   VERDICT|REFUTED|<file:fn>|<class>|<one-sentence the specific guard / control-flow fact that kills it>
// plus, on a REFUTED verdict ONLY and IMMEDIATELY BEFORE it (#1887) —
//   CONSTRAINT|<class>|<one target-independent sentence: the generalisable requirement the claim failed>
// and, with SEVERITY_RUBRIC=1 on a REFUTED verdict ONLY, ahead of BOTH of those (#2245 iteration 2) —
//   REFUTE-GROUND|<ground-id>|<the evidence that ground requires>
// (with a scope block staged, <ground-id> may also be `out-of-scope-premise`, evidence
//  `A<n>:"<quote of that row>" premise:"<quote of the claim>"` — #2257).
// The ORDER is load-bearing: run-refute.sh's _join_wrapped_verdict() treats every non-boundary line AFTER a
// `VERDICT|` line as a PTY-wrap continuation of the verdict's reason, so a CONSTRAINT| line emitted after the
// verdict would be swallowed into that reason and would then shift verify-findings.sh's `awk -F'|'` field
// read. Before the verdict it is invisible to that scraper and is picked up by _join_wrapped_constraint().

// --- file reader (dynamic path -> safe-exec-concat, per hunter.ag / recall-match.ag precedent) ---
fn cat_file(path: string) -> string {
    if len(path) == 0 { return ""; }
    // colony-lint: safe-exec-concat
    return exec sh "sed -n '1,2000p' ${path} 2>/dev/null || true";
}

// learn() outcome must be one of the runtime enum {success,failure,partial,timeout,error}.
// A REAL verdict (the refutation FAILED -> the lead survives) = success; a REFUTED verdict (the skeptic
// broke it) = failure, so refuter fitness rewards the cases where a hostile read still could not kill the
// claim — i.e. the candidates worth a Foundry PoC. No reassignment (matches hunter.ag::outcome_of).
fn outcome_of(verdict: string) -> string {
    if index_of(verdict, "VERDICT|REAL|") >= 0 { return "success"; }
    return "failure";
}

// --- #1861 implementation appendix ------------------------------------------------------------------------
// A zone split by DIRECTORY puts an abstract base in one zone and its implementations in others, so this gate
// used to judge a base class with none of its behaviour in view and answered "…in this contract contains
// no…" — a correct statement about the file and a wrong verdict about the protocol. When an appendix is
// staged it is appended to the PAYLOAD under a labelled header (hunter.ag's `// ========== <path> ==========`
// convention) and ONE judging rule is added. Both helpers return "" for an empty appendix, so the no-appendix
// prompt is byte-for-byte the pre-#1861 prompt.
fn appendix_payload(code: string, aux: string, auxPath: string) -> string {
    if len(aux) == 0 { return code; }
    return code
      + "\n\n// ========== " + auxPath + " ==========\n"
      + "// IMPLEMENTATION APPENDIX: the contract under review above is ABSTRACT. The slice below is a\n"
      + "// DERIVED contract that implements its `virtual` members — the behaviour the abstract file does\n"
      + "// not contain. Judge the RESOLVED behaviour (base + override), not either file alone.\n"
      + aux;
}

fn appendix_rule(aux: string) -> string {
    if len(aux) == 0 { return ""; }
    return "  (d) The contract under review is ABSTRACT and some functions the claim depends on are `virtual` "
      + "and implemented in the DERIVED contract shown at the end of the payload. Judge the RESOLVED behaviour "
      + "(base + override): \"this file does not implement X\" is NOT by itself a refutation when X is "
      + "implemented below. It REMAINS a refutation if the derived override provably guards the path, or if "
      + "the claim needs behaviour absent from BOTH files.\n";
}

// --- #1887 refuter -> hunter CONSTRAINT channel --------------------------------------------------------
// A refutation currently dies with the candidate: the hostile reader states the standard the claim failed to
// meet, and that standard — the GENERALISABLE half, stripped of this protocol's nouns — is exactly what the
// hunter of the NEXT target would need to pre-empt the objection. This block asks for it as one extra line
// on the REFUTED path only. Two properties make it safe rather than merely tempting:
//   ORDER   — the line comes BEFORE the verdict, because run-refute.sh's _join_wrapped_verdict() glues every
//             following non-boundary line into the verdict's reason (see the header note).
//   SCOPE   — it must be target-INDEPENDENT. A constraint naming this protocol's contracts/functions cannot
//             transfer, and would leak one target's specifics into another target's prompt; the feeder
//             (refute-to-knowledge.sh) keys entries by CLASS only, so the sentence is all that travels.
// A REAL verdict emits nothing: the gate learned no new standard from a claim that survived it.
fn constraint_rule(cls: string) -> string {
    return "IF — and only if — your verdict is REFUTED, write ONE MORE line IMMEDIATELY BEFORE the "
      + "VERDICT| line (never after it):\n"
      + "CONSTRAINT|" + cls + "|<one sentence: the GENERALISABLE requirement this claim failed to meet>\n"
      + "That sentence must be TARGET-INDEPENDENT — the standard a hostile reader applies, reusable on any "
      + "protocol. NO contract, function, variable, token or protocol names, no addresses, no numbers taken "
      + "from this code: write the RULE, not this instance of it. Example of the right shape: \"an "
      + "externally-set integration parameter is treated as privileged configuration unless the candidate "
      + "names the unprivileged trigger and the concrete divergence it causes\".\n"
      + "On a REAL verdict write NO CONSTRAINT| line at all.\n";
}


// --- #2245 iteration 2: CONTEST-SEVERITY DISMISSAL RUBRIC (opt-in, default OFF) ------------------------------
// The measured gap (issue #2245 iteration 1, three runs on the frozen base): the class net closed the
// GENERATION gap — 3 of 3 runs reached the ground-truth mechanism — and 0 of 3 KEPT it. One of those losses
// happened HERE: this gate refuted a contest-accepted Medium on "owner-only intentional guard, no external
// attacker, another exit path bypasses it, so no funds are locked". The other two happened at the hunter's own
// SAFE, on the same criterion. So the rubric is installed at BOTH decision points, with the CLOSED ground list
// below and a structured `REFUTE-GROUND|` line the driver can gate on.
//
// WHAT IS DELIBERATELY NOT CHANGED: the conservative TIE-BREAK below. That tie-break IS the precision
// mechanism of this whole gate, and #1938 established that inverting it is defensible only for a
// fuzzer-witnessed finding, never for an unproven lead. The rubric qualifies WHICH grounds may kill a claim;
// it never lowers the bar of how sure the reader must be.
//
// Default OFF (`SEVERITY_RUBRIC=1` opts in, everything else is off), and the knob is INDEPENDENT of
// OPERATIONALIZE_LENS (issue #2245 STOP-1 decision 3). Off => the directive is "" => the assembled prompt is
// BYTE-IDENTICAL to the pre-#2245 one in BOTH modes, the discovery-lead gate and the #1938 invariant gate.
// The knob must also ride run-refute.sh's exec.env_passthrough, else getenv() reads the SANITIZED env and the
// whole feature is silently inert (the #1861/#1938 failure mode this file already documents twice).
//
// SPLICE POINT: inside judge_body(), after the decision list and BEFORE the TIE-BREAK paragraph, so it
// qualifies rule (b) ("a privileged/trusted role acting within its documented permissions") before the
// tie-break is read.

fn severity_rubric_marker() -> string {
    return "=== SEVERITY RUBRIC FOR A DISMISSAL (this governs when \"not a bug\" is a valid answer) ===";
}

// The rubric + the CLOSED ground list. BYTE-IDENTICAL to hunter.ag's severity_rubric_block() — one standard,
// two decision points, and demo-severity-rubric.sh diffs the two functions so they cannot drift apart. The
// per-agent EMISSION contract differs (the hunter writes `DISMISS|`, this side writes `REFUTE-GROUND|`) and so
// lives outside this function, in ground_rule() below. Do not edit one copy: edit both, in the same commit.
fn severity_rubric_block() -> string {
    return severity_rubric_marker() + "\n"
      + "Medium is NOT reserved for a bug an unprivileged attacker profits from. THREE ATTACKER-FREE SHAPES "
      + "ARE Medium, and dismissing one of them because nobody gains is a false negative:\n"
      + "  (a) VALID-INPUT LIVENESS LOSS — a documented user path reverts, or is otherwise unavailable, under "
      + "a state or configuration the protocol's OWN validation admits. An admin/owner action INSIDE the range "
      + "its own setter accepts is a VALID INPUT, not a \"trusted admin misconfiguration\": the question is "
      + "what the code ADMITS, never who typed it.\n"
      + "  (b) ATTACKER-FREE MISACCOUNTING — value is stranded, misattributed, or emitted to nobody under a "
      + "state the code admits. A BOUNDED loss still counts; \"only dust\" is a number you must PRODUCE, not "
      + "an adjective you may assert.\n"
      + "  (c) ALTERNATIVE-PATH RULE — the existence of another path does NOT cancel the loss on the broken "
      + "one unless that alternative is EQUIVALENT IN COST AND IN TIME. A slower, more expensive or "
      + "differently-taxed route is a loss, not a remedy.\n"
      + "CLOSED GROUND LIST. Every dismissal names exactly ONE ground id from this list, and nothing outside "
      + "it counts.\n"
      + "  INSUFFICIENT — each of these is insufficient ALONE, and ANY UNION of them is STILL insufficient "
      + "(stacking three weak grounds does not build one strong one):\n"
      + "    no-attacker        no unprivileged attacker gains anything.\n"
      + "    trusted-config     a privileged role, a deploy-time choice or an admin action reaches the state.\n"
      + "    alt-path           some other path still works.\n"
      + "    dust-unquantified  the loss is \"small\", \"dust\" or \"negligible\" with no numbers.\n"
      + "  SUFFICIENT — each one stands ONLY with the evidence named next to it, in the same line:\n"
      + "    guard                 cite the file:line of the guard that provably stops the path.\n"
      + "    unreachable           cite the constructor/setter line that VALIDATES the state away.\n"
      + "    no-loss               cite the path and its ZERO delta (nothing is lost, nobody waits).\n"
      + "    known-issue           cite the brief line that already lists it.\n"
      + "    immaterial-quantified quantify the loss from THIS payload's own numbers, numbers included.\n"
      + "A missing, empty or unrecognised ground id counts as INSUFFICIENT.\n";
}

// The EMISSION contract for this side. ORDER IS LOAD-BEARING: `REFUTE-GROUND|` then `CONSTRAINT|` then
// `VERDICT|` last — run-refute.sh's _join_wrapped_verdict() glues every non-boundary line AFTER a `VERDICT|`
// line into the verdict's reason (see the header note), which would both swallow the ground and shift
// verify-findings.sh's `awk -F'|'` field read. The token carries no `VERDICT|` substring, so
// lib/run-agent-validated.sh's refuter predicate cannot false-accept a reply that never reached a verdict.
fn ground_rule() -> string {
    return "IF — and only if — your verdict is REFUTED, write ONE MORE line naming the ground it stands on. It "
      + "goes BEFORE the CONSTRAINT| line, and therefore before the VERDICT| line; nothing may follow the "
      + "verdict:\n"
      + "REFUTE-GROUND|<ground-id>|<the evidence that ground requires>\n"
      + "The ground id is copied VERBATIM from the closed list above, exactly one per verdict. A REFUTED "
      + "verdict whose ground is missing, empty, unrecognised, or one of the INSUFFICIENT ids is a verdict that "
      + "has not been justified: the driver will hand this candidate straight back to you. On a REAL verdict "
      + "write NO REFUTE-GROUND| line at all.\n";
}

// The opt-in, same INVERTED polarity as hunter.ag's severity_rubric_enabled(): only the literal "1" opts in,
// so unset / any other value is OFF and is the DEFAULT.
fn severity_rubric_enabled() -> bool {
    return getenv("SEVERITY_RUBRIC") == "1";
}

// The directive as it enters judge_body(): "" unless the knob opts in. Concatenating "" is a no-op, so the
// default prompt is byte-identical to the pre-#2245 one and the honesty-gated sentinel below auto-suppresses,
// because an empty directive carries no marker.
fn severity_rubric_directive() -> string {
    if !severity_rubric_enabled() { return ""; }
    return severity_rubric_block() + ground_evidence_directive() + ground_rule() + rubric_reask_block();
}

// The GROUND RE-ASK addressing (empty on every first attempt), the gate-side twin of hunter.ag's
// dismiss_reask_block(). run-refute.sh re-asks ONE bounded time when a REFUTED verdict stood on an
// insufficient/unknown/missing ground, and names that ground here. RUBRIC_REASK_GROUNDS is set by the driver
// ONLY on such a re-ask, so this block is "" on every first call and that prompt is unchanged; it lives INSIDE
// the rubric directive, so the rubric-OFF prompt keeps its byte-identity contract whatever the env holds.
fn rubric_reask_block() -> string {
    let open = getenv("RUBRIC_REASK_GROUNDS");
    if open == "" { return ""; }
    return "RE-ASK — you already refuted this candidate once, on a ground the closed list above treats as "
      + "INSUFFICIENT: " + open + ". Judge it AGAIN under the rubric above. If it really is not a bug, name a "
      + "SUFFICIENT ground with the evidence that ground requires. If it matches shape (a), (b) or (c), the "
      + "honest verdict is REAL. Re-stating the same insufficient ground, or adding more of them, answers "
      + "nothing — and do NOT invent a guard that is not in the code to satisfy this re-ask.\n"
      + ground_evidence_reask_clause();
}

// --- #2245 iteration 3: THE PER-GROUND EVIDENCE CONTRACT (opt-in, default OFF) -------------------------------
// The measured gap (iteration 2): the rubric moved this gate from 0/1 to 1/2 on the held-out shape, and the ONE
// remaining loss here was a REFUTED verdict that named the SUFFICIENT ground `no-loss` and then argued
// REACHABILITY — no path, no zero delta, and it never engaged the state the candidate described. The shipped
// gate checks the ground ID; nothing checked the evidence. So iteration 3 adds the per-ground EVIDENCE contract
// below and run-refute.sh checks the emitted `REFUTE-GROUND|` line against it, folding a contract failure into
// the EXISTING insufficient path — same one bounded re-ask, same `REFUTED` verdict, same sidecar.
//
// severity_rubric_block() stays FROZEN — not one byte changes — so the iteration-2 arm stays reproducible.
//
// SPLICE POINT: inside severity_rubric_directive(), between the rubric and the emission contract, exactly as in
// hunter.ag, so it lands in BOTH judge modes.
// The one string the block is RECOGNISED by (same discipline as severity_rubric_marker above): it is the
// block's literal FIRST LINE, and the sentinel greps the ASSEMBLED instruction for it, so a marker that is
// not a substring of what renders disables the sentinel loudly rather than silently claiming a contract that
// never entered the prompt.
fn ground_evidence_marker() -> string {
    return "=== EVIDENCE CONTRACT PER GROUND (a ground id is a claim; this is what proves it) ===";
}

// The per-ground EVIDENCE contract. BYTE-IDENTICAL in hunter.ag and refuter.ag — one standard, two decision
// points, and demo-severity-rubric.sh diffs the two functions so they cannot drift apart. Do not edit one
// copy: edit both, in the same commit, or the demo fails.
//
// It names the machine-findable tokens VERBATIM (`delta=0:`, `loss=`) because the drivers decide on exactly
// those tokens: a contract the model was never shown could not be met, and a driver requirement that is not
// in this text is a requirement nobody was given. The demo pins both directions.
//
// PURE-META like every other directive here: no protocol, contract, function, token, unit or product name, so
// injecting it on a held-out target cannot leak an answer.
fn ground_evidence_block() -> string {
    return ground_evidence_marker() + "\n"
      + "A ground id is a CLAIM; the evidence on the SAME line is what makes it true. Each sufficient ground "
      + "has exactly ONE contract, below. A line that names a sufficient ground without meeting that ground's "
      + "contract is read as INSUFFICIENT — the same answer as naming no ground at all.\n"
      + "  guard                 cite path:line (or path:first-last) of the check that stops the path, in code "
      + "you were given. The cited text must BE the check: a conditional, a require/revert/assert, an access "
      + "modifier.\n"
      + "  unreachable           cite the path:line that VALIDATES the state away — a rejecting check in a "
      + "constructor, an initializer or a setter. A deployment script, a migration, or the value some "
      + "deployment happens to hold, is NOT a validation: it shows what was CHOSEN, never what is REFUSED.\n"
      + "  no-loss               cite the path AND write the literal token delta=0:<the quantity that is "
      + "unchanged>. \"That state never occurs\" is NOT this ground — that claim is unreachable, and it needs "
      + "unreachable's citation. A reachability argument filed as no-loss is an insufficient dismissal.\n"
      + "  known-issue           quote the brief's own line VERBATIM, inside quotes, at least a dozen "
      + "characters of it.\n"
      + "  immaterial-quantified write the literal token loss=<amount> <unit>, and compare it in the SAME "
      + "units with a second number taken from this payload (\"... of ...\", \"... out of ...\", \"... vs "
      + "...\"). A ratio of internal counters is not a loss amount.\n"
      + "ADMITTED IS NOT DEPLOYED. A read of a live deployment, a deploy-time value, or \"as shipped today\", "
      + "establishes the DEPLOYED state only — and every ground above asks what the code ADMITS. So a "
      + "dismissal resting on deployed state closes NOTHING unless the SAME line also cites the validating "
      + "line that rejects every OTHER admitted state. \"As deployed\" is not \"admitted\".\n";
}

// The opt-in, same INVERTED polarity as severity_rubric_enabled(): only the literal "1" opts in, so unset /
// any other value is OFF and is the DEFAULT. This knob is INDEPENDENT of SEVERITY_RUBRIC and NOT a value mode
// of it (issue #2245 iteration-3 STOP-1 decision 1): a `SEVERITY_RUBRIC=2` sub-mode would have to loosen
// severity_rubric_enabled()'s `== "1"` test, which would silently disable the WHOLE rubric for an operator who
// set `2` against an older checkout — and it would make the iteration-2 arm unreproducible byte-for-byte.
// Two knobs, one delta per arm. It must also ride the driver's exec.env_passthrough, else getenv() reads the
// SANITISED env and the contract is silently inert (the #1426/#2157 failure mode).
fn ground_evidence_enabled() -> bool {
    return getenv("GROUND_EVIDENCE") == "1";
}

// The contract as it enters the rubric directive: "" unless the knob opts in. It is concatenated INSIDE
// severity_rubric_directive(), so it can only ever reach a rubric-ON cell — the contracts are defined against
// the rubric's own ground list, and GROUND_EVIDENCE=1 with the rubric off is inert by construction (no block,
// no marker, no sentinel, no shell layer).
fn ground_evidence_directive() -> string {
    if !ground_evidence_enabled() { return ""; }
    return ground_evidence_block();
}

// The second RE-ASK sentence, gated on the SAME knob so the iteration-2 re-ask text is byte-identical with the
// contract off. The driver names the failing ground as `<ground>: <what is missing>`, so this sentence only has
// to say that such a line is insufficient too.
fn ground_evidence_reask_clause() -> string {
    if !ground_evidence_enabled() { return ""; }
    return "A line whose ground id is sufficient but whose EVIDENCE does not meet that ground's contract above "
      + "is insufficient in exactly the same way; where the list names a ground it also names what is missing "
      + "from it, and repeating the line without that evidence answers nothing.\n";
}

// --- #2257: DECLARED SCOPE ASSUMPTIONS (opt-in, default OFF) ------------------------------------------------
// The measured gap: verified findings whose exploit only works with an asset or an environment the target's
// own docs EXCLUDE (a transfer-fee or rebasing asset where the docs say standard assets only). This gate never
// saw those declarations, so it could not reject such a premise. run-refute.sh --scope-assumptions stages a
// deterministic, line-cited block (lib/scope-assumptions.py) and this directive shows it, with ONE extra
// SUFFICIENT ground, `out-of-scope-premise`, whose evidence has its own citation contract: an assumption id plus
// a verbatim quote of that row, and a verbatim quote of the premise taken from the candidate's own claim. The
// driver checks that contract through the same helper that wrote the block.
//
// WHAT IS DELIBERATELY NOT CHANGED: severity_rubric_block() (frozen and byte-paired with hunter.ag), the closed
// ground list inside it, ground_evidence_block(), rubric_reask_block() and both TIE-BREAKs. The extra ground is
// described HERE, as an addition to the list, never an edit of it.
//
// TRUST ROWS ARE CONTEXT ONLY (issue #2257 STOP-1 decision 1): a declared trusted role is shown but can never
// be cited, so it cannot launder the `trusted-config` ground #2245 made insufficient.
//
// NESTED UNDER THE RUBRIC (STOP-1 decision 2): "" unless severity_rubric_enabled() AND the staged block is
// non-empty. SCOPE_ASSUMPTIONS_PATH must ride run-refute.sh's exec.env_passthrough (getenv() reads the SANITISED
// env), and with it unset the prompt is byte-identical to the rubric-only one.
//
// SPLICE POINT: the discovery-lead branch of judge_body() only, right after the rubric directive and before its
// TIE-BREAK (STOP-1 decision 4: the invariant mode is out of reach in v1).
//
// PURE-META like every directive here: no protocol, product, standard number or file name in the text.

// The one string the block is RECOGNISED by: its literal FIRST LINE. The sentinel greps the ASSEMBLED
// instruction for it, so it can only fire when the directive really entered the prompt.
fn scope_assumptions_marker() -> string {
    return "=== DECLARED SCOPE ASSUMPTIONS (the target's own docs; one extra ground, with its own citation) ===";
}

fn scope_assumptions_directive() -> string {
    if !severity_rubric_enabled() { return ""; }
    let block = cat_file(getenv("SCOPE_ASSUMPTIONS_PATH"));
    if len(block) == 0 { return ""; }
    return scope_assumptions_marker() + "\n"
      + "The target's OWN documentation declares the assumptions below, copied mechanically and cited by line. "
      + "Each row reads A<n>|<category>|<source>:<line>|<text>; the categories are token, chain, trust, "
      + "exclusion and known-issue.\n"
      + block + "\n"
      + "ONE EXTRA SUFFICIENT GROUND, in addition to the closed list above:\n"
      + "  out-of-scope-premise  the claimed exploit DEPENDS on a behaviour, an environment or an input that one "
      + "of these assumptions explicitly EXCLUDES — the claim does not work unless the excluded thing is present.\n"
      + "Its evidence has its own contract, on the REFUTE-GROUND| line:\n"
      + "REFUTE-GROUND|out-of-scope-premise|A<n>:\"<at least a dozen characters copied verbatim from row A<n>>\" "
      + "premise:\"<at least eight characters copied verbatim from the claimed exploit path above>\"\n"
      + "This ground is NOT valid when the exploit also works under the assumption, when the claim merely "
      + "mentions a component or a kind of asset the assumption names without depending on the excluded "
      + "behaviour, or when the cited row is a trust row. TRUST ROWS ARE CONTEXT ONLY: they are never a ground, "
      + "the rubric above still governs privileged roles, and an admin action inside the range its own setter "
      + "accepts is still a VALID INPUT.\n"
      + "A claim these assumptions do not exclude is traced exactly as before. A line whose id does not exist, "
      + "whose quote is not in that row, or whose premise is not in the claimed exploit is insufficient, and the "
      + "driver will hand the candidate back to you.\n";
}

// --- #1938 invariant-hunt judgment mode -----------------------------------------------------------------
// STAGE 4.5 (--deep-hunt) surfaces a BROKEN STATEFUL invariant carrying a fuzzer-reproduced shrunk witness —
// a different object from a discovery LEAD (an unproven exploit claim). When CAND_INVARIANT is set
// (run-refute.sh --invariant-mode) this gate judges the WITNESSED invariant on two axes rather than the stock
// (a)/(b)/(c) exploit trace. Both helpers below return the pre-#1938 text VERBATIM when the invariant string is
// empty, so an unset CAND_INVARIANT reproduces the discovery-lead prompt BYTE-for-BYTE (mirrors the #1861
// AUX_CODE_PATH opt-in). The output contract (VERDICT|/CONSTRAINT| lines + ordering) is unchanged in both modes.

// finding_header — the reviewed-object framing. Empty inv => the stock "candidate finding" header.
fn finding_header(inv: string, loc: string, cls: string, sev: string, exploit: string) -> string {
    if len(inv) == 0 {
        return "=== THE CANDIDATE FINDING UNDER REVIEW ===\n"
          + "Location: " + loc + "\n"
          + "Bug class: " + cls + "\n"
          + "Claimed severity: " + sev + "\n"
          + "Claimed external exploit path: " + exploit + "\n\n";
    }
    return "=== THE BROKEN INVARIANT UNDER REVIEW ===\n"
      + "Location: " + loc + "\n"
      + "Bug class: " + cls + "\n"
      + "Claimed severity: " + sev + "\n"
      + "Broken invariant + shrunk witness: " + inv + "\n\n";
}

// judge_body — the HOW-TO-JUDGE body (from the first decision sentence through the tie-break paragraph, with
// its trailing blank line). Empty inv => the pre-#1938 (a)/(b)/(c) exploit-trace block, byte-for-byte.
fn judge_body(inv: string, aux: string) -> string {
    if len(inv) == 0 {
        return "Walk the relevant function(s) and decide which holds:\n"
          + "  (a) A guard, require/revert, checks-effects-interactions order, access-control modifier, rounding "
          + "direction, or other control-flow fact in the ACTUAL code provably stops the claimed exploit. -> REFUTED.\n"
          + "  (b) The exploit relies on a privileged/trusted role acting within its documented permissions, or it "
          + "restates a listed KNOWN ISSUE, or it is below Medium severity. -> REFUTED (out of scope).\n"
          + "  (c) You traced the code and the claimed exploit genuinely holds for an UNPRIVILEGED external attacker, "
          + "with no guard stopping it. -> REAL.\n"
          + appendix_rule(aux)
          // #2245 iteration 2: the severity rubric, read AFTER the decision list it qualifies (rule (b)'s
          // trusted-role exclusion) and BEFORE the tie-break, which it deliberately leaves alone. "" when the
          // knob is off => this branch is byte-identical to the pre-#2245 one.
          + severity_rubric_directive()
          // #2257: the declared scope assumptions + the out-of-scope-premise ground. "" unless the rubric is on
          // AND a non-empty block is staged, so the rubric-only and the default prompts are both unchanged.
          + scope_assumptions_directive()
          + "TIE-BREAK: if after an honest trace you are NOT confident the exploit holds — the relevant code is not "
          + "shown, the path is ambiguous, or you cannot point to the exact step that breaks an invariant — answer "
          + "REFUTED. Surviving this gate must require the claim to be unambiguously real; uncertainty kills it.\n\n";
    }
    // Invariant-hunt mode: a fuzzer ALREADY broke this invariant with the shrunk witness above. Judge two axes;
    // REAL only if BOTH hold. The tie-break is INVERTED relative to the discovery-lead gate (see below).
    return "This finding is a STATEFUL invariant a property-fuzzer ALREADY BROKE with the shrunk witness above — "
      + "not an unproven lead. Judge it on TWO axes, and answer REAL only if BOTH hold:\n"
      + "  (a) INVARIANT VALIDITY — is the asserted invariant a REAL protocol guarantee? -> REFUTED if it is "
      + "mis-specified: e.g. a CUMULATIVE cap asserted against a PER-OPERATION budget (or vice-versa), a "
      + "documented BY-DESIGN behaviour, or a USER-ERROR precondition the protocol never promised to prevent. A "
      + "predicate the protocol never guaranteed is not a bug no matter how the witness breaks it.\n"
      + "  (b) WITNESS REACHABILITY — can an UNPRIVILEGED external attacker actually drive the shrunk-witness call "
      + "sequence? -> REFUTED if any step needs a TRUSTED role (an RBAC/access-control-gated entrypoint) or a "
      + "malicious TRUSTED component (e.g. a hook/adapter/callback that is itself pool or protocol configuration — "
      + "a malicious hook is a malicious pool, out of scope).\n"
      + "  REAL requires BOTH: the invariant is a genuine guarantee AND the witness is reachable by an "
      + "unprivileged attacker.\n"
      + appendix_rule(aux)
      // #2245 iteration 2: the same rubric in the invariant mode, for the same reason — axis (b) here carries
      // the same trusted-role exclusion. "" when the knob is off => byte-identical to the pre-#2245 prompt.
      + severity_rubric_directive()
      + "TIE-BREAK (INVERTED for a witnessed finding): the fuzzer already reproduced this exact exploit sequence, "
      + "so — UNLIKE an unproven discovery lead — DEFAULT TO REAL on genuine uncertainty. REFUTE only when you can "
      + "NAME the specific mis-specification (axis a) or the specific privileged/trusted step the witness needs "
      + "(axis b). Do NOT kill a fuzzer-witnessed finding merely because the code is not fully shown or the path "
      + "is ambiguous — that would discard the rare bug this deep-hunt gate exists to keep.\n\n";
}

// harness_payload — append the generated invariant *.t.sol (the ACTUAL asserted predicate) to the code payload
// under a labelled header when INV_HARNESS_PATH is staged. Empty harness => the payload is byte-identical.
fn harness_payload(payload: string, harness: string, harnessPath: string) -> string {
    if len(harness) == 0 { return payload; }
    return payload
      + "\n\n// ========== " + harnessPath + " ==========\n"
      + "// INVARIANT HARNESS: the generated Foundry invariant test whose predicate the fuzzer BROKE. This is the\n"
      + "// ACTUAL asserted invariant (the property under an `invariant_*`/`assert`) plus its setup — judge axis\n"
      + "// (a) INVARIANT VALIDITY against what this predicate really claims, not against a paraphrase of it.\n"
      + harness;
}

let candFn = getenv("CAND_FILE_FN");
let candClass = getenv("CAND_CLASS");
let candSev = getenv("CAND_SEVERITY");
let candExploit = getenv("CAND_EXPLOIT");
let auxPath = getenv("AUX_CODE_PATH");
let code = cat_file(getenv("CODE_PATH"));
let aux = cat_file(auxPath);
let brief = cat_file(getenv("BRIEF_PATH"));
// #1938: the invariant-hunt toggle + optional harness. Both empty (unset) => the discovery-lead prompt is
// reproduced byte-for-byte. candInvariant carries the broken-invariant + shrunk-witness sentence (== the
// manifest exploit column under --invariant-mode); harness is the generated predicate *.t.sol when staged.
let candInvariant = getenv("CAND_INVARIANT");
let harnessPath = getenv("INV_HARNESS_PATH");
let harness = cat_file(harnessPath);

// The instruction carries the skeptic role + the conservative tie-break (default REFUTED) + the strict
// output contract; the code under review is the prompt payload (matches auditor.ag::classify_evm_llm and
// hunter.ag shape: instruction = lens + contract, payload = the code).
let instruction =
    "You are an INDEPENDENT, skeptical smart-contract auditor. Another auditor has filed the finding below. "
  + "You have NO stake in it being real — your job is to REFUTE it: prove, against the ACTUAL control and data "
  + "flow in the code, that the claimed exploit does NOT work. Trace the real code yourself; do not take the "
  + "claim on faith and do not invent guards that are not in the code.\n\n"
  + finding_header(candInvariant, candFn, candClass, candSev, candExploit)
  + "=== PROTOCOL BRIEF — invariants + KNOWN ISSUES (a finding that restates a listed known issue is NOT real) ===\n"
  + brief + "\n\n"
  + "=== HOW TO JUDGE ===\n"
  + judge_body(candInvariant, aux)
  + "=== HOW TO ANSWER ===\n"
  + "FIRST reason step by step through the actual control flow. THEN write EXACTLY ONE final line:\n"
  + "VERDICT|REAL|" + candFn + "|" + candClass + "|<one sentence: why your refutation FAILED — the precise "
  + "control-flow fact that lets the unprivileged exploit hold>\n"
  + "or\n"
  + "VERDICT|REFUTED|" + candFn + "|" + candClass + "|<one sentence: the specific guard / control-flow fact / "
  + "scope rule that kills the claim>\n"
  + constraint_rule(candClass)
  + "Reason for as long as you need first; ONLY the final VERDICT| line is parsed, so your analysis above it "
  + "is free. If you are unsure, the line MUST be VERDICT|REFUTED|...";

// #1861: make the attachment OBSERVABLE in the cell log before the (expensive) call, so an operator reading
// a verdict can tell which of the two payload shapes produced it. run-refute.sh's verdict scraper closes a
// wrapped record on this sentinel, exactly as the hunter's scraper closes on BLACKBOARD-/DEPTH-CELL|.
if len(aux) > 0 { print("AUX-CONTEXT|" + auxPath); }
// #1938: same observability marker for the staged invariant harness (printed BEFORE the verdict, so it never
// perturbs run-refute.sh's verdict/constraint scrapers, which only read from the VERDICT|/CONSTRAINT| line on).
if len(harness) > 0 { print("INV-HARNESS|" + harnessPath); }
// #2245 iteration 2: the SEVERITY-RUBRIC sentinel, on the same honesty contract as hunter.ag's — gated on the
// rubric's own marker being demonstrably IN the prompt about to be sent, never on getenv() having returned
// something, so no log can claim a rubric that was not injected. It is also what makes run-refute.sh's ground
// gate INERT by construction when the knob is off: that gate reads this line and does nothing without it.
// Printed BEFORE the prompt() call (like AUX-CONTEXT| above) and carrying no `VERDICT|` substring, so neither
// _join_wrapped_verdict() nor lib/run-agent-validated.sh's refuter predicate can be confused by it.
if index_of(instruction, severity_rubric_marker()) >= 0 { print("SEVERITY-RUBRIC|refute|on"); }
// #2245 iteration 3: the GROUND-EVIDENCE sentinel, on the SAME honesty contract — it is what makes
// run-refute.sh's per-ground evidence contract INERT by construction when the second knob is off (a rubric-ON
// cell then prints the line above and not this one, which is exactly the iteration-2 arm). Carries no
// `VERDICT|` substring and closes a wrapped record in all three scrapers, like every sibling diagnostic.
if index_of(instruction, ground_evidence_marker()) >= 0 { print("GROUND-EVIDENCE|refute|on"); }
// #2257: the SCOPE-ASSUMPTIONS sentinel, on the same honesty contract — gated on the block's own marker being IN
// the prompt, never on the env. It is what arms run-refute.sh's out-of-scope-premise contract check, so with the
// rubric off or no block staged that layer decides nothing. Carries no `VERDICT|` substring and closes a wrapped
// record in all three refute scrapers, like its siblings.
if index_of(instruction, scope_assumptions_marker()) >= 0 { print("SCOPE-ASSUMPTIONS|refute|on"); }

let verdict = prompt(instruction, harness_payload(appendix_payload(code, aux, auxPath), harness, harnessPath)) -> string;

// Surface the verdict (stdout, parsed by run-refute.sh) and record the attempt so refuter fitness reweights.
print(verdict);
let outcome = outcome_of(verdict);
emit("dark-factory:refute_verdict", "{\"candidate\":\"" + candFn + "\",\"class\":\"" + candClass + "\",\"outcome\":\"" + outcome + "\"}");
learn("refute", candClass + ":" + candFn, "adversarial refutation of " + candFn + " (" + candClass + ")", outcome, [candClass, outcome]);
memo_write("refuter:last_check", "done");
