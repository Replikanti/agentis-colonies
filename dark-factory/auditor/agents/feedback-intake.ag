cb 300000;
// #1526 — FEEDBACK INTAKE, in the SUBSTRATE. The human->federation half of the loop (epic #1505). deliver-
// submission.sh (#1526) stages a report-writer (#1508) draft into an operator DROP-DIRECTORY; a human files it
// on the platform out-of-band, then writes the platform's response into that dir's OUTCOME.md. This agent reads
// the filled-in outcome and folds it back into learning, ATTRIBUTED to the gate that should own the lesson — so
// the next hunt's scope-gate / impact-gate / dup-scout / report-writer is calibrated by real platform outcomes.
//
// It NEVER submits and only ever reads the drop-dir (no platform egress, no curl/wget/submit). The success/
// failure/partial SIGNAL is DETERMINISTIC from the operator verdict enum (accepted->success, closed->failure,
// duplicate->failure, needs-info->partial) — a mis-reasoning backend can never flip a payout into a failure
// signal. The LLM's ONLY job is to ATTRIBUTE the outcome to the responsible stage (which gate should have caught
// a rejection / is confirmed by an acceptance); the learn() signal itself is pinned to the enum.
//
// The verdict read is DETERMINISTIC (grep/python3 — the muscle, capture-then-fallback per the dup-scout/impact-
// gate `grep`-exits-1 lesson); the stage attribution is the LLM's, over the manifest verdicts + the full outcome.
//
// Env:
//   SUBMISSION_DIR   the $DROP_DIR/<slug>/ dir deliver-submission.sh staged (manifest.json + OUTCOME.md).
// Stdout: exactly one line
//   FEEDBACK|<SUCCESS|FAILURE|PARTIAL>|<scope-gate|impact-gate|dup-scout|report-writer>|<rationale>
// Then ONE learn() attributed to the responsible gate's OWN topic, with the DETERMINISTIC signal.

// --- drop-dir evidence (the muscle; dynamic paths -> safe-exec-concat, per scope-gate.ag / report-writer.ag) --
fn manifest_text(dir: string) -> string {
    if len(dir) == 0 { return ""; }
    // colony-lint: safe-exec-concat
    return exec sh "sed -n '1,4000p' ${dir}/manifest.json 2>/dev/null || true";
}

fn outcome_text(dir: string) -> string {
    if len(dir) == 0 { return ""; }
    // colony-lint: safe-exec-concat
    return exec sh "sed -n '1,4000p' ${dir}/OUTCOME.md 2>/dev/null || true";
}

// The DETERMINISTIC verdict token from OUTCOME.md (accepted|closed|duplicate|needs-info). grep prints nothing
// AND exits 1 on no match, so capture-then-fallback (the dup-scout/impact-gate lesson).
fn outcome_verdict(dir: string) -> string {
    if len(dir) == 0 { return "unknown"; }
    // colony-lint: safe-exec-concat
    return exec sh "v=$(grep -iE '^verdict:' ${dir}/OUTCOME.md 2>/dev/null | head -1 | awk '{print $2}'); [ -n \"$v\" ] && echo \"$v\" || echo unknown";
}

// Read a single field from the authoritative manifest.json (NOT from the editable OUTCOME.md or the dirname).
fn manifest_field(dir: string, key: string) -> string {
    if len(dir) == 0 { return ""; }
    // colony-lint: safe-exec-concat
    return exec sh "python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2],\"\"))' ${dir}/manifest.json '${key}' 2>/dev/null || true";
}

// The one-line reason the operator recorded (freeform), used in the learn() description. Capture-then-fallback.
fn outcome_reason(dir: string) -> string {
    if len(dir) == 0 { return ""; }
    // colony-lint: safe-exec-concat
    return exec sh "r=$(grep -iE '^reason:' ${dir}/OUTCOME.md 2>/dev/null | head -1 | sed 's/^[Rr]eason:[[:space:]]*//'); [ -n \"$r\" ] && echo \"$r\" || echo ''";
}

let dir = getenv("SUBMISSION_DIR");
let manifest = manifest_text(dir);
let outcome = outcome_text(dir);
let verdict = outcome_verdict(dir);
let submissionId = manifest_field(dir, "submission_id");
let impactClass = manifest_field(dir, "impact_class");
let reason = outcome_reason(dir);

// DETERMINISTIC signal from the verdict enum — authoritative for learn(). The LLM never touches this.
let signal = if index_of(verdict, "accepted") >= 0 { "success" }
             else { if index_of(verdict, "closed") >= 0 { "failure" }
             else { if index_of(verdict, "duplicate") >= 0 { "failure" }
             else { if index_of(verdict, "needs-info") >= 0 { "partial" }
             else { "partial" } } } };

let evidence =
    "SUBMISSION_ID: " + submissionId + "\n"
  + "IMPACT_CLASS: " + impactClass + "\n"
  + "OPERATOR_VERDICT (deterministic): " + verdict + "  -> signal " + signal + "\n"
  + "=== MANIFEST (canonical id + the three raw gate verdicts, verbatim) ===\n" + manifest + "\n"
  + "=== OUTCOME (the operator-filled platform response) ===\n" + outcome;

// The attributor: pick WHICH gate owns this outcome. The signal is already decided; the LLM only names the stage.
let instruction =
    "You are the FEEDBACK INTAKE for a bug-bounty pipeline. A confirmed finding passed the scope gate, the "
  + "impact-substantiation gate and the dup-risk check, a human filed it on the platform, and the platform has "
  + "now RESPONDED (the OUTCOME below). Your job is to ATTRIBUTE the outcome to the ONE pipeline stage that owns "
  + "the lesson, so its learning is calibrated by the real result. You do NOT decide success/failure — that is "
  + "already fixed deterministically from the verdict enum. You ONLY choose the stage.\n\n"
  + "Map the outcome to a stage using the manifest verdicts + the reviewer's reason:\n"
  + "- accepted (a payout)                                  -> impact-gate (validity confirmed).\n"
  + "- closed, front-run of a PRIVILEGED action / a SIMULATED price increase / no on-chain-provable claim "
  + "-> impact-gate (reinforce its PRIVILEGED-TRIGGER / SIMULATED-STATE / NO-PROVABLE-CLAIM discriminator). This "
  + "is the real Enzyme Onyx rejection: a front-run of a privileged NAV post / simulated price increase is an "
  + "impact-gate lesson, NOT a scope lesson.\n"
  + "- closed, OUT-OF-SCOPE asset / an excluded carve-out   -> scope-gate.\n"
  + "- duplicate (already reported)                         -> dup-scout.\n"
  + "- needs-info (report unclear / missing repro)          -> report-writer.\n\n"
  + "=== EVIDENCE ===\n" + evidence + "\n"
  + "=== HOW TO ANSWER ===\nReason briefly, then write exactly ONE final line:\n"
  + "FEEDBACK|<SUCCESS|FAILURE|PARTIAL>|<scope-gate|impact-gate|dup-scout|report-writer>|<one-line rationale "
  + "naming the stage that owns this outcome and why>\n"
  + "Use the deterministic signal (accepted->SUCCESS, closed/duplicate->FAILURE, needs-info->PARTIAL) in the "
  + "first field; the stage in the second field is your judgement. Only the final FEEDBACK| line is parsed.";

let feedback = prompt(instruction, evidence) -> string;

print(feedback);
// Parse the ATTRIBUTED stage from the printed line (the LLM's only decision). Default report-writer if unclear.
let stage = if index_of(feedback, "|impact-gate|") >= 0 { "impact-gate" }
            else { if index_of(feedback, "|scope-gate|") >= 0 { "scope-gate" }
            else { if index_of(feedback, "|dup-scout|") >= 0 { "dup-scout" }
            else { "report-writer" } } };
// Map the stage to the gate's OWN learn() topic so the ground-truth signal lands on the exact dimension the gate
// learns under — critically dup-scout learns under "dup-risk", NOT "dup-scout".
let topic = if stage == "dup-scout" { "dup-risk" }
            else { if stage == "scope-gate" { "scope-gate" }
            else { if stage == "impact-gate" { "impact-gate" }
            else { "report-writer" } } };
// ONE learn() per intake (mirrors the gates). The DETERMINISTIC signal is authoritative; the LLM only chose the
// stage. Attributes carry the correlation id + impact class + stage + verdict for later slicing.
learn(topic, submissionId, "platform outcome " + verdict + " for " + submissionId + " (" + impactClass + "): " + reason, signal, [submissionId, impactClass, stage, verdict]);
emit("dark-factory:feedback_outcome", "{\"submission_id\":\"" + submissionId + "\",\"verdict\":\"" + verdict + "\",\"signal\":\"" + signal + "\",\"stage\":\"" + stage + "\"}");
memo_write("feedback-intake:last_check", "done");
