cb 300000;
// #1612 (epic #1611) — ZONE-MAPPER. Given ONE candidate zone (a directory of in-scope contracts) plus
// the taxonomy, classify its subsystem identity: a human name, the bug classes an external attacker would
// probe here (a subset of the taxonomy's C1..C15), and a one-line description. This is the ONE SEMANTIC
// step of map-zones.sh's auto-manifest: the shell does the mechanical plumbing (locate/group/LOC/hardening/
// slice/format), the substrate decides subsystem x bug-class — mirroring how run-discovery.sh delegates the
// per-cell hunt to hunter.ag. map-zones.sh runs this once per zone and scrapes the single `ZONE|` line.
//
// Env:
//   TARGET_DIR  repo root of the cloned target
//   ZONE_ID     stable id for this zone (slug of its directory; echoed back verbatim in the ZONE| line)
//   ZONE_FILES  newline-separated in-scope contract paths (relative to TARGET_DIR) for this zone. A path
//               may be function-sliced as `file@fn1+fn2` (slice-fns.sh format) for a big contract.
//   TAXONOMY    path to bug-taxonomy.md (the class menu C1..C15 the classification chooses from)
// Stdout: exactly one `ZONE|<id>|<name>|<class1,class2,...>|<one-line description>` line.

// --- file readers (dynamic paths -> safe-exec-concat per hunter.ag precedent) ---
fn cat_file(path: string) -> string {
    let at = index_of(path, "@");
    if at < 0 {
        // colony-lint: safe-exec-concat
        return exec sh "sed -n '1,2000p' ${path} 2>/dev/null || true";
    }
    // Function-level slice: a scope entry `path@fn1+fn2` feeds ONLY those functions (+ the contract header)
    // so a big contract fits the classification prompt's budget (matches hunter.ag::cat_file).
    let file = substring(path, 0, at);
    let funcs = substring(path, at + 1, len(path));
    let slicer = getenv("SLICER");
    // colony-lint: safe-exec-concat
    return exec sh "sh ${slicer} ${file} '${funcs}' 2>/dev/null || true";
}

// Concatenate every in-scope contract in the zone into one labelled blob (matches hunter.ag::scoped_code).
fn scoped_code(dir: string, files: string) -> string {
    return reduce(regex_split("\n", files), |acc: string, rel: string| -> string {
        if len(rel) == 0 { return acc; }
        return acc + "\n\n// ========== " + rel + " ==========\n" + cat_file(dir + "/" + rel);
    }, "");
}

// The whole taxonomy (the class menu C1..C15) so the classification chooses from the real class ids.
fn read_taxonomy(path: string) -> string {
    if len(path) == 0 { return ""; }
    // colony-lint: safe-exec-concat
    return exec sh "sed -n '1,4000p' ${path} 2>/dev/null || true";
}

// learn() outcome enum {success,failure,partial,timeout,error}: a zone that classified to at least one
// bug class = success; a bare/empty ZONE line = failure (mirrors hunter.ag::outcome_of's split).
fn outcome_of(verdict: string) -> string {
    if index_of(verdict, "ZONE|") >= 0 { return "success"; }
    return "failure";
}

// --- #1681 deterministic C10/C11 lending/CDP/stability-pool backstop -------------------------------
// zone-mapper's LLM classification under-recognizes lending/CDP/stability-pool code (direct forks AND
// ERC4626-style Strategy/Vault wrappers around them) — see #1681 (yearn-ybold's Strategy.sol zone, which
// wraps a Liquity-fork stability pool, classified to [C15,C2,C12] with C10/C11 never assigned). The prompt
// instruction below is best-effort; this block is the deterministic guarantee applied AFTER prompt().

// Does the zone's own concatenated code (the `code` local built by scoped_code() — NOT the file names)
// reference a lending/CDP/stability-pool interface, directly or via an ERC4626 wrapper's import/type line?
// Sequential checks (no `&&`/`||`, this file's existing style). Identifier set from the issue report, with
// ONE deviation confirmed live pre-merge (#1681 plan's own flagged risk): the bare generic `IPool` token
// was DROPPED in favor of `IPoolAddressesProvider` (Aave's own address-registry interface, always imported
// alongside a real Aave V3 integration, so it keeps the Aave signal without the collision) after a live
// map-zones.sh --backend claude run against the symm corpus-bench target showed `IPool` false-firing on
// `contracts_vesting_interfaces` — a Balancer v3 pool/router integration the LLM itself correctly classified
// as C15-only, that the bare-`IPool` backstop then force-appended C10/C11 onto anyway (confirmed via the
// second, backstop-appended `ZONE|` line in that run's zone log). yearn-ybold's positive match is unaffected
// (its zones fire on `ITroveManager`/`IStabilityPool`/`ICollateralRegistry`, never on `IPool`).
fn contains_lending_signal(code: string) -> bool {
    if index_of(code, "ITroveManager") >= 0 { return true; }
    if index_of(code, "IStabilityPool") >= 0 { return true; }
    if index_of(code, "ICollateralRegistry") >= 0 { return true; }
    if index_of(code, "IAaveLendingPool") >= 0 { return true; }
    if index_of(code, "IPoolAddressesProvider") >= 0 { return true; }
    if index_of(code, "IComptroller") >= 0 { return true; }
    if index_of(code, "ICToken") >= 0 { return true; }
    return false;
}

// --- #1698 deterministic C6 (value-moving accounting) backstop -------------------------------------
// zone-mapper's LLM classification under-recognizes zones that OWN value-moving accounting logic (mint/
// redeem/deposit/withdraw/swap entrypoints that adjust an amount before it moves) — see #1698 (dodo's
// Gateway zone, which does `amount -= platformFeesForTx;` inside GatewayCrossChain.sol/GatewayTransferNative.sol,
// classified to [C15,C3,C12,C9] with C6 never assigned). A single-substring backstop (bare "withdraw"/"swap")
// was rejected live-checking dodo's own zones: `function withdraw`/`function swap...` already appear in
// `contracts/interfaces/IWETH9.sol` and `IUniswapV2Router01.sol` (pure interface declarations, no bodies)
// and in `contracts/mocks/*.sol` (trivial pass-throughs) — neither owns real accounting logic. The compound
// AND below (a function DECLARATION keyword + a companion amount-deduction idiom) fires only on zones that
// actually own the arithmetic: dodo's Gateway zone matches both; `contracts_interfaces` has the declaration
// keyword but interfaces have no function bodies (hence no `-=`/`.sub(` anywhere — a Solidity-language
// guarantee, not a heuristic); `contracts_libraries` has `.sub(` in UniswapV2Library.sol but no value-moving
// function *declarations*; `contracts_mocks` has `function mint`/`function withdraw` but no `-=`/`.sub(`
// (trivial pass-throughs) — all three correctly stay unmatched.

// Does the zone's code DECLARE a value-moving entrypoint (mint/burn/deposit/withdraw/redeem/swap)? A
// function-declaration substring, never a bare mention/call-site (this is what distinguishes an interface
// or a call-site from the subsystem that actually owns the logic).
fn has_value_moving_function(code: string) -> bool {
    if index_of(code, "function withdraw") >= 0 { return true; }
    if index_of(code, "function deposit") >= 0 { return true; }
    if index_of(code, "function mint(") >= 0 { return true; }
    if index_of(code, "function burn(") >= 0 { return true; }
    if index_of(code, "function redeem") >= 0 { return true; }
    if index_of(code, "function swap") >= 0 { return true; }
    return false;
}

// Does the zone's code contain an amount-deduction idiom (`amount -= platformFeesForTx;` style, or
// SafeMath-style `.sub(` for targets on pre-0.8 Solidity)?
fn has_amount_deduction(code: string) -> bool {
    if index_of(code, "-=") >= 0 { return true; }
    if index_of(code, ".sub(") >= 0 { return true; }
    return false;
}

// True only when the zone BOTH declares a value-moving entrypoint AND does amount-deduction arithmetic
// (nested `if`, not `&&` — this file has no boolean-AND operator).
fn contains_accounting_signal(code: string) -> bool {
    if has_value_moving_function(code) {
        if has_amount_deduction(code) { return true; }
    }
    return false;
}

// --- #1698 deterministic C17 (index/slot-overwrite) backstop ---------------------------------------
// zone-mapper's LLM classification under-recognizes zones whose recovery/refund handlers write an id-keyed
// mapping/array slot — see #1698 (dodo's Gateway zone, whose `onRevert`/`onAbort` handlers write
// `refundInfos[externalId] = refundInfo;`, M-7's exact shape). Live-verified: dodo's Gateway zone defines
// `function onRevert`/`function onAbort` (both GatewayCrossChain.sol and GatewayTransferNative.sol) and
// writes the indexed slot inside them — both conditions hold. Crucially, dodo's test-suite zone (e.g.
// `test/GatewaySend.t.sol`) *calls* `gatewaySendA.onRevert(...)` and separately contains unrelated `] =`
// array writes, but never *defines* `function onRevert` (confirmed via `grep -rn "function onRevert"
// contracts/ test/` returning zero test-dir hits) — requiring the declaration form (not a bare mention)
// keeps the test zone from over-firing on this signal. `contracts_interfaces`/`contracts_libraries`/
// `contracts_mocks` have neither signal at all.

// Does the zone's code DECLARE a revert/refund/cancel recovery handler? A function-declaration substring,
// never a bare mention/call-site.
fn has_revert_handler(code: string) -> bool {
    if index_of(code, "function onRevert") >= 0 { return true; }
    if index_of(code, "function onAbort") >= 0 { return true; }
    if index_of(code, "function cancel") >= 0 { return true; }
    if index_of(code, "function claimRefund") >= 0 { return true; }
    if index_of(code, "function refund") >= 0 { return true; }
    return false;
}

// Does the zone's code write an indexed slot (`mapping[key] = value;` / `array[idx] = value;` — bracket-
// close, space, equals; distinguishes a WRITE from a read like `x = mapping[key];`)?
fn has_indexed_write(code: string) -> bool {
    return index_of(code, "] =") >= 0;
}

// True only when the zone BOTH declares a revert/refund/cancel handler AND writes an indexed slot (nested
// `if`, not `&&`).
fn contains_index_overwrite_signal(code: string) -> bool {
    if has_revert_handler(code) {
        if has_indexed_write(code) { return true; }
    }
    return false;
}

// --- #1713 value-custody flag (severity-first deep-hunt gate) ---------------------------------------
// A zone is VALUE-CUSTODY when it OWNS the accounting that moves user funds — either the #1698 C6
// value-moving-accounting net (a mint/redeem/deposit/withdraw/swap entrypoint that adjusts an amount
// before it moves) OR the #1681 C10/C11 lending/CDP/stability-pool net (a Trove/money-market/stability-
// pool system, directly or via an ERC4626 wrapper). Those are the zones where a stateful-invariant fuzzer
// (run-invariant-hunt.sh) is worth its cost: money-tier bugs live in the multi-step accounting a single-
// function read misses. PURE REUSE — no new detection logic; both nets are the already-live-tuned #1698/
// #1681 helpers above. map-zones.sh scrapes the CUSTODY| diagnostic line this emits (below) into
// zones.json's `value_custody`; run-zone-hunt.sh's --deep-hunt stage gates on it.
fn is_value_custody(code: string) -> bool {
    if contains_accounting_signal(code) { return true; }
    if contains_lending_signal(code) { return true; }
    return false;
}

// .ag has no bool->string builtin that guarantees the `true`/`false` tokens map-zones.sh's CUSTODY| scrape
// parses; branch explicitly (matches this file's no-reassignment style).
fn bool_str(b: bool) -> string {
    if b { return "true"; }
    return "false";
}

// First non-empty line of `s` (mirrors hunter.ag::first_line — the verdict's ZONE| line is what we want).
fn first_line(s: string) -> string {
    return reduce(regex_split("\n", s), |acc: string, l: string| -> string {
        if len(acc) > 0 { return acc; }
        if len(l) > 0 { return l; }
        return acc;
    }, "");
}

// The first `ZONE|`-prefixed line of `verdict`; "" when no such line exists (mirrors outcome_of's own
// failure detection so a genuinely failed classification is never force-upgraded to success).
fn zone_line(verdict: string) -> string {
    let at = index_of(verdict, "ZONE|");
    if at < 0 { return ""; }
    return first_line(substring(verdict, at, len(verdict)));
}

// The Nth `|`-delimited field of `line`, 0-based (same reduce-with-tab-prefixed-accumulator idiom as
// coordinator.ag::payload_field; duplicated locally per this codebase's per-agent-copy convention).
fn pipe_field(line: string, n: int) -> string {
    let segs = regex_split("\\|", line);
    let acc = reduce(segs, |a: string, seg: string| -> string {
        let bar = index_of(a, "\t");
        let idx = parse_int(substring(a, 0, bar));
        let cap = substring(a, bar + 1, len(a));
        if idx == n { return to_string(idx + 1) + "\t" + seg; }
        return to_string(idx + 1) + "\t" + cap;
    }, "0\t");
    return substring(acc, index_of(acc, "\t") + 1, len(acc));
}

// .ag has no trim builtin (same gap prospector/intake.ag::trim documents): strip leading/trailing ASCII
// whitespace by scanning in from both ends; interior spaces are preserved. Needed because the LLM's own
// csv classes field may come back "C15, C2, C12" (comma-space) rather than "C15,C2,C12".
fn is_ws(c: string) -> bool {
    if c == " " { return true; }
    if c == "\t" { return true; }
    if c == "\r" { return true; }
    if c == "\n" { return true; }
    return false;
}
fn first_nonws(s: string, i: int, n: int) -> int {
    if i >= n { return n; }
    if is_ws(substring(s, i, i + 1)) { return first_nonws(s, i + 1, n); }
    return i;
}
fn last_nonws(s: string, i: int) -> int {
    if i < 0 { return -1; }
    if is_ws(substring(s, i, i + 1)) { return last_nonws(s, i - 1); }
    return i;
}
fn trim(s: string) -> string {
    let n = len(s);
    if n == 0 { return ""; }
    let startIdx = first_nonws(s, 0, n);
    if startIdx >= n { return ""; }
    let endIdx = last_nonws(s, n - 1);
    if endIdx < startIdx { return ""; }
    return substring(s, startIdx, endIdx + 1);
}

// Is `cls` already one of the comma-separated (optionally comma-space) ids in `classesCsv`?
fn class_has(classesCsv: string, cls: string) -> bool {
    return reduce(regex_split(",", classesCsv), |acc: bool, c: string| -> bool {
        if acc { return true; }
        return trim(c) == cls;
    }, false);
}

// Append `cls` to `classesCsv` unless it is already present (avoids duplicate `C10,C10` entries, which
// would otherwise double run-discovery.sh's per-zone cell fan-out cost for that class).
fn force_include(classesCsv: string, cls: string) -> string {
    if class_has(classesCsv, cls) { return classesCsv; }
    if len(trim(classesCsv)) == 0 { return cls; }
    return classesCsv + "," + cls;
}

// Per-signal class-forcing helpers (kept separate rather than inlined into apply_backstop() so each net's
// gate stays a single readable `if !signal { return classesCsv; }` early-return, matching this file's
// no-reassignment `let` style — .ag bindings are single-assignment, so the C10/C11/C6/C17 nets are chained
// through sequential `let` locals in apply_backstop() below rather than mutating one accumulator).
fn apply_lending_backstop(classesCsv: string, code: string) -> string {
    if !contains_lending_signal(code) { return classesCsv; }
    let withC10 = force_include(classesCsv, "C10");
    return force_include(withC10, "C11");
}
fn apply_accounting_backstop(classesCsv: string, code: string) -> string {
    if !contains_accounting_signal(code) { return classesCsv; }
    return force_include(classesCsv, "C6");
}
fn apply_index_overwrite_backstop(classesCsv: string, code: string) -> string {
    if !contains_index_overwrite_signal(code) { return classesCsv; }
    return force_include(classesCsv, "C17");
}

// The deterministic net: when the zone's code signals a lending/CDP/stability-pool system (direct or
// ERC4626-wrapped), force C10 ("first-depositor/inflation") + C11 ("stability-pool offset"); when it signals
// value-moving accounting logic it owns (#1698), force C6 ("accounting/rounding direction"); when it signals
// an id-keyed slot write inside a revert/refund/cancel recovery handler (#1698), force C17 ("index/slot-
// overwrite") — into its class list regardless of what the LLM returned. False positives here are cheaper
// than a missed first-depositor, stability-pool-offset, accounting, or slot-overwrite bug (the same tradeoff
// #1681 established). A genuine classification failure (no ZONE| line at all) is left alone, not forced to
// succeed. The corrected line is APPENDED as a new, trailing `ZONE|` line rather than mutating the LLM's own
// line in place: map-zones.sh's scraper already takes `grep -E '^[[:space:]]*ZONE\|' ... | tail -1` (the
// #1663/#1664 whitespace-tolerant last-line scrape), so the appended line is picked up with zero changes to
// the shell side. All four classes are folded into ONE rebuilt trailing line (not one appended line per
// class) so that single `tail -1` scrape stays correct.

// --- #1711 learned-real-bug fitness reorder (the ACT half of the corpus-bench -> hunter feedback loop) -----
// The bench (bench-to-knowledge.sh) imports per-class REAL-BUG precision as agentis `hunt-fitness` knowledge;
// this agent CONSUMES it here to reorder a zone's class CSV so historically-real-bug classes hunt FIRST. That
// order flows through map-zones.sh's `tail -1` ZONE| scrape -> scope.tsv -> run-discovery.sh's per-cell fan-out
// in CSV order, seeding the #1001 blackboard for siblings with the highest-precision class first. NOTE: this is
// a deliberate IMPORTED-KNOWLEDGE channel (recommend/query_knowledge("hunt-fitness") reading bench-fed rows),
// NOT an in-agent learn->recommend loop — the agent's own learn() topic stays "zone-map"; the corrected signal
// lives in the separate, inspectable knowledge store, never entangled with hunter's local "surfaced=success".
// Pure `.ag`, no `exec sh`. When no hunt-fitness knowledge is imported (query_knowledge empty) OR none of the
// zone's classes carry a fitness entry, every function below is an IDENTITY on the class CSV — byte-identical
// to today, so the reorder only ever changes behaviour once the bench has taught it something.

// success_rate (real-bug precision) for `cls` among the knowledge rows; -1.0 when the class has no entry.
fn rate_of(rows: list, cls: string) -> float {
    return reduce(rows, |acc: float, row: map| -> float {
        let cond = to_string(get(row, "condition"));   // entry condition is "class <CLS>"
        let at = index_of(cond, "class ");
        if at < 0 { return acc; }
        let rc = trim(substring(cond, at + 6, len(cond)));
        if rc == cls {
            let sr = get(row, "success_rate");
            if sr > acc { return sr; }
        }
        return acc;
    }, 0.0 - 1.0);
}

// Trimmed, non-empty class ids from a CSV, ORIGINAL order preserved (mirrors class_has's split idiom).
fn csv_classes(csv: string) -> list {
    return reduce(regex_split(",", csv), |acc: list, c: string| -> list {
        let t = trim(c);
        if len(t) == 0 { return acc; }
        return push(acc, t);
    }, []);
}

// Partition helpers: a class HAS fitness when rate_of > -1.0 (a real entry, incl. a legitimate 0.0-precision
// one); it lacks fitness when rate_of <= -1.0 (the rate_of sentinel). Both preserve original CSV order.
fn with_fitness(rows: list, classes: list) -> list {
    return filter(classes, |c: string| -> bool { return rate_of(rows, c) > (0.0 - 1.0); });
}
fn without_fitness(rows: list, classes: list) -> list {
    return filter(classes, |c: string| -> bool { return rate_of(rows, c) <= (0.0 - 1.0); });
}

// Index in `classes` of the highest-precision element; FIRST occurrence on ties (strict `>`), so a stable
// selection sort falls out. Recursion carries the running best index/rate (this file's no-reassignment style).
fn argmax_rate(rows: list, classes: list, i: int, bi: int, br: float) -> int {
    if i >= len(classes) { return bi; }
    let r = rate_of(rows, get(classes, i));
    if r > br { return argmax_rate(rows, classes, i + 1, i, r); }
    return argmax_rate(rows, classes, i + 1, bi, br);
}
// `classes` with the element at index k dropped, order otherwise preserved.
fn drop_at(classes: list, k: int, i: int, acc: list) -> list {
    if i >= len(classes) { return acc; }
    if i == k { return drop_at(classes, k, i + 1, acc); }
    return drop_at(classes, k, i + 1, push(acc, get(classes, i)));
}
// Stable selection sort of the with-fitness classes by DESCENDING real-bug precision (ties keep original CSV
// order via argmax's first-occurrence rule). ≤ a handful of classes per zone, so the O(n^2) walk is trivial.
fn sel_sort(rows: list, classes: list) -> list {
    if len(classes) == 0 { return classes; }
    let bi = argmax_rate(rows, classes, 0, 0, 0.0 - 2.0);
    let best = get(classes, bi);
    let rest = drop_at(classes, bi, 0, []);
    let sortedRest = sel_sort(rows, rest);
    return reduce(sortedRest, |a: list, x: string| -> list { return push(a, x); }, push([], best));
}
// Join a class list back into a comma-separated string (no trailing separator).
fn join_csv(items: list) -> string {
    return reduce(items, |acc: string, x: string| -> string {
        if len(acc) == 0 { return x; }
        return acc + "," + x;
    }, "");
}

// Reorder `classesCsv` so classes with a learned real-bug fitness entry come FIRST (highest precision first,
// stable on ties), then the classes with no entry in their original order. Identity when no fitness is imported
// OR when none of this zone's classes carry an entry (preserving today's exact CSV, spacing included).
fn apply_fitness_reorder(classesCsv: string) -> string {
    let rows = query_knowledge("hunt-fitness", 64);
    if len(rows) == 0 { return classesCsv; }
    let classes = csv_classes(classesCsv);
    let withF = with_fitness(rows, classes);
    if len(withF) == 0 { return classesCsv; }
    let ordered = sel_sort(rows, withF);
    let noF = without_fitness(rows, classes);
    let all = reduce(noF, |a: list, x: string| -> list { return push(a, x); }, ordered);
    return join_csv(all);
}

// A short "learned fitness prior" block prepended to the classification instruction (mirrors dev-apprenticeship
// risk_assessor's `"Past incident patterns: " + to_string(rec)` shape). Empty when recommend() carries no
// knowledge (get(rec,"knowledge") == 0) -> byte-identical prompt to today, so no regression before any import.
fn fitness_prior(rec: map) -> string {
    if get(rec, "knowledge") == 0 { return ""; }
    return "=== LEARNED REAL-BUG FITNESS PRIOR (corpus-bench ground truth) ===\n"
      + "On already-scored contests, these bug classes historically caught the most REAL bugs per candidate. "
      + "Weight your class choice toward the higher-precision ones WHEN this zone's mechanics genuinely expose "
      + "them (do not add a class the zone does not actually support):\n"
      + to_string(rec) + "\n\n";
}

fn apply_backstop(verdict: string, code: string) -> string {
    let line = zone_line(verdict);
    if len(line) == 0 { return verdict; }
    let withLending = apply_lending_backstop(pipe_field(line, 3), code);
    let withAccounting = apply_accounting_backstop(withLending, code);
    let withAll = apply_index_overwrite_backstop(withAccounting, code);
    // #1711: rank the FULL post-backstop class set (LLM classes + any forced C6/C10/C11/C17) by learned
    // real-bug precision, so the highest-precision class leads the CSV that run-discovery.sh fans out.
    let reordered = apply_fitness_reorder(withAll);
    let rebuilt = "ZONE|" + pipe_field(line, 1) + "|" + pipe_field(line, 2) + "|" + reordered + "|" + pipe_field(line, 4);
    if rebuilt == line { return verdict; }
    return verdict + "\n" + rebuilt;
}

let dir = getenv("TARGET_DIR");
let zoneId = getenv("ZONE_ID");
let files = getenv("ZONE_FILES");
let code = scoped_code(dir, files);
let taxo = read_taxonomy(getenv("TAXONOMY"));

// #1711: pull the learned real-bug fitness recommendation (bench-fed `hunt-fitness` knowledge) and turn it
// into a soft prior on the classification. Empty (no knowledge imported) -> byte-identical prompt to today.
let rec = recommend("hunt-fitness", ["real-bug"]);
let priorBlock = fitness_prior(rec);

// The instruction carries the class menu (taxonomy) + the strict output contract; the zone's concatenated
// code is the prompt payload (matches hunter.ag / audit-scout.ag's prompt(instruction, code) shape). The
// learned fitness prior (empty until the bench teaches it something) leads the instruction.
let instruction = priorBlock
  + "You are an elite adversarial smart-contract auditor doing ATTACK-SURFACE MAPPING. You are handed ONE "
  + "zone of a target — a directory of in-scope contracts — and your job is to classify it: give it a short "
  + "human subsystem name, choose the bug CLASSES an external attacker (holding NO privileged role) would "
  + "probe HERE, and write a one-line description of why. Choose classes ONLY from the taxonomy below, by "
  + "their ids (e.g. C1, C6, C10); pick the 1-4 that genuinely fit this zone's mechanics, not every class.\n\n"
  + "=== THE BUG-CLASS MENU (choose ids from here) ===\n" + taxo + "\n\n"
  + "=== INTEGRATION-SEAM DETECTION RULE (C15) ===\n"
  + "INCLUDE `C15` (integration-seam / composability) in this zone's class list when the zone's contracts are "
  + "named `*Adapter`/`*Guard`/`*Bridge`/`*Oracle`/`*Wrapper`/`*Router`/`*Strategy`, OR they import or call an "
  + "external protocol's interface (an integration into a SECOND protocol) — the cross-protocol seam is "
  + "under-audited by construction (protocol A's auditors trust B; B's auditors never see A's integration "
  + "code). A name suffix is a strong hint but not required: an import/call into another protocol's interface "
  + "IS the seam even with a plain name. If this zone does NOT integrate a second protocol, do NOT add C15.\n\n"
  + "=== LENDING/CDP/STABILITY-POOL DETECTION RULE (C10/C11) ===\n"
  + "The taxonomy's own guidance is: \"a lender -> C8/C10/C11\". If this zone IS a lender/CDP/stability-pool "
  + "system (a Trove/CDP manager, a Compound/Aave-style money market, a Liquity-style stability pool, or a "
  + "fork of any of those), INCLUDE `C10` (first-depositor/inflation) and `C11` (stability-pool offset). This "
  + "extends to WRAPPED instances too: an ERC4626-style Strategy or Vault contract that deposits into, or "
  + "withdraws from, such a system is lending-adjacent even though it is not itself the lender — include "
  + "C10/C11 for the wrapper zone as well. Signals to look for (import/type lines, not just contract names): "
  + "`ITroveManager`, `IStabilityPool`, `ICollateralRegistry`, `IAaveLendingPool`, `IPoolAddressesProvider`, "
  + "`IComptroller`, `ICToken`. A bare, generic `IPool`/pool interface is NOT enough by itself — Balancer- and "
  + "AMM-style pools use that name too; only add C10/C11 when the zone is genuinely a lending/CDP/stability-pool "
  + "integration. If none of this zone's contracts touch a lending/CDP/stability-pool system, do NOT add C10/C11.\n\n"
  + "=== VALUE-MOVING ACCOUNTING DETECTION RULE (C6) ===\n"
  + "The taxonomy's own guidance is: \"mint/redeem, fee math, AMM invariants, any a*b/c\". INCLUDE `C6` "
  + "(accounting/rounding direction) when this zone DEFINES (not just declares or imports) a mint/burn/"
  + "deposit/withdraw/redeem/swap entrypoint whose function BODY does amount-adjusting arithmetic — a fee "
  + "deducted from the amount before it moves, a balance decremented, a rounding step applied. A pure "
  + "interface declaration (no function body) is NOT enough, and a trivial pass-through mock (no real "
  + "arithmetic) is NOT enough — only add C6 when this zone genuinely OWNS the value-moving accounting "
  + "logic. If this zone has no such entrypoint, or only calls/imports one defined elsewhere, do NOT add C6.\n\n"
  + "=== INDEX/SLOT-OVERWRITE DETECTION RULE (C17) ===\n"
  + "The taxonomy's own guidance is: \"any id-keyed record write (mapping/array slot assignment) -> C17\", "
  + "with special emphasis on such writes near revert/refund/cancel paths. INCLUDE `C17` (index/slot-overwrite) "
  + "when this zone DEFINES a revert/refund/cancel recovery handler that writes an id-keyed mapping/array slot "
  + "from the recovery payload without first checking the slot is empty — a stale or externally-supplied id "
  + "reused as a storage key can silently clobber a prior record. This is distinct from a routine balance-"
  + "mapping increment (e.g. `balances[msg.sender] += amount`), which is not itself an overwrite risk. If this "
  + "zone has no such recovery-path slot write, do NOT add C17.\n\n"
  + "=== ZONE ID (echo it back UNCHANGED as the first field) ===\n" + zoneId + "\n\n"
  + "=== HOW TO ANSWER ===\n"
  + "FIRST reason step by step: read the zone's contracts, name the subsystem, and for EACH candidate class "
  + "decide whether this zone's actual functions expose it. THEN write EXACTLY ONE line:\n"
  + "ZONE|" + zoneId + "|<short subsystem name>|<class1,class2,...>|<one-line why these classes apply>\n"
  + "Use NO `|` character inside the name/classes/description fields (they are pipe-delimited). Reason for as "
  + "long as you need first; ONLY the single ZONE| line is parsed, so your analysis above it is free.";

let verdict = prompt(instruction, code) -> string;
// #1681 + #1698: apply the deterministic C10/C11/C6/C17 backstop nets after the LLM classification, before
// the verdict is surfaced or scored — see apply_backstop() above for why it appends rather than mutates.
let finalVerdict = apply_backstop(verdict, code);

// Surface the classification to map-zones.sh (stdout) and record the attempt so the mapping reweights over
// time (mirrors hunter.ag / audit-scout.ag's print/emit/learn/memo tail).
print(finalVerdict);
// #1711: surface the learned-fitness recommendation used this run as a NON-ZONE| diagnostic line, so the
// recommend() result is observable in the zone log without perturbing map-zones.sh's `^ZONE\|` scrape.
print("FITNESS-REC|" + zoneId + "|" + to_string(rec));
// #1713: emit the value-custody flag as a NON-ZONE| diagnostic line (same trailing-line-scrape channel as
// FITNESS-REC|). map-zones.sh scrapes `CUSTODY|<zoneId>|<true|false>` into zones.json's `value_custody`;
// run-zone-hunt.sh's --deep-hunt stage runs the invariant engine only on the `true` zones. The `.ag` owns
// the semantic decision (via the shipped #1698/#1681 nets); the shell only scrapes — never perturbs the
// `^ZONE\|` scrape.
print("CUSTODY|" + zoneId + "|" + bool_str(is_value_custody(code)));
let outcome = outcome_of(finalVerdict);
emit("dark-factory:zone_mapped", "{\"zone\":\"" + zoneId + "\",\"outcome\":\"" + outcome + "\"}");
learn("zone-map", zoneId, "attack-surface classification of zone " + zoneId, outcome, ["zone-map", zoneId, outcome]);
memo_write("zone-mapper:last_check", "done");
