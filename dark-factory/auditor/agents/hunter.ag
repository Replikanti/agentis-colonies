cb 300000;
// #863 — custom-code DISCOVERY hunter. Deep, taxonomy-driven adversarial audit of CUSTOM
// (non-fork) in-scope code. Complements the DAG matcher (seed-patterns/recall-match), which
// fires only on known-code RECURRENCE and returns nothing on bespoke protocols (a fresh stablecoin, a new vault).
//
// One invocation hunts ONE bug class over ONE subsystem; run-audit.sh --mode discovery fans out
// (subsystem x class) in parallel — the colony-native version of a hand-run multi-agent audit pass,
// feeding every candidate into the forge-verify gate before it counts as a finding.
//
// Env:
//   TARGET_DIR  repo root of the cloned target
//   IN_SCOPE    newline-separated contract paths (relative to TARGET_DIR) for this subsystem
//   SCOPE_BRIEF path to a file holding the invariants-to-break + known-issues-to-exclude + trust model
//   TAXONOMY    path to bug-taxonomy.md
//   HUNT_CLASS  one class id, e.g. "C1"
//   SUBSYSTEM   human label for this slice
//   DEPTH_TARGET  #1827 (optional, default ""): `file@fn` of ONE already-flagged function this cell
//               re-reads under a different lens. Empty (the default) => the prompt is byte-identical.
//   DEPTH_KNOWN   #1827 (optional, default ""): the lead(s) a breadth cell already surfaced on that
//               function, quoted VERBATIM as an exclusion. Consumed as ONE opaque string (never split).
//   APPENDIX_FILE #1865 (optional, default ""): the ONE IN_SCOPE token (`path@fn+fn`) that is the #1861
//               inheritance appendix — a DERIVED contract sliced in because this zone's primary contract is
//               abstract. Empty (the default) => every helper below returns "" and the prompt is byte-identical.
//   APPENDIX_BASE #1865 (optional, default ""): the abstract base that token implements (rel path).
//   OPERATIONALIZE_LENS #2211 (optional, default unset = OFF): "1" opts IN to the pure-meta
//               "operationalize before you hunt" method directive. Any other value (or unset) leaves the
//               prompt byte-identical to the pre-#2211 one. Inverted vs CALLEE_TRUST on purpose — the
//               capability is UNMEASURED until the #2211 M2 corpus A/B runs.
//   EXTERNAL_RESOLVER #2235 (optional, default "" = OFF): absolute path to the per-cell copy of
//               resolve-external.sh. Non-empty ONLY under run-discovery.sh --external-resolve, and it is the
//               ONLY gate on the resolver directive (deliberately INDEPENDENT of OPERATIONALIZE_LENS — the
//               measured dismissals it exists to close happened in lens-OFF arms too). Empty => the directive
//               is "" => the prompt is byte-identical to the pre-#2235 one.
//   EXTERNAL_CACHE / EXTERNAL_BUDGET_STATE / EXTERNAL_BUDGET #2235 (optional, default ""): the cache root the
//               harness re-opens citations from, this cell's budget-state file, and the per-cell resolve
//               bound. They are quoted verbatim into the command line the directive prints, so the model
//               never has to invent a path; all four ride exec.env_passthrough or getenv() returns "".
//   ONCHAIN_FACT #2235 PR C (optional, default "" = OFF): absolute path to the per-cell copy of
//               onchain-fact.sh, the bounded `cast call` verb. Non-empty ONLY under run-discovery.sh
//               --external-resolve, and it is the ONLY gate on the on-chain directive. Empty => that
//               directive is "" => the prompt is byte-identical. The RPC endpoint is NEVER in the prompt or
//               in this env contract: onchain-fact.sh reads the operator's own DF_EXTERNAL_RPC/FORK_URL/
//               ETH_RPC_URL, and with none configured it answers `unavailable|no-rpc` — an honest null.
//   ONCHAIN_BUDGET_STATE / ONCHAIN_BUDGET / FORK_BLOCK #2235 PR C (optional, default ""): this cell's
//               call-budget file, the per-cell call bound, and the operator's pinned fork block. Quoted
//               verbatim into the command line the directive prints; all ride exec.env_passthrough or
//               getenv() returns "".
//   TRACE_REASK_IDS #2223 (optional, default ""): set by run-discovery.sh ONLY on a follow-through RE-ASK,
//               and only when the #2211 lens is on. It carries the check ids (`#2, #5`) the previous answer
//               left unanswered, so the re-ask names them instead of repeating the same prompt verbatim.
//               Empty (every first attempt, and every lens-OFF cell) => the directive is byte-identical.
//   PARAM_AUDIT #2245 iteration 5 (optional, default unset = OFF): "1" opts IN to the output-gated parameter
//               audit (param_audit_directive). Any other value leaves the prompt byte-identical. Independent of
//               SEVERITY_RUBRIC / GROUND_EVIDENCE / OPERATIONALIZE_LENS; its LEAD rule renders only when
//               SEVERITY_RUBRIC=1 too.
//   PARAM_REASK_ITEMS #2245 iteration 5 (optional, default ""): set by run-discovery.sh ONLY on a parameter re-ask;
//               it names the open audit items (uncovered functions, unanswered numbers, failed bounds, open
//               leads). Empty (every first attempt, and every knob-OFF cell) => the directive is unchanged.
// Stdout: exactly one `CANDIDATE|file:fn:line|class|severity|exploit|poc` line per finding, else `SAFE`.
//         Diagnostics that may precede it: `BLACKBOARD-FOCUS|`, `DEPTH-CELL|`, `APPENDIX-CONTEXT|`, —
//         #1887, only when a refute-constraint corpus is imported — `REFUTE-CONSTRAINTS|<subsystem>|<cls>|<n>`,
//         and — #2145, only when the settable-callee detector fires — `CALLEE-TRUST|<subsystem>|<cls>|<n>|v2`.
//         `CALLEE-VECTOR|<fn>|<callee-expr>|<hazard>|<CANDIDATE|dismissed: reason>` may also appear (model-emitted,
//         only when the callee-trust directive fired, #2152 — free text, never script-printed).
//         #2211, only when OPERATIONALIZE_LENS=1 opts in: `OPERATIONALIZE|<subsystem>|<cls>|on`, followed in the
//         model's own reply by one `OPCHECK|#<k>|<construct>|<invariant>` line per derived check (model-emitted,
//         free text, never script-printed) BEFORE any CANDIDATE| line, and — #2214 — one
//         `TRACE|#<k>|<CLEAN|BUG|UNRESOLVED>|<evidence>` line per derived check AFTER tracing it. #2223 made
//         `#<k>` (the check's ordinal within the cell) the PAIRING KEY: the TRACE answers the OPCHECK that
//         carries the SAME id, so a paraphrase cannot break the pairing and an unrelated trace line cannot
//         discharge a check. The TRACE lines are the FOLLOW-THROUGH half of the same contract: run-discovery.sh
//         GATES a no-candidate reply on them (any check left without a TRACE of its id => the cell is re-asked
//         once naming those ids; a cell where EVERY check stayed unanswered is then recorded as a FAILED
//         `untraced-opcheck` cell instead of a trusted clean negative, and a PARTIAL shortfall is recorded
//         per check on the cell rather than failing it wholesale). #2214 PR C adds the CITATION
//         half of that grammar: a CLEAN resting on configuration grounds must cite a `file:line` in the
//         audited repo, and a CLEAN resting on an EXTERNAL protocol fact must cite the interface/source/doc
//         it was verified against — an uncited one counts as untraced for the same gate, and an unverifiable
//         claim belongs on the record as UNRESOLVED (counted per cell), never folded into SAFE.
//         #2235, only when EXTERNAL_RESOLVER is non-empty: `EXTERNAL-RESOLVE|<subsystem>|<cls>|on`, and in the
//         model's own reply the `EXTERNAL-CITED <path>:<line>` evidence kind on a TRACE line (model-emitted,
//         free text, never script-printed). run-discovery.sh RE-OPENS every such citation from the cache or
//         the audited repo and requires the cited lines to state the fact — an unopenable or empty citation
//         marks THAT check uncited, exactly like the #2227 repo-path branch.
//         #2235 PR C, only when ONCHAIN_FACT is non-empty: `ONCHAIN-FACT|<subsystem>|<cls>|on`, and in the
//         model's own reply the `ONCHAIN <chain>:<address>:<selector>@<block> = <result>` evidence kind on a
//         TRACE line. run-discovery.sh re-opens THAT citation from the on-chain cache — never from the
//         network — and counts it only when a cached record for that call and block carries exactly the
//         cited result; anything else (including every `unavailable` answer) marks THAT check uncited.
//         #2245 iteration 5, only when PARAM_AUDIT=1 opts in: `PARAM-AUDIT|<subsystem>|<cls>|on`, followed in the
//         model's own reply by one `PARAM|#<k>|<file:function>|<parameter>|<caller|role|config|derived>` line per
//         audited value and one `PARAM-TRACE|#<k>|<bounded-at:<path>:<line>|unbounded>|<evidence>` answer per
//         number (model-emitted, free text, never script-printed). run-discovery.sh pairs them by id, re-opens
//         every bounded-at citation, and gates / re-asks / promotes on the result.

// --- file readers (dynamic paths -> safe-exec-concat per recall-match.ag precedent) ---
fn cat_file(path: string) -> string {
    if len(path) == 0 { return ""; }
    let at = index_of(path, "@");
    if at < 0 {
        // colony-lint: safe-exec-concat
        return exec sh "sed -n '1,2000p' ${path} 2>/dev/null || true";
    }
    // Function-level slice: a scope entry `path@fn1+fn2` feeds ONLY those functions (+ the contract
    // header) so a deep adversarial read of a big/complex contract fits the LLM per-call budget —
    // whole-file concats overflow it and the liquidation/seize cells time out (#863).
    let file = substring(path, 0, at);
    let funcs = substring(path, at + 1, len(path));
    let slicer = getenv("SLICER");
    // colony-lint: safe-exec-concat
    return exec sh "sh ${slicer} ${file} '${funcs}' 2>/dev/null || true";
}

// --- #1865 IMPLEMENTATION-APPENDIX FRAMING (the generation-side twin of refuter.ag's #1861 gate half) ---
// #1861 already routes the derived implementor's slice into this payload (map-zones.sh appends the token to
// the zone's scope_files, run-discovery.sh feeds it through IN_SCOPE). What never arrived is the FRAMING: the
// slice landed as just another `// ========== <path> ==========` section, so the hunter was never told that
// its primary contract is ABSTRACT and that the extra section is that contract's implementation. The helpers
// below add exactly that: a labelled header on that one payload section (appendix_label/appendix_header) and
// one judging block in the instruction (appendix_rule), both of which return "" for an empty APPENDIX_FILE —
// an appendix-free zone's payload and instruction stay byte-for-byte what they were. framing_emitted() then
// gates the RECORD on both halves actually being in the assembled prompt.
//
// COST — measured, not asserted (agentis v1.28.0, demo-discovery-parallel.sh 18g reproduces it). The added
// work is O(1) per in-scope token (one call, one len, one string compare — no new reduce, no per-element
// exec), but the CONSTANT is NOT small: it is roughly the whole pre-existing per-element cost of that
// reduce, so the fold's per-element budget is about 2x. Under a `cb 2000;` stress probe the pre-#1865 fold
// completes 107 tokens and this one 55 — and the cost is paid on EVERY cell, appendix-free zones included,
// because the call happens before `len(appendix) == 0` can return. It is NOT a runtime risk at the budget
// that actually runs: `agentis go` honours this file's declared `cb 300000;`, where the same fold is bounded
// by the 16 MiB string heap (~378 tokens) rather than by CB, three orders of magnitude above a real zone's
// file count. A per-element interpreted WALK (regex_split/reduce over a list, ~70+ CB per element) is the
// recidivist substrate trap this design still refuses; a per-element CALL is affordable, not free.

// The two markers the framing is RECOGNISED by, one per half (payload label, judging block). They are
// helpers rather than literals repeated at the check site, so a reword cannot desync framing_emitted() below
// from the text it has to detect. Written multi-line like every other fn here: demo-discovery-parallel.sh
// 18g extracts these BY LINE RANGE with the repo's `f&&/^}$/{exit}` idiom, which needs a closing line.
fn appendix_marker() -> string {
    return "// IMPLEMENTATION APPENDIX:";
}

fn anchoring_marker() -> string {
    return "ANCHORING:";
}

fn appendix_header(base: string) -> string {
    return appendix_marker() + " the contract under review (" + base + ") is ABSTRACT — some of its\n"
      + "// members are `virtual` with no body there. The slice below is ONE representative DERIVED contract\n"
      + "// implementing them: the behaviour the abstract file does not contain. Hunt the RESOLVED behaviour\n"
      + "// (base + override), not either file alone.\n";
}

// The header for the ONE payload section that IS the appendix; "" for every other file (and for every file
// when no appendix is staged). Concatenating "" is a no-op, which is what keeps the ordinary payload intact.
fn appendix_label(rel: string, appendix: string, base: string) -> string {
    if len(appendix) == 0 { return ""; }
    if rel != appendix { return ""; }
    return appendix_header(base);
}

// Concatenate every in-scope contract into one labelled blob (#1865: the appendix section additionally
// carries the header above, so the model can tell context from primary contract).
fn scoped_code(dir: string, files: string, appendix: string, base: string) -> string {
    return reduce(regex_split("\n", files), |acc: string, rel: string| -> string {
        if len(rel) == 0 { return acc; }
        return acc + "\n\n// ========== " + rel + " ==========\n"
             + appendix_label(rel, appendix, base) + cat_file(dir + "/" + rel);
    }, "");
}

// The prompt-level judging block: the counterpart of refuter.ag::appendix_rule, plus the ANCHORING clause the
// gate does not need. Anchoring matters because the appendix file is a legal in-scope file in this payload,
// so the output contract's bare `file:function[:line]` can legitimately name a file belonging to a DIFFERENT
// zone. Nothing downstream validates a candidate's file against zone membership (and a mechanical drop would
// discard exactly the "the bug is in the override" finding this appendix exists to surface), so the fix is to
// make such a location INTENTIONAL — and, via the APPENDIX-CONTEXT| sentinel below, attributable afterwards.
fn appendix_rule(appendix: string, base: string) -> string {
    if len(appendix) == 0 { return ""; }
    return "=== ABSTRACT CONTRACT — READ WITH THE IMPLEMENTATION APPENDIX ===\n"
      + "The contract you are auditing, " + base + ", is ABSTRACT: some members it declares are `virtual` "
      + "with no body in that file. The LAST section of the payload, " + appendix + ", is ONE representative "
      + "DERIVED contract that implements them.\n"
      + "Judge the RESOLVED behaviour (base + override): a bug that only exists once the override's body is "
      + "substituted into the base's flow IS a qualifying finding, and \"this file does not implement X\" is "
      + "NEVER a reason to skip a path — read X in the derived slice and keep tracing.\n"
      + anchoring_marker() + " the derived slice is CONTEXT for the base, not a second hunting ground. Put "
      + "the CANDIDATE location on the ABSTRACT contract's OWN function whenever the flaw is in the base's "
      + "logic, ordering or guards; name the derived file only when the flaw is genuinely in the override's "
      + "own body.\n\n";
}

// #1865 HONESTY GATE for the record. The sentinel below — and with it run-discovery.sh's per-cell
// `appendix` key, the artifact whose whole job is to make appendix influence attributable — must assert only
// what actually happened. Gating it on "the token was non-empty" would make it claim a cell was FRAMED even
// if the framing had been dropped from the payload or from the instruction, so the record could not serve as
// its own regression detector: a hunter that silently stopped framing would still be recorded as framing.
// It is therefore derived from the ASSEMBLED prompt — the labelled header must be in the PAYLOAD and the
// judging block in the INSTRUCTION — through the same marker helpers the producers use, so a reword cannot
// desync the check from the text it detects. Both halves are required: either one missing is a broken
// framing, and neither is reachable without a token, which is why the token test stays as the first gate.
fn framing_emitted(appendix: string, instruction: string, code: string) -> bool {
    if len(appendix) == 0 { return false; }
    if index_of(code, appendix_marker()) < 0 { return false; }
    return index_of(instruction, anchoring_marker()) >= 0;
}

// Extract the `## <cls> ...` section from the taxonomy (until the next `## `).
fn class_section(taxo: string, cls: string) -> string {
    // colony-lint: safe-exec-concat
    return exec sh "awk -v c=\"${cls}\" 'index($0,\"## \"c\" \")==1{f=1} f&&index($0,\"## \")==1&&index($0,\"## \"c\" \")!=1{exit} f{print}' ${taxo} 2>/dev/null || true";
}

// learn() outcome must be one of the runtime enum {success,failure,partial,timeout,error}.
// A surfaced candidate = success; a rigorous SAFE = failure (so taxonomy fitness rewards the
// classes that actually produce leads across targets, per #861's evolve loop). No reassignment.
fn outcome_of(verdict: string) -> string {
    if index_of(verdict, "CANDIDATE|") >= 0 { return "success"; }
    return "failure";
}

// #1827: a depth cell carries an extra "depth" tag so taxonomy fitness can be read per PHASE — a class that
// only ever produces on the breadth pass is a different signal from one that produces on a re-read. A breadth
// cell's tag list is byte-identical to the pre-#1827 one.
fn hunt_tags(cls: string, subsystem: string, outcome: string, depth: string) -> list<string> {
    if len(depth) == 0 { return [cls, subsystem, outcome]; }
    return [cls, subsystem, outcome, "depth"];
}

// --- #1001 shared BLACKBOARD: a first inter-agent coordination primitive ---
// The discovery fan-out runs every (subsystem x class) cell against ONE shared agentis store, so a
// memo a cell writes is visible to every LATER cell via recall_latest. That makes a "blackboard"
// (Hayes-Roth) the minimal-but-real way for findings to STEER siblings instead of each cell being an
// island: a cell that surfaces a CANDIDATE posts a one-line lead, and every cell that runs after it
// reads the board and FOCUSES — corroborate a sibling's hit in the same subsystem, or pivot toward a
// related attack surface a sibling already flagged. This is one coordination step, NOT a claim of
// emergent behavior; the broader vision (a coordinator that reprioritizes/prunes the manifest) is
// follow-up. The board is rolling newline-joined `subsystem|class|severity|one-line lead` lines.

// Single-assignment .ag bindings — accumulate via pure helpers, never reassign a `let`.
fn append_line(prev: string, line: string) -> string {
    if len(line) == 0 { return prev; }
    if len(prev) == 0 { return line; }
    return prev + "\n" + line;
}

// First non-empty line of `s` (the verdict's lead summary lives on the first CANDIDATE| line).
fn first_line(s: string) -> string {
    return reduce(regex_split("\n", s), |acc: string, l: string| -> string {
        if len(acc) > 0 { return acc; }
        if len(l) > 0 { return l; }
        return acc;
    }, "");
}

// The first `CANDIDATE|...` line of the verdict as a lead summary, with the literal `CANDIDATE|` token
// STRIPPED. Stripping matters: the board (and the diagnostic lines that echo it) must NOT carry a bare
// `CANDIDATE|`, or run-discovery.sh's `grep 'CANDIDATE|'` report-scraper would double-count the
// blackboard echo as a finding. The remaining `file:fn:line|class|sev|exploit|poc` is the lead body.
fn lead_summary(verdict: string) -> string {
    let at = index_of(verdict, "CANDIDATE|");
    if at < 0 { return ""; }
    let line = first_line(substring(verdict, at, len(verdict)));
    return substring(line, len("CANDIDATE|"), len(line));
}

// Leads on the board that belong to `subsystem` (want_same=true) or to OTHER subsystems (false), each
// rendered as a "  - <lead>" bullet. A lead line starts `subsystem|...`, so a same-subsystem match is
// an exact prefix match on `subsystem + "|"`.
fn board_bullets(board: string, subsystem: string, want_same: bool) -> string {
    return reduce(regex_split("\n", board), |acc: string, l: string| -> string {
        if len(l) == 0 { return acc; }
        let is_same = index_of(l, subsystem + "|") == 0;
        if is_same == want_same { return append_line(acc, "  - " + l); }
        return acc;
    }, "");
}

// The "corroborate THIS subsystem" paragraph (empty when no same-subsystem lead exists).
// #1799: a sibling lead is a same-SUBSYSTEM lead but almost always a DIFFERENT class (map-zones emits one
// subsystem x many classes, so every later cell of that subsystem lands here). The old wording ("check for
// the same root-cause class on adjacent functions") redirected each class-cell onto the sibling's class +
// function — so on a real multi-class hunt every cell CONVERGED on the first-posted lead and never hunted
// its OWN assigned class, collapsing coverage (measured live on notional: C1/C6/C4 all piled onto the C15
// getWithdrawRequestValue lead and the run named no other function). Corroboration stays valuable but MUST
// be secondary: hunt your assigned class across ALL scoped functions first — especially the untouched ones.
fn corroborate_para(same: string) -> string {
    if len(same) == 0 { return ""; }
    return "A sibling cell already surfaced a lead in THIS subsystem. Treat it as a PRIOR, but do NOT narrow "
         + "your hunt onto it: FIRST hunt YOUR assigned class across ALL your scoped functions — especially "
         + "the ones NO sibling has flagged yet — THEN, secondarily, corroborate or refute the sibling lead:\n"
         + same + "\n";
}

// The "pivot toward an OTHER-subsystem lead" paragraph (empty when no other-subsystem lead exists).
fn pivot_para(other: string) -> string {
    if len(other) == 0 { return ""; }
    return "Sibling cells flagged leads in OTHER subsystems — if any shares a dependency, code path, "
         + "or invariant with what you are reviewing, PRIORITIZE that overlap:\n" + other + "\n";
}

// Render the FOCUS block injected into a later cell's prompt: split the board into leads from THIS
// subsystem (corroborate) vs OTHER subsystems (pivot toward a related surface). Returns "" when the
// board holds no sibling lead this cell should act on — so a virgin first cell prompts unchanged and
// the existing single-cell behavior is preserved exactly. No `let` reassignment (single-assignment).
fn focus_block(board: string, subsystem: string) -> string {
    if len(board) == 0 { return ""; }
    let same = board_bullets(board, subsystem, true);
    let other = board_bullets(board, subsystem, false);
    // No `&&`/`||` in .ag — nest: only the empty-same AND empty-other case returns "".
    if len(same) == 0 {
        if len(other) == 0 { return ""; }
    }
    return "=== BLACKBOARD — leads sibling cells already posted in THIS run (let them FOCUS your hunt) ===\n"
         + corroborate_para(same) + pivot_para(other)
         + "Use these as PRIORS, not facts: still trace the code yourself, still report SAFE if this class "
         + "is genuinely clean here.\n\n";
}

// --- #1827 WITHIN-CONTRACT DEPTH pass ---
// Breadth yields <= 1 candidate per cell across the corpus even though the output contract below already asks
// for "EVERY qualifying bug", so the binding constraint is ATTENTION over a whole-zone payload, not the
// contract. A depth cell therefore re-asks the SAME question with the payload narrowed to ONE already-flagged
// function (`file@fn`, through cat_file's existing slicer) and the lead(s) that function already produced
// injected VERBATIM as an exclusion — the cheapest fake ("re-report the known bug") is foreclosed by
// construction, and the model's attention is spent on a second, mechanistically DIFFERENT bug.
//
// `known` is consumed as ONE OPAQUE STRING: it is never regex_split/reduce'd, so the added CB cost is O(1)
// in the number of known leads. An interpreted per-element walk pays ~70+ CB per element and would blow the
// enforced cb_per_tick ceiling on a function carrying a handful of leads — the recidivist substrate trap.
//
// Returns "" when `target` is empty, so a breadth cell's prompt stays byte-identical to the pre-#1827 one.
fn depth_block(target: string, known: string) -> string {
    if len(target) == 0 { return ""; }
    return "=== DEPTH PASS — a sibling cell ALREADY found a bug in this exact function ===\n"
         + "Function under review: " + target + ". The payload below is narrowed to that ONE function (plus "
         + "its contract header), because a bug was already proven to live here — this function carries real "
         + "attack surface and deserves a second, independent read.\n"
         + "ALREADY REPORTED here — do NOT report any of these again, in ANY rewording, and do not merely "
         + "restate their root cause:\n"
         + known + "\n"
         + "Report a bug whose MECHANISM is genuinely DIFFERENT from every line above (a different invariant, "
         + "a different attacker action, a different faulty guard) — a paraphrase of a known lead is worth "
         + "nothing. Do NOT invent one to satisfy this request: if, after tracing this function yourself, "
         + "there is no second qualifying bug, answer SAFE. A rigorous SAFE here is a valid, useful result.\n\n";
}

// --- #1887 REFUTER -> HUNTER CONSTRAINT CHANNEL (the read half) --------------------------------------------
// The refute gate is where most candidates die, and its reason is thrown away with the candidate. refuter.ag
// now emits the GENERALISABLE half of each refutation (`CONSTRAINT|<class>|<sentence>`, target-independent by
// contract); refute-to-knowledge.sh turns those into `refute-constraint` KnowledgeEntry rows and
// run-discovery.sh imports them into the run store BEFORE the cell loop. This block reads them back.
//
// The channel is a deliberate IMPORTED-KNOWLEDGE read, the same shape zone-mapper.ag's #1711 hunt-fitness
// read has — NOT an in-agent learn->recommend loop: nothing here writes knowledge, no cell writes knowledge,
// and the corpus is a static file identical in every cell's `cp -r` copy. That is what keeps `--jobs N`
// byte-equal to serial (#1857/#1858) while still letting one target's refutations teach the next one's hunt.
//
// INERTNESS is structural: with no corpus imported query_knowledge returns an empty list, every helper below
// returns "" / [], and the instruction is BYTE-IDENTICAL to the pre-#1887 one. The config flag, however, is
// NOT optional — without `knowledge.enabled = true` the query raises the runtime knowledge-store gate error,
// and ANY runtime error makes agentis discard this cell's whole stdout (the #1877 false zero), which is why
// run-discovery.sh ships that config line in the same change as this call. (The exact error string is
// deliberately NOT quoted here: this file is STAGED into the run dir, and demo-experience-flags.sh asserts
// the message is absent from that directory tree — a verbatim quote would make its grep self-match.)

// COST — measured, not asserted (agentis v1.28.0, demo-discovery-parallel.sh 19e reproduces it). This IS an
// interpreted per-element walk over the knowledge rows, the shape the substrate charges most for, so it is
// deliberately bounded twice: the read is capped at 32 rows and the rendered block at 6 bullets. Under the
// `cb 300000;` this file declares — what `agentis go` honours, and run-discovery.sh is the only caller, so
// that is the budget that actually runs — the fold completes on corpora of 1/8/32/128 entries, i.e. it is
// bounded by the read cap long before CB. Under the `cb 2000` cb_per_tick DEFAULT (a daemon budget this
// agent never runs under) it clears a 16-entry single-class corpus and no more. A larger per-class corpus
// than that is itself a smell: constraints are deduped standards, not a log.

// The `  - <sentence>` bullets for the constraints filed under `cls`. Entry `condition` is "class <CLS>",
// parsed with the same idiom as zone-mapper.ag::rate_of so the two readers cannot drift.
fn class_constraints(rows: list, cls: string) -> list {
    return reduce(rows, |acc: list, row: map| -> list {
        let cond = to_string(get(row, "condition"));
        let at = index_of(cond, "class ");
        if at < 0 { return acc; }
        let rc = trim(substring(cond, at + 6, len(cond)));
        if rc != cls { return acc; }
        let rec = trim(to_string(get(row, "recommendation")));
        if len(rec) == 0 { return acc; }
        return push(acc, "  - " + rec);
    }, []);
}

// The first `n` bullets, newline-joined. `sort_unique_strings` upstream makes the selection deterministic:
// the knowledge store's iteration order is NOT stable across imports, and an unsorted cap would silently
// hand two otherwise-identical cells two different prompts.
fn join_bullets(items: list, i: int, n: int, acc: string) -> string {
    if i >= n { return acc; }
    if i >= len(items) { return acc; }
    let line = to_string(get(items, i));
    if len(acc) == 0 { return join_bullets(items, i + 1, n, line); }
    return join_bullets(items, i + 1, n, acc + "\n" + line);
}

// min(len(items), n) — the number of bullets the block actually renders (the sentinel's <n> field).
fn capped_count(items: list, n: int) -> int {
    if len(items) < n { return len(items); }
    return n;
}

// The prompt block. "" for an empty corpus or a class with no constraint => byte-identical prompt.
// The anti-Goodhart clause is part of the block, not a comment: a hunter told what the gate rejects can
// learn to produce gate-PLEASING claims, and the measurement that judges this channel is ground-truth rare
// recall, not confirm rate. Capped at 6 bullets so the fold cannot grow without bound.
fn constraint_block(bullets: list) -> string {
    if len(bullets) == 0 { return ""; }
    return "=== WHAT AN INDEPENDENT SKEPTIC REJECTED IN EARLIER HUNTS OF THIS CLASS ===\n"
         + "A hostile reviewer killed earlier claims of this bug class for the reasons below. They are "
         + "STANDARDS a claim must meet, not facts about THIS code:\n"
         + join_bullets(bullets, 0, 6, "") + "\n"
         + "Pre-empt these objections: name the exact UNPRIVILEGED call sequence and the guard that fails to "
         + "stop it. NEVER weaken, re-frame or invent a claim to satisfy the gate — if the mechanism does not "
         + "hold, answer SAFE. A rigorous SAFE is worth more than a claim dressed to survive a review.\n\n";
}

// --- #2211 OPERATIONALIZE-BEFORE-YOU-HUNT DIRECTIVE (M1 — opt-in, default OFF) -------------------------------
// The measured gap: a hunt cell reads its class lens, then jumps straight at the OBVIOUS instance of it
// (reentrancy, a missing role check) and answers SAFE on zones whose real bug is only NAMEABLE after the
// class has been converted into a concrete, code-grounded check. #2191 showed that a generic "think about
// integrations" nudge does NOT close that gap (rare-recall delta +0): the lever is the METHOD — derive the
// checks, WRITE THEM OUT, then trace each one — not one more theme to keep in mind.
//
// Shape: pure-meta prose, NO detector. The method (scan for external touchpoints, numeric conversions,
// stored assumptions, state transitions) applies to essentially any zone, so a coarse detector would add
// cost and a SECOND variable without gating anything — the FLAG is the only gate, which is what keeps the
// M2 A/B a single-variable experiment. The text names no protocol, contract, function, flag, token standard
// or unit, so injecting it on a held-out target cannot leak an answer into the hunt.
//
// Default OFF, deliberately INVERTED against CALLEE_TRUST/INTEGRATION_LENS ("0" = off, default ON): this is
// an UNMEASURED recall-capability change, and #2191 proved a lens can be mechanically perfect and still
// score delta=+0. Unset (or any value other than "1") => the directive is "" => the assembled prompt is
// BYTE-IDENTICAL to the pre-#2211 one. M3 flips the default only on a measured rare-tier recall gain.

// The one string the block is RECOGNISED by, so a reword of the directive cannot desync the sentinel gate
// below from the text it has to detect (same discipline as callee_trust_marker above). It is the block's
// literal FIRST LINE: the sentinel greps the ASSEMBLED instruction for it, so a marker that is not a
// substring of what actually renders would silently disable the sentinel rather than fail loudly.
fn operationalize_marker() -> string {
    return "=== OPERATIONALIZE BEFORE YOU HUNT (do this FIRST, explicitly, in your reasoning) ===";
}

// The directive itself: the pure-meta "convert the class into code-grounded checks, write them out, THEN
// trace each" method, plus the OPCHECK| emission contract — which is what makes compliance observable in the
// cell log, so the live gate and the M2 A/B both assert on OUTPUT rather than on the prompt — and an
// anti-fabrication clause (a derived check is never itself a finding).
// #2214 closes the loop on that contract: the archived #2213 treatment arm shows cells writing 5-12 OPCHECK
// lines and then answering SAFE with ZERO of them traced in the reply, i.e. the derived check was the point
// of the method and it was silently abandoned. The TRACE| clause below makes the follow-through an OUTPUT
// obligation, which run-discovery.sh can then GATE on (prompt text alone is not a gate — that is the #2213
// lesson). Verdict vocabulary is deliberately CLEAN/BUG/UNRESOLVED: no `CANDIDATE|` substring, so
// lib/run-agent-validated.sh's hunter predicate cannot false-accept a cell on a trace line.
// #2223 numbers the checks. The measured failure of a COUNT-based contract is that N distinct but unrelated
// TRACE lines discharge N checks (the #2222 QA counter-example), so the id — the check's ordinal within this
// cell — is now the pairing key on BOTH sides, and the TRACE line drops the restated check text it can no
// longer be matched on. The instruction text is what makes the id available to the harness at all; the gate
// itself still lives in run-discovery.sh, because prompt text is not a gate (the #2213 lesson).
fn operationalize_block() -> string {
    return operationalize_marker() + "\n"
      + "Do NOT jump to the obvious bug (reentrancy, generic access control). FIRST, for the bug class in the "
      + "LENS below — and for any additional class this zone's brief names — convert the class into CONCRETE "
      + "operationalized checks grounded in THIS zone's actual code. An operationalized check is not a theme — "
      + "it has the form:\n"
      + "    \"for every <specific construct that appears in THIS zone's functions>,\n"
      + "     verify <specific invariant that construct must satisfy>, else it is a bug.\"\n"
      + "Method: scan the zone's functions for every place it touches an EXTERNAL protocol, a numeric "
      + "conversion, a stored assumption, or a state transition. For each such touchpoint, write the exact "
      + "check its correctness depends on — name the specific parameter/flag/function/field and the exact "
      + "invariant, derived from what THAT integration actually requires (read the code, do not hand-wave). "
      + "Cover both directions of any paired operation (entry vs exit, deposit vs withdraw, set vs read).\n"
      + "WRITE OUT the operationalized checks you derived for this zone, THEN trace each one against the "
      + "functions. A bug you can only name after operationalizing the check is exactly what a generic pass "
      + "misses — that is the point of this step. Do not restate the class titles; produce zone-specific, "
      + "code-grounded checks.\n"
      + "Emit each derived check, BEFORE you begin tracing and before any CANDIDATE line, on its own line, "
      + "NUMBERING the checks #1, #2, #3 ... in the order you derive them:\n"
      + "OPCHECK|#<k>|<the specific construct in this zone's code>|<the exact invariant it must satisfy>\n"
      + "Then trace each OPCHECK line against the functions and answer per the output contract below. Derive "
      + "the checks from THIS payload only: never invent a construct that is not in the code, and an OPCHECK "
      + "that traces clean is a normal result — it is never, by itself, a finding.\n"
      + "FOLLOW THROUGH — a check you write and abandon is worse than one you never derived. For EVERY "
      + "OPCHECK line you wrote, once you have traced it, emit one line of its own that REFERENCES THE SAME "
      + "NUMBER you gave that check:\n"
      + "TRACE|#<k>|<CLEAN or BUG or UNRESOLVED>|<the function or line in THIS zone that settles it>\n"
      + "The number is how a trace is matched to its check: a TRACE line carrying the wrong number, or no "
      + "number, answers NOTHING — it cannot stand in for the check it does not name, however well it is "
      + "written. Number every check, answer every number, and never renumber a check between the two lists.\n"
      + "SAFE is a valid answer ONLY when every OPCHECK number you wrote has a TRACE line with the same "
      + "number. UNRESOLVED "
      + "is an honest verdict — a check you cannot settle from this payload belongs on the record — and it "
      + "beats dropping the check silently.\n"
      + "EXTERNAL FACTS — the other way a derived check dies quietly: when a TRACE verdict of CLEAN rests on "
      + "a claim about how something OUTSIDE this payload behaves (what an external call returns, how it "
      + "scales, normalises or rounds a value, what units it uses, what order it applies operations in), "
      + "that claim is a FACT YOU MUST VERIFY, not an assumption you may lean on. VERIFIED has a strict "
      + "meaning: the text you cite is IN THIS REPOSITORY — a vendored interface, library, test or doc file, "
      + "at a specific path:line — AND that cited text literally STATES the property the check relies on (the "
      + "scaling factor, the decimal count, the normalisation rule, the ordering guarantee). Naming an "
      + "external site, a library by name, or a well-known convention is NOT verification, no matter how "
      + "standard it sounds — cite the repository text that states the fact, or the check is unverified. If "
      + "you cannot verify it from what you were given, the verdict is UNRESOLVED — never CLEAN. An "
      + "UNRESOLVED check is recorded and carried forward; a CLEAN resting on an unverified external claim is "
      + "a false negative with a confident face.\n\n";
}

// The M1 toggle. INVERTED vs callee_trust_enabled() (`!= "0"`) ON PURPOSE: only the literal "1" opts IN, so
// unset / any other value is OFF and is the DEFAULT. Do not "fix" this into consistency with its siblings —
// shipping an unmeasured recall directive default-ON is exactly the #2191 mistake this flag exists to avoid.
// The knob must also ride run-discovery.sh's exec.env_passthrough, else getenv() reads the SANITISED env and
// the whole feature is silently inert (the #1426/#2157 failure mode).
fn operationalize_enabled() -> bool {
    return getenv("OPERATIONALIZE_LENS") == "1";
}

// The directive as it enters the prompt: "" unless the flag opts in. Concatenating "" is a no-op, so the
// default (OFF) arm's instruction matches the pre-#2211 one byte for byte and the honesty-gated sentinel
// below auto-suppresses, because an empty directive carries no marker. O(1) top-level string concat — no
// regex, no reduce, no exec sh, so this adds no per-element substrate cost to any cell, firing or not.
fn operationalize_directive() -> string {
    if !operationalize_enabled() { return ""; }
    return operationalize_block() + trace_reask_block();
}

// --- #2223 RE-ASK ADDRESSING (empty on every first attempt) --------------------------------------------------
// run-discovery.sh's follow-through gate re-asks a cell that answered without a candidate while it left
// derived checks unanswered. Before #2223 the re-ask replayed the SAME prompt verbatim, which told the model
// nothing about WHICH check it dropped — the count rule could not name one. With the checks numbered, the
// shortfall IS a list of ids, so the re-ask states it. TRACE_REASK_IDS is set by the shell ONLY on a re-ask
// (and only inside a lens-ON cell), so this block is "" on every first attempt and the assembled prompt is
// unchanged there; it lives INSIDE the lens directive, so the lens-OFF prompt keeps its byte-identity
// contract whatever the env holds. Pure-meta like every other directive here: it names ids, never content.
fn trace_reask_block() -> string {
    let ids = getenv("TRACE_REASK_IDS");
    if ids == "" { return ""; }
    return "RE-ASK — your previous answer for this cell left these derived checks unanswered or closed them "
      + "on an unverified dismissal: " + ids + ". Answer each of them by number this time: keep the same "
      + "numbering you used before, emit one TRACE line per listed number, and settle it against the code in "
      + "front of you or record it as UNRESOLVED. Do not renumber the checks, do not drop the ones you "
      + "already settled, and do not replace a listed check with a different one.\n\n";
}

// --- #2145 ATTACKER-CONTROLLED-CALLEE DIRECTIVE (D1 of epic #2130) ------------------------------------------
// The measured gap this closes is NOT detection of the external call — the #2121 C8 backstop already
// force-includes a reentrancy cell on an interface-typed call. It is the TRUST MODEL the cell then applies:
// the RULES block below rightly puts "a trusted role acting WITHIN its documented permissions" out of scope,
// and a hunter reading a call whose TARGET address a deployer/config role set silently files the whole call
// site under that exclusion — so the callee is never modelled as hostile and the reentrancy/return-value/gas
// question is never asked. The fix is a generic re-framing directive, injected into the shared instruction
// (so it frames EVERY class, not just C8: reentrancy, return-value handling and gas assumptions all hang off
// who controls the callee), gated on a deterministic detector and made observable by the CALLEE-TRUST|
// sentinel below.
//
// The directive is deliberately GENERIC: it names no protocol, contract, function or role, so injecting it
// cannot leak a specific answer into a hunt — it changes which QUESTION the model asks, not what it is told.
//
// DETECTION is the same permissive, flat, whole-blob idiom zone-mapper.ag's #2121 C8 net uses (no AST, no
// CFG, so call-then-write ORDER and settability of the SPECIFIC target are never verified — only existence):
// a call surface AND a settable-target signal anywhere in the zone. False positives are cheap (a short block
// telling the model to check something that turns out to be immutable, plus its own explicit "if every call
// target here is genuinely immutable this does not apply" escape hatch); a false negative is the missed High
// this milestone exists to stop losing.
//
// COST — annotated, not asserted. Every net below is a SINGLE pass over the whole-zone `code` blob, run once
// per cell at top level (never per in-scope element — the per-element interpreted walk is the substrate trap
// this file already refuses twice). Bounded exactly like the #2121 net under the `cb 300000;` this file
// declares. A cell that FIRES additionally re-runs the three settable-target nets once, to count the signals
// for the sentinel's <n> field; a cell that does not fire never pays that.
// Substrate purity (#1587): builtins only (index_of / regex_find_all / regex_capture / reduce / len) — no new
// embedded interpreter, no new `exec sh` string.

// Low-level external-call / token-callback surface, verbatim from zone-mapper.ag::has_external_call_surface
// (agents are self-contained — there is no import, so the idiom is copied rather than shared).
fn has_low_level_call_surface(code: string) -> bool {
    if index_of(code, ".call{") >= 0 { return true; }
    if index_of(code, ".call(") >= 0 { return true; }
    if index_of(code, "safeTransfer(") >= 0 { return true; }
    if index_of(code, "safeTransferFrom(") >= 0 { return true; }
    return false;
}

// The interface-typed-call regex (Rust `regex` crate syntax), verbatim from zone-mapper.ag: `I<Name>(<args>)
// .method(` — an interface cast applied to an address expression, immediately followed by a call. Held in one
// helper because both the surface test and its per-match method extraction need the identical pattern.
fn interface_call_pattern() -> string {
    return "\\bI[A-Z][A-Za-z0-9_]*\\((?:[^()]|\\([^()]*\\))*\\)\\.([a-zA-Z_][A-Za-z0-9_]*)\\(";
}

// Denylist of view-idiom method names excluded from the interface-call surface (a plain balance/rate/metadata
// read through an interface cast is not, on its own, a callee-trust question). Kept identical to
// zone-mapper.ag::is_view_idiom_method so the two nets cannot drift apart.
fn is_view_idiom_method(name: string) -> bool {
    if name == "balanceOf" { return true; }
    if name == "allowance" { return true; }
    if name == "decimals" { return true; }
    if name == "totalSupply" { return true; }
    if name == "totalAssets" { return true; }
    if name == "convertToAssets" { return true; }
    if name == "convertToShares" { return true; }
    if name == "previewDeposit" { return true; }
    if name == "previewMint" { return true; }
    if name == "previewWithdraw" { return true; }
    if name == "previewRedeem" { return true; }
    if name == "getReserves" { return true; }
    if name == "latestRoundData" { return true; }
    if name == "latestAnswer" { return true; }
    if name == "getPrice" { return true; }
    if name == "name" { return true; }
    if name == "symbol" { return true; }
    if name == "owner" { return true; }
    if name == "paused" { return true; }
    return false;
}

// Does the payload contain an interface-typed call whose method is NOT a view idiom? `regex_find_all` collects
// every match and each match is re-run through `regex_capture` (group 1) for its own method name, since
// `regex_capture` only ever returns the FIRST capture over the string it is given. Short-circuit-on-true
// reduce, the same idiom the file's other folds use.
fn has_interface_call_surface(code: string) -> bool {
    let pat = interface_call_pattern();
    return reduce(regex_find_all(pat, code), |acc: bool, m: string| -> bool {
        if acc { return true; }
        if is_view_idiom_method(regex_capture(pat, m, 1)) { return false; }
        return true;
    }, false);
}

// The full call surface this directive cares about: low-level/token-callback OR interface-typed.
fn has_call_surface(code: string) -> bool {
    if has_low_level_call_surface(code) { return true; }
    return has_interface_call_surface(code);
}

// Signal 1 — an ADDRESS SETTER: `function set<Something>(address ...`. The canonical way a config/admin role
// repoints a call target.
fn address_setter_pattern() -> string {
    return "\\bfunction\\s+set[A-Za-z0-9_]*\\s*\\(\\s*address";
}

fn has_address_setter(code: string) -> bool {
    return len(regex_find_all(address_setter_pattern(), code)) > 0;
}

// Signal 2 — a MUTABLE `address` STATE VARIABLE: a line-leading `address [visibility] <name>;` declaration.
// `immutable`/`constant` declarations are excluded BY CONSTRUCTION rather than by a denylist: the pattern
// admits at most ONE keyword between `address` and the terminating `;`, so `address public immutable oracle;`
// and `address constant ORACLE = ...;` cannot match it, while `address public oracle;` does.
fn mutable_address_state_pattern() -> string {
    return "\\n[ \\t]*address(?:\\s+(?:public|internal|private))?\\s+[a-zA-Z_][A-Za-z0-9_]*\\s*;";
}

fn has_mutable_address_state(code: string) -> bool {
    return len(regex_find_all(mutable_address_state_pattern(), code)) > 0;
}

// Signal 3 — a COMPUTED call target: an interface cast whose argument is itself a CALL rather than a stored
// address (`IOracle(registry.getOracle()).poke()`, `IOracle(IKernel(k).getAssetOracle()).poke()`). The target
// is then whatever that external getter returns, i.e. settable wherever the getter's owner says it is.
fn computed_target_pattern() -> string {
    return "\\bI[A-Z][A-Za-z0-9_]*\\(\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*\\(";
}

// `address(...)`/`payable(...)` are plain type casts, not target resolution — denylisted the same way the
// view-idiom methods are, so `IOracle(address(x)).poke()` does not count as computed.
fn is_plain_cast_callee(name: string) -> bool {
    if name == "address" { return true; }
    if name == "payable" { return true; }
    return false;
}

fn has_computed_call_target(code: string) -> bool {
    let pat = computed_target_pattern();
    return reduce(regex_find_all(pat, code), |acc: bool, m: string| -> bool {
        if acc { return true; }
        if is_plain_cast_callee(regex_capture(pat, m, 1)) { return false; }
        return true;
    }, false);
}

// 0 for `false`, 1 for `true` — .ag has no bool->int coercion and no `let` reassignment.
fn signal_score(b: bool) -> int {
    if b { return 1; }
    return 0;
}

// How many of the three settable-target signals fired (0-3). This is the sentinel's <n> field: it makes the
// cell log say WHY the directive fired, not merely that it did.
fn settable_signal_count(code: string) -> int {
    return signal_score(has_address_setter(code))
         + signal_score(has_mutable_address_state(code))
         + signal_score(has_computed_call_target(code));
}

fn has_settable_target(code: string) -> bool {
    return settable_signal_count(code) > 0;
}

// The detector: a call surface AND a settable target. Nested, because .ag has no `&&`.
fn has_attacker_controlled_callee(code: string) -> bool {
    if !has_call_surface(code) { return false; }
    return has_settable_target(code);
}

// The one string the block is RECOGNISED by, so a reword of the directive cannot desync the sentinel gate
// below from the text it has to detect (same discipline as appendix_marker/anchoring_marker above).
fn callee_trust_marker() -> string {
    return "=== WHO CONTROLS THE CALL TARGET? ===";
}

// The directive itself. "" when the detector found nothing, so concatenating it into `instruction` is a no-op
// and an undetected zone's prompt is BYTE-IDENTICAL to the pre-#2145 one.
fn callee_trust_block(has: bool) -> string {
    if !has { return ""; }
    return callee_trust_marker() + "\n"
      + "This code makes at least one external call whose TARGET ADDRESS is not provably fixed: it is held in "
      + "a mutable state variable, written by a setter, or resolved at call time through another contract. For "
      + "EVERY external call you trace, ask WHO CONTROLS THE CALLEE, not only who is allowed to make the call.\n"
      + "Before applying the framing below, CLASSIFY the target's settability using the same positive-evidence "
      + "test #2179 already applies to callee-hosted PoC stubs: the target is ATTACKER-REPOINTABLE only when its "
      + "backing address is a mutable-declared state variable (not `immutable`/`constant`) AND is written by an "
      + "`external`/`public` setter carrying NO privilege signal — no `onlyX` modifier, no `msg.sender ==` / "
      + "`== msg.sender` check, no `hasRole(...)`, `_checkOwner`, `_checkRole`, `_authorizeUpgrade`, "
      + "`requiresAuth`, or `isAuthorized`. Everything else — an `immutable`/`constant` address, an "
      + "internal-only writer, or a setter guarded by any of the above — is ADMIN-UPGRADEABLE or unprovable, "
      + "even though the coarse signal that triggered this block (a call surface plus a settable-looking "
      + "target, checked without this per-callee reasoning) does not itself distinguish the two.\n"
      + "IF the target is ATTACKER-REPOINTABLE per the classification above, wherever a config/admin/deployer/"
      + "oracle/registry role can set or repoint that target (the variable is "
      + "not `immutable`/`constant`, a setter exists, or the address is read back from an external getter), "
      + "treat the CALLEE'S BEHAVIOUR as ATTACKER-CONTROLLED: it may reenter, revert, consume all forwarded "
      + "gas, or return arbitrary values. Judge CEI order, `nonReentrant` coverage, return-value validation "
      + "and gas bounds at that call site against a HOSTILE callee.\n"
      + "This stays IN SCOPE even though the SETTER is a trusted role: the exploit needs only the CALLEE to "
      + "misbehave, not the role to exceed its documented permissions — so \"a trusted role configured that "
      + "address\" is NOT a reason to dismiss the call site.\n"
      + "For any call you must treat as ATTACKER-CONTROLLED per the paragraph above, treat the callee as UNKNOWN "
      + "CODE: do NOT infer its behaviour from any implementation visible in this repository — an interface's "
      + "default body, a base contract, a mock, or a test — the code actually deployed at that address is bound "
      + "by none of it. Assume it may reenter any public/external entry point, revert, return arbitrary data, or "
      + "consume all forwarded gas, and check the caller's state at the exact moment control passes to it.\n"
      + "The controlling role's OTHER powers (pricing, pausing, fees, upgrades, or anything else it is "
      + "documented to do) are NOT a reason to drop the vector — rate the call-site vector on its own "
      + "consequence (what state is left inconsistent while the callee runs), report it as a CANDIDATE with "
      + "that severity, and note the role precondition. Only dismiss it when the caller's state is PROVABLY "
      + "consistent at the call (CEI order holds, a reentrancy guard covers every entry point the callee could "
      + "reenter, its return value is unused, its gas cost is bounded) — a role's other authority, or what it "
      + "already controls, is never itself that proof.\n"
      + "IF the target is ADMIN-UPGRADEABLE or unprovable per the classification above, do NOT assume hostile "
      + "callee behaviour by default — a governance/owner/role upgrade path is not itself an attacker "
      + "capability. Emit that call site as `dismissed: <the specific guard or immutability you found>` rather "
      + "than a hostile-callee CANDIDATE.\n"
      + "When this directive fires, before your final verdict, emit one line for every call site you examined "
      + "under it: `CALLEE-VECTOR|<fn>|<callee-expr>|<reentrant|return-value|gas>|<CANDIDATE|dismissed: reason>` "
      + "— <fn> the function containing the call, <callee-expr> the call expression as written, the third field "
      + "the hazard you assessed (emit a separate line per hazard if more than one applies), the last field "
      + "CANDIDATE or dismissed: <the specific state-consistency reason> — never a role-power or "
      + "in-repo-implementation reason for an ATTACKER-REPOINTABLE call site, which this directive forbids (the "
      + "ADMIN-UPGRADEABLE `dismissed: <guard/immutability>` reason above is a classification, not a "
      + "role-trust excuse, and remains the correct dismissal for that branch).\n"
      + "Do NOT invent a callee, and do NOT report a settable target as a finding by itself: if every call "
      + "target in this code is genuinely immutable or hardcoded, this directive simply does not apply.\n\n";
}

// #2157 D3 A/B toggle: the CALLEE-TRUST directive (#2145) is normally injected unconditionally, so its
// contribution to rare-recall cannot be measured against a clean control. `CALLEE_TRUST=0` forces the
// directive off even where the settable-callee detector fires, giving the D3 A/B an OFF arm. Any other
// value (or the env unset — the default) leaves the directive ON, so the assembled prompt is
// BYTE-IDENTICAL to the pre-#2157 pipeline whenever the env is absent.
fn callee_trust_enabled() -> bool {
    return getenv("CALLEE_TRUST") != "0";
}

// The directive as it enters the prompt: "" when the toggle is off (control arm) OR the detector found no
// settable callee, else the full #2145 block. Concatenating "" is a no-op, so an OFF arm's prompt matches
// the immutable-callee case byte-for-byte and the sentinel gate below auto-suppresses (empty directive).
fn callee_directive(code: string) -> string {
    if !callee_trust_enabled() { return ""; }
    return callee_trust_block(has_attacker_controlled_callee(code));
}

// --- #2214 PR C: CONFIG-REALIZABILITY DISMISSAL RULE (GENERAL — deliberately NOT lens-gated) ----------------
// The measured gap (#2214 M3, five arm-runs on the frozen base): the hunter FOUND the rare bug, named its
// consequence correctly ("the error grows permissionlessly as yield accrues"), and then threw it away — "a
// valid configuration exists", "a trusted deployer picks that pairing", "an external attacker cannot flip the
// flag" => OUT OF SCOPE — five times across three arms, WITHOUT ever checking whether the audited repository
// itself ships that configuration. It did: the repo's own deployment/test setup wires the unsafe pairing,
// which is exactly why the contest accepted the row as High. The gap is neither routing nor follow-through
// (both closed) but DISMISSAL DISCIPLINE, so the fix is a rule about what a dismissal must have done first.
//
// PLACEMENT DECISION: this rule rides the shared RULES block on EVERY cell, lens ON or OFF. The dismissal was
// measured in arms where OPERATIONALIZE_LENS was UNSET (the `routed` r1/r2 cells dismissed it with no lens at
// all), so a lens-gated rule could not reach the cells that produced the miss. The price is an honest,
// MEASURED prompt-byte delta on every cell — demo-operationalize-lens.sh prints it (RULELEN) and asserts it is
// non-zero — not a silent prompt change. The #2211 lens keeps its own byte-identity contract untouched:
// operationalize_directive() is still exactly "" when the flag is off.
//
// The text is PURE-META (no protocol, contract, function, flag, unit or product name), like every other
// directive here: it changes which QUESTION the cell must answer before it may dismiss, and cannot leak an
// answer into a hunt on a held-out target.
fn config_realizability_rule() -> string {
    return "CONFIGURATION REALIZABILITY (this governs every dismissal on configuration grounds). The audited "
      + "repository's OWN configuration is part of the audit. Before you dismiss a check or a lead because "
      + "\"a valid configuration exists\", \"the deployer would not set that\", \"a trusted role sets this\" or "
      + "\"that pairing is a deploy-time choice\", you MUST: (a) search THIS repository — deployment scripts, "
      + "tests, fixtures, example configs and documentation — for the value it actually configures for every "
      + "flag, address, source or parameter the check involves; and (b) check whether the constructor or the "
      + "setter VALIDATES that pairing at all. Then apply the rule: a pairing this repository itself ships, "
      + "documents, or accepts WITHOUT validation is IN SCOPE — a mismatch the code invites is a finding, not "
      + "somebody else's misconfiguration. Only a pairing the code itself rejects, and that nothing in the "
      + "repository sets, may be dismissed on configuration grounds. Every such dismissal MUST cite the "
      + "file:line you checked (the deployment or test line that sets the value, or the validating check in "
      + "the constructor/setter). A configuration-grounds dismissal with NO file:line citation is not a "
      + "result: record the check as UNRESOLVED and state what you could not verify.\n";
}

// --- #2245 iteration 2: CONTEST-SEVERITY DISMISSAL RUBRIC (opt-in, default OFF) ------------------------------
// The measured gap (iteration 1, three runs on the frozen base): the class net closed the GENERATION gap —
// 3 of 3 runs reached the ground-truth mechanism and wrote it out — and 0 of 3 KEPT it. All three losses
// applied ONE criterion at two different decision points, the hunter's SAFE and the refute gate's REFUTED:
// "no unprivileged attacker gain and no funds locked => not a bug". The contest's own rubric accepted every
// one of those rows as Medium (core functionality broken, or value misaccounted, under a state the protocol's
// OWN validation admits — attacker-free, alternative-path-irrelevant). So iteration 2 changes neither routing
// nor generation: it installs the SEVERITY rubric at both decision points, with a CLOSED list of dismissal
// grounds and a structured output line the harness can gate on.
//
// WHY AN OUTPUT CONTRACT AND NOT A NUDGE: #2213 measured Delta=+0 for a prompt directive with no gate. What
// did work on this pipeline is the #2214/#2223 shape — an emission contract, a deterministic OUTPUT gate, a
// named re-ask. So the rubric ships with `DISMISS|` (below), run-discovery.sh's ground gate, and — when a
// second dismissal still stands on an insufficient ground — PROMOTION of the lead to a tier-1 `Medium`
// candidate, which the refute gate and the PoC gate then still have to agree with.
//
// Default OFF, same INVERTED polarity as OPERATIONALIZE_LENS ("1" opts in, everything else is off): this is an
// UNMEASURED recall-capability change and #2191 proved a mechanically perfect lens can still score Delta=+0.
// Unset => the directive is "" => the assembled prompt is BYTE-IDENTICAL to the pre-#2245 one. The knob is
// deliberately INDEPENDENT of OPERATIONALIZE_LENS (issue #2245 STOP-1 decision 3): the measured dismissals
// happened in lens-OFF cells too, and coupling the two would make the arm a two-variable experiment.
//
// The text is PURE-META — no protocol, contract, function, token, unit or product name — like every other
// directive in this file, so injecting it on a held-out target cannot leak an answer into the hunt.
//
// SPLICE POINT: the shared RULES block, immediately AFTER config_realizability_rule(). The rule two lines
// above it ("a trusted role acting WITHIN its documented permissions is OUT OF SCOPE") is exactly what the
// measured dismissals hid behind, so the rubric that QUALIFIES it has to be read after it; and it extends the
// same dismissal-discipline rule config_realizability_rule() states for configuration grounds.

// The one string the block is RECOGNISED by (same discipline as operationalize_marker/external_resolve_marker):
// it is the block's literal FIRST LINE, and the sentinel greps the ASSEMBLED instruction for it, so a marker
// that is not a substring of what renders disables the sentinel loudly rather than silently claiming an
// injection that never happened.
fn severity_rubric_marker() -> string {
    return "=== SEVERITY RUBRIC FOR A DISMISSAL (this governs when \"not a bug\" is a valid answer) ===";
}

// The rubric + the CLOSED ground list. This block is the ONE source string the two gates share: refuter.ag
// carries a severity_rubric_block() whose body is BYTE-IDENTICAL to this one, and demo-severity-rubric.sh
// diffs the two so the hunter's standard and the refute gate's standard cannot drift apart. The per-agent
// EMISSION contracts differ (this side writes `DISMISS|`, the gate side writes `REFUTE-GROUND|`) and therefore
// live OUTSIDE this function — dismiss_rule() here, ground_rule() there — so the shared half stays diffable.
// Do not edit one copy: edit both, in the same commit, or the demo fails.
fn severity_rubric_block() -> string {
    return severity_rubric_marker() + "\n"
      + "Medium is NOT reserved for a bug an unprivileged attacker profits from. THREE ATTACKER-FREE SHAPES "
      + "ARE Medium, and dismissing one of them because nobody gains is a false negative:\n"
      + "  (a) VALID-INPUT LIVENESS LOSS — a documented user path reverts, or is otherwise unavailable, under "
      + "a state or configuration the protocol's OWN validation admits. An admin/owner action INSIDE the range "
      + "its own setter accepts is a VALID INPUT, not a \"trusted admin misconfiguration\": the question is "
      + "what the code ADMITS, never who typed it.\n"
      + "  (b) ATTACKER-FREE MISACCOUNTING — value is stranded, misattributed, or emitted to nobody under a "
      + "state the code admits. A BOUNDED loss still counts; \"only dust\" is a number you must PRODUCE, not "
      + "an adjective you may assert.\n"
      + "  (c) ALTERNATIVE-PATH RULE — the existence of another path does NOT cancel the loss on the broken "
      + "one unless that alternative is EQUIVALENT IN COST AND IN TIME. A slower, more expensive or "
      + "differently-taxed route is a loss, not a remedy.\n"
      + "CLOSED GROUND LIST. Every dismissal names exactly ONE ground id from this list, and nothing outside "
      + "it counts.\n"
      + "  INSUFFICIENT — each of these is insufficient ALONE, and ANY UNION of them is STILL insufficient "
      + "(stacking three weak grounds does not build one strong one):\n"
      + "    no-attacker        no unprivileged attacker gains anything.\n"
      + "    trusted-config     a privileged role, a deploy-time choice or an admin action reaches the state.\n"
      + "    alt-path           some other path still works.\n"
      + "    dust-unquantified  the loss is \"small\", \"dust\" or \"negligible\" with no numbers.\n"
      + "  SUFFICIENT — each one stands ONLY with the evidence named next to it, in the same line:\n"
      + "    guard                 cite the file:line of the guard that provably stops the path.\n"
      + "    unreachable           cite the constructor/setter line that VALIDATES the state away.\n"
      + "    no-loss               cite the path and its ZERO delta (nothing is lost, nobody waits).\n"
      + "    known-issue           cite the brief line that already lists it.\n"
      + "    immaterial-quantified quantify the loss from THIS payload's own numbers, numbers included.\n"
      + "A missing, empty or unrecognised ground id counts as INSUFFICIENT.\n";
}

// The EMISSION contract for this side of the gate. Kept out of severity_rubric_block() so the shared rubric
// stays byte-diffable against refuter.ag (see above). Vocabulary note: neither `DISMISS|` nor any ground id
// contains the substring `CANDIDATE|`, so lib/run-agent-validated.sh's hunter predicate cannot false-accept a
// cell that never reached a terminal verdict on one of these lines, and run-discovery.sh treats `DISMISS|` as
// a record BOUNDARY so it can never be glued onto a PTY-wrapped CANDIDATE| record.
fn dismiss_rule() -> string {
    return "RECORD EVERY DISMISSAL. For each lead you matched to this class's pattern and then did NOT report, "
      + "write ONE line of its own BEFORE your terminal verdict (before any CANDIDATE| line and before the "
      + "SAFE token):\n"
      + "DISMISS|<file:function[:line]>|<ground-id>|<the evidence that ground requires>\n"
      + "One line per dismissed lead; the ground id is copied VERBATIM from the closed list above. A lead you "
      + "dismissed without this line is a lead you did not record, and an unrecorded dismissal is not a "
      + "result. Writing a DISMISS line is never itself a finding, and it never substitutes for a report: if "
      + "the lead qualifies under (a), (b) or (c) above, the answer is a CANDIDATE line, not a dismissal.\n\n";
}

// The opt-in. INVERTED like operationalize_enabled() (`== "1"`) ON PURPOSE: only the literal "1" opts in, so
// unset / any other value is OFF and is the DEFAULT. Do not "fix" this into consistency with CALLEE_TRUST —
// shipping an unmeasured dismissal rubric default-ON is exactly the #2191 mistake the polarity exists to
// avoid. The knob must also ride run-discovery.sh's exec.env_passthrough, else getenv() reads the SANITISED
// env and the whole feature is silently inert (the #1426/#2157 failure mode).
fn severity_rubric_enabled() -> bool {
    return getenv("SEVERITY_RUBRIC") == "1";
}

// The directive as it enters the prompt: "" unless the knob opts in. Concatenating "" is a no-op, so a default
// cell's instruction matches the pre-#2245 one byte for byte and the honesty-gated sentinel below
// auto-suppresses, because an empty directive carries no marker. O(1) top-level string concat — no regex, no
// reduce, no exec sh, so this adds no per-element substrate cost to any cell, firing or not.
// #2245 iteration 3: ground_evidence_directive() rides INSIDE this gate and is "" unless its own knob opts in
// too, so SEVERITY_RUBRIC=1 alone still renders exactly the iteration-2 string, byte for byte.
fn severity_rubric_directive() -> string {
    if !severity_rubric_enabled() { return ""; }
    return severity_rubric_block() + ground_evidence_directive() + dismiss_rule() + dismiss_reask_block();
}

// The GROUND RE-ASK addressing (empty on every first attempt), the exact twin of trace_reask_block() above.
// run-discovery.sh's ground gate re-asks a cell that dismissed a lead on a ground the closed list treats as
// insufficient, and names the open locations here. DISMISS_REASK_GROUNDS is set by the shell ONLY on such a
// re-ask (and only inside a rubric-ON cell), so this block is "" on every first attempt and the assembled
// prompt is unchanged there; it lives INSIDE the rubric directive, so the rubric-OFF prompt keeps its
// byte-identity contract whatever the env holds. Pure-meta like every other directive here: it names the
// locations the cell itself wrote down and the ground ids it used, never any content of its own.
fn dismiss_reask_block() -> string {
    let open = getenv("DISMISS_REASK_GROUNDS");
    if open == "" { return ""; }
    return "RE-ASK — your previous answer for this cell dismissed these leads on a ground the closed list "
      + "above treats as INSUFFICIENT: " + open + ". Take each of them again, and for EACH either name a "
      + "SUFFICIENT ground WITH the evidence that ground requires, or apply the rubric and report the lead as "
      + "a CANDIDATE. Re-stating the same insufficient ground answers nothing, and adding more insufficient "
      + "grounds to it answers less; do not drop a listed location from your reply.\n"
      + ground_evidence_reask_clause()
      + "\n";
}

// --- #2245 iteration 3: THE PER-GROUND EVIDENCE CONTRACT (opt-in, default OFF) -------------------------------
// The measured gap (iteration 2, four runs on the frozen bases): the rubric WORKS where it is applied honestly
// — the held-out row went 0/2 -> 2/2 on this side — and all three remaining losses have ONE shape: a SUFFICIENT
// ground id attached to evidence that does not establish that ground's definition. Two of them happened HERE
// (an accrual "emitted to nobody" dismissed `no-loss` with no zero delta, and a correct on-chain read of the
// DEPLOYED configuration dismissed `no-loss` although the code ADMITS every other configuration). The shipped
// gate checks the ground ID; nothing checked the evidence. So iteration 3 changes neither the rubric text nor
// the routing nor the generation: it adds the per-ground EVIDENCE contract below, and the driver checks the
// emitted line against it on the same OUTPUT gate.
//
// severity_rubric_block() stays FROZEN — not one byte changes — so the iteration-2 arm stays reproducible and
// the two arms stay comparable. Every new sentence, including ADMITTED IS NOT DEPLOYED, lives here.
//
// SPLICE POINT: inside severity_rubric_directive(), between the rubric and the emission contract — the reader
// meets the closed ground list, then what each of those grounds actually costs, then how to write the line.
// The one string the block is RECOGNISED by (same discipline as severity_rubric_marker above): it is the
// block's literal FIRST LINE, and the sentinel greps the ASSEMBLED instruction for it, so a marker that is
// not a substring of what renders disables the sentinel loudly rather than silently claiming a contract that
// never entered the prompt.
fn ground_evidence_marker() -> string {
    return "=== EVIDENCE CONTRACT PER GROUND (a ground id is a claim; this is what proves it) ===";
}

// The per-ground EVIDENCE contract. BYTE-IDENTICAL in hunter.ag and refuter.ag — one standard, two decision
// points, and demo-severity-rubric.sh diffs the two functions so they cannot drift apart. Do not edit one
// copy: edit both, in the same commit, or the demo fails.
//
// It names the machine-findable tokens VERBATIM (`delta=0:`, `loss=`) because the drivers decide on exactly
// those tokens: a contract the model was never shown could not be met, and a driver requirement that is not
// in this text is a requirement nobody was given. The demo pins both directions.
//
// PURE-META like every other directive here: no protocol, contract, function, token, unit or product name, so
// injecting it on a held-out target cannot leak an answer.
fn ground_evidence_block() -> string {
    return ground_evidence_marker() + "\n"
      + "A ground id is a CLAIM; the evidence on the SAME line is what makes it true. Each sufficient ground "
      + "has exactly ONE contract, below. A line that names a sufficient ground without meeting that ground's "
      + "contract is read as INSUFFICIENT — the same answer as naming no ground at all.\n"
      + "  guard                 cite path:line (or path:first-last) of the check that stops the path, in code "
      + "you were given. The cited text must BE the check: a conditional, a require/revert/assert, an access "
      + "modifier.\n"
      + "  unreachable           cite the path:line that VALIDATES the state away — a rejecting check in a "
      + "constructor, an initializer or a setter. A deployment script, a migration, or the value some "
      + "deployment happens to hold, is NOT a validation: it shows what was CHOSEN, never what is REFUSED.\n"
      + "  no-loss               cite the path AND write the literal token delta=0:<the quantity that is "
      + "unchanged>. \"That state never occurs\" is NOT this ground — that claim is unreachable, and it needs "
      + "unreachable's citation. A reachability argument filed as no-loss is an insufficient dismissal.\n"
      + "  known-issue           quote the brief's own line VERBATIM, inside quotes, at least a dozen "
      + "characters of it.\n"
      + "  immaterial-quantified write the literal token loss=<amount> <unit>, and compare it in the SAME "
      + "units with a second number taken from this payload (\"... of ...\", \"... out of ...\", \"... vs "
      + "...\"). A ratio of internal counters is not a loss amount.\n"
      + "ADMITTED IS NOT DEPLOYED. A read of a live deployment, a deploy-time value, or \"as shipped today\", "
      + "establishes the DEPLOYED state only — and every ground above asks what the code ADMITS. So a "
      + "dismissal resting on deployed state closes NOTHING unless the SAME line also cites the validating "
      + "line that rejects every OTHER admitted state. \"As deployed\" is not \"admitted\".\n";
}

// The opt-in, same INVERTED polarity as severity_rubric_enabled(): only the literal "1" opts in, so unset /
// any other value is OFF and is the DEFAULT. This knob is INDEPENDENT of SEVERITY_RUBRIC and NOT a value mode
// of it (issue #2245 iteration-3 STOP-1 decision 1): a `SEVERITY_RUBRIC=2` sub-mode would have to loosen
// severity_rubric_enabled()'s `== "1"` test, which would silently disable the WHOLE rubric for an operator who
// set `2` against an older checkout — and it would make the iteration-2 arm unreproducible byte-for-byte.
// Two knobs, one delta per arm. It must also ride the driver's exec.env_passthrough, else getenv() reads the
// SANITISED env and the contract is silently inert (the #1426/#2157 failure mode).
fn ground_evidence_enabled() -> bool {
    return getenv("GROUND_EVIDENCE") == "1";
}

// The contract as it enters the rubric directive: "" unless the knob opts in. It is concatenated INSIDE
// severity_rubric_directive(), so it can only ever reach a rubric-ON cell — the contracts are defined against
// the rubric's own ground list, and GROUND_EVIDENCE=1 with the rubric off is inert by construction (no block,
// no marker, no sentinel, no shell layer).
fn ground_evidence_directive() -> string {
    if !ground_evidence_enabled() { return ""; }
    return ground_evidence_block();
}

// The second RE-ASK sentence, gated on the SAME knob so the iteration-2 re-ask text is byte-identical with the
// contract off. The driver names the failing ground as `<ground>: <what is missing>`, so this sentence only has
// to say that such a line is insufficient too.
fn ground_evidence_reask_clause() -> string {
    if !ground_evidence_enabled() { return ""; }
    return "A line whose ground id is sufficient but whose EVIDENCE does not meet that ground's contract above "
      + "is insufficient in exactly the same way; where the list names a ground it also names what is missing "
      + "from it, and repeating the line without that evidence answers nothing.\n";
}

// --- #2245 iteration 5: OUTPUT-GATED PARAMETER AUDIT (opt-in, default OFF) ---------------------------------
// The measured gap (iteration 4, on the frozen bases): the cell REACHED the function that admits the value and
// never listed that function's arguments — it ruled the function out on other grounds, and the lead that lived in
// one of its arguments was never written down. Per-shape class text did not change that, and a
// pure-meta "check where every argument is bounded" paragraph with no gate is the #2213 shape (Delta=+0). So this
// iteration gives GENERATION the mechanism that worked on the dismissal side: an emission contract (one
// `PARAM|#k|...` line per admitted value, answered by one `PARAM-TRACE|#k|...` line under the same number), a
// deterministic OUTPUT gate in run-discovery.sh, one named re-ask, and — inside a rubric-ON cell — promotion of an
// `unbounded` answer that got neither a CANDIDATE nor a DISMISS naming the parameter. The judges downstream are
// the EXISTING ones (the rubric + evidence gate, the refute gate, the PoC gate); nothing here judges a lead.
//
// WHY `PARAM-TRACE|` AND NOT `TRACE|`: with OPERATIONALIZE_LENS=1 on too, a shared `#k` namespace would collide
// with the #2223 OPCHECK pairing, and four shipped `TRACE|` consumers would silently change meaning. A separate
// token keeps the two knobs independent by construction (issue #2245 iteration-5 STOP-1 decision 2).
// None of `PARAM|`, `PARAM-TRACE|` or `PARAM-AUDIT|` contains `CANDIDATE|`, `SAFE` or `VERDICT|`, so
// lib/run-agent-validated.sh's hunter predicate cannot false-accept a cell on one of them.
//
// Default OFF, the same INVERTED polarity as every #2245 knob ("1" opts in, everything else is off), and
// INDEPENDENT of SEVERITY_RUBRIC / GROUND_EVIDENCE / OPERATIONALIZE_LENS: PARAM_AUDIT=1 alone renders the
// enumeration contract; only the LEAD rule (param_lead_rule) needs the rubric, because it points at the DISMISS
// grammar — the GROUND_EVIDENCE precedent of a second half that works only inside a rubric-ON cell.
//
// SPLICE POINT: directly after `+ rubric` in the shared RULES block (the lead rule refers to the DISMISS grammar
// just read) and before `+ extres` (so one resolved citation stays usable by both). PURE-META like every other
// directive here: no protocol, contract, function, unit, product or domain noun.

// The one string the block is RECOGNISED by (same discipline as severity_rubric_marker): it is the block's
// literal FIRST LINE, and the sentinel greps the ASSEMBLED instruction for it.
fn param_audit_marker() -> string {
    return "=== PARAMETER AUDIT (where is each admitted value bounded?) ===";
}

// The per-cell cap on audited parameter numbers. A CONSTANT, not a knob (a knob would be a second variable in
// the arm): run-discovery.sh's _param_audit_cap prints the same number, and demo-param-audit.sh pins the two equal.
fn param_audit_cap() -> int {
    return 20;
}

// The enumeration + answer contract. The bound rule is stated in words the driver checks mechanically
// (_param_bound_ok): the cited range must CHECK the value AND NAME the parameter, a role check never bounds, and
// a deployment script or a deployed value bounds nothing. demo-param-audit.sh pins _param_requirement's re-ask
// phrases against this text in both directions, so the driver can never ask for something this text never said.
fn param_audit_block() -> string {
    return param_audit_marker() + "\n"
      + "Before your terminal verdict, audit the VALUES this zone admits. Scope: every function you examine that "
      + "makes a non-view external call or writes storage. For every argument of such a call or write, name "
      + "where the value comes from:\n"
      + "  caller   an argument of an externally callable function.\n"
      + "  role     an argument of a role-gated function.\n"
      + "  config   storage written by a setter, a constructor or an initializer.\n"
      + "  derived  computed in this function from any of the above.\n"
      + "Constants, immutables, msg.sender and address(this) are out of scope.\n"
      + "Write one line per such value, NUMBERING them #1, #2, #3 ... in the order you list them:\n"
      + "PARAM|#<k>|<file:function>|<parameter as written>|<caller or role or config or derived>\n"
      + "<file:function> is the function you EXAMINED — the one you would name in a CANDIDATE or DISMISS "
      + "line — even when the call or write itself sits in an internal helper that function reaches.\n"
      + "Then answer EVERY number with one line of its own that carries the SAME number, in exactly one of two "
      + "forms:\n"
      + "PARAM-TRACE|#<k>|bounded-at:<path>:<line>[-<line>]|<the check at that line>\n"
      + "PARAM-TRACE|#<k>|unbounded|<the call or write that consumes it, and what an out-of-range value does "
      + "there>\n"
      + "The number is how an answer is matched to its parameter: an answer carrying the wrong number, or no "
      + "number, answers NOTHING. Number every parameter, answer every number, and never renumber between the "
      + "two lists. The third field is literally bounded-at:<path>:<line> or unbounded; anything else answers "
      + "nothing.\n"
      + "WHAT BOUNDS A VALUE. bounded-at must cite the path:line (or path:first-last) of the check, in code you "
      + "were given, and the cited text must both CHECK the value — a require/revert/assert, a conditional, a "
      + "min/max/clamp, an allowlist or validity lookup, or a modifier called with that value — and NAME the "
      + "parameter. Access control limits WHO calls, never WHAT value is passed: a role check does not bound an "
      + "argument. A deployment script, or a deployed value, bounds nothing — the question is what the code "
      + "ADMITS.\n"
      + "CAP. List at most " + to_string(param_audit_cap()) + " parameters in this cell: arguments of non-view "
      + "external calls first, then values written to storage, within the functions you examine. Numbers above "
      + to_string(param_audit_cap()) + " are not audited.\n"
      + "An audit line is never itself a finding: unbounded says where to look, not that there is a bug.\n";
}

// The LEAD rule — rendered ONLY inside a rubric-ON cell, because it points at the DISMISS grammar and the closed
// ground list above it (the ground_evidence_reask_clause() pattern: a knob-gated sentence that is "" otherwise).
// It deliberately does not mention the shell promotion: the model is told what it owes, not what happens if it
// does not pay.
fn param_lead_rule() -> string {
    if !severity_rubric_enabled() { return ""; }
    return "LEADS FROM THE AUDIT. Every value you answered unbounded is a LEAD, and it is judged by the severity "
      + "rubric above: either report it as a CANDIDATE line, or write a DISMISS line at that same function whose "
      + "evidence NAMES the parameter (or its #<k>). An unbounded value left with neither line is an unrecorded "
      + "lead, and an unrecorded lead is not a result.\n";
}

// The opt-in. INVERTED like severity_rubric_enabled() (`== "1"`) ON PURPOSE: unset / any other value is OFF and is
// the DEFAULT. It must also ride run-discovery.sh's exec.env_passthrough, else getenv() reads the SANITISED env and
// the whole feature is silently inert (the #1426/#2157 failure mode).
fn param_audit_enabled() -> bool {
    return getenv("PARAM_AUDIT") == "1";
}

// The PARAM RE-ASK addressing (empty on every first attempt), the twin of dismiss_reask_block(). PARAM_REASK_ITEMS
// is set by the shell ONLY on a parameter re-ask, so this block is "" on every first attempt; it lives INSIDE the
// gated directive, so the knob-OFF prompt keeps its byte-identity contract whatever the env holds. It names only
// what the cell itself wrote (plus function names from its own slice), never any content of its own.
fn param_reask_block() -> string {
    let items = getenv("PARAM_REASK_ITEMS");
    if items == "" { return ""; }
    return "RE-ASK — your previous answer for this cell left the parameter audit open: " + items + ". Take each "
      + "listed item again: write PARAM lines for every function listed as uncovered or given, answer every "
      + "listed number with one PARAM-TRACE line under the SAME number, re-cite a bound that meets the "
      + "requirement named beside it or answer it unbounded, and give every open lead a CANDIDATE line or a "
      + "DISMISS line that names the parameter. Keep your numbering, and do not drop the items you already "
      + "settled.\n";
}

// The directive as it enters the prompt: "" unless the knob opts in. Concatenating "" is a no-op, so a default
// cell's instruction matches the pre-iteration-5 one byte for byte and the honesty-gated sentinel auto-suppresses.
// O(1) top-level string concat — no regex, no reduce, no exec sh.
fn param_audit_directive() -> string {
    if !param_audit_enabled() { return ""; }
    return param_audit_block() + param_lead_rule() + param_reask_block() + "\n";
}

// --- #2235 READ THE EXTERNAL PROTOCOL (PR B — opt-in, default OFF) -------------------------------------------
// The measured gap the #2214/#2227 citation rules exposed: a cell whose verdict turns on how ANOTHER protocol
// behaves ("that rate is 1e18-scaled", "that wrapper is 1:1") has two honest moves and no third — confabulate
// a citation, or answer UNRESOLVED. Neither finds the bug. This directive adds the missing third move: the
// cell can RESOLVE the external symbol to source it can actually read, and then cite the `path:line` it read.
//
// Shape: the directive is a VERB, not knowledge. It states that the resolver exists, its INPUT CONTRACT (a
// symbol or an address — never a URL, never free text), its one-line output grammar, the per-cell budget, and
// how a resolved fact is cited. It names no protocol, contract, function, unit or product, so injecting it on
// a held-out target cannot leak an answer — the same overfitting discipline as config_realizability_rule().
//
// GATE: EXTERNAL_RESOLVER being non-empty, and nothing else. Deliberately INDEPENDENT of OPERATIONALIZE_LENS
// (issue #2235 STOP-1 decision 2): the dismissals this closes were measured in lens-OFF arms too, so a
// lens-gated verb could not reach the cells that produced the miss. Empty env => "" => the assembled prompt
// is BYTE-IDENTICAL to the pre-#2235 one, exactly like operationalize_directive()/callee_directive().
//
// SPLICE POINT: the shared RULES block, immediately after config_realizability_rule(), so one resolved
// citation can discharge BOTH rule 1 (a dismissal on configuration grounds) and rule 2 (a CLEAN resting on an
// external fact) — the two rules that otherwise leave a cell no move at all.

// The one string the block is RECOGNISED by (same discipline as operationalize_marker/callee_trust_marker):
// it is the block's literal FIRST LINE, and the sentinel greps the ASSEMBLED instruction for it, so a marker
// that is not a substring of what renders disables the sentinel loudly rather than silently lying.
fn external_resolve_marker() -> string {
    return "=== READ THE EXTERNAL PROTOCOL (a tool you have, not a fact you remember) ===";
}

// The directive text. Every path in it is passed in, so the model never has to invent one — an invented cache
// path is exactly the "citation laundering" the harness gate refuses. O(1) top-level concat: no regex, no
// reduce, no exec sh, so a cell pays nothing for it whether it fires or not.
//
// The command names `bash` EXPLICITLY, never `sh`: resolve-external.sh is bash-only (`set -o pipefail`,
// herestrings), and on a host whose /bin/sh is dash — which is what CI runs — an `sh` invocation exits 2 with
// NO output, which a cell reads as "the tool is broken" instead of "the symbol did not resolve". Naming the
// interpreter removes the dependency on whatever /bin/sh happens to be. demo-resolve-cell.sh pins it.
fn external_resolve_block(resolver: string, repo: string, cache: string, state: string, budget: string) -> string {
    return external_resolve_marker() + "\n"
      + "A claim about how something OUTSIDE this payload behaves is a fact you can now GO AND READ. There is a "
      + "deterministic resolver on disk — no model, no search — that turns the NAME of an externally declared "
      + "contract, interface or library into source you can open. Run it with Bash, exactly like this:\n"
      + "    bash " + resolver + " --symbol <Name> --repo " + repo + " --cache-dir " + cache
      + " --budget-state " + state + "\n"
      + "`<Name>` is a Solidity identifier, optionally `Name.function` — a contract/interface/library name that "
      + "appears in this payload's imports, inheritance or call sites. It takes NOTHING else: no URL, no host, "
      + "no path, no free text (those are rejected). It prints exactly one line:\n"
      + "EXTERNAL|<symbol>|<vendored|sourcify|upstream>|<path>:<line>|<sha256>\n"
      + "EXTERNAL|<symbol>|unresolved|<reason>\n"
      + "On a resolved line, OPEN that file and READ around that line — the line number is where the "
      + "declaration starts, the fact you need is usually in the doc comment or the body just below it. On an "
      + "`unresolved` line the fact remains unverified; do not guess what the source would have said.\n"
      + "BUDGET: at most " + budget + " resolutions in this cell, so spend them only on facts a VERDICT turns "
      + "on — the scaling, decimals, normalisation, rounding, ordering or return-value guarantee a check "
      + "depends on. Resolving a symbol you are merely curious about wastes a slot you will need later.\n"
      + "CITING WHAT YOU READ: when a verdict rests on text you resolved this way, cite the path and line you "
      + "actually read, on the trace line for that check:\n"
      + "TRACE|#<k>|CLEAN|EXTERNAL-CITED <path>:<line> — <the exact property those lines state>\n"
      + "A range (`<path>:<line>-<line>`) is fine. The citation is RE-OPENED and read back: the file must "
      + "exist under the repository or the resolver's cache, and the lines you cite must LITERALLY state the "
      + "property you are relying on. A path you did not get from the resolver, or a range that merely names "
      + "the file, counts as no citation at all — that check is then recorded as unanswered, which is strictly "
      + "worse than an honest UNRESOLVED. An external claim you did not resolve and cite is UNRESOLVED, never "
      + "CLEAN.\n";
}

// The toggle + the assembled directive: "" unless the shell handed this cell a resolver path. The budget is
// quoted into the text from the same env the shell enforces it with, so the number the model is told and the
// number the resolver enforces cannot drift; "5" is the resolver's own documented default.
fn external_resolve_directive() -> string {
    let resolver = getenv("EXTERNAL_RESOLVER");
    if resolver == "" { return ""; }
    let budget = getenv("EXTERNAL_BUDGET");
    if budget == "" { return external_resolve_block(resolver, getenv("TARGET_DIR"), getenv("EXTERNAL_CACHE"),
        getenv("EXTERNAL_BUDGET_STATE"), "5"); }
    return external_resolve_block(resolver, getenv("TARGET_DIR"), getenv("EXTERNAL_CACHE"),
        getenv("EXTERNAL_BUDGET_STATE"), budget);
}

// ---------------------------------------------------------------------------------------------------------
// #2235 PR C — THE ON-CHAIN FACT CHECK (the second verb)
// ---------------------------------------------------------------------------------------------------------
// The resolver above answers "what does the external SOURCE say". A second class of dismissal turns on
// DEPLOYED STATE instead — a configured cap, a role holder, a current rate — which no source file settles and
// no model can remember. onchain-fact.sh reads it with one bounded call and writes the RESULT into the same
// cache, so a citation of that value is re-openable from disk by the harness.
//
// Same discipline as the resolver: a VERB, not knowledge; pure-meta (no protocol, product, token or unit);
// gated on ONE env var, so an OFF cell's prompt is byte-identical. The ENDPOINT is never in this text — the
// tool reads the operator's own configuration, and with none configured it answers `unavailable|no-rpc`,
// which is an honest null a check may NOT be closed on (issue #2235 STOP-1 decision 4).
fn onchain_fact_marker() -> string {
    return "=== CHECK AN ON-CHAIN VALUE (a call you can make, not a number you remember) ===";
}

// The directive text. Every path and bound is passed in for the same reason the resolver's are: a value the
// model invents is exactly the citation the harness then cannot re-open. O(1) top-level concat. The command
// names `bash` explicitly for the same reason the resolver's does — one idiom, no dependency on /bin/sh —
// even though onchain-fact.sh itself is kept POSIX (the demo runs it under `sh`, i.e. dash in CI, as the
// stricter proof).
fn onchain_fact_block(tool: string, cache: string, state: string, budget: string, block: string) -> string {
    return onchain_fact_marker() + "\n"
      + "Some claims turn on DEPLOYED STATE rather than on source: what a parameter is actually set to, which "
      + "account actually holds a role, what a value actually is right now. Source cannot settle those and "
      + "neither can memory — but you can READ one. There is a deterministic on-chain reader on disk (no "
      + "model, no search). Run it with Bash:\n"
      + "    bash " + tool + " --chain <id> --address 0x<40 hex> --sig \"<name>(<argtypes>)(<returntypes>)\""
      + " [--args \"<value> <value>\"]" + block + " --cache-dir " + cache + " --budget-state " + state + "\n"
      + "The ADDRESS must be one this payload, its configuration or the resolver above actually names; an "
      + "address you invented answers about nothing. The tool takes NO endpoint and NO URL — the network "
      + "endpoint is configured by the operator, and arguments must be plain values (a hex word, a number, a "
      + "boolean, a name). It prints exactly one line:\n"
      + "ONCHAIN|<chain>:<address>:<selector>|<result>|<block>\n"
      + "ONCHAIN|<chain>:<address>:<selector>|unavailable|<reason>\n"
      + "An `unavailable` line means the value was NOT read — no endpoint is configured, the call reverted, or "
      + "the budget is spent. It is NEVER evidence that the value is what you expected: a check resting on it "
      + "is UNRESOLVED.\n"
      + "BUDGET: at most " + budget + " calls in this cell, so spend them on values a VERDICT turns on.\n"
      + "CITING WHAT YOU READ: quote the call and the value exactly as the tool printed them:\n"
      + "TRACE|#<k>|CLEAN|ONCHAIN <chain>:<address>:<selector>@<block> = <result> — <what that value settles>\n"
      + "The citation is RE-OPENED from the reader's own cache, never from the network, and the value must be "
      + "the one that call returned. A value you did not read this way, or one that does not match what was "
      + "cached, counts as no citation at all — that check is then recorded as unanswered, which is strictly "
      + "worse than an honest UNRESOLVED.\n";
}

// The toggle + the assembled directive: "" unless the shell handed this cell the reader. The optional
// `--block` is only offered when the operator pinned one, so a cell is never told to invent a block number.
// "5" is onchain-fact.sh's own documented default, quoted from the same env the shell enforces it with, so
// the number the model is told and the number enforced cannot drift.
fn onchain_budget() -> string {
    let b = getenv("ONCHAIN_BUDGET");
    if b == "" { return "5"; }
    return b;
}

fn onchain_fact_directive() -> string {
    let tool = getenv("ONCHAIN_FACT");
    if tool == "" { return ""; }
    let blk = getenv("FORK_BLOCK");
    if blk == "" {
        return onchain_fact_block(tool, getenv("EXTERNAL_CACHE"), getenv("ONCHAIN_BUDGET_STATE"),
            onchain_budget(), "");
    }
    return onchain_fact_block(tool, getenv("EXTERNAL_CACHE"), getenv("ONCHAIN_BUDGET_STATE"),
        onchain_budget(), " --block " + blk);
}

let dir = getenv("TARGET_DIR");
let files = getenv("IN_SCOPE");
let cls = getenv("HUNT_CLASS");
let subsystem = getenv("SUBSYSTEM");
let brief = cat_file(getenv("SCOPE_BRIEF"));
// #1865: run-discovery.sh --appendix sets these on a BREADTH cell whose payload carries the #1861 derived
// implementor (they must be on `exec.env_passthrough`, else getenv() returns "" and the framing is silently
// inert). Both are "" on every other cell, so scoped_code's output is byte-identical there.
let appendix_file = getenv("APPENDIX_FILE");
let appendix_base = getenv("APPENDIX_BASE");
let code = scoped_code(dir, files, appendix_file, appendix_base);
let classDoc = class_section(getenv("TAXONOMY"), cls);

// #1001 READ side: pull the shared blackboard FIRST, so a lead an EARLIER cell posted this run can
// steer this one. `focus` is "" when the board is empty (first cell) or holds nothing for this cell —
// then the instruction below is byte-identical to the pre-#1001 prompt (no behavior change). A printed
// BLACKBOARD-FOCUS| line makes the steering observable in the cell log even on the mock backend (where
// prompt() never reasons), so run-discovery.sh and the operator can SEE one cell steer another.
let board = recall_latest("dark-factory:blackboard:leads");
let focus = focus_block(board, subsystem);
if len(focus) > 0 {
    print("BLACKBOARD-FOCUS|" + subsystem + "|" + cls + "|focusing on leads sibling cells posted: "
        + first_line(board));
}

// #1827 DEPTH read: run-discovery.sh sets DEPTH_TARGET/DEPTH_KNOWN only on a depth cell (they must be on
// `exec.env_passthrough`, else getenv() returns "" and the whole feature is silently inert). `depth` is ""
// on every breadth cell, so the instruction below stays byte-identical there. The printed DEPTH-CELL| line
// makes the pass observable in the cell log even on the mock backend; run-discovery.sh treats it as a record
// BOUNDARY in _join_wrapped_candidates so it can never be glued onto an open CANDIDATE| record as prose.
let depth_target = getenv("DEPTH_TARGET");
let depth = depth_block(depth_target, getenv("DEPTH_KNOWN"));
if len(depth) > 0 {
    print("DEPTH-CELL|" + subsystem + "|" + cls + "|" + depth_target);
}

// #1865 APPENDIX read: the judging block for a payload carrying the derived implementor of an abstract base.
// The sentinel it enables is printed further down — AFTER `instruction` exists, because it is gated on the
// framing having actually been assembled into the prompt (see framing_emitted), not on the token being set.
let appx = appendix_rule(appendix_file, appendix_base);

// #1887 CONSTRAINT read: the imported corpus, filtered to THIS cell's class, sorted+deduped for determinism.
// Empty corpus => `cons` is "" => the instruction below is byte-identical to the pre-#1887 one. The printed
// sentinel makes the injection observable in the cell log (mirroring BLACKBOARD-FOCUS| / DEPTH-CELL|) and
// carries no `CANDIDATE|` substring, so lib/run-agent-validated.sh's sentinel predicate cannot false-accept
// a cell on it; run-discovery.sh treats it as a record BOUNDARY in _join_wrapped_candidates.
let cons_bullets = sort_unique_strings(class_constraints(query_knowledge("refute-constraint", 32), cls));
let cons = constraint_block(cons_bullets);
if len(cons) > 0 {
    print("REFUTE-CONSTRAINTS|" + subsystem + "|" + cls + "|" + to_string(capped_count(cons_bullets, 6)));
}

// #2145 CALLEE-TRUST read: the deterministic settable-callee detector over the assembled payload. `callee`
// is "" whenever the zone has no external call surface or no settable/computed call target, so an undetected
// zone's instruction below is BYTE-IDENTICAL to the pre-#2145 one. The sentinel it enables is printed further
// down — AFTER `instruction` exists — because it is gated on the directive having actually been assembled
// into the prompt, not merely on the detector having returned true. #2157: routed through callee_directive so
// `CALLEE_TRUST=0` forces the OFF arm; unset/any-other value is ON = byte-identical to before.
let callee = callee_directive(code);

// #2211 OPERATIONALIZE read: the pure-meta "derive code-grounded checks, write them out, THEN trace" method
// directive. `opz` is "" unless OPERATIONALIZE_LENS=1 (opt-in, default OFF), so every cell that does not opt
// in prompts BYTE-IDENTICALLY to the pre-#2211 pipeline. There is no detector — the flag is the only gate,
// which is what makes the M2 A/B a single-variable experiment. The sentinel it enables is printed further
// down, AFTER `instruction` exists, on the same honesty contract as CALLEE-TRUST| / APPENDIX-CONTEXT|.
let opz = operationalize_directive();

// #2235 EXTERNAL-RESOLVE read: the "you may go and read the external protocol" verb. `extres` is "" unless
// run-discovery.sh --external-resolve handed this cell a resolver path, so every default cell prompts
// BYTE-IDENTICALLY to the pre-#2235 pipeline. Gated on the env alone and NOT on the #2211 lens (STOP-1
// decision 2). The sentinel it enables is printed further down, AFTER `instruction` exists, on the same
// honesty contract as CALLEE-TRUST| / OPERATIONALIZE| / APPENDIX-CONTEXT|.
let extres = external_resolve_directive();

// #2245 iteration 2 SEVERITY-RUBRIC read: the contest-severity dismissal rubric + the closed ground list.
// `rubric` is "" unless SEVERITY_RUBRIC=1 (opt-in, default OFF), so every cell that does not opt in prompts
// BYTE-IDENTICALLY to the pre-#2245 pipeline. There is no detector — a severity judgment is cross-class and
// cannot be routed to a zone, so the flag is the only gate, which is what keeps the arm a single-variable
// experiment. Gated INDEPENDENTLY of OPERATIONALIZE_LENS (STOP-1 decision 3). The sentinel it enables is
// printed further down, AFTER `instruction` exists, on the same honesty contract as OPERATIONALIZE|.
let rubric = severity_rubric_directive();

// #2245 iteration 5 PARAM-AUDIT read: the output-gated parameter audit (PARAM|/PARAM-TRACE| emission contract +,
// inside a rubric-ON cell, the lead rule). `paudit` is "" unless PARAM_AUDIT=1 (opt-in, default OFF), so every
// cell that does not opt in prompts BYTE-IDENTICALLY to the pre-iteration-5 pipeline. No detector — the flag is
// the only gate. INDEPENDENT of SEVERITY_RUBRIC, GROUND_EVIDENCE and OPERATIONALIZE_LENS. The sentinel it enables
// is printed further down, AFTER `instruction` exists, on the same honesty contract as SEVERITY-RUBRIC|.
let paudit = param_audit_directive();

// #2235 PR C ON-CHAIN read: the "you may read a deployed value" verb. `onchain` is "" unless the same
// --external-resolve branch handed this cell onchain-fact.sh, so a default cell prompts BYTE-IDENTICALLY.
// It rides beside `extres` rather than inside it because the two verbs answer different questions (source
// vs deployed state) and a host with no configured endpoint still gets the resolver.
let onchain = onchain_fact_directive();

// The instruction carries the lens (taxonomy class), the brief (invariants + known-issues), and the
// strict output contract; the code is the prompt payload (matches auditor.ag::classify_evm_llm shape).
// The (possibly empty) blackboard FOCUS block sits up top so prior siblings' leads bias the hunt.
// #2145: the (possibly empty) CALLEE-TRUST directive sits directly after the role preamble, ahead of every
// other conditional block, because it re-frames the trust model the WHOLE hunt reasons under.
// #2211: the (possibly empty) OPERATIONALIZE directive sits IMMEDIATELY ABOVE the lens, because it tells the
// cell to convert "the bug class in the LENS below" into concrete checks — the referent has to follow it.
let instruction =
    "You are an elite adversarial smart-contract auditor hunting a HIGH or MEDIUM severity bug an EXTERNAL "
  + "attacker (holding NO privileged role) can exploit. Audit this code FRESH: assume nothing is safe until "
  + "you have traced the actual control/data flow yourself. An obvious-looking bug IS a real bug unless a "
  + "guard in the code provably stops it — do NOT assume prior auditors already caught it.\n\n"
  + callee
  + focus
  + depth
  + appx
  + cons
  + opz
  + "=== HUNT THIS BUG CLASS (the lens) ===\n" + classDoc + "\n\n"
  + "=== PROTOCOL BRIEF — invariants whose violation is a valid finding, and KNOWN ISSUES you MUST NOT report ===\n"
  + brief + "\n\n"
  + "=== RULES ===\nOnly Medium/High count. A trusted role acting WITHIN its documented permissions is OUT OF SCOPE; "
  + "a role EXCEEDING its permissions, or any unprivileged user, IS in scope. Never report a listed KNOWN ISSUE.\n"
  // #2214 PR C: the trusted-role exclusion one line above is exactly what the measured dismissals hid
  // behind, so the rule that qualifies it sits HERE, inside the same RULES block, on every cell.
  + config_realizability_rule()
  // #2245 iteration 2: the severity rubric QUALIFIES the trusted-role exclusion above (an admin action inside
  // the range its own setter accepts is a valid INPUT, not an out-of-scope trusted action) and extends the
  // dismissal discipline config_realizability_rule() states for configuration grounds, so it is read directly
  // after it. "" whenever the knob is off, so the RULES block is byte-identical on every default cell.
  + rubric
  // #2245 iteration 5: the parameter audit sits directly after the rubric, so its lead rule can point at the
  // DISMISS grammar just read, and before the resolver verb, so one resolved citation stays usable by both.
  // "" whenever the knob is off, so the RULES block is byte-identical on every default cell.
  + paudit
  // #2235: the resolver verb sits directly after the dismissal rule it gives a cell a MOVE against — one
  // resolved citation can discharge both rule 1 (configuration grounds) and rule 2 (an external fact).
  // "" whenever the knob is off, so the RULES block is byte-identical on every default cell.
  + extres
  // #2235 PR C: the on-chain verb follows the source verb, so a cell that cannot settle a claim from source
  // sees the deployed-state move next. "" whenever the knob is off.
  + onchain
  + "Subsystem under review: " + subsystem + ".\n\n"
  + "=== HOW TO ANSWER ===\n"
  + "BOUNDED TERMINATION (#2017 — you MUST converge to ONE terminal verdict; never run an open-ended search). "
  + "This lens is EXPECTED to reason across the seam: an in-scope payload can be a params / storage / interface / "
  + "declaration file with little or no local logic, but its declared types and fields are still attackable "
  + "THROUGH how the protocol's OTHER contracts consume them (an uninitialized/unseeded field, a params struct a "
  + "consumer trusts without a value-conservation guard). That consumer-misuse hop is IN SCOPE and is often the "
  + "ONLY way the real bug surfaces — do NOT refuse it or answer SAFE merely because this file has no function "
  + "bodies. What you MUST NOT do is enumerate consumers or hypotheticals forever. Work to a BUDGET: pick the few "
  + "(~1-3) most promising seams where a declared value is consumed WITHOUT a guard that conserves value, and for "
  + "EACH spend a BOUNDED effort tracing ONE concrete, end-to-end exploit an external attacker can actually "
  + "execute. The moment you either (i) substantiate a concrete exploitable seam or (ii) exhaust that bounded "
  + "effort without one, STOP and emit your best terminal verdict — the CANDIDATE(s) you substantiated, or the "
  + "single token SAFE. Reaching a terminal verdict within budget is the requirement; continuing past it (still "
  + "chasing new consumers after the bounded effort is spent) is the runaway this rule forbids.\n"
  + "FIRST reason step by step: walk EACH in-scope function relevant to this bug class and trace whether an "
  + "external attacker can break an invariant — verify guards/CEI-order/rounding/auth in the actual code, do "
  + "not hand-wave. THEN, for EVERY qualifying Medium/High bug you found, write one line:\n"
  + "CANDIDATE|<file:function:line>|class=" + cls + "|<severity=Medium|High>|<one-sentence external exploit path>|<concrete foundry PoC sketch: what to deploy, call, and assert>\n"
  + "The <file:function:line> field MUST be a BARE repo-relative source path, then the function name, then an "
  + "optional line — exactly `file:function[:line]` and nothing more: NO `@`-compound suffix, NO `~(...)` test "
  + "reference, and NO extra `:` beyond those two.\n"
  + "If — after actually tracing the relevant functions — there is genuinely no qualifying bug of this class, "
  + "write the single token: SAFE\n"
  + "Reason for as long as you need first; ONLY the CANDIDATE| line(s) or the final SAFE token are parsed, so "
  + "your analysis text above them is free.";

// #1865: the hunt-side twin of the gate's AUX-CONTEXT| (refuter.ag) — it makes the attachment observable in
// the cell log BEFORE the expensive call, is what run-discovery.sh derives the per-cell `appendix` record
// from, and is treated as a record BOUNDARY by _join_wrapped_candidates so it can never be glued onto an
// open CANDIDATE| record. The token carries no `CANDIDATE|` substring, so the sentinel predicate in
// lib/run-agent-validated.sh cannot false-accept a cell on it. It fires ONLY when both halves of the framing
// are demonstrably in the prompt about to be sent, so no artifact can claim a framing that did not happen.
if framing_emitted(appendix_file, instruction, code) {
    print("APPENDIX-CONTEXT|" + appendix_file);
}

// #2145: the CALLEE-TRUST sentinel, on the same honesty contract as APPENDIX-CONTEXT| above — it is gated on
// the directive's own marker being demonstrably IN the prompt about to be sent (index_of over `instruction`),
// never on the detector's return value, so no cell log can claim a re-framing that was not injected. It makes
// the injection observable even on the mock backend (where prompt() never reasons), carries no `CANDIDATE|`
// substring so lib/run-agent-validated.sh's sentinel predicate cannot false-accept a cell on it, and is
// treated as a record BOUNDARY by run-discovery.sh's _join_wrapped_candidates like every other diagnostic.
// <n> is how many of the three settable-target signals fired (setter / mutable address state / computed
// target) — the counting pass runs ONLY inside this branch, so a non-firing cell never pays for it.
if index_of(instruction, callee_trust_marker()) >= 0 {
    print("CALLEE-TRUST|" + subsystem + "|" + cls + "|" + to_string(settable_signal_count(code)) + "|v2");
}

// #2211: the OPERATIONALIZE sentinel, on the same honesty contract — gated on the directive's own marker
// being demonstrably IN the prompt about to be sent (index_of over `instruction`), never on the toggle's
// return value, so no cell log can claim a method directive that was not injected. It carries no
// `CANDIDATE|` substring (lib/run-agent-validated.sh's sentinel predicate cannot false-accept a cell on it)
// and run-discovery.sh's _join_wrapped_candidates treats it as a record BOUNDARY like every other
// diagnostic. The <state> field is a constant `on`: the line is printed ONLY when the directive is in, so
// there is nothing else it could say — an OFF cell simply prints no line at all.
if index_of(instruction, operationalize_marker()) >= 0 {
    print("OPERATIONALIZE|" + subsystem + "|" + cls + "|on");
}

// #2245 iteration 2: the SEVERITY-RUBRIC sentinel, on the same honesty contract — gated on the rubric's own
// marker being demonstrably IN the prompt about to be sent (index_of over `instruction`), never on the
// toggle's return value, so no cell log can claim a rubric that was not injected. It is also what makes
// run-discovery.sh's ground gate INERT by construction whenever the knob is off: that gate reads this line
// and counts nothing without it. Carries no `CANDIDATE|` substring (lib/run-agent-validated.sh's sentinel
// predicate cannot false-accept a cell on it) and run-discovery.sh's _join_wrapped_candidates treats it as a
// record BOUNDARY like every other diagnostic. `on` is a constant for the same reason as OPERATIONALIZE|:
// an OFF cell prints no line at all.
if index_of(instruction, severity_rubric_marker()) >= 0 {
    print("SEVERITY-RUBRIC|" + subsystem + "|" + cls + "|on");
}

// #2245 iteration 3: the GROUND-EVIDENCE sentinel, on the SAME honesty contract and for the same reason — it
// is what makes run-discovery.sh's per-ground evidence contract INERT by construction whenever the second knob
// is off: that layer reads this line and checks nothing without it. A rubric-ON / contract-OFF cell prints the
// line above and not this one, which is exactly the iteration-2 arm. Carries no `CANDIDATE|` substring and is a
// record BOUNDARY for _join_wrapped_candidates like every other diagnostic.
if index_of(instruction, ground_evidence_marker()) >= 0 {
    print("GROUND-EVIDENCE|" + subsystem + "|" + cls + "|on");
}

// #2245 iteration 5: the PARAM-AUDIT sentinel, on the SAME honesty contract — gated on the audit's own marker being
// demonstrably IN the prompt about to be sent (index_of over `instruction`), never on the toggle's return value. It
// is what ARMS run-discovery.sh's parameter gate: that gate reads this line and counts nothing without it, so the
// shell layer is inert by construction whenever the knob is off. Carries no `CANDIDATE|` substring and is a record
// BOUNDARY for _join_wrapped_candidates like every other diagnostic. `on` is a constant: an OFF cell prints nothing.
if index_of(instruction, param_audit_marker()) >= 0 {
    print("PARAM-AUDIT|" + subsystem + "|" + cls + "|on");
}

// #2235: the EXTERNAL-RESOLVE sentinel, on the same honesty contract — gated on the directive's own marker
// being demonstrably IN the prompt about to be sent, never on getenv() having returned something. It carries
// no `CANDIDATE|` substring (lib/run-agent-validated.sh's sentinel predicate cannot false-accept a cell on
// it) and run-discovery.sh's _join_wrapped_candidates treats it as a record BOUNDARY like every other
// diagnostic. `on` is a constant for the same reason as OPERATIONALIZE|: an OFF cell prints no line at all.
if index_of(instruction, external_resolve_marker()) >= 0 {
    print("EXTERNAL-RESOLVE|" + subsystem + "|" + cls + "|on");
}

// #2235 PR C: the ONCHAIN-FACT sentinel, on the same honesty contract as EXTERNAL-RESOLVE| above — gated on
// its own marker being demonstrably IN the prompt about to be sent, never on getenv(). It carries no
// `CANDIDATE|` substring and run-discovery.sh's _join_wrapped_candidates treats it as a record BOUNDARY.
if index_of(instruction, onchain_fact_marker()) >= 0 {
    print("ONCHAIN-FACT|" + subsystem + "|" + cls + "|on");
}

let verdict = prompt(instruction, code) -> string;

// Surface to the verifier (stdout) and record the attempt so taxonomy fitness reweights over time.
print(verdict);
let outcome = outcome_of(verdict);
emit("dark-factory:hunt_result", "{\"class\":\"" + cls + "\",\"subsystem\":\"" + subsystem + "\",\"outcome\":\"" + outcome + "\"}");
learn("hunt", cls + ":" + subsystem, "discovery hunt of " + cls + " on " + subsystem, outcome, hunt_tags(cls, subsystem, outcome, depth));

// #1001 WRITE side: a CANDIDATE is a LEAD worth steering siblings toward. POST it to the shared
// blackboard (rolling, read by every later cell above) as `subsystem|class|<lead summary>`, and emit
// `dark-factory:lead` on the bus so an out-of-band coordinator/dashboard can react too. A reasoned
// SAFE writes nothing — only positive findings steer, never a clean result. memo_write overwrites the
// key, so we read-append-write to keep prior siblings' leads (single shared store = no lost update,
// cells run sequentially). The subsystem name rides inside the lead BODY (the `subsystem|...` prefix
// every reader splits on) — it must NOT be spliced into a memo KEY: a real zone name carries spaces,
// `&`, `/`, `()` etc, none of which are legal in a memo key ([A-Za-z0-9_:.-]), so a per-subsystem key
// crashed the hunter on every real (multi-word-named) zone at the exact moment it surfaced a CANDIDATE,
// silently discarding the lead. Only `dark-factory:blackboard:leads` is ever read (here + coordinator.ag);
// the per-subsystem shadow key was never read by anything, so it is gone.
if outcome == "success" {
    let lead = subsystem + "|" + cls + "|" + lead_summary(verdict);
    memo_write("dark-factory:blackboard:leads", append_line(board, lead));
    emit("dark-factory:lead", "{\"subsystem\":\"" + subsystem + "\",\"class\":\"" + cls + "\"}");
    print("BLACKBOARD-POST|" + lead);
}
memo_write("hunter:last_check", "done");
