# Containerfile.preprint -- base image for the preprint-foundry
# federation (#596). Converts a `VERIFIED_NEW` claim row from
# claim-auditor's audit-ledger.jsonl into a LaTeX preprint + arXiv
# submission tarball.
#
# Layered on top of the math-foundry / claim-auditor image shape:
# Debian + agentis runtime + Python scientific stack + claude CLI.
# This federation additionally needs:
#   - TeX Live (texlive-latex-extra, texlive-fonts-recommended,
#     texlive-science) for `latexmk -pdf` invoked by the editor colony,
#   - GAP (`gap-core`, optionally `gap-pkg-smallgrp`) so the computer
#     colony can run group-theory reproducibility scripts,
#   - `curl` (already present) for arXiv endorsement / metadata lookups,
#   - a working SMTP path so the submitter colony can mail
#     submission.tar.gz to the arXiv email gateway when a human flips
#     the HITL approval flag. The orchestrator does NOT pass
#     `--network none`; rootless podman's default slirp4netns egress
#     is used.
#
# WARNING: this image deliberately bakes ONLY the agentis runtime, the
# Python / LaTeX / GAP toolchains, and the claude CLI. The five
# colonies and the per-run hermetic .agentis/ state are mounted at run
# time via `-v $REPO_ROOT:/repo:ro` and `-v $RUN_DIR/<node>:/run-root:rw`.
# Do NOT `COPY` any colony source into the image.
#
# WARNING: Claude Code session credentials
# (`~/.claude/.credentials.json`) MUST NOT be baked in. The orchestrator
# bind-mounts the host operator's `$HOME/.claude` at run time via
# `-v $HOST_CLAUDE_DIR:/root/.claude:rw,z`; never `COPY` the directory
# into the image.

FROM ubuntu:24.04

ARG AGENTIS_VERSION=v1.7.12

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-requests \
        jq \
        git \
        curl \
        ca-certificates \
        texlive-latex-base \
        texlive-latex-recommended \
        texlive-latex-extra \
        texlive-fonts-recommended \
        texlive-science \
        latexmk \
        gap-core \
        ssmtp \
 && rm -rf /var/lib/apt/lists/*

# Compute stack matching math-foundry so a future merged-image cut is
# painless. The computer colony's Python reproducibility scripts may
# use any of these.
RUN python3 -m pip install --no-cache-dir --break-system-packages \
        sympy \
        numpy \
        networkx

RUN cd /tmp \
 && curl -fsSL -o agentis-linux-x86_64 \
        "https://github.com/Replikanti/agentis/releases/download/${AGENTIS_VERSION}/agentis-linux-x86_64" \
 && curl -fsSL -o agentis-linux-x86_64.sha256 \
        "https://github.com/Replikanti/agentis/releases/download/${AGENTIS_VERSION}/agentis-linux-x86_64.sha256" \
 && sha256sum -c agentis-linux-x86_64.sha256 \
 && install -m 0755 agentis-linux-x86_64 /usr/local/bin/agentis \
 && rm /tmp/agentis-linux-x86_64 /tmp/agentis-linux-x86_64.sha256

# Install Claude Code CLI for the optional claude-backend support
# (Opus for the introducer / theorist / editor colonies, Sonnet for
# the computer / submitter colonies in a future per-colony cut).
RUN curl -fsSL https://claude.ai/install.sh | bash \
 && ln -s /root/.local/bin/claude /usr/local/bin/claude

WORKDIR /run-root

ENTRYPOINT ["/bin/bash"]
