# grand-rounds baseline -- external toolchain pins (public reference data only).
#
# Every value here is a public URL or a public container tag. NOTHING in this
# file may reference gated challenge data, a local host path, or a proband.
# scripts/fetch-reference-data.sh resolves these into $MVA_WORK_DIR/refdata/
# and records the realised versions + sha256 sums into
# $MVA_WORK_DIR/refdata/RESOLVED.env, which the .ag pipeline's Exomiser stage
# reads. bcftools/Exomiser wrappers are written under $MVA_WORK_DIR/tools/bin/.
#
# Override any of them in the environment; the fetch script only sets the ones
# that are still unset (`: "${VAR:=default}"`).

# --- Containers -------------------------------------------------------------
# The host JDK is not pinnable across machines (a JDK 25 host cannot run
# Exomiser 14.x, which supports 17-21), so both binary tools run in pinned
# images through wrapper scripts generated in $MVA_WORK_DIR/tools/bin/.
: "${MVA_CONTAINER_CMD:=podman}"
: "${MVA_BCFTOOLS_IMAGE:=quay.io/biocontainers/bcftools:1.19--h8b25389_0}"
: "${MVA_JRE_IMAGE:=docker.io/library/eclipse-temurin:17-jre}"

# --- Exomiser ---------------------------------------------------------------
# Data bundle sizes (2406): hg38 ~23.5 GB compressed, phenotype ~6.2 GB.
: "${MVA_EXOMISER_VERSION:=14.1.0}"
: "${MVA_EXOMISER_DATA_VERSION:=2406}"
: "${MVA_EXOMISER_CLI_URL:=https://github.com/exomiser/Exomiser/releases/download/${MVA_EXOMISER_VERSION}/exomiser-cli-${MVA_EXOMISER_VERSION}-distribution.zip}"
: "${MVA_EXOMISER_DATA_BASE_URL:=https://data.monarchinitiative.org/exomiser/data}"
: "${MVA_EXOMISER_ASSEMBLY:=hg38}"
# Java heap for the Exomiser run. The 2406 hg38 MVStore is memory hungry;
# below ~8g the run either thrashes or dies with an OOM part-way through.
: "${EXOMISER_JAVA_OPTS:=-Xmx16g}"

# --- Reference assembly -----------------------------------------------------
# GRCh38 "no_alt" analysis set with UCSC-style (chr-prefixed) contig names --
# the same naming the submission schema requires. ~873 MB compressed,
# ~3.1 GB on disk after decompression. The .fai published beside it indexes
# the DECOMPRESSED file, so setup-tools.sh gunzips and reuses it.
: "${MVA_REF_BASE_URL:=https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids}"
: "${MVA_REF_FASTA_NAME:=GCA_000001405.15_GRCh38_no_alt_analysis_set.fna}"

# --- Ontology + gene models -------------------------------------------------
: "${MVA_HPO_OBO_URL:=https://purl.obolibrary.org/obo/hp.obo}"
: "${MVA_GENCODE_RELEASE:=45}"
: "${MVA_GENCODE_GTF_URL:=https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_${MVA_GENCODE_RELEASE}/gencode.v${MVA_GENCODE_RELEASE}.primary_assembly.annotation.gtf.gz}"

# --- Analysis parameters ----------------------------------------------------
# Primary-assembly contigs kept by stage 1. Everything else in the challenge
# VCF (unlocalized `*_random`, unplaced `chrUn_*`, `chrEBV`, alt loci) is
# outside the submission schema and outside every gene panel we score.
: "${MVA_PRIMARY_CONTIGS:=chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY,chrM}"
# Padding (bp) applied around each panel gene when stage 4 derives the BED from
# the GENCODE GTF -- wide enough to catch canonical splice + near-UTR hits.
# start-colony.sh exports this as PANEL_PAD for the .ag pipeline.
: "${MVA_PANEL_PAD:=5000}"
