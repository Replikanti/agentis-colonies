// pipeline.ag — Grand Rounds "baseline" colony (MVA Hackathon 2026, Track 1).
//
// A one-shot `agentis go` clinical-genomics prioritization pipeline. SEVEN
// cooperating agents (a coordinator + six stage agents) wired by the substrate
// emit/listen bus own the WHOLE decision surface; external binaries (bcftools,
// the Exomiser container) do only bulk, mechanical data transforms. Nothing
// decision-shaped lives in a shell script.
//
//   coordinator --emit baseline:env--> preprocessor (stage 1)
//   preprocessor --emit baseline:normalized_vcf--> phenotyper (stage 2 + D6 gate)
//                                              \--> panel_reviewer (stage 4)
//   phenotyper  --emit baseline:hpo_ids--> exomiser_runner (stage 3, OPT-IN)
//   panel_reviewer --emit baseline:panel_hits--> reconciler (stage 5)
//   reconciler  --emit baseline:candidates--> emitter (stage 6: build + validate + write)
//
//   The panel review reads the normalized VCF directly, NOT the Exomiser TSV.
//   The Exomiser branch (stage 3) is OPT-IN (MVA_RUN_EXOMISER=1, hour-scale
//   run) and since #2054 its output (baseline:exomiser_tsv) IS consumed: the
//   reconciler appends the Exomiser top-N as novel-gene candidates AFTER the
//   panel set, on the epcr.yml phenotype_novel_gene/incidental tiers.
//
// The .ag / external boundary is drawn so NO bulk record stream ever enters
// .ag: every stage narrows externally first (bcftools over ~5M records, the
// Exomiser container), and .ag sees only tens-to-hundreds of rows; the final
// candidate set (<= 10 rows) is entirely .ag-resident.
//
// Run: ./scripts/start-colony.sh   (execs `agentis go agents/pipeline.ag
//   --enable-exec --enable-messaging` from the colony dir, with the env
//   contract exported and exec.env_passthrough wired in .agentis/config).
//
// All external I/O goes through `exec sh` with shell_escape() on every dynamic
// value: file_read/file_write are sandboxed to .agentis/sandbox, but the gated
// inputs live outside it (reached via $MVA_DATA_DIR etc.).

cb 2000000;

// ======================================================================
// shared helpers (shallow, leaf-heavy — flat builtins over per-element walks)
// ======================================================================

// getenv with a default (getenv reads the SANITIZED env; a knob missing from
// exec.env_passthrough returns "").
fn getenv_or(name: string, dflt: string) -> string {
    let v = getenv(name);
    if len(v) == 0 { return dflt; }
    return v;
}

// nth tab-separated field of a line (0-based), "" if absent. Leaf recursion.
fn field(line: string, n: int) -> string {
    if n <= 0 {
        let t = index_of(line, "\t");
        if t < 0 { return line; }
        return substring(line, 0, t);
    }
    let t = index_of(line, "\t");
    if t < 0 { return ""; }
    return field(substring(line, t + 1, len(line)), n - 1);
}

// Literal (non-regex) substring replacement of EVERY occurrence of `from`.
// agentis has no `replace`/`replace_all` builtin (the typechecker defaults an
// unknown name to Any, so a bogus builtin passes `agentis commit` but aborts at
// runtime with "undefined function"); regex_split can't be used here because the
// CSV/template needles contain regex metacharacters ({, }). Leaf recursion over
// index_of/substring, like `field`.
fn replace_all(s: string, from: string, to: string) -> string {
    if len(from) == 0 { return s; }
    let i = index_of(s, from);
    if i < 0 { return s; }
    let before = substring(s, 0, i);
    let after = substring(s, i + len(from), len(s));
    return before + to + replace_all(after, from, to);
}

// Join a list<string> with a separator. agentis has no `join` builtin either
// (same Any-defaulting typechecker gap as `replace`); reduce is native/iterative
// so this stays cheap on the ~hundreds-of-runs docx text list. Strips the one
// leading separator the fold produces.
fn join_str(xs: list<string>, sep: string) -> string {
    let joined = reduce(xs, |acc: string, x: string| -> string { return acc + sep + x; }, "");
    if len(joined) == 0 { return ""; }
    return substring(joined, len(sep), len(joined));
}

// first n elements of a list<string> (there is no `range` builtin, so this is
// push-recursion over an empty list<string> obtained via a false filter).
fn take_acc(xs: list<string>, n: int, i: int, acc: list<string>) -> list<string> {
    if i >= n { return acc; }
    if i >= len(xs) { return acc; }
    return take_acc(xs, n, i + 1, push(acc, get(xs, i)));
}
fn take(xs: list<string>, n: int) -> list<string> {
    let empty = filter(xs, |x: string| -> bool { return false; });
    return take_acc(xs, n, 0, empty);
}

// non-empty lines of a blob.
fn nonempty_lines(blob: string) -> list<string> {
    return filter(regex_split("\n", blob), |l: string| -> bool { return len(trim(l)) > 0; });
}

// Total bus read (#2044). listen() returns Void when the producer aborted
// before emitting; every consumer guard here keys on len() == 0, so normalize
// Void ("void" after to_string) to "". Without this a post-abort tick dies
// with a runtime type error and the WHOLE RUN's print buffer — including the
// abort reason the operator needs — is discarded with it.
fn bus_read(topic: string) -> string {
    let v = to_string(listen(topic));
    if v == "void" { return ""; }
    return v;
}

// Record the row count a stage handed to .ag (M6 boundary-table regression
// guard). Written to $MVA_WORK_DIR/stage-rows.tsv, one line per stage.
fn record_rows(stage: string, rows: int) -> void {
    let wd = getenv("MVA_WORK_DIR");
    let line = stage + "\t" + to_string(rows) + "\n";
    // colony-lint: safe-exec-concat
    exec sh "printf %s " + shell_escape(line) + " >> " + shell_escape(wd + "/stage-rows.tsv");
    print("stage", stage, "rows into .ag:", rows);
}

// Map a raw VCF contig id to its chr-prefixed name (stage 1 decision).
fn chr_name(id: string) -> string {
    if index_of(id, "chr") == 0 { return id; }
    if id == "MT" { return "chrM"; }
    if id == "M" { return "chrM"; }
    return "chr" + id;
}

// Is this a chr-prefixed PRIMARY contig (chr1..22, chrX/Y/M)? (stage 1 + 6)
fn is_primary_contig(name: string) -> bool {
    return regex_match("^chr([1-9]|1[0-9]|2[0-2]|X|Y|M)$", name);
}

// bcftools binary/wrapper (env or PATH default).
fn bcftools_bin() -> string {
    return getenv_or("MVA_BCFTOOLS", "bcftools");
}

// Is M3 lens mode requested? (opt-in, default off — the Exomiser opt-in
// precedent. Every M3 agent early-returns on the default so the baseline
// submission stays byte-for-byte identical.)
fn lens_mode() -> bool {
    return getenv_or("MVA_LENS_MODE", "0") == "1";
}

// ======================================================================
// M3 lens fan-out + refute gate — shared helpers (leaf-heavy, flat builtins)
// ======================================================================

// First whitespace-delimited token of a string (the gene symbol leads a notes
// field like "BUB1B biallelic (hom-alt)").
fn first_token(s: string) -> string {
    let sp = index_of(s, " ");
    if sp < 0 { return s; }
    return substring(s, 0, sp);
}

// Left-pad a numeric string to `width` with zeros (there is no format builtin;
// leaf recursion, like `take`). Only the lexicographic rank keys below need it.
fn zpad(s: string, width: int) -> string {
    if len(s) >= width { return s; }
    return zpad("0" + s, width);
}

fn clamp01(x: float) -> float {
    if x < 0.0 { return 0.0; }
    if x > 1.0 { return 1.0; }
    return x;
}

// The whole epcr.yml text (one grep-free read; the lens keys are then extracted
// with regex_capture, no YAML library — the M1 epcr_for pattern).
fn epcr_yml() -> string {
    let cdir = getenv("COLONY_DIR");
    // colony-lint: safe-exec-concat
    return exec sh "cat " + shell_escape(cdir + "/settings/epcr.yml") + " 2>/dev/null || true";
}

// Word-valued yaml key (tag names etc.; yaml_num below only matches
// numerics). Anchored to line start via "\n" so a commented-out line
// ("# key: ...") or another key's suffix ("x_key: ...") can never match —
// a silent miss here degrades to "tag absent -> fail-open for all", the
// exact #2056 failure class.
fn yaml_word(blob: string, key: string, dflt: string) -> string {
    let v = trim(regex_capture("\n[ ]*" + key + ":[ ]*([A-Za-z0-9_.:-]+)", blob, 1));
    if len(v) == 0 { return dflt; }
    return v;
}

// A top-level scalar key ("key: <number>") from the epcr.yml blob, or a default.
// Only real key lines carry "<key>: <num>"; the documentation lines use an em
// dash, so they never match.
fn yaml_num(blob: string, key: string, dflt: string) -> string {
    let v = trim(regex_capture(key + ":[ ]*([0-9.]+)", blob, 1));
    if len(v) == 0 { return dflt; }
    return v;
}

// Is `gene` a member of the known MVA panel (mva-genes.tsv)? Mechanical grep,
// the .ag reads the count. Every candidate the baseline surfaces is a panel
// gene, so this is 1.0 for the known-gene lens and the discriminator the
// pathway/novel-gene lens inverts.
fn in_known_panel(gene: string) -> bool {
    if len(trim(gene)) == 0 { return false; }
    let cdir = getenv("COLONY_DIR");
    // colony-lint: safe-exec-concat
    let hit = exec sh "grep -v '^#' " + shell_escape(cdir + "/settings/mva-genes.tsv")
        + " 2>/dev/null | grep -c -w -F " + shell_escape(gene) + " 2>/dev/null || echo 0";
    return parse_int(trim(hit)) > 0;
}

// POPULATION allele frequency of the representative variant, read from the
// caller-supplied `tag` ("" / "." = unassessable, fail-open — never a
// refutation). The tag comes from epcr.yml benign_af_info_tag (default
// GNOMAD_AF) and MUST have population semantics: a raw caller VCF carries
// INFO/AF = the SAMPLE's allele fraction (~0.5/1.0 on every het), and
// reading that as a population frequency refuted every real candidate on
// the first real run (#2056).
fn pop_af(nvcf: string, chrom: string, pos: string, tag: string) -> string {
    let bcftools = bcftools_bin();
    // colony-lint: safe-exec-concat
    return trim(exec sh shell_escape(bcftools) + " query -f " + shell_escape("%INFO/" + tag + "\\n") + " -r "
        + shell_escape(chrom + ":" + pos + "-" + pos) + " " + shell_escape(nvcf)
        + " 2>/dev/null | head -1 || true");
}

// --- the pool fact bundle the five lenses reason over --------------------
// One pool line per candidate: gene, chrom, pos, zygosity, vaf, filter, tierid
// (built by the reconciler from the panel-review evidence). The lenses read a
// COMPACT projection of it (facts only, tens of rows).
fn lens_payload(rows: list<string>) -> string {
    let lines = map(rows, |r: string| -> string {
        return "gene=" + field(r, 0) + " zygosity=" + field(r, 3) + " vaf=" + field(r, 4)
            + " filter=" + field(r, 5) + " tier=" + field(r, 6);
    });
    return join_str(lines, "\n");
}

// Parse the LLM's score for `gene` from a reply of "gene<TAB>score<TAB>..."
// lines, clamped to [0,1]. Falls back to the deterministic `prior` when the
// reply carries no parseable line for the gene (an offline/mock backend, or a
// model that ignored the format): the pipeline stays deterministic without a
// live model, and the lens is genuine with one. Returned as a string (memo).
fn lens_score(reply: string, gene: string, prior: float) -> string {
    let lines = nonempty_lines(reply);
    let hit = filter(lines, |l: string| -> bool { return field(l, 0) == gene; });
    if len(hit) == 0 { return to_string(clamp01(prior)); }
    let raw = trim(field(get(hit, 0), 1));
    if len(raw) == 0 { return to_string(clamp01(prior)); }
    return to_string(clamp01(parse_float(raw)));
}

// Deterministic lens priors — grounded in machine-checkable facts so the lens
// fan-out has a defined, input-driven signal even offline (the LLM refines it).
fn prior_inheritance(r: string) -> float {
    let tier = field(r, 6);
    if tier == "biallelic" { return 0.9; }
    if tier == "comphet" { return 0.8; }
    return 0.3;
}
fn prior_mosaicism(r: string) -> float {
    if index_of(field(r, 5), "LowVAF") >= 0 { return 0.9; }
    let vaf = parse_float(field(r, 4));
    if vaf > 0.0 { if vaf < 0.15 { return 0.9; } }
    return 0.3;
}
fn prior_known_gene(r: string) -> float {
    if in_known_panel(field(r, 0)) { return 1.0; }
    return 0.2;
}
fn prior_hpo(r: string, hpo: string) -> float {
    if len(trim(hpo)) == 0 { return 0.3; }
    if in_known_panel(field(r, 0)) { return 0.8; }
    return 0.4;
}
fn prior_pathway(r: string) -> float {
    if in_known_panel(field(r, 0)) { return 0.2; }
    return 0.7;
}

// --- the reconcile step: agreement count, refute verdict, promotion ------
// A single lens's score for `gene` (0.0 when the memo has no line for it).
fn score_of(blob: string, gene: string) -> float {
    let hit = filter(nonempty_lines(blob), |l: string| -> bool { return field(l, 0) == gene; });
    if len(hit) == 0 { return 0.0; }
    return parse_float(field(get(hit, 0), 1));
}

// How many of the five lenses scored `gene` at or above the agreement threshold.
fn count_agree(gene: string, thr: float, a: string, b: string, c: string, d: string, e: string) -> int {
    let g1 = if score_of(a, gene) >= thr { 1 } else { 0 };
    let g2 = if score_of(b, gene) >= thr { g1 + 1 } else { g1 };
    let g3 = if score_of(c, gene) >= thr { g2 + 1 } else { g2 };
    let g4 = if score_of(d, gene) >= thr { g3 + 1 } else { g3 };
    let g5 = if score_of(e, gene) >= thr { g4 + 1 } else { g4 };
    return g5;
}

// The refute verdict recorded for `gene` (REAL when absent — nothing refuted it).
fn refute_verdict_for(gene: string, refute: string) -> string {
    let hit = filter(nonempty_lines(refute), |l: string| -> bool { return field(l, 0) == gene; });
    if len(hit) == 0 { return "REAL"; }
    return field(get(hit, 0), 1);
}

// The two leading annotation columns (agreement, verdict) stripped back to the
// 12-field candidate row.
fn strip_fields(s: string, n: int) -> string {
    if n <= 0 { return s; }
    let t = index_of(s, "\t");
    if t < 0 { return ""; }
    return strip_fields(substring(s, t + 1, len(s)), n - 1);
}

// Rebuild a tab row with field `n` replaced by `val` (no in-place mutation).
fn set_field_rec(parts: list<string>, n: int, val: string, i: int, acc: list<string>) -> list<string> {
    if i >= len(parts) { return acc; }
    let e = if i == n { val } else { get(parts, i) };
    return set_field_rec(parts, n, val, i + 1, push(acc, e));
}
fn set_field(row: string, n: int, val: string) -> string {
    let parts = regex_split("\t", row);
    let empty = filter(parts, |x: string| -> bool { return false; });
    return join_str(set_field_rec(parts, n, val, 0, empty), "\t");
}
fn note_append(row: string, extra: string) -> string {
    return set_field(row, 11, field(row, 11) + extra);
}

// The epcr of a candidate row as an integer in centi (0.90 -> 90), for a
// deterministic rank key. epcr never reaches 1.0 in this ladder (max 0.90).
fn epcr_centi(row: string) -> int {
    let e = field(row, 9);
    let dot = index_of(e, ".");
    if dot < 0 { return parse_int(e) * 100; }
    // "1.00" must not read as 0 — with tie-separation a 1.00 leader would
    // collapse every following row to the floor (#2068 review; latent today,
    // the ladder maxes at 0.90 and promote_row caps at >= 90).
    if substring(e, 0, dot) == "1" { return 100; }
    let dec = substring(e, dot + 1, len(e));
    let d2 = if len(dec) >= 2 { substring(dec, 0, 2) } else { dec + "0" };
    return parse_int(d2);
}

// Promote a candidate ONE rung up the epcr ladder (comphet -> biallelic, etc.),
// reading the target epcr from the same epcr.yml the baseline reconciler uses
// (never a fabricated number). The top rung (biallelic) has no higher rung.
fn promote_row(row: string) -> string {
    // #2055 review: a novel-gene/incidental row must NOT climb into the
    // known_gene_* rungs — their epcr.yml labels assert panel membership the
    // row does not have. Lens agreement still orders it within its tier
    // (order_key sorts on agreement after epcr).
    if index_of(field(row, 11), "novel-gene") >= 0 { return row; }
    // #2060 review: an alternate representation mirrors its primary — it is
    // never promotable (from 0.15 the numeric ladder would land it on the
    // phenotype_novel_gene rung, whose label asserts NON-panel membership).
    if index_of(field(row, 11), "alternate representation") >= 0 { return row; }
    let cur = epcr_centi(row);
    let up = if cur >= 90 { "" }
        else { if cur >= 75 { epcr_for("known_gene_biallelic") }
        else { if cur >= 35 { epcr_for("known_gene_comphet") }
        else { if cur >= 20 { epcr_for("known_gene_monoallelic") }
        else { epcr_for("phenotype_novel_gene") } } } };
    if len(up) == 0 { return note_append(row, " [lens-promoted]"); }
    return note_append(set_field(row, 9, up), " [lens-promoted]");
}

// Lexicographic rank key: epcr DESC, then agreement DESC, then gene ASC. Built
// so sort_strings (ascending) yields the intended order; the key is stripped
// back off after the sort.
fn order_key(row: string, agree: int) -> string {
    return zpad(to_string(100 - epcr_centi(row)), 3) + "\t"
        + zpad(to_string(100 - agree), 3) + "\t"
        + first_token(field(row, 11));
}

// Proband sample name from the normalized VCF (mechanical), "PROBAND" fallback.
fn resolve_proband(nvcf: string) -> string {
    // #2066: the challenge scorer accepts only the dataset-documented literal
    // (e.g. PROBAND01), which need not equal the VCF sample name — the knob
    // wins when set; the sample name stays the default. The knob is hand-set
    // right before a real submission, so it is VALIDATED: a comma, tab,
    // newline or other exotic character would ride through the tab->comma
    // CSV join and bypass the column-count chokepoint (#2068 review).
    let knob = trim(getenv("MVA_PROBAND_ID"));
    if len(knob) > 0 {
        if regex_match("^[A-Za-z0-9_.-]+$", knob) { return knob; }
        print("resolve_proband: WARNING — MVA_PROBAND_ID contains unsafe characters; ignoring the knob and using the VCF sample name");
    }
    let bcftools = bcftools_bin();
    // colony-lint: safe-exec-concat
    let p0 = trim(exec sh shell_escape(bcftools) + " query -l " + shell_escape(nvcf) + " 2>/dev/null | head -1 || true");
    if len(p0) == 0 { return "PROBAND"; }
    return p0;
}

// ======================================================================
// stage 0 — coordinator: resolve inputs, seed the bus
// ======================================================================

// Resolve the proband VCF: explicit $MVA_VCF, else the single *.vcf.gz in
// $MVA_DATA_DIR. Bulk file discovery is mechanical (exec sh ls), the choice
// (exactly one, else refuse) is the decision.
fn resolve_vcf() -> string {
    let explicit = getenv("MVA_VCF");
    if len(explicit) > 0 { return explicit; }
    let dd = getenv("MVA_DATA_DIR");
    // colony-lint: safe-exec-concat
    let listing = exec sh "ls -1 " + shell_escape(dd) + "/*.vcf.gz 2>/dev/null || true";
    let nonempty = nonempty_lines(listing);
    if len(nonempty) == 1 { return get(nonempty, 0); }
    return "";
}

// Resolve the clinical .docx: explicit $MVA_PHENOTYPE_DOC, else single *.docx.
fn resolve_docx() -> string {
    let explicit = getenv("MVA_PHENOTYPE_DOC");
    if len(explicit) > 0 { return explicit; }
    let dd = getenv("MVA_DATA_DIR");
    // colony-lint: safe-exec-concat
    let listing = exec sh "ls -1 " + shell_escape(dd) + "/*.docx 2>/dev/null || true";
    let nonempty = nonempty_lines(listing);
    if len(nonempty) == 1 { return get(nonempty, 0); }
    return "";
}

agent coordinator() -> void {
    let vcf = resolve_vcf();
    let docx = resolve_docx();
    let ref = getenv("MVA_REF_FASTA");
    let wd = getenv("MVA_WORK_DIR");
    if len(vcf) == 0 {
        print("coordinator: ERROR — could not resolve exactly one proband VCF in MVA_DATA_DIR (set MVA_VCF). Refusing.");
        emit("baseline:abort", "no-vcf");
        return;
    }
    if len(ref) == 0 {
        print("coordinator: ERROR — MVA_REF_FASTA is empty (allowlist not wired?). Refusing.");
        emit("baseline:abort", "no-ref");
        return;
    }
    // GTF preflight (#2044). The panel stage derives its BED from the GTF via
    // a PLAIN-TEXT grep (panel_bed_line): an unset, missing, or gzipped GTF —
    // or one that resolves no panel symbol — used to sail through to a
    // silently EMPTY submission (0-record panel -> 0-candidate reconcile ->
    // degenerate CSV). Refuse HERE, before any expensive stage runs.
    let gtf = getenv("MVA_GTF");
    if len(trim(gtf)) == 0 {
        print("coordinator: ERROR — MVA_GTF is empty/unset (allowlist not wired, or GTF not provisioned — run fetch-reference-data.sh). Refusing: no-gtf");
        memo_write("baseline:abort_reason", "no-gtf");
        emit("baseline:abort", "no-gtf");
        return;
    }
    // colony-lint: safe-exec-concat
    let gtf_present = trim(exec sh "test -f " + shell_escape(gtf) + " && echo yes || echo no");
    if gtf_present != "yes" {
        print("coordinator: ERROR — MVA_GTF does not exist: ", gtf, " (run fetch-reference-data.sh or point MVA_GTF at a GENCODE GTF). Refusing: gtf-missing");
        memo_write("baseline:abort_reason", "gtf-missing");
        emit("baseline:abort", "gtf-missing");
        return;
    }
    if regex_match("\\.gz$", gtf) {
        print("coordinator: ERROR — MVA_GTF is gzip-compressed (", gtf, "); the panel lookup greps plain text and resolves NOTHING on a .gz. Decompress it (fetch-reference-data.sh does since #2044). Refusing: gtf-gzipped");
        memo_write("baseline:abort_reason", "gtf-gzipped");
        emit("baseline:abort", "gtf-gzipped");
        return;
    }
    // Every panel symbol must resolve through the SAME lookup the panel stage
    // uses — a wrong-assembly or truncated GTF fails loudly here, not as an
    // empty BED three stages later. mva-genes.tsv's own header row is not a
    // symbol.
    let cdir = getenv("COLONY_DIR");
    // colony-lint: safe-exec-concat
    let genes_raw = exec sh "grep -v '^#' " + shell_escape(cdir + "/settings/mva-genes.tsv") + " 2>/dev/null || true";
    let panel_genes = filter(map(nonempty_lines(genes_raw), |l: string| -> string { return field(l, 0); }),
        |g: string| -> bool { return g != "symbol"; });
    if len(panel_genes) == 0 {
        print("coordinator: ERROR — no panel symbols readable from settings/mva-genes.tsv. Refusing: empty-gene-panel");
        memo_write("baseline:abort_reason", "empty-gene-panel");
        emit("baseline:abort", "empty-gene-panel");
        return;
    }
    let unresolved = filter(panel_genes, |g: string| -> bool { return len(panel_bed_line(gtf, g, 0)) == 0; });
    if len(unresolved) > 0 {
        // NOTHING resolving is never overridable; a PARTIAL miss (gene-name
        // drift across GENCODE releases) can be waived with
        // MVA_PANEL_ALLOW_PARTIAL=1, so one renamed symbol cannot hard-stop an
        // otherwise-usable run under deadline.
        if len(unresolved) == len(panel_genes) {
            print("coordinator: ERROR — NO panel gene from mva-genes.tsv resolves in MVA_GTF (", join_str(unresolved, ","), ") — wrong or truncated GTF? Refusing: panel-genes-unresolved");
            memo_write("baseline:abort_reason", "panel-genes-unresolved");
            emit("baseline:abort", "panel-genes-unresolved");
            return;
        }
        if getenv("MVA_PANEL_ALLOW_PARTIAL") == "1" {
            print("coordinator: WARNING — ", len(unresolved), " panel gene(s) unresolvable in MVA_GTF (", join_str(unresolved, ","), ") — proceeding WITHOUT them on MVA_PANEL_ALLOW_PARTIAL=1");
        } else {
            print("coordinator: ERROR — ", len(unresolved), " panel gene(s) unresolvable in MVA_GTF (", join_str(unresolved, ","), ") — wrong or truncated GTF? Refusing: panel-genes-unresolved (set MVA_PANEL_ALLOW_PARTIAL=1 to proceed without them)");
            memo_write("baseline:abort_reason", "panel-genes-unresolved");
            emit("baseline:abort", "panel-genes-unresolved");
            return;
        }
    }
    // colony-lint: safe-exec-concat
    exec sh "mkdir -p " + shell_escape(wd) + "/preproc " + shell_escape(wd) + "/phenotype " + shell_escape(wd) + "/exomiser";
    emit("baseline:vcf", vcf);
    emit("baseline:docx", docx);
    emit("baseline:env", "ok");
    print("coordinator: resolved inputs; seeding pipeline");
}

// ======================================================================
// stage 1 — preprocessor: contig-rename + norm (bcftools bulk), .ag decides
// ======================================================================

// Build the rename-chrs map from the VCF header contig lines (decision).
fn build_rename_map(header: string) -> string {
    let lines = regex_split("\n", header);
    let contig_lines = filter(lines, |l: string| -> bool {
        return index_of(l, "##contig=<ID=") == 0;
    });
    return reduce(contig_lines, |acc: string, l: string| -> string {
        let id = regex_capture("##contig=<ID=([^,>]+)", l, 1);
        if len(id) == 0 { return acc; }
        return acc + id + " " + chr_name(id) + "\n";
    }, "");
}

agent preprocessor() -> void {
    let ok = bus_read("baseline:env");
    if ok != "ok" { print("preprocessor: no env — skipping"); return; }
    let vcf = bus_read("baseline:vcf");
    let ref = getenv("MVA_REF_FASTA");
    let wd = getenv("MVA_WORK_DIR");
    let bcftools = bcftools_bin();
    // The GRCh38 primary assembly (chr-prefixed, post-rename). Defaulted in-.ag
    // so a knob missing from exec.env_passthrough can NEVER collapse to
    // `bcftools view -t ''` (which silently drops every record); the operator
    // can still override via MVA_PRIMARY_CONTIGS.
    let primary = getenv_or("MVA_PRIMARY_CONTIGS", "chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY,chrM");

    // header is ~30 lines — the ONLY bulk-derived text .ag reads here.
    // colony-lint: safe-exec-concat
    let header = exec sh shell_escape(bcftools) + " view -h " + shell_escape(vcf) + " 2>/dev/null || true";
    let contigs = regex_find_all("##contig=<ID=", header);
    record_rows("preprocess", len(contigs));

    let rename = build_rename_map(header);
    let renamefile = wd + "/preproc/rename-chrs.txt";
    // colony-lint: safe-exec-concat
    exec sh "printf %s " + shell_escape(rename) + " > " + shell_escape(renamefile);

    let out = wd + "/preproc/normalized.vcf.gz";
    let stats = wd + "/preproc/norm.stats";
    // Bulk transform over ~5M records: rename contigs, keep primary assembly,
    // split multiallelics + left-align against the chr-prefixed reference, then
    // re-sort (left-align can shift a POS leftward and unsort it, which would
    // break `index -t`). `-c w` WARNS on a REF mismatch (never silently
    // accepts) — a mismatch is the signature of the wrong assembly / bad rename.
    // FILTER is preserved (never `-f PASS`): the hard filters drop exactly the
    // low-VAF mosaic records the panel review looks for.
    // colony-lint: safe-exec-concat
    let cmd = shell_escape(bcftools) + " annotate --rename-chrs " + shell_escape(renamefile) + " " + shell_escape(vcf)
        + " 2>/dev/null | " + shell_escape(bcftools) + " view -t " + shell_escape(primary)
        + " 2>/dev/null | " + shell_escape(bcftools) + " norm -m -any -f " + shell_escape(ref) + " -c w -Oz 2> "
        + shell_escape(stats) + " | " + shell_escape(bcftools) + " sort -Oz -o " + shell_escape(out)
        + " 2>/dev/null ; " + shell_escape(bcftools) + " index -t "
        + shell_escape(out) + " 2>/dev/null ; echo __rc=$?";
    // colony-lint: safe-exec-concat
    let run = exec sh cmd;

    // Post-condition (decision): refuse on any REF mismatch. bcftools norm -c w
    // reports a "ref mismatch" count to stderr; extract the leading integer.
    // colony-lint: safe-exec-concat
    let mism = exec sh "grep -oiE '[0-9]+ +[a-z ]*ref mismatch' " + shell_escape(stats) + " 2>/dev/null | grep -oE '^[0-9]+' | head -1 || true";
    let mismatches = parse_int(trim(mism));
    if mismatches > 0 {
        print("preprocessor: REFUSING — ", mismatches, " REF mismatch(es) after norm (wrong assembly / bad contig rename). See", stats);
        emit("baseline:abort", "ref-mismatch");
        return;
    }

    // Post-condition (decision): refuse when ZERO records survived rename +
    // contig filter + norm. An empty normalized VCF is the silent-inert failure
    // (empty contig list, wrong contig names, unwritable ref) that would
    // otherwise sail through to a header-only CSV — a scored zero. The
    // REF-mismatch guard above passes vacuously on zero records, so this is the
    // guard that actually bites the empty case.
    // colony-lint: safe-exec-concat
    let nrec = trim(exec sh shell_escape(bcftools) + " view -H " + shell_escape(out) + " 2>/dev/null | head -1 | wc -l || echo 0");
    if parse_int(nrec) <= 0 {
        print("preprocessor: REFUSING — zero records survived rename + primary-contig filter + norm (empty MVA_PRIMARY_CONTIGS, wrong contig names, or unreadable reference). See", stats);
        emit("baseline:abort", "empty-after-filter");
        return;
    }
    print("preprocessor: normalized VCF written (FILTER preserved, primary contigs, left-aligned)");
    // The normalized-VCF path is read by FOUR downstream stages (phenotyper,
    // exomiser_runner, panel_reviewer, emitter). `listen` is consume-once
    // (a queue, not a broadcast), so only the first listener would get it and
    // the rest would crash on a void. Publish the path on the memo (broadcast,
    // re-readable) for the fan-out reads; keep the single emit/listen edge for
    // the phenotyper proceed-signal.
    memo_write("baseline:nvcf", out);
    emit("baseline:normalized_vcf", out);
}

// ======================================================================
// stage 2 — phenotyper: HPO derivation + the D6 hash-pinned operator gate
// ======================================================================

// Extract the free-text runs from the docx XML (<w:t>...</w:t>). The unzip is
// mechanical; the regex extraction + join is .ag. ~200-600 short runs.
fn docx_text(docx: string) -> string {
    // colony-lint: safe-exec-concat
    let xml = exec sh "unzip -p " + shell_escape(docx) + " word/document.xml 2>/dev/null || true";
    let runs = regex_find_all("<w:t[^>]*>([^<]*)</w:t>", xml);
    let texts = map(runs, |r: string| -> string {
        return regex_capture("<w:t[^>]*>([^<]*)</w:t>", r, 1);
    });
    return join_str(texts, " ");
}

// Verify a proposed HP id exists in hp.obo (mechanical grep, .ag decides).
fn hp_exists(id: string) -> bool {
    let obo = getenv("MVA_HPO_OBO");
    if len(obo) == 0 { return false; }
    // colony-lint: safe-exec-concat
    let hit = exec sh "grep -c -F " + shell_escape("id: " + id) + " " + shell_escape(obo) + " 2>/dev/null || echo 0";
    return parse_int(trim(hit)) > 0;
}

agent phenotyper() -> void {
    let nvcf = bus_read("baseline:normalized_vcf");
    if len(nvcf) == 0 { print("phenotyper: no normalized VCF — upstream aborted"); return; }
    let docx = bus_read("baseline:docx");
    let wd = getenv("MVA_WORK_DIR");
    if len(docx) == 0 {
        print("phenotyper: ERROR — no clinical .docx resolved; cannot derive phenotype. Refusing.");
        emit("baseline:abort", "no-docx");
        return;
    }
    let text = docx_text(docx);
    record_rows("phenotype", len(regex_find_all("<w:t", text)) + 1);

    // Derive candidate HPO ids from the phenotype text (LLM decision). The
    // prompt asks for a compact list; every id is then mechanically verified
    // against hp.obo, so an hallucinated id is dropped rather than trusted.
    let reply = prompt("You are a clinical geneticist. From the phenotype description below, list the most specific Human Phenotype Ontology terms that apply. Reply with one line per phenotype, each line an HPO id (the 'HP:' prefix followed by exactly seven digits), then a TAB, then the term label — nothing else, no prose.", text) -> string;
    let proposed = regex_find_all("HP:[0-9]{7}", reply);
    let verified = filter(proposed, |id: string| -> bool { return hp_exists(id); });
    let ids = sort_unique_strings(verified);
    record_rows("phenotype-hpo", len(ids));

    let draft = join_str(ids, ",");
    let draftfile = wd + "/phenotype/hpo-draft.txt";
    // The draft FILE carries a trailing newline, and the operator approves by
    // hashing that file (`sha256sum draftfile`). The gate must therefore hash
    // the SAME bytes — `draft + "\n"` — or the hashes never match and the gate
    // is fail-closed forever. Mutating the HPO payload changes `draft`, so the
    // hash still moves: the gate stays real, not theatre.
    let file_bytes = draft + "\n";
    // colony-lint: safe-exec-concat
    exec sh "printf %s " + shell_escape(file_bytes) + " > " + shell_escape(draftfile);
    let draft_hash = sha256_hex(file_bytes);
    print("phenotyper: HPO draft written (", len(ids), " verified terms) ->", draftfile);

    // An EMPTY phenotype set must never reach the operator gate. With no LLM
    // backend wired (agentis init defaults to llm.backend = mock) prompt()
    // returns nothing, the draft is one byte, and the run then prints
    // copy-pasteable approval instructions FOR THAT EMPTY DRAFT. Approving them
    // yields a complete, schema-valid submission CSV built on zero phenotype
    // evidence, with nothing anywhere saying so — a confident wrong answer,
    // which is worse than a crash. Refuse instead, and name the likely cause.
    if len(ids) == 0 {
        print("phenotyper: REFUSING — zero HPO terms were extracted and verified.");
        print("  A submission built on an empty phenotype set would look valid and be meaningless,");
        print("  so this run stops here rather than offering the draft for approval.");
        print("  Most likely cause: no real LLM backend is wired. `agentis init` defaults to");
        print("  llm.backend = mock, whose prompt() returns nothing. Check .agentis/config and");
        print("  see doc/methods.md on configuring the backend.");
        print("  Other causes: an empty or unreadable clinical document ($MVA_PHENOTYPE_DOC),");
        print("  or an hp.obo that verified none of the extracted terms.");
        memo_write("baseline:abort_reason", "phenotype-empty");
        emit("baseline:abort", "phenotype-empty");
        return;
    }

    // --- D6 operator review gate (hash-pinned) --------------------------
    // The pipeline STOPS here until an operator reviews hpo-draft.txt and
    // writes the SHA-256 of the reviewed draft into $MVA_APPROVAL_FILE.
    // Editing the draft after approval changes its hash and re-arms the gate,
    // so approval can never be silently stale (D6, strengthened).
    let approval_file = getenv_or("MVA_APPROVAL_FILE", wd + "/phenotype/hpo-approved.txt");
    // colony-lint: safe-exec-concat
    let approved_hash = trim(exec sh "cat " + shell_escape(approval_file) + " 2>/dev/null || true");
    if approved_hash != draft_hash {
        print("phenotyper: REVIEW GATE — HPO set is NOT approved for this draft.");
        print("  1. Review the HPO draft:   ", draftfile);
        print("  2. Approve by storing its hash (this exact draft's hash is", draft_hash, "):");
        print("       sha256sum", draftfile, "| cut -d' ' -f1 >", approval_file);
        print("  3. Re-run ./scripts/start-colony.sh to resume.");
        memo_write("pipeline:gate", "blocked");
        emit("baseline:abort", "hpo-unapproved");
        return;
    }
    print("phenotyper: HPO set approved (hash matches) — proceeding");
    memo_write("pipeline:gate", "approved");
    // M3: broadcast the approved HPO set so the HPO-overlap lens can re-read it
    // (memo, not the consume-once baseline:hpo_ids emit). Gated behind lens mode
    // so the baseline path writes nothing extra.
    if lens_mode() { memo_write("lens:hpo", draft); }
    emit("baseline:hpo_ids", draft);
}

// ======================================================================
// stage 3 — exomiser_runner: render YAML, idempotent run (blocking, N4)
// ======================================================================

// Render the analysis YAML from settings/exomiser-analysis.template.yml.
// `failedVariantFilter` is rendered EMPTY (D4) so hard-filter-FAILED records
// survive into the ranking.
fn render_analysis(assembly: string, vcf: string, proband: string, hpo_quoted: string, outdir: string, prefix: string) -> string {
    let cdir = getenv("COLONY_DIR");
    // colony-lint: safe-exec-concat
    let tmpl = exec sh "cat " + shell_escape(cdir + "/settings/exomiser-analysis.template.yml") + " 2>/dev/null || true";
    let a = replace_all(tmpl, "{{ASSEMBLY}}", assembly);
    let b = replace_all(a, "{{VCF}}", vcf);
    let c = replace_all(b, "{{PROBAND}}", proband);
    let d = replace_all(c, "{{HPO_IDS}}", hpo_quoted);
    let e = replace_all(d, "{{FAILED_VARIANT_FILTER}}", "");
    let f = replace_all(e, "{{OUTPUT_DIR}}", outdir);
    return replace_all(f, "{{OUTPUT_PREFIX}}", prefix);
}

agent exomiser_runner() -> void {
    // OPT-IN gate (default OFF), checked FIRST — before any listen(), so the
    // default path returns without touching the (possibly unemitted) hpo_ids
    // channel. Since #2054 the reconciler CONSUMES baseline:exomiser_tsv
    // (novel-gene merge into the EPCR ladder), so flipping MVA_RUN_EXOMISER=1
    // is now worth the hour-scale run. The default stays OFF only because of
    // that runtime cost — the operator launch script is the place to enable it.
    if getenv_or("MVA_RUN_EXOMISER", "0") != "1" {
        print("exomiser_runner: SKIP — Exomiser stage is opt-in (set MVA_RUN_EXOMISER=1). Since #2054 its top-N merges into the reconciler.");
        return;
    }
    let hpo = bus_read("baseline:hpo_ids");
    if len(hpo) == 0 { print("exomiser_runner: no approved HPO set — upstream gated/aborted"); return; }
    let nvcf = recall_latest("baseline:nvcf");
    let wd = getenv("MVA_WORK_DIR");
    let exomiser = getenv_or("MVA_EXOMISER", "exomiser");
    let assembly = getenv_or("MVA_EXOMISER_ASSEMBLY", "hg38");
    let bcftools = bcftools_bin();
    let outdir = wd + "/exomiser";
    let prefix = "baseline";

    // proband sample name from the normalized VCF (mechanical), 1 value.
    // colony-lint: safe-exec-concat
    let proband = trim(exec sh shell_escape(bcftools) + " query -l " + shell_escape(nvcf) + " 2>/dev/null | head -1 || true");

    // Quote each HPO id for the YAML list.
    let ids = regex_split(",", hpo);
    let quoted = map(ids, |i: string| -> string { return "'" + i + "'"; });
    let hpo_quoted = join_str(quoted, ", ");

    let analysis = render_analysis(assembly, nvcf, proband, hpo_quoted, outdir, prefix);
    let analysisfile = wd + "/exomiser/analysis.yml";
    // colony-lint: safe-exec-concat
    exec sh "printf %s " + shell_escape(analysis) + " > " + shell_escape(analysisfile);
    record_rows("exomiser", 1);

    // Idempotency: hash the input manifest (vcf + hpo + assembly). Skip a
    // completed run whose marker matches (N4 idempotent skip).
    let manifest = nvcf + "|" + hpo + "|" + assembly;
    let mhash = sha256_hex(manifest);
    let marker = wd + "/exomiser/.done." + mhash;
    // colony-lint: safe-exec-concat
    let done = trim(exec sh "test -f " + shell_escape(marker) + " && echo yes || echo no");
    let tsv = outdir + "/" + prefix + ".variants.tsv";
    if done == "yes" {
        print("exomiser_runner: idempotent skip — completed run for this manifest exists");
        emit("baseline:exomiser_tsv", tsv);
        return;
    }

    // Blocking run with an explicit inline timeout (N4). EXOMISER_TIMEOUT_MS is
    // a millisecond budget; the agentis inline `timeout` keyword bounds the exec
    // (6 h hard ceiling), and the shell `timeout Ns` inside honours the operator
    // knob within that ceiling.
    let tms = parse_int(getenv("EXOMISER_TIMEOUT_MS"));
    let tsec = if tms <= 0 { 21600 } else { tms / 1000 };
    // colony-lint: safe-exec-concat
    let run = exec sh timeout 21700000 "timeout " + shell_escape(to_string(tsec)) + "s " + shell_escape(exomiser)
        + " --analysis " + shell_escape(analysisfile) + " 2>&1; echo __rc=$?";
    let rc = parse_int(regex_capture("__rc=([0-9]+)", run, 1));
    if rc != 0 {
        print("exomiser_runner: Exomiser exited rc=", rc, " (timeout or error). Refusing to trust partial output.");
        emit("baseline:abort", "exomiser-failed");
        return;
    }
    // Verify the output parses (non-empty TSV) before trusting it.
    // colony-lint: safe-exec-concat
    let lines = trim(exec sh "wc -l < " + shell_escape(tsv) + " 2>/dev/null || echo 0");
    if parse_int(lines) <= 0 {
        print("exomiser_runner: Exomiser produced no variants TSV — refusing");
        emit("baseline:abort", "exomiser-empty");
        return;
    }
    // colony-lint: safe-exec-concat
    exec sh "touch " + shell_escape(marker);
    print("exomiser_runner: run complete (", lines, " TSV lines)");
    emit("baseline:exomiser_tsv", tsv);
}

// ======================================================================
// stage 4 — panel_reviewer: per-variant reasoning incl. FILTER-FAILED records
// ======================================================================

// Derive the panel BED line for one gene from the GTF (grep mechanical; the
// span + padding is the decision). One region per gene.
fn panel_bed_line(gtf: string, gene: string, pad: int) -> string {
    // colony-lint: safe-exec-concat
    let gline = exec sh "grep -F " + shell_escape("gene_name \"" + gene + "\"") + " " + shell_escape(gtf)
        + " 2>/dev/null | grep -P '\\tgene\\t' | head -1 || true";
    if len(gline) == 0 { return ""; }
    let chrom = field(gline, 0);
    let start0 = parse_int(field(gline, 3)) - pad;
    let start = if start0 < 0 { 0 } else { start0 };
    let end = parse_int(field(gline, 4)) + pad;
    return chrom + "\t" + to_string(start) + "\t" + to_string(end) + "\t" + gene;
}

// Classify a single panel record. AD is "ref,alt"; VAF = alt/(ref+alt).
// Returns a TSV row: chrom pos ref alt filter gt vaf gene zygosity.
fn classify_record(line: string, gene: string) -> string {
    let chrom = field(line, 0);
    let pos = field(line, 1);
    let ref = field(line, 2);
    let alt = field(line, 3);
    let flt = field(line, 4);
    let gt = field(line, 5);
    let ad = field(line, 6);
    let refc = parse_int(regex_capture("([0-9]+),", ad, 1));
    let altc = parse_int(regex_capture(",([0-9]+)", ad, 1));
    let depth = refc + altc;
    let vaf = if depth > 0 { to_string(parse_float(to_string(altc)) / parse_float(to_string(depth))) } else { "NA" };
    let zyg = if index_of(gt, "1/1") >= 0 { "hom-alt" } else { if index_of(gt, "1|1") >= 0 { "hom-alt" } else { "het" } };
    return chrom + "\t" + pos + "\t" + ref + "\t" + alt + "\t" + flt + "\t" + gt + "\t" + vaf + "\t" + gene + "\t" + zyg;
}

// Which panel gene's region does (chrom,pos) fall in? "" if none.
fn gene_at(gene_lines: list<string>, gtf: string, pad: int, chrom: string, pos: int) -> string {
    return reduce(gene_lines, |acc: string, gl: string| -> string {
        if len(acc) > 0 { return acc; }
        let bl = panel_bed_line(gtf, field(gl, 0), pad);
        if len(bl) == 0 { return acc; }
        if field(bl, 0) != chrom { return acc; }
        let s = parse_int(field(bl, 1));
        let e = parse_int(field(bl, 2));
        if pos >= s { if pos <= e { return field(gl, 0); } }
        return acc;
    }, "");
}

agent panel_reviewer() -> void {
    let nvcf = recall_latest("baseline:nvcf");
    if len(nvcf) == 0 { print("panel_reviewer: no normalized VCF — skipping"); return; }
    let wd = getenv("MVA_WORK_DIR");
    let cdir = getenv("COLONY_DIR");
    let gtf = getenv("MVA_GTF");
    let bcftools = bcftools_bin();
    let pad0 = parse_int(getenv("PANEL_PAD"));
    let pad = if pad0 <= 0 { 5000 } else { pad0 };

    // Read the known-gene panel (a handful of rows).
    // colony-lint: safe-exec-concat
    let genes_raw = exec sh "grep -v '^#' " + shell_escape(cdir + "/settings/mva-genes.tsv") + " 2>/dev/null || true";
    let gene_lines = nonempty_lines(genes_raw);
    let genes = map(gene_lines, |l: string| -> string { return field(l, 0); });

    // Build the panel BED (one region per gene) — decision-shaped.
    let bed = reduce(genes, |acc: string, g: string| -> string {
        let bl = panel_bed_line(gtf, g, pad);
        if len(bl) == 0 { return acc; }
        return acc + bl + "\n";
    }, "");
    // Belt-and-braces to the coordinator's #2044 GTF preflight: an empty BED
    // here means EVERY gene lookup failed (GTF replaced/moved between stages,
    // or a panel edit) — bcftools view -R over an empty BED matches 0 records
    // and the run would end as a silently EMPTY submission.
    if len(trim(bed)) == 0 {
        print("panel_reviewer: REFUSING — panel BED is empty (no gene from settings/mva-genes.tsv resolved in MVA_GTF): empty-panel-bed");
        memo_write("baseline:abort_reason", "empty-panel-bed");
        emit("baseline:abort", "empty-panel-bed");
        return;
    }
    let bedfile = wd + "/preproc/panel.bed";
    // colony-lint: safe-exec-concat
    exec sh "printf %s " + shell_escape(bed) + " > " + shell_escape(bedfile);

    // Pull panel records — NO `-f PASS`, so hard-filter-FAILED records survive.
    // colony-lint: safe-exec-concat
    let recs = exec sh shell_escape(bcftools) + " view -R " + shell_escape(bedfile) + " " + shell_escape(nvcf)
        + " 2>/dev/null | " + shell_escape(bcftools) + " query -f '%CHROM\\t%POS\\t%REF\\t%ALT\\t%FILTER[\\t%GT\\t%AD]\\n' 2>/dev/null || true";
    let rec_lines = nonempty_lines(recs);
    record_rows("panel", len(rec_lines));
    // Stage 1 already refused an empty normalized VCF, so 0 panel records over
    // a NON-EMPTY VCF is a data mismatch (contig naming / assembly disagreement
    // between the VCF and the GTF-derived panel), never a valid result (#2044).
    if len(rec_lines) == 0 {
        print("panel_reviewer: REFUSING — 0 panel records over a non-empty normalized VCF (contig-naming/assembly mismatch between the VCF and the GTF-derived panel, or a failed `bcftools view -R` — e.g. a missing .tbi index; its stderr is swallowed above): panel-zero-records");
        memo_write("baseline:abort_reason", "panel-zero-records");
        emit("baseline:abort", "panel-zero-records");
        return;
    }
    if len(rec_lines) > 500 {
        print("panel_reviewer: REFUSING — ", len(rec_lines), " records exceed the .ag boundary limit (500).");
        emit("baseline:abort", "panel-too-wide");
        return;
    }

    // Tag each record with the gene whose region it fell in, then classify.
    let classified = map(rec_lines, |line: string| -> string {
        let gene = gene_at(gene_lines, gtf, pad, field(line, 0), parse_int(field(line, 1)));
        if len(gene) == 0 { return ""; }
        return classify_record(line, gene);
    });
    let hits = filter(classified, |r: string| -> bool { return len(r) > 0; });
    let panel_tsv = wd + "/panel-review.tsv";
    // colony-lint: safe-exec-concat
    exec sh "printf %s " + shell_escape(join_str(hits, "\n") + "\n") + " > " + shell_escape(panel_tsv);
    print("panel_reviewer: ", len(hits), " panel record(s) reviewed (FILTER-failed included)");
    emit("baseline:panel_hits", panel_tsv);
}

// ======================================================================
// stage 5 — reconciler: EPCR evidence-tier ladder, dedup, cap at 10
// ======================================================================

// The epcr.yml block for a tier id (grep mechanical; reading the field is .ag).
fn tier_block(tier_id: string) -> string {
    let cdir = getenv("COLONY_DIR");
    // colony-lint: safe-exec-concat
    return exec sh "grep -A2 -F " + shell_escape("id: " + tier_id) + " " + shell_escape(cdir + "/settings/epcr.yml") + " 2>/dev/null || true";
}

fn epcr_for(tier_id: string) -> string {
    return trim(regex_capture("epcr:[ ]*([0-9.]+)", tier_block(tier_id), 1));
}


// --- #2054: Exomiser top-N merge (novel genes the panel cannot see) --------

// Index of a named column in a tab-separated header (0 - 1 when absent) —
// Exomiser's column layout varies by version, so never hardcode positions.
fn col_idx_rec(cols: list<string>, name: string, i: int) -> int {
    if i >= len(cols) { return 0 - 1; }
    if get(cols, i) == name { return i; }
    return col_idx_rec(cols, name, i + 1);
}
fn col_idx(hdr: string, name: string) -> int {
    return col_idx_rec(regex_split("\t", hdr), name, 0);
}

// Append-concat two lists (push-recursion; reduce is only exercised with
// string accumulators in this file, so stay with the take_acc idiom).
fn concat_rec(xs: list<string>, i: int, acc: list<string>) -> list<string> {
    if i >= len(xs) { return acc; }
    return concat_rec(xs, i + 1, push(acc, get(xs, i)));
}

// Resolve the Exomiser variants TSV: the bus emit when the stage ran this
// pass, else the canonical output path (survives the D6 two-pass flow and is
// plantable by the live test). "" = no Exomiser output -> panel-only
// reconcile, byte-identical to the pre-#2054 submission. Removing
// $MVA_WORK_DIR/exomiser/ is the documented way to force panel-only.
fn exomiser_tsv_path(wd: string) -> string {
    let bus = bus_read("baseline:exomiser_tsv");
    if len(bus) > 0 { return bus; }
    let canonical = wd + "/exomiser/baseline.variants.tsv";
    // Manifest-pinned fallback (#2055 review): only trust a canonical TSV
    // whose .done.<mhash> marker matches THIS run's inputs — the same
    // nvcf|hpo|assembly manifest exomiser_runner hashes. An Exomiser output
    // computed for an earlier HPO set / VCF must never silently merge into a
    // submission claiming the new approved phenotype. The bus hpo payload is
    // the draft WITHOUT the file's trailing newline, hence the trim.
    let nvcf = recall_latest("baseline:nvcf");
    // colony-lint: safe-exec-concat
    let hpo = trim(exec sh "cat " + shell_escape(wd + "/phenotype/hpo-draft.txt") + " 2>/dev/null || true");
    let assembly = getenv_or("MVA_EXOMISER_ASSEMBLY", "hg38");
    let mhash = sha256_hex(nvcf + "|" + hpo + "|" + assembly);
    let marker = wd + "/exomiser/.done." + mhash;
    // colony-lint: safe-exec-concat
    let ok = trim(exec sh "test -f " + shell_escape(marker) + " && test -s " + shell_escape(canonical) + " && echo yes || echo no");
    if ok == "yes" { return canonical; }
    return "";
}

// One Exomiser data row -> ONE candidate row for a gene outside the panel.
// The tier comes from the evidence ladder, never from the score itself:
// Exomiser's combined score is a RANKING score, not a probability (epcr.yml
// is explicit about this) — the score only picks the rung (>= min_score ->
// phenotype_novel_gene, primary; below -> incidental, secondary) and is
// quoted in the notes for transparency. "" = malformed row, skip.
fn exo_candidate_row(r: string, g: string, ic: int, ip: int, ir: int, ia: int, isc: int, minscore: float) -> string {
    // #2055 review hardening: one bad row must SKIP, never poison the whole
    // submission. Exomiser may write UNPREFIXED contig names (svart assembly
    // ids) -> chr_name-normalize and drop non-primary contigs; symbolic
    // alleles (<DEL>), non-numeric positions, and comma-carrying gene symbols
    // (readthrough annotations) would either fail validate_row — which
    // short-circuits the ENTIRE emit — or corrupt the bare tab->comma CSV.
    let rawc = trim(field(r, ic));
    // PLINK-style numeric sex chromosomes some tool builds emit.
    let mappedc = if rawc == "23" { "X" } else { if rawc == "24" { "Y" } else { rawc } };
    let chrom = chr_name(mappedc);
    if !is_primary_contig(chrom) { return ""; }
    let pos = trim(field(r, ip));
    if !regex_match("^[0-9]+$", pos) { return ""; }
    let rf = trim(field(r, ir));
    let al = trim(field(r, ia));
    if !regex_match("^[ACGTNacgtn]+$", rf) { return ""; }
    if !regex_match("^[ACGTNacgtn]+$", al) { return ""; }
    if index_of(g, ",") >= 0 { return ""; }
    let score = parse_float(trim(field(r, isc)));
    if score >= minscore {
        return "PROBAND\t" + chrom + "\t" + pos + "\t" + rf + "\t" + al + "\t\t\t\t\t"
            + epcr_for("phenotype_novel_gene") + "\tprimary\t" + g
            + " phenotype-driven novel-gene candidate (Exomiser combined score " + to_string(score) + ")";
    }
    return "PROBAND\t" + chrom + "\t" + pos + "\t" + rf + "\t" + al + "\t\t\t\t\t"
        + epcr_for("incidental") + "\tsecondary\t" + g
        + " incidental novel-gene (Exomiser combined score " + to_string(score) + " below threshold)";
}

// Rank-ordered walk over the TSV lines (index 0 is the header): ONE variant
// per NEW gene — `seen` starts as the whole panel, so panel genes are never
// duplicated — and at most `left` rows (the global cap's leftover).
fn exo_fold(lines: list<string>, i: int, seen: string, acc: list<string>, ig: int, ic: int, ip: int, ir: int, ia: int, isc: int, minscore: float, left: int) -> list<string> {
    if left <= 0 { return acc; }
    if i >= len(lines) { return acc; }
    let r = get(lines, i);
    let g = trim(field(r, ig));
    if len(g) == 0 { return exo_fold(lines, i + 1, seen, acc, ig, ic, ip, ir, ia, isc, minscore, left); }
    if index_of(seen, "|" + g + "|") >= 0 { return exo_fold(lines, i + 1, seen, acc, ig, ic, ip, ir, ia, isc, minscore, left); }
    let cand = exo_candidate_row(r, g, ic, ip, ir, ia, isc, minscore);
    if len(cand) == 0 { return exo_fold(lines, i + 1, seen, acc, ig, ic, ip, ir, ia, isc, minscore, left); }
    // #2055 review: the emitter refuses duplicate chrom_1:pos_1 keys and that
    // refusal kills the WHOLE submission — so the registry also tracks variant
    // keys (seeded with the panel's own), catching readthrough symbols
    // (BUB1B-PAK6) and PANEL_PAD overlaps that carry a different gene name.
    let key = field(cand, 1) + ":" + field(cand, 2);
    if index_of(seen, "|" + key + "|") >= 0 { return exo_fold(lines, i + 1, seen, acc, ig, ic, ip, ir, ia, isc, minscore, left); }
    return exo_fold(lines, i + 1, seen + g + "|" + key + "|", push(acc, cand), ig, ic, ip, ir, ia, isc, minscore, left - 1);
}

// The #2054 merge: bounded read (rank order is file order, so head keeps the
// top), header-driven column resolution, panel precedence via `seen`.
fn exomiser_candidates(tsv: string, panel_genes: list<string>, panel_keys: string, left: int) -> list<string> {
    // head -200: bounds the .ag read (well under the 500-row boundary) while
    // leaving room for numGenes:0 outputs where one gene owns dozens of rows.
    // colony-lint: safe-exec-concat
    let raw = exec sh "head -200 " + shell_escape(tsv) + " 2>/dev/null || true";
    let lines = nonempty_lines(raw);
    let none = filter(lines, |x: string| -> bool { return false; });
    if len(lines) < 2 { return none; }
    let hdr = get(lines, 0);
    let ig = col_idx(hdr, "GENE_SYMBOL");
    let ic = col_idx(hdr, "CONTIG");
    let ip = col_idx(hdr, "START");
    let ir = col_idx(hdr, "REF");
    let ia = col_idx(hdr, "ALT");
    let isc = col_idx(hdr, "EXOMISER_GENE_COMBINED_SCORE");
    if ig < 0 { print("reconciler: Exomiser TSV lacks GENE_SYMBOL — skipping merge"); return none; }
    if ic < 0 { print("reconciler: Exomiser TSV lacks CONTIG — skipping merge"); return none; }
    if ip < 0 { print("reconciler: Exomiser TSV lacks START — skipping merge"); return none; }
    if ir < 0 { print("reconciler: Exomiser TSV lacks REF — skipping merge"); return none; }
    if ia < 0 { print("reconciler: Exomiser TSV lacks ALT — skipping merge"); return none; }
    if isc < 0 { print("reconciler: Exomiser TSV lacks EXOMISER_GENE_COMBINED_SCORE — skipping merge"); return none; }
    let minscore = parse_float(yaml_num(epcr_yml(), "phenotype_novel_gene_min_score", "0.7"));
    let seen = "|" + join_str(panel_genes, "|") + "|" + panel_keys;
    record_rows("exo_merge", len(lines) - 1);
    let picked = exo_fold(lines, 1, seen, none, ig, ic, ip, ir, ia, isc, minscore, left);
    // Operator observability on an hour-scale run: say how much of the TSV was
    // actually understood, not just how much merged.
    print("reconciler: Exomiser TSV — ", len(lines) - 1, " row(s) examined, ", len(picked), " merged (rest skipped: panel-owned / dup-key / contig / allele / malformed)");
    return picked;
}


// --- #2059: representative-variant selection for panel genes ---------------

// Exomiser-ranked variant keys ("chrom:pos", best first) for one panel gene;
// "" when the TSV lacks the needed columns. Ordering EVIDENCE only — the
// tiers stay ladder-driven.
fn exo_gene_keys(tsv: string, gene: string) -> string {
    // colony-lint: safe-exec-concat
    let raw = exec sh "head -200 " + shell_escape(tsv) + " 2>/dev/null || true";
    let lines = nonempty_lines(raw);
    if len(lines) < 2 { return ""; }
    let hdr = get(lines, 0);
    let ig = col_idx(hdr, "GENE_SYMBOL");
    let ic = col_idx(hdr, "CONTIG");
    let ip = col_idx(hdr, "START");
    if ig < 0 { return ""; }
    if ic < 0 { return ""; }
    if ip < 0 { return ""; }
    let mine = filter(lines, |l: string| -> bool { return trim(field(l, ig)) == gene; });
    return join_str(map(mine, |l: string| -> string {
        let rawc = trim(field(l, ic));
        let mappedc = if rawc == "23" { "X" } else { if rawc == "24" { "Y" } else { rawc } };
        return chr_name(mappedc) + ":" + trim(field(l, ip));
    }), "\n");
}

// First hit whose chrom:pos matches the best-ranked key, skipping `excl`
// ("" = no exclusion); "" when nothing matches any key.
fn first_by_exo(hits: list<string>, keys: list<string>, i: int, excl: string) -> string {
    if i >= len(keys) { return ""; }
    let k = get(keys, i);
    let m = filter(hits, |h: string| -> bool {
        if h == excl { return false; }
        return field(h, 0) + ":" + field(h, 1) == k;
    });
    if len(m) > 0 { return get(m, 0); }
    return first_by_exo(hits, keys, i + 1, excl);
}

// Representative pick: Exomiser-ranked when the evidence covers the pool,
// else positional (the pre-#2059 behaviour), always excluding `excl`.
fn pick_rep(pool: list<string>, keys: list<string>, excl: string) -> string {
    let byexo = first_by_exo(pool, keys, 0, excl);
    if len(byexo) > 0 { return byexo; }
    let rest = filter(pool, |h: string| -> bool { return h != excl; });
    if len(rest) > 0 { return get(rest, 0); }
    return "";
}

// Row builders for the two representations (single-variant / comphet pair).
fn single_row(g: string, v: string, tier: string, ft: string, note: string) -> string {
    return "PROBAND\t" + field(v,0) + "\t" + field(v,1) + "\t" + field(v,2) + "\t" + field(v,3)
        + "\t\t\t\t\t" + epcr_for(tier) + "\t" + ft + "\t" + g + note;
}
fn pair_row(g: string, a: string, b: string, tier: string, ft: string, note: string) -> string {
    return "PROBAND\t" + field(a,0) + "\t" + field(a,1) + "\t" + field(a,2) + "\t" + field(a,3)
        + "\t" + field(b,0) + "\t" + field(b,1) + "\t" + field(b,2) + "\t" + field(b,3)
        + "\t" + epcr_for(tier) + "\t" + ft + "\t" + g + note;
}


// #2064: within-tier ordering evidence. Rank = index of the gene's FIRST row
// in the rank-ordered Exomiser output; 999 when the gene is absent or there
// is no TSV — those fall back to the deterministic text tie-break AFTER
// every ranked gene. Implements epcr.yml's documented "the Exomiser score is
// used only to order candidates WITHIN a tier".
//
// The rank SOURCE is resolved ONCE per reconcile (#2065 review): prefer the
// GENES TSV (one row per gene in rank order — no truncation risk, ~50x
// smaller scan) derived from the variants path; fall back to the variants
// window when the genes file is absent (older outputs, planted test TSVs).
fn exo_rank_lines(tsv: string) -> list<string> {
    if len(tsv) == 0 { return nonempty_lines(""); }
    let gtsv = replace_all(tsv, ".variants.tsv", ".genes.tsv");
    // Guard both fallback conditions (#2065 review): a path not ending
    // .variants.tsv leaves gtsv == tsv (skip the genes branch), and a genes
    // file without a GENE_SYMBOL column must fall through to the variants
    // window instead of pinning ig = -1.
    if gtsv != tsv {
        // colony-lint: safe-exec-concat
        let raw = exec sh "head -100 " + shell_escape(gtsv) + " 2>/dev/null || true";
        let lines = nonempty_lines(raw);
        if len(lines) >= 2 {
            if col_idx(get(lines, 0), "GENE_SYMBOL") >= 0 { return lines; }
        }
    }
    // colony-lint: safe-exec-concat
    let raw2 = exec sh "head -200 " + shell_escape(tsv) + " 2>/dev/null || true";
    return nonempty_lines(raw2);
}
fn exo_gene_rank_rec(lines: list<string>, ig: int, gene: string, i: int) -> int {
    if i >= len(lines) { return 999; }
    if trim(field(get(lines, i), ig)) == gene { return i; }
    return exo_gene_rank_rec(lines, ig, gene, i + 1);
}
fn exo_gene_rank(lines: list<string>, ig: int, gene: string) -> int {
    if ig < 0 { return 999; }
    return exo_gene_rank_rec(lines, ig, gene, 1);
}

agent reconciler() -> void {
    let panel_tsv = bus_read("baseline:panel_hits");
    if len(panel_tsv) == 0 { print("reconciler: no panel hits — skipping"); return; }
    let wd = getenv("MVA_WORK_DIR");
    let cdir = getenv("COLONY_DIR");
    // colony-lint: safe-exec-concat
    let panel_raw = exec sh "cat " + shell_escape(panel_tsv) + " 2>/dev/null || true";
    let hits = nonempty_lines(panel_raw);
    record_rows("reconcile", len(hits));

    // Group per gene: hom-alt -> biallelic; >=2 het in a gene -> candidate
    // compound-het (unphased, never asserted confirmed biallelic); single rare
    // -> monoallelic. Fold each gene into ONE candidate row (proband injected
    // by the emitter). The panel review is the evidence-tier anchor; the
    // Exomiser top-N is appended AFTER it below (#2054).
    let genes = sort_unique_strings(map(hits, |h: string| -> string { return field(h, 7); }));
    // #2059: representative-variant selection. Track-1 scoring is
    // VARIANT-level and the padded windows are full of benign SNPs; the old
    // fold picked arbitrarily (first hom / first two hets) AND let any
    // hom-alt suppress the compound-het pair entirely. Now: Exomiser's
    // per-variant ranking (when its manifest-pinned TSV exists) picks WHICH
    // variants represent the gene, the top-ranked hit decides WHICH
    // representation leads, and the other representation rides along as a
    // secondary alt_representation row. The official Track-1 instructions
    // state: "Secondary or incidental findings won't hurt your automated
    // score - include them if you want them considered." — a suppressed
    // hypothesis costs nothing on the automated metric (slot accounting at
    // the cap below counts primary rows only).
    // Single resolve (#2060 review): baseline:exomiser_tsv is a consume-once
    // bus topic — a second exomiser_tsv_path() call would find the bus empty
    // and silently depend on the marker fallback alone.
    let exo_tsv = exomiser_tsv_path(wd);
    let cand_blobs = map(genes, |g: string| -> string {
        let gene_hits = filter(hits, |h: string| -> bool { return field(h, 7) == g; });
        let hom = filter(gene_hits, |h: string| -> bool { return field(h, 8) == "hom-alt"; });
        let het = filter(gene_hits, |h: string| -> bool { return field(h, 8) == "het"; });
        let none_h = filter(gene_hits, |x: string| -> bool { return false; });
        let keys = if len(exo_tsv) > 0 { nonempty_lines(exo_gene_keys(exo_tsv, g)) } else { none_h };
        if len(het) >= 2 {
            let a = pick_rep(het, keys, "");
            let akey = field(a, 0) + ":" + field(a, 1);
            // Pair members must sit at DISTINCT positions: bcftools norm
            // -m -any splits a multiallelic site into several het records at
            // one pos, and a "pair" of those is one site, not compound-het
            // (#2060 review). Exclude by KEY, not by row identity.
            let het_b = filter(het, |h: string| -> bool { return field(h, 0) + ":" + field(h, 1) != akey; });
            if len(het_b) > 0 {
                let b = pick_rep(het_b, keys, "");
                let pr = pair_row(g, a, b, "known_gene_comphet", "primary", " candidate compound-het (unphased)");
                if len(hom) > 0 {
                    let v = pick_rep(hom, keys, "");
                    let vkey = field(v, 0) + ":" + field(v, 1);
                    let hr = single_row(g, v, "known_gene_biallelic", "primary", " biallelic (hom-alt)");
                    let ar_pair = pair_row(g, a, b, "alt_representation", "secondary", " candidate compound-het (unphased) — alternate representation");
                    let ar_hom = single_row(g, v, "alt_representation", "secondary", " biallelic (hom-alt) — alternate representation");
                    // The alternate must not collide with the primary on the
                    // emitter's chrom_1:pos_1 dup-key check — a shared key
                    // would refuse the WHOLE submission (#2060 review). On a
                    // collision the alternate is dropped, not the submission.
                    // The top Exomiser-ranked hit decides which representation
                    // leads; without that evidence the PAIR leads (a padded
                    // window's hom-alts are overwhelmingly benign
                    // polymorphisms).
                    let top = first_by_exo(gene_hits, keys, 0, "");
                    let hom_leads = if len(top) > 0 { field(top, 8) == "hom-alt" } else { false };
                    if hom_leads {
                        if akey == vkey { return hr; }
                        return hr + "\n" + ar_pair;
                    }
                    if vkey == akey { return pr; }
                    return pr + "\n" + ar_hom;
                }
                return pr;
            }
        }
        if len(hom) > 0 {
            let v = pick_rep(hom, keys, "");
            return single_row(g, v, "known_gene_biallelic", "primary", " biallelic (hom-alt)");
        }
        if len(het) >= 1 {
            let v = pick_rep(het, keys, "");
            return single_row(g, v, "known_gene_monoallelic", "primary", " single rare protein-altering allele");
        }
        return "";
    });
    let rows = nonempty_lines(join_str(cand_blobs, "\n"));

    // Cap at max_rows from the ladder.
    // colony-lint: safe-exec-concat
    let maxs = trim(exec sh "grep -oiE 'max_rows:[ ]*[0-9]+' " + shell_escape(cdir + "/settings/epcr.yml") + " 2>/dev/null | grep -oE '[0-9]+' | head -1 || echo 10");
    let cap0 = parse_int(maxs);
    let cap = if cap0 <= 0 { 10 } else { cap0 };

    // #2054: merge the Exomiser top-N AFTER the panel candidates — novel genes
    // the panel cannot see. Panel precedence is structural: appended after,
    // and the strict EPCR sort + cap arbitrate the tail. Slot accounting
    // counts PRIMARY rows only (#2060 review): a 0.15 secondary alternate
    // must not displace a 0.20 primary novel-gene row — the sort below
    // trims the lowest-EPCR rows when the total exceeds the cap.
    let none2 = filter(rows, |x: string| -> bool { return false; });
    let primary_rows = filter(rows, |r: string| -> bool { return field(r, 10) == "primary"; });
    let exo_left = cap - len(primary_rows);
    let pkeys = reduce(rows, |acc: string, r: string| -> string {
        let k1 = field(r, 1) + ":" + field(r, 2) + "|";
        let c2 = field(r, 5);
        if len(c2) > 0 { return acc + k1 + c2 + ":" + field(r, 6) + "|"; }
        return acc + k1;
    }, "");
    let exo_rows = if len(exo_tsv) == 0 { none2 }
        else { if exo_left <= 0 { none2 } else { exomiser_candidates(exo_tsv, genes, pkeys, exo_left) } };
    if len(exo_tsv) > 0 {
        print("reconciler: Exomiser merge — ", len(exo_rows), " novel-gene candidate(s) from ", exo_tsv);
    } else {
        print("reconciler: no Exomiser TSV — panel-only reconcile");
    }
    let combined = concat_rec(exo_rows, 0, rows);
    // #2059: STRICT EPCR ordering — the submission is ranked by epcr, so the
    // emitted row order must follow it (desc). #2064: ties within a tier are
    // broken by the gene's EXOMISER RANK (epcr.yml's documented contract —
    // an evidence-blind text tie-break put an arbitrary gene at rank 1 on
    // real data); genes absent from the TSV (or no TSV at all) rank 999 and
    // keep the deterministic row-text fallback. Sorting BEFORE the cap keeps
    // the top-ranked rows.
    let rank_lines = exo_rank_lines(exo_tsv);
    let rank_ig = if len(rank_lines) >= 2 { col_idx(get(rank_lines, 0), "GENE_SYMBOL") } else { 0 - 1 };
    if len(exo_tsv) > 0 {
        print("reconciler: within-tier ranks from ", len(rank_lines), " Exomiser row(s) (genes TSV preferred; unranked genes = 999, text fallback)");
    }
    let keyed = map(combined, |r: string| -> string {
        let g = first_token(field(r, 11));
        return zpad(to_string(100 - epcr_centi(r)), 3) + "\t"
            + zpad(to_string(exo_gene_rank(rank_lines, rank_ig, g)), 3) + "\t" + r;
    });
    let sorted_rows = map(sort_strings(keyed), |k: string| -> string { return strip_fields(k, 2); });
    let capped = if len(sorted_rows) > cap { take(sorted_rows, cap) } else { sorted_rows };
    let cand_tsv = wd + "/candidates.tsv";
    // colony-lint: safe-exec-concat
    exec sh "printf %s " + shell_escape(join_str(capped, "\n") + "\n") + " > " + shell_escape(cand_tsv);
    print("reconciler: ", len(capped), " candidate(s) after EPCR ladder + cap(", cap, ")");
    emit("baseline:candidates", cand_tsv);

    // M3 (lens mode): broadcast the candidate set for the lens fan-out. `listen`
    // is consume-once, so the full candidate rows AND a per-gene fact bundle go
    // on the memo where all five lenses + the refuter + the lens reconciler can
    // re-read them. Nothing here touches the baseline submission.
    if lens_mode() {
        memo_write("lens:candidates", join_str(capped, "\n"));
        // alt_representation rows are the SAME gene hypothesis in another
        // zygosity dress — scoring them as separate pool members would
        // double-count the gene in every lens, so they stay out of the pool.
        let pool_src = filter(capped, |row: string| -> bool { return index_of(field(row, 11), "alternate representation") < 0; });
        let pool = map(pool_src, |row: string| -> string {
            let notes = field(row, 11);
            let gene = first_token(notes);
            let chrom = field(row, 1);
            let pos = field(row, 2);
            let tierid = if index_of(notes, "biallelic") >= 0 { "biallelic" }
                else { if index_of(notes, "compound-het") >= 0 { "comphet" }
                else { if index_of(notes, "novel-gene") >= 0 { "novel" } else { "monoallelic" } } };
            // representative-variant evidence (the candidate's chrom_1:pos_1).
            let h = filter(hits, |x: string| -> bool {
                if field(x, 0) != chrom { return false; }
                return field(x, 1) == pos;
            });
            let hit = if len(h) > 0 { get(h, 0) } else { "" };
            let zyg = if len(hit) > 0 { field(hit, 8) } else { "" };
            let vaf = if len(hit) > 0 { field(hit, 6) } else { "NA" };
            let flt = if len(hit) > 0 { field(hit, 4) } else { "" };
            return gene + "\t" + chrom + "\t" + pos + "\t" + zyg + "\t" + vaf + "\t" + flt + "\t" + tierid;
        });
        memo_write("lens:pool", join_str(pool, "\n"));
        print("reconciler: lens mode — broadcast lens:pool (", len(pool), " candidate(s))");
    }
}

// ======================================================================
// stage 6 — emitter: build the CSV, validate the schema, refuse on violation
// ======================================================================

// Replace field 0 (proband_id) of a tab row with a value.
fn replace_first_field(row: string, val: string) -> string {
    let t = index_of(row, "\t");
    if t < 0 { return val; }
    return val + substring(row, t, len(row));
}

// Validate ONE candidate row (tab-separated, 12 fields). "" if valid, else the
// first violated rule: column count, chr-prefix primary contig, 0 < epcr <= 1,
// pair columns all-or-nothing, finding_type set.
fn validate_row(row: string) -> string {
    let n = len(regex_split("\t", row));
    if n != 12 { return "column-count"; }
    if !is_primary_contig(field(row, 1)) { return "chrom_1-not-chr-primary"; }
    let epcr = parse_float(field(row, 9));
    if epcr <= 0.0 { return "epcr-out-of-range"; }
    if epcr > 1.0 { return "epcr-out-of-range"; }
    let ft = field(row, 10);
    if ft != "primary" { if ft != "secondary" { return "finding_type"; } }
    let c2 = field(row, 5);
    let p2 = field(row, 6);
    let r2 = field(row, 7);
    let a2 = field(row, 8);
    let filled = len(c2) + len(p2) + len(r2) + len(a2);
    if len(c2) > 0 {
        if len(p2) == 0 { return "pair-partial"; }
        if !is_primary_contig(c2) { return "chrom_2-not-chr-primary"; }
    }
    if len(c2) == 0 { if filled > 0 { return "pair-partial"; } }
    return "";
}

// Shared submission writer (M1 emitter core, extracted so the M3 lens_emitter
// reuses the SAME schema validator + writer instead of duplicating it). Injects
// the proband id into each candidate row, validates the 12-field schema
// (short-circuit on the first violation), refuses duplicate variant keys, then
// writes header + rows (tabs -> commas) to
// <outdir>/agentis-federation_<approach>.csv. Returns "" on success, else a
// short reason tag ("too-many-rows" | "schema-invalid:<rule>" | "dup-key") the
// caller surfaces. Byte-identical to the pre-refactor emitter for `baseline`.
// #2067: the submission metric measures a RANKING ("only your ranking
// relative to your own guesses matters") and F-max needs a threshold that
// isolates the top rows — tied EPCRs cap precision (measured live: two rows
// at 0.90 -> F-max 0.667). After the ordering is FINAL, ties are separated
// deterministically: the first row of a tie keeps its tier value, each
// following row emits just below the previous one (-0.01, floored at 0.01).
// Tier provenance stays in the notes; the ladder itself is untouched — this
// expresses the total order the pipeline already computed, no new evidence.
// Milli (0.001) steps: centi steps exhaust the band under the 0.05 tier
// after five rows (#2068 review); with 0.001 steps the 10-row cap can never
// collide (at most 9 decrements, ladder minimum 0.05 = 50 milli).
fn separate_epcr_rec(rows: list<string>, i: int, prev_milli: int, acc: list<string>) -> list<string> {
    if i >= len(rows) { return acc; }
    let r = get(rows, i);
    let m0 = epcr_centi(r) * 10;
    let m = if i == 0 { m0 } else { if m0 >= prev_milli { prev_milli - 1 } else { m0 } };
    // The floor applies ONLY to values the separation itself lowered — an
    // invalid original (e.g. a corrupted 0 tier) must reach the validator
    // untouched so the epcr-out-of-range refusal still bites (M4 contract).
    let mf = if m == m0 { m } else { if m < 1 { 1 } else { m } };
    let sep = if mf == m0 { r } else {
        set_field(r, 9, zpad_epcr_milli(mf))
    };
    return separate_epcr_rec(rows, i + 1, mf, push(acc, sep));
}
fn zpad_epcr_milli(milli: int) -> string {
    if milli >= 1000 { return "1.000"; }
    if milli >= 100 { return "0." + to_string(milli); }
    if milli >= 10 { return "0.0" + to_string(milli); }
    return "0.00" + to_string(milli);
}

fn emit_submission(rows: list<string>, proband: string, outdir: string, approach: string) -> string {
    if len(rows) > 10 { return "too-many-rows"; }
    let none_r = filter(rows, |x: string| -> bool { return false; });
    let rows2 = separate_epcr_rec(rows, 0, 0, none_r);
    let validated = reduce(rows2, |acc: string, row: string| -> string {
        if index_of(acc, "VIOLATION:") == 0 { return acc; }
        let withid = replace_first_field(row, proband);
        let v = validate_row(withid);
        if len(v) > 0 { return "VIOLATION:" + v; }
        return acc + withid + "\n";
    }, "");
    if index_of(validated, "VIOLATION:") == 0 {
        return "schema-invalid:" + substring(validated, 10, len(validated));
    }
    let body_rows = nonempty_lines(validated);
    let keys = map(body_rows, |r: string| -> string { return field(r, 1) + ":" + field(r, 2); });
    if len(sort_unique_strings(keys)) != len(keys) { return "dup-key"; }
    let header = "proband_id,chrom_1,pos_1,ref_1,alt_1,chrom_2,pos_2,ref_2,alt_2,epcr,finding_type,notes";
    let csv_rows = map(body_rows, |r: string| -> string { return replace_all(r, "\t", ","); });
    let csv = header + "\n" + join_str(csv_rows, "\n") + "\n";
    // colony-lint: safe-exec-concat
    exec sh "mkdir -p " + shell_escape(outdir);
    let outfile = outdir + "/agentis-federation_" + approach + ".csv";
    // colony-lint: safe-exec-concat
    exec sh "printf %s " + shell_escape(csv) + " > " + shell_escape(outfile);
    return "";
}

agent emitter() -> void {
    let cand_tsv = bus_read("baseline:candidates");
    if len(cand_tsv) == 0 { print("emitter: no candidates — nothing to emit"); return; }
    // The D6 operator review gate governs emission: the submission CSV is
    // written ONLY when the phenotype HPO set was approved for THIS run (a
    // hash match). No approval -> refuse, no CSV (M2 proves this bites).
    let gate = recall_latest("pipeline:gate");
    if gate != "approved" {
        print("emitter: REFUSING to emit — HPO set not approved (D6 gate:", gate, "). No CSV written.");
        emit("baseline:abort", "gate-blocked");
        return;
    }
    let outdir = getenv("MVA_OUT_DIR");
    let nvcf = recall_latest("baseline:nvcf");
    let approach = getenv_or("MVA_APPROACH", "baseline");
    let proband = resolve_proband(nvcf);

    // colony-lint: safe-exec-concat
    let raw = exec sh "cat " + shell_escape(cand_tsv) + " 2>/dev/null || true";
    let rows = nonempty_lines(raw);
    record_rows("emit", len(rows));

    let err = emit_submission(rows, proband, outdir, approach);
    if len(err) > 0 {
        if index_of(err, "too-many-rows") == 0 {
            print("emitter: REFUSING — ", len(rows), " rows exceed the schema cap of 10");
            emit("baseline:abort", "too-many-rows");
            return;
        }
        if index_of(err, "schema-invalid:") == 0 {
            print("emitter: REFUSING to emit — schema violation:", substring(err, 15, len(err)));
            emit("baseline:abort", "schema-invalid");
            return;
        }
        print("emitter: REFUSING to emit — duplicate variant keys");
        emit("baseline:abort", "dup-key");
        return;
    }
    print("emitter: wrote schema-valid submission CSV ->", outdir + "/agentis-federation_" + approach + ".csv");
    print("Verdict: EMITTED");
}

// ======================================================================
// M3 — lens fan-out: five independent lenses, each ONE prompt over the whole
// candidate pool, blind to the others. Every lens early-returns unless lens
// mode is on (the Exomiser opt-in precedent), reads the broadcast pool + HPO
// (recall_latest, never the consume-once listen), makes one scoring prompt, and
// memo_writes a per-candidate score TSV (gene<TAB>score) on its own key.
// ======================================================================

agent lens_inheritance() -> void {
    if !lens_mode() { return; }
    let pool = recall_latest("lens:pool");
    if len(pool) == 0 { print("lens_inheritance: empty pool (lens mode)"); return; }
    let rows = nonempty_lines(pool);
    let reply = prompt(
        "You are a clinical geneticist scoring candidate genes on ONE axis: INHERITANCE-MODEL FIT for a single "
      + "proband with mosaic variegated aneuploidy and NO parental samples. For each candidate line (gene, "
      + "zygosity, VAF, FILTER, evidence tier) reply with EXACTLY one line: the gene, a TAB, a score in [0,1] "
      + "(1 = zygosity/segregation strongly fits a causal biallelic or de-novo model, 0 = poor fit), a TAB, a "
      + "one-clause rationale. Nothing else.", lens_payload(rows)) -> string;
    let scored = map(rows, |r: string| -> string {
        return field(r, 0) + "\t" + lens_score(reply, field(r, 0), prior_inheritance(r));
    });
    memo_write("lens:score:inheritance", join_str(scored, "\n"));
    emit("baseline:lens_done", "inheritance");
    print("lens_inheritance: scored", len(rows), "candidate(s)");
}

agent lens_mosaicism() -> void {
    if !lens_mode() { return; }
    let pool = recall_latest("lens:pool");
    if len(pool) == 0 { print("lens_mosaicism: empty pool (lens mode)"); return; }
    let rows = nonempty_lines(pool);
    let reply = prompt(
        "You are a clinical geneticist scoring candidate genes on ONE axis: MOSAIC / LOW-VAF support. Mosaic "
      + "variegated aneuploidy is mosaic by definition, so a low variant allele fraction or a LowVAF hard-filter "
      + "is EVIDENCE, not noise. For each candidate line reply with EXACTLY one line: gene, TAB, score in [0,1] "
      + "(1 = strong somatic/mosaic support, 0 = a clean germline-fraction call), TAB, one-clause rationale.",
        lens_payload(rows)) -> string;
    let scored = map(rows, |r: string| -> string {
        return field(r, 0) + "\t" + lens_score(reply, field(r, 0), prior_mosaicism(r));
    });
    memo_write("lens:score:mosaicism", join_str(scored, "\n"));
    emit("baseline:lens_done", "mosaicism");
    print("lens_mosaicism: scored", len(rows), "candidate(s)");
}

agent lens_hpo() -> void {
    if !lens_mode() { return; }
    let pool = recall_latest("lens:pool");
    if len(pool) == 0 { print("lens_hpo: empty pool (lens mode)"); return; }
    let hpo = recall_latest("lens:hpo");
    let rows = nonempty_lines(pool);
    let reply = prompt(
        "You are a clinical geneticist scoring candidate genes on ONE axis: GENE-PHENOTYPE OVERLAP against the "
      + "approved HPO set for this proband (below). For each candidate line reply with EXACTLY one line: gene, "
      + "TAB, score in [0,1] (1 = the gene's known disease phenotype matches the HPO set strongly, 0 = no "
      + "overlap), TAB, one-clause rationale. Approved HPO ids: " + hpo, lens_payload(rows)) -> string;
    let scored = map(rows, |r: string| -> string {
        return field(r, 0) + "\t" + lens_score(reply, field(r, 0), prior_hpo(r, hpo));
    });
    memo_write("lens:score:hpo", join_str(scored, "\n"));
    emit("baseline:lens_done", "hpo");
    print("lens_hpo: scored", len(rows), "candidate(s)");
}

agent lens_known_gene() -> void {
    if !lens_mode() { return; }
    let pool = recall_latest("lens:pool");
    if len(pool) == 0 { print("lens_known_gene: empty pool (lens mode)"); return; }
    let rows = nonempty_lines(pool);
    let reply = prompt(
        "You are a clinical geneticist scoring candidate genes on ONE axis: KNOWN-MVA-GENE priority. Rank "
      + "BUB1B, CEP57, TRIP13, CENATAC and other spindle-assembly-checkpoint / chromosome-segregation genes "
      + "higher. For each candidate line reply with EXACTLY one line: gene, TAB, score in [0,1] (1 = an "
      + "established MVA gene, 0 = no segregation-machinery link), TAB, one-clause rationale.",
        lens_payload(rows)) -> string;
    let scored = map(rows, |r: string| -> string {
        return field(r, 0) + "\t" + lens_score(reply, field(r, 0), prior_known_gene(r));
    });
    memo_write("lens:score:known_gene", join_str(scored, "\n"));
    emit("baseline:lens_done", "known_gene");
    print("lens_known_gene: scored", len(rows), "candidate(s)");
}

agent lens_pathway() -> void {
    if !lens_mode() { return; }
    let pool = recall_latest("lens:pool");
    if len(pool) == 0 { print("lens_pathway: empty pool (lens mode)"); return; }
    let rows = nonempty_lines(pool);
    let reply = prompt(
        "You are a clinical geneticist scoring candidate genes on ONE axis: PLAUSIBLE-PATHWAY NOVEL gene. Reward "
      + "genes OUTSIDE the known MVA panel that sit in a disrupted mitotic / spindle-checkpoint / DNA-damage "
      + "pathway (a candidate for a NEW MVA gene). For each candidate line reply with EXACTLY one line: gene, "
      + "TAB, score in [0,1] (1 = a strong novel-pathway candidate, 0 = an already-known panel gene), TAB, a "
      + "one-clause rationale.", lens_payload(rows)) -> string;
    let scored = map(rows, |r: string| -> string {
        return field(r, 0) + "\t" + lens_score(reply, field(r, 0), prior_pathway(r));
    });
    memo_write("lens:score:pathway", join_str(scored, "\n"));
    emit("baseline:lens_done", "pathway");
    print("lens_pathway: scored", len(rows), "candidate(s)");
}

// ======================================================================
// M3 — refute gate: an INDEPENDENT skeptic per candidate (<=10, bounded),
// replaying dark-factory/auditor/agents/refuter.ag in the genomics domain.
// The benign-in-population axis is a hard, machine-checkable fact (population
// AF), so it is decided in .ag; the other axes (wrong inheritance fit,
// phenotype mismatch, artifact call) are the LLM skeptic's genuine devise->
// refute. On any failure to assess (no population AF, malformed row) the
// candidate is KEPT and tagged `refuter-error` — the dark-factory fail-open,
// never a silent drop.
// ======================================================================

// One candidate -> "gene<TAB>verdict<TAB>axis<TAB>detail", verdict in
// {REAL, REFUTED, refuter-error}.
fn refute_one(nvcf: string, benign_af: float, aftag: string, r: string) -> string {
    let gene = field(r, 0);
    if len(trim(gene)) == 0 { return "\trefuter-error\tmalformed\tempty candidate row"; }
    let afRaw = pop_af(nvcf, field(r, 1), field(r, 2), aftag);
    let af_known = if len(afRaw) == 0 { false } else { if afRaw == "." { false } else { true } };
    // Deterministic hard axis — only when a genuine POPULATION AF annotation
    // exists: a common population allele is not a penetrant cause.
    if af_known {
        if parse_float(afRaw) >= benign_af {
            return gene + "\tREFUTED\tbenign-in-population\tpopulation AF " + afRaw + " at/above the common-variant cutoff";
        }
    }
    // Genuine LLM skeptic (a parseable REFUTED demotes). A missing annotation
    // must NOT disable the skeptic (#2056): the benign axis then falls to the
    // LLM's own knowledge of common variants.
    let afnote = if af_known {
        "The representative variant is NOT common in the population (already checked against the population-AF annotation). Try to REFUTE on: wrong inheritance fit, phenotype mismatch, or a low-quality/artifact call. "
    } else {
        "No population-AF annotation is available, so ALSO consider benign-in-population from your own knowledge of common variants. Try to REFUTE on: benign-in-population, wrong inheritance fit, phenotype mismatch, or a low-quality/artifact call. "
    };
    // colony-lint: prompt-gate-ok
    let verdict = prompt(
        "You are an INDEPENDENT clinical geneticist with NO stake in this candidate being causal. Try to REFUTE "
      + "its causality for a single proband with mosaic variegated aneuploidy (no parental samples). " + afnote
      + "Reply with EXACTLY ONE final line: VERDICT|REAL|" + gene
      + "|<axis>|<why the refutation failed> or VERDICT|REFUTED|" + gene + "|<axis>|<the fact that kills "
      + "causality>. If unsure, answer REAL.",
        "gene=" + gene + " zygosity=" + field(r, 3) + " vaf=" + field(r, 4) + " filter=" + field(r, 5)
      + " tier=" + field(r, 6)) -> string;
    if index_of(verdict, "VERDICT|REFUTED|") >= 0 {
        // Capture "<axis>|<reason>" in one tab/newline-free group: the model
        // text is untrusted and a TAB or NEWLINE here would inject columns or
        // rows into refuted.tsv (#2057 review).
        let why = trim(regex_capture("VERDICT\\|REFUTED\\|[^|]*\\|([^\\t\\n]*)", verdict, 1));
        return gene + "\tREFUTED\tllm-skeptic\t" + why;
    }
    if af_known { return gene + "\tREAL\tsurvived\tno refuting fact found"; }
    // L4 fail-open contract: no annotation -> KEPT, visibly tagged.
    return gene + "\trefuter-error\tbenign-in-population\tno population-AF annotation (" + aftag + ") — LLM skeptic found no refuting fact";
}
fn refute_rec(nvcf: string, benign_af: float, aftag: string, rows: list<string>, i: int, acc: string) -> string {
    if i >= len(rows) { return acc; }
    return refute_rec(nvcf, benign_af, aftag, rows, i + 1, acc + refute_one(nvcf, benign_af, aftag, get(rows, i)) + "\n");
}

agent refuter() -> void {
    if !lens_mode() { return; }
    let pool = recall_latest("lens:pool");
    if len(pool) == 0 { print("refuter: empty pool (lens mode)"); return; }
    let nvcf = recall_latest("baseline:nvcf");
    let wd = getenv("MVA_WORK_DIR");
    let benign = parse_float(yaml_num(epcr_yml(), "benign_population_af", "0.01"));
    // Resolve the population-AF tag ONCE and log it — bcftools failures on an
    // undeclared tag are silenced in pop_af, so this line is the operator's
    // only signal about which annotation the benign axis is reading (#2056).
    let aftag = yaml_word(epcr_yml(), "benign_af_info_tag", "GNOMAD_AF");
    print("refuter: benign-in-population reads INFO/" + aftag + " (unannotated variants fall to the LLM skeptic, fail-open)");
    // Per-candidate, bounded at <=10 — the refute gate's intentional cost.
    let rows = take(nonempty_lines(pool), 10);
    let verdicts = refute_rec(nvcf, benign, aftag, rows, 0, "");
    memo_write("lens:refute", verdicts);
    record_rows("refute", len(rows));
    // Transparency bucket: everything not a clean REAL (REFUTED + refuter-error).
    let vlines = nonempty_lines(verdicts);
    let bucket = filter(vlines, |l: string| -> bool { return field(l, 1) != "REAL"; });
    // colony-lint: safe-exec-concat
    exec sh "printf %s " + shell_escape(join_str(bucket, "\n") + "\n") + " > " + shell_escape(wd + "/refuted.tsv");
    let refuted_n = len(filter(vlines, |l: string| -> bool { return field(l, 1) == "REFUTED"; }));
    // learn() is best-effort telemetry — a no-op unless experience.enabled.
    let learned = try {
        learn("refute", "grand-rounds", "adversarial refutation of " + to_string(len(rows)) + " candidate(s) ("
          + to_string(refuted_n) + " refuted)", "success", ["refute", "grand-rounds"]);
        "on";
    } catch e { "off"; };
    emit("baseline:refute_verdict", to_string(refuted_n));
    print("refuter:", len(rows), "candidate(s) judged,", refuted_n, "refuted ->", wd + "/refuted.tsv");
}

// ======================================================================
// M3 — lens reconciler: merge the five lens scores + the refute verdicts into
// one EPCR-ranked candidate set. Lens AGREEMENT (>= promote_min lenses above
// threshold) promotes a candidate one rung up the SAME epcr.yml ladder the
// baseline uses; REFUTATION removes it into refuted.tsv. Uses the substrate
// `decide()` to select each candidate's final tier from the fact-ranked
// options (proven in dark-factory/auditor). Then lens_emitter reuses M1's
// validator + writer to emit agentis-federation_lens.csv.
// ======================================================================

agent lens_reconciler() -> void {
    if !lens_mode() { return; }
    let candraw = recall_latest("lens:candidates");
    if len(candraw) == 0 { print("lens_reconciler: no candidates (lens mode)"); return; }
    let rows = nonempty_lines(candraw);
    let blob = epcr_yml();
    let thr = parse_float(yaml_num(blob, "lens_score_threshold", "0.6"));
    let promote_min = parse_int(yaml_num(blob, "lens_agreement_promote_min", "3"));
    let s_inh = recall_latest("lens:score:inheritance");
    let s_mos = recall_latest("lens:score:mosaicism");
    let s_hpo = recall_latest("lens:score:hpo");
    let s_kg = recall_latest("lens:score:known_gene");
    let s_pw = recall_latest("lens:score:pathway");
    let refute = recall_latest("lens:refute");

    // Annotate: "<agree>\t<verdict>\t<row>".
    let annotated = map(rows, |row: string| -> string {
        let gene = first_token(field(row, 11));
        return to_string(count_agree(gene, thr, s_inh, s_mos, s_hpo, s_kg, s_pw))
            + "\t" + refute_verdict_for(gene, refute) + "\t" + row;
    });
    // REFUTED candidates leave the ranked submission (kept in refuted.tsv).
    let kept = filter(annotated, |a: string| -> bool { return field(a, 1) != "REFUTED"; });
    // Apply promotion (agreement) + refuter-error tag, and select the final tier
    // with the substrate decide() over fact-ranked options; prefix the sort key.
    let adjusted = map(kept, |a: string| -> string {
        let agree = parse_int(field(a, 0));
        let verdict = field(a, 1);
        let row = strip_fields(a, 2);
        let promoted = if agree >= promote_min { promote_row(row) } else { row };
        // Substrate selection: the fact-ranked option is first; decide() returns
        // it offline and may arbitrate a near-tie on a real backend. Either way
        // the ORDERING is ours (agreement + refute), not an opaque pick.
        let picked = decide([promoted, row],
            "Select the final EPCR tier for this MVA candidate. The first option already encodes lens "
          + "agreement (" + to_string(agree) + " of five lenses) and the refute verdict; keep it unless the "
          + "runner-up is clearly better supported. Prefer the first.");
        let chosen = if len(trim(picked)) == 0 { promoted } else { picked };
        let tagged = if verdict == "refuter-error" { note_append(chosen, " [refuter-error]") } else { chosen };
        return order_key(tagged, agree) + "\t" + tagged;
    });
    let ranked = sort_strings(adjusted);
    let cap = parse_int(yaml_num(blob, "max_rows", "10"));
    let capped = if len(ranked) > cap { take(ranked, cap) } else { ranked };
    let final_rows = map(capped, |x: string| -> string { return strip_fields(x, 3); });
    memo_write("lens:ranked", join_str(final_rows, "\n"));
    record_rows("lens-reconcile", len(final_rows));
    emit("baseline:lens_ranked", to_string(len(final_rows)));
    print("lens_reconciler:", len(final_rows), "ranked candidate(s) after lens agreement + refute");
}

agent lens_emitter() -> void {
    if !lens_mode() { return; }
    let ranked = recall_latest("lens:ranked");
    if len(ranked) == 0 { print("lens_emitter: no ranked lens candidates"); return; }
    // The D6 operator review gate governs the lens submission too (the HPO set
    // feeds lens_hpo, so lens emission is legitimately phenotype-gated).
    let gate = recall_latest("pipeline:gate");
    if gate != "approved" {
        print("lens_emitter: REFUSING to emit — HPO set not approved (D6 gate:", gate, ").");
        emit("baseline:abort", "lens-gate-blocked");
        return;
    }
    let outdir = getenv("MVA_OUT_DIR");
    let nvcf = recall_latest("baseline:nvcf");
    let proband = resolve_proband(nvcf);
    let rows = nonempty_lines(ranked);
    record_rows("lens-emit", len(rows));
    let err = emit_submission(rows, proband, outdir, "lens");
    if len(err) > 0 {
        print("lens_emitter: REFUSING to emit lens submission —", err);
        emit("baseline:abort", "lens-schema-invalid");
        return;
    }
    print("lens_emitter: wrote schema-valid LENS submission CSV (", len(rows), " rows) ->",
        outdir + "/agentis-federation_lens.csv");
    print("Verdict: LENS-EMITTED");
}

// ======================================================================
// orchestrator: seed the bus, run the event chain (no polling)
// ======================================================================
print("baseline: pipeline start");
// Reset the review gate so a prior run's approval can never leak into this one.
memo_write("pipeline:gate", "reset");
// Reset the broadcast normalized-VCF path: recall_latest returns void for a
// MISSING key (which would crash len()), so a same-run write guarantees the
// fan-out readers always see a string ("" until the preprocessor succeeds).
memo_write("baseline:nvcf", "");
// Seed every M3 lens memo empty for the same reason: the lens agents + the lens
// reconciler recall_latest these keys, and a missing key would crash len(). The
// reconciler/lenses overwrite them in lens mode; in baseline mode they stay "".
memo_write("lens:pool", "");
memo_write("lens:candidates", "");
memo_write("lens:hpo", "");
memo_write("lens:score:inheritance", "");
memo_write("lens:score:mosaicism", "");
memo_write("lens:score:hpo", "");
memo_write("lens:score:known_gene", "");
memo_write("lens:score:pathway", "");
memo_write("lens:refute", "");
memo_write("lens:ranked", "");
coordinator();
preprocessor();
phenotyper();
exomiser_runner();
panel_reviewer();
reconciler();
emitter();
// M3 lens fan-out + refute gate + reconcile (each no-ops unless MVA_LENS_MODE=1,
// so the baseline chain above is byte-for-byte unchanged when lens mode is off).
lens_inheritance();
lens_mosaicism();
lens_hpo();
lens_known_gene();
lens_pathway();
refuter();
lens_reconciler();
lens_emitter();
memo_write("pipeline:last_check", now_iso());
print("baseline: pipeline done");
