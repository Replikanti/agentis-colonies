# Containerfile.research -- merged base image for the research-foundry
# federation (#638). Single image hosting all 15 colonies (math
# pipeline + claim-auditor searchers + preprint pipeline) under one
# `.agentis/` state dir. Replaces the three retired Containerfiles
# (Containerfile.foundry, Containerfile.auditor, Containerfile.preprint).
#
# Toolchain (superset of the three retired images):
#   - Debian/Ubuntu + Python scientific stack (sympy / numpy / networkx)
#     for the math pipeline and preprint computer colony.
#   - TeX Live (texlive-latex-extra / fonts-recommended / science /
#     latexmk) for `latexmk -pdf` invoked by the editor colony.
#   - GAP (`gap-core`) so the computer colony can run group-theory
#     reproducibility scripts.
#   - `curl` for arxiv / OEIS / groupprops / scholar HTTPS fetches and
#     for the agentis-runtime release download below.
#   - ssmtp so the submitter colony can mail submission.tar.gz to the
#     arXiv email gateway when a human flips the HITL approval flag.
#   - claude CLI for the (default) claude llm backend.
#
# The orchestrator does NOT pass `--network none`; rootless podman's
# default slirp4netns egress is used.
#
# WARNING: this image deliberately bakes ONLY the agentis runtime, the
# Python / LaTeX / GAP toolchains, and the claude CLI. The 15 colonies
# and the per-run hermetic .agentis/ state are mounted at run time via
# `-v $REPO_ROOT:/repo:ro` and `-v $RUN_DIR/<node>:/run-root:rw`. Do
# NOT `COPY` any colony source into the image.
#
# WARNING: Claude Code session credentials
# (`~/.claude/.credentials.json`) MUST NOT be baked in. The orchestrator
# bind-mounts the host operator's `$HOME/.claude` at run time via
# `-v $HOST_CLAUDE_DIR:/root/.claude:rw,z`; never `COPY` the directory
# into the image.

FROM ubuntu:24.04

ARG AGENTIS_VERSION=v1.18.23

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-requests \
        jq \
        git \
        curl \
        ca-certificates \
        texlive-latex-base \
        texlive-latex-recommended \
        texlive-latex-extra \
        texlive-fonts-recommended \
        texlive-science \
        latexmk \
        gap-core \
        ssmtp \
        time \
 && rm -rf /var/lib/apt/lists/*

# Compute stack matching the retired math-foundry / preprint-foundry
# images. The explorer / formulator / computer colonies' Python
# reproducibility scripts may use any of these.
RUN python3 -m pip install --no-cache-dir --break-system-packages \
        sympy \
        numpy \
        networkx

RUN cd /tmp \
 && curl -fsSL -o agentis-linux-x86_64 \
        "https://github.com/Replikanti/agentis/releases/download/${AGENTIS_VERSION}/agentis-linux-x86_64" \
 && curl -fsSL -o agentis-linux-x86_64.sha256 \
        "https://github.com/Replikanti/agentis/releases/download/${AGENTIS_VERSION}/agentis-linux-x86_64.sha256" \
 && sha256sum -c agentis-linux-x86_64.sha256 \
 && install -m 0755 agentis-linux-x86_64 /usr/local/bin/agentis \
 && rm /tmp/agentis-linux-x86_64 /tmp/agentis-linux-x86_64.sha256

# Install Claude Code CLI for the default claude-backend support. A
# future Phase 2 cut may split per-colony backends (Sonnet for the
# four searchers, Opus for the auditor / introducer / theorist /
# editor) via per-colony AGENTIS_ROOT.
RUN curl -fsSL https://claude.ai/install.sh | bash \
 && ln -s /root/.local/bin/claude /usr/local/bin/claude

# Lean 4 toolchain for first-class proof verification in theorist.ag
# (#745). Uses elan (Lean version manager) with a pinned toolchain so
# the image is reproducible across rebuilds. Image bloat: ~1.5 GB per
# the #745 forensic. Most LLM-generated proofs will FAIL the formal
# check — that is the desired signal; verified / failed / incomplete
# are all informative. theorist.ag treats the check as non-terminal
# and still emits the LaTeX body regardless of outcome.
ARG LEAN_TOOLCHAIN=leanprover/lean4:v4.13.0
RUN curl -sSf https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh \
        | sh -s -- -y --default-toolchain "${LEAN_TOOLCHAIN}"
ENV PATH="/root/.elan/bin:${PATH}"
RUN lean --version

# Mathlib 4 — pre-fetched precompiled cache so theorist.ag can produce
# verified proofs of real mathematical claims, not just structural
# `variable (P : Prop)` axiom-shells (pre-this-change Containerfile
# explicitly forbade `import Mathlib` in the theorist's seed prompt
# because there was no mathlib in the image). The setup pattern is the
# canonical Lake-based one: a tiny shell project at /opt/mathlib-shell
# whose only purpose is to expose `LEAN_PATH` (via `lake env`) so any
# `.lean` file outside the project can still `import Mathlib`. Mathlib
# is fetched as a Lake dependency and its precompiled .olean files come
# from the Mathlib build cache (`lake exe cache get`) — that takes ~10
# minutes and ~3 GB of disk vs. ~3 hours of CPU for a from-scratch
# `lake build`. Pinned to the Mathlib release tag matching
# leanprover/lean4:v4.13.0 above.
#
# Theorist's _run_lean_check invokes `lake env --dir=/opt/mathlib-shell
# lean <abs_path>` (see theorist.ag) so the lean process inherits the
# correct LEAN_PATH; lean otherwise refuses `import Mathlib` with
# "unknown module Mathlib".
ARG MATHLIB_REV=v4.13.0
RUN mkdir -p /opt/mathlib-shell \
 && cd /opt/mathlib-shell \
 && printf 'leanprover/lean4:v4.13.0\n' > lean-toolchain \
 && printf 'import Lake\nopen Lake DSL\n\npackage «mathlib-shell» where\n\nrequire mathlib from git "https://github.com/leanprover-community/mathlib4.git" @ "%s"\n' "${MATHLIB_REV}" > lakefile.lean \
 && lake update \
 && (lake exe cache get || echo "cache get failed — proceeding; first lean import may compile from source") \
 && lake build plausible \
 && echo "Mathlib shell ready"
ENV MATHLIB_SHELL=/opt/mathlib-shell

WORKDIR /run-root

ENTRYPOINT ["/bin/bash"]
